#!/usr/bin/env sage
# FORK (1), cheap+definitive: are the a!=0 eigenvalues ABELIAN over Q (=> Jacobi/Hecke => Stickelberger)?
# Over K=Q(zeta_12n), L* = q1*q2 (quadratics).  Splitting field = K(sqrt D1, sqrt D2), Di=disc(qi).
# K(sqrt D)/Q abelian  <=>  D in Q^* * (K^*)^2  (Kronecker-Weber: quadratic subfields of cyclotomic
# fields are the Q(sqrt r), r rational).  Tests:
#   (necessary, Galois) sigma(D)/D in (K^*)^2 for all sigma in Gal(K/Q)  [check generators]
#   (definitive) squarefree part of the ideal (D) is generated by a RATIONAL  (=> D = r * square).
import sys
sys.path.insert(0, "/Users/trentpalelei/Desktop/Math Ex/btc_puzzle_investigation")
import audit_n1_vsign_v2_core as core

def build_L(p, a, K, z, n):
    dl = core.dlog_table(p, n); h1 = core.hist_k1(p, n, dl); h2 = core.hist_k2(p, n, dl)
    V1 = sum(h1[d]*z**((a*d) % n) for d in range(n))
    V2 = sum(h2[d]*z**((a*d) % n) for d in range(n))
    leg = 1 if p % 4 == 1 else -1
    e1 = -V1; e2 = (V1**2 + V2)/2; e3 = leg*p*e1; e4 = K(p**2)
    R = PolynomialRing(K, 'T'); T = R.gen()
    return T**4 - e1*T**3 + e2*T**2 - e3*T + e4

def rational_squarefree_part(D, K):
    """True iff the squarefree part of the fractional ideal (D) is generated by a rational,
    i.e. every prime of K dividing (D) to odd exponent lies over a rational prime whose FULL
    set of primes appears to the same odd exponent (Galois-stable) -> ideal part is r*square."""
    I = K.ideal(D)
    fac = I.factor()
    # group odd-exponent primes by the rational prime below; each such rational prime must have
    # ALL its primes (with same residue pattern) at the same odd exponent for the product to be rational*square
    from collections import defaultdict
    odd = defaultdict(list)
    for P, e in fac:
        if e % 2 == 1:
            odd[P.smallest_integer()].append((P, e))
    for pbelow, plist in odd.items():
        primes_above = K.primes_above(pbelow)
        # need: every prime above pbelow present with the SAME odd exponent (so product = (pbelow)*square)
        exps = {}
        for P, e in plist:
            exps[P] = e
        for P in primes_above:
            if exps.get(P, 0) % 2 != (list(exps.values())[0] % 2 if exps else 0):
                return False
        # all present at odd exponent, same parity -> contributes (pbelow)^odd * square: ok as rational*square
    return True

def identify(p, a=1):
    n = core.curve_order(p); assert is_prime(n)
    m = 12*n
    K = CyclotomicField(m); z = K.gen()
    Kn = CyclotomicField(n); zn = Kn.gen()
    L = build_L(p, a, Kn, zn, n)
    phi = Kn.hom([z**12], K)
    R = PolynomialRing(K, 'T'); T = R.gen()
    Lb = sum(phi(c)*T**i for i, c in enumerate(L.list()))
    facs = [f for f, e in Lb.factor()]
    degs = sorted(f.degree() for f in facs)
    if degs != [2, 2]:
        print(f"p={p} n={n} a={a}: NOT [2,2] over Q(zeta_{m}) (got {degs}) -- rehandle"); return
    gens = [Integer(g) for g in Zmod(m).unit_gens()]
    results = []
    for q in facs:
        b = q[1]; c = q[0]                         # q = T^2 + b T + c
        D = b*b - 4*c
        if D.is_square():
            results.append("splits"); continue
        galois = all((K.hom([z**t])(D)/D).is_square() for t in gens)
        rat = rational_squarefree_part(D, K) if galois else False
        results.append("ABELIAN" if (galois and rat) else ("Galois-not-rat" if galois else "non-abelian"))
    verdict = "ABELIAN (=> cyclotomic eigenvalues, Jacobi/Hecke, L-Stick)" if all(r == "ABELIAN" for r in results) \
              else "NON-ABELIAN (=> NOT Jacobi sums, go to L-mono)" if any(r == "non-abelian" for r in results) \
              else f"mixed {results}"
    print(f"p={p} n={n} a={a}: quad-discriminant verdicts {results} -> {verdict}")

if __name__ == "__main__":
    identify(13, 1)
    identify(13, 2)
    identify(43, 1)
