                     (7 * (speeds ⟨4, by omega⟩ : ℝ) / (speeds ⟨1, by omega⟩ : ℝ)) := by
      rw [mul_max_of_nonneg _ _ (by positivity : (0:ℝ) ≤ (speeds ⟨4, by omega⟩ : ℝ))]
      rw [mul_max_of_nonneg _ _ (by norm_num : (0:ℝ) ≤ 6)]
