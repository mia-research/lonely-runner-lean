  have hrR : (r : ℝ) = p + cc * qp := by rw [hr_eq]; push_cast; ring
  have hq0R : (q : ℝ) ≠ 0 := by rw [hqR]; positivity
  have hccr : (cc : ℝ) * (2 * (rho : ℝ) + 1) / (2 * i) = (dInt : ℝ) + δ := by
    have hccR : (cc : ℝ) * (2 * (rho : ℝ) + 1) = 2 * (i : ℝ) * dInt + dRem := by
