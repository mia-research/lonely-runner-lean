/-!
# Theorem 6.1 — Bounded Speed Ratio

Source: `lrc_proof_v11_draft.md` §6.

**Statement:** If `V ≤ (n-1) * v₁` (where `v₁` is the minimum speed and `V` is the
maximum), then `t* = 1 / (n * v₁)` satisfies `circDist(v_j * t*) ≥ 1/n` for all `j`.

**Proof:** For each runner `j`:
  `v_j * t* = v_j / (n * v₁) ∈ [1/n, (n-1)/n]`
since `v₁ ≤ v_j ≤ V ≤ (n-1)*v₁`.  The value lies in `[1/n, (n-1)/n] ⊆ (0,1)`,
so `Int.fract(v_j * t*) = v_j / (n * v₁)` and
  `circDist(v_j * t*) = min(v_j/(n*v₁), 1 - v_j/(n*v₁)) ≥ 1/n`.

**Difficulty:** ROUTINE — pure arithmetic.  The proof uses no inductive hypothesis.
-/


/-! ## §6  Bounded Speed Ratio -/

/-- The explicit good time for the BSR case: `t* = 1 / (n * v₁)`. -/
noncomputable def bsr_time (n v₁ : ℕ) : ℝ := 1 / ((n : ℝ) * (v₁ : ℝ))

/-- **Lemma (BSR pre-step):** Under BSR hypothesis, `v_j / (n * v₁) ∈ [1/n, (n-1)/n]`
    for any speed `v_j` with `v₁ ≤ v_j ≤ V ≤ (n-1)*v₁`. -/
theorem bsr_range
    (n v₁ v_j : ℕ) (hn : 2 ≤ n)
    (hv1_pos : 0 < v₁)
    (hlo : v₁ ≤ v_j)
    (hhi : v_j ≤ (n - 1) * v₁) :
    (1 : ℝ) / n ≤ (v_j : ℝ) / ((n : ℝ) * (v₁ : ℝ)) ∧
    (v_j : ℝ) / ((n : ℝ) * (v₁ : ℝ)) ≤ (n - 1 : ℝ) / n := by
  have hn_r : (0 : ℝ) < n := by exact_mod_cast show 0 < n by omega
  have hv1_r : (0 : ℝ) < v₁ := Nat.cast_pos.mpr hv1_pos
  have hlo_r : (v₁ : ℝ) ≤ v_j := by exact_mod_cast hlo
  constructor
  · -- Lower bound: 1/n ≤ v_j/(n*v₁) ↔ v₁ ≤ v_j (cross-multiply by n*(n*v₁) > 0)
    rw [div_le_div_iff₀ hn_r (mul_pos hn_r hv1_r)]
    nlinarith
  · -- Upper bound: v_j/(n*v₁) ≤ (n-1)/n ↔ n*v_j ≤ (n-1)*(n*v₁)
    -- (n-1:ℝ) elaborates as real subtraction (n:ℝ)-1, so this is rfl or ring.
    have hn1_cast : (n - 1 : ℝ) = (n : ℝ) - 1 := by ring
    rw [hn1_cast, div_le_div_iff₀ (mul_pos hn_r hv1_r) hn_r]
    have hhi_r : (v_j : ℝ) ≤ ((n - 1 : ℕ) : ℝ) * v₁ := by exact_mod_cast hhi
    have hn1_nat : ((n - 1 : ℕ) : ℝ) = (n : ℝ) - 1 := by
      push_cast [show 1 ≤ n from by omega]; ring
    rw [hn1_nat] at hhi_r
    nlinarith

/-- **Key step:** If `r ∈ [1/n, (n-1)/n]` and `r ∈ [0,1)`, then `circDist r ≥ 1/n`. -/
theorem circDist_of_range (r : ℝ) (h1 : 1 / n ≤ r) (h2 : r ≤ (n - 1) / n) (hn : 0 < n) :
    -- Here n : ℝ in this context
    min r (1 - r) ≥ 1 / n := by
  rw [ge_iff_le, le_min_iff]
  refine ⟨h1, ?_⟩
  have : (n - 1) / n + 1 / n = 1 := by field_simp; ring
  linarith

/-- **Theorem 6.1** (Bounded Speed Ratio).

    Let `n ≥ 3` and let `speeds : Fin (n-1) → ℕ` be strictly increasing positive
    integer speeds with maximum speed `V = speeds ⟨n-2, _⟩ ≤ (n-1) * speeds ⟨0, _⟩`.
    Then `t* = 1 / (n * speeds 0)` satisfies `circDist (speeds i * t*) ≥ 1/n` for all `i`. -/
theorem theorem61_BSR
    (n : ℕ) (hn : 3 ≤ n)
    (speeds : Fin (n - 1) → ℕ)
    (hpos : ∀ i, 0 < speeds i)
    (hmono : StrictMono speeds)
    (hV : speeds ⟨n - 2, by omega⟩ ≤ (n - 1) * speeds ⟨0, by omega⟩) :
    ∀ i : Fin (n - 1),
      circDist ((speeds i : ℝ) * bsr_time n (speeds ⟨0, by omega⟩)) ≥
      (1 : ℝ) / (n : ℝ) := by
  intro i
  -- Abbreviations
  set v₁ := speeds ⟨0, by omega⟩ with hv1_def
  set vᵢ := speeds i with hvi_def
  -- Positivity casts
  have hn_r  : (0 : ℝ) < n := by exact_mod_cast show 0 < n by omega
  have hv1_r : (0 : ℝ) < v₁ := Nat.cast_pos.mpr (hpos ⟨0, by omega⟩)
  -- Step 1: bounds on the index i
  have hlo_i : v₁ ≤ vᵢ := by
    by_cases h : (i : ℕ) = 0
    · -- i = ⟨0, _⟩, so vᵢ = v₁
      have heq : i = ⟨0, by omega⟩ := Fin.ext h
      simp [vᵢ, v₁, heq]
    · -- 0 < i, so strict monotonicity gives v₁ < vᵢ
      have hlt : (⟨0, by omega⟩ : Fin (n - 1)) < i := by
        simp [Fin.lt_def]; omega
      exact Nat.le_of_lt (hmono hlt)
  have hhi_i : vᵢ ≤ (n - 1) * v₁ := by
    have hle : i ≤ ⟨n - 2, by omega⟩ := by
      simp only [Fin.le_iff_val_le_val]; omega
    calc vᵢ ≤ speeds ⟨n - 2, by omega⟩ := hmono.monotone hle
      _ ≤ (n - 1) * v₁ := hV
  -- Step 2: v_i * t* = v_i/(n*v₁) ∈ [1/n, (n-1)/n]
  have hval : (vᵢ : ℝ) * bsr_time n v₁ = (vᵢ : ℝ) / ((n : ℝ) * (v₁ : ℝ)) := by
    simp only [bsr_time]; ring
  -- Get range
  obtain ⟨hlo_r, hhi_r⟩ := bsr_range n v₁ vᵢ (by omega) (hpos ⟨0, by omega⟩) hlo_i hhi_i
  -- Normalise (n-1:ℝ) = (n:ℝ) - 1
  have hn1 : (n - 1 : ℝ) = (n : ℝ) - 1 := by ring
  rw [hn1] at hhi_r
  -- Step 3: value is in [0,1) so Int.fract equals the value
  have hnn  : (0 : ℝ) ≤ (vᵢ : ℝ) / ((n : ℝ) * (v₁ : ℝ)) :=
    le_trans (div_nonneg one_pos.le hn_r.le) hlo_r
  have hlt1 : (vᵢ : ℝ) / ((n : ℝ) * (v₁ : ℝ)) < 1 := by
    have : ((n : ℝ) - 1) / n < 1 := by rw [div_lt_one hn_r]; linarith
    linarith
  have hfract : Int.fract ((vᵢ : ℝ) / ((n : ℝ) * (v₁ : ℝ))) =
                (vᵢ : ℝ) / ((n : ℝ) * (v₁ : ℝ)) := by
    have hfl : ⌊(vᵢ : ℝ) / ((n : ℝ) * (v₁ : ℝ))⌋ = (0 : ℤ) := by
      set r := (vᵢ : ℝ) / ((n : ℝ) * (v₁ : ℝ))
      have h1 : (0 : ℤ) ≤ ⌊r⌋ := Int.floor_nonneg.mpr hnn
      have h2 : ⌊r⌋ < (1 : ℤ) := by rw [Int.floor_lt]; exact_mod_cast hlt1
      omega
    simp [Int.fract, hfl]
  -- Step 4: unfold circDist, rewrite by hval and hfract, then conclude
  rw [ge_iff_le]
  unfold circDist
  rw [hval, hfract]
  exact circDist_of_range _ hlo_r hhi_r hn_r

/-- Edge case: at the BSR boundary `V = (n-1)*v₁`, Theorem 6.1 still works. -/
example : (3 : ℕ) ≤ 3 := le_refl 3  -- sanity check

/-- Numerical check: n=3, v₁=1, V=2. t* = 1/3.
    circDist(1 * 1/3) = 1/3 ✓
    circDist(2 * 1/3) = circDist(2/3) = min(2/3, 1/3) = 1/3 ✓ -/
example : circDist (1 * (1 / (3 * 1 : ℝ))) = 1 / 3 := by
  unfold circDist
  norm_num [Int.fract_eq_self]

example : circDist (2 * (1 / (3 * 1 : ℝ))) = 1 / 3 := by
  unfold circDist
  norm_num [Int.fract_eq_self]

end


/-
───────────────────────────────────────────────────────────────────────────────
  PART 3: Lemma41_PositiveMeasure.lean
───────────────────────────────────────────────────────────────────────────────
-/
section

/-!
# Lemma 4.1 — Positive-Measure Lemma

Source: `lrc_proof_v11_draft.md` §4.

**Statement:** If LRC holds for `n-1` runners (i.e. `H(n-1)` holds), then the
simultaneous good set `G_s` for the `n-2` slow runners has positive Lebesgue measure.
Moreover, it contains a non-degenerate closed interval.

**Proof sketch:**
1. `H(n-1)` gives `t**` with `circDist(v_j * t**) ≥ 1/(n-1)` for all slow `j`.
2. Since `1/(n-1) > 1/n`, `t**` lies in the open interior of every `goodSet v_j n`.
3. By Lipschitz continuity of `t ↦ circDist(v_j * t)` (Lipschitz constant `v_j`),
   a neighbourhood `(t** - δ, t** + δ)` is contained in each `goodSet v_j n`.
4. Taking `δ = 1 / (n * (n-1) * v_{n-2})` yields the explicit bound.

This lemma converts the bare existence given by the inductive hypothesis into
the positive-measure input that Weyl equidistribution (Theorem 5.2) requires.
-/


open MeasureTheory Set

/-! ## §4  Positive-Measure Lemma -/

-- Note: `circDist_lipschitz : LipschitzWith 1 circDist` is proved in Defs.lean.
-- Here we record that the composition `t ↦ circDist(v*t)` satisfies the key
-- distance bound used in Lemma 4.1's neighbourhood argument.

/-- The neighbourhood radius from Lemma 4.1's explicit bound (★).
    Written with explicit ℝ coercions to avoid elaboration through ℤ. -/
noncomputable def lemma41_delta (n : ℕ) (vmax : ℕ) : ℝ :=
  1 / ((n : ℝ) * ((n : ℝ) - 1) * (vmax : ℝ))

/-- **Lemma 4.1** (Positive-Measure Lemma).

    Given `H(n-1)` (LRC for n-1 runners), and slow runners `v₁ < ... < v_{n-2}`,
    the simultaneous good set `G_s = ⋂_j goodSet v_j n` has positive measure.
    Specifically, it contains the closed interval `[t** - δ, t** + δ]`
    where `δ = 1 / (n * (n-1) * v_{n-2})`. -/
theorem lemma41_positive_measure
    {k n : ℕ} (hn : 3 ≤ n) (hk : k = n - 2)
    (speeds : Fin k → ℕ)
    (hpos : ∀ i, 0 < speeds i)
    (hmono : StrictMono speeds)
    (Hn : H n) :
    ∃ (t_star : ℝ) (δ : ℝ), 0 < δ ∧
      lemma41_delta n (speeds ⟨k - 1, by omega⟩) ≤ δ ∧
      Icc (t_star - δ) (t_star + δ) ⊆ jointGoodSet speeds n ∧
      0 < MeasureTheory.volume (jointGoodSet speeds n) := by
  -- Step 1: intLRC (n-1) from H n (since n-1 < n).
  -- intLRC (n-1) gives a good time for Fin (n-2) = Fin k runners at threshold 1/(n-1).
  -- NORMALISATION: intLRC requires Finset.gcd = 1; we normalise by dividing by the gcd
  -- and scale the witness by 1/d.
  have Hn1_applied : ∃ t : ℝ, ∀ i : Fin k,
      circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / ((n - 1 : ℕ) : ℝ) := by
    have hLRC : intLRC (n - 1) := Hn (n - 1) (by omega)
    have h_eq : n - 1 - 1 = k := by omega
    set slowK : Fin (n - 1 - 1) → ℕ := speeds ∘ Fin.cast h_eq with hslowK_def
    have hslowK_pos : ∀ i, 0 < slowK i := fun i => hpos (Fin.cast h_eq i)
    set d : ℕ := Finset.gcd Finset.univ slowK with hd_def
    have hd_pos : 0 < d := by
      rw [hd_def, Nat.pos_iff_ne_zero, Finset.gcd_ne_zero_iff]
      exact ⟨⟨0, by omega⟩, Finset.mem_univ _, (hslowK_pos _).ne'⟩
    have hd_dvd : ∀ i, d ∣ slowK i := fun i => Finset.gcd_dvd (Finset.mem_univ i)
    let normalSpeeds : Fin (n - 1 - 1) → ℕ := fun i => slowK i / d
    have hnorm_mul : ∀ i, d * normalSpeeds i = slowK i :=
      fun i => Nat.mul_div_cancel' (hd_dvd i)
    have hnorm_pos : ∀ i, 0 < normalSpeeds i := fun i =>
      Nat.div_pos (Nat.le_of_dvd (hslowK_pos i) (hd_dvd i)) hd_pos
    have hnorm_mono : StrictMono normalSpeeds := by
      intro a b hab
      have h1 : slowK a < slowK b := hmono hab
      have h2 : d * normalSpeeds a < d * normalSpeeds b := by
        rw [hnorm_mul, hnorm_mul]; exact h1
      exact Nat.lt_of_mul_lt_mul_left h2
    have hnorm_gcd : Finset.gcd Finset.univ normalSpeeds = 1 :=
      Finset.gcd_div_eq_one (Finset.mem_univ (⟨0, by omega⟩ : Fin (n - 1 - 1)))
        (hslowK_pos _).ne'
    obtain ⟨t, ht⟩ := hLRC normalSpeeds hnorm_mono hnorm_pos hnorm_gcd
    refine ⟨t / d, fun i => ?_⟩
    set i' : Fin (n - 1 - 1) := Fin.cast h_eq.symm i with hi'_def
    have h_cast : Fin.cast h_eq i' = i := Fin.ext rfl
    have hs : slowK i' = speeds i := by
      show speeds (Fin.cast h_eq i') = speeds i
      rw [h_cast]
    have h_speeds : (speeds i : ℝ) = (d : ℝ) * (normalSpeeds i' : ℝ) := by
      have hn : d * normalSpeeds i' = slowK i' := hnorm_mul i'
      have : (speeds i : ℕ) = d * normalSpeeds i' := by rw [← hs]; exact hn.symm
      exact_mod_cast this
    have hd_ne : (d : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hd_pos.ne'
    have h_mul : (speeds i : ℝ) * (t / d) = (normalSpeeds i' : ℝ) * t := by
      rw [h_speeds]; field_simp
    rw [h_mul]; exact ht i'
  obtain ⟨t_star, ht_star⟩ := Hn1_applied
  -- Step 2: t** is in the strict interior of each goodSet speeds_i n.
  have h_strict : ∀ i : Fin k,
      circDist ((speeds i : ℝ) * t_star) > (1 : ℝ) / (n : ℝ) := by
    intro i
    have h1 : circDist ((speeds i : ℝ) * t_star) ≥ 1 / ((n - 1 : ℕ) : ℝ) := ht_star i
    have h2 : (1 : ℝ) / ((n - 1 : ℕ) : ℝ) > 1 / (n : ℝ) := by
      -- ((n-1 : ℕ) : ℝ) = (n : ℝ) - 1 when 1 ≤ n.
      have h_cast : ((n - 1 : ℕ) : ℝ) = (n : ℝ) - 1 := by
        push_cast [show 1 ≤ n from by omega]; ring
      have hn1_pos : (0 : ℝ) < (n : ℝ) - 1 := by
        have := show (2 : ℝ) ≤ n by exact_mod_cast show 2 ≤ n by omega
        linarith
      rw [h_cast, gt_iff_lt]
      -- 1/(n : ℝ) < 1/((n : ℝ) - 1) since 0 < n-1 < n.
      exact one_div_lt_one_div_of_lt hn1_pos (by linarith)
    linarith
  -- Step 3: Lipschitz → explicit neighbourhood.
  -- For each i: circDist(v_i * t) > 1/n for t in (t** - δ_i, t** + δ_i)
  -- where δ_i = (circDist(v_i * t**) - 1/n) / v_i ≥ (1/(n-1) - 1/n) / v_i
  --           = 1/(n(n-1)v_i).
  -- Taking minimum over i gives δ ≥ 1/(n(n-1) * v_{n-2}).
  let vmax : ℕ := if k = 0 then 1 else speeds ⟨k - 1, by omega⟩
  let δ := lemma41_delta n vmax
  -- Common positivity facts reused across goals
  have hn_r   : (0 : ℝ) < n := by exact_mod_cast show 0 < n by omega
  have hn1_r  : (0 : ℝ) < (n : ℝ) - 1 := by
    have : (2 : ℝ) ≤ n := by exact_mod_cast show 2 ≤ n by omega
    linarith
  have hvmax_pos : 0 < vmax := by
    simp only [vmax]; split_ifs with hk0
    · exact Nat.one_pos
    · exact hpos ⟨k - 1, by omega⟩
  have hvmax_r : (0 : ℝ) < vmax := by exact_mod_cast hvmax_pos
  have hδ_pos : 0 < δ := by
    dsimp only [lemma41_delta]
    exact div_pos one_pos (mul_pos (mul_pos hn_r hn1_r) hvmax_r)
  -- Key arithmetic: 1/(n-1) - vmax * δ = 1/n
  have h_arith : 1 / ((n : ℝ) - 1) - (vmax : ℝ) * δ = 1 / (n : ℝ) := by
    simp only [lemma41_delta, δ]
    field_simp [hn_r.ne', hn1_r.ne', hvmax_r.ne']
  -- Interval containment: [t* - δ, t* + δ] ⊆ jointGoodSet speeds n
  have h_sub : Set.Icc (t_star - δ) (t_star + δ) ⊆ jointGoodSet speeds n := by
    intro t ht
    simp only [jointGoodSet, Set.mem_iInter, goodSet, Set.mem_setOf_eq]
    intro i
    -- |t - t*| ≤ δ
    have ht_abs : |t - t_star| ≤ δ := by
      rw [abs_le]; exact ⟨by linarith [ht.1], by linarith [ht.2]⟩
    -- speeds i ≤ vmax (by strict monotonicity of speeds)
    have hvi_le : speeds i ≤ vmax := by
      simp only [vmax]
      split_ifs with hk0
      · exact absurd i.isLt (by omega)
      · have hi := i.isLt
        apply hmono.monotone
        -- i ≤ ⟨k-1, _⟩ as Fin k is definitionally i.val ≤ k-1
        change i.val ≤ k - 1
        omega
    -- Lipschitz: dist(circDist(v*t), circDist(v*t*)) ≤ v * |t - t*| ≤ v * δ
    have h_combined :
        dist (circDist ((speeds i : ℝ) * t)) (circDist ((speeds i : ℝ) * t_star)) ≤
        (speeds i : ℝ) * δ := by
      -- Step 1: 1-Lipschitz of circDist gives dist(circDist a, circDist b) ≤ dist a b
      have h1 : dist (circDist ((speeds i : ℝ) * t)) (circDist ((speeds i : ℝ) * t_star)) ≤
                dist ((speeds i : ℝ) * t) ((speeds i : ℝ) * t_star) := by
        have := circDist_lipschitz.dist_le_mul
                   ((speeds i : ℝ) * t) ((speeds i : ℝ) * t_star)
        simpa [NNReal.coe_one, one_mul] using this
      -- Step 2: dist(v*t, v*t*) = v * |t - t*| ≤ v * δ
      have h2 : dist ((speeds i : ℝ) * t) ((speeds i : ℝ) * t_star) ≤ (speeds i : ℝ) * δ := by
        rw [Real.dist_eq,
            show (speeds i : ℝ) * t - (speeds i : ℝ) * t_star =
                 (speeds i : ℝ) * (t - t_star) from by ring,
            abs_mul, abs_of_nonneg (Nat.cast_nonneg _)]
        exact mul_le_mul_of_nonneg_left ht_abs (Nat.cast_nonneg _)
      exact h1.trans h2
    -- Extract lower bound: circDist(v*t) ≥ circDist(v*t*) - v * δ
    have h_lower : circDist ((speeds i : ℝ) * t) ≥
                   circDist ((speeds i : ℝ) * t_star) - (speeds i : ℝ) * δ := by
      have habs : |circDist ((speeds i : ℝ) * t) - circDist ((speeds i : ℝ) * t_star)| ≤
                  (speeds i : ℝ) * δ := by rwa [← Real.dist_eq]
      linarith [(abs_le.mp habs).1]
    -- circDist(v*t*) ≥ 1/(n-1)
    have h_tstar : circDist ((speeds i : ℝ) * t_star) ≥ 1 / ((n : ℝ) - 1) := by
      have hi := ht_star i
      have h_cast : ((n - 1 : ℕ) : ℝ) = (n : ℝ) - 1 := by
        push_cast [show 1 ≤ n from by omega]; ring
      rwa [ge_iff_le, ← h_cast]
    -- v_i * δ ≤ vmax * δ
    have hvi_delta : (speeds i : ℝ) * δ ≤ (vmax : ℝ) * δ :=
      mul_le_mul_of_nonneg_right (by exact_mod_cast hvi_le) (le_of_lt hδ_pos)
    -- Combine: circDist(v*t) ≥ 1/(n-1) - vmax*δ = 1/n
    linarith [h_lower, h_tstar, hvi_delta, h_arith]
  have hδ_lb : lemma41_delta n (speeds ⟨k - 1, by omega⟩) ≤ δ := by
    have hk_ne : k ≠ 0 := by omega
    change lemma41_delta n (speeds ⟨k - 1, by omega⟩) ≤
           lemma41_delta n (if k = 0 then 1 else speeds ⟨k - 1, by omega⟩)
    simp [hk_ne]
  refine ⟨t_star, δ, hδ_pos, hδ_lb, h_sub, ?_⟩
  -- μ(jointGoodSet) > 0 (from interval containment + δ > 0)
  apply lt_of_lt_of_le _ (MeasureTheory.measure_mono h_sub)
  rw [Real.volume_Icc]
  apply ENNReal.ofReal_pos.mpr
  linarith

/-- Quantitative form: the measure of `jointGoodSet` is at least `2 * δ`. -/
theorem lemma41_measure_lower_bound
    {k n : ℕ} (hn : 3 ≤ n) (hk : k = n - 2)
    (speeds : Fin k → ℕ)
    (hpos : ∀ i, 0 < speeds i)
    (hmono : StrictMono speeds)
    (Hn : H n) :
    MeasureTheory.volume (jointGoodSet speeds n) ≥
      ENNReal.ofReal (2 * lemma41_delta n (speeds ⟨k - 1, by omega⟩)) := by
  obtain ⟨t_star, δ, hδ_pos, hδ_lb, h_sub, _⟩ :=
    lemma41_positive_measure hn hk speeds hpos hmono Hn
  calc ENNReal.ofReal (2 * lemma41_delta n (speeds ⟨k - 1, by omega⟩))
      ≤ ENNReal.ofReal (2 * δ) := by
        apply ENNReal.ofReal_le_ofReal; linarith
    _ = MeasureTheory.volume (Set.Icc (t_star - δ) (t_star + δ)) := by
        rw [Real.volume_Icc]; congr 1; ring
    _ ≤ MeasureTheory.volume (jointGoodSet speeds n) :=
        MeasureTheory.measure_mono h_sub

end


/-
───────────────────────────────────────────────────────────────────────────────
  PART 4: Theorem71_LargeSR.lean
───────────────────────────────────────────────────────────────────────────────
-/
section

/-!
# Theorem 7.1 — Large Speed Ratio

Source: `lrc_proof_v11_draft.md` §7.

**Statement:** If `V > (n-1) * v_{n-2}` (where `v_{n-2}` is the second-largest speed),
then there exists `t` with `circDist(v_j * t) ≥ 1/n` for all `j`.

**Proof sketch:**
1. Get `t**` from `H(n-1)` with `circDist(v_j * t**) ≥ 1/(n-1)` for slow runners.
2. By Lemma 4.1, `I = [t** - δ, t** + δ] ⊆ G_s` with `δ = 1/(n(n-1)v_{n-2})`.
3. Each connected component of `B_V` (bad set for V) has width `2/(nV) < 2δ = |I|`.
4. No single bad component covers all of `I`, so `I ∩ G_V ≠ ∅`.

**Difficulty:** MODERATE — interval arithmetic, two sub-cases for the geometric argument.
-/


open MeasureTheory Set

/-! ## §7  Large Speed Ratio -/

/-- Width of a connected component of `badSet V n`: each component is an interval
    of length `2/(n*V)` centred at some integer multiple of `1/V`. -/
theorem badSet_component_width (V n : ℕ) (hV : 0 < V) (hn : 1 < n) :
    ∀ k : ℤ,
      (badSet V n) ∩ Set.Ioo ((k : ℝ) / V - 1 / (n * V)) ((k : ℝ) / V + 1 / (n * V)) =
      Set.Ioo ((k : ℝ) / V - 1 / (n * V)) ((k : ℝ) / V + 1 / (n * V)) := by
  intro k
  rw [Set.inter_eq_right]
  -- Show: every t in the open interval satisfies circDist(V*t) < 1/n (i.e. t ∈ badSet V n).
  intro t ht
  simp only [badSet, goodSet, Set.mem_compl_iff, Set.mem_setOf_eq, not_le]
  -- Reals positivity helpers
  have hV_r : (0 : ℝ) < V := Nat.cast_pos.mpr hV
  have hn_r : (0 : ℝ) < n := by exact_mod_cast show 0 < n by omega
  -- Key bound: 1/n ≤ 1/2 (since n ≥ 2, as hn : 1 < n)
  have h1n : (1 : ℝ) / n ≤ 1 / 2 :=
    one_div_le_one_div_of_le (by norm_num) (by exact_mod_cast show 2 ≤ n by omega)
  -- Extract interval membership
  rw [Set.mem_Ioo] at ht
  -- V*t ∈ (k - 1/n, k + 1/n) via field arithmetic
  have ht_lo : (k : ℝ) - 1 / n < (V : ℝ) * t := by
    have h := ht.1
    have heq : (V : ℝ) * ((k : ℝ) / V - 1 / ((n : ℝ) * V)) = k - 1 / n := by
      field_simp [hV_r.ne', hn_r.ne']
    linarith [mul_lt_mul_of_pos_left h hV_r, heq.symm.le]
  have ht_hi : (V : ℝ) * t < (k : ℝ) + 1 / n := by
    have h := ht.2
    have heq : (V : ℝ) * ((k : ℝ) / V + 1 / ((n : ℝ) * V)) = k + 1 / n := by
      field_simp [hV_r.ne', hn_r.ne']
    linarith [mul_lt_mul_of_pos_left h hV_r, heq.le]
  -- Case split: V*t < k or V*t ≥ k
  unfold circDist
  rcases lt_or_ge ((V : ℝ) * t) k with h_lt | h_ge
  · -- V*t ∈ (k-1/n, k): floor(V*t) = k-1
    have hfl : ⌊(V : ℝ) * t⌋ = k - 1 := by
      apply Int.floor_eq_iff.mpr
      constructor
      · push_cast; linarith [h1n]   -- k-1 ≤ V*t: from ht_lo and 1/n ≤ 1/2 ≤ 1
      · push_cast; linarith         -- V*t < k: direct from h_lt
    rw [Int.fract, hfl]
    push_cast
    -- fract = V*t - (k-1) = V*t - k + 1 ∈ (1-1/n, 1)
    -- circDist = min(fract, 1-fract) = k - V*t (the smaller piece) < 1/n
    have hfrac_lo : (V : ℝ) * t - (↑k - 1) > 1 - 1 / n := by linarith
    have hfrac_hi : (V : ℝ) * t - (↑k - 1) < 1 := by linarith
    rw [show 1 - ((V : ℝ) * t - (↑k - 1)) = ↑k - (V : ℝ) * t by ring]
    -- min(V*t-(k-1), k-V*t): since k-V*t < 1/n ≤ 1/2 < V*t-(k-1), min = k-V*t
    rw [min_comm]
    rw [min_eq_left (by linarith [h1n])]  -- k-V*t ≤ V*t-(k-1): since k-V*t<1/2<V*t-(k-1)
    linarith                               -- k-V*t < 1/n from ht_lo
  · -- V*t ≥ k: floor(V*t) = k (since V*t < k + 1/n ≤ k+1)
    have hfl : ⌊(V : ℝ) * t⌋ = k := by
      apply Int.floor_eq_iff.mpr
      constructor
      · exact_mod_cast h_ge
      · push_cast; linarith [h1n]   -- V*t < k+1: from ht_hi and 1/n ≤ 1/2 ≤ 1
    rw [Int.fract, hfl]
    push_cast
    -- fract = V*t - k ∈ [0, 1/n) ⊆ [0, 1/2)
    have hfrac_nn : (V : ℝ) * t - k ≥ 0 := by linarith
    have hfrac_lt : (V : ℝ) * t - k < 1 / n := by linarith
    rw [min_eq_left (by linarith [h1n])]   -- V*t-k ≤ 1-(V*t-k): since V*t-k<1/n≤1/2
    linarith

/-- **Key geometric lemma:** Any interval `[a, b]` with length `> 2/(n*V)` intersects
    `goodSet V n`. Proof: if `a ∈ G_V` we are done; otherwise `a` lies inside a bad
    component centred at some integer `k/V`, and the right boundary `k/V + 1/(n*V)` lies
    strictly in `(a, b)` and has `circDist(V * (k/V + 1/(n*V))) = 1/n`. -/
theorem interval_escapes_bad
    (V n : ℕ) (hV : 0 < V) (hn : 1 < n)
    (a b : ℝ) (hlen : 2 / ((n : ℝ) * (V : ℝ)) < b - a) :
    (Set.Icc a b ∩ goodSet V n).Nonempty := by
  have hV_r : (0 : ℝ) < (V : ℝ) := Nat.cast_pos.mpr hV
  have hn_r : (0 : ℝ) < (n : ℝ) := by exact_mod_cast show 0 < n by omega
  have h1n : (1 : ℝ) / (n : ℝ) ≤ 1 / 2 :=
    one_div_le_one_div_of_le (by norm_num) (by exact_mod_cast show 2 ≤ n by omega)
  have hab : a < b := by linarith [div_pos (by norm_num : (0:ℝ) < 2) (mul_pos hn_r hV_r)]
  -- Auxiliary: circDist(k + 1/n) ≥ 1/n for any integer k (it equals 1/n exactly).
  have boundary_good : ∀ k : ℤ, (k : ℝ) / (V : ℝ) + 1 / ((n : ℝ) * (V : ℝ)) ∈ goodSet V n := by
    intro k
    simp only [goodSet, Set.mem_setOf_eq, ge_iff_le]
    have hVc : (V : ℝ) * ((k : ℝ) / V + 1 / ((n : ℝ) * V)) = (k : ℝ) + 1 / (n : ℝ) := by
      field_simp [hV_r.ne', hn_r.ne']
    rw [hVc]; unfold circDist
    have h1n_pos : (0 : ℝ) < 1 / (n : ℝ) := div_pos one_pos hn_r
    have h1n_lt1 : (1 : ℝ) / (n : ℝ) < 1 := by
      rw [div_lt_one hn_r]; exact_mod_cast show 1 < n by omega
    have hfl : ⌊(k : ℝ) + 1 / (n : ℝ)⌋ = k := Int.floor_eq_iff.mpr
      ⟨by push_cast; linarith [h1n_pos.le], by push_cast; linarith⟩
    rw [Int.fract, hfl]; push_cast
    -- k + 1/n - k simplifies to 1/n; then le_min holds by le_rfl and h1n
    have hsimpl : (k : ℝ) + 1 / n - k = 1 / n := by ring
    rw [hsimpl]; exact le_min le_rfl (by linarith)
  -- Case: is a ∈ goodSet V n?
  by_cases ha : a ∈ goodSet V n
  · exact ⟨a, Set.left_mem_Icc.mpr hab.le, ha⟩
  -- a is bad: circDist(V*a) < 1/n. Split on which part of min is small.
  · simp only [goodSet, Set.mem_setOf_eq, not_le] at ha
    unfold circDist at ha
    rw [min_lt_iff] at ha
    rcases ha with h_frac | h_frac
    · -- Case A: Int.fract(V*a) < 1/n.
      -- k = ⌊V*a⌋; a ∈ [k/V, k/V + 1/(nV)); right boundary c = k/V + 1/(nV) is in (a,b).
      set k := ⌊(V : ℝ) * a⌋ with hk_def
      have hk_le : (k : ℝ) ≤ (V : ℝ) * a := Int.floor_le _
      -- hkr connects the ℝ-cast of k with ↑⌊V*a⌋ so linarith can use h_frac
      have hkr : (k : ℝ) = ↑⌊(V : ℝ) * a⌋ := by exact_mod_cast hk_def
      -- h_frac : Int.fract(V*a) < 1/n means V*a - ↑⌊V*a⌋ < 1/n, i.e. V*a - k < 1/n
      rw [Int.fract] at h_frac; push_cast at h_frac
      set c := (k : ℝ) / (V : ℝ) + 1 / ((n : ℝ) * (V : ℝ)) with hc_def
      -- a < c: V*a - k < 1/n (from h_frac via hkr) → V*a < k + 1/n = V*c → a < c
      have hca : a < c := by
        have hVc : (V : ℝ) * c = (k : ℝ) + 1 / (n : ℝ) := by
          simp only [hc_def]; field_simp [hV_r.ne', hn_r.ne']
        have hVa_lt_Vc : (V : ℝ) * a < (V : ℝ) * c := by rw [hVc]; linarith [hkr]
        exact lt_of_mul_lt_mul_left hVa_lt_Vc (le_of_lt hV_r)
      -- c < b: work in V-scaled world — V*c = k+1/n ≤ V*a+1/n < V*a+2/n < V*b
      have hcb : c < b := by
        have hVc : (V : ℝ) * c = (k : ℝ) + 1 / n := by
          simp only [hc_def]; field_simp [hV_r.ne', hn_r.ne']
        have hVak : (V : ℝ) * a - k < 1 / n := by linarith [hkr]
        have h12n : (1 : ℝ) / n + 1 / n = 2 / n := by ring
        have hmul := mul_lt_mul_of_pos_right hlen hV_r
        have h2nVV : (2 : ℝ) / ((n : ℝ) * V) * V = 2 / n := by
          field_simp [hV_r.ne', hn_r.ne']
        have hVba : (1 : ℝ) / n < (V : ℝ) * (b - a) := by
          linarith [mul_comm (b - a) (V : ℝ), h2nVV, h12n, div_pos one_pos hn_r]
        have hVab : (V : ℝ) * b = (V : ℝ) * a + V * (b - a) := by ring
        exact lt_of_mul_lt_mul_left
          (by linarith [hVc, hVak, hVba, hVab, hk_le] : (V : ℝ) * c < V * b)
          (le_of_lt hV_r)
      exact ⟨c, ⟨le_of_lt hca, le_of_lt hcb⟩, boundary_good k⟩
    · -- Case B: 1 - Int.fract(V*a) < 1/n, i.e., fract(V*a) > 1 - 1/n.
      -- k = ⌊V*a⌋ + 1; a ∈ (k/V - 1/(nV), k/V); right boundary c = k/V + 1/(nV) is in (a,b).
      set k := ⌊(V : ℝ) * a⌋ + 1 with hk_def
      -- hkr: real cast of k = ↑⌊V*a⌋ + 1; used in hk_lt and hk_lo
      have hkr : (k : ℝ) = ↑⌊(V : ℝ) * a⌋ + 1 := by exact_mod_cast hk_def
      have hk_lt : (V : ℝ) * a < (k : ℝ) := by
        linarith [Int.lt_floor_add_one ((V : ℝ) * a), hkr]
      -- h_frac says 1 - fract(V*a) < 1/n, i.e., k - V*a < 1/n, i.e., V*a > k - 1/n
      have hk_lo : (k : ℝ) - 1 / (n : ℝ) < (V : ℝ) * a := by
        rw [Int.fract] at h_frac; push_cast at h_frac
        linarith [hkr]
      set c := (k : ℝ) / (V : ℝ) + 1 / ((n : ℝ) * (V : ℝ)) with hc_def
      -- a < c: V*a < k < k + 1/n = V*c, so V*a < V*c, hence a < c
      have hca : a < c := by
        have hVc : (V : ℝ) * c = (k : ℝ) + 1 / (n : ℝ) := by
          simp only [hc_def]; field_simp [hV_r.ne', hn_r.ne']
        have hVa_lt_Vc : (V : ℝ) * a < (V : ℝ) * c := by
          rw [hVc]; linarith [hk_lt, div_pos one_pos hn_r]
        exact lt_of_mul_lt_mul_left hVa_lt_Vc (le_of_lt hV_r)
      -- c < b: k/V - 1/(nV) < a and c = (k/V - 1/(nV)) + 2/(nV) < a + (b-a) = b
      have hcb : c < b := by
        have heq : (V : ℝ) * ((k : ℝ) / V - 1 / (n * V)) = (k : ℝ) - 1 / n := by
          field_simp [hV_r.ne', hn_r.ne']
        have ha_lb : (k : ℝ) / (V : ℝ) - 1 / ((n : ℝ) * (V : ℝ)) < a := by
          have hmul : (V : ℝ) * ((k : ℝ) / V - 1 / (n * V)) < (V : ℝ) * a := by
            linarith [heq, hk_lo]
          exact lt_of_mul_lt_mul_left hmul (le_of_lt hV_r)
        -- spread: c = (k/V - 1/(nV)) + 2/(nV), so c - a < 2/(nV) < b - a
        have h2nV : (1 : ℝ) / ((n : ℝ) * V) + 1 / (n * V) = 2 / (n * V) := by ring
        linarith [ha_lb, hc_def, h2nV, hlen]
      exact ⟨c, ⟨le_of_lt hca, le_of_lt hcb⟩, boundary_good k⟩

/-- **Theorem 7.1** (Large Speed Ratio).

    Suppose `V > (n-1) * v_{n-2}` (where `v_{n-2}` is the second-largest slow runner's speed).
    Then under `H(n-1)`, there exists `t₀ ∈ G_s ∩ G_V`. -/
theorem theorem71_LargeSR
    (n : ℕ) (hn : 3 ≤ n)
    (slowSpeeds : Fin (n - 2) → ℕ)
    (V : ℕ)
    (hpos : ∀ i, 0 < slowSpeeds i)
    (hmono : StrictMono slowSpeeds)
    (hV_large : (n - 1) * slowSpeeds ⟨n - 3, by omega⟩ < V)
    (Hn : H n) :
    ∃ t₀ : ℝ,
      (∀ i, circDist ((slowSpeeds i : ℝ) * t₀) ≥ (1 : ℝ) / n) ∧
      circDist ((V : ℝ) * t₀) ≥ (1 : ℝ) / n := by
  -- Step 1: Apply Lemma 4.1 to get a good neighbourhood for the slow runners.
  have hpm := @lemma41_positive_measure (n - 2) n hn rfl slowSpeeds hpos hmono Hn
  obtain ⟨t_star, δ, hδ_pos, hδ_lb, hI_sub, _⟩ := hpm
  -- Basic positivity
  have hV_pos : 0 < V := by
    have h := Nat.mul_pos (show 0 < n - 1 by omega) (hpos ⟨n - 3, by omega⟩)
    omega
  have hn_1 : 1 < n := by omega
  -- Reconcile Fin indices: k=n-2 so speeds ⟨k-1, _⟩ = slowSpeeds ⟨n-2-1, _⟩ = slowSpeeds ⟨n-3, _⟩
  have h_idx : slowSpeeds ⟨n - 2 - 1, by omega⟩ = slowSpeeds ⟨n - 3, by omega⟩ := by
    simp_rw [show n - 2 - 1 = n - 3 from by omega]
  rw [h_idx] at hδ_lb
  -- hδ_lb : lemma41_delta n (slowSpeeds ⟨n-3, _⟩) ≤ δ
  -- Step 2: The interval [t** - δ, t** + δ] has length 2δ > 2/(n*V).
  have hlen : 2 / ((n : ℝ) * (V : ℝ)) < (t_star + δ) - (t_star - δ) := by
    rw [show (t_star + δ) - (t_star - δ) = 2 * δ from by ring]
    have hn_r : (0 : ℝ) < n := by exact_mod_cast show 0 < n by omega
    have hV_r : (0 : ℝ) < (V : ℝ) := by exact_mod_cast hV_pos
    have hn1_r : (0 : ℝ) < (n : ℝ) - 1 := by
      have h2n : (2 : ℝ) ≤ n := by exact_mod_cast show 2 ≤ n by omega
      linarith
    have hvmax_r : (0 : ℝ) < (slowSpeeds ⟨n - 3, by omega⟩ : ℝ) := by
      exact_mod_cast hpos ⟨n - 3, by omega⟩
    have h_large : ((n - 1 : ℕ) : ℝ) * (slowSpeeds ⟨n - 3, by omega⟩ : ℝ) < V := by
      exact_mod_cast hV_large
    have h_n1 : ((n - 1 : ℕ) : ℝ) = (n : ℝ) - 1 := by
      push_cast [show 1 ≤ n from by omega]; ring
    rw [h_n1] at h_large
    -- 1/(n*V) < 1/(n*(n-1)*vmax) = lemma41_delta n vmax ≤ δ → 2/(n*V) < 2*δ
    have h_lt : 1 / ((n : ℝ) * V) < lemma41_delta n (slowSpeeds ⟨n - 3, by omega⟩) := by
      simp only [lemma41_delta]
      exact one_div_lt_one_div_of_lt
        (mul_pos (mul_pos hn_r hn1_r) hvmax_r)
        (by nlinarith)
    have h_combined : 1 / ((n : ℝ) * V) < δ := lt_of_lt_of_le h_lt hδ_lb
    have h_ring : 2 / ((n : ℝ) * V) = 2 * (1 / ((n : ℝ) * V)) := by ring
    linarith
  -- Step 3: The geometric lemma finds t₀ ∈ [t**-δ, t**+δ] ∩ goodSet V n.
  have hesc := interval_escapes_bad V n hV_pos hn_1 (t_star - δ) (t_star + δ) hlen
  obtain ⟨t₀, ht₀⟩ := hesc
  -- Step 4: Assemble the conclusion.
  refine ⟨t₀, ?_, ?_⟩
  · -- Slow runners: t₀ ∈ Icc ⊆ jointGoodSet slowSpeeds n → circDist ≥ 1/n for each.
    have ht₀_slow : t₀ ∈ jointGoodSet slowSpeeds n := hI_sub ht₀.1
    intro i
    simp only [jointGoodSet, Set.mem_iInter, goodSet, Set.mem_setOf_eq] at ht₀_slow
    exact ht₀_slow i
  · -- Fast runner V: t₀ ∈ goodSet V n from interval_escapes_bad.
    have ht₀_goodV := ht₀.2
    simp only [goodSet, Set.mem_setOf_eq] at ht₀_goodV
    exact ht₀_goodV

/-! ## §7  Boundary remark -/

-- At the boundary `V = (n-1) * v_{n-2}`, the LR argument breaks (equal widths).
-- This case falls into the hard case (§9) and is handled by Theorems 10.1 or 11.1.
-- No separate proof is needed here.

end


/-
───────────────────────────────────────────────────────────────────────────────
  PART 5: IntLRC_3.lean
───────────────────────────────────────────────────────────────────────────────
-/
section

/-!
# `intLRC 3` — Lonely Runner Conjecture for n = 3

For n = 3 the Hard Case of Lemma 9.1 is vacuous: with `speeds : Fin 2 → ℕ`,
`v_{n-2}` and `v_1` are the same speed (both `speeds ⟨0, _⟩`), so the Hard Case
`(n-1)·v_1 < V ≤ (n-1)·v_{n-2}` collapses to `2·v_1 < V ≤ 2·v_1`, which is
empty. Therefore the case split reduces to BSR ∨ LR, neither of which depends
on the sorry'd Theorem 5.2 / DI-MOD branch.

This is a real proof: it discharges `intLRC 3` without any `sorry`.
-/

open MeasureTheory Set

/-- The strong-induction premise `H 3` (intLRC holds for all `m < 3`).
    Adapted from `Theorem121_Main.lean`'s inline construction; isolated here so
    the small-n proofs do not need to depend on `Theorem121_Main`. -/
theorem H_three : H 3 := by
  intro m hm
  intro speeds _hmono hpos _hgcd
  interval_cases m
  · -- m = 0: speeds : Fin 0 → ℕ ; conclusion is over an empty index, vacuous
    exact ⟨0, fun i => i.elim0⟩
  · -- m = 1: speeds : Fin 0 → ℕ ; same as above
    exact ⟨0, fun i => i.elim0⟩
  · -- m = 2: one slow runner; t = 1/(2 v) gives circDist(v · t) = circDist(1/2) = 1/2
    refine ⟨1 / (2 * (speeds ⟨0, by omega⟩ : ℝ)), fun i => ?_⟩
    have hi : i = ⟨0, by omega⟩ := Fin.ext (by omega)
    subst hi
    have hv : (0 : ℝ) < speeds ⟨0, by omega⟩ := by exact_mod_cast hpos ⟨0, by omega⟩
    rw [show (speeds ⟨0, by omega⟩ : ℝ) * (1 / (2 * speeds ⟨0, by omega⟩)) = 1 / 2
        from by field_simp]
    have h_floor : ⌊(1 / 2 : ℝ)⌋ = (0 : ℤ) := Int.floor_eq_zero_iff.mpr (by norm_num)
    have h_frac : Int.fract (1 / 2 : ℝ) = 1 / 2 := by
      simp only [Int.fract, h_floor, Int.cast_zero, sub_zero]
    show circDist (1 / 2 : ℝ) ≥ (1 : ℝ) / 2
    unfold circDist
    rw [h_frac]
    norm_num

/-- **Main result for n = 3.**  The Lonely Runner Conjecture holds with two
    runners (`Fin 2`), positive distinct integer speeds with `gcd = 1`.

    Proof: case split on whether `V := speeds 1 ≤ 2 · speeds 0` (BSR) or not
    (LR; the Hard Case is vacuous as `v_{n-2} = v_1` for n = 3). -/
theorem intLRC_three : intLRC 3 := by
  intro speeds hmono hpos _hgcd
  -- Decompose speeds : Fin 2 → ℕ into V = speeds 1 and slowSpeeds (just speeds 0)
  let V : ℕ := speeds ⟨1, by omega⟩
  let slowSpeeds : Fin 1 → ℕ := fun _ => speeds ⟨0, by omega⟩
  have hpos_slow : ∀ i, 0 < slowSpeeds i := fun _ => hpos ⟨0, by omega⟩
  have hmono_slow : StrictMono slowSpeeds := by
    intro a b hab; exact absurd hab (by fin_cases a <;> fin_cases b <;> decide)
  -- Case split: V ≤ 2·v₁ (BSR) or 2·v₁ < V (LR). The Hard Case is vacuous.
  by_cases hBSR : V ≤ 2 * speeds ⟨0, by omega⟩
  · -- BSR Case: explicit time t* = 1/(3·v₁)
    refine ⟨bsr_time 3 (speeds ⟨0, by omega⟩), ?_⟩
    intro i
    have hV_bsr : speeds ⟨3 - 2, by omega⟩ ≤ (3 - 1) * speeds ⟨0, by omega⟩ := by
      show speeds ⟨1, by omega⟩ ≤ 2 * speeds ⟨0, by omega⟩
      exact hBSR
    exact theorem61_BSR 3 (by norm_num) speeds hpos hmono hV_bsr i
  · -- LR Case: 2·v₁ < V; apply Theorem 7.1 with H 3
    push_neg at hBSR
    have hV_large : (3 - 1) * slowSpeeds ⟨3 - 3, by omega⟩ < V := by
      show 2 * speeds ⟨0, by omega⟩ < V
      exact hBSR
    obtain ⟨t₀, ht₀_slow, ht₀_V⟩ :=
      theorem71_LargeSR 3 (by norm_num) slowSpeeds V hpos_slow hmono_slow hV_large H_three
    refine ⟨t₀, fun i => ?_⟩
    -- speeds : Fin 2 → ℕ; case on i = 0 (slow) vs i = 1 (V)
    by_cases hi : i.val = 0
    · -- Slow runner: speeds i = slowSpeeds ⟨0, _⟩
      have h := ht₀_slow ⟨0, by omega⟩
      simp only [slowSpeeds] at h
      have heq : (speeds i : ℝ) = (speeds ⟨0, by omega⟩ : ℝ) := by
        congr 2; exact Fin.ext hi
      rw [heq]; exact h
    · -- Fast runner: i.val = 1, speeds i = V
      have hi1 : i.val = 1 := by omega
      have heq : (speeds i : ℝ) = (V : ℝ) := by
        show (speeds i : ℝ) = (speeds ⟨1, by omega⟩ : ℝ)
        congr 2; exact Fin.ext hi1
      rw [heq]; exact ht₀_V

end


/-
───────────────────────────────────────────────────────────────────────────────
  PART 6: IntLRC_4_Bienia.lean
───────────────────────────────────────────────────────────────────────────────
-/
section

/-!
# Bienia et al. 1998 — proof of `intLRC 4`

Source: Bienia, Goddyn, Gvozdjak, Sebő, Tarsi (1998), "Flows, View
Obstructions and the Lonely Runner", JCTB 72:1-9, §3.

Their `k = 3` case = our `intLRC 4` (3 moving + observer, target gap 1/4).

This file builds up the proof in pieces:
1. **`intLRC_four_all_odd`** — if all three speeds are odd, `t = 1/2` works.
   (Fully proved.)
2. **`intLRC_four_pre_jump`** — TODO. If gcd of two speeds doesn't divide
   the third, reduce to `intLRC_three`.
3. **`intLRC_four_main`** — TODO. The T-interval connectedness argument
   under WLOG hypotheses.
4. **`intLRC_four_classical`** — combine 1–3.
-/

open MeasureTheory Set

/-- Periodicity of `Int.fract` under adding a natural-number cast. -/
private lemma fract_add_nat (x : ℝ) (n : ℕ) :
    Int.fract ((n : ℝ) + x) = Int.fract x :=
  Int.fract_natCast_add n x

/-- `circDist` is invariant under adding an integer. -/
private lemma circDist_add_int (x : ℝ) (n : ℤ) : circDist (x + (n : ℝ)) = circDist x := by
  unfold circDist
  rw [Int.fract_add_intCast]

/-- `circDist (1/2) = 1/2`. -/
private lemma circDist_half : circDist (1 / 2 : ℝ) = 1 / 2 := by
  unfold circDist
  have h_floor : ⌊(1 / 2 : ℝ)⌋ = 0 := Int.floor_eq_zero_iff.mpr (by norm_num)
  have h_fract : Int.fract (1 / 2 : ℝ) = 1 / 2 := by
    simp only [Int.fract, h_floor, Int.cast_zero, sub_zero]
  rw [h_fract]
  norm_num

/-- **Geometric core of the pre-jump shift.**
    Among the `m` equally spaced shifts `k/m` (`k : ℤ`), at least one places
    `y` into the closed distant arc `[1/4, 3/4]`, i.e. at `circDist ≥ 1/4`.
    Holds whenever `m ≥ 2`: consecutive shifts are `1/m ≤ 1/2` apart and the
    distant arc has width `1/2`, so no shift can "jump over" it.

    Concretely the witness is `k = ⌈m·(1/4 − y)⌉`, which forces
    `y + k/m ∈ [1/4, 1/4 + 1/m] ⊆ [1/4, 3/4]`. -/
lemma exists_shift_distant (m : ℕ) (hm : 2 ≤ m) (y : ℝ) :
    ∃ k : ℤ, circDist (y + (k : ℝ) / (m : ℝ)) ≥ (1 : ℝ) / 4 := by
  have hmR : (2 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
  have hm0 : (0 : ℝ) < (m : ℝ) := by linarith
  have hmne : (m : ℝ) ≠ 0 := ne_of_gt hm0
  have hinvm : (1 : ℝ) / (m : ℝ) ≤ 1 / 2 :=
    one_div_le_one_div_of_le (by norm_num) hmR
  refine ⟨⌈(m : ℝ) * (1 / 4 - y)⌉, ?_⟩
  set K : ℤ := ⌈(m : ℝ) * (1 / 4 - y)⌉ with hK
  have hk_lb : (m : ℝ) * (1 / 4 - y) ≤ (K : ℝ) := Int.le_ceil _
  have hk_ub : (K : ℝ) < (m : ℝ) * (1 / 4 - y) + 1 := Int.ceil_lt_add_one _
  -- Lower bound: 1/4 ≤ y + K/m.
  have hz_lb : (1 : ℝ) / 4 ≤ y + (K : ℝ) / (m : ℝ) := by
    have h : (1 / 4 - y) ≤ (K : ℝ) / (m : ℝ) :=
      (le_div_iff₀ hm0).mpr (by rw [mul_comm]; exact hk_lb)
    linarith
  -- Upper bound: y + K/m ≤ 3/4.
  have hz_ub : y + (K : ℝ) / (m : ℝ) ≤ 3 / 4 := by
    have h : (K : ℝ) / (m : ℝ) < (1 / 4 - y) + 1 / (m : ℝ) := by
      rw [div_lt_iff₀ hm0]
      have hid : ((1 / 4 - y) + 1 / (m : ℝ)) * (m : ℝ) = (m : ℝ) * (1 / 4 - y) + 1 := by
        field_simp
      rw [hid]; exact hk_ub
    linarith
  -- Conclude via circDist of a point already inside [1/4, 3/4].
  have hfr : Int.fract (y + (K : ℝ) / (m : ℝ)) = y + (K : ℝ) / (m : ℝ) :=
    Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩
  unfold circDist
  rw [hfr, ge_iff_le, le_min_iff]
  exact ⟨by linarith, by linarith⟩

/-- **Pre-jump shift, arbitrary multiplier.**
    If `d ≥ 2` and `d ∤ v`, some shift `v·K/d` (`K : ℤ`) places `y` into the
    distant arc `[1/4, 3/4]`.  The orbit `{v·K/d mod 1}` is the cyclic subgroup
    of `ℝ/ℤ` generated by `gcd(v,d)/d`, of order `d/gcd(v,d) ≥ 2`; combine
    `exists_shift_distant` (a distant point exists in any `≥2`-point equispaced
    set) with Bézout (the orbit reaches that point). -/
lemma exists_step_distant (v d : ℕ) (hd : 2 ≤ d) (hdvd : ¬ (d ∣ v)) (y : ℝ) :
    ∃ K : ℤ, circDist (y + (v : ℝ) * (K : ℝ) / (d : ℝ)) ≥ (1 : ℝ) / 4 := by
  have hd0 : 0 < d := by omega
  have he_pos : 0 < Nat.gcd v d := Nat.gcd_pos_of_pos_right v hd0
  set e : ℕ := Nat.gcd v d with he
  have he_dvd_d : e ∣ d := Nat.gcd_dvd_right v d
  have he_dvd_v : e ∣ v := Nat.gcd_dvd_left v d
  have he_ne_d : e ≠ d := fun h => hdvd (h ▸ he_dvd_v)
  have he_lt_d : e < d := lt_of_le_of_ne (Nat.le_of_dvd hd0 he_dvd_d) he_ne_d
  -- D := d / e is the order of the orbit; D ≥ 2.
  obtain ⟨mm, hmm⟩ := id he_dvd_d                  -- hmm : d = e * mm  (keep he_dvd_d)
  have hmm2 : 2 ≤ mm := by rcases mm with _ | _ | mm <;> omega
  set D : ℕ := d / e with hD
  have hD_eq : D = mm := by rw [hD, hmm, Nat.mul_div_cancel_left mm he_pos]
  have hD_ge2 : 2 ≤ D := by rw [hD_eq]; exact hmm2
  -- real-number bookkeeping
  set V : ℕ := v / e with hV
  have hveq : (e : ℝ) * (V : ℝ) = (v : ℝ) := by exact_mod_cast Nat.mul_div_cancel' he_dvd_v
  have hdeq : (e : ℝ) * (D : ℝ) = (d : ℝ) := by exact_mod_cast Nat.mul_div_cancel' he_dvd_d
  have heR : (e : ℝ) ≠ 0 := by exact_mod_cast he_pos.ne'
  have hDR : (D : ℝ) ≠ 0 := by exact_mod_cast (by omega : D ≠ 0)
  -- coprimality V, D in ℤ, then Bézout.
  have hcop : Nat.Coprime V D := Nat.coprime_div_gcd_div_gcd he_pos
  have hcopZ : IsCoprime (V : ℤ) (D : ℤ) := Nat.isCoprime_iff_coprime.mpr hcop
  obtain ⟨a, b, hab⟩ := hcopZ                       -- hab : a * V + b * D = 1
  have habR : (a : ℝ) * (V : ℝ) + (b : ℝ) * (D : ℝ) = 1 := by exact_mod_cast hab
  -- distant orbit point from the equispaced lemma
  obtain ⟨k₀, hk₀⟩ := exists_shift_distant D hD_ge2 y
  refine ⟨a * k₀, ?_⟩
  have hfinal :
      y + (v : ℝ) * ((a * k₀ : ℤ) : ℝ) / (d : ℝ)
        = (y + (k₀ : ℝ) / (D : ℝ)) + ((-(b * k₀) : ℤ) : ℝ) := by
    have h1 : (v : ℝ) * ((a * k₀ : ℤ) : ℝ) / (d : ℝ)
        = ((V : ℝ) * ((a * k₀ : ℤ) : ℝ)) / (D : ℝ) := by
      rw [← hveq, ← hdeq, mul_assoc, mul_div_mul_left _ _ heR]
    have hVa : (V : ℝ) * ((a * k₀ : ℤ) : ℝ) = (k₀ : ℝ) - (b : ℝ) * (k₀ : ℝ) * (D : ℝ) := by
      push_cast; linear_combination (k₀ : ℝ) * habR
    rw [h1, hVa]
    push_cast
    field_simp
    ring
  rw [hfinal, circDist_add_int]
  exact hk₀

/-- **Integer shift absorbs `a·K/d` when `d ∣ a`.**
    If `d ∣ a` (and `d ≠ 0`), then `a·K/d` is an integer for every `K : ℤ`,
    so adding it leaves `circDist` unchanged.  This is what keeps the *kept*
    pair `(a, b)` distant while the pre-jump shift fixes the dropped runner:
    `d = gcd(a,b)` divides both `a` and `b`. -/
lemma circDist_add_natMul_div (a d : ℕ) (hd : d ≠ 0) (hdvd : d ∣ a) (K : ℤ) (x : ℝ) :
    circDist (x + (a : ℝ) * (K : ℝ) / (d : ℝ)) = circDist x := by
  obtain ⟨m, hm⟩ := hdvd
  have hdR : (d : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hd
  have hstep : (a : ℝ) * (K : ℝ) / (d : ℝ) = (((m : ℤ) * K : ℤ) : ℝ) := by
    rw [hm]; push_cast; field_simp
  rw [hstep, circDist_add_int]

/-- **Two-runner witness, gap `1/3`, ordered coprime pair.**
    For coprime `p < q` (both positive) there is a time placing both runners
    in the distant arc at gap `1/3`.  This is exactly `intLRC 3` (two moving
    runners + observer), specialised to the explicit pair `![p, q]`. -/
lemma two_runner_third_ordered (p q : ℕ) (hp : 0 < p) (hpq : p < q)
    (hcop : Nat.Coprime p q) :
    ∃ t : ℝ, circDist ((p : ℝ) * t) ≥ (1 : ℝ) / 3 ∧ circDist ((q : ℝ) * t) ≥ (1 : ℝ) / 3 := by
  have hspeeds : StrictMono (![p, q] : Fin 2 → ℕ) := by
    intro i j hij; fin_cases i <;> fin_cases j <;> simp_all [Fin.lt_def]
  have hpos : ∀ i, 0 < (![p, q] : Fin 2 → ℕ) i := by
    rw [Fin.forall_fin_two]; exact ⟨hp, lt_trans hp hpq⟩
  have hgcd : Finset.gcd Finset.univ (![p, q] : Fin 2 → ℕ) = 1 := by
    rw [show (Finset.univ : Finset (Fin 2)) = {0, 1} from by decide,
        Finset.gcd_insert, Finset.gcd_singleton]
    simpa using hcop
  obtain ⟨t, ht⟩ := intLRC_three ![p, q] hspeeds hpos hgcd
  have h0 := ht 0; have h1 := ht 1
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Nat.cast_ofNat] at h0 h1
  exact ⟨t, h0, h1⟩

/-- **Two-runner witness, gap `1/4`, arbitrary distinct pair.**
    Divide the pair by `g = gcd(a,b)` to a coprime pair, apply
    `two_runner_third_ordered` (gap `1/3 ≥ 1/4`), and rescale time by `1/g`. -/
lemma two_runner_quarter (a b : ℕ) (ha : 0 < a) (hb : 0 < b) (hab : a ≠ b) :
    ∃ t : ℝ, circDist ((a : ℝ) * t) ≥ (1 : ℝ) / 4 ∧ circDist ((b : ℝ) * t) ≥ (1 : ℝ) / 4 := by
  have hg0 : 0 < Nat.gcd a b := Nat.gcd_pos_iff.mpr (Or.inl ha)
  have hgR : (Nat.gcd a b : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hg0.ne'
  have hcop : Nat.Coprime (a / Nat.gcd a b) (b / Nat.gcd a b) := Nat.coprime_div_gcd_div_gcd hg0
  have ha'0 : 0 < a / Nat.gcd a b := Nat.div_pos (Nat.le_of_dvd ha (Nat.gcd_dvd_left a b)) hg0
  have hb'0 : 0 < b / Nat.gcd a b := Nat.div_pos (Nat.le_of_dvd hb (Nat.gcd_dvd_right a b)) hg0
  have hae : (a : ℝ) = (a / Nat.gcd a b : ℕ) * (Nat.gcd a b : ℝ) := by
    rw [← Nat.cast_mul, Nat.div_mul_cancel (Nat.gcd_dvd_left a b)]
  have hbe : (b : ℝ) = (b / Nat.gcd a b : ℕ) * (Nat.gcd a b : ℝ) := by
    rw [← Nat.cast_mul, Nat.div_mul_cancel (Nat.gcd_dvd_right a b)]
  have ha'b' : a / Nat.gcd a b ≠ b / Nat.gcd a b := by
    intro h; apply hab
    have hreal : (a : ℝ) = (b : ℝ) := by rw [hae, hbe, h]
    exact_mod_cast hreal
  rcases lt_or_gt_of_ne ha'b' with hlt | hgt
  · obtain ⟨t', h1, h2⟩ := two_runner_third_ordered _ _ ha'0 hlt hcop
    refine ⟨t' / (Nat.gcd a b : ℝ), ?_, ?_⟩
    · rw [show (a : ℝ) * (t' / (Nat.gcd a b : ℝ)) = (a / Nat.gcd a b : ℕ) * t' from by
            rw [hae]; field_simp]; linarith
    · rw [show (b : ℝ) * (t' / (Nat.gcd a b : ℝ)) = (b / Nat.gcd a b : ℕ) * t' from by
            rw [hbe]; field_simp]; linarith
  · obtain ⟨t', h1, h2⟩ := two_runner_third_ordered _ _ hb'0 hgt hcop.symm
    refine ⟨t' / (Nat.gcd a b : ℝ), ?_, ?_⟩
    · rw [show (a : ℝ) * (t' / (Nat.gcd a b : ℝ)) = (a / Nat.gcd a b : ℕ) * t' from by
            rw [hae]; field_simp]; linarith
    · rw [show (b : ℝ) * (t' / (Nat.gcd a b : ℝ)) = (b / Nat.gcd a b : ℕ) * t' from by
            rw [hbe]; field_simp]; linarith

/-- **Pre-jump reduction (Bienia §3, step 2).**
    Keep the pair `(a, b)` with `d := gcd(a,b) ≥ 2`, drop `c` with `d ∤ c`.
    Take a base time `t₀` making `a, b` distant (`two_runner_quarter`), then
    shift by `K/d` chosen (`exists_step_distant`) so that `c` becomes distant
    too.  The shift moves `a, b` by `a·K/d, b·K/d`, both integers (`d ∣ a, b`),
    so they stay distant (`circDist_add_natMul_div`). -/
lemma pre_jump (a b c : ℕ) (ha : 0 < a) (hb : 0 < b) (hab : a ≠ b)
    (hd2 : 2 ≤ Nat.gcd a b) (hdvd : ¬ (Nat.gcd a b ∣ c)) :
    ∃ t : ℝ, circDist ((a : ℝ) * t) ≥ (1 : ℝ) / 4 ∧ circDist ((b : ℝ) * t) ≥ (1 : ℝ) / 4
           ∧ circDist ((c : ℝ) * t) ≥ (1 : ℝ) / 4 := by
  obtain ⟨t₀, ha₀, hb₀⟩ := two_runner_quarter a b ha hb hab
  obtain ⟨K, hK⟩ := exists_step_distant c (Nat.gcd a b) hd2 hdvd ((c : ℝ) * t₀)
  have hdne : Nat.gcd a b ≠ 0 := by omega
  refine ⟨t₀ + (K : ℝ) / (Nat.gcd a b : ℝ), ?_, ?_, ?_⟩
  · have he : (a : ℝ) * (t₀ + (K : ℝ) / (Nat.gcd a b : ℝ))
        = (a : ℝ) * t₀ + (a : ℝ) * (K : ℝ) / (Nat.gcd a b : ℝ) := by ring
    rw [he, circDist_add_natMul_div a (Nat.gcd a b) hdne (Nat.gcd_dvd_left a b) K ((a : ℝ) * t₀)]
    exact ha₀
  · have he : (b : ℝ) * (t₀ + (K : ℝ) / (Nat.gcd a b : ℝ))
        = (b : ℝ) * t₀ + (b : ℝ) * (K : ℝ) / (Nat.gcd a b : ℝ) := by ring
    rw [he, circDist_add_natMul_div b (Nat.gcd a b) hdne (Nat.gcd_dvd_right a b) K ((b : ℝ) * t₀)]
    exact hb₀
  · have he : (c : ℝ) * (t₀ + (K : ℝ) / (Nat.gcd a b : ℝ))
        = (c : ℝ) * t₀ + (c : ℝ) * (K : ℝ) / (Nat.gcd a b : ℝ) := by ring
    rw [he]; exact hK

/-- **Bienia §3 Step 1 — all-odd case.**
    If three positive distinct integer speeds are all odd, then `t = 1/2`
    is a witness (every runner is at distance `1/2 ≥ 1/4` from origin). -/
theorem intLRC_four_all_odd (speeds : Fin 3 → ℕ) (hodd : ∀ i, Odd (speeds i)) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 4 := by
  refine ⟨1 / 2, fun i => ?_⟩
  obtain ⟨k, hk⟩ := hodd i
  -- speeds i = 2k+1, so (speeds i : ℝ) * (1/2) = k + 1/2
  have hcast : (speeds i : ℝ) * (1 / 2) = (k : ℝ) + 1 / 2 := by
    have hnat : (speeds i : ℝ) = ((2 * k + 1 : ℕ) : ℝ) := by exact_mod_cast hk
    rw [hnat]
    push_cast
    ring
  rw [hcast]
  -- circDist((k : ℝ) + 1/2) = circDist(1/2) by periodicity
  have hperiod : circDist ((k : ℝ) + 1 / 2) = circDist (1 / 2 : ℝ) := by
    unfold circDist
    rw [fract_add_nat (1 / 2) k]
  rw [hperiod, circDist_half]
  norm_num

/-! ### Path B machinery — Bienia's T-interval connectedness argument

The pairwise-coprime, not-all-odd case has exactly one even speed `e` and two odd
speeds `o₁, o₂`.  Track `T = [1/(4e), 3/(4e)]`, the first interval on which runner `e`
is distant.  Either some `t ∈ T` has *neither* odd runner distant — then the `+1/2`
pre-jump makes all three distant — or `T ⊆ G(o₁) ∪ G(o₂)`, and connectedness of `T`
with closedness of the good-sets forces a common point `t ∈ T ∩ G(o₁) ∩ G(o₂)`. -/

private theorem circDist_le_abs_sub_int (x : ℝ) (m : ℤ) : circDist x ≤ |x - (m : ℝ)| := by
  rw [circDist_eq_infDist, ← Real.dist_eq]; exact Metric.infDist_le_dist_of_mem ⟨m, rfl⟩

/-- Any closed interval of length `> 1/2` contains a point within `1/4` of an integer. -/
theorem bad_point_of_long (α L : ℝ) (hL : 1 / 2 < L) :
    ∃ s ∈ Set.Icc α (α + L), circDist s < 1 / 4 := by
  obtain ⟨m, hm_lo, hm_hi⟩ : ∃ m : ℤ, α - 1 / 4 < (m : ℝ) ∧ (m : ℝ) ≤ α + 3 / 4 := by
    refine ⟨⌊α - 1 / 4⌋ + 1, ?_, ?_⟩
    · push_cast; linarith [Int.lt_floor_add_one (α - 1 / 4)]
    · push_cast; linarith [Int.floor_le (α - 1 / 4)]
  rcases le_or_gt α (m : ℝ) with hαm | hαm
  · rcases le_or_gt (m : ℝ) (α + L) with hmL | hmL
    · refine ⟨(m : ℝ), ⟨hαm, hmL⟩, ?_⟩
      have : circDist (m : ℝ) = 0 := by unfold circDist; rw [Int.fract_intCast]; simp
      rw [this]; norm_num
    · refine ⟨α + L, ⟨by linarith, le_refl _⟩, ?_⟩
      calc circDist (α + L) ≤ |(α + L) - (m : ℝ)| := circDist_le_abs_sub_int (α + L) m
        _ = (m : ℝ) - (α + L) := by rw [abs_of_nonpos (by linarith)]; ring
        _ < 1 / 4 := by linarith
  · refine ⟨α, ⟨le_refl _, by linarith⟩, ?_⟩
    calc circDist α ≤ |α - (m : ℝ)| := circDist_le_abs_sub_int α m
      _ = α - (m : ℝ) := by rw [abs_of_nonneg (by linarith)]
      _ < 1 / 4 := by linarith

/-- On the even runner's first-distant interval `T`, any *other* runner `v_o ≠ vₑ`
    fails to be distant somewhere: `T ⊄ goodSet v_o 4`. -/
theorem T_has_bad_point (v_e v_o : ℕ) (hve : 0 < v_e) (hvo : 0 < v_o) (hne : v_o ≠ v_e) :
    ∃ t ∈ Set.Icc (1 / (4 * (v_e : ℝ))) (3 / (4 * (v_e : ℝ))),
      circDist ((v_o : ℝ) * t) < 1 / 4 := by
  have hveR : (0 : ℝ) < (v_e : ℝ) := by exact_mod_cast hve
  have hvoR : (0 : ℝ) < (v_o : ℝ) := by exact_mod_cast hvo
  rcases lt_or_gt_of_ne hne with hlt | hgt
  · have hvolt : (v_o : ℝ) < (v_e : ℝ) := by exact_mod_cast hlt
    refine ⟨1 / (4 * (v_e : ℝ)), ⟨le_refl _, by gcongr; norm_num⟩, ?_⟩
    rw [show (v_o : ℝ) * (1 / (4 * (v_e : ℝ))) = (v_o : ℝ) / (4 * (v_e : ℝ)) from by ring]
    set x := (v_o : ℝ) / (4 * (v_e : ℝ)) with hx
    have hx0 : 0 < x := by rw [hx]; positivity
    have hx14 : x < 1 / 4 := by rw [hx, div_lt_iff₀ (by positivity)]; linarith
    unfold circDist
    rw [Int.fract_eq_self.mpr ⟨le_of_lt hx0, by linarith⟩, min_eq_left (by linarith)]; exact hx14
  · have hvogt : (v_e : ℝ) < (v_o : ℝ) := by exact_mod_cast hgt
    have hLgt : 1 / 2 < (v_o : ℝ) / (2 * (v_e : ℝ)) := by rw [lt_div_iff₀ (by positivity)]; linarith
    obtain ⟨s, hs_mem, hs_bad⟩ :=
      bad_point_of_long ((v_o : ℝ) / (4 * (v_e : ℝ))) ((v_o : ℝ) / (2 * (v_e : ℝ))) hLgt
    obtain ⟨hs_lo, hs_hi⟩ := hs_mem
    refine ⟨s / (v_o : ℝ), ⟨?_, ?_⟩, ?_⟩
    · rw [le_div_iff₀ hvoR,
        show 1 / (4 * (v_e : ℝ)) * (v_o : ℝ) = (v_o : ℝ) / (4 * (v_e : ℝ)) from by ring]
      exact hs_lo
    · rw [div_le_iff₀ hvoR, show 3 / (4 * (v_e : ℝ)) * (v_o : ℝ)
        = (v_o : ℝ) / (4 * (v_e : ℝ)) + (v_o : ℝ) / (2 * (v_e : ℝ)) from by ring]
      exact hs_hi
    · rw [mul_div_cancel₀ s (ne_of_gt hvoR)]; exact hs_bad

/-- On `T = [1/(4vₑ), 3/(4vₑ)]` the runner with speed `vₑ` is distant. -/
theorem even_runner_distant_on_T (v_e : ℕ) (hve : 0 < v_e) (t : ℝ)
    (ht : t ∈ Set.Icc (1 / (4 * (v_e : ℝ))) (3 / (4 * (v_e : ℝ)))) :
    circDist ((v_e : ℝ) * t) ≥ 1 / 4 := by
  have hveR : (0 : ℝ) < (v_e : ℝ) := by exact_mod_cast hve
  obtain ⟨hlo, hhi⟩ := ht
  have hne : (v_e : ℝ) ≠ 0 := ne_of_gt hveR
  have key1 : (v_e : ℝ) * (1 / (4 * (v_e : ℝ))) = 1 / 4 := by field_simp
  have key2 : (v_e : ℝ) * (3 / (4 * (v_e : ℝ))) = 3 / 4 := by field_simp
  have h1 : (1 : ℝ) / 4 ≤ (v_e : ℝ) * t := by
    calc (1 : ℝ) / 4 = (v_e : ℝ) * (1 / (4 * (v_e : ℝ))) := key1.symm
      _ ≤ (v_e : ℝ) * t := mul_le_mul_of_nonneg_left hlo (le_of_lt hveR)
  have h2 : (v_e : ℝ) * t ≤ 3 / 4 := by
    calc (v_e : ℝ) * t
        ≤ (v_e : ℝ) * (3 / (4 * (v_e : ℝ))) := mul_le_mul_of_nonneg_left hhi (le_of_lt hveR)
      _ = 3 / 4 := key2
  unfold circDist
  rw [Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩, ge_iff_le, le_min_iff]
  exact ⟨by linarith, by linarith⟩

/-- The `+1/2` pre-jump turns a *non-distant* point into a distant one. -/
theorem circDist_add_half_of_lt (y : ℝ) (hy : circDist y < 1 / 4) :
    circDist (y + 1 / 2) ≥ 1 / 4 := by
  rw [circDist] at hy
  have hf0 := Int.fract_nonneg y
  have hf1 := Int.fract_lt_one y
  rw [ge_iff_le, circDist]
  have hshift : Int.fract (y + 1 / 2) = Int.fract (Int.fract y + 1 / 2) := by
    conv_lhs => rw [← Int.floor_add_fract y]
    rw [show (↑⌊y⌋ + Int.fract y + 1 / 2 : ℝ) = (Int.fract y + 1 / 2) + ↑⌊y⌋ from by ring,
      Int.fract_add_intCast]
  rw [hshift]
  set f := Int.fract y with hfdef
  rcases lt_or_ge f (1 / 2) with hlt | hge
  · rw [Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩]
    have hf14 : f < 1 / 4 := by rw [min_eq_left (by linarith)] at hy; exact hy
    rw [le_min_iff]; constructor <;> linarith
  · have hfr : Int.fract (f + 1 / 2) = f - 1 / 2 := by
      rw [show f + 1 / 2 = (f - 1 / 2) + 1 from by ring, Int.fract_add_one,
        Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩]
    rw [hfr]
    have hf34 : 3 / 4 < f := by rw [min_eq_right (by linarith)] at hy; linarith
    rw [le_min_iff]; constructor <;> linarith

/-- An even-speed runner is invariant under the `+1/2` pre-jump. -/
theorem circDist_even_add_half (e : ℕ) (he : Even e) (t : ℝ) :
    circDist ((e : ℝ) * (t + 1 / 2)) = circDist ((e : ℝ) * t) := by
  obtain ⟨k, hk⟩ := he
  have hcast : (e : ℝ) * (t + 1 / 2) = (e : ℝ) * t + (k : ℝ) := by rw [hk]; push_cast; ring
  rw [hcast]; unfold circDist; simp only [Int.fract_add_natCast]

/-- An odd-speed runner under the `+1/2` pre-jump shifts its phase by exactly `1/2`. -/
theorem circDist_odd_add_half (o : ℕ) (ho : Odd o) (t : ℝ) :
    circDist ((o : ℝ) * (t + 1 / 2)) = circDist ((o : ℝ) * t + 1 / 2) := by
  obtain ⟨k, hk⟩ := ho
  have hcast : (o : ℝ) * (t + 1 / 2) = ((o : ℝ) * t + 1 / 2) + (k : ℝ) := by
    rw [hk]; push_cast; ring
  rw [hcast]; unfold circDist; simp only [Int.fract_add_natCast]

/-- **Bienia §3 core (Path B).** Even runner `e`, odd runners `o1, o2`, both distinct
    from `e`. The witness comes either directly from `T ∩ G(o1) ∩ G(o2)` (connectedness)
    or from the `+1/2` pre-jump of a point where neither odd runner is distant. -/
theorem pathB_core (e o1 o2 : ℕ) (hpe : 0 < e) (hpo1 : 0 < o1) (hpo2 : 0 < o2)
    (he : Even e) (ho1 : Odd o1) (ho2 : Odd o2) (h1e : o1 ≠ e) (h2e : o2 ≠ e) :
    ∃ t : ℝ, circDist ((e : ℝ) * t) ≥ 1 / 4 ∧ circDist ((o1 : ℝ) * t) ≥ 1 / 4 ∧
      circDist ((o2 : ℝ) * t) ≥ 1 / 4 := by
  set T := Set.Icc (1 / (4 * (e : ℝ))) (3 / (4 * (e : ℝ))) with hT
  have getlt : ∀ (v : ℕ) (s : ℝ), s ∉ goodSet v 4 → circDist ((v : ℝ) * s) < 1 / 4 := by
    intro v s hs; rw [goodSet, Set.mem_setOf_eq] at hs; push_cast at hs; exact not_le.mp hs
  have getge : ∀ (v : ℕ) (s : ℝ), s ∈ goodSet v 4 → circDist ((v : ℝ) * s) ≥ 1 / 4 := by
    intro v s hs; rw [goodSet, Set.mem_setOf_eq] at hs; push_cast at hs; exact hs
  by_cases hsub : T ⊆ goodSet o1 4 ∪ goodSet o2 4
  · have hG1ne : (T ∩ goodSet o1 4).Nonempty := by
      by_contra hempty
      rw [Set.not_nonempty_iff_eq_empty] at hempty
      have hTG2 : T ⊆ goodSet o2 4 := fun x hx => (hsub hx).resolve_left
        (fun h => Set.notMem_empty x (hempty ▸ Set.mem_inter hx h))
      obtain ⟨t, htT, htbad⟩ := T_has_bad_point e o2 hpe hpo2 h2e
      exact absurd (getge o2 t (hTG2 htT)) (not_le.mpr htbad)
    have hG2ne : (T ∩ goodSet o2 4).Nonempty := by
      by_contra hempty
      rw [Set.not_nonempty_iff_eq_empty] at hempty
      have hTG1 : T ⊆ goodSet o1 4 := fun x hx => (hsub hx).resolve_right
        (fun h => Set.notMem_empty x (hempty ▸ Set.mem_inter hx h))
      obtain ⟨t, htT, htbad⟩ := T_has_bad_point e o1 hpe hpo1 h1e
      exact absurd (getge o1 t (hTG1 htT)) (not_le.mpr htbad)
    have hpre : IsPreconnected T := isPreconnected_Icc
    obtain ⟨t, htT, ht1, ht2⟩ := (isPreconnected_closed_iff.mp hpre) (goodSet o1 4) (goodSet o2 4)
      (goodSet_isClosed o1 4) (goodSet_isClosed o2 4) hsub hG1ne hG2ne
    exact ⟨t, even_runner_distant_on_T e hpe t htT, getge o1 t ht1, getge o2 t ht2⟩
  · rw [Set.not_subset] at hsub
    obtain ⟨t, htT, htnotin⟩ := hsub
    rw [Set.mem_union, not_or] at htnotin
    obtain ⟨hn1, hn2⟩ := htnotin
    refine ⟨t + 1 / 2, ?_, ?_, ?_⟩
    · rw [circDist_even_add_half e he t]; exact even_runner_distant_on_T e hpe t htT
    · rw [circDist_odd_add_half o1 ho1 t]; exact circDist_add_half_of_lt _ (getlt o1 t hn1)
    · rw [circDist_odd_add_half o2 ho2 t]; exact circDist_add_half_of_lt _ (getlt o2 t hn2)

/-- **Bienia §3 — not-all-odd case.**
    Case split on pairwise coprimality of the three speeds.

    * **Some pair non-coprime.**  Say `d := gcd(sᵢ, sⱼ) ≥ 2`.  Since the three
      speeds have overall gcd `1`, `d` cannot divide the remaining speed `sₖ`
      (else `d ∣ gcd = 1`).  So `pre_jump` applies: solve `{sᵢ, sⱼ}` at gap
      `1/4` via `intLRC 3`, then shift `sₖ` into the distant arc while keeping
      `sᵢ, sⱼ` fixed.  **(Path A — fully proved.)**

    * **Pairwise coprime.**  Then at most one speed is even; not-all-odd forces
      exactly one even speed, and Bienia's T-interval connectedness argument
      produces the witness.  **(Path B — `sorry`, the residual hard core.)** -/
theorem intLRC_four_not_all_odd (speeds : Fin 3 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i) (hgcd : Finset.gcd Finset.univ speeds = 1)
    (hnotodd : ¬ ∀ i, Odd (speeds i)) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 4 := by
  set s0 := speeds ⟨0, by omega⟩
  set s1 := speeds ⟨1, by omega⟩
  set s2 := speeds ⟨2, by omega⟩
  have hp0 : 0 < s0 := hpos _
  have hp1 : 0 < s1 := hpos _
  have hp2 : 0 < s2 := hpos _
  have h01 : s0 < s1 := hmono (Fin.mk_lt_mk.mpr (by norm_num))
  have h02 : s0 < s2 := hmono (Fin.mk_lt_mk.mpr (by norm_num))
  have h12 : s1 < s2 := hmono (Fin.mk_lt_mk.mpr (by norm_num))
  -- Any common divisor of all three speeds divides the overall gcd = 1.
  have hcommon : ∀ d : ℕ, d ∣ s0 → d ∣ s1 → d ∣ s2 → d ∣ 1 := by
    intro d hd0 hd1 hd2
    have hdg : d ∣ Finset.gcd Finset.univ speeds := by
      apply Finset.dvd_gcd
      intro i _; fin_cases i
      · exact hd0
      · exact hd1
      · exact hd2
    rwa [hgcd] at hdg
  -- Assemble a 3-conjunction witness into the `∀ i` goal.
  have mk : ∀ t : ℝ, circDist ((s0 : ℝ) * t) ≥ 1 / 4 → circDist ((s1 : ℝ) * t) ≥ 1 / 4 →
      circDist ((s2 : ℝ) * t) ≥ 1 / 4 →
      ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 4 := by
    intro t q0 q1 q2
    refine ⟨t, fun i => ?_⟩
    fin_cases i
    · exact q0
    · exact q1
    · exact q2
  by_cases h01c : Nat.Coprime s0 s1
  · by_cases h02c : Nat.Coprime s0 s2
    · by_cases h12c : Nat.Coprime s1 s2
      · -- All pairwise coprime ⇒ exactly one even speed; Bienia's T-interval argument.
        -- Coprimality forbids two even speeds, so the even one's partners are odd.
        have other_odd : ∀ a b : ℕ, Nat.Coprime a b → Even a → Odd b := by
          intro a b hcop ha
          rw [← Nat.not_even_iff_odd]
          intro hb
          have hdvd : 2 ∣ Nat.gcd a b := Nat.dvd_gcd ha.two_dvd hb.two_dvd
          have hce : Nat.gcd a b = 1 := hcop
          omega
        -- Not-all-odd ⇒ at least one even speed.
        have heven_or : Even s0 ∨ Even s1 ∨ Even s2 := by
          by_contra h
          simp only [not_or] at h
          obtain ⟨hno0, hno1, hno2⟩ := h
          rw [Nat.not_even_iff_odd] at hno0 hno1 hno2
          refine hnotodd (fun i => ?_)
          fin_cases i
          · exact hno0
          · exact hno1
          · exact hno2
        rcases heven_or with he0 | he1 | he2
        · -- s0 even; s1, s2 odd
          have ho1 : Odd s1 := other_odd s0 s1 h01c he0
          have ho2 : Odd s2 := other_odd s0 s2 h02c he0
          obtain ⟨t, pe, p1, p2⟩ := pathB_core s0 s1 s2 hp0 hp1 hp2 he0 ho1 ho2 h01.ne' h02.ne'
          exact mk t pe p1 p2
        · -- s1 even; s0, s2 odd
          have ho0 : Odd s0 := other_odd s1 s0 h01c.symm he1
          have ho2 : Odd s2 := other_odd s1 s2 h12c he1
          obtain ⟨t, pe, p0, p2⟩ := pathB_core s1 s0 s2 hp1 hp0 hp2 he1 ho0 ho2 h01.ne h12.ne'
          exact mk t p0 pe p2
        · -- s2 even; s0, s1 odd
          have ho0 : Odd s0 := other_odd s2 s0 h02c.symm he2
          have ho1 : Odd s1 := other_odd s2 s1 h12c.symm he2
          obtain ⟨t, pe, p0, p1⟩ := pathB_core s2 s0 s1 hp2 hp0 hp1 he2 ho0 ho1 h02.ne h12.ne
          exact mk t p0 p1 pe
      · -- ¬ Coprime s1 s2: pre-jump keeping (s1, s2), dropping s0.
        have hd2 : 2 ≤ Nat.gcd s1 s2 := by
          have hpos12 : 0 < Nat.gcd s1 s2 := Nat.gcd_pos_iff.mpr (Or.inl hp1)
          have hne12 : Nat.gcd s1 s2 ≠ 1 := h12c
          omega
        have hnd : ¬ (Nat.gcd s1 s2 ∣ s0) := by
          intro hdvd0
          have hdo : Nat.gcd s1 s2 ∣ 1 :=
            hcommon _ hdvd0 (Nat.gcd_dvd_left s1 s2) (Nat.gcd_dvd_right s1 s2)
          have hg1 : Nat.gcd s1 s2 = 1 := Nat.dvd_one.mp hdo
          omega
        obtain ⟨t, p1, p2, p0⟩ := pre_jump s1 s2 s0 hp1 hp2 h12.ne hd2 hnd
        exact mk t p0 p1 p2
    · -- ¬ Coprime s0 s2: pre-jump keeping (s0, s2), dropping s1.
      have hd2 : 2 ≤ Nat.gcd s0 s2 := by
        have hpos02 : 0 < Nat.gcd s0 s2 := Nat.gcd_pos_iff.mpr (Or.inl hp0)
        have hne02 : Nat.gcd s0 s2 ≠ 1 := h02c
        omega
      have hnd : ¬ (Nat.gcd s0 s2 ∣ s1) := by
        intro hdvd1
        have hdo : Nat.gcd s0 s2 ∣ 1 :=
          hcommon _ (Nat.gcd_dvd_left s0 s2) hdvd1 (Nat.gcd_dvd_right s0 s2)
        have hg1 : Nat.gcd s0 s2 = 1 := Nat.dvd_one.mp hdo
        omega
      obtain ⟨t, p0, p2, p1⟩ := pre_jump s0 s2 s1 hp0 hp2 h02.ne hd2 hnd
      exact mk t p0 p1 p2
  · -- ¬ Coprime s0 s1: pre-jump keeping (s0, s1), dropping s2.
    have hd2 : 2 ≤ Nat.gcd s0 s1 := by
      have hpos01 : 0 < Nat.gcd s0 s1 := Nat.gcd_pos_iff.mpr (Or.inl hp0)
      have hne01 : Nat.gcd s0 s1 ≠ 1 := h01c
      omega
    have hnd : ¬ (Nat.gcd s0 s1 ∣ s2) := by
      intro hdvd2
      have hdo : Nat.gcd s0 s1 ∣ 1 :=
        hcommon _ (Nat.gcd_dvd_left s0 s1) (Nat.gcd_dvd_right s0 s1) hdvd2
      have hg1 : Nat.gcd s0 s1 = 1 := Nat.dvd_one.mp hdo
      omega
    obtain ⟨t, p0, p1, p2⟩ := pre_jump s0 s1 s2 hp0 hp1 h01.ne hd2 hnd
    exact mk t p0 p1 p2

end


/-
───────────────────────────────────────────────────────────────────────────────
  PART 7: IntLRC_4.lean
───────────────────────────────────────────────────────────────────────────────
-/
section

/-!
# `intLRC 4` — Lonely Runner Conjecture for n = 4

Three moving runners + observer, target gap `1/4`. In the literature's
convention (observer omitted) this is the case `n = 3` settled by
Betke–Wills 1972 and Cusick 1974, with shorter modern proofs by Bienia et al.
1998 (flows) and Renault 2004 (congruence classes mod n+1 = 4).

This file structures the proof via our framework's case split
(Lemma 9.1: BSR / LR / Hard). The BSR and LR cases discharge cleanly from
`theorem61_BSR` and `theorem71_LargeSR` respectively. The Hard Case
`3·v_1 < V ≤ 3·v_2` is the residual that requires a classical argument; it is
left as a single `sorry` with a structured TODO.

**Sorry budget:** 1 (the Hard Case body). Everything else, including the
strong-induction premise `H 4`, is fully proved.
-/

open MeasureTheory Set

/-- The strong-induction premise `H 4`.  For `m < 4`:
    `m = 0, 1` are vacuous; `m = 2` has an explicit witness `t = 1/(2v)`;
    `m = 3` is `intLRC_three`. -/
theorem H_four : H 4 := by
  intro m hm
  intro speeds hmono hpos hgcd
  interval_cases m
  · exact ⟨0, fun i => i.elim0⟩
  · exact ⟨0, fun i => i.elim0⟩
  · refine ⟨1 / (2 * (speeds ⟨0, by omega⟩ : ℝ)), fun i => ?_⟩
    have hi : i = ⟨0, by omega⟩ := Fin.ext (by omega)
    subst hi
    have hv : (0 : ℝ) < speeds ⟨0, by omega⟩ := by exact_mod_cast hpos ⟨0, by omega⟩
    rw [show (speeds ⟨0, by omega⟩ : ℝ) * (1 / (2 * speeds ⟨0, by omega⟩)) = 1 / 2
        from by field_simp]
    have h_floor : ⌊(1 / 2 : ℝ)⌋ = (0 : ℤ) := Int.floor_eq_zero_iff.mpr (by norm_num)
    have h_frac : Int.fract (1 / 2 : ℝ) = 1 / 2 := by
      simp only [Int.fract, h_floor, Int.cast_zero, sub_zero]
    change circDist (1 / 2 : ℝ) ≥ (1 : ℝ) / 2
    unfold circDist
    rw [h_frac]
    norm_num
  · exact intLRC_three speeds hmono hpos hgcd

/-- **Main result for n = 4** (sorry'd at the Hard Case).

    `speeds : Fin 3 → ℕ` distinct positive integers, `gcd = 1`.  Case split via
    Lemma 9.1:
    - BSR `V ≤ 3·v_1`: explicit time `t* = 1/(4·v_1)` via `theorem61_BSR`.
    - LR `3·v_2 < V`: neighbourhood argument via `theorem71_LargeSR` + `H 4`.
    - Hard `3·v_1 < V ≤ 3·v_2`: requires the classical argument
      (Bienia/Renault/Chen). **Currently `sorry`.** -/
theorem intLRC_four : intLRC 4 := by
  intro speeds hmono hpos hgcd
  let V : ℕ := speeds ⟨2, by omega⟩
  let slowSpeeds : Fin 2 → ℕ := fun i => speeds ⟨i.val, by omega⟩
  have hpos_slow : ∀ i, 0 < slowSpeeds i := fun i => hpos ⟨i.val, by omega⟩
  have hmono_slow : StrictMono slowSpeeds := by
    intro a b hab
    show speeds ⟨a.val, by omega⟩ < speeds ⟨b.val, by omega⟩
    exact hmono (show (⟨a.val, by omega⟩ : Fin 3) < ⟨b.val, by omega⟩ from hab)
  -- Case split inline (avoids dependency on Theorem121_Main which has a sorry):
  -- BSR: V ≤ 3 v_1; LR: 3 v_2 < V; Hard: 3 v_1 < V ≤ 3 v_2.
  by_cases hBSR : V ≤ 3 * speeds ⟨0, by omega⟩
  · -- BSR Case: explicit time t* = 1/(4·v_1)
    refine ⟨bsr_time 4 (speeds ⟨0, by omega⟩), ?_⟩
    intro i
    have hV_bsr : speeds ⟨4 - 2, by omega⟩ ≤ (4 - 1) * speeds ⟨0, by omega⟩ := by
      change speeds ⟨2, by omega⟩ ≤ 3 * speeds ⟨0, by omega⟩
      exact hBSR
    exact theorem61_BSR 4 (by norm_num) speeds hpos hmono hV_bsr i
  · push_neg at hBSR
    -- 3·v_1 < V; split LR vs Hard
    by_cases hLR : 3 * speeds ⟨1, by omega⟩ < V
    · -- LR Case: 3·v_2 < V; apply theorem71_LargeSR with H_four
      have hV_large : (4 - 1) * slowSpeeds ⟨4 - 3, by omega⟩ < V := by
        change 3 * speeds ⟨1, by omega⟩ < V
        exact hLR
      obtain ⟨t₀, ht₀_slow, ht₀_V⟩ :=
        theorem71_LargeSR 4 (by norm_num) slowSpeeds V hpos_slow hmono_slow hV_large H_four
      refine ⟨t₀, fun i => ?_⟩
      by_cases hi : i.val < 2
      · -- Slow runner
        have h := ht₀_slow ⟨i.val, hi⟩
        simp only [slowSpeeds] at h
        have heq : (speeds i : ℝ) = (speeds ⟨i.val, by omega⟩ : ℝ) := by
          rfl
        rw [heq]; exact h
      · -- Fast runner: i.val = 2
        push_neg at hi
        have hi2 : i.val = 2 := by omega
        have heq : (speeds i : ℝ) = (V : ℝ) := by
          change (speeds i : ℝ) = (speeds ⟨2, by omega⟩ : ℝ)
          congr 2; exact Fin.ext hi2
        rw [heq]; exact ht₀_V
    · push_neg at hLR
      -- Hard Case: 3·v_1 < V ≤ 3·v_2
      -- Apply Bienia's case split: all-odd vs. else.
      by_cases hall_odd : ∀ i, Odd (speeds i)
      · -- All three speeds odd: Bienia §3 step 1, t = 1/2.
        exact intLRC_four_all_odd speeds hall_odd
      · -- Not all odd: pre-jump reduction (Path A, proved) +
        -- T-interval main argument (Path B, residual sorry inside the lemma).
        exact intLRC_four_not_all_odd speeds hmono hpos hgcd hall_odd

end


/-
───────────────────────────────────────────────────────────────────────────────
  PART 8: IntLRC_5_Bienia.lean
───────────────────────────────────────────────────────────────────────────────
-/
section

/-!
# `intLRC 5` — Bienia's `k = 4` argument (helpers)

Four moving runners + observer, target gap `1/5`. Literature `n = 4`
(observer omitted), proved by Bienia–Goddyn–Gvozdjak–Sebő–Tarsi 1998 with an
elementary self-contained argument using that `n + 1 = 5` is prime.

This file collects the machinery; `IntLRC_5.lean` assembles the main theorem.

## Roadmap (Bienia §3–§4)
* **Generalised shift lemmas** (below): lift the gap-`1/4` shift lemmas of
  `IntLRC_4_Bienia` to any gap `g ≤ 1/4`, so the pre-jump works at `1/5`.
* **Lemma (3)** (prime pigeonhole): among the five times `t + j/5`, a speed
  divisible by 5 is fixed while every other cycles through all nonzero fifths;
  a counting argument gives a fully-distant time.
* Cases `|D| = 0` (`t = 1/5`, done in `IntLRC_5.lean`), `|D| ∈ {2,3}`
  (induction + Lemma 3), `|D| = 1` (gcd split + doubling).
-/

open MeasureTheory Set

/-- Integer shifts leave `circDist` unchanged (local copy; the one in
    `IntLRC_4_Bienia` is `private`). -/
private theorem circDist_add_intCast' (z : ℝ) (n : ℤ) :
    circDist (z + (n : ℝ)) = circDist z := by
  unfold circDist; rw [Int.fract_add_intCast]

/-- **Equispaced shift, general gap `g ≤ 1/4`.**  For `m ≥ 2`, some shift
    `k/m` (`k : ℤ`) lands `y` in the distant arc `[g, 1-g]`.  Consecutive shifts
    are `1/m ≤ 1/2 ≤ 1-2g` apart, so they cannot jump over the arc. -/
theorem exists_shift_distant_gen (m : ℕ) (hm : 2 ≤ m) (g : ℝ) (hg0 : 0 < g) (hg4 : g ≤ 1 / 4)
    (y : ℝ) : ∃ k : ℤ, circDist (y + (k : ℝ) / (m : ℝ)) ≥ g := by
  have hmR : (2 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
  have hm0 : (0 : ℝ) < (m : ℝ) := by linarith
  have hinvm : (1 : ℝ) / (m : ℝ) ≤ 1 / 2 := one_div_le_one_div_of_le (by norm_num) hmR
  refine ⟨⌈(m : ℝ) * (g - y)⌉, ?_⟩
  set K : ℤ := ⌈(m : ℝ) * (g - y)⌉ with hK
  have hk_lb : (m : ℝ) * (g - y) ≤ (K : ℝ) := Int.le_ceil _
  have hk_ub : (K : ℝ) < (m : ℝ) * (g - y) + 1 := Int.ceil_lt_add_one _
  have hz_lb : g ≤ y + (K : ℝ) / (m : ℝ) := by
    have h : (g - y) ≤ (K : ℝ) / (m : ℝ) := (le_div_iff₀ hm0).mpr (by rw [mul_comm]; exact hk_lb)
    linarith
  have hz_ub : y + (K : ℝ) / (m : ℝ) ≤ 1 - g := by
    have h : (K : ℝ) / (m : ℝ) < (g - y) + 1 / (m : ℝ) := by
      rw [div_lt_iff₀ hm0]
      have hid : ((g - y) + 1 / (m : ℝ)) * (m : ℝ) = (m : ℝ) * (g - y) + 1 := by field_simp
      rw [hid]; exact hk_ub
    have h1m : 1 / (m : ℝ) ≤ 1 - 2 * g := by linarith
    linarith
  have hfr : Int.fract (y + (K : ℝ) / (m : ℝ)) = y + (K : ℝ) / (m : ℝ) :=
    Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩
  unfold circDist
  rw [hfr, ge_iff_le, le_min_iff]
  exact ⟨by linarith, by linarith⟩

/-- **Pre-jump shift, arbitrary multiplier, general gap `g ≤ 1/4`.**  If `d ≥ 2`
    and `d ∤ v`, some shift `v·K/d` places `y` in the distant arc `[g, 1-g]`.
    The orbit `{v·K/d mod 1}` is the order-`d/gcd(v,d) ≥ 2` cyclic subgroup;
    combine `exists_shift_distant_gen` with Bézout. -/
theorem exists_step_distant_gen (v d : ℕ) (hd : 2 ≤ d) (hdvd : ¬ (d ∣ v))
    (g : ℝ) (hg0 : 0 < g) (hg4 : g ≤ 1 / 4) (y : ℝ) :
    ∃ K : ℤ, circDist (y + (v : ℝ) * (K : ℝ) / (d : ℝ)) ≥ g := by
  have hd0 : 0 < d := by omega
  have he_pos : 0 < Nat.gcd v d := Nat.gcd_pos_of_pos_right v hd0
  set e : ℕ := Nat.gcd v d with he
  have he_dvd_d : e ∣ d := Nat.gcd_dvd_right v d
  have he_dvd_v : e ∣ v := Nat.gcd_dvd_left v d
  have he_ne_d : e ≠ d := fun h => hdvd (h ▸ he_dvd_v)
  obtain ⟨mm, hmm⟩ := id he_dvd_d
  have hmm2 : 2 ≤ mm := by rcases mm with _ | _ | mm <;> omega
  set D : ℕ := d / e with hD
  have hD_eq : D = mm := by rw [hD, hmm, Nat.mul_div_cancel_left mm he_pos]
  have hD_ge2 : 2 ≤ D := by rw [hD_eq]; exact hmm2
  set V : ℕ := v / e with hV
  have hveq : (e : ℝ) * (V : ℝ) = (v : ℝ) := by exact_mod_cast Nat.mul_div_cancel' he_dvd_v
  have hdeq : (e : ℝ) * (D : ℝ) = (d : ℝ) := by exact_mod_cast Nat.mul_div_cancel' he_dvd_d
  have heR : (e : ℝ) ≠ 0 := by exact_mod_cast he_pos.ne'
  have hcop : Nat.Coprime V D := Nat.coprime_div_gcd_div_gcd he_pos
  have hcopZ : IsCoprime (V : ℤ) (D : ℤ) := Nat.isCoprime_iff_coprime.mpr hcop
  obtain ⟨a, b, hab⟩ := hcopZ
  have habR : (a : ℝ) * (V : ℝ) + (b : ℝ) * (D : ℝ) = 1 := by exact_mod_cast hab
  obtain ⟨k₀, hk₀⟩ := exists_shift_distant_gen D hD_ge2 g hg0 hg4 y
  refine ⟨a * k₀, ?_⟩
  have hfinal :
      y + (v : ℝ) * ((a * k₀ : ℤ) : ℝ) / (d : ℝ)
        = (y + (k₀ : ℝ) / (D : ℝ)) + ((-(b * k₀) : ℤ) : ℝ) := by
    have h1 : (v : ℝ) * ((a * k₀ : ℤ) : ℝ) / (d : ℝ)
        = ((V : ℝ) * ((a * k₀ : ℤ) : ℝ)) / (D : ℝ) := by
      rw [← hveq, ← hdeq, mul_assoc, mul_div_mul_left _ _ heR]
    have hVa : (V : ℝ) * ((a * k₀ : ℤ) : ℝ) = (k₀ : ℝ) - (b : ℝ) * (k₀ : ℝ) * (D : ℝ) := by
      push_cast; linear_combination (k₀ : ℝ) * habR
    rw [h1, hVa]; push_cast; field_simp; ring
  rw [hfinal, circDist_add_intCast']
  exact hk₀

/-! ### Lemma (3) geometry — when a `+s/5` shift lands in the near-zero arc

For `f = fract y ∈ [0,1)`, the four shifted points `f + s/5` (`s = 1,2,3,4`) are
"bad" (`circDist < 1/5`, i.e. within `1/5` of an integer) exactly on the open
intervals `bad₁=(3/5,1)`, `bad₂=(2/5,4/5)`, `bad₃=(1/5,3/5)`, `bad₄=(0,2/5)`.
These adjacent intervals have no triple overlap, so at any `f` at most two shifts
are bad — and at most one unless `f` lies in the interior set
`C₂ = (1/5,2/5)∪(2/5,3/5)∪(3/5,4/5)`. -/

private theorem bad_fifth_one (f : ℝ) (h0 : 0 ≤ f) (h1 : f < 1) :
    circDist (f + 1 / 5) < 1 / 5 ↔ 3 / 5 < f := by
  unfold circDist
  rcases lt_or_ge (f + 1 / 5) 1 with hlt | hge
  · rw [Int.fract_eq_self.mpr ⟨by linarith, hlt⟩, min_lt_iff]
    constructor
    · rintro (h | h) <;> linarith
    · intro h; right; linarith
  · rw [show f + 1 / 5 = (f - 4 / 5) + 1 from by ring, Int.fract_add_one,
      Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩, min_lt_iff]
    constructor
    · intro _; linarith
    · intro _; left; linarith

private theorem bad_fifth_two (f : ℝ) (h0 : 0 ≤ f) (h1 : f < 1) :
    circDist (f + 2 / 5) < 1 / 5 ↔ (2 / 5 < f ∧ f < 4 / 5) := by
  unfold circDist
  rcases lt_or_ge (f + 2 / 5) 1 with hlt | hge
  · rw [Int.fract_eq_self.mpr ⟨by linarith, hlt⟩, min_lt_iff]
    constructor
    · rintro (h | h)
      · exfalso; linarith
      · exact ⟨by linarith, by linarith⟩
    · intro ⟨_, _⟩; right; linarith
  · rw [show f + 2 / 5 = (f - 3 / 5) + 1 from by ring, Int.fract_add_one,
      Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩, min_lt_iff]
    constructor
    · rintro (h | h)
      · exact ⟨by linarith, by linarith⟩
      · exfalso; linarith
    · intro ⟨_, _⟩; left; linarith

private theorem bad_fifth_three (f : ℝ) (h0 : 0 ≤ f) (h1 : f < 1) :
    circDist (f + 3 / 5) < 1 / 5 ↔ (1 / 5 < f ∧ f < 3 / 5) := by
  unfold circDist
  rcases lt_or_ge (f + 3 / 5) 1 with hlt | hge
  · rw [Int.fract_eq_self.mpr ⟨by linarith, hlt⟩, min_lt_iff]
    constructor
    · rintro (h | h)
      · exfalso; linarith
      · exact ⟨by linarith, by linarith⟩
    · intro ⟨_, _⟩; right; linarith
  · rw [show f + 3 / 5 = (f - 2 / 5) + 1 from by ring, Int.fract_add_one,
      Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩, min_lt_iff]
    constructor
    · rintro (h | h)
      · exact ⟨by linarith, by linarith⟩
      · exfalso; linarith
    · intro ⟨_, _⟩; left; linarith

private theorem bad_fifth_four (f : ℝ) (h0 : 0 ≤ f) (h1 : f < 1) :
    circDist (f + 4 / 5) < 1 / 5 ↔ (0 < f ∧ f < 2 / 5) := by
  unfold circDist
  rcases lt_or_ge (f + 4 / 5) 1 with hlt | hge
  · rw [Int.fract_eq_self.mpr ⟨by linarith, hlt⟩, min_lt_iff]
    constructor
    · rintro (h | h)
      · exfalso; linarith
      · exact ⟨by linarith, by linarith⟩
    · intro ⟨_, _⟩; right; linarith
  · rw [show f + 4 / 5 = (f - 1 / 5) + 1 from by ring, Int.fract_add_one,
      Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩, min_lt_iff]
    constructor
    · rintro (h | h)
      · exact ⟨by linarith, by linarith⟩
      · exfalso; linarith
    · intro ⟨_, _⟩; left; linarith

/-- **Lemma-3 count bound (in terms of `f = fract y`).** At most two of the four
    `+s/5` shifts are non-distant.  Split `{1,2,3,4} = {1,3} ∪ {2,4}`: `bad₁,bad₃`
    are disjoint and `bad₂,bad₄` are disjoint, so each half contributes ≤ 1. -/
theorem badShift_le_two_f (f : ℝ) (h0 : 0 ≤ f) (h1 : f < 1) :
    ((Finset.Icc 1 4).filter (fun s : ℕ => circDist (f + (s : ℝ) / 5) < 1 / 5)).card ≤ 2 := by
  have hsplit : (Finset.Icc 1 4 : Finset ℕ) = {1, 3} ∪ {2, 4} := by decide
  rw [hsplit, Finset.filter_union]
  refine le_trans (Finset.card_union_le _ _) ?_
  have h13 : (({1, 3} : Finset ℕ).filter
      (fun s : ℕ => circDist (f + (s : ℝ) / 5) < 1 / 5)).card ≤ 1 := by
    rw [Finset.card_le_one]
    intro a ha b hb
    simp only [Finset.mem_filter, Finset.mem_insert, Finset.mem_singleton] at ha hb
    obtain ⟨ha1, hpa⟩ := ha; obtain ⟨hb1, hpb⟩ := hb
    rcases ha1 with rfl | rfl <;> rcases hb1 with rfl | rfl
    · rfl
    · exfalso; norm_num at hpa hpb
      rw [bad_fifth_one f h0 h1] at hpa; rw [bad_fifth_three f h0 h1] at hpb; linarith
    · exfalso; norm_num at hpa hpb
      rw [bad_fifth_three f h0 h1] at hpa; rw [bad_fifth_one f h0 h1] at hpb; linarith
    · rfl
  have h24 : (({2, 4} : Finset ℕ).filter
      (fun s : ℕ => circDist (f + (s : ℝ) / 5) < 1 / 5)).card ≤ 1 := by
    rw [Finset.card_le_one]
    intro a ha b hb
    simp only [Finset.mem_filter, Finset.mem_insert, Finset.mem_singleton] at ha hb
    obtain ⟨ha1, hpa⟩ := ha; obtain ⟨hb1, hpb⟩ := hb
    rcases ha1 with rfl | rfl <;> rcases hb1 with rfl | rfl
    · rfl
    · exfalso; norm_num at hpa hpb
      rw [bad_fifth_two f h0 h1] at hpa; rw [bad_fifth_four f h0 h1] at hpb; linarith
    · exfalso; norm_num at hpa hpb
      rw [bad_fifth_four f h0 h1] at hpa; rw [bad_fifth_two f h0 h1] at hpb; linarith
    · rfl
  omega

/-- **Residue injection.** For `5 ∤ v`, the actual bad-shift count (over times
    `t + j/5`) is at most the `+s/5` count, via the injection `j ↦ (j·v) mod 5`
    on `{1,2,3,4}` (a bijection since `v` is invertible mod the prime `5`). -/
theorem nbad_le_badShift (v : ℕ) (hv : ¬ 5 ∣ v) (y : ℝ) :
    ((Finset.Icc 1 4).filter (fun j : ℕ => circDist (y + (j : ℝ) * (v : ℝ) / 5) < 1 / 5)).card
      ≤ ((Finset.Icc 1 4).filter (fun s : ℕ => circDist (y + (s : ℝ) / 5) < 1 / 5)).card := by
  have hcop : Nat.Coprime 5 v := (Nat.Prime.coprime_iff_not_dvd (p := 5) (by decide)).mpr hv
  apply Finset.card_le_card_of_injOn (fun j => (j * v) % 5)
  · intro j hj
    obtain ⟨hjIcc, hbad⟩ := Finset.mem_filter.mp hj
    obtain ⟨hj1, hj4⟩ := Finset.mem_Icc.mp hjIcc
    have hjv : ¬ (5 ∣ j * v) := fun h => by
      have h5j : (5 : ℕ) ∣ j := hcop.dvd_of_dvd_mul_right h
      exact absurd (Nat.le_of_dvd (by omega) h5j) (by omega)
    have hmod_pos : (j * v) % 5 ≠ 0 := fun h => hjv (Nat.dvd_of_mod_eq_zero h)
    have hmod_lt : (j * v) % 5 < 5 := Nat.mod_lt _ (by norm_num)
    simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_Icc]
    refine ⟨⟨by omega, by omega⟩, ?_⟩
    have key : y + (j : ℝ) * (v : ℝ) / 5
        = (y + (((j * v) % 5 : ℕ) : ℝ) / 5) + (((j * v) / 5 : ℕ) : ℝ) := by
      have hc : (j : ℝ) * (v : ℝ) = ((j * v : ℕ) : ℝ) := by push_cast; ring
      have hdm : ((j * v : ℕ) : ℝ) = 5 * (((j * v) / 5 : ℕ) : ℝ) + (((j * v) % 5 : ℕ) : ℝ) := by
        exact_mod_cast (Nat.div_add_mod (j * v) 5).symm
      rw [hc, hdm]; ring
    have heq : circDist (y + (j : ℝ) * (v : ℝ) / 5)
        = circDist (y + (((j * v) % 5 : ℕ) : ℝ) / 5) := by
      rw [key]; unfold circDist; rw [Int.fract_add_natCast]
    rw [← heq]; exact hbad
  · intro j1 hj1 j2 hj2 heq
    rw [Finset.mem_coe, Finset.mem_filter, Finset.mem_Icc] at hj1 hj2
    have hmod : j1 * v ≡ j2 * v [MOD 5] := heq
    have hj : j1 ≡ j2 [MOD 5] := Nat.ModEq.cancel_right_of_coprime hcop hmod
    have h3 : j1 % 5 = j2 % 5 := hj
    omega

/-- `circDist` depends only on the fractional part (modulo the added constant). -/
theorem circDist_add_eq_fract (y c : ℝ) : circDist (y + c) = circDist (Int.fract y + c) := by
  conv_lhs => rw [← Int.floor_add_fract y]
  rw [show (↑⌊y⌋ + Int.fract y) + c = (Int.fract y + c) + (↑⌊y⌋ : ℝ) from by ring]
  unfold circDist; rw [Int.fract_add_intCast]

/-- At `f = 0` no `+s/5` shift is bad (the count is `0`). -/
theorem badShift_zero_f :
    ((Finset.Icc 1 4).filter (fun s : ℕ => circDist ((0 : ℝ) + (s : ℝ) / 5) < 1 / 5)).card = 0 := by
  rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
  intro s hs
  obtain ⟨hs1, hs4⟩ := Finset.mem_Icc.mp hs
  have hsR1 : (1 : ℝ) ≤ (s : ℝ) := by exact_mod_cast hs1
  have hsR4 : (s : ℝ) ≤ 4 := by exact_mod_cast hs4
  rw [zero_add, not_lt]
  unfold circDist
  rw [Int.fract_eq_self.mpr ⟨by positivity, by linarith⟩, le_min_iff]
  exact ⟨by linarith, by linarith⟩

/-- **Lemma-3 refined count bound:** off the interior set `C₂` (i.e. when
    `f ≤ 1/5 ∨ 4/5 ≤ f ∨ f = 2/5 ∨ f = 3/5`), at most *one* `+s/5` shift is bad.
    In each of the four cases all bad shifts are forced to a single value. -/
theorem badShift_le_one_f (f : ℝ) (h0 : 0 ≤ f) (h1 : f < 1)
    (hC2 : f ≤ 1 / 5 ∨ 4 / 5 ≤ f ∨ f = 2 / 5 ∨ f = 3 / 5) :
    ((Finset.Icc 1 4).filter (fun s : ℕ => circDist (f + (s : ℝ) / 5) < 1 / 5)).card ≤ 1 := by
  rw [Finset.card_le_one]
  intro a ha b hb
  rw [Finset.mem_filter, Finset.mem_Icc] at ha hb
  obtain ⟨⟨ha1, ha4⟩, hpa⟩ := ha
  obtain ⟨⟨hb1, hb4⟩, hpb⟩ := hb
  rcases hC2 with h | h | h | h
  · have F : ∀ s : ℕ, 1 ≤ s → s ≤ 4 → circDist (f + (s : ℝ) / 5) < 1 / 5 → s = 4 := by
      intro s hs1 hs4 hb'
      interval_cases s
      · exfalso; norm_num at hb'; rw [bad_fifth_one f h0 h1] at hb'; linarith
      · exfalso; norm_num at hb'; rw [bad_fifth_two f h0 h1] at hb'; linarith [hb'.1, hb'.2]
      · exfalso; norm_num at hb'; rw [bad_fifth_three f h0 h1] at hb'; linarith [hb'.1, hb'.2]
      · rfl
    rw [F a ha1 ha4 hpa, F b hb1 hb4 hpb]
  · have F : ∀ s : ℕ, 1 ≤ s → s ≤ 4 → circDist (f + (s : ℝ) / 5) < 1 / 5 → s = 1 := by
      intro s hs1 hs4 hb'
      interval_cases s
      · rfl
      · exfalso; norm_num at hb'; rw [bad_fifth_two f h0 h1] at hb'; linarith [hb'.1, hb'.2]
      · exfalso; norm_num at hb'; rw [bad_fifth_three f h0 h1] at hb'; linarith [hb'.1, hb'.2]
      · exfalso; norm_num at hb'; rw [bad_fifth_four f h0 h1] at hb'; linarith [hb'.1, hb'.2]
    rw [F a ha1 ha4 hpa, F b hb1 hb4 hpb]
  · have F : ∀ s : ℕ, 1 ≤ s → s ≤ 4 → circDist (f + (s : ℝ) / 5) < 1 / 5 → s = 3 := by
      intro s hs1 hs4 hb'
      interval_cases s
      · exfalso; norm_num at hb'; rw [bad_fifth_one f h0 h1] at hb'; linarith
      · exfalso; norm_num at hb'; rw [bad_fifth_two f h0 h1] at hb'; linarith [hb'.1, hb'.2]
      · rfl
      · exfalso; norm_num at hb'; rw [bad_fifth_four f h0 h1] at hb'; linarith [hb'.1, hb'.2]
    rw [F a ha1 ha4 hpa, F b hb1 hb4 hpb]
  · have F : ∀ s : ℕ, 1 ≤ s → s ≤ 4 → circDist (f + (s : ℝ) / 5) < 1 / 5 → s = 2 := by
      intro s hs1 hs4 hb'
      interval_cases s
      · exfalso; norm_num at hb'; rw [bad_fifth_one f h0 h1] at hb'; linarith
      · rfl
      · exfalso; norm_num at hb'; rw [bad_fifth_three f h0 h1] at hb'; linarith [hb'.1, hb'.2]
      · exfalso; norm_num at hb'; rw [bad_fifth_four f h0 h1] at hb'; linarith [hb'.1, hb'.2]
    rw [F a ha1 ha4 hpa, F b hb1 hb4 hpb]

/-- Reduce the `+s/5` count to the fractional part of `y`. -/
theorem badShift_eq (y : ℝ) :
    ((Finset.Icc 1 4).filter (fun s : ℕ => circDist (y + (s : ℝ) / 5) < 1 / 5)).card
      = ((Finset.Icc 1 4).filter
          (fun s : ℕ => circDist (Int.fract y + (s : ℝ) / 5) < 1 / 5)).card := by
  congr 1
  apply Finset.filter_congr
  intro s _
  rw [circDist_add_eq_fract]

/-- A non-`5`-divisible runner is non-distant at ≤ 2 of the four times `t + j/5`. -/
theorem nbad_le_two (v : ℕ) (hv : ¬ 5 ∣ v) (y : ℝ) :
    ((Finset.Icc 1 4).filter
      (fun j : ℕ => circDist (y + (j : ℝ) * (v : ℝ) / 5) < 1 / 5)).card ≤ 2 := by
  refine le_trans (nbad_le_badShift v hv y) ?_
  rw [badShift_eq]
  exact badShift_le_two_f _ (Int.fract_nonneg y) (Int.fract_lt_one y)

/-- If moreover `fract y` is off the interior `C₂`, the count drops to ≤ 1. -/
theorem nbad_le_one (v : ℕ) (hv : ¬ 5 ∣ v) (y : ℝ)
    (hC2 : Int.fract y ≤ 1 / 5 ∨ 4 / 5 ≤ Int.fract y ∨ Int.fract y = 2 / 5 ∨ Int.fract y = 3 / 5) :
    ((Finset.Icc 1 4).filter
      (fun j : ℕ => circDist (y + (j : ℝ) * (v : ℝ) / 5) < 1 / 5)).card ≤ 1 := by
  refine le_trans (nbad_le_badShift v hv y) ?_
  rw [badShift_eq]
  exact badShift_le_one_f _ (Int.fract_nonneg y) (Int.fract_lt_one y) hC2

/-- If `fract y = 0` (runner at the origin), the count is 0. -/
theorem nbad_eq_zero_fract (v : ℕ) (hv : ¬ 5 ∣ v) (y : ℝ) (hf : Int.fract y = 0) :
    ((Finset.Icc 1 4).filter
      (fun j : ℕ => circDist (y + (j : ℝ) * (v : ℝ) / 5) < 1 / 5)).card = 0 := by
  have h1 := nbad_le_badShift v hv y
  rw [badShift_eq, hf, badShift_zero_f] at h1
  omega

/-- A `5`-divisible runner stays fixed under `+j/5`; if distant at `t`, count 0. -/
theorem nbad_dvd5 (v : ℕ) (h5 : 5 ∣ v) (y : ℝ) (hdist : 1 / 5 ≤ circDist y) :
    ((Finset.Icc 1 4).filter
      (fun j : ℕ => circDist (y + (j : ℝ) * (v : ℝ) / 5) < 1 / 5)).card = 0 := by
  rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
  intro j _
  rw [not_lt]
  obtain ⟨m, hm⟩ := h5
  have hval : y + (j : ℝ) * (v : ℝ) / 5 = y + ((j * m : ℕ) : ℝ) := by rw [hm]; push_cast; ring
  rw [hval]
  have hsh : circDist (y + ((j * m : ℕ) : ℝ)) = circDist y := by
    unfold circDist; rw [Int.fract_add_natCast]
  rw [hsh]; exact hdist

/-- The "off `C₂`" predicate: `fract y` not in the open interior `C₂`. -/
def offC2 (x : ℝ) : Prop := x ≤ 1 / 5 ∨ 4 / 5 ≤ x ∨ x = 2 / 5 ∨ x = 3 / 5

noncomputable instance : DecidablePred offC2 := fun x => by unfold offC2; infer_instance

/-- **Bienia's Lemma (3) — prime pigeonhole.**  Suppose the `5`-divisible runners
    (`D`) are all distant at `t`, and `|R₂| < |R₀|` where `R₀` collects the
    `5`-divisible-or-at-origin runners and `R₂` the non-`5`-divisible runners whose
    phase lies in the interior `C₂`.  Then some time `t + j/5` (`j ∈ {1,2,3,4}`)
    makes *every* runner distant.  Proof: a double-count.  Each runner is
    non-distant at ≤ `wtᵢ = [i∉R₀] + [i∈R₂]` of the four shifted times, so
    `Σᵢ nbadᵢ ≤ (4−|R₀|)+|R₂| < 4`; but if no shift worked every time has a bad
    runner, forcing `Σᵢ nbadᵢ ≥ 4` — contradiction. -/
theorem lemma3 (speeds : Fin 4 → ℕ) (t : ℝ)
    (hD : ∀ i, 5 ∣ speeds i → 1 / 5 ≤ circDist ((speeds i : ℝ) * t))
    (hcard :
      (Finset.univ.filter
          (fun i => ¬ 5 ∣ speeds i ∧ ¬ offC2 (Int.fract ((speeds i : ℝ) * t)))).card
        < (Finset.univ.filter
          (fun i => 5 ∣ speeds i ∨ Int.fract ((speeds i : ℝ) * t) = 0)).card) :
    ∃ j ∈ (Finset.Icc 1 4 : Finset ℕ),
      ∀ i, 1 / 5 ≤ circDist ((speeds i : ℝ) * (t + (j : ℝ) / 5)) := by
  by_contra hcon
  push_neg at hcon
  set R0 := Finset.univ.filter
    (fun i => 5 ∣ speeds i ∨ Int.fract ((speeds i : ℝ) * t) = 0) with hR0
  set R2 := Finset.univ.filter
    (fun i => ¬ 5 ∣ speeds i ∧ ¬ offC2 (Int.fract ((speeds i : ℝ) * t))) with hR2
  have hlow : 4 ≤ ∑ i : Fin 4, ((Finset.Icc 1 4).filter
      (fun j : ℕ => circDist ((speeds i : ℝ) * (t + (j : ℝ) / 5)) < 1 / 5)).card := by
    have hdc : ∑ i : Fin 4, ((Finset.Icc 1 4).filter
          (fun j : ℕ => circDist ((speeds i : ℝ) * (t + (j : ℝ) / 5)) < 1 / 5)).card
        = ∑ j ∈ (Finset.Icc 1 4 : Finset ℕ), (Finset.univ.filter
          (fun i : Fin 4 => circDist ((speeds i : ℝ) * (t + (j : ℝ) / 5)) < 1 / 5)).card := by
      simp_rw [Finset.card_filter]; rw [Finset.sum_comm]
    rw [hdc]
    have hcard4 : (Finset.Icc 1 4 : Finset ℕ).card = 4 := by decide
    calc (4 : ℕ) = ∑ _j ∈ (Finset.Icc 1 4 : Finset ℕ), 1 := by simp [Finset.sum_const, hcard4]
      _ ≤ _ := by
          apply Finset.sum_le_sum
          intro j hj
          obtain ⟨i, hi⟩ := hcon j hj
          exact Finset.card_pos.mpr ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩⟩
  have key : ∀ i : Fin 4, ((Finset.Icc 1 4).filter
        (fun j : ℕ => circDist ((speeds i : ℝ) * (t + (j : ℝ) / 5)) < 1 / 5)).card
      ≤ (if i ∉ R0 then 1 else 0) + (if i ∈ R2 then 1 else 0) := by
    intro i
    have hcongr : ((Finset.Icc 1 4).filter
          (fun j : ℕ => circDist ((speeds i : ℝ) * (t + (j : ℝ) / 5)) < 1 / 5))
        = ((Finset.Icc 1 4).filter
          (fun j : ℕ => circDist ((speeds i : ℝ) * t + (j : ℝ) * (speeds i : ℝ) / 5) < 1 / 5)) := by
      apply Finset.filter_congr; intro j _
      rw [show (speeds i : ℝ) * (t + (j : ℝ) / 5)
          = (speeds i : ℝ) * t + (j : ℝ) * (speeds i : ℝ) / 5 from by ring]
    rw [hcongr]
    by_cases h0 : i ∈ R0
    · rw [if_neg (not_not.mpr h0)]
      have hz : ((Finset.Icc 1 4).filter
          (fun j : ℕ => circDist ((speeds i : ℝ) * t + (j : ℝ) * (speeds i : ℝ) / 5) < 1 / 5)).card
          = 0 := by
        simp only [hR0, Finset.mem_filter, Finset.mem_univ, true_and] at h0
        rcases h0 with h5 | hfr
        · exact nbad_dvd5 (speeds i) h5 _ (hD i h5)
        · by_cases h5 : 5 ∣ speeds i
          · exact nbad_dvd5 (speeds i) h5 _ (hD i h5)
          · exact nbad_eq_zero_fract (speeds i) h5 _ hfr
      rw [hz]; exact Nat.zero_le _
    · rw [if_pos h0]
      have h5 : ¬ 5 ∣ speeds i := fun h =>
        h0 (by rw [hR0]; exact Finset.mem_filter.mpr ⟨Finset.mem_univ i, Or.inl h⟩)
      by_cases h2 : i ∈ R2
      · rw [if_pos h2]; exact le_trans (nbad_le_two (speeds i) h5 _) (by norm_num)
      · rw [if_neg h2]
        have hoff : offC2 (Int.fract ((speeds i : ℝ) * t)) := by
          by_contra hno
          exact h2 (by rw [hR2]; exact Finset.mem_filter.mpr ⟨Finset.mem_univ i, ⟨h5, hno⟩⟩)
        exact le_trans (nbad_le_one (speeds i) h5 _ hoff) (by norm_num)
  have hf2 : Finset.univ.filter (fun i : Fin 4 => i ∈ R2) = R2 := by ext i; simp
  have hf0 : Finset.univ.filter (fun i : Fin 4 => i ∉ R0) = Finset.univ \ R0 := by ext i; simp
  have hup : (∑ i : Fin 4, ((Finset.Icc 1 4).filter
        (fun j : ℕ => circDist ((speeds i : ℝ) * (t + (j : ℝ) / 5)) < 1 / 5)).card)
      ≤ (4 - R0.card) + R2.card := by
    refine le_trans (Finset.sum_le_sum (fun i _ => key i)) ?_
    rw [Finset.sum_add_distrib]
    have e1 : ∑ i : Fin 4, (if i ∈ R2 then 1 else 0) = R2.card := by
      rw [← Finset.sum_filter, hf2, Finset.sum_const, smul_eq_mul, mul_one]
    have e2 : ∑ i : Fin 4, (if i ∉ R0 then 1 else 0) = 4 - R0.card := by
      rw [← Finset.sum_filter, hf0, Finset.sum_const, smul_eq_mul, mul_one, Finset.card_sdiff]
      simp
    rw [e1, e2]
  have hR0le : R0.card ≤ 4 := by
    rw [hR0]
    exact le_trans (Finset.card_filter_le _ _) (by rw [Finset.card_univ, Fintype.card_fin])
  omega

/-! ### Bienia §4 — applying Lemma (3) -/

/-- A non-distant runner has its phase off `C₂`, hence cannot lie in `R₂`. -/
theorem not_distant_offC2 (x : ℝ) (h : circDist x < 1 / 5) :
    Int.fract x ≤ 1 / 5 ∨ 4 / 5 ≤ Int.fract x ∨ Int.fract x = 2 / 5 ∨ Int.fract x = 3 / 5 := by
  unfold circDist at h
  rcases min_lt_iff.mp h with h' | h'
  · exact Or.inl (le_of_lt h')
  · exact Or.inr (Or.inl (by linarith))

/-- Three sorted runners with (symmetric) coprimality are simultaneously distant
    at gap `1/4` — `intLRC 4` specialised to the explicit ordered triple `![a,b,c]`. -/
theorem three_runner_quarter_ordered (a b c : ℕ) (ha : 0 < a) (hab : a < b) (hbc : b < c)
    (hcop : ∀ d : ℕ, d ∣ a → d ∣ b → d ∣ c → d = 1) :
    ∃ t : ℝ, 1 / 4 ≤ circDist ((a : ℝ) * t) ∧ 1 / 4 ≤ circDist ((b : ℝ) * t) ∧
      1 / 4 ≤ circDist ((c : ℝ) * t) := by
  have hmono : StrictMono (![a, b, c] : Fin 3 → ℕ) := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all [Fin.lt_def] <;> omega
  have hpos : ∀ i, 0 < (![a, b, c] : Fin 3 → ℕ) i := by
    intro i; fin_cases i <;> simp <;> omega
  have hg : Finset.gcd Finset.univ (![a, b, c] : Fin 3 → ℕ) = 1 := by
    apply hcop
    · simpa using Finset.gcd_dvd (Finset.mem_univ (0 : Fin 3))
    · simpa using Finset.gcd_dvd (Finset.mem_univ (1 : Fin 3))
    · simpa using Finset.gcd_dvd (Finset.mem_univ (2 : Fin 3))
  obtain ⟨t, ht⟩ := intLRC_four (![a, b, c]) hmono hpos hg
  exact ⟨t, by have := ht 0; simpa using this, by have := ht 1; simpa using this,
    by have := ht 2; simpa using this⟩

/-- Unordered version: any three distinct coprime runners are distant at gap `1/4`. -/
theorem three_runner_quarter (a b c : ℕ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c)
    (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c)
    (hcop : ∀ d : ℕ, d ∣ a → d ∣ b → d ∣ c → d = 1) :
    ∃ t : ℝ, 1 / 4 ≤ circDist ((a : ℝ) * t) ∧ 1 / 4 ≤ circDist ((b : ℝ) * t) ∧
      1 / 4 ≤ circDist ((c : ℝ) * t) := by
  rcases lt_trichotomy a b with h1 | h1 | h1
  · rcases lt_trichotomy b c with h2 | h2 | h2
    · obtain ⟨t, p, q, r⟩ := three_runner_quarter_ordered a b c ha h1 h2 hcop; exact ⟨t, p, q, r⟩
    · exact absurd h2 hbc
    · rcases lt_trichotomy a c with h3 | h3 | h3
      · obtain ⟨t, p, q, r⟩ := three_runner_quarter_ordered a c b ha h3 h2
          (fun d d1 d2 d3 => hcop d d1 d3 d2)
        exact ⟨t, p, r, q⟩
      · exact absurd h3 hac
      · obtain ⟨t, p, q, r⟩ := three_runner_quarter_ordered c a b hc h3 h1
          (fun d d1 d2 d3 => hcop d d2 d3 d1)
        exact ⟨t, q, r, p⟩
  · exact absurd h1 hab
  · rcases lt_trichotomy a c with h3 | h3 | h3
    · obtain ⟨t, p, q, r⟩ := three_runner_quarter_ordered b a c hb h1 h3
        (fun d d1 d2 d3 => hcop d d2 d1 d3)
      exact ⟨t, q, p, r⟩
    · exact absurd h3 hac
    · rcases lt_trichotomy b c with h2 | h2 | h2
      · obtain ⟨t, p, q, r⟩ := three_runner_quarter_ordered b c a hb h2 h3
          (fun d d1 d2 d3 => hcop d d3 d1 d2)
        exact ⟨t, r, p, q⟩
      · exact absurd h2 hbc
      · obtain ⟨t, p, q, r⟩ := three_runner_quarter_ordered c b a hc h2 h1
          (fun d d1 d2 d3 => hcop d d3 d2 d1)
        exact ⟨t, r, q, p⟩

/-- **Three distinct runners are simultaneously distant at gap `1/5`.**  Divide by
    `g = gcd`, apply `three_runner_quarter` (gap `1/4 ≥ 1/5`) to the coprime triple,
    rescale time by `1/g`. -/
theorem three_runner_fifth (a b c : ℕ) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c)
    (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c) :
    ∃ t : ℝ, 1 / 5 ≤ circDist ((a : ℝ) * t) ∧ 1 / 5 ≤ circDist ((b : ℝ) * t) ∧
      1 / 5 ≤ circDist ((c : ℝ) * t) := by
  set g := Nat.gcd a (Nat.gcd b c) with hgdef
  have hg0 : 0 < g := Nat.gcd_pos_iff.mpr (Or.inl ha)
  have hga : g ∣ a := Nat.gcd_dvd_left _ _
  have hgbc : g ∣ Nat.gcd b c := Nat.gcd_dvd_right _ _
  have hgb : g ∣ b := hgbc.trans (Nat.gcd_dvd_left _ _)
  have hgc : g ∣ c := hgbc.trans (Nat.gcd_dvd_right _ _)
  have hae : a = g * (a / g) := (Nat.mul_div_cancel' hga).symm
  have hbe : b = g * (b / g) := (Nat.mul_div_cancel' hgb).symm
  have hce : c = g * (c / g) := (Nat.mul_div_cancel' hgc).symm
  have ha' : 0 < a / g := Nat.div_pos (Nat.le_of_dvd ha hga) hg0
  have hb' : 0 < b / g := Nat.div_pos (Nat.le_of_dvd hb hgb) hg0
  have hc' : 0 < c / g := Nat.div_pos (Nat.le_of_dvd hc hgc) hg0
  have hd1 : a / g ≠ b / g := fun h => hab (by rw [hae, hbe, h])
  have hd2 : a / g ≠ c / g := fun h => hac (by rw [hae, hce, h])
  have hd3 : b / g ≠ c / g := fun h => hbc (by rw [hbe, hce, h])
  have hcop : ∀ d : ℕ, d ∣ a / g → d ∣ b / g → d ∣ c / g → d = 1 := by
    intro d hda hdb hdc
    have kda : d * g ∣ a := by obtain ⟨k, hk⟩ := hda; exact ⟨k, by rw [hae, hk]; ring⟩
    have kdb : d * g ∣ b := by obtain ⟨k, hk⟩ := hdb; exact ⟨k, by rw [hbe, hk]; ring⟩
    have kdc : d * g ∣ c := by obtain ⟨k, hk⟩ := hdc; exact ⟨k, by rw [hce, hk]; ring⟩
    have key : d * g ∣ g := Nat.dvd_gcd kda (Nat.dvd_gcd kdb kdc)
    have heq : d * g = g := Nat.dvd_antisymm key (dvd_mul_left g d)
    exact Nat.eq_of_mul_eq_mul_right hg0 (by rw [heq, one_mul])
  obtain ⟨τ, p, q, r⟩ := three_runner_quarter (a / g) (b / g) (c / g) ha' hb' hc' hd1 hd2 hd3 hcop
  have hgR : (g : ℝ) ≠ 0 := by exact_mod_cast hg0.ne'
  refine ⟨τ / (g : ℝ), ?_, ?_, ?_⟩
  · rw [show (a : ℝ) * (τ / (g : ℝ)) = ((a / g : ℕ) : ℝ) * τ from by
        rw [show (a : ℝ) = (g : ℝ) * ((a / g : ℕ) : ℝ) from by exact_mod_cast hae]; field_simp]
    linarith
  · rw [show (b : ℝ) * (τ / (g : ℝ)) = ((b / g : ℕ) : ℝ) * τ from by
        rw [show (b : ℝ) = (g : ℝ) * ((b / g : ℕ) : ℝ) from by exact_mod_cast hbe]; field_simp]
    linarith
  · rw [show (c : ℝ) * (τ / (g : ℝ)) = ((c / g : ℕ) : ℝ) * τ from by
        rw [show (c : ℝ) = (g : ℝ) * ((c / g : ℕ) : ℝ) from by exact_mod_cast hce]; field_simp]
    linarith

open Finset in
/-- **`|D| = 3` case.** Three speeds divisible by 5: `three_runner_fifth` gives a
    time where they (and so all of `D`) are distant; then `|R₂| ≤ 1 < 3 ≤ |R₀|`,
    so `lemma3` finishes. -/
theorem case_D3 (speeds : Fin 4 → ℕ) (hmono : StrictMono speeds) (hpos : ∀ i, 0 < speeds i)
    (hD3 : (univ.filter (fun i => 5 ∣ speeds i)).card = 3) :
    ∃ t : ℝ, ∀ i, 1 / 5 ≤ circDist ((speeds i : ℝ) * t) := by
  obtain ⟨i, j, k, hij, hik, hjk, hDeq⟩ := Finset.card_eq_three.mp hD3
  have getmem : ∀ m, m ∈ ({i, j, k} : Finset (Fin 4)) → 5 ∣ speeds m := by
    intro m hm
    have : m ∈ univ.filter (fun n => 5 ∣ speeds n) := by rw [hDeq]; exact hm
    exact (Finset.mem_filter.mp this).2
  obtain ⟨τ, di, dj, dk⟩ := three_runner_fifth (speeds i) (speeds j) (speeds k)
    (hpos i) (hpos j) (hpos k)
    (hmono.injective.ne hij) (hmono.injective.ne hik) (hmono.injective.ne hjk)
  have hDdist : ∀ m, 5 ∣ speeds m → 1 / 5 ≤ circDist ((speeds m : ℝ) * τ) := by
    intro m hm
    have hmem : m ∈ univ.filter (fun n => 5 ∣ speeds n) := by simp [hm]
    rw [hDeq, Finset.mem_insert, Finset.mem_insert, Finset.mem_singleton] at hmem
    rcases hmem with rfl | rfl | rfl
    · exact di
    · exact dj
    · exact dk
  have hcard : (univ.filter (fun m => ¬ 5 ∣ speeds m ∧
        ¬ offC2 (Int.fract ((speeds m : ℝ) * τ)))).card
      < (univ.filter (fun m => 5 ∣ speeds m ∨ Int.fract ((speeds m : ℝ) * τ) = 0)).card := by
    have hsub0 : univ.filter (fun m => 5 ∣ speeds m)
        ⊆ univ.filter (fun m => 5 ∣ speeds m ∨ Int.fract ((speeds m : ℝ) * τ) = 0) := by
      intro m hm; rw [Finset.mem_filter] at hm ⊢; exact ⟨hm.1, Or.inl hm.2⟩
    have h1 : 3 ≤ (univ.filter (fun m => 5 ∣ speeds m ∨
        Int.fract ((speeds m : ℝ) * τ) = 0)).card := by rw [← hD3]; exact Finset.card_le_card hsub0
    have hsub2 : univ.filter (fun m => ¬ 5 ∣ speeds m ∧
          ¬ offC2 (Int.fract ((speeds m : ℝ) * τ)))
        ⊆ univ.filter (fun m => ¬ 5 ∣ speeds m) := by
      intro m hm; rw [Finset.mem_filter] at hm ⊢; exact ⟨hm.1, hm.2.1⟩
    have hneg : (univ.filter (fun m => ¬ 5 ∣ speeds m)).card = 1 := by
      have hsplit := Finset.filter_card_add_filter_neg_card_eq_card
        (s := (univ : Finset (Fin 4))) (p := fun m => 5 ∣ speeds m)
      rw [Finset.card_univ, Fintype.card_fin, hD3] at hsplit
      omega
    have h2 : (univ.filter (fun m => ¬ 5 ∣ speeds m ∧
        ¬ offC2 (Int.fract ((speeds m : ℝ) * τ)))).card ≤ 1 := by
      rw [← hneg]; exact Finset.card_le_card hsub2
    omega
  obtain ⟨jj, _, hall⟩ := lemma3 speeds τ hDdist hcard
  exact ⟨τ + (jj : ℝ) / 5, hall⟩

open Finset in
/-- **`|D| = 2` case.** Two speeds divisible by 5: `two_runner_quarter` gives a
    time where they (so all of `D`) are distant.  Either all four are distant
    (done), or some non-`D` runner is not — by `not_distant_offC2` it lies off
    `C₂`, so `|R₂| ≤ 1 < 2 ≤ |R₀|` and `lemma3` finishes. -/
theorem case_D2 (speeds : Fin 4 → ℕ) (hmono : StrictMono speeds) (hpos : ∀ i, 0 < speeds i)
    (hD2 : (univ.filter (fun i => 5 ∣ speeds i)).card = 2) :
    ∃ t : ℝ, ∀ i, 1 / 5 ≤ circDist ((speeds i : ℝ) * t) := by
  obtain ⟨i, j, hij, hDeq⟩ := Finset.card_eq_two.mp hD2
  obtain ⟨τ, di', dj'⟩ := two_runner_quarter (speeds i) (speeds j) (hpos i) (hpos j)
    (hmono.injective.ne hij)
  have hDdist : ∀ m, 5 ∣ speeds m → 1 / 5 ≤ circDist ((speeds m : ℝ) * τ) := by
    intro m hm
    have hmem : m ∈ univ.filter (fun n => 5 ∣ speeds n) := by simp [hm]
    rw [hDeq, Finset.mem_insert, Finset.mem_singleton] at hmem
    rcases hmem with rfl | rfl
    · linarith [di']
    · linarith [dj']
  by_cases hall : ∀ m, 1 / 5 ≤ circDist ((speeds m : ℝ) * τ)
  · exact ⟨τ, hall⟩
  · push_neg at hall
    obtain ⟨m, hm⟩ := hall
    have hmlt : circDist ((speeds m : ℝ) * τ) < 1 / 5 := hm
    have hmnD : ¬ 5 ∣ speeds m := fun h => absurd (hDdist m h) (not_le.mpr hmlt)
    have hoffm : offC2 (Int.fract ((speeds m : ℝ) * τ)) := not_distant_offC2 _ hmlt
    have hcard : (univ.filter (fun n => ¬ 5 ∣ speeds n ∧
          ¬ offC2 (Int.fract ((speeds n : ℝ) * τ)))).card
        < (univ.filter (fun n => 5 ∣ speeds n ∨ Int.fract ((speeds n : ℝ) * τ) = 0)).card := by
      have h1 : 2 ≤ (univ.filter (fun n => 5 ∣ speeds n ∨
          Int.fract ((speeds n : ℝ) * τ) = 0)).card := by
        rw [← hD2]; apply Finset.card_le_card
        intro n hn; rw [Finset.mem_filter] at hn ⊢; exact ⟨hn.1, Or.inl hn.2⟩
      have hmfilt : m ∈ univ.filter (fun n => ¬ 5 ∣ speeds n) := by simp [hmnD]
      have hmR2 : m ∉ univ.filter (fun n => ¬ 5 ∣ speeds n ∧
          ¬ offC2 (Int.fract ((speeds n : ℝ) * τ))) := by
        rw [Finset.mem_filter]; rintro ⟨-, -, hno⟩; exact hno hoffm
      have hsub2 : univ.filter (fun n => ¬ 5 ∣ speeds n ∧
            ¬ offC2 (Int.fract ((speeds n : ℝ) * τ)))
          ⊆ (univ.filter (fun n => ¬ 5 ∣ speeds n)).erase m := by
        intro n hn
        rw [Finset.mem_erase, Finset.mem_filter]
        exact ⟨by rintro rfl; exact hmR2 hn, mem_univ n, (Finset.mem_filter.mp hn).2.1⟩
      have hneg2 : (univ.filter (fun n => ¬ 5 ∣ speeds n)).card = 2 := by
        have hs := Finset.filter_card_add_filter_neg_card_eq_card
          (s := (univ : Finset (Fin 4))) (p := fun n => 5 ∣ speeds n)
        rw [Finset.card_univ, Fintype.card_fin, hD2] at hs
        omega
      have h2 : (univ.filter (fun n => ¬ 5 ∣ speeds n ∧
          ¬ offC2 (Int.fract ((speeds n : ℝ) * τ)))).card ≤ 1 := by
        calc _ ≤ ((univ.filter (fun n => ¬ 5 ∣ speeds n)).erase m).card :=
              Finset.card_le_card hsub2
          _ = (univ.filter (fun n => ¬ 5 ∣ speeds n)).card - 1 := Finset.card_erase_of_mem hmfilt
          _ = 1 := by rw [hneg2]
      omega
    obtain ⟨jj, _, hallj⟩ := lemma3 speeds τ hDdist hcard
    exact ⟨τ + (jj : ℝ) / 5, hallj⟩

/-- **Distance doubling.**  If `circDist z ≤ 1/4`, doubling the time doubles the
    distance: `circDist (2z) = 2·circDist z`.  (First brick of Bienia's `|D|=1`
    doubling argument for the ÷5-runner-not-fastest sub-case.) -/
theorem circDist_two_mul (z : ℝ) (hz : circDist z ≤ 1 / 4) :
    circDist (2 * z) = 2 * circDist z := by
  have hf0 := Int.fract_nonneg z
  have hf1 := Int.fract_lt_one z
  set f := Int.fract z with hfdef
  have hfr : Int.fract (2 * z) = Int.fract (2 * f) := by
    conv_lhs => rw [← Int.floor_add_fract z]
    rw [mul_add, show 2 * (↑⌊z⌋ : ℝ) + 2 * f = 2 * f + ((2 * ⌊z⌋ : ℤ) : ℝ) from by push_cast; ring,
      Int.fract_add_intCast]
  have hcz : circDist z = min f (1 - f) := by rw [circDist]
  rw [hcz] at hz
  rw [circDist, hfr, hcz]
  rcases le_or_gt f (1 / 2) with hf | hf
  · rw [min_eq_left (show f ≤ 1 - f by linarith)] at hz ⊢
    rw [Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩, min_eq_left (by linarith)]
  · rw [min_eq_right (show 1 - f ≤ f by linarith)] at hz ⊢
    have hfr2 : Int.fract (2 * f) = 2 * f - 1 := by
      conv_lhs => rw [show 2 * f = (2 * f - 1) + 1 from by ring]
      rw [Int.fract_add_one, Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩]
    rw [hfr2, min_eq_right (by linarith)]
    ring

/-- **Iterated distance doubling.**  If `2ʲ·circDist w ≤ 1/2`, then
    `circDist (2ʲ·w) = 2ʲ·circDist w`.  The engine of the doubling minimality. -/
theorem circDist_two_pow (w : ℝ) (j : ℕ) (h : (2 : ℝ) ^ j * circDist w ≤ 1 / 2) :
    circDist ((2 : ℝ) ^ j * w) = (2 : ℝ) ^ j * circDist w := by
  induction j with
  | zero => simp
  | succ n ih =>
    have hstep : (2 : ℝ) ^ (n + 1) * circDist w = 2 * ((2 : ℝ) ^ n * circDist w) := by
      rw [pow_succ]; ring
    have hn4 : (2 : ℝ) ^ n * circDist w ≤ 1 / 4 := by rw [hstep] at h; linarith
    have hn2 : (2 : ℝ) ^ n * circDist w ≤ 1 / 2 := by linarith
    have hcn : circDist ((2 : ℝ) ^ n * w) ≤ 1 / 4 := by rw [ih hn2]; exact hn4
    rw [show (2 : ℝ) ^ (n + 1) * w = 2 * ((2 : ℝ) ^ n * w) from by rw [pow_succ]; ring,
      circDist_two_mul _ hcn, ih hn2, hstep]

/-- **Doubling step (Bienia §4 crux).**  Suppose at base time `x`: the fastest
    runner `vF` is at the origin (`fract(vF·x)=0`), the ÷5 runner `vE` is *not*
    distant (`0 < δe := circDist(vE·x) < 1/5`), and the third runner `v3` has
    `circDist(v3·x) ≤ δe/2`.  Doubling time to `t = 2ᴶx` (least `J` with
    `2ᴶ·δe ≥ 1/5`) keeps `vF` at the origin, makes `vE` distant, and keeps `v3`
    non-distant.  Distances double in lockstep (`circDist_two_pow`); minimality of
    `J` gives `2ᴶ·δe < 2/5`, so `2ᴶ·(δe/2) < 1/5` bounds `v3`. -/
theorem doubling_step (vF vE v3 : ℕ) (x : ℝ)
    (hF : Int.fract ((vF : ℝ) * x) = 0)
    (hδe_pos : 0 < circDist ((vE : ℝ) * x))
    (hδe_lt : circDist ((vE : ℝ) * x) < 1 / 5)
    (hδ3 : circDist ((v3 : ℝ) * x) ≤ circDist ((vE : ℝ) * x) / 2) :
    ∃ t : ℝ, Int.fract ((vF : ℝ) * t) = 0 ∧ 1 / 5 ≤ circDist ((vE : ℝ) * t) ∧
      circDist ((v3 : ℝ) * t) < 1 / 5 := by
  set δe := circDist ((vE : ℝ) * x) with hδe_def
  set δ3 := circDist ((v3 : ℝ) * x) with hδ3_def
  have hex : ∃ j : ℕ, (1 : ℝ) / 5 ≤ 2 ^ j * δe := by
    obtain ⟨N, hN⟩ := exists_nat_gt ((1 / 5) / δe)
    refine ⟨N, ?_⟩
    have h2N : (N : ℝ) ≤ 2 ^ N := by
      calc (N : ℝ) ≤ ((2 ^ N : ℕ) : ℝ) := by exact_mod_cast Nat.lt_two_pow_self.le
        _ = 2 ^ N := by push_cast; ring
    have h1 : (1 : ℝ) / 5 < (N : ℝ) * δe := (div_lt_iff₀ hδe_pos).mp hN
    have h2 : (N : ℝ) * δe ≤ 2 ^ N * δe := mul_le_mul_of_nonneg_right h2N hδe_pos.le
    linarith
  classical
  set J := Nat.find hex with hJ
  have hJspec : (1 : ℝ) / 5 ≤ 2 ^ J * δe := Nat.find_spec hex
  have hJ0 : J ≠ 0 := by
    intro h; rw [h, pow_zero, one_mul] at hJspec; linarith
  have hJpred : 2 ^ (J - 1) * δe < 1 / 5 :=
    not_le.mp (Nat.find_min hex (show J - 1 < J by omega))
  have hpow : (2 : ℝ) ^ J = 2 ^ (J - 1) * 2 := by
    conv_lhs => rw [show J = (J - 1) + 1 by omega]
    rw [pow_succ]
  have hJlt : 2 ^ J * δe < 2 / 5 := by rw [hpow]; nlinarith [hJpred]
  have hpowpos : (0 : ℝ) < 2 ^ J := by positivity
  refine ⟨2 ^ J * x, ?_, ?_, ?_⟩
  · have hz : (vF : ℝ) * x = ((⌊(vF : ℝ) * x⌋ : ℤ) : ℝ) := by
      have h := Int.floor_add_fract ((vF : ℝ) * x)
      rw [hF, add_zero] at h; exact h.symm
    rw [show (vF : ℝ) * (2 ^ J * x) = 2 ^ J * ((vF : ℝ) * x) by ring, hz,
      show (2 : ℝ) ^ J * ((⌊(vF : ℝ) * x⌋ : ℤ) : ℝ) = (((2 ^ J : ℤ) * ⌊(vF : ℝ) * x⌋ : ℤ) : ℝ) by
        push_cast; ring]
    exact Int.fract_intCast _
  · rw [show (vE : ℝ) * (2 ^ J * x) = 2 ^ J * ((vE : ℝ) * x) by ring,
      circDist_two_pow ((vE : ℝ) * x) J (by rw [← hδe_def]; linarith), ← hδe_def]
    exact hJspec
  · have h3half : 2 ^ J * δ3 ≤ 2 ^ J * δe / 2 := by nlinarith [hδ3]
    rw [show (v3 : ℝ) * (2 ^ J * x) = 2 ^ J * ((v3 : ℝ) * x) by ring,
      circDist_two_pow ((v3 : ℝ) * x) J (by rw [← hδ3_def]; nlinarith), ← hδ3_def]
    nlinarith

/-- A nonzero integer of absolute value `< m` is not divisible by `m`. -/
theorem not_dvd_of_natAbs_lt (m : ℕ) (c : ℤ) (hc : c ≠ 0) (hlt : c.natAbs < m) :
    ¬ (m : ℤ) ∣ c := by
  intro hdvd
  have hna : (m : ℤ).natAbs ∣ c.natAbs := Int.natAbs_dvd_natAbs.mpr hdvd
  rw [Int.natAbs_natCast] at hna
  exact absurd (Nat.le_of_dvd (Int.natAbs_pos.mpr hc) hna) (not_le.mpr hlt)

/-- `circDist` of an integer fraction `c / m` in terms of `c % m`. -/
theorem circDist_intCast_div (c : ℤ) (m : ℕ) :
    circDist ((c : ℝ) / (m : ℝ)) =
      min ((↑(c % (m : ℤ)) : ℝ) / (m : ℝ)) (1 - (↑(c % (m : ℤ)) : ℝ) / (m : ℝ)) := by
  rw [circDist, Int.fract_div_intCast_eq_div_intCast_mod]

/-- **Bézout-position distances.**  At `x = α/vF` with `α·v3 ≡ 1 (mod vF)` and
    `gcd(α, vF) = 1`: runner `v3` sits at distance exactly `1/vF`, and runner `vE`
    (with `0<vE<vF`, `vE ≠ v3`, `vE+v3 ≠ vF`) sits at distance `≥ 2/vF` — the
    "twice fact", because `α·vE ≢ 0, ±1 (mod vF)`. -/
theorem bezout_distances (vF vE v3 : ℕ) (α : ℤ) (hvE0 : 0 < vE) (hvEF : vE < vF)
    (hv30 : 0 < v3) (hv3F : v3 < vF) (hEne3 : vE ≠ v3) (hsum : vE + v3 ≠ vF)
    (hcopα : IsCoprime (α : ℤ) (vF : ℤ)) (h1 : (α : ℤ) * v3 ≡ 1 [ZMOD vF]) :
    circDist ((v3 : ℝ) * ((α : ℝ) / (vF : ℝ))) = 1 / (vF : ℝ) ∧
      2 / (vF : ℝ) ≤ circDist ((vE : ℝ) * ((α : ℝ) / (vF : ℝ))) := by
  have hvF2 : 2 ≤ vF := by omega
  have hvF0 : 0 < vF := by omega
  have hvFR : (0 : ℝ) < (vF : ℝ) := by exact_mod_cast hvF0
  have hvFRne : (vF : ℝ) ≠ 0 := hvFR.ne'
  have hcopFα : IsCoprime (vF : ℤ) (α : ℤ) := hcopα.symm
  have h1vF : (1 : ℤ) % (vF : ℤ) = 1 := Int.emod_eq_of_lt (by norm_num) (by exact_mod_cast hvF2)
  -- runner v3 at exactly 1/vF
  have hc3mod : ((α : ℤ) * v3) % (vF : ℤ) = 1 := by
    have := h1; rw [Int.ModEq] at this; rw [this, h1vF]
  have hpos3 : (v3 : ℝ) * ((α : ℝ) / (vF : ℝ)) = ((α * (v3 : ℤ) : ℤ) : ℝ) / (vF : ℝ) := by
    push_cast; ring
  have h3 : circDist ((v3 : ℝ) * ((α : ℝ) / (vF : ℝ))) = 1 / (vF : ℝ) := by
    rw [hpos3, circDist_intCast_div, hc3mod]
    have hle : (1 : ℝ) / (vF : ℝ) ≤ 1 - 1 / (vF : ℝ) := by
      rw [le_sub_iff_add_le]
      have e : (1 : ℝ) / (vF : ℝ) + 1 / (vF : ℝ) = 2 / (vF : ℝ) := by ring
      rw [e, div_le_one hvFR]; exact_mod_cast hvF2
    simpa using min_eq_left hle
  refine ⟨h3, ?_⟩
  -- runner vE at ≥ 2/vF
  set ρ : ℤ := ((α : ℤ) * vE) % (vF : ℤ) with hρdef
  have hρ0 : 0 ≤ ρ := Int.emod_nonneg _ (by exact_mod_cast hvF0.ne')
  have hρlt : ρ < (vF : ℤ) := Int.emod_lt_of_pos _ (by exact_mod_cast hvF0)
  -- ρ ≠ 0
  have hρne0 : ρ ≠ 0 := by
    intro h
    have hdvd : (vF : ℤ) ∣ (α : ℤ) * vE := Int.dvd_of_emod_eq_zero (by rw [← hρdef, h])
    have hd : (vF : ℤ) ∣ (vE : ℤ) := hcopFα.dvd_of_dvd_mul_left hdvd
    exact not_dvd_of_natAbs_lt vF vE (by exact_mod_cast hvE0.ne') (by simpa using hvEF) hd
  -- ρ ≠ 1
  have hρne1 : ρ ≠ 1 := by
    intro h
    have hcong : (α : ℤ) * vE ≡ α * v3 [ZMOD vF] := by rw [Int.ModEq, ← hρdef, h, hc3mod]
    have hdvd : (vF : ℤ) ∣ ((α : ℤ) * v3 - α * vE) := (Int.modEq_iff_dvd).mp hcong
    have hdvd2 : (vF : ℤ) ∣ (α : ℤ) * ((v3 : ℤ) - vE) := by rw [mul_sub]; exact hdvd
    have hdvd3 : (vF : ℤ) ∣ ((v3 : ℤ) - vE) := hcopFα.dvd_of_dvd_mul_left hdvd2
    have hne : (v3 : ℤ) - vE ≠ 0 := by omega
    have hlt : ((v3 : ℤ) - vE).natAbs < vF := by omega
    exact not_dvd_of_natAbs_lt vF _ hne hlt hdvd3
  -- ρ ≠ vF - 1
  have hρneF : ρ ≠ (vF : ℤ) - 1 := by
    intro h
    have hz : ((α : ℤ) * vE + α * v3) % (vF : ℤ) = 0 := by
      rw [Int.add_emod, ← hρdef, h, hc3mod, show (vF : ℤ) - 1 + 1 = vF by ring, Int.emod_self]
    have hdvd : (vF : ℤ) ∣ ((α : ℤ) * vE + α * v3) := Int.dvd_of_emod_eq_zero hz
    have hdvd2 : (vF : ℤ) ∣ (α : ℤ) * ((vE : ℤ) + v3) := by rw [mul_add]; exact hdvd
    have hdvd3 : (vF : ℤ) ∣ ((vE : ℤ) + v3) := hcopFα.dvd_of_dvd_mul_left hdvd2
    have hdvd4 : (vF : ℤ) ∣ ((vE : ℤ) + v3 - vF) := dvd_sub hdvd3 (dvd_refl _)
    have hne : (vE : ℤ) + v3 - vF ≠ 0 := by omega
    have hlt : ((vE : ℤ) + v3 - vF).natAbs < vF := by omega
    exact not_dvd_of_natAbs_lt vF _ hne hlt hdvd4
  -- combine: 2 ≤ ρ ≤ vF - 2
  have hρ2 : 2 ≤ ρ := by omega
  have hρle : ρ ≤ (vF : ℤ) - 2 := by omega
  have hposE : (vE : ℝ) * ((α : ℝ) / (vF : ℝ)) = ((α * (vE : ℤ) : ℤ) : ℝ) / (vF : ℝ) := by
    push_cast; ring
  rw [hposE, circDist_intCast_div, ← hρdef]
  have hρR2 : (2 : ℝ) ≤ (ρ : ℝ) := by exact_mod_cast hρ2
  have hρRle : (ρ : ℝ) ≤ (vF : ℝ) - 2 := by
    have h2 : ((vF : ℝ) - 2) = (((vF : ℤ) - 2 : ℤ) : ℝ) := by push_cast; ring
    rw [h2]; exact_mod_cast hρle
  apply le_min
  · rw [div_le_iff₀ hvFR, div_mul_cancel₀ _ hvFRne]; exact hρR2
  · rw [le_sub_iff_add_le]
    have e : (2 : ℝ) / (vF : ℝ) + (ρ : ℝ) / (vF : ℝ) = (2 + ρ) / (vF : ℝ) := by ring
    rw [e, div_le_one hvFR]; linarith

open Finset in
/-- **Closing via Lemma 3 (`|D| = 1`).**  At time `t`: the unique ÷5 runner `e` is
    distant, the fastest runner `3` is at the origin, and the chosen runner `i3`
    is *not* distant.  Then `R₀ ⊇ {3, e}` (`|R₀| ≥ 2`) while `R₂` can contain only
    the fourth runner (`|R₂| ≤ 1`), so `lemma3` yields an all-distant time. -/
theorem close_via_lemma3 (speeds : Fin 4 → ℕ) (t : ℝ) (e i3 : Fin 4) (he : 5 ∣ speeds e)
    (hD1 : (univ.filter (fun i => 5 ∣ speeds i)).card = 1)
    (he3 : e ≠ 3) (hi33 : i3 ≠ 3) (hi3e : i3 ≠ e)
    (hEdist : 1 / 5 ≤ circDist ((speeds e : ℝ) * t))
    (hForig : Int.fract ((speeds 3 : ℝ) * t) = 0)
    (h3notdist : circDist ((speeds i3 : ℝ) * t) < 1 / 5) :
    ∃ t' : ℝ, ∀ i, 1 / 5 ≤ circDist ((speeds i : ℝ) * t') := by
  -- the ÷5 set is exactly {e}
  obtain ⟨a, ha⟩ := Finset.card_eq_one.mp hD1
  have hea : e = a := by
    have : e ∈ ({a} : Finset (Fin 4)) := ha ▸ Finset.mem_filter.mpr ⟨mem_univ _, he⟩
    rwa [Finset.mem_singleton] at this
  have hDeq : univ.filter (fun i => 5 ∣ speeds i) = {e} := by rw [ha, hea]
  have hDdist : ∀ m, 5 ∣ speeds m → 1 / 5 ≤ circDist ((speeds m : ℝ) * t) := by
    intro m hm
    have hmem : m ∈ univ.filter (fun n => 5 ∣ speeds n) := mem_filter.mpr ⟨mem_univ _, hm⟩
    rw [hDeq, Finset.mem_singleton] at hmem; subst hmem; exact hEdist
  -- |R₂| ≤ 1 < 2 ≤ |R₀|
  have hcard : (univ.filter (fun i => ¬ 5 ∣ speeds i ∧
        ¬ offC2 (Int.fract ((speeds i : ℝ) * t)))).card
      < (univ.filter (fun i => 5 ∣ speeds i ∨ Int.fract ((speeds i : ℝ) * t) = 0)).card := by
    have h2le : 2 ≤ (univ.filter (fun i => 5 ∣ speeds i ∨
        Int.fract ((speeds i : ℝ) * t) = 0)).card := by
      have hsub : ({(3 : Fin 4), e} : Finset (Fin 4)) ⊆ univ.filter
          (fun i => 5 ∣ speeds i ∨ Int.fract ((speeds i : ℝ) * t) = 0) := by
        intro x hx
        simp only [Finset.mem_insert, Finset.mem_singleton] at hx
        rcases hx with rfl | rfl
        · exact mem_filter.mpr ⟨mem_univ _, Or.inr hForig⟩
        · exact mem_filter.mpr ⟨mem_univ _, Or.inl he⟩
      have hc2 : ({(3 : Fin 4), e} : Finset (Fin 4)).card = 2 := by
        rw [Finset.card_insert_of_notMem (Finset.notMem_singleton.mpr he3.symm),
          Finset.card_singleton]
      rw [← hc2]; exact Finset.card_le_card hsub
    have h1le : (univ.filter (fun i => ¬ 5 ∣ speeds i ∧
        ¬ offC2 (Int.fract ((speeds i : ℝ) * t)))).card ≤ 1 := by
      have hsub : univ.filter (fun i => ¬ 5 ∣ speeds i ∧
            ¬ offC2 (Int.fract ((speeds i : ℝ) * t)))
          ⊆ univ \ {(3 : Fin 4), e, i3} := by
        intro x hx
        rw [mem_filter] at hx
        rw [Finset.mem_sdiff]
        refine ⟨mem_univ _, ?_⟩
        simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
        refine ⟨?_, ?_, ?_⟩
        · rintro rfl
          exact hx.2.2 (by have h0 : offC2 (0 : ℝ) := Or.inl (by norm_num); rwa [← hForig] at h0)
        · rintro rfl; exact hx.2.1 he
        · rintro rfl; exact hx.2.2 (not_distant_offC2 _ h3notdist)
      have hc3 : (univ \ {(3 : Fin 4), e, i3} : Finset (Fin 4)).card = 1 := by
        have hs3 : ({(3 : Fin 4), e, i3} : Finset (Fin 4)).card = 3 := by
          rw [Finset.card_insert_of_notMem (by simp [he3.symm, hi33.symm]),
            Finset.card_insert_of_notMem (Finset.notMem_singleton.mpr hi3e.symm), Finset.card_singleton]
        rw [Finset.card_sdiff, Finset.inter_univ, Finset.card_univ, Fintype.card_fin, hs3]
      rw [← hc3]; exact Finset.card_le_card hsub
    omega
  obtain ⟨jj, _, hall⟩ := lemma3 speeds t hDdist hcard
  exact ⟨t + (jj : ℝ) / 5, hall⟩

open Finset in
/-- **`|D| = 1`, sub-case B with `gcd(vF, v3) = 1`.**  Bézout gives `α·v3 ≡ 1
    (mod vF)`; at `x = α/vF` the fastest runner `3` is at the origin, `v3` at
    `1/vF < 1/5`, and `vE` at distance `≥ 2/vF`.  If `vE` is already distant we
    close; otherwise `doubling_step` doubles time until `vE` becomes distant while
    `v3` stays `< 1/5`.  Either way `close_via_lemma3` finishes. -/
theorem case_D1_B_gcd1 (speeds : Fin 4 → ℕ) (hmono : StrictMono speeds) (hpos : ∀ i, 0 < speeds i)
    (e i3 : Fin 4) (he : 5 ∣ speeds e)
    (hD1 : (univ.filter (fun i => 5 ∣ speeds i)).card = 1)
    (he3 : e ≠ 3) (hi33 : i3 ≠ 3) (hi3e : i3 ≠ e)
    (hsum : speeds e + speeds i3 ≠ speeds 3)
    (hcop : Nat.Coprime (speeds 3) (speeds i3)) :
    ∃ t : ℝ, ∀ i, 1 / 5 ≤ circDist ((speeds i : ℝ) * t) := by
  have hvE0 : 0 < speeds e := hpos e
  have hv30 : 0 < speeds i3 := hpos i3
  have heV : e < (3 : Fin 4) := by
    have h2 : (e : ℕ) ≠ 3 := fun h => he3 (Fin.ext h)
    have h1 : (e : ℕ) < 4 := e.isLt
    omega
  have hi3V : i3 < (3 : Fin 4) := by
    have h2 : (i3 : ℕ) ≠ 3 := fun h => hi33 (Fin.ext h)
    have h1 : (i3 : ℕ) < 4 := i3.isLt
    omega
  have hvEF : speeds e < speeds 3 := hmono heV
  have hv3F : speeds i3 < speeds 3 := hmono hi3V
  have hvE5 : 5 ≤ speeds e := Nat.le_of_dvd hvE0 he
  have hvF6 : 6 ≤ speeds 3 := by omega
  have hEne3 : speeds e ≠ speeds i3 := hmono.injective.ne hi3e.symm
  have hvFR : (0 : ℝ) < (speeds 3 : ℝ) := by exact_mod_cast (by omega : 0 < speeds 3)
  have hvFRne : (speeds 3 : ℝ) ≠ 0 := hvFR.ne'
  have hvF6R : (6 : ℝ) ≤ (speeds 3 : ℝ) := by exact_mod_cast hvF6
  -- Bézout: α·v3 ≡ 1 (mod vF), gcd(α, vF) = 1
  have hcopZ : IsCoprime ((speeds i3 : ℕ) : ℤ) ((speeds 3 : ℕ) : ℤ) :=
    Nat.isCoprime_iff_coprime.mpr hcop.symm
  obtain ⟨a, b, hab⟩ := hcopZ
  have h1 : (a : ℤ) * (speeds i3) ≡ 1 [ZMOD (speeds 3)] := by
    rw [Int.modEq_iff_dvd]; exact ⟨b, by linear_combination -hab⟩
  have hcopα : IsCoprime (a : ℤ) ((speeds 3 : ℕ) : ℤ) :=
    ⟨speeds i3, b, by linear_combination hab⟩
  obtain ⟨h3eq, hEge⟩ := bezout_distances (speeds 3) (speeds e) (speeds i3) a hvE0 hvEF hv30 hv3F
    hEne3 hsum hcopα h1
  have hForig : Int.fract ((speeds 3 : ℝ) * ((a : ℝ) / (speeds 3 : ℝ))) = 0 := by
    rw [show (speeds 3 : ℝ) * ((a : ℝ) / (speeds 3 : ℝ)) = ((a : ℤ) : ℝ) from by field_simp]
    exact Int.fract_intCast a
  have h1vF5 : (1 : ℝ) / (speeds 3 : ℝ) < 1 / 5 := by
    rw [div_lt_iff₀ hvFR]; nlinarith [hvF6R]
  by_cases hEdist : 1 / 5 ≤ circDist ((speeds e : ℝ) * ((a : ℝ) / (speeds 3 : ℝ)))
  · exact close_via_lemma3 speeds ((a : ℝ) / (speeds 3 : ℝ)) e i3 he hD1 he3 hi33 hi3e hEdist
      hForig (by rw [h3eq]; exact h1vF5)
  · push_neg at hEdist
    have hδepos : 0 < circDist ((speeds e : ℝ) * ((a : ℝ) / (speeds 3 : ℝ))) :=
      lt_of_lt_of_le (div_pos (by norm_num) hvFR) hEge
    have hδ3half : circDist ((speeds i3 : ℝ) * ((a : ℝ) / (speeds 3 : ℝ)))
        ≤ circDist ((speeds e : ℝ) * ((a : ℝ) / (speeds 3 : ℝ))) / 2 := by
      rw [h3eq]
      have e2 : (2 : ℝ) / (speeds 3 : ℝ) = 2 * (1 / (speeds 3 : ℝ)) := by ring
      linarith [hEge, e2]
    obtain ⟨t', hFt', hEt', h3t'⟩ := doubling_step (speeds 3) (speeds e) (speeds i3)
      ((a : ℝ) / (speeds 3 : ℝ)) hForig hδepos hEdist hδ3half
    exact close_via_lemma3 speeds t' e i3 he hD1 he3 hi33 hi3e hEt' hFt' h3t'

/-- If `d ∣ v` (`d > 0`), then `v·(K/d)` is an integer, so `fract = 0`. -/
theorem fract_dvd_mul_div (v d : ℕ) (K : ℤ) (hd : 0 < d) (hdvd : d ∣ v) :
    Int.fract ((v : ℝ) * ((K : ℝ) / (d : ℝ))) = 0 := by
  obtain ⟨m, hm⟩ := hdvd
  have hdR : (d : ℝ) ≠ 0 := by exact_mod_cast hd.ne'
  rw [show (v : ℝ) * ((K : ℝ) / (d : ℝ)) = (((m : ℤ) * K : ℤ) : ℝ) from by
    rw [hm]; push_cast; field_simp]
  exact Int.fract_intCast _

/-- If `d ∣ v` (`d > 0`), shifting time by `K/d` leaves runner `v`'s distance fixed. -/
theorem circDist_shift_dvd (v d : ℕ) (K : ℤ) (τ : ℝ) (hd : 0 < d) (hdvd : d ∣ v) :
    circDist ((v : ℝ) * (τ + (K : ℝ) / (d : ℝ))) = circDist ((v : ℝ) * τ) := by
  obtain ⟨m, hm⟩ := hdvd
  have hdR : (d : ℝ) ≠ 0 := by exact_mod_cast hd.ne'
  rw [show (v : ℝ) * (τ + (K : ℝ) / (d : ℝ)) = (v : ℝ) * τ + (((m : ℤ) * K : ℤ) : ℝ) from by
    rw [hm]; push_cast; field_simp]
  exact circDist_add_intCast' _ _

open Finset in
/-- **`|D| = 1`, sub-case B, `gcd(vF, v3) = d > 1`, `d ∤ vE` (Bienia Cor 4).**  At
    `t = K/d` (chosen so `vE` is distant) runners `3` and `i3` (both ÷`d`) sit at
    the origin while `vE` is distant: `|R₀| ≥ 3`, so `close_via_lemma3` finishes. -/
theorem case_D1_B_gcd_ndvd (speeds : Fin 4 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i) (e i3 : Fin 4) (he : 5 ∣ speeds e)
    (hD1 : (univ.filter (fun i => 5 ∣ speeds i)).card = 1)
    (he3 : e ≠ 3) (hi33 : i3 ≠ 3) (hi3e : i3 ≠ e)
    (d : ℕ) (hd2 : 2 ≤ d) (hdF : d ∣ speeds 3) (hd3 : d ∣ speeds i3) (hdE : ¬ d ∣ speeds e) :
    ∃ t : ℝ, ∀ i, 1 / 5 ≤ circDist ((speeds i : ℝ) * t) := by
  have hdpos : 0 < d := by omega
  obtain ⟨K, hK⟩ := exists_step_distant_gen (speeds e) d hd2 hdE (1 / 5) (by norm_num)
    (by norm_num) 0
  refine close_via_lemma3 speeds ((K : ℝ) / (d : ℝ)) e i3 he hD1 he3 hi33 hi3e ?_ ?_ ?_
  · have h := hK; rwa [zero_add, mul_div_assoc] at h
  · exact fract_dvd_mul_div (speeds 3) d K hdpos hdF
  · have h3z : circDist ((speeds i3 : ℝ) * ((K : ℝ) / (d : ℝ))) = 0 := by
      rw [circDist, fract_dvd_mul_div (speeds i3) d K hdpos hd3]; simp
    rw [h3z]; norm_num

/-- **`|D| = 1`, sub-case B, `gcd(vF, v3) = d > 1`, `d ∣ vE` (Bienia pre-jump 2).**
    Then `d ∣ vF, vE, v3` but `d ∤ v₄`: `three_runner_fifth` makes `{vF, vE, v3}`
    distant at `τ`, then a `+K/d` pre-jump lands the fourth runner distant while
    leaving the first three fixed. -/
theorem case_D1_B_gcd_dvd (speeds : Fin 4 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i) (e i3 i4 : Fin 4) (he3 : e ≠ 3) (hi33 : i3 ≠ 3) (hi3e : i3 ≠ e)
    (hi43 : i4 ≠ 3) (hi4e : i4 ≠ e) (hi4i3 : i4 ≠ i3)
    (d : ℕ) (hd2 : 2 ≤ d) (hdF : d ∣ speeds 3) (hd3 : d ∣ speeds i3) (hdE : d ∣ speeds e)
    (hd4 : ¬ d ∣ speeds i4) :
    ∃ t : ℝ, ∀ i, 1 / 5 ≤ circDist ((speeds i : ℝ) * t) := by
  have hdpos : 0 < d := by omega
  obtain ⟨τ, dF, dE, d3⟩ := three_runner_fifth (speeds 3) (speeds e) (speeds i3)
    (hpos 3) (hpos e) (hpos i3) (hmono.injective.ne he3.symm) (hmono.injective.ne hi33.symm)
    (hmono.injective.ne hi3e.symm)
  obtain ⟨K, hK⟩ := exists_step_distant_gen (speeds i4) d hd2 hd4 (1 / 5) (by norm_num)
    (by norm_num) ((speeds i4 : ℝ) * τ)
  refine ⟨τ + (K : ℝ) / (d : ℝ), ?_⟩
  intro i
  have hall4 : ({(3 : Fin 4), e, i3, i4} : Finset (Fin 4)) = Finset.univ := by
    apply Finset.eq_univ_of_card
    rw [Finset.card_insert_of_notMem (by simp [he3.symm, hi33.symm, hi43.symm]),
      Finset.card_insert_of_notMem (by simp [hi3e.symm, hi4e.symm]),
      Finset.card_insert_of_notMem (by simp [hi4i3.symm]), Finset.card_singleton,
      Fintype.card_fin]
  have hi : i ∈ ({(3 : Fin 4), e, i3, i4} : Finset (Fin 4)) := hall4 ▸ Finset.mem_univ i
  simp only [Finset.mem_insert, Finset.mem_singleton] at hi
  rcases hi with h | h | h | h
  · rw [h, circDist_shift_dvd (speeds 3) d K τ hdpos hdF]; exact dF
  · rw [h, circDist_shift_dvd (speeds e) d K τ hdpos hdE]; exact dE
  · rw [h, circDist_shift_dvd (speeds i3) d K τ hdpos hd3]; exact d3
  · rw [h, show (speeds i4 : ℝ) * (τ + (K : ℝ) / (d : ℝ))
        = (speeds i4 : ℝ) * τ + (speeds i4 : ℝ) * (K : ℝ) / (d : ℝ) from by ring]
    exact hK

open Finset in
/-- **`|D| = 1`, easy sub-case:** the divisible-by-5 runner is the fastest.
    Then `t = 1/(5·v₃)` puts it at exactly `1/5` (distant) and every slower runner
    in `(0,1/5) ⊆ C₁`, so `R₂ = ∅` and `lemma3` finishes. -/
theorem case_D1_A (speeds : Fin 4 → ℕ) (hmono : StrictMono speeds) (hpos : ∀ i, 0 < speeds i)
    (hD1 : (univ.filter (fun i => 5 ∣ speeds i)).card = 1) (h3 : 5 ∣ speeds (3 : Fin 4)) :
    ∃ t : ℝ, ∀ i, 1 / 5 ≤ circDist ((speeds i : ℝ) * t) := by
  obtain ⟨a, ha⟩ := Finset.card_eq_one.mp hD1
  have h3a : (3 : Fin 4) = a := by
    have : (3 : Fin 4) ∈ ({a} : Finset (Fin 4)) :=
      ha ▸ Finset.mem_filter.mpr ⟨Finset.mem_univ _, h3⟩
    rwa [Finset.mem_singleton] at this
  have hDeq : univ.filter (fun i => 5 ∣ speeds i) = {(3 : Fin 4)} := by rw [ha, h3a]
  have hpos3 : (0 : ℝ) < (speeds 3 : ℝ) := by exact_mod_cast hpos 3
  set t : ℝ := 1 / (5 * (speeds (3 : Fin 4) : ℝ)) with ht
  have hc15 : circDist ((1 : ℝ) / 5) = 1 / 5 := by
    unfold circDist
    rw [Int.fract_eq_self.mpr ⟨by norm_num, by norm_num⟩, min_eq_left (by norm_num)]
  have hdist3 : 1 / 5 ≤ circDist ((speeds 3 : ℝ) * t) := by
    have hv : (speeds 3 : ℝ) * t = 1 / 5 := by rw [ht]; field_simp
    rw [hv, hc15]
  have hDdist : ∀ m, 5 ∣ speeds m → 1 / 5 ≤ circDist ((speeds m : ℝ) * t) := by
    intro m hm
    have hmem : m ∈ univ.filter (fun i => 5 ∣ speeds i) :=
      Finset.mem_filter.mpr ⟨Finset.mem_univ _, hm⟩
    rw [hDeq, Finset.mem_singleton] at hmem
    subst hmem; exact hdist3
  have hcard : (univ.filter (fun n => ¬ 5 ∣ speeds n ∧
        ¬ offC2 (Int.fract ((speeds n : ℝ) * t)))).card
      < (univ.filter (fun n => 5 ∣ speeds n ∨ Int.fract ((speeds n : ℝ) * t) = 0)).card := by
    have hR2 : univ.filter (fun n => ¬ 5 ∣ speeds n ∧
        ¬ offC2 (Int.fract ((speeds n : ℝ) * t))) = ∅ := by
      rw [Finset.filter_eq_empty_iff]
      intro n _
      simp only [not_and_or, not_not]
      by_cases hn5 : 5 ∣ speeds n
      · exact Or.inl hn5
      · right
        have hn3 : n ≠ 3 := fun h => hn5 (h ▸ h3)
        have hlt : speeds n < speeds 3 :=
          hmono (Fin.lt_def.mpr (by have := n.isLt; have := Fin.val_ne_of_ne hn3; omega))
        have hltR : (speeds n : ℝ) < (speeds 3 : ℝ) := by exact_mod_cast hlt
        have hval : (speeds n : ℝ) * t = (speeds n : ℝ) / (5 * (speeds 3 : ℝ)) := by rw [ht]; ring
        have hle : (speeds n : ℝ) / (5 * (speeds 3 : ℝ)) ≤ 1 / 5 := by
          rw [div_le_iff₀ (by positivity)]; nlinarith
        have hfr : Int.fract ((speeds n : ℝ) * t) = (speeds n : ℝ) / (5 * (speeds 3 : ℝ)) := by
          rw [hval, Int.fract_eq_self.mpr ⟨by positivity, by linarith⟩]
        rw [hfr]; exact Or.inl hle
    rw [hR2, Finset.card_empty]
    exact Finset.card_pos.mpr ⟨3, Finset.mem_filter.mpr ⟨Finset.mem_univ _, Or.inl h3⟩⟩
  obtain ⟨jj, _, hall⟩ := lemma3 speeds t hDdist hcard
  exact ⟨t + (jj : ℝ) / 5, hall⟩

open Finset in
/-- **`|D| = 1`, sub-case B, gcd dispatch.**  With the third runner `i3` fixed
    (`v3 ≠ vF − vE`), split on `d = gcd(vF, v3)`: `d = 1` → `case_D1_B_gcd1`;
    `d > 1 ∧ d ∣ vE` → `case_D1_B_gcd_dvd`; `d > 1 ∧ d ∤ vE` → `case_D1_B_gcd_ndvd`. -/
theorem case_D1_B_dispatch (speeds : Fin 4 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i) (e i3 i4 : Fin 4) (he : 5 ∣ speeds e)
    (hD1 : (univ.filter (fun i => 5 ∣ speeds i)).card = 1) (hgcd : Finset.gcd univ speeds = 1)
    (he3 : e ≠ 3) (hi33 : i3 ≠ 3) (hi3e : i3 ≠ e)
    (hi43 : i4 ≠ 3) (hi4e : i4 ≠ e) (hi4i3 : i4 ≠ i3)
    (hsum : speeds e + speeds i3 ≠ speeds 3) :
    ∃ t : ℝ, ∀ i, 1 / 5 ≤ circDist ((speeds i : ℝ) * t) := by
  by_cases hcop : Nat.Coprime (speeds 3) (speeds i3)
  · exact case_D1_B_gcd1 speeds hmono hpos e i3 he hD1 he3 hi33 hi3e hsum hcop
  · have hdpos : 0 < Nat.gcd (speeds 3) (speeds i3) := Nat.gcd_pos_iff.mpr (Or.inl (hpos 3))
    have hd2 : 2 ≤ Nat.gcd (speeds 3) (speeds i3) := by
      have hne1 : Nat.gcd (speeds 3) (speeds i3) ≠ 1 := hcop
      omega
    set d := Nat.gcd (speeds 3) (speeds i3) with hd_def
    have hdF : d ∣ speeds 3 := Nat.gcd_dvd_left _ _
    have hd3 : d ∣ speeds i3 := Nat.gcd_dvd_right _ _
    by_cases hdE : d ∣ speeds e
    · have hd4 : ¬ d ∣ speeds i4 := by
        intro hcon
        have hall4 : ({(3 : Fin 4), e, i3, i4} : Finset (Fin 4)) = Finset.univ := by
          apply Finset.eq_univ_of_card
          rw [Finset.card_insert_of_notMem (by simp [he3.symm, hi33.symm, hi43.symm]),
            Finset.card_insert_of_notMem (by simp [hi3e.symm, hi4e.symm]),
            Finset.card_insert_of_notMem (by simp [hi4i3.symm]), Finset.card_singleton,
            Fintype.card_fin]
        have hdall : ∀ i ∈ (univ : Finset (Fin 4)), d ∣ speeds i := by
          intro i _
          have hmem : i ∈ ({(3 : Fin 4), e, i3, i4} : Finset (Fin 4)) := hall4 ▸ mem_univ i
          simp only [Finset.mem_insert, Finset.mem_singleton] at hmem
          rcases hmem with h | h | h | h <;> rw [h]
          exacts [hdF, hdE, hd3, hcon]
        have hd1 : d ∣ Finset.gcd univ speeds := Finset.dvd_gcd hdall
        rw [hgcd] at hd1
        exact absurd (Nat.le_of_dvd one_pos hd1) (by omega)
      exact case_D1_B_gcd_dvd speeds hmono hpos e i3 i4 he3 hi33 hi3e hi43 hi4e hi4i3 d hd2 hdF hd3
        hdE hd4
    · exact case_D1_B_gcd_ndvd speeds hmono hpos e i3 he hD1 he3 hi33 hi3e d hd2 hdF hd3 hdE

open Finset in
/-- **`|D| = 1`, sub-case B, pick the third runner.**  Of the two non-fastest,
    non-÷5 runners `p, q`, at least one has speed `≠ vF − vE` (they have distinct
    speeds); use it as `i3` and dispatch on `gcd(vF, v3)`. -/
theorem case_D1_B_pick (speeds : Fin 4 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i) (e p q : Fin 4) (he : 5 ∣ speeds e)
    (hD1 : (univ.filter (fun i => 5 ∣ speeds i)).card = 1) (hgcd : Finset.gcd univ speeds = 1)
    (he3 : e ≠ 3) (hp3 : p ≠ 3) (hpe : p ≠ e) (hq3 : q ≠ 3) (hqe : q ≠ e) (hpq : p ≠ q) :
    ∃ t : ℝ, ∀ i, 1 / 5 ≤ circDist ((speeds i : ℝ) * t) := by
  by_cases hbad : speeds p = speeds 3 - speeds e
  · have hsum : speeds e + speeds q ≠ speeds 3 := by
      intro hcon
      have hqv : speeds q = speeds 3 - speeds e := by omega
      rw [← hbad] at hqv
      exact (hmono.injective.ne hpq.symm) hqv
    exact case_D1_B_dispatch speeds hmono hpos e q p he hD1 hgcd he3 hq3 hqe hp3 hpe hpq hsum
  · have hsum : speeds e + speeds p ≠ speeds 3 := fun hcon => hbad (by omega)
    exact case_D1_B_dispatch speeds hmono hpos e p q he hD1 hgcd he3 hp3 hpe hq3 hqe hpq.symm hsum

open Finset in
/-- **`|D| = 1` case.**  Sub-case A (÷5 runner fastest) is `case_D1_A`; sub-case B
    (÷5 runner not fastest) is Bienia's doubling argument (`case_D1_B_pick`). -/
theorem case_D1 (speeds : Fin 4 → ℕ) (hmono : StrictMono speeds) (hpos : ∀ i, 0 < speeds i)
    (hgcd : Finset.gcd Finset.univ speeds = 1)
    (hD1 : (univ.filter (fun i => 5 ∣ speeds i)).card = 1) :
    ∃ t : ℝ, ∀ i, 1 / 5 ≤ circDist ((speeds i : ℝ) * t) := by
  by_cases h3 : 5 ∣ speeds (3 : Fin 4)
  · exact case_D1_A speeds hmono hpos hD1 h3
  · obtain ⟨e, he_eq⟩ := Finset.card_eq_one.mp hD1
    have he : 5 ∣ speeds e := by
      have hmem : e ∈ univ.filter (fun i => 5 ∣ speeds i) := he_eq ▸ Finset.mem_singleton_self e
      exact (Finset.mem_filter.mp hmem).2
    have he3 : e ≠ 3 := fun h => h3 (h ▸ he)
    fin_cases e
    · exact case_D1_B_pick speeds hmono hpos 0 1 2 he hD1 hgcd he3 (by decide) (by decide)
        (by decide) (by decide) (by decide)
    · exact case_D1_B_pick speeds hmono hpos 1 0 2 he hD1 hgcd he3 (by decide) (by decide)
        (by decide) (by decide) (by decide)
    · exact case_D1_B_pick speeds hmono hpos 2 0 1 he hD1 hgcd he3 (by decide) (by decide)
        (by decide) (by decide) (by decide)
    · exact absurd he h3

open Finset in
/-- **Residual assembly.**  Sorted positive `gcd = 1` speeds with at least one
    divisible by 5.  `|D| ∈ {1,2,3}`; `|D| = 2,3` close via `case_D2`/`case_D3`,
    `|D| = 1` via `case_D1`. -/
theorem intLRC_five_residual (speeds : Fin 4 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i) (hgcd : Finset.gcd univ speeds = 1) (hex : ∃ i, 5 ∣ speeds i) :
    ∃ t : ℝ, ∀ i, 1 / 5 ≤ circDist ((speeds i : ℝ) * t) := by
  have hDpos : 1 ≤ (univ.filter (fun i => 5 ∣ speeds i)).card := by
    obtain ⟨i, hi⟩ := hex
    exact Finset.card_pos.mpr ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩⟩
  have hDlt : (univ.filter (fun i => 5 ∣ speeds i)).card < 4 := by
    have hle : (univ.filter (fun i => 5 ∣ speeds i)).card ≤ 4 := by simpa using Finset.card_le_univ _
    rcases lt_or_eq_of_le hle with h | h
    · exact h
    · exfalso
      have hDu : univ.filter (fun i => 5 ∣ speeds i) = Finset.univ :=
        Finset.eq_univ_of_card _ (by rw [h, Fintype.card_fin])
      have h5all : ∀ i ∈ (Finset.univ : Finset (Fin 4)), 5 ∣ speeds i := by
        intro i _
        have hi : i ∈ univ.filter (fun i => 5 ∣ speeds i) := by rw [hDu]; exact Finset.mem_univ i
        exact (Finset.mem_filter.mp hi).2
      have hd5 : (5 : ℕ) ∣ Finset.gcd Finset.univ speeds := Finset.dvd_gcd h5all
      rw [hgcd] at hd5
      exact absurd hd5 (by decide)
  have h123 : (univ.filter (fun i => 5 ∣ speeds i)).card = 1 ∨
      (univ.filter (fun i => 5 ∣ speeds i)).card = 2 ∨
      (univ.filter (fun i => 5 ∣ speeds i)).card = 3 := by omega
  rcases h123 with hc | hc | hc
  · exact case_D1 speeds hmono hpos hgcd hc
  · exact case_D2 speeds hmono hpos hc
  · exact case_D3 speeds hmono hpos hc

end


/-
───────────────────────────────────────────────────────────────────────────────
  PART 9: IntLRC_5.lean
───────────────────────────────────────────────────────────────────────────────
-/
section

/-!
# `intLRC 5` — Lonely Runner Conjecture for n = 5

Four moving runners + observer, target gap `1/5`. Literature `n = 4`
(observer omitted). Open-access source: Barajas–Serra 2008 §3 (|D|=4 case,
using the Prime Filtering Lemma with prime `p = 5`).

Structure mirrors `IntLRC_4.lean`: BSR and LR cases discharge via
`theorem61_BSR` / `theorem71_LargeSR`; Hard Case `4·v_1 < V ≤ 4·v_3` is closed
via `intLRC_five_residual` (Bienia §4) in `IntLRC_5_Bienia.lean`, covering
`|D| ∈ {1,2,3}` (the `|D| = 1` crux is Bienia's doubling argument).

**Sorry budget:** 0 — `intLRC_five` is sorry-free
(`#print axioms` = `propext, Classical.choice, Quot.sound`).
-/

open MeasureTheory Set

/-- Strong-induction premise `H 5`: chains down to `H_four` and `intLRC_four`. -/
theorem H_five : H 5 := by
  intro m hm
  intro speeds hmono hpos hgcd
  interval_cases m
  · exact ⟨0, fun i => i.elim0⟩
  · exact ⟨0, fun i => i.elim0⟩
  · refine ⟨1 / (2 * (speeds ⟨0, by omega⟩ : ℝ)), fun i => ?_⟩
    have hi : i = ⟨0, by omega⟩ := Fin.ext (by omega)
    subst hi
    have hv : (0 : ℝ) < speeds ⟨0, by omega⟩ := by exact_mod_cast hpos ⟨0, by omega⟩
    rw [show (speeds ⟨0, by omega⟩ : ℝ) * (1 / (2 * speeds ⟨0, by omega⟩)) = 1 / 2
        from by field_simp]
    have h_floor : ⌊(1 / 2 : ℝ)⌋ = (0 : ℤ) := Int.floor_eq_zero_iff.mpr (by norm_num)
    have h_frac : Int.fract (1 / 2 : ℝ) = 1 / 2 := by
      simp only [Int.fract, h_floor, Int.cast_zero, sub_zero]
    change circDist (1 / 2 : ℝ) ≥ (1 : ℝ) / 2
    unfold circDist
    rw [h_frac]
    norm_num
  · exact intLRC_three speeds hmono hpos hgcd
  · exact intLRC_four speeds hmono hpos hgcd

/-- **Prime trick (p = 5).** If `5 ∤ v`, then at `t = 1/5` runner `v` sits at a
    nonzero multiple of `1/5` (its residue `v mod 5 ∈ {1,2,3,4}`), so
    `circDist (v·(1/5)) ≥ 1/5`.  This discharges the entire "no speed divisible
    by 5" subcase of the Hard Case in one shot. -/
lemma circDist_fifth_of_not_dvd (v : ℕ) (h : ¬ (5 ∣ v)) :
    circDist ((v : ℝ) * (1 / 5)) ≥ 1 / 5 := by
  have hr0 : v % 5 ≠ 0 := fun hh => h (Nat.dvd_of_mod_eq_zero hh)
  have hrlt : v % 5 < 5 := Nat.mod_lt v (by norm_num)
  have hr1R : (1 : ℝ) ≤ (↑(v % 5) : ℝ) := by exact_mod_cast (by omega : 1 ≤ v % 5)
  have hr4R : (↑(v % 5) : ℝ) ≤ 4 := by exact_mod_cast (by omega : v % 5 ≤ 4)
  have hsplit : (v : ℝ) * (1 / 5) = (↑(v % 5) : ℝ) / 5 + (↑(v / 5) : ℝ) := by
    have hvR : (v : ℝ) = 5 * (↑(v / 5) : ℝ) + (↑(v % 5) : ℝ) := by
      exact_mod_cast (Nat.div_add_mod v 5).symm
    rw [hvR]; ring
  rw [hsplit]
  unfold circDist
  rw [Int.fract_add_natCast]
  have hfr : Int.fract ((↑(v % 5) : ℝ) / 5) = (↑(v % 5) : ℝ) / 5 :=
    Int.fract_eq_self.mpr ⟨by positivity, by rw [div_lt_one (by norm_num)]; linarith⟩
  rw [hfr, ge_iff_le, le_min_iff]
  exact ⟨by linarith, by linarith⟩

/-- **Main result for n = 5** (sorry-free).  `speeds : Fin 4 → ℕ`.
    BSR `V ≤ 4·v_1`; LR `4·v_3 < V`; Hard `4·v_1 < V ≤ 4·v_3`.  The Hard Case
    further splits on divisibility by the prime `5`: if no speed is divisible
    by `5`, then `t = 1/5` works (`circDist_fifth_of_not_dvd`); the residual
    (some speed `≡ 0 mod 5`) is closed by `intLRC_five_residual` (Bienia §4). -/
theorem intLRC_five : intLRC 5 := by
  intro speeds hmono hpos hgcd
  let V : ℕ := speeds ⟨3, by omega⟩
  let slowSpeeds : Fin 3 → ℕ := fun i => speeds ⟨i.val, by omega⟩
  have hpos_slow : ∀ i, 0 < slowSpeeds i := fun i => hpos ⟨i.val, by omega⟩
  have hmono_slow : StrictMono slowSpeeds := by
    intro a b hab
    show speeds ⟨a.val, by omega⟩ < speeds ⟨b.val, by omega⟩
    exact hmono (show (⟨a.val, by omega⟩ : Fin 4) < ⟨b.val, by omega⟩ from hab)
  by_cases hBSR : V ≤ 4 * speeds ⟨0, by omega⟩
  · -- BSR Case: t* = 1/(5·v_1)
    refine ⟨bsr_time 5 (speeds ⟨0, by omega⟩), ?_⟩
    intro i
    have hV_bsr : speeds ⟨5 - 2, by omega⟩ ≤ (5 - 1) * speeds ⟨0, by omega⟩ := by
      change speeds ⟨3, by omega⟩ ≤ 4 * speeds ⟨0, by omega⟩; exact hBSR
    exact theorem61_BSR 5 (by norm_num) speeds hpos hmono hV_bsr i
  · push_neg at hBSR
    by_cases hLR : 4 * speeds ⟨2, by omega⟩ < V
    · -- LR Case
      have hV_large : (5 - 1) * slowSpeeds ⟨5 - 3, by omega⟩ < V := by
        change 4 * speeds ⟨2, by omega⟩ < V; exact hLR
      obtain ⟨t₀, ht₀_slow, ht₀_V⟩ :=
        theorem71_LargeSR 5 (by norm_num) slowSpeeds V hpos_slow hmono_slow hV_large H_five
      refine ⟨t₀, fun i => ?_⟩
      by_cases hi : i.val < 3
      · have h := ht₀_slow ⟨i.val, hi⟩
        simp only [slowSpeeds] at h
        have heq : (speeds i : ℝ) = (speeds ⟨i.val, by omega⟩ : ℝ) := by rfl
        rw [heq]; exact h
      · push_neg at hi
        have hi3 : i.val = 3 := by omega
        have heq : (speeds i : ℝ) = (V : ℝ) := by
          change (speeds i : ℝ) = (speeds ⟨3, by omega⟩ : ℝ)
          congr 2; exact Fin.ext hi3
        rw [heq]; exact ht₀_V
    · push_neg at hLR
      -- Hard Case: 4·v_1 < V ≤ 4·v_3.  Split on divisibility by the prime 5.
      by_cases h5 : ∃ i, 5 ∣ speeds i
      · -- Hard residual: some speed ≡ 0 mod 5.  Bienia §4 (`intLRC_five_residual`):
        -- `|D| ∈ {1,2,3}` all closed via `lemma3` (|D|=1 uses Bienia's doubling).
        exact intLRC_five_residual speeds hmono hpos hgcd h5
      · -- Easy subcase: no speed divisible by 5 → t = 1/5 witnesses all distant.
        push_neg at h5
        exact ⟨1 / 5, fun i => circDist_fifth_of_not_dvd (speeds i) (h5 i)⟩

end


/-
───────────────────────────────────────────────────────────────────────────────
  PART 10: IntLRC_6_BHK_Defs.lean
───────────────────────────────────────────────────────────────────────────────
-/
section

/-!
# Bohman–Holzman–Kleitman 2001 — Foundations

Definitions and elementary bridge lemmas shared across the BHK formalisation.

* `BHK.bhkB`            — open unsafe set near integers `⋃_k (k-1/6, k+1/6)`
* `BHK.bhkBunion`       — `⋃_i x_i · B` (the conjecture asserts this `≠ ℝ⁺`)
* `BHK.unsafeOf i`      — set of times `t` with `v_i · t ∈ bhkB`
* `BHK.mem_bhkB_iff`    — bridge to `circDist x < 1/6`
* `BHK.mem_unsafeOf_iff`— bridge for `unsafeOf`
* `BHK.bhkRectangle`    — the standard 2-torus rectangle from BHK §3
-/

open MeasureTheory Set

namespace BHK

/-- BHK's `B`: the open unsafe set near integers,
    `B = {x : ℝ | ∃ k : ℤ, |x − k| < 1/6}`. -/
def bhkB : Set ℝ := { x : ℝ | ∃ k : ℤ, |x - (k : ℝ)| < 1 / 6 }

/-- BHK's union `𝓑 = ⋃_i x_i · B`. -/
noncomputable def bhkBunion (speeds : Fin 5 → ℕ) : Set ℝ :=
  ⋃ i, { t : ℝ | (speeds i : ℝ) * t ∈ bhkB }

/-- The set of times where runner `i` is "near the origin" (within `1/6`)
    on the circle. -/
def unsafeOf (speeds : Fin 5 → ℕ) (i : Fin 5) : Set ℝ :=
  { t : ℝ | (speeds i : ℝ) * t ∈ bhkB }

/-- Bridge between BHK's interval formulation and our `circDist` formulation:
    `x ∈ bhkB` iff `circDist x < 1/6`. -/
theorem mem_bhkB_iff (x : ℝ) : x ∈ bhkB ↔ circDist x < 1 / 6 := by
  constructor
  · rintro ⟨k, hk⟩
    have hmem : (k : ℝ) ∈ Set.range (Int.cast : ℤ → ℝ) := ⟨k, rfl⟩
    rw [circDist_eq_infDist]
    calc Metric.infDist x (Set.range (Int.cast : ℤ → ℝ))
        ≤ dist x (k : ℝ) := Metric.infDist_le_dist_of_mem hmem
      _ = |x - (k : ℝ)| := Real.dist_eq _ _
      _ < 1 / 6 := hk
  · intro hcd
    unfold circDist at hcd
    rcases min_lt_iff.mp hcd with hL | hR
    · refine ⟨⌊x⌋, ?_⟩
      have hfl_le : (⌊x⌋ : ℝ) ≤ x := Int.floor_le x
      have hfract : x - (⌊x⌋ : ℝ) = Int.fract x := by
        unfold Int.fract; ring
      rw [abs_of_nonneg (by linarith), hfract]; exact hL
    · refine ⟨⌊x⌋ + 1, ?_⟩
      have hlt : x < (⌊x⌋ : ℝ) + 1 := Int.lt_floor_add_one x
      have hfract_lt_one : Int.fract x < 1 := Int.fract_lt_one x
      have hcast : ((⌊x⌋ + 1 : ℤ) : ℝ) = (⌊x⌋ : ℝ) + 1 := by push_cast; ring
      have hdiff : x - ((⌊x⌋ + 1 : ℤ) : ℝ) = -(1 - Int.fract x) := by
        rw [hcast]; unfold Int.fract; ring
      rw [hdiff, abs_neg, abs_of_nonneg (by linarith)]; exact hR

/-- Translated bridge: `t ∈ unsafeOf speeds i` iff `circDist (v_i · t) < 1/6`. -/
theorem mem_unsafeOf_iff (speeds : Fin 5 → ℕ) (i : Fin 5) (t : ℝ) :
    t ∈ unsafeOf speeds i ↔ circDist ((speeds i : ℝ) * t) < 1 / 6 := by
  unfold unsafeOf; exact mem_bhkB_iff _

/-- The 2-dimensional torus rectangle `R = {(u,v) : 0 ≤ {u - x₁} ≤ α ∧ 0 ≤ {v - x₂} ≤ β}`
    from BHK §3, encoded as a subset of `ℝ × ℝ`. -/
def bhkRectangle (x₁ x₂ α β : ℝ) : Set (ℝ × ℝ) :=
  { p | 0 ≤ Int.fract (p.1 - x₁) ∧ Int.fract (p.1 - x₁) ≤ α ∧
        0 ≤ Int.fract (p.2 - x₂) ∧ Int.fract (p.2 - x₂) ≤ β }

/-! ## Structural facts about `bhkB` and `unsafeOf`

These characterise `bhkB` as a union of open intervals around integers and
give explicit length bounds — both used downstream in `bhk_lemma_4` and the
case branches of §§5–8. -/

/-- `bhkB` is the disjoint union of open intervals of length `1/3` centred at
    each integer: `bhkB = ⋃_k (k - 1/6, k + 1/6)`. -/
theorem bhkB_eq_iUnion_Ioo :
    bhkB = ⋃ k : ℤ, Ioo ((k : ℝ) - 1 / 6) ((k : ℝ) + 1 / 6) := by
  ext x
  simp only [bhkB, mem_iUnion, mem_setOf_eq, mem_Ioo]
  constructor
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_, ?_⟩
    · have := neg_lt_of_abs_lt hk; linarith
    · have := lt_of_abs_lt hk; linarith
  · rintro ⟨k, h1, h2⟩
    refine ⟨k, ?_⟩
    rw [abs_lt]; exact ⟨by linarith, by linarith⟩

/-- `unsafeOf i` rescaled: `t ∈ unsafeOf i` iff `(v_i · t) ∈ bhkB`. -/
theorem mem_unsafeOf_iff_bhkB (speeds : Fin 5 → ℕ) (i : Fin 5) (t : ℝ) :
    t ∈ unsafeOf speeds i ↔ (speeds i : ℝ) * t ∈ bhkB := Iff.rfl

end BHK

end


/-
───────────────────────────────────────────────────────────────────────────────
  PART 11: IntLRC_6_BHK_MainLemma.lean
───────────────────────────────────────────────────────────────────────────────
-/
section

/-!
# BHK §3 — Main Lemma and Corollary 6 (2-torus subgroup ↔ rectangle)

The Main Lemma says: a finite subgroup `G ⊆ T = [0,1)²` of order `n`
intersects every `α × β` rectangle whenever `αβ ≥ 1/n`, modulo an
exceptional small lattice point `(i,j) ∈ ℤ²` with `(i/n, j/n) ∈ G`
satisfying `β|i| + α|j| - (2/n)|i||j| < 1`.

Corollary 6 is the applied form used throughout §§5–8.

## Source

T. Bohman, R. Holzman, D. Kleitman, *Six Lonely Runners*, EJC **8** (2001)
R3, §3 (p5–11). Main Lemma + proof in §3.1; Corollary 6 + proof in §3.2;
minimality refinement in §3.3.

## Proof structure (BHK §3.1)

The proof uses a Minkowski-style covering argument on the 2-torus:

1. Family `ℱ = {(i/n, j/n) + (1/(2n))·K : (i/n, j/n) ∈ G}`. Each set in
   `ℱ` has 2-D Lebesgue area `A(K)/(4n²) ≥ 1/n`, and there are `n` sets.
2. If `A(K) > 4n`, total area `> 1 = area(T)`, so two sets in `ℱ` must
   intersect. Pull back the intersection to get
   `(i,j) := (i_1 - i_2, j_1 - j_2) ∈ K ∩ ℤ² \ {(0,0)}` with
   `(i/n, j/n) ∈ G`.
3. Pick `(i,j)` minimal (no `(i,j) = k(i_0, j_0)` with `k > 1`).
4. Suppose `G` misses some `α × β` rectangle `R`. WLOG `i, j ≥ 0`.
   * `i = 0`: `G` is `n/j` equidistant points on `j` vertical circles. By
     spacing, `j/n > β`, equivalent to (12).
   * `j = 0`: symmetric.
   * `i, j > 0`: circle `L_g` generated by `g = (i/n, j/n)` has period
     `i/n`. Lines parallel to `L_g` cross `R`'s vertical edge at equally
     spaced points; if none have `y`-coord in the rectangle's vertical
     window, then `β - j(2i - αn)/(in) < 1/i`, equivalent to (12).

This file decomposes the proof into named helper lemmas. All are fully
proved (sorry-free): the Minkowski covering (`bhk_main_lemma_existence`),
minimality refinement, Corollary 6 (via a Dirichlet-pigeonhole witness
replacing BHK's half-open box), and the equally-spaced line-segment
argument (`bhk_main_lemma_rectangle_minimal`), the latter via a fully
discrete sliding-window form of BHK's parallel-segment argument
(`bhk_rectangle_minimal_core_hit`): column-basis decomposition,
minimality-as-coprimality, a Bézout companion point with determinant
`n`, and two interval catches whose feasibility is exactly ¬(12).
-/

open MeasureTheory Set

namespace BHK

/-- **G is the ℤ²-periodic lift of a subgroup `H ⊆ (ZMod n)²` of order `n`.**

    BHK's "G is a subgroup of `T = (ℝ/ℤ)²` of order `n`" is encoded by
    making `G ⊆ ℝ²` be the full ℤ²-periodic lift of an honest `H` in
    `(ZMod n × ZMod n)`. Membership `(i/n, j/n) ∈ G` for `(i, j) ∈ ℤ²`
    then literally holds iff `(i mod n, j mod n) ∈ H`.

    Note: under this convention, `G` is countable but not finite as a set
    of `ℝ²` (each `H`-element has a full `ℤ²`-orbit of representatives). -/
def IsBHKLift (G : Set (ℝ × ℝ)) (n : ℕ) : Prop :=
  ∃ H : AddSubgroup (ZMod n × ZMod n), Nat.card H = n ∧
    ∀ p : ℝ × ℝ, p ∈ G ↔
      ∃ h ∈ H, ∃ i j : ℤ,
        p = (((h.1.val : ℝ) / n) + (i : ℝ), ((h.2.val : ℝ) / n) + (j : ℝ))

/-- **Generator order.** The cyclic subgroup generated by `(↑r, ↑p)` in
    `(ZMod q)²` has order `q` when `gcd(p, q) = 1`: the second coordinate already
    has additive order `q`, and the first has order dividing `q`. This supplies
    the order-`q` subgroup `H` needed for `IsBHKLift` in BHK §5 Part 3. -/
lemma bhk_addOrderOf_gen (r p q : ℕ) (hq : 0 < q) (hcop : Nat.gcd p q = 1) :
    addOrderOf ((↑r, ↑p) : ZMod q × ZMod q) = q := by
  rw [Prod.addOrderOf_mk]
  have hp : addOrderOf (↑p : ZMod q) = q := by
    rw [ZMod.addOrderOf_coe p (show q ≠ 0 by omega), Nat.gcd_comm, hcop, Nat.div_one]
  have hr : addOrderOf (↑r : ZMod q) ∣ q := by
    apply addOrderOf_dvd_of_nsmul_eq_zero
    rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  rw [hp]
  exact Nat.lcm_eq_right hr

/-- The order-`q` cyclic subgroup `⟨(↑r, ↑p)⟩ ⊆ (ZMod q)²` from
    `bhk_addOrderOf_gen`, as an `AddSubgroup` with `Nat.card = q`. -/
lemma bhk_card_zmultiples_gen (r p q : ℕ) (hq : 0 < q) (hcop : Nat.gcd p q = 1) :
    Nat.card (AddSubgroup.zmultiples ((↑r, ↑p) : ZMod q × ZMod q)) = q := by
  rw [Nat.card_zmultiples]; exact bhk_addOrderOf_gen r p q hq hcop

/-- **Fractional-part bridge.** The canonical representative `(m : ZMod q).val`
    and the integer `m` have the same `fract` after dividing by `q`: they differ
    by the integer `m / q`. Lets abstract `IsBHKLift` membership (phrased via
    `.val`) be read off directly from the generator multiple `m`. -/
lemma bhk_fract_val_div (q : ℕ) (hq : 0 < q) (m : ℤ) :
    Int.fract ((((m : ZMod q)).val : ℝ) / (q : ℝ)) = Int.fract ((m : ℝ) / (q : ℝ)) := by
  haveI : NeZero q := ⟨by omega⟩
  have hqR : (q : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hval : (((m : ZMod q)).val : ℤ) = m % q := ZMod.val_intCast m
  have hmod : q * (m / q) + m % q = m := Int.ediv_add_emod m q
  have key : (m : ℝ) / q = ((m / q : ℤ) : ℝ) + (((m : ZMod q)).val : ℝ) / q := by
    have e1 : (((m : ZMod q)).val : ℝ) = ((m % q : ℤ) : ℝ) := by exact_mod_cast hval
    have hmodR : (m : ℝ) = (q : ℝ) * ((m / q : ℤ) : ℝ) + ((m % q : ℤ) : ℝ) := by
      exact_mod_cast hmod.symm
    rw [e1, hmodR]; field_simp
  rw [key, Int.fract_intCast_add]

/-- **The Part-3 lift `G`.** The ℤ²-periodic lift of the order-`q` cyclic group
    `⟨(↑r, ↑p)⟩`. It satisfies `IsBHKLift G q`, and every point's torus
    coordinates are read off the generator: `fract x.1 = fract(k r / q)`,
    `fract x.2 = fract(k p / q)` for some `k : ℤ`. (BHK §5 Part 3, `q ≥ 18`.) -/
lemma bhk_isBHKLift_gen (r p q : ℕ) (hq : 0 < q) (hcop : Nat.gcd p q = 1) :
    ∃ G : Set (ℝ × ℝ), IsBHKLift G q ∧
      ∀ x ∈ G, ∃ k : ℤ,
        Int.fract x.1 = Int.fract ((k : ℝ) * r / q) ∧
        Int.fract x.2 = Int.fract ((k : ℝ) * p / q) := by
  refine ⟨{x | ∃ h ∈ AddSubgroup.zmultiples (((r : ZMod q), (p : ZMod q))), ∃ i j : ℤ,
      x = ((h.1.val : ℝ) / q + i, (h.2.val : ℝ) / q + j)},
    ⟨AddSubgroup.zmultiples _, bhk_card_zmultiples_gen r p q hq hcop, fun _ => Iff.rfl⟩, ?_⟩
  rintro x ⟨h, hh, i, j, rfl⟩
  rw [AddSubgroup.mem_zmultiples_iff] at hh
  obtain ⟨k, hk⟩ := hh
  have hh1 : h.1 = ((k * (r : ℤ) : ℤ) : ZMod q) := by
    rw [← hk]; show k • (r : ZMod q) = ((k * (r : ℤ) : ℤ) : ZMod q)
    rw [zsmul_eq_mul]; push_cast; ring
  have hh2 : h.2 = ((k * (p : ℤ) : ℤ) : ZMod q) := by
    rw [← hk]; show k • (p : ZMod q) = ((k * (p : ℤ) : ℤ) : ZMod q)
    rw [zsmul_eq_mul]; push_cast; ring
  refine ⟨k, ?_, ?_⟩
  · show Int.fract ((h.1.val : ℝ) / q + (i : ℝ)) = Int.fract ((k : ℝ) * r / q)
    rw [Int.fract_add_intCast, hh1, bhk_fract_val_div q hq]
    congr 1; push_cast; ring
  · show Int.fract ((h.2.val : ℝ) / q + (j : ℝ)) = Int.fract ((k : ℝ) * p / q)
    rw [Int.fract_add_intCast, hh2, bhk_fract_val_div q hq]
    congr 1; push_cast; ring

/-- Fractional part absorbs the integer part of the first summand. -/
lemma bhk_fract_add_fract (x c : ℝ) :
    Int.fract (x + c) = Int.fract (Int.fract x + c) := by
  conv_lhs => rw [← Int.floor_add_fract x]
  rw [add_assoc, Int.fract_intCast_add]

/-- **Window from a `fract`.** If a torus value `S ∈ [0,1)` has
    `fract (S - 1/6) ≤ β` with `β < 5/6`, then `S ∈ [1/6, 1/6 + β]`. (The
    `S < 1/6` branch is impossible since then `fract (S - 1/6) = S + 5/6 ≥ 5/6`.) -/
lemma bhk_window_from_fract {S β : ℝ} (hS0 : 0 ≤ S) (hS1 : S < 1)
    (hβ : β < 5 / 6) (hb : Int.fract (S - 1 / 6) ≤ β) : 1 / 6 ≤ S ∧ S ≤ 1 / 6 + β := by
  by_cases h : 1 / 6 ≤ S
  · refine ⟨h, ?_⟩
    rw [Int.fract_eq_self.2 ⟨by linarith, by linarith⟩] at hb; linarith
  · push_neg at h
    exfalso
    rw [show S - 1 / 6 = (S + 5 / 6) + ((-1 : ℤ) : ℝ) from by push_cast; ring,
      Int.fract_add_intCast, Int.fract_eq_self.2 ⟨by linarith, by linarith⟩] at hb
    linarith

/-- **Lattice from subgroup.** From `H ⊆ (ZMod n)²` a subgroup of order `n`,
    construct the sub-lattice `M ⊆ ℝ²` of integer points whose mod-`n`
    reduction lies in `H`, with a fundamental domain `F` of volume `n`.

    This isolates the Minkowski lattice-theory bookkeeping (sub-lattice
    construction, discreteness, fundamental domain, covolume) from the
    rest of the BHK proof. -/
lemma bhk_lattice_from_subgroup (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (_hH_card : Nat.card H = n) :
    ∃ (M : AddSubgroup (ℝ × ℝ)) (F : Set (ℝ × ℝ))
      (_ : Countable M) (_ : DiscreteTopology M),
      MeasureTheory.IsAddFundamentalDomain M F MeasureTheory.volume ∧
      MeasureTheory.volume F = (n : ENNReal) ∧
      (∀ x : (M : Set (ℝ × ℝ)),
        ∃ i j : ℤ, (x : ℝ × ℝ) = ((i : ℝ), (j : ℝ)) ∧
                    ((i : ZMod n), (j : ZMod n)) ∈ H) ∧
      -- The converse: every integer point whose mod-n reduction lies in H is in M.
      (∀ i j : ℤ, ((i : ZMod n), (j : ZMod n)) ∈ H →
        ((i : ℝ), (j : ℝ)) ∈ M) := by
  -- M is the additive subgroup of ℝ² whose elements are integer points
  -- (i, j) ∈ ℤ² with (i mod n, j mod n) ∈ H.
  let M : AddSubgroup (ℝ × ℝ) :=
    { carrier := {p : ℝ × ℝ | ∃ i j : ℤ,
                                p = ((i : ℝ), (j : ℝ)) ∧
                                ((i : ZMod n), (j : ZMod n)) ∈ H}
      zero_mem' := ⟨0, 0, by ext <;> simp, by push_cast; exact H.zero_mem⟩
      add_mem' := by
        rintro a b ⟨i₁, j₁, ha_eq, h₁⟩ ⟨i₂, j₂, hb_eq, h₂⟩
        refine ⟨i₁ + i₂, j₁ + j₂, ?_, ?_⟩
        · rw [ha_eq, hb_eq]; ext <;> simp
        · push_cast; exact H.add_mem h₁ h₂
      neg_mem' := by
        rintro a ⟨i, j, ha_eq, h⟩
        refine ⟨-i, -j, ?_, ?_⟩
        · rw [ha_eq]; ext <;> simp
        · push_cast; exact H.neg_mem h }
  -- Countable: M ⊆ {(↑i, ↑j) : i j : ℤ}, the image of countable ℤ × ℤ.
  have h_countable : Countable M := by
    apply Set.Countable.to_subtype
    apply Set.Countable.mono (s₂ := {p : ℝ × ℝ | ∃ i j : ℤ, p = ((i : ℝ), (j : ℝ))})
    · rintro p ⟨i, j, h_eq, _⟩; exact ⟨i, j, h_eq⟩
    · have : ({p : ℝ × ℝ | ∃ i j : ℤ, p = ((i : ℝ), (j : ℝ))} : Set (ℝ × ℝ)) =
             Set.range (fun (ij : ℤ × ℤ) => ((ij.1 : ℝ), (ij.2 : ℝ))) := by
        ext p; simp; tauto
      rw [this]; exact Set.countable_range _
  -- DiscreteTopology: 0 ∈ M has open neighborhood (-1/2, 1/2)² in ℝ² intersecting M only at 0.
  have h_discrete : DiscreteTopology M := by
    rw [discreteTopology_iff_isOpen_singleton_zero]
    rw [isOpen_induced_iff]
    refine ⟨Set.Ioo (-1/2 : ℝ) (1/2) ×ˢ Set.Ioo (-1/2 : ℝ) (1/2),
            isOpen_Ioo.prod isOpen_Ioo, ?_⟩
    ext ⟨x, hx⟩
    simp only [Set.mem_preimage, Set.mem_singleton_iff, AddSubgroup.mk_eq_zero]
    obtain ⟨i, j, hij_eq, _⟩ := hx
    subst hij_eq
    simp only [Set.mem_prod, Set.mem_Ioo]
    constructor
    · rintro ⟨⟨h1, h2⟩, h3, h4⟩
      have hi_zero : i = 0 := by
        have hi_lt : (i : ℝ) < 1 := by linarith
        have hi_gt : -1 < (i : ℝ) := by linarith
        have hi_lt' : i < 1 := by exact_mod_cast hi_lt
        have hi_gt' : (-1 : ℤ) < i := by exact_mod_cast hi_gt
        omega
      have hj_zero : j = 0 := by
        have hj_lt : (j : ℝ) < 1 := by linarith
        have hj_gt : -1 < (j : ℝ) := by linarith
        have hj_lt' : j < 1 := by exact_mod_cast hj_lt
        have hj_gt' : (-1 : ℤ) < j := by exact_mod_cast hj_gt
        omega
      simp [hi_zero, hj_zero]
    · intro h_zero
      have hi_zero : i = 0 := by
        have := congr_arg Prod.fst h_zero
        simpa using (Int.cast_eq_zero (α := ℝ)).mp this
      have hj_zero : j = 0 := by
        have := congr_arg Prod.snd h_zero
        simpa using (Int.cast_eq_zero (α := ℝ)).mp this
      subst hi_zero; subst hj_zero
      refine ⟨⟨?_, ?_⟩, ?_, ?_⟩ <;> norm_num
  -- Build a basis of M via Submodule.basisOfPid applied to the preimage in ℤ × ℤ.
  -- ψ : ℤ × ℤ → ZMod n × ZMod n is the natural mod-n reduction.
  let ψ_hom : (ℤ × ℤ) →+ (ZMod n × ZMod n) :=
    AddMonoidHom.prodMap
      ((Int.castRingHom (ZMod n)).toAddMonoidHom)
      ((Int.castRingHom (ZMod n)).toAddMonoidHom)
  -- N_sub : preimage of H in ℤ × ℤ as Submodule ℤ.
  let N_sub : Submodule ℤ (ℤ × ℤ) :=
    AddSubgroup.toIntSubmodule (H.comap ψ_hom)
  -- Get a basis of N_sub via basisOfPid (using the standard basis of ℤ × ℤ).
  let basis_pkg : (k : ℕ) × Module.Basis (Fin k) ℤ N_sub :=
    Submodule.basisOfPid (Module.Basis.finTwoProd ℤ) N_sub
  -- N_sub has rank 2: contains nℤ × nℤ which spans ℝ² as ℝ-module, hence rank ≥ 2.
  -- And N_sub ⊆ ℤ × ℤ which has rank 2, hence rank = 2.
  have h_rank_eq : basis_pkg.1 = 2 := by
    have h_finrank_eq_basis : Module.finrank ℤ ↥N_sub = basis_pkg.1 := by
      rw [Module.finrank_eq_card_basis basis_pkg.2, Fintype.card_fin]
    rw [← h_finrank_eq_basis]
    -- Goal: Module.finrank ℤ ↥N_sub = 2.
    -- Use Submodule.finiteQuotient_iff: finrank N = finrank M ↔ Finite (M/N).
    have hψ_surj : Function.Surjective ψ_hom := by
      intro ⟨a, b⟩
      haveI : NeZero n := ⟨by omega⟩
      refine ⟨((a.val : ℤ), (b.val : ℤ)), ?_⟩
      show (((a.val : ℤ) : ZMod n), ((b.val : ℤ) : ZMod n)) = (a, b)
      ext
      · push_cast; exact ZMod.natCast_zmod_val a
      · push_cast; exact ZMod.natCast_zmod_val b
    have h_index_eq : (H.comap ψ_hom).index = H.index :=
      AddSubgroup.index_comap_of_surjective H hψ_surj
    -- H.index = n²/|H| = n²/n = n.  Hence finite index, hence finite quotient.
    -- The two quotient flavors (Submodule vs AddSubgroup) coincide for ℤ-modules.
    have h_finite_quot : Finite ((ℤ × ℤ) ⧸ N_sub) := by
      haveI : NeZero n := ⟨by omega⟩
      have h_H_idx : H.index = n := by
        have h_im_card := AddSubgroup.index_mul_card H
        have h_prod_card : Nat.card (ZMod n × ZMod n) = n * n := by
          rw [Nat.card_prod]; simp [Nat.card_zmod]
        rw [h_prod_card, _hH_card] at h_im_card
        have hn_pos : 0 < n := by omega
        exact Nat.eq_of_mul_eq_mul_right hn_pos h_im_card
      have h_idx_n : (H.comap ψ_hom).index = n := by
        rw [h_index_eq]; exact h_H_idx
      haveI : (H.comap ψ_hom).FiniteIndex := ⟨by rw [h_idx_n]; omega⟩
      -- AddSubgroup quotient is finite.
      have h_AG_finite : Finite ((ℤ × ℤ) ⧸ H.comap ψ_hom) :=
        AddSubgroup.finite_quotient_of_finiteIndex
      -- N_sub.toAddSubgroup = H.comap ψ_hom (by definition).
      -- The Submodule quotient and AddSubgroup quotient give the same type for ℤ-modules.
      exact h_AG_finite
    have h_eq_finrank :=
      (Submodule.finiteQuotient_iff N_sub).mp h_finite_quot
    rw [h_eq_finrank]
    simp [Module.finrank_prod, Module.finrank_self]
  -- Reindex the basis to Fin 2.
  let b_N : Module.Basis (Fin 2) ℤ N_sub :=
    basis_pkg.2.reindex (finCongr h_rank_eq)
  -- The ℤ-linear inclusion ι : ℤ × ℤ → ℝ × ℝ.
  let ι_lin : (ℤ × ℤ) →ₗ[ℤ] (ℝ × ℝ) :=
    LinearMap.prod
      ((Int.castRingHom ℝ).toIntLinearMap.comp (LinearMap.fst ℤ ℤ ℤ))
      ((Int.castRingHom ℝ).toIntLinearMap.comp (LinearMap.snd ℤ ℤ ℤ))
  -- The real basis: b_real i := ι(b_N i) ∈ ℝ × ℝ.
  let b_real : Fin 2 → (ℝ × ℝ) := fun i => ι_lin (b_N i : ℤ × ℤ)
  -- b_real is ℝ-linearly independent (since b_N is ℤ-linearly independent and the
  -- inclusion preserves linear independence over ℝ for integer vectors).
  -- Show ⊤ ≤ span_ℝ(b_real) first, then derive ℝ-linear independence.
  -- Strategy: (n, 0) and (0, n) ∈ N_sub (since their mod-n reductions are zero, which is in H),
  -- so ι_lin (n, 0) = (↑n, 0) and ι_lin (0, n) = (0, ↑n) are in span_ℤ(b_real) ⊆ span_ℝ(b_real).
  -- Scaling by (n : ℝ)⁻¹ gives the standard basis vectors (1, 0) and (0, 1), which span ℝ × ℝ.
  have h_spans : ⊤ ≤ Submodule.span ℝ (Set.range b_real) := by
    haveI : NeZero n := ⟨by omega⟩
    have hn_real : (n : ℝ) > 0 := by exact_mod_cast (by omega : 0 < n)
    have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_real
    have h_n_z_mem : ((n : ℤ), (0 : ℤ)) ∈ N_sub := by
      change (((n : ℤ) : ZMod n), ((0 : ℤ) : ZMod n)) ∈ H
      simp only [Int.cast_natCast, CharP.cast_eq_zero, Int.cast_zero]
      exact H.zero_mem
    have h_z_n_mem : ((0 : ℤ), (n : ℤ)) ∈ N_sub := by
      change (((0 : ℤ) : ZMod n), ((n : ℤ) : ZMod n)) ∈ H
      simp only [Int.cast_natCast, CharP.cast_eq_zero, Int.cast_zero]
      exact H.zero_mem
    -- span_ℤ(b_N viewed in ℤ × ℤ) = N_sub.
    have h_subN : Submodule.span ℤ (Set.range (fun i : Fin 2 => (b_N i : ℤ × ℤ))) = N_sub := by
      have h_top : Submodule.span ℤ (Set.range ⇑b_N) = (⊤ : Submodule ℤ N_sub) := b_N.span_eq
      have h_map : Submodule.map (Submodule.subtype N_sub)
            (Submodule.span ℤ (Set.range ⇑b_N)) =
          Submodule.map (Submodule.subtype N_sub) ⊤ := by
        rw [h_top]
      rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype] at h_map
      have h_rng : (⇑(Submodule.subtype N_sub) '' Set.range ⇑b_N) =
                   Set.range (fun i : Fin 2 => (b_N i : ℤ × ℤ)) := by
        ext y
        constructor
        · rintro ⟨_, ⟨i, rfl⟩, rfl⟩; exact ⟨i, rfl⟩
        · rintro ⟨i, rfl⟩; exact ⟨b_N i, ⟨i, rfl⟩, rfl⟩
      rw [h_rng] at h_map
      exact h_map
    -- ι_lin maps N_sub into span_ℤ(b_real).
    have h_imN : ∀ x ∈ N_sub, ι_lin x ∈ Submodule.span ℤ (Set.range b_real) := by
      intro x hx
      rw [← h_subN] at hx
      have h_lin : Submodule.span ℤ (Set.range b_real) =
          Submodule.map ι_lin
            (Submodule.span ℤ (Set.range (fun i : Fin 2 => (b_N i : ℤ × ℤ)))) := by
        rw [Submodule.map_span]
        congr 1
        rw [← Set.range_comp]; rfl
      rw [h_lin]
      exact ⟨x, hx, rfl⟩
    -- Lift span_ℤ ≤ span_ℝ.
    have h_Z_le_R : Submodule.span ℤ (Set.range b_real) ≤
        Submodule.restrictScalars ℤ (Submodule.span ℝ (Set.range b_real)) :=
      Submodule.span_le_restrictScalars ℤ ℝ _
    have h_iota_n_zero : ι_lin ((n : ℤ), (0 : ℤ)) = ((n : ℝ), (0 : ℝ)) := by simp [ι_lin]
    have h_iota_zero_n : ι_lin ((0 : ℤ), (n : ℤ)) = ((0 : ℝ), (n : ℝ)) := by simp [ι_lin]
    have h_n_zero_R : ((n : ℝ), (0 : ℝ)) ∈ Submodule.span ℝ (Set.range b_real) := by
      rw [← h_iota_n_zero]
      exact (Submodule.restrictScalars_mem ℤ _ _).mp (h_Z_le_R (h_imN _ h_n_z_mem))
    have h_zero_n_R : ((0 : ℝ), (n : ℝ)) ∈ Submodule.span ℝ (Set.range b_real) := by
      rw [← h_iota_zero_n]
      exact (Submodule.restrictScalars_mem ℤ _ _).mp (h_Z_le_R (h_imN _ h_z_n_mem))
    -- Scale to get the standard basis vectors.
    have h_unit1 : ((1 : ℝ), (0 : ℝ)) ∈ Submodule.span ℝ (Set.range b_real) := by
      have h_smul := Submodule.smul_mem (Submodule.span ℝ (Set.range b_real))
        ((n : ℝ)⁻¹) h_n_zero_R
      convert h_smul using 1
      ext
      · show (1 : ℝ) = (n : ℝ)⁻¹ * (n : ℝ); field_simp
      · show (0 : ℝ) = (n : ℝ)⁻¹ * 0; ring
    have h_unit2 : ((0 : ℝ), (1 : ℝ)) ∈ Submodule.span ℝ (Set.range b_real) := by
      have h_smul := Submodule.smul_mem (Submodule.span ℝ (Set.range b_real))
        ((n : ℝ)⁻¹) h_zero_n_R
      convert h_smul using 1
      ext
      · show (0 : ℝ) = (n : ℝ)⁻¹ * 0; ring
      · show (1 : ℝ) = (n : ℝ)⁻¹ * (n : ℝ); field_simp
    -- Any (x, y) ∈ ℝ × ℝ is x • (1, 0) + y • (0, 1).
    intro x _
    have h1 := Submodule.smul_mem (Submodule.span ℝ (Set.range b_real)) x.1 h_unit1
    have h2 := Submodule.smul_mem (Submodule.span ℝ (Set.range b_real)) x.2 h_unit2
    have h_sum := Submodule.add_mem _ h1 h2
    convert h_sum using 1
    ext
    · show x.1 = x.1 * 1 + x.2 * 0; ring
    · show x.2 = x.1 * 0 + x.2 * 1; ring
  have h_lin_indep : LinearIndependent ℝ b_real :=
    linearIndependent_of_top_le_span_of_card_eq_finrank h_spans
      (by simp [Fintype.card_fin, Module.finrank_prod, Module.finrank_self])
  -- Build a Module.Basis (Fin 2) ℝ (ℝ × ℝ) from b_real.
  let basis_real : Module.Basis (Fin 2) ℝ (ℝ × ℝ) :=
    Module.Basis.mk h_lin_indep h_spans
  -- F = the fundamental parallelepiped of basis_real.
  let F : Set (ℝ × ℝ) := ZSpan.fundamentalDomain basis_real
  -- Connect: Submodule.span ℤ (Set.range b_real) = M.toIntSubmodule.
  -- Recompute h_subN / h_imN since they were local to the h_spans proof above.
  have h_subN : Submodule.span ℤ (Set.range (fun i : Fin 2 => (b_N i : ℤ × ℤ))) = N_sub := by
    have h_top : Submodule.span ℤ (Set.range ⇑b_N) = (⊤ : Submodule ℤ N_sub) := b_N.span_eq
    have h_map : Submodule.map (Submodule.subtype N_sub)
          (Submodule.span ℤ (Set.range ⇑b_N)) =
        Submodule.map (Submodule.subtype N_sub) ⊤ := by
      rw [h_top]
    rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype] at h_map
    have h_rng : (⇑(Submodule.subtype N_sub) '' Set.range ⇑b_N) =
                 Set.range (fun i : Fin 2 => (b_N i : ℤ × ℤ)) := by
      ext y
      constructor
      · rintro ⟨_, ⟨i, rfl⟩, rfl⟩; exact ⟨i, rfl⟩
      · rintro ⟨i, rfl⟩; exact ⟨b_N i, ⟨i, rfl⟩, rfl⟩
    rw [h_rng] at h_map
    exact h_map
  have h_real_eq_map : Submodule.span ℤ (Set.range b_real) =
      Submodule.map ι_lin
        (Submodule.span ℤ (Set.range (fun i : Fin 2 => (b_N i : ℤ × ℤ)))) := by
    rw [Submodule.map_span]
    congr 1
    rw [← Set.range_comp]; rfl
  have h_span_eq : (M.toIntSubmodule : Set (ℝ × ℝ)) =
                   (Submodule.span ℤ (Set.range b_real) : Set (ℝ × ℝ)) := by
    apply Set.eq_of_subset_of_subset
    · -- M ⊆ span ℤ (range b_real): every x ∈ M is integer pair with mod-n in H,
      -- hence lies in N_sub; b_N spans N_sub, push through ι_lin.
      intro x hx
      change x ∈ M at hx
      obtain ⟨i, j, hx_eq, h_H⟩ := hx
      -- (i, j) ∈ N_sub by definition of N_sub (preimage under ψ_hom).
      have h_ij_N : ((i, j) : ℤ × ℤ) ∈ N_sub := by
        change (((i : ZMod n), (j : ZMod n)) : ZMod n × ZMod n) ∈ H
        exact h_H
      -- (i, j) ∈ span ℤ (range (b_N · : ℤ × ℤ)) via h_subN.
      have h_ij_span : ((i, j) : ℤ × ℤ) ∈
          Submodule.span ℤ (Set.range (fun i : Fin 2 => (b_N i : ℤ × ℤ))) := by
        rw [h_subN]; exact h_ij_N
      -- Push through ι_lin.
      have h_real_in : ι_lin ((i, j) : ℤ × ℤ) ∈ Submodule.span ℤ (Set.range b_real) := by
        rw [h_real_eq_map]; exact ⟨(i, j), h_ij_span, rfl⟩
      have h_iota_eq : ι_lin ((i, j) : ℤ × ℤ) = ((i : ℝ), (j : ℝ)) := by simp [ι_lin]
      rw [h_iota_eq] at h_real_in
      change x ∈ (Submodule.span ℤ (Set.range b_real) : Set (ℝ × ℝ))
      rw [hx_eq]
      exact h_real_in
    · -- span ℤ (range b_real) ⊆ M: each b_real i ∈ M.
      intro x hx
      change x ∈ Submodule.span ℤ (Set.range b_real) at hx
      have h_each : ∀ i : Fin 2, b_real i ∈ M.toIntSubmodule := by
        intro i
        -- b_real i = ι_lin (b_N i : ℤ × ℤ); b_N i ∈ N_sub gives mod-n in H.
        have h_bN_in : ((b_N i : ℤ × ℤ).1, (b_N i : ℤ × ℤ).2) ∈ N_sub := by
          have := (b_N i).property
          convert this
        have h_mod : ((((b_N i : ℤ × ℤ).1 : ZMod n)),
                       ((b_N i : ℤ × ℤ).2 : ZMod n)) ∈ H := h_bN_in
        have hb_eq : b_real i = (((b_N i : ℤ × ℤ).1 : ℝ), ((b_N i : ℤ × ℤ).2 : ℝ)) := by
          simp [b_real, ι_lin]
        change b_real i ∈ M
        rw [hb_eq]
        exact ⟨(b_N i : ℤ × ℤ).1, (b_N i : ℤ × ℤ).2, rfl, h_mod⟩
      have h_range_sub : Set.range b_real ⊆ (M.toIntSubmodule : Set (ℝ × ℝ)) := by
        rintro _ ⟨i, rfl⟩; exact h_each i
      exact Submodule.span_le.mpr h_range_sub hx
  -- Set.range basis_real = Set.range b_real (since basis_real = Basis.mk h_lin_indep h_spans).
  have h_range_eq : Set.range basis_real = Set.range b_real := by
    change Set.range (Module.Basis.mk h_lin_indep h_spans) = Set.range b_real
    congr 1; rw [Module.Basis.coe_mk]
  -- Span equality as Submodules: span ℤ (range basis_real) = M.toIntSubmodule.
  have h_span_eq_sub : Submodule.span ℤ (Set.range basis_real) = M.toIntSubmodule := by
    rw [h_range_eq]
    exact (SetLike.coe_set_eq.mp h_span_eq.symm)
  refine ⟨M, F, h_countable, h_discrete, ?_, ?_, ?_, ?_⟩
  -- IsAddFundamentalDomain: comes from ZSpan.isAddFundamentalDomain (with span identification).
  · -- Note: ↥(M.toIntSubmodule) and ↥M are definitionally the same type;
    -- the VAdd actions agree, so IsAddFundamentalDomain transports along Submodule equality.
    have h_ZF : MeasureTheory.IsAddFundamentalDomain
        (Submodule.span ℤ (Set.range basis_real)) F MeasureTheory.volume :=
      ZSpan.isAddFundamentalDomain basis_real MeasureTheory.volume
    change MeasureTheory.IsAddFundamentalDomain M.toIntSubmodule F MeasureTheory.volume
    exact h_span_eq_sub ▸ h_ZF
  -- volume F = n: from ZSpan.measure_fundamentalDomain + |det| = index of N_sub = n.
  · -- Step A: volume F = ENNReal.ofReal |b₀.det basis_real| * volume (fundDom b₀)
    have step_A : MeasureTheory.volume F =
        ENNReal.ofReal |(Module.Basis.finTwoProd ℝ).det basis_real| *
        MeasureTheory.volume (ZSpan.fundamentalDomain (Module.Basis.finTwoProd ℝ)) :=
      ZSpan.measure_fundamentalDomain basis_real MeasureTheory.volume
        (b₀ := Module.Basis.finTwoProd ℝ)
    -- Step B: volume (fundDom (finTwoProd ℝ)) = 1 (unit square).
    have step_B : MeasureTheory.volume
        (ZSpan.fundamentalDomain (Module.Basis.finTwoProd ℝ)) = 1 := by
      have h_eq : ZSpan.fundamentalDomain (Module.Basis.finTwoProd ℝ) =
          Set.Ico (0:ℝ) 1 ×ˢ Set.Ico (0:ℝ) 1 := by
        ext p; simp [ZSpan.mem_fundamentalDomain]
      rw [h_eq,
        show (MeasureTheory.volume : MeasureTheory.Measure (ℝ × ℝ)) =
          MeasureTheory.volume.prod MeasureTheory.volume from rfl,
        MeasureTheory.Measure.prod_prod, Real.volume_Ico, sub_zero, ENNReal.ofReal_one, mul_one]
    -- Step C: |(finTwoProd ℝ).det basis_real| = n.
    -- (i) The ℝ-det of basis_real equals the ℤ-det of b_N (cast to ℝ).
    have h_basis_real_explicit : ∀ i : Fin 2,
        basis_real i = (((b_N i : ℤ × ℤ).1 : ℝ), ((b_N i : ℤ × ℤ).2 : ℝ)) := by
      intro i
      simp only [basis_real, Module.Basis.coe_mk]
      simp [b_real, ι_lin]
    have h_det_R_eq_cast :
        (Module.Basis.finTwoProd ℝ).det basis_real =
        (((Module.Basis.finTwoProd ℤ).det (fun i => ((b_N i : ℤ × ℤ))) : ℤ) : ℝ) := by
      have h_v : basis_real = (fun i =>
          (((b_N i : ℤ × ℤ).1 : ℝ), ((b_N i : ℤ × ℤ).2 : ℝ))) := by
        funext i; exact h_basis_real_explicit i
      rw [h_v]
      rw [Module.Basis.det_apply, Module.Basis.det_apply]
      simp [Matrix.det_fin_two, Module.Basis.toMatrix, Module.Basis.coe_finTwoProd_repr]
    -- (ii) The natAbs of the ℤ-det of b_N equals the index of N_sub.toAddSubgroup, which is n.
    -- First, restate the index calculation we already did above.
    have hψ_surj : Function.Surjective ψ_hom := by
      intro ⟨a, b⟩
      haveI : NeZero n := ⟨by omega⟩
      refine ⟨((a.val : ℤ), (b.val : ℤ)), ?_⟩
      change (((a.val : ℤ) : ZMod n), ((b.val : ℤ) : ZMod n)) = (a, b)
      ext
      · push_cast; exact ZMod.natCast_zmod_val a
      · push_cast; exact ZMod.natCast_zmod_val b
    have h_H_idx : H.index = n := by
      have h_im_card := AddSubgroup.index_mul_card H
      have h_prod_card : Nat.card (ZMod n × ZMod n) = n * n := by
        rw [Nat.card_prod]; simp
      rw [h_prod_card, _hH_card] at h_im_card
      have hn_pos : 0 < n := by omega
      exact Nat.eq_of_mul_eq_mul_right hn_pos h_im_card
    have h_index_eq : (H.comap ψ_hom).index = H.index :=
      AddSubgroup.index_comap_of_surjective H hψ_surj
    have h_idx_n : (H.comap ψ_hom).index = n := by rw [h_index_eq]; exact h_H_idx
    -- N_sub.toAddSubgroup = H.comap ψ_hom (by definition).
    -- Apply AddSubgroup.index_eq_natAbs_det directly with b_N as basis of N_sub.toIntSubmodule.
    -- Since N_sub.toAddSubgroup = H.comap ψ_hom (defl), its index = n.
    have h_NsubAS_idx : (N_sub : Submodule ℤ (ℤ × ℤ)).toAddSubgroup.index = n := h_idx_n
    have h_det_natAbs : ((Module.Basis.finTwoProd ℤ).det
        (fun i => ((b_N i : ℤ × ℤ)))).natAbs = n := by
      have h1 := AddSubgroup.index_eq_natAbs_det (Module.Basis.finTwoProd ℤ)
        (N_sub : Submodule ℤ (ℤ × ℤ)).toAddSubgroup b_N
      rw [h_NsubAS_idx] at h1
      exact h1.symm
    -- (iii) Combine: |det| in ℝ = (natAbs : ℝ) = n.
    have step_C : |(Module.Basis.finTwoProd ℝ).det basis_real| = (n : ℝ) := by
      rw [h_det_R_eq_cast]
      -- Goal: |((det_ℤ : ℤ) : ℝ)| = n. Use Int.cast_abs and Int.cast_natAbs.
      rw [show |(((Module.Basis.finTwoProd ℤ).det (fun i => ((b_N i : ℤ × ℤ))) : ℤ) : ℝ)| =
            (((Module.Basis.finTwoProd ℤ).det (fun i => ((b_N i : ℤ × ℤ)))).natAbs : ℝ) from by
              rw [← Int.cast_abs, ← Nat.cast_natAbs]]
      rw [h_det_natAbs]
    -- Step D: combine.
    rw [step_A, step_B, mul_one, step_C]
    -- Goal: ENNReal.ofReal n = (n : ENNReal)
    exact ENNReal.ofReal_natCast n
  -- M-to-integer: trivial from carrier definition.
  · rintro ⟨x, hx⟩
    obtain ⟨i, j, h_eq, h_mem⟩ := hx
    exact ⟨i, j, h_eq, h_mem⟩
  -- Integer-to-M: trivial.
  · intro i j h_mem
    exact ⟨i, j, rfl, h_mem⟩

/-! ## §3.1 helpers: family ℱ, minimality, rectangle-missing analysis -/

/-- **BHK Main Lemma — existence step.** Given a finite subgroup `G` of
    `T` with `|G| = n > 1`, and a symmetric closed convex neighborhood
    `K` of `(0,0)` in `ℝ²` contained in `[-αn, αn] × [-βn, βn]` with
    `A(K) ≥ 4n`, there exists a nonzero lattice point `(i,j) ∈ K ∩ ℤ²`
    such that `(i/n, j/n) ∈ G`.

    Proof (BHK p9): Minkowski-style covering. We use mathlib's
    `MeasureTheory.exists_ne_zero_mem_lattice_of_measure_mul_two_pow_le_measure`
    applied to the sub-lattice
    `M = {(i, j) ∈ ℤ² | (i mod n, j mod n) ∈ H} ⊆ ℝ²` of covolume `n`.

    Requires `K` to be symmetric, convex, compact (since mathlib's
    Minkowski needs these). -/
theorem bhk_main_lemma_existence
    (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (hG_lift : IsBHKLift G n)
    (α β : ℝ) (hα : 0 < α) (hβ : 0 < β)
    (K : Set (ℝ × ℝ)) (hK_sub : K ⊆ Set.Icc (-(α * n)) (α * n) ×ˢ
                                  Set.Icc (-(β * n)) (β * n))
    (hK_sym : ∀ x ∈ K, -x ∈ K) (hK_conv : Convex ℝ K) (hK_compact : IsCompact K)
    (hK_area : (4 * n : ℝ) ≤ (MeasureTheory.volume K).toReal) :
    ∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ℝ), (ij.2 : ℝ)) ∈ K ∧
      ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G := by
  -- Extract H, the algebraic subgroup behind G.
  obtain ⟨H, hH_card, hG_eq⟩ := hG_lift
  -- Build the sub-lattice M ⊆ ℝ² of integer points whose mod-n reduction
  -- lies in H, along with a fundamental domain F of volume n.
  obtain ⟨M, F, h_count, h_disc, hF_FD, hF_vol, h_M_to_int, _h_int_to_M⟩ :=
    bhk_lattice_from_subgroup n hn H hH_card
  -- Promote h_count, h_disc to instances for Minkowski's typeclass inference.
  haveI : Countable M := h_count
  haveI : DiscreteTopology M := h_disc
  -- Apply mathlib's Minkowski theorem to L = M, F as above, s = K.
  -- The hypothesis vol(K) ≥ 4n matches vol(F) · 2^2 = n · 4 = 4n.
  have hn_pos_nat : 0 < n := by omega
  have hn_pos_real : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn_pos_nat
  have h_finrank : Module.finrank ℝ (ℝ × ℝ) = 2 := by
    simp [Module.finrank_prod, Module.finrank_self]
  have h_two_pow : (2 : ℕ∞) ^ Module.finrank ℝ (ℝ × ℝ) = 4 := by
    rw [h_finrank]; norm_num
  have hvol_K : MeasureTheory.volume F * 2 ^ Module.finrank ℝ (ℝ × ℝ) ≤
                MeasureTheory.volume K := by
    rw [hF_vol, h_finrank]
    -- (n : ENNReal) * 2^2 = 4n ≤ vol(K)
    have h_2sq : (2 : ENNReal) ^ 2 = 4 := by norm_num
    rw [h_2sq]
    -- Goal: (n : ENNReal) * 4 ≤ volume K
    -- We have hK_area : 4 * n ≤ (volume K).toReal
    have h_vol_lt_top : MeasureTheory.volume K ≠ ⊤ := IsCompact.measure_ne_top hK_compact
    have h_n_real_nn : (0 : ℝ) ≤ 4 * n := by positivity
    calc (n : ENNReal) * 4
        = ENNReal.ofReal (4 * n) := by
          rw [mul_comm]
          rw [show (4 : ENNReal) = ENNReal.ofReal 4 from by
            rw [ENNReal.ofReal_ofNat]]
          rw [show ((n : ENNReal)) = ENNReal.ofReal n from by
            rw [ENNReal.ofReal_natCast]]
          rw [← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 4)]
      _ ≤ ENNReal.ofReal (MeasureTheory.volume K).toReal :=
          ENNReal.ofReal_le_ofReal hK_area
      _ = MeasureTheory.volume K := ENNReal.ofReal_toReal h_vol_lt_top
  obtain ⟨x, hx_ne, hx_K⟩ :=
    @MeasureTheory.exists_ne_zero_mem_lattice_of_measure_mul_two_pow_le_measure
      (ℝ × ℝ) _ MeasureTheory.volume F K _ _ _ _ _ _ M _ _
      hF_FD hK_sym hK_conv hK_compact hvol_K
  -- Extract integer coordinates from x ∈ M.
  obtain ⟨i, j, hij_eq, hij_H⟩ := h_M_to_int x
  refine ⟨(i, j), ?_, ?_, ?_⟩
  · -- (i, j) ≠ (0, 0): if it were, then x = 0 in M, contradicting hx_ne.
    intro h_eq
    apply hx_ne
    have hi_zero : i = 0 := (Prod.mk.injEq _ _ _ _).mp h_eq |>.1
    have hj_zero : j = 0 := (Prod.mk.injEq _ _ _ _).mp h_eq |>.2
    apply Subtype.ext
    rw [hij_eq, hi_zero, hj_zero]
    simp [AddSubmonoid.coe_zero]
  · -- (i, j) ∈ K (as reals).
    have h_coe : (x : ℝ × ℝ) = ((i : ℝ), (j : ℝ)) := hij_eq
    rw [← h_coe]; exact hx_K
  · -- (i/n, j/n) ∈ G. We have (i, j) ∈ M means (i mod n, j mod n) ∈ H,
    -- which gives membership in G via hG_eq.
    rw [hG_eq]
    refine ⟨((i : ZMod n), (j : ZMod n)), hij_H, ?_⟩
    -- Need: (i/n, j/n) = ((((i : ZMod n).val : ℝ) / n) + a, ...) for some a, b ∈ ℤ.
    have hn_ne_real : (n : ℝ) ≠ 0 := ne_of_gt hn_pos_real
    haveI : NeZero n := ⟨by omega⟩
    have hi_dvd : (n : ℤ) ∣ (i - ((i : ZMod n).val : ℤ)) := by
      have : ((i - ((i : ZMod n).val : ℤ) : ℤ) : ZMod n) = 0 := by
        push_cast
        rw [ZMod.natCast_zmod_val]
        ring
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp this
    have hj_dvd : (n : ℤ) ∣ (j - ((j : ZMod n).val : ℤ)) := by
      have : ((j - ((j : ZMod n).val : ℤ) : ℤ) : ZMod n) = 0 := by
        push_cast
        rw [ZMod.natCast_zmod_val]
        ring
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp this
    obtain ⟨a, ha⟩ := hi_dvd
    obtain ⟨b, hb⟩ := hj_dvd
    refine ⟨a, b, ?_⟩
    have hi_real : (i : ℝ) = ((i : ZMod n).val : ℝ) + (n : ℝ) * a := by
      have hi_int : (i : ℤ) = ((i : ZMod n).val : ℤ) + n * a := by linarith [ha]
      exact_mod_cast hi_int
    have hj_real : (j : ℝ) = ((j : ZMod n).val : ℝ) + (n : ℝ) * b := by
      have hj_int : (j : ℤ) = ((j : ZMod n).val : ℤ) + n * b := by linarith [hb]
      exact_mod_cast hj_int
    refine Prod.ext ?_ ?_
    · show (i : ℝ) / n = ((i : ZMod n).val : ℝ) / n + a
      rw [hi_real]
      field_simp
    · show (j : ℝ) / n = ((j : ZMod n).val : ℝ) / n + b
      rw [hj_real]
      field_simp

/-- **BHK Main Lemma — minimality refinement (§3.1 picks a "minimal" `(i,j)`).**
    Among nonzero integer points `(i,j)` with `(i/n, j/n) ∈ G`, there is
    one that is "minimal" in the sense that no proper integer scaling
    `(i,j) = k(i₀, j₀)` (`k > 1`, `(i₀/n, j₀/n) ∈ G`) exists.

    Proof: pick a candidate minimizing `|i| + |j|` (as a natural number,
    using `Int.natAbs`). The minimum exists by `Nat.find` applied to the
    well-founded `<` on `ℕ`. Any proper integer scaling `(i,j) = k(i₀,j₀)`
    with `k > 1` (integer) gives `|i| + |j| = k·(|i₀| + |j₀|) ≥ 2·(|i₀| +
    |j₀|) > |i₀| + |j₀|`, so `(i₀, j₀)` would have strictly smaller sum,
    contradicting minimality. -/
theorem bhk_main_lemma_minimality
    (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (α β : ℝ) (hαn : 0 ≤ α * (n : ℝ)) (hβn : 0 ≤ β * (n : ℝ))
    (h_exists : ∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
      |(ij.1 : ℝ)| ≤ α * n ∧ |(ij.2 : ℝ)| ≤ β * n) :
    ∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
      |(ij.1 : ℝ)| ≤ α * n ∧ |(ij.2 : ℝ)| ≤ β * n ∧
      (∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
        ((i₀ : ℝ) / n, (j₀ : ℝ) / n) ∈ G →
        (ij.1, ij.2) ≠ (k * i₀, k * j₀)) := by
  -- P k := "∃ (i,j) ≠ 0 in box with (i/n, j/n) ∈ G and |i| + |j| = k".
  set P : ℕ → Prop := fun k =>
    ∃ ij : ℤ × ℤ, ij ≠ (0,0) ∧ ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
      |(ij.1 : ℝ)| ≤ α * n ∧ |(ij.2 : ℝ)| ≤ β * n ∧
      ij.1.natAbs + ij.2.natAbs = k with hP_def
  have hP_classical : ∀ k, Decidable (P k) := fun _ => Classical.dec _
  have hP_nonempty : ∃ k, P k := by
    obtain ⟨ij, hij_ne, hij_G, hij_α, hij_β⟩ := h_exists
    exact ⟨ij.1.natAbs + ij.2.natAbs, ij, hij_ne, hij_G, hij_α, hij_β, rfl⟩
  classical
  let k₀ := Nat.find hP_nonempty
  have hk₀_spec : P k₀ := Nat.find_spec hP_nonempty
  have hk₀_min : ∀ k, k < k₀ → ¬ P k := fun _ hk => Nat.find_min hP_nonempty hk
  obtain ⟨ij, hij_ne, hij_G, hij_α, hij_β, hij_card⟩ := hk₀_spec
  refine ⟨ij, hij_ne, hij_G, hij_α, hij_β, ?_⟩
  intro i₀ j₀ k hk_gt hG₀
  by_contra h_eq
  -- Extract componentwise equalities.
  have hij1 : ij.1 = k * i₀ := (Prod.mk.injEq _ _ _ _).mp h_eq |>.1
  have hij2 : ij.2 = k * j₀ := (Prod.mk.injEq _ _ _ _).mp h_eq |>.2
  -- (i₀, j₀) ≠ (0, 0) — else ij = (0, 0).
  have hij₀_ne : (i₀, j₀) ≠ (0, 0) := by
    intro hh
    apply hij_ne
    have : i₀ = 0 ∧ j₀ = 0 := Prod.mk.injEq _ _ _ _ |>.mp hh
    have hh1 : ij.1 = 0 := by rw [hij1, this.1]; ring
    have hh2 : ij.2 = 0 := by rw [hij2, this.2]; ring
    rcases ij with ⟨a, b⟩
    simp at hh1 hh2; subst hh1; subst hh2; rfl
  -- |k| ≥ 2 (since k > 1 in ℤ).
  have hk_natAbs_ge_2 : 2 ≤ k.natAbs := by
    have hk_pos : 0 < k := by linarith
    have hk_ge_2 : 2 ≤ k := hk_gt
    have hk_eq : k.natAbs = k.toNat := Int.natAbs_of_nonneg hk_pos.le |>.symm ▸ rfl
    omega
  -- |ij.1| + |ij.2| = |k| · (|i₀| + |j₀|).
  have h_sum_eq : ij.1.natAbs + ij.2.natAbs = k.natAbs * (i₀.natAbs + j₀.natAbs) := by
    rw [hij1, hij2, Int.natAbs_mul, Int.natAbs_mul]; ring
  -- |i₀| + |j₀| > 0 (since (i₀, j₀) ≠ (0, 0)).
  have h_sum₀_pos : 0 < i₀.natAbs + j₀.natAbs := by
    by_contra h
    push_neg at h
    have h1 : i₀.natAbs = 0 := by omega
    have h2 : j₀.natAbs = 0 := by omega
    have hi₀ : i₀ = 0 := Int.natAbs_eq_zero.mp h1
    have hj₀ : j₀ = 0 := Int.natAbs_eq_zero.mp h2
    exact hij₀_ne (by rw [hi₀, hj₀])
  -- Box-closure: (i₀, j₀) is also in the box (smaller absolute values).
  -- |ij.1| = |k| * |i₀|, and |k| ≥ 1, so |i₀| ≤ |ij.1| ≤ α n. Similarly for j₀.
  have hk_R_ge_one : (1 : ℝ) ≤ |(k : ℝ)| := by
    have h_nat : (1 : ℕ) ≤ k.natAbs := by omega
    have h1 : (1 : ℝ) ≤ (k.natAbs : ℝ) := by exact_mod_cast h_nat
    have h_cast : (k.natAbs : ℝ) = |(k : ℝ)| := by
      have h_int : ((k.natAbs : ℤ) : ℝ) = ((|k| : ℤ) : ℝ) := by
        exact_mod_cast (Int.abs_eq_natAbs k).symm
      rw [Int.cast_natCast] at h_int
      rw [Int.cast_abs] at h_int
      exact h_int
    linarith
  have hi₀_box : |(i₀ : ℝ)| ≤ α * n := by
    have h_eq : |(ij.1 : ℝ)| = |(k : ℝ)| * |(i₀ : ℝ)| := by
      rw [hij1]; push_cast; rw [abs_mul]
    have h_le : |(i₀ : ℝ)| ≤ |(ij.1 : ℝ)| := by
      have h_nonneg : (0 : ℝ) ≤ |(i₀ : ℝ)| := abs_nonneg _
      calc |(i₀ : ℝ)| = 1 * |(i₀ : ℝ)| := by ring
        _ ≤ |(k : ℝ)| * |(i₀ : ℝ)| := mul_le_mul_of_nonneg_right hk_R_ge_one h_nonneg
        _ = |(ij.1 : ℝ)| := h_eq.symm
    linarith [hij_α]
  have hj₀_box : |(j₀ : ℝ)| ≤ β * n := by
    have h_eq : |(ij.2 : ℝ)| = |(k : ℝ)| * |(j₀ : ℝ)| := by
      rw [hij2]; push_cast; rw [abs_mul]
    have h_le : |(j₀ : ℝ)| ≤ |(ij.2 : ℝ)| := by
      have h_nonneg : (0 : ℝ) ≤ |(j₀ : ℝ)| := abs_nonneg _
      calc |(j₀ : ℝ)| = 1 * |(j₀ : ℝ)| := by ring
        _ ≤ |(k : ℝ)| * |(j₀ : ℝ)| := mul_le_mul_of_nonneg_right hk_R_ge_one h_nonneg
        _ = |(ij.2 : ℝ)| := h_eq.symm
    linarith [hij_β]
  -- Hence |i₀| + |j₀| < k₀.
  have h_smaller : i₀.natAbs + j₀.natAbs < k₀ := by
    have hk₀_eq : k₀ = k.natAbs * (i₀.natAbs + j₀.natAbs) := by
      rw [← hij_card, h_sum_eq]
    rw [hk₀_eq]
    have h_lt : 1 * (i₀.natAbs + j₀.natAbs) < k.natAbs * (i₀.natAbs + j₀.natAbs) :=
      Nat.mul_lt_mul_of_pos_right (by omega : 1 < k.natAbs) h_sum₀_pos
    linarith
  -- Apply hk₀_min: P (|i₀| + |j₀|) cannot hold, but it does (using box closure).
  exact hk₀_min _ h_smaller ⟨(i₀, j₀), hij₀_ne, hG₀, hi₀_box, hj₀_box, rfl⟩

/-! ## Bridge and structure lemmas for the Main Lemma geometry -/

/-- **Integer-point membership bridge for a BHK lift.** For integers
    `a, b`, the point `(a/n, b/n)` lies in `G` iff the mod-`n`
    reduction `(a, b)` lies in `H`. -/
lemma bhk_lift_int_mem_iff (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n))
    (hG_iff : ∀ p : ℝ × ℝ, p ∈ G ↔ ∃ h ∈ H, ∃ i j : ℤ,
      p = (((h.1.val : ℝ) / n) + (i : ℝ), ((h.2.val : ℝ) / n) + (j : ℝ)))
    (a b : ℤ) :
    ((a : ℝ) / n, (b : ℝ) / n) ∈ G ↔ ((a : ZMod n), (b : ZMod n)) ∈ H := by
  haveI : NeZero n := ⟨by omega⟩
  have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
  have hn_ne_real : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  constructor
  · intro hab
    rw [hG_iff] at hab
    obtain ⟨h, hh_in, k, l, heq⟩ := hab
    have h_a_eq : (a : ℝ) = (h.1.val : ℝ) + (n : ℝ) * (k : ℝ) := by
      have h1 := congr_arg Prod.fst heq
      field_simp at h1
      linarith
    have h_b_eq : (b : ℝ) = (h.2.val : ℝ) + (n : ℝ) * (l : ℝ) := by
      have h2 := congr_arg Prod.snd heq
      field_simp at h2
      linarith
    have h_a_int : a = (h.1.val : ℤ) + (n : ℤ) * k := by
      have h_rhs : (h.1.val : ℝ) + (n : ℝ) * (k : ℝ) =
          (((h.1.val : ℤ) + (n : ℤ) * k : ℤ) : ℝ) := by push_cast; ring
      rw [h_rhs] at h_a_eq
      exact_mod_cast h_a_eq
    have h_b_int : b = (h.2.val : ℤ) + (n : ℤ) * l := by
      have h_rhs : (h.2.val : ℝ) + (n : ℝ) * (l : ℝ) =
          (((h.2.val : ℤ) + (n : ℤ) * l : ℤ) : ℝ) := by push_cast; ring
      rw [h_rhs] at h_b_eq
      exact_mod_cast h_b_eq
    have h_a_zmod : (a : ZMod n) = h.1 := by
      rw [h_a_int]; push_cast; simp [ZMod.natCast_val]
    have h_b_zmod : (b : ZMod n) = h.2 := by
      rw [h_b_int]; push_cast; simp [ZMod.natCast_val]
    have h_pair : ((a : ZMod n), (b : ZMod n)) = (h : ZMod n × ZMod n) := by
      ext
      · exact h_a_zmod
      · exact h_b_zmod
    rw [h_pair]; exact hh_in
  · intro hab
    rw [hG_iff]
    refine ⟨((a : ZMod n), (b : ZMod n)), hab, ?_⟩
    have ha_dvd : (n : ℤ) ∣ (a - ((a : ZMod n).val : ℤ)) := by
      have : ((a - ((a : ZMod n).val : ℤ) : ℤ) : ZMod n) = 0 := by
        push_cast; rw [ZMod.natCast_zmod_val]; ring
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp this
    have hb_dvd : (n : ℤ) ∣ (b - ((b : ZMod n).val : ℤ)) := by
      have : ((b - ((b : ZMod n).val : ℤ) : ℤ) : ZMod n) = 0 := by
        push_cast; rw [ZMod.natCast_zmod_val]; ring
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp this
    obtain ⟨k, hk⟩ := ha_dvd
    obtain ⟨l, hl⟩ := hb_dvd
    refine ⟨k, l, ?_⟩
    have h_a_real : (a : ℝ) = ((a : ZMod n).val : ℝ) + (n : ℝ) * (k : ℝ) := by
      have : (a : ℤ) = ((a : ZMod n).val : ℤ) + (n : ℤ) * k := by linarith [hk]
      exact_mod_cast this
    have h_b_real : (b : ℝ) = ((b : ZMod n).val : ℝ) + (n : ℝ) * (l : ℝ) := by
      have : (b : ℤ) = ((b : ZMod n).val : ℤ) + (n : ℤ) * l := by linarith [hl]
      exact_mod_cast this
    refine Prod.ext ?_ ?_
    · show (a : ℝ) / n = ((a : ZMod n).val : ℝ) / n + k
      rw [h_a_real]; field_simp
    · show (b : ℝ) / n = ((b : ZMod n).val : ℝ) / n + l
      rw [h_b_real]; field_simp

/-- **Closed interval catches a spaced progression.** Any arithmetic
    progression `y₀ + ℤ·s` (step `0 < s`) meets any closed interval
    `[a, a + L]` with `L ≥ s`: take `k = ⌈(a - y₀)/s⌉`. -/
lemma bhk_interval_catch (y₀ s a L : ℝ) (hs : 0 < s) (hsL : s ≤ L) :
    ∃ k : ℤ, a ≤ y₀ + (k : ℝ) * s ∧ y₀ + (k : ℝ) * s ≤ a + L := by
  refine ⟨⌈(a - y₀) / s⌉, ?_, ?_⟩
  · have h1 := mul_le_mul_of_nonneg_right (Int.le_ceil ((a - y₀) / s)) hs.le
    rw [div_mul_cancel₀ _ hs.ne'] at h1
    linarith
  · have h1 := mul_lt_mul_of_pos_right (Int.ceil_lt_add_one ((a - y₀) / s)) hs
    rw [add_mul, div_mul_cancel₀ _ hs.ne', one_mul] at h1
    linarith

/-- **Closed window catches a spaced coset.** Any arithmetic progression
    `y₀ + ℤ·s` (step `0 < s`) meets the fract-window
    `{y | Int.fract (y - x) ≤ L}` whenever `s ≤ L < 1`: take
    `k = ⌈(x - y₀)/s⌉`, so `y₀ + k·s - x ∈ [0, s) ⊆ [0, L]`. -/
lemma bhk_coset_catch (y₀ s x L : ℝ) (hs : 0 < s) (hsL : s ≤ L) (hL : L < 1) :
    ∃ k : ℤ, Int.fract (y₀ + (k : ℝ) * s - x) ≤ L := by
  refine ⟨⌈(x - y₀) / s⌉, ?_⟩
  have h_ceil_ge : (x - y₀) / s ≤ (⌈(x - y₀) / s⌉ : ℝ) := Int.le_ceil _
  have h_ceil_lt : (⌈(x - y₀) / s⌉ : ℝ) < (x - y₀) / s + 1 := Int.ceil_lt_add_one _
  have h_lo : 0 ≤ y₀ + (⌈(x - y₀) / s⌉ : ℝ) * s - x := by
    have h1 := mul_le_mul_of_nonneg_right h_ceil_ge hs.le
    rw [div_mul_cancel₀ _ hs.ne'] at h1
    linarith
  have h_hi : y₀ + (⌈(x - y₀) / s⌉ : ℝ) * s - x < s := by
    have h1 := mul_lt_mul_of_pos_right h_ceil_lt hs
    rw [add_mul, div_mul_cancel₀ _ hs.ne', one_mul] at h1
    linarith
  have h_fract_eq : Int.fract (y₀ + (⌈(x - y₀) / s⌉ : ℝ) * s - x) =
      y₀ + (⌈(x - y₀) / s⌉ : ℝ) * s - x :=
    Int.fract_eq_self.mpr ⟨h_lo, by linarith⟩
  rw [h_fract_eq]
  linarith

/-- **Generator equality for subgroups of `ZMod n`.** Any subgroup
    `X ≤ ZMod n` *equals* the cyclic subgroup generated by the residue
    `n / |X|`. Proved by sandwiching: every element of `X` is
    `|X|`-torsion, so `X` lies inside `⟨n/|X|⟩`; both have `|X|`
    elements, hence are equal. -/
lemma bhk_zmod_div_card_eq (n : ℕ) (hn : 0 < n) (X : AddSubgroup (ZMod n)) :
    X = AddSubgroup.zmultiples ((n / Nat.card X : ℕ) : ZMod n) := by
  haveI : NeZero n := ⟨hn.ne'⟩
  set m : ℕ := Nat.card X with hm_def
  have hm_pos : 0 < m := Nat.card_pos
  have hm_dvd : m ∣ n := by
    have h := AddSubgroup.card_addSubgroup_dvd_card X
    rwa [Nat.card_zmod] at h
  set d : ℕ := n / m with hd_def
  have hdm : d * m = n := Nat.div_mul_cancel hm_dvd
  have hd_pos : 0 < d := Nat.div_pos (Nat.le_of_dvd hn hm_dvd) hm_pos
  have hd_dvd : d ∣ n := ⟨m, hdm.symm⟩
  -- Every element of X is m-torsion.
  have h_torsion : ∀ x ∈ X, ((m : ℕ) : ZMod n) * x = 0 := by
    intro x hx
    have h1 : m • (⟨x, hx⟩ : X) = 0 := by
      rw [hm_def]; exact card_nsmul_eq_zero'
    have h2 := congrArg (X.subtype) h1
    rw [map_nsmul, map_zero] at h2
    simp only [AddSubgroup.subtype_apply] at h2
    rwa [nsmul_eq_mul] at h2
  -- Hence X is contained in the m-torsion subgroup ⟨(d : ZMod n)⟩.
  have h_le : X ≤ AddSubgroup.zmultiples ((d : ℕ) : ZMod n) := by
    intro x hx
    have h_zero : ((m * x.val : ℕ) : ZMod n) = 0 := by
      push_cast
      rw [ZMod.natCast_zmod_val]
      exact h_torsion x hx
    have h_n_dvd : n ∣ m * x.val := by
      have h3 : ((m * x.val : ℕ) : ZMod n) = ((0 : ℕ) : ZMod n) := by
        rw [h_zero]; norm_num
      exact (Nat.modEq_zero_iff_dvd).mp ((ZMod.natCast_eq_natCast_iff _ _ _).mp h3)
    have h_d_dvd : d ∣ x.val := by
      obtain ⟨t, ht⟩ := h_n_dvd
      refine ⟨t, ?_⟩
      have hmx : m * x.val = m * (d * t) := by
        rw [ht, ← hdm]; ring
      exact Nat.eq_of_mul_eq_mul_left hm_pos hmx
    obtain ⟨t, ht⟩ := h_d_dvd
    rw [AddSubgroup.mem_zmultiples_iff]
    refine ⟨(t : ℤ), ?_⟩
    have hx_eq : ((x.val : ℕ) : ZMod n) = x := ZMod.natCast_zmod_val x
    rw [← hx_eq, ht, zsmul_eq_mul]
    push_cast
    ring
  -- Card comparison: |⟨d⟩| = m = |X| forces equality.
  have h_card_z : Nat.card (AddSubgroup.zmultiples ((d : ℕ) : ZMod n)) = m := by
    rw [Nat.card_zmultiples, ZMod.addOrderOf_coe d hn.ne', Nat.gcd_eq_right hd_dvd,
        ← hdm, Nat.mul_div_cancel_left m hd_pos]
  exact AddSubgroup.eq_of_le_of_card_ge h_le (by rw [h_card_z, hm_def])

/-- **Generator membership for subgroups of `ZMod n`** (corollary of
    `bhk_zmod_div_card_eq`). -/
lemma bhk_zmod_div_card_mem (n : ℕ) (hn : 0 < n) (X : AddSubgroup (ZMod n)) :
    ((n / Nat.card X : ℕ) : ZMod n) ∈ X :=
  (bhk_zmod_div_card_eq n hn X).ge (AddSubgroup.mem_zmultiples _)

/-- **Column structure of an order-`n` subgroup of `(ZMod n)²`.**

    Any `H ≤ (ZMod n)²` with `|H| = n` determines positive integers
    `e, f` with `e * f = n` and a residue `c` such that `(e, c) ∈ H` and
    `(0, f) ∈ H`, and moreover `f` *generates* the kernel column
    `{y : (0, y) ∈ H}` (order `n/f`); `e` generates the
    first-coordinate image `π₁(H)` (order `n/e`).

    The identity `e · f = n` is the first isomorphism theorem
    `|H| = |im π₁| · |ker π₁|` combined with `|H| = n`. -/
lemma bhk_subgroup_column_structure (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n) :
    ∃ e f c : ℕ, 0 < e ∧ 0 < f ∧ e * f = n ∧
      (((e : ℕ) : ZMod n), ((c : ℕ) : ZMod n)) ∈ H ∧
      ((0 : ZMod n), ((f : ℕ) : ZMod n)) ∈ H ∧
      (∀ y : ZMod n, ((0 : ZMod n), y) ∈ H →
        y ∈ AddSubgroup.zmultiples (((f : ℕ) : ℕ) : ZMod n)) ∧
      (∀ p : ZMod n × ZMod n, p ∈ H →
        p.1 ∈ AddSubgroup.zmultiples (((e : ℕ) : ℕ) : ZMod n)) := by
  haveI : NeZero n := ⟨by omega⟩
  haveI : Finite H := Nat.finite_of_card_ne_zero (by rw [hH_card]; omega)
  -- First-coordinate projection of H.
  set π : H →+ ZMod n := (AddMonoidHom.fst (ZMod n) (ZMod n)).comp H.subtype
    with hπ_def
  -- First isomorphism theorem: |range π| · |ker π| = n.
  have h_iso : Nat.card (H ⧸ π.ker) = Nat.card π.range :=
    Nat.card_congr (QuotientAddGroup.quotientKerEquivRange π).toEquiv
  have h_lagrange := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup π.ker
  have h_prod : Nat.card π.range * Nat.card π.ker = n := by
    rw [← h_iso, ← h_lagrange, hH_card]
  -- The kernel column as a subgroup of ZMod n.
  set Y : AddSubgroup (ZMod n) :=
    { carrier := {y : ZMod n | ((0 : ZMod n), y) ∈ H}
      zero_mem' := H.zero_mem
      add_mem' := by
        intro a b ha hb
        have h := H.add_mem ha hb
        simpa using h
      neg_mem' := by
        intro a ha
        have h := H.neg_mem ha
        simpa using h } with hY_def
  have hY_mem_iff : ∀ y : ZMod n, y ∈ Y ↔ ((0 : ZMod n), y) ∈ H := by
    intro y; rfl
  -- Y is (equinumerous with) the kernel of π.
  have h_card_Y : Nat.card Y = Nat.card π.ker := by
    refine Nat.card_congr (Equiv.symm ?_)
    refine Equiv.ofBijective
      (fun k => (⟨(k.val.val).2, ?_⟩ : Y)) ⟨?_, ?_⟩
    · -- membership: (0, k.val.val.2) ∈ H
      have hk_mem : k.val.val ∈ H := k.val.prop
      have hk_fst : (k.val.val).1 = 0 := by
        have hk := k.prop
        rw [AddMonoidHom.mem_ker] at hk
        exact hk
      have h_pair : k.val.val = ((0 : ZMod n), (k.val.val).2) :=
        Prod.ext hk_fst rfl
      rw [hY_mem_iff, ← h_pair]
      exact hk_mem
    · -- injective
      intro k₁ k₂ h_eq
      have h_snd : (k₁.val.val).2 = (k₂.val.val).2 := congrArg Subtype.val h_eq
      have h_fst : (k₁.val.val).1 = (k₂.val.val).1 := by
        have h1 := k₁.prop
        have h2 := k₂.prop
        rw [AddMonoidHom.mem_ker] at h1 h2
        rw [show ((k₁.val.val).1 : ZMod n) = π k₁.val from rfl, h1,
            show ((k₂.val.val).1 : ZMod n) = π k₂.val from rfl, h2]
      exact Subtype.ext (Subtype.ext (Prod.ext h_fst h_snd))
    · -- surjective
      intro y
      have hy_mem : ((0 : ZMod n), y.val) ∈ H := (hY_mem_iff y.val).mp y.prop
      have h_in_ker : (⟨((0 : ZMod n), y.val), hy_mem⟩ : H) ∈ π.ker := by
        rw [AddMonoidHom.mem_ker]
        rfl
      exact ⟨⟨⟨((0 : ZMod n), y.val), hy_mem⟩, h_in_ker⟩, Subtype.ext rfl⟩
  -- Extract e from the image, f from the kernel column.
  have h_e_mem := bhk_zmod_div_card_mem n (by omega) π.range
  have h_f_mem := bhk_zmod_div_card_mem n (by omega) Y
  have h_Y_eq := bhk_zmod_div_card_eq n (by omega) Y
  have h_X_eq := bhk_zmod_div_card_eq n (by omega) π.range
  set mX : ℕ := Nat.card π.range with hmX_def
  set mY : ℕ := Nat.card Y with hmY_def
  have hmX_pos : 0 < mX := Nat.card_pos
  have hmY_pos : 0 < mY := Nat.card_pos
  have h_prod' : mX * mY = n := by rw [h_card_Y]; exact h_prod
  -- e = n / mX and f = n / mY multiply back to n.
  have he_eq : n / mX = mY := by
    rw [← h_prod', Nat.mul_div_cancel_left mY hmX_pos]
  have hf_eq : n / mY = mX := by
    have h2 : mY * mX = n := by rw [mul_comm]; exact h_prod'
    rw [← h2, Nat.mul_div_cancel_left mX hmY_pos]
  -- Unpack the image membership: some h₁ ∈ H has first coordinate e.
  obtain ⟨h₁, hπh₁⟩ := AddMonoidHom.mem_range.mp h_e_mem
  refine ⟨n / mX, n / mY, ((h₁.val).2).val, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- 0 < e
    rw [he_eq]; exact hmY_pos
  · -- 0 < f
    rw [hf_eq]; exact hmX_pos
  · -- e * f = n
    rw [he_eq, hf_eq, mul_comm]; exact h_prod'
  · -- ((e : ZMod n), (c : ZMod n)) ∈ H
    have h_fst : (h₁.val).1 = ((n / mX : ℕ) : ZMod n) := by
      rw [← hπh₁]; rfl
    have h_snd : ((((h₁.val).2).val : ℕ) : ZMod n) = (h₁.val).2 :=
      ZMod.natCast_zmod_val _
    have h_pair : (((n / mX : ℕ) : ZMod n), ((((h₁.val).2).val : ℕ) : ZMod n)) =
        h₁.val := by
      refine Prod.ext ?_ ?_
      · exact h_fst.symm
      · exact h_snd
    rw [h_pair]
    exact h₁.prop
  · -- ((0 : ZMod n), (f : ZMod n)) ∈ H
    exact (hY_mem_iff _).mp h_f_mem
  · -- f generates the kernel column.
    intro y hy
    have hy_Y : y ∈ Y := (hY_mem_iff y).mpr hy
    rw [h_Y_eq] at hy_Y
    exact hy_Y
  · -- e generates the first-coordinate image.
    intro p hp
    have hp1 : p.1 ∈ π.range := AddMonoidHom.mem_range.mpr ⟨⟨p, hp⟩, rfl⟩
    rw [h_X_eq] at hp1
    exact hp1

/-- **Row structure of an order-`n` subgroup of `(ZMod n)²`** — the
    coordinate swap of `bhk_subgroup_column_structure`: `e·f = n` with
    `(c, e) ∈ H`, `(f, 0) ∈ H`, and `f` generating the row kernel
    `{x : (x, 0) ∈ H}`. -/
lemma bhk_subgroup_row_structure (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n) :
    ∃ e f c : ℕ, 0 < e ∧ 0 < f ∧ e * f = n ∧
      (((c : ℕ) : ZMod n), ((e : ℕ) : ZMod n)) ∈ H ∧
      (((f : ℕ) : ZMod n), (0 : ZMod n)) ∈ H ∧
      (∀ x : ZMod n, (x, (0 : ZMod n)) ∈ H →
        x ∈ AddSubgroup.zmultiples (((f : ℕ) : ℕ) : ZMod n)) := by
  -- Transport along the coordinate swap.
  set σ : (ZMod n × ZMod n) ≃+ (ZMod n × ZMod n) :=
    AddEquiv.prodComm with hσ_def
  set H' : AddSubgroup (ZMod n × ZMod n) := H.map σ.toAddMonoidHom with hH'_def
  have hH'_mem : ∀ p : ZMod n × ZMod n, p ∈ H' ↔ (p.2, p.1) ∈ H := by
    intro p
    constructor
    · rintro ⟨q, hq, rfl⟩
      simpa [hσ_def] using hq
    · intro hp
      exact ⟨(p.2, p.1), hp, rfl⟩
  have hH'_card : Nat.card H' = n := by
    rw [hH'_def,
        ← Nat.card_congr (AddSubgroup.equivMapOfInjective H σ.toAddMonoidHom
          (AddEquiv.injective σ)).toEquiv]
    exact hH_card
  obtain ⟨e, f, c, he, hf, hef, h_ec, h_0f, h_gen, -⟩ :=
    bhk_subgroup_column_structure n hn H' hH'_card
  refine ⟨e, f, c, he, hf, hef, ?_, ?_, ?_⟩
  · exact (hH'_mem _).mp h_ec
  · exact (hH'_mem _).mp h_0f
  · intro x hx
    exact h_gen x ((hH'_mem _).mpr (by simpa using hx))

/-- **Vertical-axis case of the rectangle-minimal bound (`i = 0`).**

    If `(0, j)` (with `j ≠ 0`, `|j| ≤ βn`) reduces into `G` and is
    minimal, and `G` misses some `α × β` rectangle, then `α·|j| < 1`
    (the `i = 0` instance of BHK (12)).

    Geometry (BHK p10): minimality forces `|j| = f`, the generator of
    the kernel column of `H`; the column structure provides a slope
    point `(e, c) ∈ H` with `e·f = n`. If `α·f ≥ 1` then the
    `e`-multiples are `e/n = 1/f ≤ α`-dense horizontally and each
    occupied column is `f/n ≤ β`-dense vertically, so every rectangle
    is hit — contradiction. -/
lemma bhk_rectangle_minimal_vertical_axis
    (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (hG_lift : IsBHKLift G n)
    (α β : ℝ) (hα' : α < 1) (hβ' : β < 1)
    (j : ℤ) (hj : j ≠ 0)
    (hj_box : |(j : ℝ)| ≤ β * n)
    (hij_in_G : ((((0 : ℤ)) : ℝ) / n, (j : ℝ) / n) ∈ G)
    (hij_minimal : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ℝ) / n, (j₀ : ℝ) / n) ∈ G →
      ((0 : ℤ), j) ≠ (k * i₀, k * j₀))
    (h_misses : ∃ x₁ x₂, ¬ (G ∩ bhkRectangle x₁ x₂ α β).Nonempty) :
    α * |(j : ℝ)| < 1 := by
  by_contra h_ge
  push_neg at h_ge
  obtain ⟨x₁, x₂, h_miss⟩ := h_misses
  haveI : NeZero n := ⟨by omega⟩
  have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
  obtain ⟨H, hH_card, hG_iff⟩ := hG_lift
  have h_bridge := bhk_lift_int_mem_iff G n hn H hG_iff
  obtain ⟨e, f, c, he_pos, hf_pos, hef, h_ec_mem, h_0f_mem, h_gen, -⟩ :=
    bhk_subgroup_column_structure n hn H hH_card
  have he_pos_R : (0 : ℝ) < e := by exact_mod_cast he_pos
  have hf_pos_R : (0 : ℝ) < f := by exact_mod_cast hf_pos
  have hef_R : (e : ℝ) * f = n := by exact_mod_cast hef
  -- (0, j) reduces into H.
  have hj_H : (((0 : ℤ) : ZMod n), (j : ZMod n)) ∈ H := (h_bridge 0 j).mp hij_in_G
  -- f ∣ j (j lies in the kernel column, generated by f).
  have h_f_dvd : ((f : ℕ) : ℤ) ∣ j := by
    have h_zm : (j : ZMod n) ∈ AddSubgroup.zmultiples (((f : ℕ) : ℕ) : ZMod n) := by
      apply h_gen
      have h0 : ((0 : ℤ) : ZMod n) = (0 : ZMod n) := by push_cast; ring
      rwa [h0] at hj_H
    rw [AddSubgroup.mem_zmultiples_iff] at h_zm
    obtain ⟨m, hm⟩ := h_zm
    have h_zero : ((j - m * (f : ℕ) : ℤ) : ZMod n) = 0 := by
      push_cast
      rw [show ((j : ZMod n) : ZMod n) = m • ((f : ℕ) : ZMod n) from hm.symm,
          zsmul_eq_mul]
      ring
    have h_n_dvd : (n : ℤ) ∣ (j - m * (f : ℕ)) :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp h_zero
    obtain ⟨t, ht⟩ := h_n_dvd
    refine ⟨m + (e : ℤ) * t, ?_⟩
    have hef_Z : ((e : ℕ) : ℤ) * ((f : ℕ) : ℤ) = (n : ℤ) := by exact_mod_cast hef
    have h_j_eq : j = m * (f : ℕ) + (n : ℤ) * t := by linarith [ht]
    rw [h_j_eq, ← hef_Z]
    ring
  -- Minimality forces |j| = f.
  have h_abs_j : j.natAbs = f := by
    obtain ⟨q, hq⟩ := h_f_dvd
    have hq_ne : q ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at hq
      exact hj hq
    by_contra h_ne
    have h_natAbs_eq : j.natAbs = f * q.natAbs := by
      rw [hq, Int.natAbs_mul, Int.natAbs_natCast]
    have h_q_ge_2 : 2 ≤ q.natAbs := by
      have h1 : q.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hq_ne
      have h2 : q.natAbs ≠ 1 := by
        intro h1'
        rw [h1', mul_one] at h_natAbs_eq
        exact h_ne h_natAbs_eq
      omega
    rcases lt_or_gt_of_ne hq_ne with h_neg | h_pos
    · -- q < 0: (0, j) = ((-q)·0, (-q)·(-f)) violates minimality.
      have h_0negf_G : ((((0 : ℤ)) : ℝ) / n, ((-(f : ℕ) : ℤ) : ℝ) / n) ∈ G := by
        apply (h_bridge 0 (-(f : ℕ))).mpr
        have h_negf : ((-(f : ℕ) : ℤ) : ZMod n) = -((f : ℕ) : ZMod n) := by
          push_cast; ring
        rw [h_negf]
        have h0 : ((0 : ℤ) : ZMod n) = (0 : ZMod n) := by push_cast; ring
        rw [h0]
        have := H.neg_mem h_0f_mem
        simpa using this
      have h_k_gt : (1 : ℤ) < -q := by omega
      apply hij_minimal 0 (-(f : ℕ)) (-q) h_k_gt h_0negf_G
      refine Prod.ext ?_ ?_
      · simp
      · show j = -q * -(f : ℕ)
        rw [hq]; ring
    · -- q > 0: (0, j) = (q·0, q·f) violates minimality.
      have h_0f_G : ((((0 : ℤ)) : ℝ) / n, (((f : ℕ) : ℤ) : ℝ) / n) ∈ G := by
        apply (h_bridge 0 (f : ℕ)).mpr
        have h0 : ((0 : ℤ) : ZMod n) = (0 : ZMod n) := by push_cast; ring
        have hf_cast : (((f : ℕ) : ℤ) : ZMod n) = ((f : ℕ) : ZMod n) := by
          push_cast; ring
        rw [h0, hf_cast]
        exact h_0f_mem
      have h_k_gt : (1 : ℤ) < q := by omega
      apply hij_minimal 0 (f : ℕ) q h_k_gt h_0f_G
      refine Prod.ext ?_ ?_
      · simp
      · show j = q * (f : ℕ)
        rw [hq]; ring
  -- Real form: f = |j|.
  have h_f_eq_absj : (f : ℝ) = |(j : ℝ)| := by
    rw [← h_abs_j]
    exact_mod_cast (Int.cast_natAbs (α := ℝ) j)
  -- Density bounds for the two catching steps.
  have h_αf : 1 ≤ α * f := by rw [h_f_eq_absj]; exact h_ge
  have h_en_le : (e : ℝ) / n ≤ α := by
    have h_en : (e : ℝ) / n = 1 / f := by
      rw [← hef_R]
      field_simp
    rw [h_en, div_le_iff₀ hf_pos_R]
    linarith
  have h_fn_le : (f : ℝ) / n ≤ β := by
    rw [div_le_iff₀ hn_pos, h_f_eq_absj]
    exact hj_box
  -- Catch the rectangle: x-step then y-step.
  obtain ⟨k, hk⟩ := bhk_coset_catch 0 ((e : ℝ) / n) x₁ α (by positivity) h_en_le hα'
  obtain ⟨m, hm⟩ := bhk_coset_catch ((k : ℝ) * c / n) ((f : ℝ) / n) x₂ β
    (by positivity) h_fn_le hβ'
  -- The caught point of G.
  have hp_H : (((k * (e : ℕ) : ℤ) : ZMod n),
      ((k * (c : ℕ) + m * (f : ℕ) : ℤ) : ZMod n)) ∈ H := by
    have h_pair_eq :
        (((k * (e : ℕ) : ℤ) : ZMod n), ((k * (c : ℕ) + m * (f : ℕ) : ℤ) : ZMod n)) =
          k • (((e : ℕ) : ZMod n), ((c : ℕ) : ZMod n)) +
          m • ((0 : ZMod n), ((f : ℕ) : ZMod n)) := by
      refine Prod.ext ?_ ?_
      · show ((k * (e : ℕ) : ℤ) : ZMod n) =
            k • ((e : ℕ) : ZMod n) + m • (0 : ZMod n)
        rw [smul_zero, add_zero, zsmul_eq_mul]
        push_cast
        ring
      · show ((k * (c : ℕ) + m * (f : ℕ) : ℤ) : ZMod n) =
            k • ((c : ℕ) : ZMod n) + m • ((f : ℕ) : ZMod n)
        rw [zsmul_eq_mul, zsmul_eq_mul]
        push_cast
        ring
    rw [h_pair_eq]
    exact H.add_mem (H.zsmul_mem h_ec_mem k) (H.zsmul_mem h_0f_mem m)
  have hp_G : (((k * (e : ℕ) : ℤ) : ℝ) / n,
      ((k * (c : ℕ) + m * (f : ℕ) : ℤ) : ℝ) / n) ∈ G :=
    (h_bridge _ _).mpr hp_H
  -- The caught point lies in the missed rectangle: contradiction.
  apply h_miss
  refine ⟨(((k * (e : ℕ) : ℤ) : ℝ) / n,
    ((k * (c : ℕ) + m * (f : ℕ) : ℤ) : ℝ) / n), hp_G, ?_⟩
  refine ⟨Int.fract_nonneg _, ?_, Int.fract_nonneg _, ?_⟩
  · -- x-window
    have h_x_eq : ((k * (e : ℕ) : ℤ) : ℝ) / n = 0 + (k : ℝ) * ((e : ℝ) / n) := by
      push_cast
      ring
    show Int.fract (((k * (e : ℕ) : ℤ) : ℝ) / n - x₁) ≤ α
    rw [h_x_eq]
    exact hk
  · -- y-window
    have h_y_eq : ((k * (c : ℕ) + m * (f : ℕ) : ℤ) : ℝ) / n =
        (k : ℝ) * c / n + (m : ℝ) * ((f : ℝ) / n) := by
      push_cast
      ring
    show Int.fract (((k * (c : ℕ) + m * (f : ℕ) : ℤ) : ℝ) / n - x₂) ≤ β
    rw [h_y_eq]
    exact hm

/-- **Horizontal-axis case of the rectangle-minimal bound (`j = 0`).**

    Mirror image of `bhk_rectangle_minimal_vertical_axis`: if `(i, 0)`
    (with `i ≠ 0`, `|i| ≤ αn`) reduces into `G` and is minimal, and `G`
    misses some `α × β` rectangle, then `β·|i| < 1`. -/
lemma bhk_rectangle_minimal_horizontal_axis
    (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (hG_lift : IsBHKLift G n)
    (α β : ℝ) (hα' : α < 1) (hβ' : β < 1)
    (i : ℤ) (hi : i ≠ 0)
    (hi_box : |(i : ℝ)| ≤ α * n)
    (hij_in_G : ((i : ℝ) / n, (((0 : ℤ)) : ℝ) / n) ∈ G)
    (hij_minimal : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ℝ) / n, (j₀ : ℝ) / n) ∈ G →
      (i, (0 : ℤ)) ≠ (k * i₀, k * j₀))
    (h_misses : ∃ x₁ x₂, ¬ (G ∩ bhkRectangle x₁ x₂ α β).Nonempty) :
    β * |(i : ℝ)| < 1 := by
  by_contra h_ge
  push_neg at h_ge
  obtain ⟨x₁, x₂, h_miss⟩ := h_misses
  haveI : NeZero n := ⟨by omega⟩
  have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
  obtain ⟨H, hH_card, hG_iff⟩ := hG_lift
  have h_bridge := bhk_lift_int_mem_iff G n hn H hG_iff
  obtain ⟨e, f, c, he_pos, hf_pos, hef, h_ce_mem, h_f0_mem, h_gen⟩ :=
    bhk_subgroup_row_structure n hn H hH_card
  have he_pos_R : (0 : ℝ) < e := by exact_mod_cast he_pos
  have hf_pos_R : (0 : ℝ) < f := by exact_mod_cast hf_pos
  have hef_R : (e : ℝ) * f = n := by exact_mod_cast hef
  -- (i, 0) reduces into H.
  have hi_H : ((i : ZMod n), ((0 : ℤ) : ZMod n)) ∈ H := (h_bridge i 0).mp hij_in_G
  -- f ∣ i (i lies in the row kernel, generated by f).
  have h_f_dvd : ((f : ℕ) : ℤ) ∣ i := by
    have h_zm : (i : ZMod n) ∈ AddSubgroup.zmultiples (((f : ℕ) : ℕ) : ZMod n) := by
      apply h_gen
      have h0 : ((0 : ℤ) : ZMod n) = (0 : ZMod n) := by push_cast; ring
      rwa [h0] at hi_H
    rw [AddSubgroup.mem_zmultiples_iff] at h_zm
    obtain ⟨m, hm⟩ := h_zm
    have h_zero : ((i - m * (f : ℕ) : ℤ) : ZMod n) = 0 := by
      push_cast
      rw [show ((i : ZMod n) : ZMod n) = m • ((f : ℕ) : ZMod n) from hm.symm,
          zsmul_eq_mul]
      ring
    have h_n_dvd : (n : ℤ) ∣ (i - m * (f : ℕ)) :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp h_zero
    obtain ⟨t, ht⟩ := h_n_dvd
    refine ⟨m + (e : ℤ) * t, ?_⟩
    have hef_Z : ((e : ℕ) : ℤ) * ((f : ℕ) : ℤ) = (n : ℤ) := by exact_mod_cast hef
    have h_i_eq : i = m * (f : ℕ) + (n : ℤ) * t := by linarith [ht]
    rw [h_i_eq, ← hef_Z]
    ring
  -- Minimality forces |i| = f.
  have h_abs_i : i.natAbs = f := by
    obtain ⟨q, hq⟩ := h_f_dvd
    have hq_ne : q ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at hq
      exact hi hq
    by_contra h_ne
    have h_natAbs_eq : i.natAbs = f * q.natAbs := by
      rw [hq, Int.natAbs_mul, Int.natAbs_natCast]
    have h_q_ge_2 : 2 ≤ q.natAbs := by
      have h1 : q.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hq_ne
      have h2 : q.natAbs ≠ 1 := by
        intro h1'
        rw [h1', mul_one] at h_natAbs_eq
        exact h_ne h_natAbs_eq
      omega
    rcases lt_or_gt_of_ne hq_ne with h_neg | h_pos
    · -- q < 0: (i, 0) = ((-q)·(-f), (-q)·0) violates minimality.
      have h_negf0_G : (((-(f : ℕ) : ℤ) : ℝ) / n, (((0 : ℤ)) : ℝ) / n) ∈ G := by
        apply (h_bridge (-(f : ℕ)) 0).mpr
        have h_negf : ((-(f : ℕ) : ℤ) : ZMod n) = -((f : ℕ) : ZMod n) := by
          push_cast; ring
        have h0 : ((0 : ℤ) : ZMod n) = (0 : ZMod n) := by push_cast; ring
        rw [h_negf, h0]
        have := H.neg_mem h_f0_mem
        simpa using this
      have h_k_gt : (1 : ℤ) < -q := by omega
      apply hij_minimal (-(f : ℕ)) 0 (-q) h_k_gt h_negf0_G
      refine Prod.ext ?_ ?_
      · show i = -q * -(f : ℕ)
        rw [hq]; ring
      · simp
    · -- q > 0: (i, 0) = (q·f, q·0) violates minimality.
      have h_f0_G : ((((f : ℕ) : ℤ) : ℝ) / n, (((0 : ℤ)) : ℝ) / n) ∈ G := by
        apply (h_bridge (f : ℕ) 0).mpr
        have h0 : ((0 : ℤ) : ZMod n) = (0 : ZMod n) := by push_cast; ring
        have hf_cast : (((f : ℕ) : ℤ) : ZMod n) = ((f : ℕ) : ZMod n) := by
          push_cast; ring
        rw [h0, hf_cast]
        exact h_f0_mem
      have h_k_gt : (1 : ℤ) < q := by omega
      apply hij_minimal (f : ℕ) 0 q h_k_gt h_f0_G
      refine Prod.ext ?_ ?_
      · show i = q * (f : ℕ)
        rw [hq]; ring
      · simp
  -- Real form: f = |i|.
  have h_f_eq_absi : (f : ℝ) = |(i : ℝ)| := by
    rw [← h_abs_i]
    exact_mod_cast (Int.cast_natAbs (α := ℝ) i)
  -- Density bounds for the two catching steps.
  have h_βf : 1 ≤ β * f := by rw [h_f_eq_absi]; exact h_ge
  have h_en_le : (e : ℝ) / n ≤ β := by
    have h_en : (e : ℝ) / n = 1 / f := by
      rw [← hef_R]
      field_simp
    rw [h_en, div_le_iff₀ hf_pos_R]
    linarith
  have h_fn_le : (f : ℝ) / n ≤ α := by
    rw [div_le_iff₀ hn_pos, h_f_eq_absi]
    exact hi_box
  -- Catch the rectangle: y-step then x-step.
  obtain ⟨m, hm⟩ := bhk_coset_catch 0 ((e : ℝ) / n) x₂ β (by positivity) h_en_le hβ'
  obtain ⟨k, hk⟩ := bhk_coset_catch ((m : ℝ) * c / n) ((f : ℝ) / n) x₁ α
    (by positivity) h_fn_le hα'
  -- The caught point of G.
  have hp_H : (((m * (c : ℕ) + k * (f : ℕ) : ℤ) : ZMod n),
      ((m * (e : ℕ) : ℤ) : ZMod n)) ∈ H := by
    have h_pair_eq :
        (((m * (c : ℕ) + k * (f : ℕ) : ℤ) : ZMod n), ((m * (e : ℕ) : ℤ) : ZMod n)) =
          m • (((c : ℕ) : ZMod n), ((e : ℕ) : ZMod n)) +
          k • (((f : ℕ) : ZMod n), (0 : ZMod n)) := by
      refine Prod.ext ?_ ?_
      · show ((m * (c : ℕ) + k * (f : ℕ) : ℤ) : ZMod n) =
            m • ((c : ℕ) : ZMod n) + k • ((f : ℕ) : ZMod n)
        rw [zsmul_eq_mul, zsmul_eq_mul]
        push_cast
        ring
      · show ((m * (e : ℕ) : ℤ) : ZMod n) =
            m • ((e : ℕ) : ZMod n) + k • (0 : ZMod n)
        rw [smul_zero, add_zero, zsmul_eq_mul]
        push_cast
        ring
    rw [h_pair_eq]
    exact H.add_mem (H.zsmul_mem h_ce_mem m) (H.zsmul_mem h_f0_mem k)
  have hp_G : (((m * (c : ℕ) + k * (f : ℕ) : ℤ) : ℝ) / n,
      ((m * (e : ℕ) : ℤ) : ℝ) / n) ∈ G :=
    (h_bridge _ _).mpr hp_H
  -- The caught point lies in the missed rectangle: contradiction.
  apply h_miss
  refine ⟨(((m * (c : ℕ) + k * (f : ℕ) : ℤ) : ℝ) / n,
    ((m * (e : ℕ) : ℤ) : ℝ) / n), hp_G, ?_⟩
  refine ⟨Int.fract_nonneg _, ?_, Int.fract_nonneg _, ?_⟩
  · -- x-window
    have h_x_eq : ((m * (c : ℕ) + k * (f : ℕ) : ℤ) : ℝ) / n =
        (m : ℝ) * c / n + (k : ℝ) * ((f : ℝ) / n) := by
      push_cast
      ring
    show Int.fract (((m * (c : ℕ) + k * (f : ℕ) : ℤ) : ℝ) / n - x₁) ≤ α
    rw [h_x_eq]
    exact hk
  · -- y-window
    have h_y_eq : ((m * (e : ℕ) : ℤ) : ℝ) / n = 0 + (m : ℝ) * ((e : ℝ) / n) := by
      push_cast
      ring
    show Int.fract (((m * (e : ℕ) : ℤ) : ℝ) / n - x₂) ≤ β
    rw [h_y_eq]
    exact hm

/-- **ℤ-linear combinations of two `H`-pairs reduce into `H`.** -/
lemma bhk_int_comb_mem (n : ℕ) (H : AddSubgroup (ZMod n × ZMod n))
    (p₁ p₂ q₁ q₂ : ℤ)
    (hp : ((p₁ : ZMod n), (p₂ : ZMod n)) ∈ H)
    (hq : ((q₁ : ZMod n), (q₂ : ZMod n)) ∈ H) (A B : ℤ) :
    (((A * p₁ + B * q₁ : ℤ) : ZMod n), ((A * p₂ + B * q₂ : ℤ) : ZMod n)) ∈ H := by
  have h_pair :
      (((A * p₁ + B * q₁ : ℤ) : ZMod n), ((A * p₂ + B * q₂ : ℤ) : ZMod n)) =
        A • ((p₁ : ZMod n), (p₂ : ZMod n)) + B • ((q₁ : ZMod n), (q₂ : ZMod n)) := by
    refine Prod.ext ?_ ?_
    · show ((A * p₁ + B * q₁ : ℤ) : ZMod n) = A • (p₁ : ZMod n) + B • (q₁ : ZMod n)
      rw [zsmul_eq_mul, zsmul_eq_mul]
      push_cast
      ring
    · show ((A * p₂ + B * q₂ : ℤ) : ZMod n) = A • (p₂ : ZMod n) + B • (q₂ : ZMod n)
      rw [zsmul_eq_mul, zsmul_eq_mul]
      push_cast
      ring
  rw [h_pair]
  exact H.add_mem (H.zsmul_mem hp A) (H.zsmul_mem hq B)

/-- **From `(x : ZMod n) ∈ ⟨g⟩` with `g ∣ n`, conclude `g ∣ x` over ℤ.** -/
lemma bhk_zmultiples_int_dvd (n : ℕ) (hn : 0 < n) (g : ℕ)
    (hg_dvd : (g : ℤ) ∣ (n : ℤ)) (x : ℤ)
    (hx : (x : ZMod n) ∈ AddSubgroup.zmultiples ((g : ℕ) : ZMod n)) :
    (g : ℤ) ∣ x := by
  haveI : NeZero n := ⟨hn.ne'⟩
  rw [AddSubgroup.mem_zmultiples_iff] at hx
  obtain ⟨m, hm⟩ := hx
  have h_zero : ((x - m * (g : ℕ) : ℤ) : ZMod n) = 0 := by
    push_cast
    rw [show ((x : ZMod n) : ZMod n) = m • ((g : ℕ) : ZMod n) from hm.symm,
        zsmul_eq_mul]
    ring
  have h_n_dvd : (n : ℤ) ∣ (x - m * (g : ℕ)) :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp h_zero
  obtain ⟨t, ht⟩ := h_n_dvd
  obtain ⟨w, hw⟩ := hg_dvd
  refine ⟨m + w * t, ?_⟩
  have h_x_eq : x = m * (g : ℕ) + (n : ℤ) * t := by linarith [ht]
  rw [h_x_eq, hw]
  ring

/-- **Integer basis decomposition for an `H`-pair.** Given the column
    structure data `(e, c)`, `(0, f)` of `H` with the generator
    properties, every integer pair reducing into `H` decomposes as
    `(u, v) = k·(e, c) + l·(0, f)` over ℤ — i.e. the two column
    generators form a ℤ-basis of the lifted lattice. -/
lemma bhk_int_pair_basis (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n))
    (e f c : ℕ) (he_pos : 0 < e) (hf_pos : 0 < f) (hef : e * f = n)
    (h_ec_mem : (((e : ℕ) : ZMod n), ((c : ℕ) : ZMod n)) ∈ H)
    (h_kergen : ∀ y : ZMod n, ((0 : ZMod n), y) ∈ H →
        y ∈ AddSubgroup.zmultiples (((f : ℕ) : ℕ) : ZMod n))
    (h_imggen : ∀ p : ZMod n × ZMod n, p ∈ H →
        p.1 ∈ AddSubgroup.zmultiples (((e : ℕ) : ℕ) : ZMod n))
    (u v : ℤ) (h_uv : ((u : ZMod n), (v : ZMod n)) ∈ H) :
    ∃ k l : ℤ, u = k * e ∧ v = k * c + l * f := by
  haveI : NeZero n := ⟨by omega⟩
  have he_dvd_n : ((e : ℕ) : ℤ) ∣ (n : ℤ) := ⟨(f : ℤ), by exact_mod_cast hef.symm⟩
  have hf_dvd_n : ((f : ℕ) : ℤ) ∣ (n : ℤ) := ⟨(e : ℤ), by
    have : (f : ℤ) * e = (n : ℤ) := by
      have := hef
      push_cast [← this]
      ring
    exact this.symm⟩
  -- e ∣ u from the image generator property.
  have h_e_dvd : ((e : ℕ) : ℤ) ∣ u :=
    bhk_zmultiples_int_dvd n (by omega) e he_dvd_n u
      (h_imggen ((u : ZMod n), (v : ZMod n)) h_uv)
  obtain ⟨k, hk⟩ := h_e_dvd
  -- (0, v - k·c) reduces into H.
  have h_col : ((0 : ZMod n), ((v - k * c : ℤ) : ZMod n)) ∈ H := by
    have h_comb := bhk_int_comb_mem n H u v (e : ℕ) (c : ℕ)
      h_uv (by push_cast; exact h_ec_mem) 1 (-k)
    have h_fst : ((1 * u + (-k) * (e : ℕ) : ℤ) : ZMod n) = (0 : ZMod n) := by
      rw [show (1 * u + (-k) * (e : ℕ) : ℤ) = u - k * e from by ring, hk]
      push_cast
      ring
    have h_snd : ((1 * v + (-k) * (c : ℕ) : ℤ) : ZMod n) =
        ((v - k * c : ℤ) : ZMod n) := by
      congr 1
      ring
    rwa [h_fst, h_snd] at h_comb
  -- f ∣ (v - k·c) from the kernel generator property.
  have h_f_dvd : ((f : ℕ) : ℤ) ∣ (v - k * c) :=
    bhk_zmultiples_int_dvd n (by omega) f hf_dvd_n (v - k * c)
      (h_kergen _ h_col)
  obtain ⟨l, hl⟩ := h_f_dvd
  exact ⟨k, l, by linarith [hk], by linarith [hl]⟩

set_option maxHeartbeats 1000000 in
/-- **Core case of the rectangle-minimal bound (`i, j > 0`): hit
    construction.** If `(i, j)` (both positive, inside the
    `[αn] × [βn]` box) reduces into `H`, is minimal, and the BHK (12)
    bound *fails* (`n ≤ βn·i + αn·j - 2ij`), then every `α × β`
    rectangle contains a point of the lift.

    Discrete form of BHK's parallel-segment argument (p10): write
    `(i, j) = d·(e, c) + t·(0, f)` in the column basis; minimality says
    exactly `gcd(d, t) = 1`; Bézout yields `B ∈ M` with
    `i·B₂ - j·B₁ = n`, so `{(i, j), B}` is a ℤ-basis of the lattice
    and the parallel lines of BHK are the `b`-fibres `a ↦ a(i,j) + bB`.
    The rectangle hit reduces to a sliding-window overlap (windows of
    lengths `αn` and `i·βn/j`, sliding at step `n/j`), whose
    feasibility is *exactly* the failed (12); two interval catches
    finish. -/
lemma bhk_rectangle_minimal_core_hit (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n)
    (α β : ℝ) (hα' : α < 1) (hβ' : β < 1)
    (i j : ℤ) (hi : 0 < i) (hj : 0 < j)
    (hi_box : (i : ℝ) ≤ α * n) (hj_box : (j : ℝ) ≤ β * n)
    (hij_H : ((i : ZMod n), (j : ZMod n)) ∈ H)
    (hij_min_H : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H → (i, j) ≠ (k * i₀, k * j₀))
    (h12 : (n : ℝ) ≤ β * n * i + α * n * j - 2 * i * j)
    (x₁ x₂ : ℝ) :
    ∃ u v : ℤ, ((u : ZMod n), (v : ZMod n)) ∈ H ∧
      Int.fract ((u : ℝ) / n - x₁) ≤ α ∧ Int.fract ((v : ℝ) / n - x₂) ≤ β := by
  haveI : NeZero n := ⟨by omega⟩
  have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
  have hi_R : (0 : ℝ) < i := by exact_mod_cast hi
  have hj_R : (0 : ℝ) < j := by exact_mod_cast hj
  obtain ⟨e, f, c, he_pos, hf_pos, hef, h_ec_mem, h_0f_mem, h_kergen, h_imggen⟩ :=
    bhk_subgroup_column_structure n hn H hH_card
  have hef_Z : ((e : ℕ) : ℤ) * ((f : ℕ) : ℤ) = (n : ℤ) := by exact_mod_cast hef
  -- ℤ-cast forms of the two generators' memberships.
  have h_ec_Z : ((((e : ℕ) : ℤ) : ZMod n), (((c : ℕ) : ℤ) : ZMod n)) ∈ H := by
    push_cast
    exact h_ec_mem
  have h_0f_Z : ((((0 : ℕ) : ℤ) : ZMod n), (((f : ℕ) : ℤ) : ZMod n)) ∈ H := by
    push_cast
    exact h_0f_mem
  -- Basis decomposition of the minimal point: (i, j) = d·(e, c) + t·(0, f).
  obtain ⟨d, t, hd_eq, ht_eq⟩ := bhk_int_pair_basis n hn H e f c he_pos hf_pos hef
    h_ec_mem h_kergen h_imggen i j hij_H
  have he_Z_pos : (0 : ℤ) < (e : ℕ) := by exact_mod_cast he_pos
  have hd_pos : 0 < d := by
    rcases lt_trichotomy d 0 with h | h | h
    · nlinarith [hd_eq]
    · rw [h, zero_mul] at hd_eq
      omega
    · exact h
  -- Minimality in basis coordinates is coprimality.
  have h_gcd : Int.gcd d t = 1 := by
    by_contra h_ne
    have hg_ne : Int.gcd d t ≠ 0 := by
      rw [Ne, Int.gcd_eq_zero_iff]
      rintro ⟨h0, -⟩
      omega
    have hg_ge_2 : 2 ≤ Int.gcd d t := by omega
    obtain ⟨d', hd'⟩ := Int.gcd_dvd_left (a := d) (b := t)
    obtain ⟨t', ht'⟩ := Int.gcd_dvd_right (a := d) (b := t)
    have h_cand := bhk_int_comb_mem n H ((e : ℕ) : ℤ) ((c : ℕ) : ℤ)
      ((0 : ℕ) : ℤ) ((f : ℕ) : ℤ) h_ec_Z h_0f_Z d' t'
    apply hij_min_H (d' * (e : ℕ)) (d' * (c : ℕ) + t' * (f : ℕ))
      (Int.gcd d t) (by exact_mod_cast hg_ge_2) (by
        have h_fst : (d' * ((e : ℕ) : ℤ) + t' * ((0 : ℕ) : ℤ) : ℤ) =
            d' * (e : ℕ) := by push_cast; ring
        rwa [h_fst] at h_cand)
    refine Prod.ext ?_ ?_
    · show i = (Int.gcd d t : ℤ) * (d' * (e : ℕ))
      linear_combination hd_eq + ((e : ℕ) : ℤ) * hd'
    · show j = (Int.gcd d t : ℤ) * (d' * (c : ℕ) + t' * (f : ℕ))
      linear_combination ht_eq + ((c : ℕ) : ℤ) * hd' + ((f : ℕ) : ℤ) * ht'
  -- Bézout: ν·d - μ·t = 1.
  obtain ⟨ν, μ', h_bez⟩ := (Int.isCoprime_iff_gcd_eq_one.mpr h_gcd)
  set μ : ℤ := -μ' with hμ_def
  have h_unim : d * ν - t * μ = 1 := by
    rw [hμ_def]
    linarith [h_bez]
  -- The Bézout companion point B with i·B₂ - j·B₁ = n.
  set B₁ : ℤ := μ * (e : ℕ) with hB₁_def
  set B₂ : ℤ := μ * (c : ℕ) + ν * (f : ℕ) with hB₂_def
  have hB_mem : ((B₁ : ZMod n), (B₂ : ZMod n)) ∈ H := by
    have h_comb := bhk_int_comb_mem n H ((e : ℕ) : ℤ) ((c : ℕ) : ℤ)
      ((0 : ℕ) : ℤ) ((f : ℕ) : ℤ) h_ec_Z h_0f_Z μ ν
    have h_fst : (μ * ((e : ℕ) : ℤ) + ν * ((0 : ℕ) : ℤ) : ℤ) = B₁ := by
      rw [hB₁_def]
      all_goals push_cast; ring
    have h_snd : (μ * ((c : ℕ) : ℤ) + ν * ((f : ℕ) : ℤ) : ℤ) = B₂ := by
      rw [hB₂_def]
      all_goals push_cast; ring
    rwa [h_fst, h_snd] at h_comb
  have h_det : i * B₂ - j * B₁ = (n : ℤ) := by
    have h_expand : i * B₂ - j * B₁ =
        (((e : ℕ) : ℤ) * ((f : ℕ) : ℤ)) * (d * ν - t * μ) := by
      rw [hd_eq, ht_eq, hB₁_def, hB₂_def]
      ring
    rw [h_expand, h_unim, mul_one, hef_Z]
  -- ===== Sliding-window selection of the line index b =====
  -- Window 1: u ∈ [n·x₁, n·x₁ + αn].  Window 2 (line b): u such that
  -- the line height lands in the y-window — slides at step n/j.
  have h_sL : (n : ℝ) / j ≤ (α * n + (i : ℝ) * (β * n) / j - 2 * i) := by
    rw [div_le_iff₀ hj_R]
    have h_expand : (α * n + (i : ℝ) * (β * n) / j - 2 * i) * j =
        α * n * j + i * (β * n) - 2 * i * j := by
      field_simp
      try ring
    rw [h_expand]
    linarith [h12]
  obtain ⟨kb, hkb₁, hkb₂⟩ := bhk_interval_catch
    ((i : ℝ) * (n * x₂) / j - n * x₁) ((n : ℝ) / j)
    ((i : ℝ) - (i : ℝ) * (β * n) / j)
    (α * n + (i : ℝ) * (β * n) / j - 2 * i)
    (by positivity) h_sL
  set b : ℤ := -kb with hb_def
  set y : ℝ := (i : ℝ) * (n * x₂) / j - n * x₁ + (kb : ℝ) * ((n : ℝ) / j)
    with hy_def
  -- y-range: i - i·βn/j ≤ y ≤ αn - i.
  have hy_lo : (i : ℝ) - (i : ℝ) * (β * n) / j ≤ y := hkb₁
  have hy_hi : y ≤ α * n - (i : ℝ) := by
    linarith [hkb₂]
  -- The window-2 left endpoint P, and its product identity P·j = i·n·x₂ - b·n.
  set P : ℝ := y + n * x₁ with hP_def
  have hP_j : P * j = (i : ℝ) * (n * x₂) - (b : ℝ) * n := by
    rw [hP_def, hy_def, hb_def]
    push_cast
    field_simp
    ring
  -- ===== Catch u inside the overlap =====
  set cc : ℝ := n * x₁ + max 0 y with hcc_def
  obtain ⟨ka, hka₁, hka₂⟩ := bhk_interval_catch
    ((b : ℝ) * (B₁ : ℝ)) (i : ℝ) cc (i : ℝ) hi_R le_rfl
  set u : ℤ := b * B₁ + ka * i with hu_def
  have hu_cast : (u : ℝ) = (b : ℝ) * (B₁ : ℝ) + (ka : ℝ) * i := by
    rw [hu_def]
    push_cast
    ring
  -- u lies in window 1: n·x₁ ≤ u ≤ n·x₁ + αn.
  have hu_w1_lo : n * x₁ ≤ (u : ℝ) := by
    rw [hu_cast]
    have h_max : (0 : ℝ) ≤ max 0 y := le_max_left 0 y
    have : cc ≥ n * x₁ := by rw [hcc_def]; linarith
    linarith [hka₁]
  have hu_w1_hi : (u : ℝ) ≤ n * x₁ + α * n := by
    rw [hu_cast]
    rcases le_total 0 y with hy0 | hy0
    · have h_max : max 0 y = y := max_eq_right hy0
      have hcc_eq : cc = n * x₁ + y := by rw [hcc_def, h_max]
      have := hka₂
      rw [hcc_eq] at this
      linarith [hy_hi]
    · have h_max : max 0 y = 0 := max_eq_left hy0
      have hcc_eq : cc = n * x₁ := by rw [hcc_def, h_max]; ring
      have := hka₂
      rw [hcc_eq] at this
      linarith [hi_box]
  -- u lies in window 2: P ≤ u ≤ P + i·βn/j.
  have hu_w2_lo : P ≤ (u : ℝ) := by
    rw [hu_cast, hP_def]
    rcases le_total 0 y with hy0 | hy0
    · have h_max : max 0 y = y := max_eq_right hy0
      have hcc_eq : cc = n * x₁ + y := by rw [hcc_def, h_max]
      have := hka₁
      rw [hcc_eq] at this
      linarith
    · have h_max : max 0 y = 0 := max_eq_left hy0
      have hcc_eq : cc = n * x₁ := by rw [hcc_def, h_max]; ring
      have := hka₁
      rw [hcc_eq] at this
      linarith
  have hu_w2_hi : (u : ℝ) ≤ P + (i : ℝ) * (β * n) / j := by
    rw [hu_cast, hP_def]
    have h_ij_le : (i : ℝ) ≤ (i : ℝ) * (β * n) / j := by
      rw [le_div_iff₀ hj_R]
      nlinarith [hj_box, hi_R.le]
    rcases le_total 0 y with hy0 | hy0
    · have h_max : max 0 y = y := max_eq_right hy0
      have hcc_eq : cc = n * x₁ + y := by rw [hcc_def, h_max]
      have := hka₂
      rw [hcc_eq] at this
      linarith
    · have h_max : max 0 y = 0 := max_eq_left hy0
      have hcc_eq : cc = n * x₁ := by rw [hcc_def, h_max]; ring
      have := hka₂
      rw [hcc_eq] at this
      linarith [hy_lo]
  -- ===== Assemble the hit point =====
  set v : ℤ := b * B₂ + ka * j with hv_def
  have h_iv : i * v = b * (n : ℤ) + u * j := by
    rw [hv_def, hu_def]
    linear_combination b * h_det
  -- y-window for v: n·x₂ ≤ v ≤ n·x₂ + βn.
  have h_uj_lo : (i : ℝ) * (n * x₂) ≤ (b : ℝ) * n + (u : ℝ) * j := by
    have h1 := mul_le_mul_of_nonneg_right hu_w2_lo hj_R.le
    rw [hP_j] at h1
    linarith
  have h_uj_hi : (b : ℝ) * n + (u : ℝ) * j ≤ (i : ℝ) * (n * x₂) + (i : ℝ) * (β * n) := by
    have h1 := mul_le_mul_of_nonneg_right hu_w2_hi hj_R.le
    rw [add_mul, hP_j, div_mul_cancel₀ _ hj_R.ne'] at h1
    linarith
  have h_iv_R : (i : ℝ) * (v : ℝ) = (b : ℝ) * n + (u : ℝ) * j := by
    exact_mod_cast congrArg (Int.cast : ℤ → ℝ) h_iv
  have hv_lo : n * x₂ ≤ (v : ℝ) := by
    have h1 : (i : ℝ) * (n * x₂) ≤ (i : ℝ) * (v : ℝ) := by rw [h_iv_R]; linarith
    exact le_of_mul_le_mul_left h1 hi_R
  have hv_hi : (v : ℝ) ≤ n * x₂ + β * n := by
    have h1 : (i : ℝ) * (v : ℝ) ≤ (i : ℝ) * (n * x₂ + β * n) := by
      rw [h_iv_R, mul_add]
      linarith
    exact le_of_mul_le_mul_left h1 hi_R
  -- Membership of (u, v).
  have h_uv_mem : ((u : ZMod n), (v : ZMod n)) ∈ H := by
    have h_comb := bhk_int_comb_mem n H B₁ B₂ i j hB_mem hij_H b ka
    have h_fst : (b * B₁ + ka * i : ℤ) = u := by rw [hu_def]
    have h_snd : (b * B₂ + ka * j : ℤ) = v := by rw [hv_def]
    rwa [h_fst, h_snd] at h_comb
  -- α, β are positive (from the box and positivity of i, j).
  have hα_pos : (0 : ℝ) < α := by nlinarith [hi_box, hi_R, hn_pos]
  have hβ_pos : (0 : ℝ) < β := by nlinarith [hj_box, hj_R, hn_pos]
  -- The fract conditions.
  refine ⟨u, v, h_uv_mem, ?_, ?_⟩
  · have h_arg : (u : ℝ) / n - x₁ = ((u : ℝ) - n * x₁) / n := by
      field_simp
    rw [h_arg]
    have h_in : 0 ≤ ((u : ℝ) - n * x₁) / n ∧ ((u : ℝ) - n * x₁) / n ≤ α := by
      constructor
      · apply div_nonneg _ hn_pos.le
        linarith
      · rw [div_le_iff₀ hn_pos]
        linarith [hu_w1_hi]
    rw [Int.fract_eq_self.mpr ⟨h_in.1, lt_of_le_of_lt h_in.2 hα'⟩]
    exact h_in.2
  · have h_arg : (v : ℝ) / n - x₂ = ((v : ℝ) - n * x₂) / n := by
      field_simp
    rw [h_arg]
    have h_in : 0 ≤ ((v : ℝ) - n * x₂) / n ∧ ((v : ℝ) - n * x₂) / n ≤ β := by
      constructor
      · apply div_nonneg _ hn_pos.le
        linarith
      · rw [div_le_iff₀ hn_pos]
        linarith [hv_hi]
    rw [Int.fract_eq_self.mpr ⟨h_in.1, lt_of_le_of_lt h_in.2 hβ'⟩]
    exact h_in.2

/-- **Fract reflection.** If the fractional position of `w` relative to
    the reflected target `-x - γ` is within `γ`, then the fractional
    position of `-w` relative to `x` is within `γ`. Pure `Int.fract`
    algebra: transports a rectangle hit through the coordinate
    reflection `w ↦ -w`. -/
lemma bhk_fract_reflect (w x γ : ℝ) (hγ : 0 ≤ γ) (hγ' : γ < 1)
    (h : Int.fract (w - (-x - γ)) ≤ γ) : Int.fract (-w - x) ≤ γ := by
  have hs0 : 0 ≤ Int.fract (w + x + γ) := Int.fract_nonneg _
  have hsγ : Int.fract (w + x + γ) ≤ γ := by
    have harg : w - (-x - γ) = w + x + γ := by ring
    rwa [harg] at h
  have hfr : Int.fract (w + x + γ) = (w + x + γ) - (⌊w + x + γ⌋ : ℤ) := rfl
  have hkey : -w - x =
      (γ - Int.fract (w + x + γ)) - ((⌊w + x + γ⌋ : ℤ) : ℝ) := by
    rw [hfr]
    ring
  rw [hkey, Int.fract_sub_intCast,
    Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩]
  linarith

/-- **Sign handling for the core hit, step 1: `i > 0`, `j ≠ 0`.**

    The case `j < 0` is transported through the `y`-reflection
    automorphism `σ : (x, y) ↦ (x, -y)` of `(ZMod n)²`: the reflected
    subgroup `H' = σ(H)` has the same order, `(i, -j)` lies in `H'`
    positively and minimally, and a hit for `H'` at the reflected
    target `(x₁, -x₂ - β)` reflects back to a hit for `H` at
    `(x₁, x₂)` via `bhk_fract_reflect`. -/
lemma bhk_rectangle_minimal_core_hit_pos_i (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n)
    (α β : ℝ) (hα' : α < 1) (hβ : 0 ≤ β) (hβ' : β < 1)
    (i j : ℤ) (hi : 0 < i) (hj : j ≠ 0)
    (hi_box : (i : ℝ) ≤ α * n) (hj_box : |(j : ℝ)| ≤ β * n)
    (hij_H : ((i : ZMod n), (j : ZMod n)) ∈ H)
    (hij_min_H : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H → (i, j) ≠ (k * i₀, k * j₀))
    (h12 : (n : ℝ) ≤ β * n * i + α * n * |(j : ℝ)| - 2 * i * |(j : ℝ)|)
    (x₁ x₂ : ℝ) :
    ∃ u v : ℤ, ((u : ZMod n), (v : ZMod n)) ∈ H ∧
      Int.fract ((u : ℝ) / n - x₁) ≤ α ∧ Int.fract ((v : ℝ) / n - x₂) ≤ β := by
  rcases lt_or_gt_of_ne hj with hj_neg | hj_pos
  · -- j < 0: reflect the second coordinate.
    set σ : (ZMod n × ZMod n) ≃+ (ZMod n × ZMod n) :=
      (AddEquiv.refl (ZMod n)).prodCongr (AddEquiv.neg (ZMod n)) with hσ_def
    set H' : AddSubgroup (ZMod n × ZMod n) := H.map σ.toAddMonoidHom with hH'_def
    -- Membership characterisation of H' on integer casts.
    have h_mem' : ∀ u v : ℤ, ((u : ZMod n), (v : ZMod n)) ∈ H' ↔
        ((u : ZMod n), ((-v : ℤ) : ZMod n)) ∈ H := by
      intro u v
      have hcast : ((-v : ℤ) : ZMod n) = -((v : ℤ) : ZMod n) := by
        push_cast; ring
      rw [hH'_def, AddSubgroup.mem_map_equiv, hcast]
      rfl
    have hH'_card : Nat.card H' = n := by
      have hcongr : Nat.card (H.map σ.toAddMonoidHom) = Nat.card H :=
        (Nat.card_congr
          (AddSubgroup.equivMapOfInjective H σ.toAddMonoidHom σ.injective).toEquiv).symm
      rw [hH'_def]
      exact hcongr.trans hH_card
    -- (i, -j) ∈ H', positively.
    have hij_H' : ((i : ZMod n), ((-j : ℤ) : ZMod n)) ∈ H' := by
      rw [h_mem' i (-j)]
      simpa using hij_H
    -- Minimality transports through the reflection.
    have hij_min' : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
        ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H' → (i, -j) ≠ (k * i₀, k * j₀) := by
      intro i₀ j₀ k hk h₀ h_eq
      have h₀H : ((i₀ : ZMod n), ((-j₀ : ℤ) : ZMod n)) ∈ H := (h_mem' i₀ j₀).mp h₀
      apply hij_min_H i₀ (-j₀) k hk h₀H
      have h1 : i = k * i₀ := congrArg Prod.fst h_eq
      have h2 : -j = k * j₀ := congrArg Prod.snd h_eq
      refine Prod.ext h1 ?_
      show j = k * -j₀
      linear_combination -h2
    have habs : |(j : ℝ)| = -(j : ℝ) := abs_of_neg (by exact_mod_cast hj_neg)
    -- Core hit for H' at the reflected target.
    obtain ⟨u, v, h_uv', hu, hv⟩ := bhk_rectangle_minimal_core_hit n hn H' hH'_card
      α β hα' hβ' i (-j) hi (by omega)
      hi_box (by push_cast; linarith [hj_box, habs.symm.le, habs.le])
      hij_H' hij_min'
      (by push_cast; rw [habs] at h12; linarith) x₁ (-x₂ - β)
    -- Reflect the hit back.
    refine ⟨u, -v, (h_mem' u v).mp h_uv', hu, ?_⟩
    have harg : (((-v : ℤ) : ℝ)) / n - x₂ = -((v : ℝ) / n) - x₂ := by
      push_cast; ring
    rw [harg]
    exact bhk_fract_reflect ((v : ℝ) / n) x₂ β hβ hβ' hv
  · -- j > 0: direct.
    have habs : |(j : ℝ)| = (j : ℝ) := abs_of_pos (by exact_mod_cast hj_pos)
    exact bhk_rectangle_minimal_core_hit n hn H hH_card α β hα' hβ' i j hi hj_pos
      hi_box (habs ▸ hj_box) hij_H hij_min_H (habs ▸ h12) x₁ x₂

/-- **Sign handling for the core hit, step 2: `i ≠ 0`, `j ≠ 0`.**

    The case `i < 0` is handled by negating the point: `(-i, -j) ∈ H`
    with `-i > 0`, minimality and the box/(12) data transport (all are
    stated in `|i|`, `|j|` form) — and the conclusion does not mention
    `(i, j)`, so the hit needs no transport at all. -/
lemma bhk_rectangle_minimal_core_hit_signed (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n)
    (α β : ℝ) (hα' : α < 1) (hβ : 0 ≤ β) (hβ' : β < 1)
    (i j : ℤ) (hi : i ≠ 0) (hj : j ≠ 0)
    (hi_box : |(i : ℝ)| ≤ α * n) (hj_box : |(j : ℝ)| ≤ β * n)
    (hij_H : ((i : ZMod n), (j : ZMod n)) ∈ H)
    (hij_min_H : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H → (i, j) ≠ (k * i₀, k * j₀))
    (h12 : (n : ℝ) ≤ β * n * |(i : ℝ)| + α * n * |(j : ℝ)| -
      2 * |(i : ℝ)| * |(j : ℝ)|)
    (x₁ x₂ : ℝ) :
    ∃ u v : ℤ, ((u : ZMod n), (v : ZMod n)) ∈ H ∧
      Int.fract ((u : ℝ) / n - x₁) ≤ α ∧ Int.fract ((v : ℝ) / n - x₂) ≤ β := by
  rcases lt_or_gt_of_ne hi with hi_neg | hi_pos
  · -- i < 0: negate the point inside the same H.
    have habs_i : |(i : ℝ)| = -(i : ℝ) := abs_of_neg (by exact_mod_cast hi_neg)
    have h_neg_mem : (((-i : ℤ) : ZMod n), ((-j : ℤ) : ZMod n)) ∈ H := by
      push_cast
      simpa using H.neg_mem hij_H
    have h_neg_min : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
        ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H → (-i, -j) ≠ (k * i₀, k * j₀) := by
      intro i₀ j₀ k hk h₀ h_eq
      have h₀' : (((-i₀ : ℤ) : ZMod n), ((-j₀ : ℤ) : ZMod n)) ∈ H := by
        push_cast
        simpa using H.neg_mem h₀
      apply hij_min_H (-i₀) (-j₀) k hk h₀'
      have h1 : -i = k * i₀ := congrArg Prod.fst h_eq
      have h2 : -j = k * j₀ := congrArg Prod.snd h_eq
      refine Prod.ext ?_ ?_
      · show i = k * -i₀
        linear_combination -h1
      · show j = k * -j₀
        linear_combination -h2
    have habs_negi : ((-i : ℤ) : ℝ) = |(i : ℝ)| := by
      push_cast
      rw [habs_i]
    have habs_negj : |((-j : ℤ) : ℝ)| = |(j : ℝ)| := by
      push_cast
      rw [abs_neg]
    exact bhk_rectangle_minimal_core_hit_pos_i n hn H hH_card α β hα' hβ hβ'
      (-i) (-j) (by omega) (by omega)
      (habs_negi ▸ hi_box) (habs_negj ▸ hj_box)
      h_neg_mem h_neg_min
      (by rw [habs_negi, habs_negj]; exact h12) x₁ x₂
  · -- i > 0: feed directly.
    have habs_i : |(i : ℝ)| = (i : ℝ) := abs_of_pos (by exact_mod_cast hi_pos)
    exact bhk_rectangle_minimal_core_hit_pos_i n hn H hH_card α β hα' hβ hβ'
      i j hi_pos hj
      (habs_i ▸ hi_box) hj_box hij_H hij_min_H (habs_i ▸ h12) x₁ x₂

/-- **BHK Main Lemma — rectangle-missing implies (12) for minimal (i,j).**

    If `G` misses some `α × β` rectangle `R` in `T`, then any *minimal*
    nonzero lattice point `(i,j) ∈ K ∩ ℤ²` with `(i/n, j/n) ∈ G` and
    `(i, j) ∈ [-αn, αn] × [-βn, βn]` satisfies
    `β|i| + α|j| - (2/n)|i||j| < 1`.

    Proof (BHK p9–10): split on whether `i = 0`, `j = 0`, or `i, j > 0`.

    * `i = 0`: `G` is `n/j` equidistant points on `j` vertical circles,
      separated horizontally by `1/j ≤ α`. The internal point spacing
      `j/n` would have to exceed `β` (else `G` hits any vertical strip),
      i.e. `α|j| < α·βn = β·n·α ≤ β·j` — gives (12).
    * `j = 0`: symmetric.
    * `i, j > 0`: circle `L_g` generated by `g = (i/n, j/n)` has period
      `i/n`. The family `ℒ` of equally-spaced segments parallel to
      `L_g` cross the rectangle's left edge `{x_1} × [x_2, x_2+β]` at
      `i` equally distributed points; if none falls in the y-range,
      `β - j(2i - αn)/(in) < 1/i`, equivalent to (12).

    **Status:** fully proved. The axis cases `i = 0` and `j = 0` go
    through `bhk_rectangle_minimal_vertical_axis` /
    `bhk_rectangle_minimal_horizontal_axis` (column/row structure of
    `H` and coset catching). The `i ≠ 0 ∧ j ≠ 0` core goes through
    `bhk_rectangle_minimal_core_hit_signed`, the discrete
    sliding-window form of the line-segment family argument, with
    signs handled by point negation and the `y`-reflection
    automorphism of `(ZMod n)²`. -/
theorem bhk_main_lemma_rectangle_minimal
    (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (hG_lift : IsBHKLift G n)
    (α β : ℝ) (hα : 0 < α) (hα' : α < 1) (hβ : 0 < β) (hβ' : β < 1)
    (i j : ℤ) (hij : (i, j) ≠ (0, 0))
    (hij_in_box : (|(i : ℝ)| ≤ α * n) ∧ (|(j : ℝ)| ≤ β * n))
    (hij_in_G : ((i : ℝ) / n, (j : ℝ) / n) ∈ G)
    (hij_minimal : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ℝ) / n, (j₀ : ℝ) / n) ∈ G →
      (i, j) ≠ (k * i₀, k * j₀))
    (h_misses : ∃ x₁ x₂, ¬ (G ∩ bhkRectangle x₁ x₂ α β).Nonempty) :
    β * |(i : ℝ)| + α * |(j : ℝ)| - 2 / n * |(i : ℝ)| * |(j : ℝ)| < 1 := by
  by_cases hi0 : i = 0
  · -- i = 0: the bound reduces to α·|j| < 1.
    have hj0 : j ≠ 0 := by
      intro hj0
      exact hij (by rw [hi0, hj0])
    subst hi0
    have h_axis := bhk_rectangle_minimal_vertical_axis G n hn hG_lift α β hα' hβ'
      j hj0 hij_in_box.2 hij_in_G hij_minimal h_misses
    simp only [Int.cast_zero, abs_zero, mul_zero, zero_mul, sub_zero, zero_add]
    linarith
  by_cases hj0 : j = 0
  · -- j = 0: the bound reduces to β·|i| < 1.
    subst hj0
    have h_axis := bhk_rectangle_minimal_horizontal_axis G n hn hG_lift α β hα' hβ'
      i hi0 hij_in_box.1 hij_in_G hij_minimal h_misses
    simp only [Int.cast_zero, abs_zero, mul_zero, zero_mul, sub_zero, add_zero]
    linarith
  · -- i ≠ 0 ∧ j ≠ 0: the discrete line-segment family argument
    -- (`bhk_rectangle_minimal_core_hit_signed`): if (12) failed, the
    -- sliding-window construction would hit the missed rectangle.
    by_contra h_ge
    push_neg at h_ge
    obtain ⟨x₁, x₂, h_miss⟩ := h_misses
    haveI : NeZero n := ⟨by omega⟩
    have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
    obtain ⟨H, hH_card, hG_iff⟩ := hG_lift
    have h_bridge := bhk_lift_int_mem_iff G n hn H hG_iff
    have hij_H : ((i : ZMod n), (j : ZMod n)) ∈ H := (h_bridge i j).mp hij_in_G
    have hij_min_H : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
        ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H → (i, j) ≠ (k * i₀, k * j₀) :=
      fun i₀ j₀ k hk h₀ => hij_minimal i₀ j₀ k hk ((h_bridge i₀ j₀).mpr h₀)
    -- ¬(12) in the n-scaled form needed by the core hit.
    have h12 : (n : ℝ) ≤ β * n * |(i : ℝ)| + α * n * |(j : ℝ)| -
        2 * |(i : ℝ)| * |(j : ℝ)| := by
      have hkey := mul_le_mul_of_nonneg_right h_ge hn_pos.le
      have hdiv : 2 / (n : ℝ) * |(i : ℝ)| * |(j : ℝ)| * n =
          2 * |(i : ℝ)| * |(j : ℝ)| := by
        field_simp
      nlinarith [hkey, hdiv]
    obtain ⟨u, v, h_uv, hu, hv⟩ := bhk_rectangle_minimal_core_hit_signed n hn
      H hH_card α β hα' hβ.le hβ' i j hi0 hj0 hij_in_box.1 hij_in_box.2
      hij_H hij_min_H h12 x₁ x₂
    exact h_miss ⟨((u : ℝ) / n, (v : ℝ) / n), (h_bridge u v).mpr h_uv,
      Int.fract_nonneg _, hu, Int.fract_nonneg _, hv⟩

/-! ## Main statement (BHK Main Lemma) -/

/-- **BHK Main Lemma.** Let `G ⊆ ℝ²` be a finite subgroup of `T` of
    order `n > 1`. Let `0 < α, β < 1` with `α · β ≥ 1/n`. Then either
    `G` intersects every `α × β` rectangle, OR there exists a nonzero
    lattice point `(i, j) ∈ ℤ²` with `(i/n, j/n) ∈ G` satisfying
    `β|i| + α|j| - (2/n)|i||j| < 1`.

    Proof: combine `bhk_main_lemma_existence` (Minkowski) with
    `bhk_main_lemma_minimality` (minimal representative) and
    `bhk_main_lemma_rectangle_minimal` (the bound when `G` misses a
    rectangle). -/
theorem bhk_main_lemma
    (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (hG_lift : IsBHKLift G n)
    (α β : ℝ) (hα : 0 < α) (hα' : α < 1) (hβ : 0 < β) (hβ' : β < 1)
    (hαβ : α * β ≥ 1 / (n : ℝ)) :
    (∀ x₁ x₂, (G ∩ bhkRectangle x₁ x₂ α β).Nonempty) ∨
    (∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
      β * |(ij.1 : ℝ)| + α * |(ij.2 : ℝ)| - 2 / n * |(ij.1 : ℝ)| * |(ij.2 : ℝ)| < 1) := by
  -- Classical disjunction: either every rectangle is hit, or some is missed.
  by_cases h_all_hit : ∀ x₁ x₂, (G ∩ bhkRectangle x₁ x₂ α β).Nonempty
  · exact Or.inl h_all_hit
  · refine Or.inr ?_
    push_neg at h_all_hit
    obtain ⟨x₁, x₂, h_miss_eq⟩ := h_all_hit
    have h_miss : ¬ (G ∩ bhkRectangle x₁ x₂ α β).Nonempty := by
      rw [Set.not_nonempty_iff_eq_empty]; exact h_miss_eq
    -- Choose K = [-αn, αn] × [-βn, βn] (the maximum allowed box).
    set K : Set (ℝ × ℝ) :=
      Set.Icc (-(α * n)) (α * n) ×ˢ Set.Icc (-(β * n)) (β * n) with hK_def
    have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
    have hαn_pos : (0 : ℝ) < α * n := mul_pos hα hn_pos
    have hβn_pos : (0 : ℝ) < β * n := mul_pos hβ hn_pos
    -- K is symmetric, convex, compact.
    have hK_sym : ∀ x ∈ K, -x ∈ K := by
      intro x hx
      rw [hK_def] at hx ⊢
      obtain ⟨⟨hL1, hR1⟩, hL2, hR2⟩ := hx
      refine ⟨⟨?_, ?_⟩, ?_, ?_⟩
      · simp; linarith
      · simp; linarith
      · simp; linarith
      · simp; linarith
    have hK_conv : Convex ℝ K := by
      rw [hK_def]; exact (convex_Icc _ _).prod (convex_Icc _ _)
    have hK_compact : IsCompact K := by
      rw [hK_def]; exact (isCompact_Icc).prod isCompact_Icc
    -- Area of K is 4αβn² ≥ 4n (since αβ ≥ 1/n).
    have hK_area : (4 * n : ℝ) ≤ (MeasureTheory.volume K).toReal := by
      rw [hK_def, MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod,
          Real.volume_Icc, Real.volume_Icc]
      have h1 : (α * (n : ℝ) - -(α * (n : ℝ))) = 2 * α * n := by ring
      have h2 : (β * (n : ℝ) - -(β * (n : ℝ))) = 2 * β * n := by ring
      rw [h1, h2,
          ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ 2 * α * n),
          ENNReal.toReal_ofReal (by positivity : (0 : ℝ) ≤ 2 * α * n * (2 * β * n))]
      have hone : (1 : ℝ) ≤ α * β * (n : ℝ) := by
        rw [ge_iff_le, div_le_iff₀ hn_pos] at hαβ
        linarith
      nlinarith [hone, hn_pos, hα, hβ]
    -- Apply existence to find (i,j) ∈ K ∩ ℤ² \ {(0,0)} with (i/n,j/n) ∈ G.
    obtain ⟨ij, hij_ne, hij_K, hij_G⟩ :=
      bhk_main_lemma_existence G n hn hG_lift α β hα hβ K subset_rfl
        hK_sym hK_conv hK_compact hK_area
    have hαn_nn : (0 : ℝ) ≤ α * n := hαn_pos.le
    have hβn_nn : (0 : ℝ) ≤ β * n := hβn_pos.le
    have hij_box : |((ij.1 : ℝ))| ≤ α * n ∧ |((ij.2 : ℝ))| ≤ β * n := by
      have hK1 : ((ij.1 : ℝ), (ij.2 : ℝ)) ∈
                  Icc (-(α * (n : ℝ))) (α * n) ×ˢ Icc (-(β * (n : ℝ))) (β * n) := by
        rw [hK_def] at hij_K; exact hij_K
      rcases hK1 with ⟨⟨hL1, hR1⟩, hL2, hR2⟩
      exact ⟨abs_le.mpr ⟨hL1, hR1⟩, abs_le.mpr ⟨hL2, hR2⟩⟩
    -- Refine to minimal (i,j), preserving box membership.
    obtain ⟨ij', hij'_ne, hij'_G, hij'_α, hij'_β, hij'_min⟩ :=
      bhk_main_lemma_minimality G n hn α β hαn_nn hβn_nn
        ⟨ij, hij_ne, hij_G, hij_box.1, hij_box.2⟩
    have hij'_box : |((ij'.1 : ℝ))| ≤ α * n ∧ |((ij'.2 : ℝ))| ≤ β * n := ⟨hij'_α, hij'_β⟩
    have h_bound := bhk_main_lemma_rectangle_minimal G n hn hG_lift α β
      hα hα' hβ hβ' ij'.1 ij'.2 hij'_ne hij'_box hij'_G hij'_min
      ⟨x₁, x₂, h_miss⟩
    exact ⟨ij', hij'_ne, hij'_G, h_bound⟩

/-! ## Corollary 6 (BHK §3.2)

The applied form of the Main Lemma. The convex polygon `X` is the
region in `ℤ²` bounded by `0 ≤ i < 1/β` and
`-1/α - (β/α)·i < j < 1/α + (β/α)·i`. -/

/-- The BHK Corollary 6 region `X ⊆ ℤ²`. -/
def bhkCor6Region (α β : ℝ) : Set (ℤ × ℤ) :=
  {ij | 0 ≤ ij.1 ∧ (ij.1 : ℝ) < 1 / β ∧
        -1 / α - β / α * ij.1 < (ij.2 : ℝ) ∧
        (ij.2 : ℝ) < 1 / α + β / α * ij.1} \ {(0, 0)}

/-- **Group-theoretic helper for Corollary 6 Case C.**

    Any AddSubgroup `H ⊆ ZMod n × ZMod n` of order `n` (with `n > 1`)
    contains a nonzero element whose second coordinate is `0` or `1`.

    Proof: Consider the homomorphism `f : H → ZMod n` from second
    projection. Two cases:
    * `f` injective: since `|H| = n = |ZMod n|`, `f` is also surjective.
      Pick `h ∈ H` with `f(h) = 1`. Then `h ≠ 0` (else `f(h) = 0 ≠ 1`)
      and `h.2 = 1`.
    * `f` not injective: ∃ `a, b ∈ H` with `a ≠ b` and `f(a) = f(b)`,
      i.e., `a - b ≠ 0` and `f(a - b) = 0`. So `(a - b).2 = 0`. -/
lemma bhk_corollary_6_case_C_helper
    (n : ℕ) (hn : 1 < n) (H : AddSubgroup (ZMod n × ZMod n))
    (hH_card : Nat.card H = n) :
    ∃ ab : ZMod n × ZMod n, ab ∈ H ∧ ab ≠ 0 ∧ (ab.2 = 0 ∨ ab.2 = 1) := by
  haveI : Fact (1 < n) := ⟨hn⟩
  haveI hn_pos : NeZero n := ⟨by omega⟩
  haveI : Finite H := Nat.finite_of_card_ne_zero (by rw [hH_card]; exact hn_pos.out)
  let f : H →+ ZMod n := (AddMonoidHom.snd (ZMod n) (ZMod n)).comp H.subtype
  by_cases hf_inj : Function.Injective f
  · have h_card_eq : Nat.card H = Nat.card (ZMod n) := by
      rw [hH_card, Nat.card_zmod]
    have hf_surj : Function.Surjective f := by
      have hα : Fintype H := Fintype.ofFinite H
      have hβ : Fintype (ZMod n) := Fintype.ofFinite (ZMod n)
      have h_card' : Fintype.card H = Fintype.card (ZMod n) := by
        rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, h_card_eq]
      exact (Fintype.bijective_iff_injective_and_card f).mpr ⟨hf_inj, h_card'⟩ |>.surjective
    obtain ⟨h, h_eq⟩ := hf_surj 1
    refine ⟨h.val, h.property, ?_, Or.inr ?_⟩
    · intro h_zero
      have hh_zero : h = (0 : H) := Subtype.ext h_zero
      rw [hh_zero] at h_eq
      simp [f] at h_eq
    · have := h_eq
      simp [f] at this
      exact this
  · obtain ⟨a, b, hfab, hab⟩ := Function.not_injective_iff.mp hf_inj
    have h_sub_ne : a - b ≠ 0 := sub_ne_zero.mpr hab
    have h_sub_in : (a - b).val ∈ H := (a - b).property
    have h_sub_proj : (a - b).val.2 = 0 := by
      have hk : f (a - b) = 0 := by
        rw [map_sub, hfab, sub_self]
      simpa [f] using hk
    exact ⟨(a - b).val, h_sub_in, fun h => h_sub_ne (Subtype.ext h), Or.inl h_sub_proj⟩

/-- **Small-`i` witness for Corollary 6 (Cases A & B).**

    A nonzero integer pair `(i, j)` reducing into `H`, with `|i| ≤ B` for
    some bound `B` *strictly* below `1/β`, and `|j| ≤ βn`.

    This replaces the closed-box Minkowski step: the closed box
    `[-1/β, 1/β] × [-βn, βn]` has area exactly `4n`, so Minkowski only
    yields the non-strict `|i| ≤ 1/β`, with a genuine boundary case
    `|i| = 1/β` possible when `1/β ∈ ℤ`. BHK (p10) instead take the box
    half-open in `x` and argue "although it is only half-closed, n
    translates of it cannot be disjoint" — a measure-density argument
    that is awkward to formalize. We avoid both via the column structure
    of `H` and Dirichlet's approximation theorem:

    * if `eβ ≥ 1`, the column point `(0, f)` works since `f = n/e ≤ βn`;
    * if `eβ < 1`, Dirichlet with `κ = ⌈1/(βe)⌉ ≥ 2` gives `1 ≤ k ≤ κ-1`
      and `j` with `|k·c - j·f| ≤ f/κ ≤ βn`; the witness is
      `(k·e, k·c - j·f)` with `|k·e| ≤ (κ-1)·e < 1/β`. -/
lemma bhk_corollary_6_small_i_witness (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n)
    (β : ℝ) (hβ : 0 < β) :
    ∃ B : ℝ, 0 ≤ B ∧ B < 1 / β ∧ ∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ZMod n), (ij.2 : ZMod n)) ∈ H ∧
      |(ij.1 : ℝ)| ≤ B ∧ |(ij.2 : ℝ)| ≤ β * n := by
  obtain ⟨e, f, c, he_pos, hf_pos, hef, h_ec_mem, h_0f_mem, -, -⟩ :=
    bhk_subgroup_column_structure n hn H hH_card
  have hn_pos_R : (0 : ℝ) < n := by exact_mod_cast (by omega : 0 < n)
  have he_pos_R : (0 : ℝ) < e := by exact_mod_cast he_pos
  have hf_pos_R : (0 : ℝ) < f := by exact_mod_cast hf_pos
  have hef_R : (e : ℝ) * f = n := by exact_mod_cast hef
  have h_1β_pos : (0 : ℝ) < 1 / β := by positivity
  by_cases h_eβ : 1 ≤ (e : ℝ) * β
  · -- Case `eβ ≥ 1`: vertical witness (0, f), B = 0.
    refine ⟨0, le_refl 0, h_1β_pos, ((0 : ℤ), (f : ℤ)), ?_, ?_, ?_, ?_⟩
    · -- (0, f) ≠ (0, 0)
      intro h_eq
      have h2 : ((f : ℕ) : ℤ) = 0 := congrArg Prod.snd h_eq
      have : f = 0 := by exact_mod_cast h2
      omega
    · -- membership, modulo ℤ-vs-ℕ casts
      have h_fst : (((0 : ℤ) : ZMod n)) = (0 : ZMod n) := by push_cast; ring
      have h_snd : ((((f : ℕ) : ℤ) : ZMod n)) = ((f : ℕ) : ZMod n) := by
        push_cast; ring
      rw [show ((((0 : ℤ), (f : ℤ)) : ℤ × ℤ).1 : ZMod n) = (0 : ZMod n) from h_fst,
          show ((((0 : ℤ), (f : ℤ)) : ℤ × ℤ).2 : ZMod n) = ((f : ℕ) : ZMod n) from h_snd]
      exact h_0f_mem
    · simp
    · -- |f| ≤ βn: from βe ≥ 1, βn = (βe)·f ≥ f.
      have h_abs : |(((f : ℕ) : ℤ) : ℝ)| = (f : ℝ) := by
        rw [abs_of_nonneg (by positivity : (0 : ℝ) ≤ (((f : ℕ) : ℤ) : ℝ))]
        push_cast
        ring
      rw [show ((((0 : ℤ), (f : ℤ)) : ℤ × ℤ).2 : ℝ) = (((f : ℕ) : ℤ) : ℝ) from rfl,
          h_abs]
      have h_expand : ((e : ℝ) * β - 1) * f = β * n - f := by
        rw [← hef_R]; ring
      have h_nonneg : (0 : ℝ) ≤ ((e : ℝ) * β - 1) * f :=
        mul_nonneg (by linarith) hf_pos_R.le
      linarith
  · -- Case `eβ < 1`: Dirichlet pigeonhole on the column slope c/f.
    push_neg at h_eβ
    have h_βe_pos : (0 : ℝ) < β * e := by positivity
    set κ : ℕ := ⌈1 / (β * (e : ℝ))⌉₊ with hκ_def
    have hκ_ge : 1 / (β * (e : ℝ)) ≤ (κ : ℝ) := Nat.le_ceil _
    have hκ_lt : (κ : ℝ) < 1 / (β * e) + 1 := by
      rw [hκ_def]
      exact Nat.ceil_lt_add_one (by positivity)
    have hκ_gt_one : 1 < κ := by
      rw [hκ_def, Nat.lt_ceil]
      push_cast
      rw [lt_div_iff₀ h_βe_pos]
      nlinarith
    have hκ_pos_R : (0 : ℝ) < κ := by
      exact_mod_cast (by omega : 0 < κ)
    have hκ_pred : 0 < κ - 1 := by omega
    obtain ⟨j, k, hk_pos, hk_le, h_dir⟩ :=
      Real.exists_int_int_abs_mul_sub_le ((c : ℝ) / f) hκ_pred
    have hκ_cast : ((κ - 1 : ℕ) : ℝ) = (κ : ℝ) - 1 := by
      have h1 : (1 : ℕ) ≤ κ := by omega
      push_cast [h1]
      ring
    have h_dir' : |(k : ℝ) * ((c : ℝ) / f) - (j : ℝ)| ≤ 1 / κ := by
      have h1 : ((κ - 1 : ℕ) : ℝ) + 1 = κ := by rw [hκ_cast]; ring
      rwa [h1] at h_dir
    have hk_le_R : (k : ℝ) ≤ (κ : ℝ) - 1 := by
      rw [← hκ_cast]; exact_mod_cast hk_le
    have hk_pos_R : (0 : ℝ) < k := by exact_mod_cast hk_pos
    -- The witness pair (k·e, k·c - j·f).
    refine ⟨((κ : ℝ) - 1) * e, by nlinarith, ?_,
        ((k * (e : ℕ) : ℤ), (k * (c : ℕ) - j * (f : ℕ) : ℤ)), ?_, ?_, ?_, ?_⟩
    · -- B < 1/β: (κ-1)·e < (1/(βe))·e = 1/β.
      have h1 : (κ : ℝ) - 1 < 1 / (β * e) := by linarith
      calc ((κ : ℝ) - 1) * e < (1 / (β * e)) * e :=
            mul_lt_mul_of_pos_right h1 he_pos_R
        _ = 1 / β := by field_simp
    · -- nonzero: first coordinate k·e > 0.
      intro h_eq
      have h1 : (k * (e : ℕ) : ℤ) = 0 := congrArg Prod.fst h_eq
      have he_int : (0 : ℤ) < ((e : ℕ) : ℤ) := by exact_mod_cast he_pos
      nlinarith
    · -- membership: the pair is k•(e, c) - j•(0, f) in (ZMod n)².
      have h_pair_eq :
          (((k * (e : ℕ) : ℤ) : ZMod n), ((k * (c : ℕ) - j * (f : ℕ) : ℤ) : ZMod n)) =
            k • (((e : ℕ) : ZMod n), ((c : ℕ) : ZMod n)) -
            j • ((0 : ZMod n), ((f : ℕ) : ZMod n)) := by
        refine Prod.ext ?_ ?_
        · show ((k * (e : ℕ) : ℤ) : ZMod n) =
              k • ((e : ℕ) : ZMod n) - j • (0 : ZMod n)
          rw [smul_zero, sub_zero, zsmul_eq_mul]
          push_cast
          ring
        · show ((k * (c : ℕ) - j * (f : ℕ) : ℤ) : ZMod n) =
              k • ((c : ℕ) : ZMod n) - j • ((f : ℕ) : ZMod n)
          rw [zsmul_eq_mul, zsmul_eq_mul]
          push_cast
          ring
      rw [show ((((k * (e : ℕ) : ℤ), (k * (c : ℕ) - j * (f : ℕ) : ℤ)) : ℤ × ℤ).1 : ZMod n) =
            (((k * (e : ℕ) : ℤ)) : ZMod n) from rfl]
      rw [show ((((k * (e : ℕ) : ℤ), (k * (c : ℕ) - j * (f : ℕ) : ℤ)) : ℤ × ℤ).2 : ZMod n) =
            (((k * (c : ℕ) - j * (f : ℕ) : ℤ)) : ZMod n) from rfl]
      rw [show ((((k * (e : ℕ) : ℤ)) : ZMod n), (((k * (c : ℕ) - j * (f : ℕ) : ℤ)) : ZMod n)) =
            k • (((e : ℕ) : ZMod n), ((c : ℕ) : ZMod n)) -
            j • ((0 : ZMod n), ((f : ℕ) : ZMod n)) from h_pair_eq]
      exact H.sub_mem (H.zsmul_mem h_ec_mem k) (H.zsmul_mem h_0f_mem j)
    · -- |k·e| ≤ (κ-1)·e.
      have h_pos : (0 : ℝ) < (k : ℝ) * (e : ℕ) := by
        nlinarith
      rw [show (((k * (e : ℕ) : ℤ)) : ℝ) = (k : ℝ) * ((e : ℕ) : ℝ) from by push_cast; ring,
          abs_of_pos h_pos]
      nlinarith
    · -- |k·c - j·f| = |k·(c/f) - j|·f ≤ f/κ ≤ (βe)·f = βn.
      have h_abs_eq : |((k * (c : ℕ) - j * (f : ℕ) : ℤ) : ℝ)| =
          |(k : ℝ) * ((c : ℝ) / f) - (j : ℝ)| * f := by
        have h1 : ((k * (c : ℕ) - j * (f : ℕ) : ℤ) : ℝ) =
            ((k : ℝ) * ((c : ℝ) / f) - (j : ℝ)) * f := by
          push_cast
          field_simp
        rw [h1, abs_mul, abs_of_pos hf_pos_R]
      rw [show (((k * (c : ℕ) - j * (f : ℕ) : ℤ)) : ℝ) =
            ((k * (c : ℕ) - j * (f : ℕ) : ℤ) : ℝ) from rfl, h_abs_eq]
      have h_1κ_le : (1 : ℝ) / κ ≤ β * e := by
        rw [div_le_iff₀ hκ_pos_R]
        calc (1 : ℝ) = (1 / (β * e)) * (β * e) := by field_simp
          _ ≤ (κ : ℝ) * (β * e) := mul_le_mul_of_nonneg_right hκ_ge h_βe_pos.le
          _ = β * e * κ := by ring
      calc |(k : ℝ) * ((c : ℝ) / f) - (j : ℝ)| * f ≤ (1 / κ) * f :=
            mul_le_mul_of_nonneg_right h_dir' hf_pos_R.le
        _ ≤ (β * e) * f := mul_le_mul_of_nonneg_right h_1κ_le hf_pos_R.le
        _ = β * n := by rw [mul_assoc, hef_R]

/-- **BHK Corollary 6.** Either `G` intersects every `α × β` rectangle,
    or there exists `(i, j) ∈ bhkCor6Region α β` with `(i/n, j/n) ∈ G`.

    Proof (BHK §3.2, p10–11): three cases on `n` vs `1/(αβ)` and `1/β`.

    * **Cases A & B** `n ≥ 1/β` (unified): a pigeonhole witness
      (`bhk_corollary_6_small_i_witness`, replacing BHK's half-open-box
      Minkowski argument) gives a nonzero `(i, j)` in `H`-coords with
      `|i| ≤ B < 1/β` *strictly* and `|j| ≤ βn`. Refine to a minimal
      representative (`bhk_main_lemma_minimality`, with `α' := B/n`, so
      the strict bound is inherited), then `rectangle_minimal` gives the
      BHK (12) bound, from which the cone bounds on `j` follow since
      `|j| ≤ βn`. WLOG `i ≥ 0` by group symmetry; this gives
      `(i, j) ∈ X`.

    * **Case C** `n < 1/β`: `X` contains the set `{0,...,n-1} × {-1,0,1}
      \ {(0,0)}` (since `n < 1/β` and `α < 1` imply `n-1 < 1/β` and
      `1 < 1/α`). Cyclic-subgroup theory: `G` contains some
      `(i/n, j/n)` with `i ∈ {0,...,n-1}` and `j ∈ {-1, 0, 1}` (i.e.,
      a generator can be chosen with second coordinate in this range
      using the cyclic group structure mod `n`). -/
theorem bhk_corollary_6
    (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (hG_lift : IsBHKLift G n)
    (α β : ℝ) (hα : 0 < α) (hα' : α < 1) (hβ : 0 < β) (hβ' : β < 1)
    (hαβ : α * β ≥ 1 / (n : ℝ)) :
    (∀ x₁ x₂, (G ∩ bhkRectangle x₁ x₂ α β).Nonempty) ∨
    (∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
      0 ≤ ij.1 ∧ (ij.1 : ℝ) < 1 / β ∧
      -1 / α - β / α * ij.1 < (ij.2 : ℝ) ∧
      (ij.2 : ℝ) < 1 / α + β / α * ij.1) := by
  by_cases h_n_lt_1_β : (n : ℝ) < 1 / β
  · -- ===== Case C: `n < 1/β` (combinatorial) =====
    refine Or.inr ?_
    obtain ⟨H, hH_card, hG_iff⟩ := hG_lift
    obtain ⟨ab, hab_in, hab_ne, hab_proj⟩ :=
      bhk_corollary_6_case_C_helper n hn H hH_card
    haveI : Fact (1 < n) := ⟨hn⟩
    haveI : NeZero n := ⟨by omega⟩
    have hab1_val_lt : ab.1.val < n := ZMod.val_lt _
    have habval_nonneg : (0 : ℝ) ≤ (ab.1.val : ℝ) := Nat.cast_nonneg _
    have habval_lt_n : (ab.1.val : ℝ) < (n : ℝ) := by exact_mod_cast hab1_val_lt
    have h_1α_pos : (0 : ℝ) < 1/α := one_div_pos.mpr hα
    have h_1_lt_1α : (1 : ℝ) < 1/α := by rw [lt_div_iff₀ hα]; linarith
    have hβα_nonneg : (0 : ℝ) ≤ β/α := div_nonneg hβ.le hα.le
    have h_prod_nonneg : (0 : ℝ) ≤ β/α * (ab.1.val : ℝ) :=
      mul_nonneg hβα_nonneg habval_nonneg
    rcases hab_proj with hab_0 | hab_1
    · -- ab.2 = 0. Witness: ((ab.1.val : ℤ), 0).
      refine ⟨((ab.1.val : ℤ), 0), ?_, ?_, ?_, ?_, ?_, ?_⟩
      · -- (i, j) ≠ (0, 0). Else i = 0 → ab.1 = 0 → ab = (0, 0).
        intro h_eq
        have h_i_zero : ((ab.1.val : ℤ)) = (0 : ℤ) := congr_arg Prod.fst h_eq
        have h_val_zero : ab.1.val = 0 := by exact_mod_cast h_i_zero
        have h_ab1_zero : ab.1 = 0 := (ZMod.val_eq_zero ab.1).mp h_val_zero
        exact hab_ne (Prod.ext h_ab1_zero hab_0)
      · -- (i/n, 0/n) ∈ G.
        rw [hG_iff]
        refine ⟨ab, hab_in, 0, 0, ?_⟩
        have h_val_2 : ab.2.val = 0 := by rw [hab_0]; exact ZMod.val_zero
        refine Prod.ext ?_ ?_
        · show ((ab.1.val : ℤ) : ℝ) / (n : ℝ) = (ab.1.val : ℝ) / n + ((0 : ℤ) : ℝ)
          push_cast; ring
        · show ((0 : ℤ) : ℝ) / (n : ℝ) = (ab.2.val : ℝ) / n + ((0 : ℤ) : ℝ)
          rw [h_val_2]; push_cast; ring
      · exact Int.ofNat_nonneg _
      · show ((ab.1.val : ℤ) : ℝ) < 1 / β
        push_cast; linarith
      · show -1/α - β/α * ((ab.1.val : ℤ) : ℝ) < ((0 : ℤ) : ℝ)
        push_cast
        have h_pos : (0 : ℝ) < 1/α + β/α * (ab.1.val : ℝ) :=
          add_pos_of_pos_of_nonneg h_1α_pos h_prod_nonneg
        have h_neg_form : (-1 : ℝ) / α - β / α * (ab.1.val : ℝ) =
                          -(1/α + β/α * (ab.1.val : ℝ)) := by ring
        linarith [h_pos, h_neg_form]
      · show ((0 : ℤ) : ℝ) < 1/α + β/α * ((ab.1.val : ℤ) : ℝ)
        push_cast; linarith
    · -- ab.2 = 1. Witness: ((ab.1.val : ℤ), 1).
      refine ⟨((ab.1.val : ℤ), 1), ?_, ?_, ?_, ?_, ?_, ?_⟩
      · intro h_eq
        have : (1 : ℤ) = 0 := congr_arg Prod.snd h_eq
        exact one_ne_zero this
      · rw [hG_iff]
        refine ⟨ab, hab_in, 0, 0, ?_⟩
        have h_val_2 : ab.2.val = 1 := by rw [hab_1]; exact ZMod.val_one n
        refine Prod.ext ?_ ?_
        · show ((ab.1.val : ℤ) : ℝ) / (n : ℝ) = (ab.1.val : ℝ) / n + ((0 : ℤ) : ℝ)
          push_cast; ring
        · show ((1 : ℤ) : ℝ) / (n : ℝ) = (ab.2.val : ℝ) / n + ((0 : ℤ) : ℝ)
          rw [h_val_2]; push_cast; ring
      · exact Int.ofNat_nonneg _
      · show ((ab.1.val : ℤ) : ℝ) < 1 / β
        push_cast; linarith
      · show -1/α - β/α * ((ab.1.val : ℤ) : ℝ) < ((1 : ℤ) : ℝ)
        push_cast
        have h_pos : (0 : ℝ) < 1/α + β/α * (ab.1.val : ℝ) :=
          add_pos_of_pos_of_nonneg h_1α_pos h_prod_nonneg
        have h_neg_form : (-1 : ℝ) / α - β / α * (ab.1.val : ℝ) =
                          -(1/α + β/α * (ab.1.val : ℝ)) := by ring
        linarith [h_pos, h_neg_form]
      · show ((1 : ℤ) : ℝ) < 1/α + β/α * ((ab.1.val : ℤ) : ℝ)
        push_cast; linarith
  · -- ===== Cases A & B: `n ≥ 1/β`. Apply Main Lemma with the small K =====
    push_neg at h_n_lt_1_β  -- h_n_lt_1_β : 1/β ≤ ↑n
    have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
    have h_1β_pos : (0 : ℝ) < 1/β := one_div_pos.mpr hβ
    have hβn_pos : (0 : ℝ) < β * n := mul_pos hβ hn_pos
    have hβn_nn : (0 : ℝ) ≤ β * n := hβn_pos.le
    -- αβn ≥ 1 (from hαβ : αβ ≥ 1/n), hence 1/β ≤ αn.
    have hαβn_ge_one : (1 : ℝ) ≤ α * β * n := by
      have := hαβ
      rw [ge_iff_le, div_le_iff₀ hn_pos] at this
      linarith
    have h_1β_le_αn : (1 : ℝ) / β ≤ α * n := by
      rw [div_le_iff₀ hβ]; linarith
    -- Classical disjunction
    by_cases h_all_hit : ∀ x₁ x₂, (G ∩ bhkRectangle x₁ x₂ α β).Nonempty
    · exact Or.inl h_all_hit
    refine Or.inr ?_
    push_neg at h_all_hit
    obtain ⟨x₁, x₂, h_miss_eq⟩ := h_all_hit
    have h_miss : ¬ (G ∩ bhkRectangle x₁ x₂ α β).Nonempty := by
      rw [Set.not_nonempty_iff_eq_empty]; exact h_miss_eq
    -- Unpack the lift once (a copy survives for the Main Lemma applications).
    obtain ⟨H, hH_card, hG_iff⟩ := id hG_lift
    haveI : NeZero n := ⟨by omega⟩
    have hn_ne_real : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
    -- Integer-coordinate characterization of G-membership.
    have hG_int_iff : ∀ a b : ℤ, ((a : ℝ) / n, (b : ℝ) / n) ∈ G ↔
        ((a : ZMod n), (b : ZMod n)) ∈ H :=
      fun a b => bhk_lift_int_mem_iff G n hn H hG_iff a b
    -- Pigeonhole witness: nonzero (i,j) in H-coords with |i| ≤ B < 1/β, |j| ≤ βn.
    -- (Strictness of B < 1/β is what the closed-box Minkowski step cannot give.)
    obtain ⟨B, hB_nn, hB_lt, ij₀, hij₀_ne, hij₀_H, hij₀_B, hij₀_β⟩ :=
      bhk_corollary_6_small_i_witness n hn H hH_card β hβ
    -- Feed it to minimality with α' := B/n (so that α'·n = B).
    have h_Bn_eq : (B / n) * (n : ℝ) = B := div_mul_cancel₀ B hn_ne_real
    have h_Bn_nn : (0 : ℝ) ≤ (B / n) * (n : ℝ) := by rw [h_Bn_eq]; exact hB_nn
    have hij₀_ex : ∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
        ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
        |(ij.1 : ℝ)| ≤ (B / n) * n ∧ |(ij.2 : ℝ)| ≤ β * n := by
      refine ⟨ij₀, hij₀_ne, (hG_int_iff ij₀.1 ij₀.2).mpr hij₀_H, ?_, hij₀_β⟩
      rw [h_Bn_eq]; exact hij₀_B
    obtain ⟨ij', hij'_ne, hij'_G, hij'_α', hij'_β, hij'_min⟩ :=
      bhk_main_lemma_minimality G n hn (B / n) β h_Bn_nn hβn_nn hij₀_ex
    -- Strict bound |i| < 1/β, inherited from B < 1/β.
    have hij'_i_lt : |(ij'.1 : ℝ)| < 1 / β := by
      rw [h_Bn_eq] at hij'_α'
      exact lt_of_le_of_lt hij'_α' hB_lt
    have hij'_box_αn : |(ij'.1 : ℝ)| ≤ α * n := le_trans hij'_i_lt.le h_1β_le_αn
    -- Apply rectangle_minimal to get the BHK (12) bound on (i,j).
    have h_bound := bhk_main_lemma_rectangle_minimal G n hn hG_lift α β
      hα hα' hβ hβ' ij'.1 ij'.2 hij'_ne ⟨hij'_box_αn, hij'_β⟩ hij'_G hij'_min
      ⟨x₁, x₂, h_miss⟩
    -- WLOG ij'.1 ≥ 0 via G-negation symmetry (G is the ℤ²-lift of H closed under neg).
    -- G-negation: from (a/n, b/n) ∈ G derive (-a/n, -b/n) ∈ G.
    have hG_neg : ∀ a b : ℤ, ((a : ℝ) / n, (b : ℝ) / n) ∈ G →
        (((-a : ℤ) : ℝ) / n, ((-b : ℤ) : ℝ) / n) ∈ G := by
      intro a b hab
      have h_in_H : ((a : ZMod n), (b : ZMod n)) ∈ H := (hG_int_iff a b).mp hab
      apply (hG_int_iff (-a) (-b)).mpr
      have : (((-a : ℤ) : ZMod n), ((-b : ℤ) : ZMod n)) =
              -((a : ZMod n), (b : ZMod n)) := by
        ext
        · push_cast; simp
        · push_cast; simp
      rw [this]; exact H.neg_mem h_in_H
    -- Step 2: WLOG ij'.1 ≥ 0.
    -- Helper proof for the j bound and the (|j| < 1/α + β/α·|i|) bound — works for either sign.
    -- From h_bound + |ij'.2| ≤ βn, derive α·|j| < 1 + β·|i|.
    have h_j_alpha_bound : α * |(ij'.2 : ℝ)| < 1 + β * |(ij'.1 : ℝ)| := by
      -- β·|i| + α·|j| - 2/n·|i||j| < 1
      -- α·|j| < 1 - β·|i| + 2/n·|i||j|
      -- α·|j| - β·|i| < 1 + 2·|i|·(|j|/n - β); and |j| ≤ βn, so |j|/n ≤ β.
      have h_abs_i_nn : (0 : ℝ) ≤ |(ij'.1 : ℝ)| := abs_nonneg _
      have h_jn_le_β : |(ij'.2 : ℝ)| / n ≤ β := by
        rw [div_le_iff₀ hn_pos]; linarith [hij'_β]
      -- Equivalently: 2/n · |i| · |j| ≤ 2β · |i|.
      have h_key : 2 / (n : ℝ) * |(ij'.1 : ℝ)| * |(ij'.2 : ℝ)| ≤
                   2 * β * |(ij'.1 : ℝ)| := by
        have h_abs_j_nn : (0 : ℝ) ≤ |(ij'.2 : ℝ)| := abs_nonneg _
        have h_step : (2 / (n : ℝ)) * |(ij'.2 : ℝ)| ≤ 2 * β := by
          rw [div_mul_eq_mul_div]
          rw [div_le_iff₀ hn_pos]
          linarith [hij'_β]
        nlinarith [h_step, h_abs_i_nn]
      linarith [h_bound, h_key]
    -- Now the case split. The new (i, j) is (ij'.1, ij'.2) or (-ij'.1, -ij'.2)
    -- depending on sign of ij'.1.
    by_cases h_pos : 0 ≤ ij'.1
    swap
    · -- Case: ij'.1 < 0. Use (-ij'.1, -ij'.2).
      have h_neg_i : ij'.1 < 0 := by omega
      refine ⟨(-ij'.1, -ij'.2), ?_, ?_, by omega, ?_, ?_, ?_⟩
      · -- (-ij'.1, -ij'.2) ≠ (0, 0)
        intro h_eq
        apply hij'_ne
        ext
        · have h1 : (-ij'.1, -ij'.2).1 = (0 : ℤ × ℤ).1 := congr_arg Prod.fst h_eq
          simp at h1; omega
        · have h2 : (-ij'.1, -ij'.2).2 = (0 : ℤ × ℤ).2 := congr_arg Prod.snd h_eq
          simp at h2; omega
      · -- ((-ij'.1 : ℝ)/n, (-ij'.2 : ℝ)/n) ∈ G via G-negation.
        have := hG_neg ij'.1 ij'.2 hij'_G
        convert this using 2 <;> push_cast <;> ring
      · -- (-ij'.1 : ℝ) < 1/β: strict, since |ij'.1| < 1/β.
        have h_i_abs : |(ij'.1 : ℝ)| = -(ij'.1 : ℝ) :=
          abs_of_neg (by exact_mod_cast h_neg_i)
        push_cast
        linarith [hij'_i_lt]
      · -- -1/α - β/α·(-ij'.1) < -ij'.2
        have h_α_pos : (0 : ℝ) < α := hα
        have h_i_abs : |(ij'.1 : ℝ)| = -(ij'.1 : ℝ) := abs_of_neg (by exact_mod_cast h_neg_i)
        have h_j_le : (ij'.2 : ℝ) ≤ |(ij'.2 : ℝ)| := le_abs_self _
        have h_α_j_le : α * (ij'.2 : ℝ) ≤ α * |(ij'.2 : ℝ)| :=
          mul_le_mul_of_nonneg_left h_j_le h_α_pos.le
        have h_total : α * (ij'.2 : ℝ) < 1 + β * (-(ij'.1 : ℝ)) := by
          rw [show β * (-(ij'.1 : ℝ)) = β * |(ij'.1 : ℝ)| from by rw [h_i_abs]]
          linarith [h_j_alpha_bound, h_α_j_le]
        have h_div : (ij'.2 : ℝ) < (1 + β * (-(ij'.1 : ℝ))) / α :=
          (lt_div_iff₀ h_α_pos).mpr (by linarith)
        have h_eq : (-1 : ℝ)/α - β/α * ((-ij'.1 : ℤ) : ℝ) =
                    -((1 + β * (-(ij'.1 : ℝ))) / α) := by
          push_cast; field_simp; ring
        push_cast at h_eq ⊢
        linarith [h_div, h_eq]
      · -- (-ij'.2 : ℝ) < 1/α + β/α·(-ij'.1)
        have h_α_pos : (0 : ℝ) < α := hα
        have h_i_abs : |(ij'.1 : ℝ)| = -(ij'.1 : ℝ) := abs_of_neg (by exact_mod_cast h_neg_i)
        have h_j_abs_ge : -(ij'.2 : ℝ) ≤ |(ij'.2 : ℝ)| := neg_le_abs _
        have h_α_j_lt : α * (-(ij'.2 : ℝ)) ≤ α * |(ij'.2 : ℝ)| :=
          mul_le_mul_of_nonneg_left h_j_abs_ge h_α_pos.le
        have h_total : α * (-(ij'.2 : ℝ)) < 1 + β * (-(ij'.1 : ℝ)) := by
          rw [show β * (-(ij'.1 : ℝ)) = β * |(ij'.1 : ℝ)| from by rw [h_i_abs]]
          linarith [h_j_alpha_bound, h_α_j_lt]
        have h_div : -(ij'.2 : ℝ) < (1 + β * (-(ij'.1 : ℝ))) / α :=
          (lt_div_iff₀ h_α_pos).mpr (by linarith)
        have h_eq : (1 : ℝ)/α + β/α * ((-ij'.1 : ℤ) : ℝ) =
                    (1 + β * (-(ij'.1 : ℝ))) / α := by
          push_cast; field_simp
        push_cast at h_eq ⊢
        linarith [h_div, h_eq]
    · -- Case: ij'.1 ≥ 0. Use (ij'.1, ij'.2).
      refine ⟨ij', hij'_ne, hij'_G, h_pos, ?_, ?_, ?_⟩
      · -- ij'.1 < 1/β: strict, since |ij'.1| < 1/β.
        have h_i_abs : |(ij'.1 : ℝ)| = (ij'.1 : ℝ) := abs_of_nonneg (by exact_mod_cast h_pos)
        linarith [hij'_i_lt]
      · -- -1/α - β/α·ij'.1 < ij'.2
        have h_α_pos : (0 : ℝ) < α := hα
        have h_i_abs : |(ij'.1 : ℝ)| = (ij'.1 : ℝ) := abs_of_nonneg (by exact_mod_cast h_pos)
        have h_j_abs_ge : -(ij'.2 : ℝ) ≤ |(ij'.2 : ℝ)| := neg_le_abs _
        have h_α_j_lt : α * (-(ij'.2 : ℝ)) ≤ α * |(ij'.2 : ℝ)| :=
          mul_le_mul_of_nonneg_left h_j_abs_ge h_α_pos.le
        have h_total : α * (-(ij'.2 : ℝ)) < 1 + β * (ij'.1 : ℝ) := by
          rw [← h_i_abs]; linarith [h_j_alpha_bound, h_α_j_lt]
        -- α · (-j) < 1 + β·i  ⟹  -j < (1 + β·i)/α  ⟹  j > -(1 + β·i)/α = -1/α - β/α·i
        have h_div : -(ij'.2 : ℝ) < (1 + β * (ij'.1 : ℝ)) / α :=
          (lt_div_iff₀ h_α_pos).mpr (by linarith)
        have h_eq : (-1 : ℝ)/α - β/α * (ij'.1 : ℝ) = -((1 + β * (ij'.1 : ℝ)) / α) := by
          field_simp; ring
        linarith [h_div, h_eq]
      · -- ij'.2 < 1/α + β/α·ij'.1
        have h_α_pos : (0 : ℝ) < α := hα
        have h_i_abs : |(ij'.1 : ℝ)| = (ij'.1 : ℝ) := abs_of_nonneg (by exact_mod_cast h_pos)
        have h_j_le : (ij'.2 : ℝ) ≤ |(ij'.2 : ℝ)| := le_abs_self _
        have h_α_j_le : α * (ij'.2 : ℝ) ≤ α * |(ij'.2 : ℝ)| :=
          mul_le_mul_of_nonneg_left h_j_le h_α_pos.le
        have h_total : α * (ij'.2 : ℝ) < 1 + β * (ij'.1 : ℝ) := by
          rw [← h_i_abs]; linarith [h_j_alpha_bound, h_α_j_le]
        have h_div : (ij'.2 : ℝ) < (1 + β * (ij'.1 : ℝ)) / α :=
          (lt_div_iff₀ h_α_pos).mpr (by linarith)
        have h_eq : (1 : ℝ)/α + β/α * (ij'.1 : ℝ) = (1 + β * (ij'.1 : ℝ)) / α := by
          field_simp
        linarith [h_div, h_eq]

/-- **BHK §5 Part 3 — extraction of an exceptional pair (`q ≥ 18`).** Given the
    "no good time" fact (the set `S = {({v₄(l+½)}, {v₁(l+½)})}` avoids the
    `1/3 × 1/6` rectangle `R`, phrased as `h_nogood`), the main lemma
    (`bhk_corollary_6`) forces the generator `(r/q, p/q)` to land in a finite
    *exceptional* region: there is a nonzero `(i, j)` with `(i/q, j/q)` a multiple
    of `(r/q, p/q)` on the torus, `0 ≤ i < 6`, and `|j| < 3 + i/2`.

    The bridge: `S` avoids `R` ⟺ the lift `G` of `⟨(↑r,↑p)⟩` misses the rectangle
    anchored at `(1/6 − r/(2q), 1/6 − p/(2q))` (the `½`-offset), so the
    "hits every rectangle" disjunct of Corollary 6 fails. -/
theorem bhk_part3_exceptional (r p q : ℕ) (hq18 : 18 ≤ q) (hcop : Nat.gcd p q = 1)
    (h_nogood : ∀ k : ℤ,
      ¬ (Int.fract ((r : ℝ) / q * ((k : ℝ) + 1 / 2)) ∈ Set.Icc (1 / 6 : ℝ) (1 / 2) ∧
         Int.fract ((p : ℝ) / q * ((k : ℝ) + 1 / 2)) ∈ Set.Icc (1 / 6 : ℝ) (1 / 3))) :
    ∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      (∃ k : ℤ, Int.fract ((ij.1 : ℝ) / q) = Int.fract ((k : ℝ) * r / q) ∧
                Int.fract ((ij.2 : ℝ) / q) = Int.fract ((k : ℝ) * p / q)) ∧
      0 ≤ ij.1 ∧ (ij.1 : ℝ) < 6 ∧
      -3 - 1 / 2 * (ij.1 : ℝ) < (ij.2 : ℝ) ∧ (ij.2 : ℝ) < 3 + 1 / 2 * (ij.1 : ℝ) := by
  have hq0 : 0 < q := by omega
  obtain ⟨G, hGlift, hGmem⟩ := bhk_isBHKLift_gen r p q hq0 hcop
  set x₁ : ℝ := 1 / 6 - (r : ℝ) / (2 * q) with hx1def
  set x₂ : ℝ := 1 / 6 - (p : ℝ) / (2 * q) with hx2def
  have hmiss : ¬ ∀ a b, (G ∩ bhkRectangle a b (1 / 3) (1 / 6)).Nonempty := by
    intro hall
    obtain ⟨g, hgG, hgR⟩ := hall x₁ x₂
    obtain ⟨k, hk1, hk2⟩ := hGmem g hgG
    rw [bhkRectangle, Set.mem_setOf_eq] at hgR
    obtain ⟨_, hg1u, _, hg2u⟩ := hgR
    have hb1 : Int.fract (Int.fract (g.1 + (r : ℝ) / (2 * q)) - 1 / 6) ≤ 1 / 3 := by
      rw [show Int.fract (g.1 + (r : ℝ) / (2 * q)) - 1 / 6
            = Int.fract (g.1 + (r : ℝ) / (2 * q)) + (-(1 / 6) : ℝ) from by ring,
          ← bhk_fract_add_fract,
          show g.1 + (r : ℝ) / (2 * q) + (-(1 / 6) : ℝ) = g.1 - x₁ from by rw [hx1def]; ring]
      exact hg1u
    have hwin1 := bhk_window_from_fract (Int.fract_nonneg _) (Int.fract_lt_one _)
      (by norm_num : (1 : ℝ) / 3 < 5 / 6) hb1
    have hSeq1 : Int.fract (g.1 + (r : ℝ) / (2 * q))
        = Int.fract ((r : ℝ) / q * ((k : ℝ) + 1 / 2)) := by
      rw [bhk_fract_add_fract g.1, hk1, ← bhk_fract_add_fract]; congr 1; ring
    rw [hSeq1] at hwin1
    have hb2 : Int.fract (Int.fract (g.2 + (p : ℝ) / (2 * q)) - 1 / 6) ≤ 1 / 6 := by
      rw [show Int.fract (g.2 + (p : ℝ) / (2 * q)) - 1 / 6
            = Int.fract (g.2 + (p : ℝ) / (2 * q)) + (-(1 / 6) : ℝ) from by ring,
          ← bhk_fract_add_fract,
          show g.2 + (p : ℝ) / (2 * q) + (-(1 / 6) : ℝ) = g.2 - x₂ from by rw [hx2def]; ring]
      exact hg2u
    have hwin2 := bhk_window_from_fract (Int.fract_nonneg _) (Int.fract_lt_one _)
      (by norm_num : (1 : ℝ) / 6 < 5 / 6) hb2
    have hSeq2 : Int.fract (g.2 + (p : ℝ) / (2 * q))
        = Int.fract ((p : ℝ) / q * ((k : ℝ) + 1 / 2)) := by
      rw [bhk_fract_add_fract g.2, hk2, ← bhk_fract_add_fract]; congr 1; ring
    rw [hSeq2] at hwin2
    exact h_nogood k ⟨⟨hwin1.1, by linarith [hwin1.2]⟩, ⟨hwin2.1, by linarith [hwin2.2]⟩⟩
  rcases bhk_corollary_6 G q (by omega) hGlift (1 / 3) (1 / 6) (by norm_num) (by norm_num)
      (by norm_num) (by norm_num)
      (by rw [show (1 : ℝ) / 3 * (1 / 6) = 1 / 18 from by norm_num]
          exact one_div_le_one_div_of_le (by norm_num) (by exact_mod_cast hq18)) with
    hhit | ⟨ij, hne, hmemij, h0, h1β, hc1, hc2⟩
  · exact absurd hhit hmiss
  · refine ⟨ij, hne, hGmem _ hmemij, h0, ?_, ?_, ?_⟩
    · norm_num at h1β; exact h1β
    · norm_num at hc1; linarith [hc1]
    · norm_num at hc2; linarith [hc2]

end BHK

end


