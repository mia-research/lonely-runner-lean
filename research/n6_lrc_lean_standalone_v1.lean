section

/-!
# BHK §2 — Lemma 4 (45-block size bound) and Corollary 5

**BHK Lemma 4.** If `I` is a 45-block (maximal closed interval inside
`unsafeOf 3 ∪ unsafeOf 4`) then `|I| < 2 / (3 v_4)`.

In Lean we state the slightly stronger inclusion form: any closed interval
`[a, b]` contained in `unsafeOf 3 ∪ unsafeOf 4` has `b - a < 2 / (3 v_4)`.
The bound holds for all sub-intervals, so the original "45-block" form is
the special case where `[a, b]` is maximal.

**BHK Corollary 5.** Any 123-gap of length `≥ 2 / (3 v_3)` contains a lonely
time.

Both are fully proved (sorry-free). Case C of Lemma 4 (the BHK "k ≥ 2"
case) is closed by a two-5-block separation count in place of BHK's
5-gap-in-4-block alignment argument.

## Source

T. Bohman, R. Holzman, D. Kleitman, *Six Lonely Runners*, EJC **8** (2001)
R3, §2 (p3–4).
-/

open MeasureTheory Set

namespace BHK

/-! ## Helpers for BHK Lemma 4

We follow BHK's proof: every connected component of `unsafeOf i` is an open
interval of length `1/(3 v_i)`. Their gaps are closed intervals of length
`2/(3 v_i)`. -/

/-- **Sub-lemma A (single-runner block bound).** A closed interval contained
    in `unsafeOf speeds i` has length strictly less than `1 / (3 v_i)`.

    Proof: pick the integer `k` so that `a * v_i ∈ (k - 1/6, k + 1/6)`.
    Suppose `b * v_i ≥ k + 1/6`. Then `(k + 1/6) / v_i ∈ [a, b]`, but
    `(k + 1/6)` is not in `bhkB`, contradiction. So `b * v_i < k + 1/6` and
    `b - a < 1/(3 v_i)`. -/
lemma block_length_bound (speeds : Fin 5 → ℕ) (i : Fin 5) (hv : 0 < speeds i)
    (a b : ℝ) (hab : a ≤ b)
    (hsub : Set.Icc a b ⊆ unsafeOf speeds i) :
    b - a < 1 / (3 * (speeds i : ℝ)) := by
  have hvR : (0 : ℝ) < (speeds i : ℝ) := by exact_mod_cast hv
  -- a is in unsafeOf i, so v_i · a is in bhkB
  have ha_mem : a ∈ unsafeOf speeds i := hsub ⟨le_refl a, hab⟩
  rw [mem_unsafeOf_iff_bhkB] at ha_mem
  obtain ⟨k, hk⟩ := ha_mem
  -- v_i · a ∈ (k - 1/6, k + 1/6)
  have ha_lt : (speeds i : ℝ) * a < (k : ℝ) + 1 / 6 := by
    have := lt_of_abs_lt hk; linarith
  have ha_gt : (k : ℝ) - 1 / 6 < (speeds i : ℝ) * a := by
    have := neg_lt_of_abs_lt hk; linarith
  -- Claim: v_i · b < k + 1/6
  by_contra hcontra
  push_neg at hcontra
  -- hcontra : 1 / (3 * v) ≤ b - a
  have hbge : (k : ℝ) + 1 / 6 ≤ (speeds i : ℝ) * b := by
    -- b ≥ a + 1/(3v), so v * b ≥ v * a + 1/3
    have hba : 1 / (3 * (speeds i : ℝ)) ≤ b - a := hcontra
    have h1 : (speeds i : ℝ) * (b - a) ≥ 1 / 3 := by
      have hmul : (speeds i : ℝ) * (1 / (3 * (speeds i : ℝ))) ≤ (speeds i : ℝ) * (b - a) :=
        mul_le_mul_of_nonneg_left hba (le_of_lt hvR)
      have hsimp : (speeds i : ℝ) * (1 / (3 * (speeds i : ℝ))) = 1 / 3 := by
        field_simp
      linarith
    have h2 : (speeds i : ℝ) * b - (speeds i : ℝ) * a ≥ 1 / 3 := by
      have : (speeds i : ℝ) * (b - a) = (speeds i : ℝ) * b - (speeds i : ℝ) * a := by ring
      linarith
    linarith
  -- Define t* := (k + 1/6) / v_i
  set t_star : ℝ := ((k : ℝ) + 1 / 6) / (speeds i : ℝ) with ht_star
  have ht_a : a ≤ t_star := by
    rw [ht_star, le_div_iff₀ hvR]; linarith
  have ht_b : t_star ≤ b := by
    rw [ht_star, div_le_iff₀ hvR]; linarith
  -- t* ∈ [a, b] so t* ∈ unsafeOf i
  have ht_mem : t_star ∈ unsafeOf speeds i := hsub ⟨ht_a, ht_b⟩
  rw [mem_unsafeOf_iff_bhkB] at ht_mem
  obtain ⟨k', hk'⟩ := ht_mem
  -- v_i · t* = k + 1/6
  have ht_eval : (speeds i : ℝ) * t_star = (k : ℝ) + 1 / 6 := by
    rw [ht_star]; field_simp
  rw [ht_eval] at hk'
  -- |k + 1/6 - k'| < 1/6
  -- Since k' is integer and k is integer, the only ints in (k, k + 1/3) are none
  exfalso
  have h1 : (k' : ℝ) > (k : ℝ) := by
    have := lt_of_abs_lt hk'; linarith
  have h2 : (k' : ℝ) < (k : ℝ) + 1 / 3 := by
    have := neg_lt_of_abs_lt hk'; linarith
  have h3 : (k : ℤ) < k' := by exact_mod_cast h1
  have h4 : k + 1 ≤ k' := h3
  have h5 : (k : ℝ) + 1 ≤ (k' : ℝ) := by exact_mod_cast h4
  linarith

/-- **Block containment.** Refinement of `block_length_bound`. If a closed
    interval `[a, b]` is contained in `unsafeOf speeds i`, then there exists
    a single integer `k` such that
    `k - 1/6 < v_i · a` and `v_i · b < k + 1/6`. I.e., `[a, b]` is
    contained in the single "i-block" centred at `k / v_i`. The integer `k`
    is exactly the integer closest to `v_i · a` (and equivalently to
    `v_i · b`). -/
lemma block_containment (speeds : Fin 5 → ℕ) (i : Fin 5) (hv : 0 < speeds i)
    (a b : ℝ) (hab : a ≤ b)
    (hsub : Set.Icc a b ⊆ unsafeOf speeds i) :
    ∃ k : ℤ, (k : ℝ) - 1/6 < (speeds i : ℝ) * a ∧
              (speeds i : ℝ) * b < (k : ℝ) + 1/6 := by
  have hvR : (0 : ℝ) < (speeds i : ℝ) := by exact_mod_cast hv
  have ha_mem : a ∈ unsafeOf speeds i := hsub ⟨le_refl a, hab⟩
  rw [mem_unsafeOf_iff_bhkB] at ha_mem
  obtain ⟨k, hk⟩ := ha_mem
  have ha_gt : (k : ℝ) - 1 / 6 < (speeds i : ℝ) * a := by
    have := neg_lt_of_abs_lt hk; linarith
  refine ⟨k, ha_gt, ?_⟩
  by_contra hcontra
  push_neg at hcontra
  set t_star : ℝ := ((k : ℝ) + 1 / 6) / (speeds i : ℝ) with ht_star
  have ha_lt : (speeds i : ℝ) * a < (k : ℝ) + 1 / 6 := by
    have := lt_of_abs_lt hk; linarith
  have ht_a : a ≤ t_star := by
    rw [ht_star, le_div_iff₀ hvR]; linarith
  have ht_b : t_star ≤ b := by
    rw [ht_star, div_le_iff₀ hvR]; linarith
  have ht_mem : t_star ∈ unsafeOf speeds i := hsub ⟨ht_a, ht_b⟩
  rw [mem_unsafeOf_iff_bhkB] at ht_mem
  obtain ⟨k', hk'⟩ := ht_mem
  have ht_eval : (speeds i : ℝ) * t_star = (k : ℝ) + 1 / 6 := by
    rw [ht_star]; field_simp
  rw [ht_eval] at hk'
  have h1 : (k' : ℝ) > (k : ℝ) := by
    have := lt_of_abs_lt hk'; linarith
  have h3 : (k : ℤ) < k' := by exact_mod_cast h1
  have h5 : (k : ℝ) + 1 ≤ (k' : ℝ) := by exact_mod_cast (h3 : k + 1 ≤ k')
  have := neg_lt_of_abs_lt hk'; linarith

/-- **Helper: characterising "not in `unsafeOf i`" via integer gaps.**
    `t ∉ unsafeOf speeds i` iff `v_i · t ∈ [k + 1/6, k + 5/6]` for some integer
    `k`. The complement of the open U3-components is exactly the union of
    closed gaps. -/
lemma not_mem_unsafeOf_iff_in_gap (speeds : Fin 5 → ℕ) (i : Fin 5) (t : ℝ) :
    t ∉ unsafeOf speeds i ↔
    ∃ k : ℤ, (k : ℝ) + 1 / 6 ≤ (speeds i : ℝ) * t ∧ (speeds i : ℝ) * t ≤ (k : ℝ) + 5 / 6 := by
  rw [mem_unsafeOf_iff_bhkB, bhkB]
  simp only [Set.mem_setOf_eq, not_exists]
  constructor
  · intro h
    -- ¬ ∃ k, |v · t - k| < 1/6
    -- So ∀ k, |v · t - k| ≥ 1/6
    -- Let k = ⌊v · t - 1/6⌋, then v · t - 1/6 ≥ k, so v · t ≥ k + 1/6.
    -- And v · t - 1/6 < k + 1, so v · t < k + 7/6.
    -- Need: v · t ≤ k + 5/6. Suppose v · t > k + 5/6, then |v·t - (k+1)| < 1/6. Contradiction.
    refine ⟨⌊(speeds i : ℝ) * t - 1/6⌋, ?_, ?_⟩
    · have hfl := Int.floor_le ((speeds i : ℝ) * t - 1/6)
      linarith
    · have hfl_lt := Int.lt_floor_add_one ((speeds i : ℝ) * t - 1/6)
      by_contra hgt
      push_neg at hgt
      -- v · t > k + 5/6, so |v · t - (k+1)| < 1/6
      have : |(speeds i : ℝ) * t - ((⌊(speeds i : ℝ) * t - 1/6⌋ + 1 : ℤ) : ℝ)| < 1/6 := by
        push_cast
        rw [abs_lt]
        constructor
        · linarith
        · linarith
      exact absurd this (h _)
  · rintro ⟨k, hkl, hkr⟩ k'
    -- v · t ∈ [k + 1/6, k + 5/6]
    -- For any integer k', |v · t - k'| ≥ ? Show ≥ 1/6.
    intro hcontra
    have hh := lt_of_abs_lt hcontra
    have hh' := neg_lt_of_abs_lt hcontra
    -- |v · t - k'| < 1/6 means k' - 1/6 < v · t < k' + 1/6.
    -- Combined with k + 1/6 ≤ v · t ≤ k + 5/6: k + 1/6 < k' + 1/6 (so k < k')
    -- and k' - 1/6 < k + 5/6 (so k' < k + 1). So k < k' < k + 1: no integer.
    have h1 : (k : ℝ) < (k' : ℝ) := by linarith
    have h2 : (k' : ℝ) < (k : ℝ) + 1 := by linarith
    have h1z : k < k' := by exact_mod_cast h1
    have h2z : k' < k + 1 := by exact_mod_cast h2
    omega

/-- **Helper: points in a closed `unsafeOf i`-gap are not in `unsafeOf i`.**
    If `(k + 1/6)/v_i ≤ t ≤ (k + 5/6)/v_i`, then `t ∉ unsafeOf speeds i`. -/
lemma not_mem_unsafeOf_of_in_gap (speeds : Fin 5 → ℕ) (i : Fin 5) (hv : 0 < speeds i)
    (k : ℤ) (t : ℝ)
    (h1 : ((k : ℝ) + 1/6) / (speeds i : ℝ) ≤ t)
    (h2 : t ≤ ((k : ℝ) + 5/6) / (speeds i : ℝ)) :
    t ∉ unsafeOf speeds i := by
  have hvR : (0 : ℝ) < (speeds i : ℝ) := by exact_mod_cast hv
  rw [not_mem_unsafeOf_iff_in_gap]
  refine ⟨k, ?_, ?_⟩
  · -- (k + 1/6) ≤ v_i · t
    rw [div_le_iff₀ hvR] at h1
    linarith
  · -- v_i · t ≤ (k + 5/6)
    rw [le_div_iff₀ hvR] at h2
    linarith

/-- **Sub-lemma B (gap-piece bound).** A closed sub-interval of `[a, b]` that is
    disjoint from `unsafeOf speeds 3` lies in `unsafeOf speeds 4`, and hence
    has length `< 1 / (3 v_5)`. Specifically, for any integer `k`, the closed
    sub-interval `[max(a, (k+1/6)/v_4), min(b, (k+5/6)/v_4)]` (if non-trivial)
    is in `unsafeOf 4`, and has length `< 1/(3 v_5)`. -/
lemma gap_piece_bound (speeds : Fin 5 → ℕ)
    (hpos : ∀ i, 0 < speeds i)
    (a b : ℝ) (hab : a ≤ b)
    (hI : Set.Icc a b ⊆ unsafeOf speeds ⟨3, by omega⟩ ∪ unsafeOf speeds ⟨4, by omega⟩)
    (k : ℤ)
    (sL sR : ℝ) (hsL_a : a ≤ sL) (hsR_b : sR ≤ b) (hsLR : sL ≤ sR)
    (hgapL : ((k : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ) ≤ sL)
    (hgapR : sR ≤ ((k : ℝ) + 5/6) / (speeds ⟨3, by omega⟩ : ℝ)) :
    sR - sL < 1 / (3 * (speeds ⟨4, by omega⟩ : ℝ)) := by
  -- Show [sL, sR] ⊆ unsafeOf 4
  have hv3pos : 0 < speeds ⟨3, by omega⟩ := hpos _
  have hv4pos : 0 < speeds ⟨4, by omega⟩ := hpos _
  have hsub_U4 : Set.Icc sL sR ⊆ unsafeOf speeds ⟨4, by omega⟩ := by
    intro t ht
    obtain ⟨htL, htR⟩ := ht
    have ht_ab : t ∈ Set.Icc a b := ⟨le_trans hsL_a htL, le_trans htR hsR_b⟩
    have ht_S : t ∈ unsafeOf speeds ⟨3, by omega⟩ ∪ unsafeOf speeds ⟨4, by omega⟩ := hI ht_ab
    -- Need to rule out t ∈ unsafeOf 3
    have ht_notU3 : t ∉ unsafeOf speeds ⟨3, by omega⟩ :=
      not_mem_unsafeOf_of_in_gap speeds ⟨3, by omega⟩ hv3pos k t
        (le_trans hgapL htL) (le_trans htR hgapR)
    rcases ht_S with h | h
    · exact absurd h ht_notU3
    · exact h
  exact block_length_bound speeds ⟨4, by omega⟩ hv4pos sL sR hsLR hsub_U4

/-- **BHK Lemma 4 — Case C (`fract(v_4 · a) ∈ [1/2, 5/6)`).** The genuine
    BHK "k ≥ 2" case. In `v_4`-coordinates, `J = [m+s, m+s+2/3]`
    decomposes as gap-piece + full 4-block + gap-piece:
    `[m+s, m+5/6] ∪ [m+5/6, m+7/6] ∪ [m+7/6, m+s+2/3]`.

    1. The two gap-pieces are closed intervals inside `unsafeOf 4`
       (4-safe times in `J` are 5-unsafe), so each is `< 1/(3 v_5)` by
       `gap_piece_bound`; their lengths sum to exactly `1/(3 v_4)`,
       giving `v_5 < 2 v_4`.
    2. `block_containment` pins each gap-piece inside a *single*
       5-block: integers `k₁, k₂` with each piece within `1/6` of `k_i`
       in `v_5`-coordinates.
    3. The `v_5`-distance between the two facing endpoints is exactly
       `d = v_5/(3 v_4) ∈ (1/3, 2/3)` (left end strict from
       `v_4 < v_5`, right end strict from step 1). Containment forces
       `k₂ - k₁ - 1/3 < d < k₂ - k₁ + 1/3`, i.e. `0 < k₂ - k₁ < 1` —
       no such integer. This replaces BHK's 5-gap-in-4-block
       alignment argument with a purely local two-block separation
       count. -/
theorem bhk_lemma_4_case_C (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i)
    (a b : ℝ) (_hab : a ≤ b)
    (hI : Set.Icc a b ⊆ unsafeOf speeds ⟨3, by omega⟩ ∪ unsafeOf speeds ⟨4, by omega⟩)
    (hcontra : 2 / (3 * (speeds ⟨3, by omega⟩ : ℝ)) ≤ b - a)
    (hs_half : 1/2 ≤ Int.fract ((speeds ⟨3, by omega⟩ : ℝ) * a))
    (hs_56 : Int.fract ((speeds ⟨3, by omega⟩ : ℝ) * a) < 5/6) :
    False := by
  have hv3pos : (0 : ℝ) < (speeds ⟨3, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv4pos : (0 : ℝ) < (speeds ⟨4, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv3_lt_v4 : (speeds ⟨3, by omega⟩ : ℝ) < (speeds ⟨4, by omega⟩ : ℝ) := by
    have hmlt : speeds ⟨3, by omega⟩ < speeds ⟨4, by omega⟩ :=
      hmono (show (⟨3, by omega⟩ : Fin 5) < ⟨4, by omega⟩ by decide)
    exact_mod_cast hmlt
  set v3 : ℝ := (speeds ⟨3, by omega⟩ : ℝ) with hv3def
  set v4 : ℝ := (speeds ⟨4, by omega⟩ : ℝ) with hv4def
  set m : ℤ := ⌊v3 * a⌋ with hmdef
  set s : ℝ := Int.fract (v3 * a) with hsdef
  have hs_lt_one : s < 1 := Int.fract_lt_one _
  have hva_eq : v3 * a = (m : ℝ) + s := by
    rw [hsdef, hmdef]
    have := Int.floor_add_fract (v3 * a)
    linarith
  -- J = [a, b'] ⊆ [a, b]
  set b' : ℝ := a + 2 / (3 * v3) with hb'def
  have hb'_le_b : b' ≤ b := by rw [hb'def]; linarith
  have hab' : a ≤ b' := by
    have : (0 : ℝ) < 2 / (3 * v3) := by positivity
    rw [hb'def]
    linarith
  have hJ_sub : Set.Icc a b' ⊆ unsafeOf speeds ⟨3, by omega⟩ ∪
                                unsafeOf speeds ⟨4, by omega⟩ := by
    intro t ⟨ht1, ht2⟩
    exact hI ⟨ht1, le_trans ht2 hb'_le_b⟩
  have ha_eq : a = ((m : ℝ) + s) / v3 := by
    rw [eq_div_iff (ne_of_gt hv3pos)]; linarith [hva_eq]
  have hb'_eq : b' = ((m : ℝ) + s + 2/3) / v3 := by
    rw [hb'def, ha_eq]
    field_simp
  -- The facing endpoints of the two gap-pieces.
  set e₁ : ℝ := ((m : ℝ) + 5/6) / v3 with he₁def
  set e₂ : ℝ := ((m : ℝ) + 7/6) / v3 with he₂def
  -- Ordering.
  have h_a_e₁ : a ≤ e₁ := by
    rw [ha_eq, he₁def]
    exact div_le_div_of_nonneg_right (by linarith) (le_of_lt hv3pos)
  have h_e₁_e₂ : e₁ ≤ e₂ := by
    rw [he₁def, he₂def]
    exact div_le_div_of_nonneg_right (by linarith) (le_of_lt hv3pos)
  have h_e₂_b' : e₂ ≤ b' := by
    rw [he₂def, hb'_eq]
    exact div_le_div_of_nonneg_right (by linarith) (le_of_lt hv3pos)
  have h_e₁_b' : e₁ ≤ b' := le_trans h_e₁_e₂ h_e₂_b'
  -- Gap conditions for the left piece [a, e₁] (3-gap at m).
  have hgapL₁ : ((m : ℝ) + 1/6) / v3 ≤ a := by
    rw [ha_eq]
    exact div_le_div_of_nonneg_right (by linarith) (le_of_lt hv3pos)
  have hgapR₁ : e₁ ≤ ((m : ℝ) + 5/6) / v3 := he₁def.le
  -- Gap conditions for the right piece [e₂, b'] (3-gap at m+1).
  have hgapL₂ : ((↑(m + 1) : ℝ) + 1/6) / v3 ≤ e₂ := by
    rw [he₂def]
    push_cast
    exact div_le_div_of_nonneg_right (by linarith) (le_of_lt hv3pos)
  have hgapR₂ : b' ≤ ((↑(m + 1) : ℝ) + 5/6) / v3 := by
    rw [hb'_eq]
    push_cast
    exact div_le_div_of_nonneg_right (by linarith) (le_of_lt hv3pos)
  -- Step 1: each gap-piece is < 1/(3 v4); the pieces sum to 1/(3 v3).
  have hgp₁ : e₁ - a < 1 / (3 * v4) :=
    gap_piece_bound speeds hpos a b' hab' hJ_sub m a e₁
      le_rfl h_e₁_b' h_a_e₁ hgapL₁ hgapR₁
  have hgp₂ : b' - e₂ < 1 / (3 * v4) :=
    gap_piece_bound speeds hpos a b' hab' hJ_sub (m + 1) e₂ b'
      (le_trans h_a_e₁ h_e₁_e₂) le_rfl h_e₂_b' hgapL₂ hgapR₂
  have hv4_lt_2v3 : v4 < 2 * v3 := by
    have hsum : (e₁ - a) + (b' - e₂) = 1 / (3 * v3) := by
      rw [he₁def, he₂def, ha_eq, hb'_eq]
      field_simp
      ring
    have htwo : 2 / (3 * v4) = 1 / (3 * v4) + 1 / (3 * v4) := by ring
    have h2 : 1 / (3 * v3) < 2 / (3 * v4) := by
      rw [htwo]
      linarith
    rw [div_lt_div_iff₀ (by positivity) (by positivity)] at h2
    linarith
  -- Step 2: each gap-piece lies in unsafeOf 4, hence in a single 5-block.
  have hP₁_sub : Set.Icc a e₁ ⊆ unsafeOf speeds ⟨4, by omega⟩ := by
    intro t ⟨ht1, ht2⟩
    have h_not3 : t ∉ unsafeOf speeds ⟨3, by omega⟩ :=
      not_mem_unsafeOf_of_in_gap speeds ⟨3, by omega⟩ (hpos _) m t
        (le_trans hgapL₁ ht1) (le_trans ht2 hgapR₁)
    rcases hJ_sub ⟨ht1, le_trans ht2 h_e₁_b'⟩ with h | h
    · exact absurd h h_not3
    · exact h
  have hP₂_sub : Set.Icc e₂ b' ⊆ unsafeOf speeds ⟨4, by omega⟩ := by
    intro t ⟨ht1, ht2⟩
    have h_not3 : t ∉ unsafeOf speeds ⟨3, by omega⟩ :=
      not_mem_unsafeOf_of_in_gap speeds ⟨3, by omega⟩ (hpos _) (m + 1) t
        (le_trans hgapL₂ ht1) (le_trans ht2 hgapR₂)
    rcases hJ_sub ⟨le_trans (le_trans h_a_e₁ h_e₁_e₂) ht1, ht2⟩ with h | h
    · exact absurd h h_not3
    · exact h
  obtain ⟨k₁, hk₁l, hk₁r⟩ :=
    block_containment speeds ⟨4, by omega⟩ (hpos _) a e₁ h_a_e₁ hP₁_sub
  obtain ⟨k₂, hk₂l, hk₂r⟩ :=
    block_containment speeds ⟨4, by omega⟩ (hpos _) e₂ b' h_e₂_b' hP₂_sub
  -- Step 3: the v4-distance between the facing endpoints is v4/(3 v3),
  -- strictly between 1/3 and 2/3 — incompatible with two 5-blocks.
  have hd_eq : v4 * e₂ - v4 * e₁ = v4 / (3 * v3) := by
    rw [he₁def, he₂def]
    field_simp
    ring
  have hd_lo : 1/3 < v4 * e₂ - v4 * e₁ := by
    rw [hd_eq, lt_div_iff₀ (by positivity)]
    linarith
  have hd_hi : v4 * e₂ - v4 * e₁ < 2/3 := by
    rw [hd_eq, div_lt_iff₀ (by positivity)]
    linarith
  have h₁ : v4 * a ≤ v4 * e₁ := mul_le_mul_of_nonneg_left h_a_e₁ (le_of_lt hv4pos)
  have h₂ : v4 * e₂ ≤ v4 * b' := mul_le_mul_of_nonneg_left h_e₂_b' (le_of_lt hv4pos)
  -- 0 < k₂ - k₁ < 1 over ℝ, hence over ℤ: contradiction.
  have h_int_lo : k₁ < k₂ := by
    have : (k₁ : ℝ) < (k₂ : ℝ) := by linarith
    exact_mod_cast this
  have h_int_hi : k₂ < k₁ + 1 := by
    have : (k₂ : ℝ) < (k₁ : ℝ) + 1 := by linarith
    exact_mod_cast this
  omega

/-- **BHK Lemma 4.** Any closed interval `[a, b]` contained in
    `unsafeOf 3 ∪ unsafeOf 4` has length `< 2 / (3 v_4)`.

    **Proof outline (fully proved, sorry-free):**

    Suppose for contradiction `b - a ≥ 2/(3 v_4)`. Consider
    `J = [a, a + 2/(3 v_4)] ⊆ [a, b]` and let `s = fract (v_4 · a)`.
    In `v_4`-coordinates, J is `[s, s + 2/3]`.

    * **Case A** (`s ∈ [0, 1/6] ∪ [5/6, 1)`): `a` lies in a 4-block. The 4-gap
      portion of J has length `≥ 1/2` in `v_4`-coords, so `≥ 1/(2 v_4)` in
      `t`-coords. This is one connected sub-interval ⊆ `unsafeOf 4`. By
      `block_length_bound`, length `< 1/(3 v_5)`. Hence `v_5 < 2 v_4 / 3 < v_4`,
      contradicting `hmono`.

    * **Case B1** (`s ∈ (1/6, 5/6)` with `s + 2/3 ≤ 5/6`, i.e. `s ≤ 1/6`):
      vacuous (forces `s = 1/6`).

    * **Case B2** (`s ∈ (1/6, 5/6)` with `s + 2/3 > 5/6`): J crosses from
      4-gap into 4-block (and possibly into the next 4-gap).
      - Subcase `s ∈ (1/6, 1/2]`: single gap-piece `[s, 5/6]` of length
        `5/6 - s ≥ 1/3` in `v_4`-coords. By `gap_piece_bound`,
        `(5/6 - s)/v_4 < 1/(3 v_5) < 1/(3 v_4)`, so `5/6 - s < 1/3`,
        i.e. `s > 1/2` — contradiction.
      - Subcase `s ∈ (1/2, 5/6)`: J covers gap-piece + full 4-block + next
        gap-piece. Gap-pieces sum to `1/3` in `v_4`-coords = `1/(3 v_4)` in
        `t`-coords. Each gap-piece `< 1/(3 v_5)` by `gap_piece_bound`; sum
        `< 2/(3 v_5)`. Hence `v_5 < 2 v_4`.

        **This is BHK's "k ≥ 2" structural case**, closed in
        `bhk_lemma_4_case_C` by a two-5-block separation count: the
        two gap-pieces each sit inside a single 5-block, but their
        facing endpoints are `v_5/(3 v_4) ∈ (1/3, 2/3)` apart in
        `v_5`-coordinates — too far for the same block, too near for
        distinct blocks.

    Helpers `block_length_bound`, `not_mem_unsafeOf_iff_in_gap`,
    `not_mem_unsafeOf_of_in_gap`, `gap_piece_bound` are in scope. -/
theorem bhk_lemma_4 (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i)
    (a b : ℝ) (hab : a ≤ b)
    (hI : Set.Icc a b ⊆ unsafeOf speeds ⟨3, by omega⟩ ∪ unsafeOf speeds ⟨4, by omega⟩) :
    b - a < 2 / (3 * (speeds ⟨3, by omega⟩ : ℝ)) := by
  -- Abbreviations and basic positivity
  have hv3pos : (0 : ℝ) < (speeds ⟨3, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv4pos : (0 : ℝ) < (speeds ⟨4, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv3_lt_v4 : (speeds ⟨3, by omega⟩ : ℝ) < (speeds ⟨4, by omega⟩ : ℝ) := by
    have hmlt : speeds ⟨3, by omega⟩ < speeds ⟨4, by omega⟩ :=
      hmono (show (⟨3, by omega⟩ : Fin 5) < ⟨4, by omega⟩ by decide)
    exact_mod_cast hmlt
  set v3 : ℝ := (speeds ⟨3, by omega⟩ : ℝ) with hv3def
  set v4 : ℝ := (speeds ⟨4, by omega⟩ : ℝ) with hv4def
  -- Proof by contradiction
  by_contra hcontra
  push_neg at hcontra
  -- hcontra : 2 / (3 * v3) ≤ b - a
  -- Restrict to J = [a, a + 2/(3 v3)] ⊆ [a, b]
  set L : ℝ := 2 / (3 * v3) with hLdef
  have hL_pos : 0 < L := by positivity
  set b' : ℝ := a + L with hb'def
  have hb'_le_b : b' ≤ b := by rw [hb'def]; linarith
  have hab' : a ≤ b' := by rw [hb'def]; linarith
  have hJ_sub : Set.Icc a b' ⊆ unsafeOf speeds ⟨3, by omega⟩ ∪
                                unsafeOf speeds ⟨4, by omega⟩ := by
    intro t ⟨ht1, ht2⟩
    exact hI ⟨ht1, le_trans ht2 hb'_le_b⟩
  -- Set m = ⌊v3 · a⌋ so that v3 · a = m + s with s = fract(v3 · a) ∈ [0, 1).
  set m : ℤ := ⌊v3 * a⌋ with hmdef
  set s : ℝ := Int.fract (v3 * a) with hsdef
  have hs_nonneg : 0 ≤ s := Int.fract_nonneg _
  have hs_lt_one : s < 1 := Int.fract_lt_one _
  have hva_eq : v3 * a = (m : ℝ) + s := by
    rw [hsdef, hmdef]
    have := Int.floor_add_fract (v3 * a)
    linarith
  -- We will derive a contradiction by case analysis on s.
  -- The bound we want is `v_4 < v_3` (contradiction with hmono) from a single
  -- gap-piece of v3-coord length ≥ 1/3.
  -- KEY LEMMA: if (sL, sR) is a 3-gap-piece in [a, b'] of v3-coord length ≥ 1/3,
  -- then 1/(3 v3) ≤ sR - sL < 1/(3 v4), so v4 < v3, contradicting hmono.
  -- Cases A (s ∈ [0, 1/6]), B (s ∈ (1/6, 1/2]), D (s ∈ [5/6, 1))
  -- all yield a single gap-piece of v3-coord length ≥ 1/3.
  -- Case C (s ∈ (1/2, 5/6)) is the BHK-residual; we use a different argument.
  rcases lt_or_ge s (1/2) with hs_half | hs_half
  · -- s < 1/2: cases A (s ≤ 1/6) and B (1/6 < s < 1/2)
    -- In both, use the single gap-piece [max(a, (m+1/6)/v3), (m+5/6)/v3]
    -- = [(m+1/6)/v3, (m+5/6)/v3] when s ≤ 1/6 (=case A, gap fully in J)
    --   has length (m + 5/6 - (m + 1/6))/v3 = 2/3 / v3 ≥ 1/3 / v3
    -- = [(m+s)/v3, (m+5/6)/v3] when 1/6 < s < 1/2 (=case B, gap starts at a)
    --   wait, but (m+s)/v3 = a only if a is in the 3-gap, i.e., s ≥ 1/6
    --
    -- Let's define sL, sR carefully:
    -- sL = max(a, (m+1/6)/v3), sR = min(b', (m+5/6)/v3)
    -- For s ∈ [0, 1/2): we want sR - sL ≥ 1/(3 v3).
    set sL : ℝ := max a ((↑m + 1/6) / v3) with hsLdef
    set sR : ℝ := min b' ((↑m + 5/6) / v3) with hsRdef
    -- Need: a ≤ sL, sR ≤ b', sL ≤ sR, and gap conditions.
    have hsL_ge_a : a ≤ sL := le_max_left _ _
    have hsR_le_b' : sR ≤ b' := min_le_left _ _
    have hsL_ge_gap : ((↑m : ℝ) + 1/6) / v3 ≤ sL := le_max_right _ _
    have hsR_le_gap : sR ≤ ((↑m : ℝ) + 5/6) / v3 := min_le_right _ _
    -- Compute sL and sR explicitly:
    -- a = (m+s)/v3, so a vs (m+1/6)/v3: a ≤ (m+1/6)/v3 ⟺ m + s ≤ m + 1/6 ⟺ s ≤ 1/6
    -- Case A (s ≤ 1/6): sL = (m+1/6)/v3.
    -- Case B (1/6 < s < 1/2): sL = a = (m+s)/v3.
    -- b' = a + 2/(3 v3) = (m+s)/v3 + 2/(3 v3) = (m + s + 2/3)/v3
    -- b' vs (m+5/6)/v3: b' ≤ (m+5/6)/v3 ⟺ m + s + 2/3 ≤ m + 5/6 ⟺ s ≤ 1/6
    -- Case A: sR = b' = (m+s+2/3)/v3, length = (s+2/3-1/6)/v3 = (s+1/2)/v3 ≥ 1/2/v3
    -- Case B: sR = (m+5/6)/v3, length = (5/6-s)/v3 ≥ 1/3/v3 (since s ≤ 1/2 ⇒ 5/6-s ≥ 1/3)
    have ha_eq : a = ((↑m : ℝ) + s) / v3 := by
      rw [eq_div_iff (ne_of_gt hv3pos)]; linarith [hva_eq]
    have hb'_eq : b' = ((↑m : ℝ) + s + 2/3) / v3 := by
      rw [hb'def, hLdef, ha_eq]
      field_simp
    have hsLR : sL ≤ sR := by
      rw [hsLdef, hsRdef]
      rw [ha_eq, hb'_eq]
      -- max ((m+s)/v3) ((m+1/6)/v3) ≤ min ((m+s+2/3)/v3) ((m+5/6)/v3)
      apply max_le
      · apply le_min
        · have : (↑m : ℝ) + s ≤ (↑m : ℝ) + s + 2/3 := by linarith
          exact div_le_div_of_nonneg_right this (le_of_lt hv3pos)
        · -- (m+s)/v3 ≤ (m+5/6)/v3 ⟺ s ≤ 5/6, which holds since s < 1/2
          have : (↑m : ℝ) + s ≤ (↑m : ℝ) + 5/6 := by linarith
          exact div_le_div_of_nonneg_right this (le_of_lt hv3pos)
      · apply le_min
        · -- (m+1/6)/v3 ≤ (m+s+2/3)/v3 ⟺ 1/6 ≤ s + 2/3 ⟺ s ≥ -1/2 ✓
          have : (↑m : ℝ) + 1/6 ≤ (↑m : ℝ) + s + 2/3 := by linarith
          exact div_le_div_of_nonneg_right this (le_of_lt hv3pos)
        · have : (↑m : ℝ) + 1/6 ≤ (↑m : ℝ) + 5/6 := by linarith
          exact div_le_div_of_nonneg_right this (le_of_lt hv3pos)
    -- Apply gap_piece_bound
    have hgap : sR - sL < 1 / (3 * v4) := by
      have := gap_piece_bound speeds hpos a b' hab' hJ_sub m sL sR
        hsL_ge_a hsR_le_b' hsLR hsL_ge_gap hsR_le_gap
      exact this
    -- Now bound sR - sL ≥ 1/(3 v3) in both cases A and B
    have hgap_len_ge : 1 / (3 * v3) ≤ sR - sL := by
      rw [hsLdef, hsRdef]
      have ha_eq : a = ((↑m : ℝ) + s) / v3 := by
        field_simp; linarith [hva_eq]
      have hb'_eq : b' = ((↑m : ℝ) + s + 2/3) / v3 := by
        rw [hb'def, hLdef]
        field_simp; linarith [hva_eq]
      rw [ha_eq, hb'_eq]
      -- min ((m+s+2/3)/v3) ((m+5/6)/v3) - max ((m+s)/v3) ((m+1/6)/v3) ≥ 1/(3v3)
      -- Numerator: min(m+s+2/3, m+5/6) - max(m+s, m+1/6)
      -- = m + min(s+2/3, 5/6) - m - max(s, 1/6)
      -- = min(s+2/3, 5/6) - max(s, 1/6)
      -- Case A (s ≤ 1/6): min = s+2/3 (≤ 5/6 iff s ≤ 1/6), max = 1/6.
      --   Numerator = s + 2/3 - 1/6 = s + 1/2 ≥ 1/2 ≥ 1/3
      -- Case B (s > 1/6): min = 5/6, max = s.
      --   Numerator = 5/6 - s ≥ 1/3 (since s ≤ 1/2 ⇒ 5/6 - s ≥ 1/3)
      have hmin_max : min ((↑m : ℝ) + s + 2/3) ((↑m : ℝ) + 5/6) -
                       max ((↑m : ℝ) + s) ((↑m : ℝ) + 1/6) ≥ 1/3 := by
        rcases le_or_gt s (1/6) with hsA | hsA
        · -- Case A: min = m+s+2/3 (since s+2/3 ≤ 5/6), max = m+1/6
          rw [min_eq_left (by linarith), max_eq_right (by linarith)]
          linarith
        · -- Case B: min = m+5/6 (since s+2/3 ≥ 5/6 iff s ≥ 1/6), max = m+s
          rw [min_eq_right (by linarith), max_eq_left (by linarith)]
          linarith
      -- min ((m+s+2/3)/v3) ((m+5/6)/v3) = min (m+s+2/3, m+5/6) / v3
      have hmin_div : min (((↑m : ℝ) + s + 2/3) / v3) (((↑m : ℝ) + 5/6) / v3)
                      = min ((↑m : ℝ) + s + 2/3) ((↑m : ℝ) + 5/6) / v3 := by
        rcases le_or_gt ((↑m : ℝ) + s + 2/3) ((↑m : ℝ) + 5/6) with h | h
        · rw [min_eq_left h, min_eq_left (div_le_div_of_nonneg_right h (le_of_lt hv3pos))]
        · rw [min_eq_right (le_of_lt h),
              min_eq_right (div_le_div_of_nonneg_right (le_of_lt h) (le_of_lt hv3pos))]
      have hmax_div : max (((↑m : ℝ) + s) / v3) (((↑m : ℝ) + 1/6) / v3)
                      = max ((↑m : ℝ) + s) ((↑m : ℝ) + 1/6) / v3 := by
        rcases le_or_gt ((↑m : ℝ) + s) ((↑m : ℝ) + 1/6) with h | h
        · rw [max_eq_right h, max_eq_right (div_le_div_of_nonneg_right h (le_of_lt hv3pos))]
        · rw [max_eq_left (le_of_lt h),
              max_eq_left (div_le_div_of_nonneg_right (le_of_lt h) (le_of_lt hv3pos))]
      rw [hmin_div, hmax_div]
      rw [div_sub_div_same, le_div_iff₀ hv3pos]
      have : 1 / (3 * v3) * v3 = 1/3 := by field_simp
      rw [this]
      linarith
    -- 1/(3 v3) ≤ sR - sL < 1/(3 v4) ⇒ 1/(3 v3) < 1/(3 v4) ⇒ v4 < v3
    have hcontr : 1 / (3 * v3) < 1 / (3 * v4) := lt_of_le_of_lt hgap_len_ge hgap
    have hv4_lt_v3 : v4 < v3 := by
      rw [div_lt_div_iff₀ (by positivity) (by positivity)] at hcontr
      linarith
    linarith
  · -- s ≥ 1/2: cases C (1/2 ≤ s < 5/6) and D (s ≥ 5/6)
    rcases lt_or_ge s (5/6) with hs_56 | hs_56
    · -- Case C: s ∈ [1/2, 5/6). The genuine BHK k ≥ 2 case — gap-piece +
      -- 4-block + gap-piece decomposition, closed by the two-5-block
      -- separation count in `bhk_lemma_4_case_C`.
      exact bhk_lemma_4_case_C speeds hmono hpos a b hab hI hcontra hs_half hs_56
    · -- Case D: s ∈ [5/6, 1). Gap-piece at m+1 has v3-coord length ≥ 1/3.
      -- sL = (m+1+1/6)/v3 = (m+7/6)/v3, sR = b' = a + 2/(3v3) = (m+s+2/3)/v3
      -- length = (s+2/3 - 7/6)/v3 = (s - 1/2)/v3 ≥ 1/3/v3 (since s ≥ 5/6)
      have ha_eq : a = ((↑m : ℝ) + s) / v3 := by
        rw [eq_div_iff (ne_of_gt hv3pos)]; linarith [hva_eq]
      have hb'_eq : b' = ((↑m : ℝ) + s + 2/3) / v3 := by
        rw [hb'def, hLdef, ha_eq]
        field_simp
      set sL : ℝ := ((↑m : ℝ) + 7/6) / v3 with hsLdef
      let sR : ℝ := b'
      have hsR_eq : sR = ((↑m : ℝ) + s + 2/3) / v3 := hb'_eq
      have hsL_ge_a : a ≤ sL := by
        rw [hsLdef, ha_eq]
        apply div_le_div_of_nonneg_right _ (le_of_lt hv3pos)
        linarith
      have hsR_le_b' : sR ≤ b' := le_refl _
      have hsLR : sL ≤ sR := by
        change sL ≤ b'
        rw [hsLdef, hb'_eq]
        apply div_le_div_of_nonneg_right _ (le_of_lt hv3pos)
        linarith
      have hsL_ge_gap : ((↑(m + 1) : ℝ) + 1/6) / v3 ≤ sL := by
        rw [hsLdef]
        push_cast
        apply div_le_div_of_nonneg_right _ (le_of_lt hv3pos)
        linarith
      have hsR_le_gap : sR ≤ ((↑(m + 1) : ℝ) + 5/6) / v3 := by
        change b' ≤ _
        rw [hb'_eq]
        push_cast
        apply div_le_div_of_nonneg_right _ (le_of_lt hv3pos)
        linarith
      have hgap : sR - sL < 1 / (3 * v4) :=
        gap_piece_bound speeds hpos a b' hab' hJ_sub (m+1) sL sR
          hsL_ge_a hsR_le_b' hsLR hsL_ge_gap hsR_le_gap
      have hgap_len_ge : 1 / (3 * v3) ≤ sR - sL := by
        change 1 / (3 * v3) ≤ b' - sL
        rw [hsLdef, hb'_eq]
        rw [div_sub_div_same, le_div_iff₀ hv3pos]
        have : 1 / (3 * v3) * v3 = 1/3 := by field_simp
        rw [this]
        linarith
      have hcontr : 1 / (3 * v3) < 1 / (3 * v4) := lt_of_le_of_lt hgap_len_ge hgap
      have hv4_lt_v3 : v4 < v3 := by
        rw [div_lt_div_iff₀ (by positivity) (by positivity)] at hcontr
        linarith
      linarith

/-- **§8 structural fact `v_4 < 2 v_3`.** Under failure of loneliness
    (`h_no_lonely`) and the §8 entry condition `hlarge : v_3 ≤ 3 v_1`,
    apply `bhk_lemma_4` to the 123-gap `[1/(6 v_1), 5/(6 v_3)]` to derive
    `v_4 < 2 v_3`.

    Strategy (mirrors `bhk_case_8_2_1`'s opening derivation):
    1. The 123-gap `[1/(6 v_1), 5/(6 v_3)]` is in `unsafeOf ⟨3⟩ ∪ unsafeOf ⟨4⟩`
       because for any `t` in the gap, `h_no_lonely` gives some runner `i`,
       and runners 0, 1, 2 are ruled out by their `k=0` block-gap arguments
       (using `hlarge` and monotonicity to compare `1/(6 v_i) ≤ 1/(6 v_1)`
       and `5/(6 v_3) ≤ 5/(6 v_i)`).
    2. `bhk_lemma_4` gives the length bound `5/(6 v_3) - 1/(6 v_1) < 2/(3 v_4)`.
    3. `hlarge` gives the length lower bound `1/(3 v_3) ≤ 5/(6 v_3) - 1/(6 v_1)`
       (because `5 v_1 - v_3 ≥ 2 v_1`).
    4. Chain: `1/(3 v_3) < 2/(3 v_4)`, so `v_4 < 2 v_3`.

    Reusable across §8 sub-cases. -/
lemma bhk_8_v4_lt_2v3 (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i)
    (hlarge : speeds ⟨2, by omega⟩ ≤ 3 * speeds ⟨0, by omega⟩)
    (h_no_lonely : ∀ t : ℝ, ∃ i, circDist ((speeds i : ℝ) * t) < 1/6) :
    (speeds ⟨3, by omega⟩ : ℝ) < 2 * (speeds ⟨2, by omega⟩ : ℝ) := by
  set v1 : ℝ := (speeds ⟨0, by omega⟩ : ℝ) with hv1_def
  set v2 : ℝ := (speeds ⟨1, by omega⟩ : ℝ) with hv2_def
  set v3 : ℝ := (speeds ⟨2, by omega⟩ : ℝ) with hv3_def
  set v4 : ℝ := (speeds ⟨3, by omega⟩ : ℝ) with hv4_def
  have hv1_pos : 0 < v1 := by rw [hv1_def]; exact_mod_cast hpos _
  have hv2_pos : 0 < v2 := by rw [hv2_def]; exact_mod_cast hpos _
  have hv3_pos : 0 < v3 := by rw [hv3_def]; exact_mod_cast hpos _
  have hv4_pos : 0 < v4 := by rw [hv4_def]; exact_mod_cast hpos _
  have hv1_le_v2 : v1 ≤ v2 := by
    rw [hv1_def, hv2_def]
    exact_mod_cast Nat.le_of_lt
      (hmono (Fin.mk_lt_mk.mpr (show (0:ℕ) < 1 by omega)))
  have hv1_le_v3 : v1 ≤ v3 := by
    rw [hv1_def, hv3_def]
    exact_mod_cast Nat.le_of_lt
      (hmono (Fin.mk_lt_mk.mpr (show (0:ℕ) < 2 by omega)))
  have hv2_le_v3 : v2 ≤ v3 := by
    rw [hv2_def, hv3_def]
    exact_mod_cast Nat.le_of_lt
      (hmono (Fin.mk_lt_mk.mpr (show (1:ℕ) < 2 by omega)))
  have hlargeR : v3 ≤ 3 * v1 := by
    rw [hv1_def, hv3_def]; exact_mod_cast hlarge
  -- (1) 123-gap inclusion `[1/(6 v_1), 5/(6 v_3)] ⊆ unsafeOf ⟨3⟩ ∪ unsafeOf ⟨4⟩`.
  have h_123_incl : Set.Icc (1 / (6 * v1)) (5 / (6 * v3)) ⊆
      unsafeOf speeds ⟨3, by omega⟩ ∪ unsafeOf speeds ⟨4, by omega⟩ := by
    intro t ht
    obtain ⟨htL, htR⟩ := ht
    obtain ⟨i, hi_unsafe⟩ := h_no_lonely t
    rw [← mem_unsafeOf_iff] at hi_unsafe
    have hnot0 : t ∉ unsafeOf speeds ⟨0, by omega⟩ := by
      apply not_mem_unsafeOf_of_in_gap speeds ⟨0, by omega⟩ (hpos _) 0 t
      · rw [show ((0:ℤ):ℝ) + 1/6 = 1/6 from by norm_num, div_div]
        rw [hv1_def] at htL; exact htL
      · rw [show ((0:ℤ):ℝ) + 5/6 = 5/6 from by norm_num, div_div]
        calc t ≤ 5 / (6 * v3) := htR
          _ ≤ 5 / (6 * (speeds ⟨0, by omega⟩ : ℝ)) := by
              rw [hv1_def] at hv1_le_v3 hv1_pos
              apply div_le_div_of_nonneg_left (by norm_num) (by positivity)
              nlinarith [hv1_le_v3, hv1_pos, hv3_pos]
    have hnot1 : t ∉ unsafeOf speeds ⟨1, by omega⟩ := by
      apply not_mem_unsafeOf_of_in_gap speeds ⟨1, by omega⟩ (hpos _) 0 t
      · rw [show ((0:ℤ):ℝ) + 1/6 = 1/6 from by norm_num, div_div]
        calc (1 : ℝ) / (6 * (speeds ⟨1, by omega⟩ : ℝ))
            ≤ 1 / (6 * v1) := by
              rw [hv2_def] at hv1_le_v2
              apply div_le_div_of_nonneg_left (by norm_num) (by positivity)
              nlinarith [hv1_le_v2, hv1_pos, hv2_pos]
          _ ≤ t := by rw [hv1_def] at htL; exact htL
      · rw [show ((0:ℤ):ℝ) + 5/6 = 5/6 from by norm_num, div_div]
        calc t ≤ 5 / (6 * v3) := htR
          _ ≤ 5 / (6 * (speeds ⟨1, by omega⟩ : ℝ)) := by
              rw [hv2_def] at hv2_le_v3
              apply div_le_div_of_nonneg_left (by norm_num) (by positivity)
              nlinarith [hv2_le_v3, hv2_pos, hv3_pos]
    have hnot2 : t ∉ unsafeOf speeds ⟨2, by omega⟩ := by
      apply not_mem_unsafeOf_of_in_gap speeds ⟨2, by omega⟩ (hpos _) 0 t
      · rw [show ((0:ℤ):ℝ) + 1/6 = 1/6 from by norm_num, div_div]
        calc (1 : ℝ) / (6 * (speeds ⟨2, by omega⟩ : ℝ))
            ≤ 1 / (6 * v1) := by
              rw [hv3_def] at hv1_le_v3
              apply div_le_div_of_nonneg_left (by norm_num) (by positivity)
              nlinarith [hv1_le_v3, hv1_pos, hv3_pos]
          _ ≤ t := by rw [hv1_def] at htL; exact htL
      · rw [show ((0:ℤ):ℝ) + 5/6 = 5/6 from by norm_num, div_div]
        rw [hv3_def] at htR; exact htR
    fin_cases i
    · exact absurd hi_unsafe hnot0
    · exact absurd hi_unsafe hnot1
    · exact absurd hi_unsafe hnot2
    · exact Or.inl hi_unsafe
    · exact Or.inr hi_unsafe
  -- (2) `a ≤ b`: `1/(6 v_1) ≤ 5/(6 v_3)` from hlarge (`v_3 ≤ 3 v_1 ≤ 5 v_1`).
  have h_a_le_b : 1 / (6 * v1) ≤ 5 / (6 * v3) := by
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    nlinarith [hlargeR, hv1_pos, hv3_pos]
  -- (3) bhk_lemma_4 gives `5/(6 v_3) - 1/(6 v_1) < 2/(3 v_4)`.
  have h_len_bd : 5 / (6 * v3) - 1 / (6 * v1) < 2 / (3 * v4) := by
    have h := bhk_lemma_4 speeds hmono hpos
      (1 / (6 * v1)) (5 / (6 * v3)) h_a_le_b
      (by intro t ht; exact h_123_incl ht)
    rw [hv4_def]; exact h
  -- (4) `1/(3 v_3) ≤ 5/(6 v_3) - 1/(6 v_1)` from hlarge (`5 v_1 - v_3 ≥ 2 v_1`).
  have hbd : 1 / (3 * v3) ≤ 5 / (6 * v3) - 1 / (6 * v1) := by
    have key : (5 / (6 * v3) - 1 / (6 * v1)) * (6 * v3 * v1) = 5 * v1 - v3 := by
      field_simp
    have key2 : 1 / (3 * v3) * (6 * v3 * v1) = 2 * v1 := by
      field_simp; ring
    nlinarith [key, key2, hlargeR, hv1_pos, hv3_pos,
               mul_pos hv1_pos hv3_pos]
  -- (5) Chain: `1/(3 v_3) < 2/(3 v_4)`, hence `v_4 < 2 v_3`.
  have hlt : 1 / (3 * v3) < 2 / (3 * v4) := lt_of_le_of_lt hbd h_len_bd
  rw [div_lt_div_iff₀ (by positivity) (by positivity)] at hlt
  linarith

/-- **BHK Corollary 5.** If a closed interval `[a, b]` is contained in the
    complement of `unsafeOf 0 ∪ unsafeOf 1 ∪ unsafeOf 2` (a 123-gap) and has
    length `≥ 2 / (3 v_3)`, then it contains a time lonely for all 5 runners.

    Proof: if no lonely time, then `[a, b] ⊆ unsafeOf 3 ∪ unsafeOf 4`; Lemma 4
    bounds this length by `< 2 / (3 v_4) < 2 / (3 v_3)`, contradiction. -/
theorem bhk_corollary_5 (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i)
    (a b : ℝ) (hab : a ≤ b)
    (h123gap : Set.Icc a b ⊆ (unsafeOf speeds ⟨0, by omega⟩ ∪
                              unsafeOf speeds ⟨1, by omega⟩ ∪
                              unsafeOf speeds ⟨2, by omega⟩)ᶜ)
    (h3len : 2 / (3 * (speeds ⟨2, by omega⟩ : ℝ)) ≤ b - a) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 6 := by
  by_contra hne
  push_neg at hne
  have hcover : Set.Icc a b ⊆ unsafeOf speeds ⟨3, by omega⟩ ∪
                              unsafeOf speeds ⟨4, by omega⟩ := by
    intro t ht
    obtain ⟨i, hi⟩ := hne t
    have h123 : t ∉ unsafeOf speeds ⟨0, by omega⟩ ∪
                    unsafeOf speeds ⟨1, by omega⟩ ∪
                    unsafeOf speeds ⟨2, by omega⟩ := h123gap ht
    have ht_unsafe : t ∈ unsafeOf speeds i := (mem_unsafeOf_iff speeds i t).mpr hi
    fin_cases i
    · exact absurd (Or.inl (Or.inl ht_unsafe)) h123
    · exact absurd (Or.inl (Or.inr ht_unsafe)) h123
    · exact absurd (Or.inr ht_unsafe) h123
    · exact Or.inl ht_unsafe
    · exact Or.inr ht_unsafe
  have hbnd : b - a < 2 / (3 * (speeds ⟨3, by omega⟩ : ℝ)) :=
    bhk_lemma_4 speeds hmono hpos a b hab hcover
  have hv3pos : (0 : ℝ) < speeds ⟨2, by omega⟩ := by exact_mod_cast hpos _
  have hv4pos : (0 : ℝ) < speeds ⟨3, by omega⟩ := by exact_mod_cast hpos _
  have hlt : (speeds ⟨2, by omega⟩ : ℝ) < speeds ⟨3, by omega⟩ := by
    have : speeds ⟨2, by omega⟩ < speeds ⟨3, by omega⟩ :=
      hmono (show (⟨2, by omega⟩ : Fin 5) < ⟨3, by omega⟩ by decide)
    exact_mod_cast this
  have hcmp : 2 / (3 * (speeds ⟨3, by omega⟩ : ℝ)) <
              2 / (3 * (speeds ⟨2, by omega⟩ : ℝ)) := by
    apply div_lt_div_of_pos_left (by norm_num) (by positivity)
    linarith
  linarith

end BHK

end


/-
───────────────────────────────────────────────────────────────────────────────
  PART 13: IntLRC_6_BHK_Lemma7.lean
───────────────────────────────────────────────────────────────────────────────
-/
section

/-!
# BHK Lemma 7 — the order bound for a minimal group element

BHK strengthen the notion of "minimal element" used in the Main Lemma and
Corollary 6.  For `i, j ≥ 0` let

  `Z_{i,j} = [-i, i] × [-j, j] \ {(±i, ±j)}`

and call `(i/n, j/n) ∈ G` *minimal* (BHK (13)) when
`{(k/n, l/n) : (k, l) ∈ Z_{|i|,|j|} ∩ G} = {(0, 0)}`.  Lemma 7 is the lower
bound on the order `n = |G|` of a group having such a minimal element:

  `|i|, |j| ≥ 1 ⇒ n ≥ (|i| + 1)(|j| + 1) − 2`  (BHK (14), main part).

**Proof (BHK).**  Put `Y = [0, i] × [0, j] \ {(i, 0), (i, j)}`, so that
`Y − Y ⊆ Z_{i,j}` (removing the two points `(i,0)`, `(i,j)` is exactly what
prevents a difference of two `Y`-points from landing on a corner `(±i, ±j)`).
Minimality then makes the translates `{g + Y : g ∈ G}` pairwise disjoint, so the
map `G × Y → (ℤ/n)²`, `(g, y) ↦ g + y`, is injective.  Hence
`|G| · |Y| ≤ n²`, and with `|G| = n`, `|Y| = (i+1)(j+1) − 2` this gives (14).

This is the combinatorial prerequisite for the §5 (Proposition 11) exceptional
-pair reductions: combined with the "full vertical length `1/6 ⟹ q < 6|j|`"
upper bound it eliminates the high-`|j|` and `gcd(i,q) > 1` anti-diagonal pairs
that the pure-congruence kills (`bhk_prop11_exc_anti_diag`, gcd 1 only) cannot
reach.

## Source

T. Bohman, R. Holzman, D. Kleitman, *Six Lonely Runners*, EJC **8** (2001) R3,
§3.3 (Lemma 7) — pp. 11.
-/

open scoped Finset

namespace BHK

/-- **BHK Lemma 7, main part (combinatorial core over `H`).**  Let
`H ⊆ (ℤ/n)²` be a subgroup of order `n` (`n > 1`), and let `i, j ≥ 1` with
`i, j < n` (so the box `[0,i] × [0,j]` embeds injectively into `(ℤ/n)²`).
If `H` contains no nonzero point of `Z_{i,j} = [-i,i] × [-j,j] \ {(±i, ±j)}`
(the (13)-minimality hypothesis), then `n ≥ (i+1)(j+1) − 2`. -/
lemma bhk_lemma7_card (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH : Nat.card H = n)
    (i j : ℕ) (hi : 1 ≤ i) (hj : 1 ≤ j) (hin : i < n) (hjn : j < n)
    (hmin : ∀ k l : ℤ, (k, l) ≠ (0, 0) → |k| ≤ (i : ℤ) → |l| ≤ (j : ℤ) →
        ¬(|k| = (i : ℤ) ∧ |l| = (j : ℤ)) →
        (((k : ZMod n), (l : ZMod n)) : ZMod n × ZMod n) ∉ H) :
    (i + 1) * (j + 1) - 2 ≤ n := by
  classical
  haveI : NeZero n := ⟨by omega⟩
  -- The box of representatives `[0,i] × [0,j]` (as `ℕ × ℕ`) and the two
  -- corner points BHK removes.
  set box : Finset (ℕ × ℕ) := Finset.range (i + 1) ×ˢ Finset.range (j + 1) with hbox
  set corners : Finset (ℕ × ℕ) := {(i, 0), (i, j)} with hcorners
  set Y₀ : Finset (ℕ × ℕ) := box \ corners with hY₀
  -- The embedding into the torus group.
  set emb : ℕ × ℕ → ZMod n × ZMod n := fun ab => ((ab.1 : ZMod n), (ab.2 : ZMod n)) with hemb
  set Y : Finset (ZMod n × ZMod n) := Y₀.image emb with hYdef
  set S : Finset (ZMod n × ZMod n) := Finset.univ.filter (· ∈ H) with hSdef
  -- `emb` is injective on the box (coords `< n`).
  have hcast_inj : ∀ a b : ℕ, a < n → b < n → (a : ZMod n) = (b : ZMod n) → a = b := by
    intro a b ha hb hab
    have := congrArg ZMod.val hab
    rwa [ZMod.val_natCast, ZMod.val_natCast, Nat.mod_eq_of_lt ha, Nat.mod_eq_of_lt hb] at this
  have hemb_injOn : Set.InjOn emb box := by
    intro x hx y hy hxy
    rw [Finset.coe_product, Set.mem_prod] at hx hy
    simp only [Finset.coe_range, Set.mem_Iio] at hx hy
    obtain ⟨hx1, hx2⟩ := hx; obtain ⟨hy1, hy2⟩ := hy
    have h1 : x.1 = y.1 := hcast_inj _ _ (by omega) (by omega) (congrArg Prod.fst hxy)
    have h2 : x.2 = y.2 := hcast_inj _ _ (by omega) (by omega) (congrArg Prod.snd hxy)
    exact Prod.ext h1 h2
  -- `|Y| = (i+1)(j+1) - 2`.
  have hbox_card : box.card = (i + 1) * (j + 1) := by
    rw [hbox, Finset.card_product, Finset.card_range, Finset.card_range]
  have hcorners_sub : corners ⊆ box := by
    rw [hcorners, Finset.insert_subset_iff, Finset.singleton_subset_iff, hbox]
    exact ⟨Finset.mk_mem_product (Finset.mem_range.mpr (by omega)) (Finset.mem_range.mpr (by omega)),
           Finset.mk_mem_product (Finset.mem_range.mpr (by omega)) (Finset.mem_range.mpr (by omega))⟩
  have hcorners_card : corners.card = 2 := by
    rw [hcorners]
    exact Finset.card_pair (by intro hcon; rw [Prod.mk.injEq] at hcon; omega)
  have hY₀_card : Y₀.card = (i + 1) * (j + 1) - 2 := by
    have hcard := Finset.card_sdiff_add_card_eq_card hcorners_sub
    rw [← hY₀, hbox_card, hcorners_card] at hcard
    omega
  have hY_card : Y.card = (i + 1) * (j + 1) - 2 := by
    rw [hYdef, Finset.card_image_of_injOn (hemb_injOn.mono (by rw [hY₀]; exact Finset.sdiff_subset)),
      hY₀_card]
  -- `|S| = n`.
  have hS_card : S.card = n := by
    rw [hSdef, ← Fintype.card_subtype (· ∈ H), ← Nat.card_eq_fintype_card]
    exact hH
  -- The map `(g, y) ↦ g + y` is injective on `S ×ˢ Y`.
  have hmap_inj : Set.InjOn (fun p : (ZMod n × ZMod n) × (ZMod n × ZMod n) => p.1 + p.2)
      (↑(S ×ˢ Y) : Set ((ZMod n × ZMod n) × (ZMod n × ZMod n))) := by
    intro p hp p' hp' heq
    rw [Finset.mem_coe, Finset.mem_product] at hp hp'
    obtain ⟨hpS, hpY⟩ := hp
    obtain ⟨hp'S, hp'Y⟩ := hp'
    rw [hSdef, Finset.mem_filter] at hpS hp'S
    obtain ⟨-, hpH⟩ := hpS
    obtain ⟨-, hp'H⟩ := hp'S
    rw [hYdef, Finset.mem_image] at hpY hp'Y
    obtain ⟨⟨a₁, b₁⟩, hab₁, hemb₁⟩ := hpY
    obtain ⟨⟨a₂, b₂⟩, hab₂, hemb₂⟩ := hp'Y
    simp only [hemb] at hemb₁ hemb₂
    -- box bounds and corner exclusions for both representatives
    rw [hY₀, Finset.mem_sdiff] at hab₁ hab₂
    obtain ⟨hin₁, hcor₁⟩ := hab₁
    obtain ⟨hin₂, hcor₂⟩ := hab₂
    rw [hbox, Finset.mem_product, Finset.mem_range, Finset.mem_range] at hin₁ hin₂
    obtain ⟨ha₁, hb₁⟩ := hin₁
    obtain ⟨ha₂, hb₂⟩ := hin₂
    rw [hcorners, Finset.mem_insert, Finset.mem_singleton, not_or] at hcor₁ hcor₂
    -- `heq` as an equation of group elements
    have h : p.1 + p.2 = p'.1 + p'.2 := heq
    -- `p'.2 - p.2 ∈ H`
    have hdiff_mem : p'.2 - p.2 ∈ H := by
      have hsub : p'.2 - p.2 = p.1 - p'.1 := by linear_combination -h
      rw [hsub]; exact H.sub_mem hpH hp'H
    -- identify the difference with the integer pair `(a₂-a₁, b₂-b₁)` reduced mod n
    set k : ℤ := (a₂ : ℤ) - (a₁ : ℤ) with hk
    set l : ℤ := (b₂ : ℤ) - (b₁ : ℤ) with hl
    have hmem_kl : (((k : ZMod n), (l : ZMod n)) : ZMod n × ZMod n) ∈ H := by
      have heqkl : (((k : ZMod n), (l : ZMod n)) : ZMod n × ZMod n) = p'.2 - p.2 := by
        rw [← hemb₂, ← hemb₁, hk, hl, Prod.mk_sub_mk, Prod.mk.injEq]
        constructor <;> push_cast <;> ring
      rw [heqkl]; exact hdiff_mem
    have hk_abs : |k| ≤ (i : ℤ) := by rw [hk, abs_le]; omega
    have hl_abs : |l| ≤ (j : ℤ) := by rw [hl, abs_le]; omega
    by_cases hkl0 : (k, l) = (0, 0)
    · -- zero difference: the box reps coincide, hence both coordinates do
      have hk0 : k = 0 := congrArg Prod.fst hkl0
      have hl0 : l = 0 := congrArg Prod.snd hkl0
      have ha : a₁ = a₂ := by rw [hk] at hk0; omega
      have hb : b₁ = b₂ := by rw [hl] at hl0; omega
      have hp2eq : p.2 = p'.2 := by rw [← hemb₁, ← hemb₂, ha, hb]
      have hp1eq : p.1 = p'.1 := by rw [hp2eq] at h; exact add_right_cancel h
      exact Prod.ext hp1eq hp2eq
    · exfalso
      by_cases hcorner : |k| = (i : ℤ) ∧ |l| = (j : ℤ)
      · -- corner difference: one of the box reps is a removed corner
        obtain ⟨hki, hlj⟩ := hcorner
        rw [hk, abs_eq (by positivity)] at hki
        rw [hl, abs_eq (by positivity)] at hlj
        rcases hki with hki | hki <;> rcases hlj with hlj | hlj
        · -- a₂=i,a₁=0,b₂=j,b₁=0 : (a₂,b₂)=(i,j)
          exact hcor₂.2 (Prod.ext (by omega) (by omega))
        · -- a₂=i,a₁=0,b₂=0,b₁=j : (a₂,b₂)=(i,0)
          exact hcor₂.1 (Prod.ext (by omega) (by omega))
        · -- a₂=0,a₁=i,b₂=j,b₁=0 : (a₁,b₁)=(i,0)
          exact hcor₁.1 (Prod.ext (by omega) (by omega))
        · -- a₂=0,a₁=i,b₂=0,b₁=j : (a₁,b₁)=(i,j)
          exact hcor₁.2 (Prod.ext (by omega) (by omega))
      · exact hmin k l hkl0 hk_abs hl_abs hcorner hmem_kl
  -- counting: `|S| · |Y| ≤ n²`
  have hcard_le : (S ×ˢ Y).card ≤ (Finset.univ : Finset (ZMod n × ZMod n)).card :=
    Finset.card_le_card_of_injOn (fun p => p.1 + p.2) (fun _ _ => Finset.mem_univ _) hmap_inj
  have huniv : (Finset.univ : Finset (ZMod n × ZMod n)).card = n * n := by
    simp only [Finset.card_univ, Fintype.card_prod, ZMod.card]
  rw [Finset.card_product, hS_card, hY_card, huniv] at hcard_le
  -- cancel the factor `n`
  exact Nat.le_of_mul_le_mul_left hcard_le (by omega)

/-- **BHK Lemma 7, main part (group form).**  Phrased over `IsBHKLift G n` and the
(13)-minimality predicate exactly as produced by `bhk_s7_corollary_6_minimal`
(`((k/n, l/n) ∉ G)` for the off-corner box points).  For a minimal nonzero pair
`(i, j)` with `i, j ≠ 0` and `|i|, |j| < n`, the order satisfies
`n ≥ (|i| + 1)(|j| + 1) − 2` (BHK (14), main part). -/
lemma bhk_lemma7 (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n) (hG_lift : IsBHKLift G n)
    (i j : ℤ) (hi : i ≠ 0) (hj : j ≠ 0)
    (hin : i.natAbs < n) (hjn : j.natAbs < n)
    (hmin : ∀ kl : ℤ × ℤ, kl ≠ (0, 0) → |kl.1| ≤ |i| → |kl.2| ≤ |j| →
        ¬(|kl.1| = |i| ∧ |kl.2| = |j|) → ((kl.1 : ℝ) / n, (kl.2 : ℝ) / n) ∉ G) :
    (i.natAbs + 1) * (j.natAbs + 1) - 2 ≤ n := by
  obtain ⟨H, hH_card, hG_iff⟩ := hG_lift
  refine bhk_lemma7_card n hn H hH_card i.natAbs j.natAbs (by omega) (by omega) hin hjn ?_
  intro k l hkl0 hk_abs hl_abs hcorner
  rw [← bhk_lift_int_mem_iff G n hn H hG_iff k l]
  refine hmin (k, l) hkl0 ?_ ?_ ?_
  · rw [Int.abs_eq_natAbs i]; exact hk_abs
  · rw [Int.abs_eq_natAbs j]; exact hl_abs
  · rw [Int.abs_eq_natAbs i, Int.abs_eq_natAbs j]; exact hcorner

/-- **Grid pigeonhole (the `q < 6|j|` equidistribution engine).**  When `m ∣ q`
(`0 < m ≤ q`) the multiples of `m/q` form an `m/q`-spaced grid on the circle, so
every window `[y, y + m/q]` lying in `[0, 1]` contains one.  This is the kernel of
BHK's Part-4 "a segment of `L_{i,j}` meets `R` with full vertical length `1/6`,
hence `C ∩ R = ∅ ⇒ q < 6|j|`" argument (Cases 5.2.2/5.2.3): the coset's coordinates
on the segment are `|j|/q`-spaced, so avoiding the length-`1/6` crossing forces
`|j|/q > 1/6`. -/
lemma bhk_prop11_grid_hit (m q : ℕ) (hm : 0 < m) (hq : 0 < q) (hmdvd : m ∣ q)
    (y : ℝ) (hy0 : 0 ≤ y) (hy1 : y + (m : ℝ) / q ≤ 1) :
    ∃ t : ℕ, Int.fract ((t * m : ℝ) / q) ∈ Set.Icc y (y + (m : ℝ) / q) := by
  obtain ⟨d, hd⟩ := hmdvd
  have hd0 : 0 < d := by
    rcases Nat.eq_zero_or_pos d with h | h
    · rw [h, Nat.mul_zero] at hd; omega
    · exact h
  have hdR : (0 : ℝ) < d := by exact_mod_cast hd0
  have hmR : (0 : ℝ) < m := by exact_mod_cast hm
  have hqmd : (q : ℝ) = (m : ℝ) * d := by exact_mod_cast hd
  have hmq_eq : (m : ℝ) / q = 1 / d := by rw [hqmd]; field_simp
  rw [hmq_eq] at hy1 ⊢
  set s : ℕ := ⌈y * d⌉₊ with hs
  -- `s ≤ d - 1`, so `s < d` and the grid point `s/d` lies in `[0, 1)`.
  have hyd_le : y * d ≤ (d : ℝ) - 1 := by
    have hy' : y ≤ 1 - 1 / d := by linarith
    have h1 : y * d ≤ (1 - 1 / d) * d := mul_le_mul_of_nonneg_right hy' hdR.le
    have h2 : (1 - 1 / d) * d = (d : ℝ) - 1 := by field_simp
    linarith
  have hsd : s < d := by
    have : s ≤ d - 1 := by
      rw [hs, Nat.ceil_le, Nat.cast_sub hd0, Nat.cast_one]; exact hyd_le
    omega
  have hsmq : (s * m : ℝ) / q = (s : ℝ) / d := by rw [hqmd]; field_simp
  have hfract : Int.fract ((s * m : ℝ) / q) = (s : ℝ) / d := by
    rw [hsmq, Int.fract_eq_self.mpr ⟨by positivity, ?_⟩]
    rw [div_lt_one hdR]; exact_mod_cast hsd
  refine ⟨s, ?_⟩
  rw [hfract]
  refine ⟨?_, ?_⟩
  · rw [le_div_iff₀ hdR, hs]; exact Nat.le_ceil _
  · rw [div_le_iff₀ hdR]
    have hub : (s : ℝ) < y * d + 1 := by rw [hs]; exact Nat.ceil_lt_add_one (by positivity)
    have he : (y + 1 / d) * d = y * d + 1 := by field_simp
    rw [he]; linarith

/-- **`q < 6m` from a missed window (the Part-4 `q < 6|j|` bound).**  If the
`m/q`-spaced grid (`m ∣ q`) avoids a closed window `[y, y + 1/6]` inside `[0, 1]`,
then its spacing exceeds `1/6`, i.e. `q < 6m`.  This is the directly-usable form of
BHK's Case 5.2.2/5.2.3 conclusion: with `m = |j|` and the missed window the
full-height crossing of `R`, `C ∩ R = ∅` yields `q < 6|j|`.  (The remaining Part-4
obligation is to exhibit the coset's coordinates on the segment as this grid and the
crossing as the missed window.) -/
lemma bhk_prop11_grid_avoid (m q : ℕ) (hm : 0 < m) (hq : 0 < q) (hmdvd : m ∣ q)
    (y : ℝ) (hy0 : 0 ≤ y) (hy1 : y + 1 / 6 ≤ 1)
    (havoid : ∀ t : ℕ, Int.fract ((t * m : ℝ) / q) ∉ Set.Icc y (y + 1 / 6)) :
    q < 6 * m := by
  by_contra hle
  push_neg at hle
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq
  have hmq6 : (m : ℝ) / q ≤ 1 / 6 := by
    rw [div_le_iff₀ hqR]
    have h6 : (6 : ℝ) * m ≤ q := by exact_mod_cast hle
    linarith
  have hy1' : y + (m : ℝ) / q ≤ 1 := by linarith
  obtain ⟨t, ht⟩ := bhk_prop11_grid_hit m q hm hq hmdvd y hy0 hy1'
  exact havoid t ⟨ht.1, le_trans ht.2 (by linarith)⟩

/-- **Coset grid pigeonhole.**  A `1/e`-spaced coset `{ b + t/e : t ∈ ℤ }` meets every
closed window `[y, y + w]` of length `w ≥ 1/e` lying inside `[0, 1]`.  This is the coset
form of `bhk_prop11_grid_hit` needed for the anti-diagonal Case 5.2.2: on a slope-`-1`
circle of `L_{i,-i}` the coset's second coordinates are `1/e`-spaced (`e = gcd(r+p, q)`),
so any crossing of `R` of vertical length `≥ 1/e` contains one. -/
lemma bhk_prop11_grid_hit_coset (e : ℕ) (he : 0 < e) (b y w : ℝ)
    (hw : 1 / (e : ℝ) ≤ w) (hy0 : 0 ≤ y) (hy1 : y + w ≤ 1) :
    ∃ t : ℤ, Int.fract (b + (t : ℝ) / e) ∈ Set.Icc y (y + w) := by
  have heR : (0 : ℝ) < e := by exact_mod_cast he
  refine ⟨⌈(y - b) * (e : ℝ)⌉, ?_⟩
  have hlo : y ≤ b + ((⌈(y - b) * (e : ℝ)⌉ : ℤ) : ℝ) / e := by
    have h : y - b ≤ ((⌈(y - b) * (e : ℝ)⌉ : ℤ) : ℝ) / e :=
      (le_div_iff₀ heR).mpr (Int.le_ceil _)
    linarith
  have hhi0 : ((⌈(y - b) * (e : ℝ)⌉ : ℤ) : ℝ) / e < (y - b) + 1 / e := by
    rw [div_lt_iff₀ heR, show ((y - b) + 1 / (e : ℝ)) * e = (y - b) * e + 1 from by field_simp]
    exact Int.ceil_lt_add_one _
  have hhi : b + ((⌈(y - b) * (e : ℝ)⌉ : ℤ) : ℝ) / e < y + w := by linarith
  rw [Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩]
  exact ⟨hlo, le_of_lt hhi⟩

/-- **Coprime-step coset grid pigeonhole.**  When `gcd(c, e) = 1`, the coset
`{ b + t·c/e : t ∈ ℤ }` equals the plain `1/e`-coset, so it too meets every window of
length `≥ 1/e` in `[0,1]`.  On a slope-`-1` circle of `L_{i,-i}` the second coordinate
advances by `p/e` per step (with `gcd(p,e) = 1`), so this is the form the anti-diagonal
witness search consumes. -/
lemma bhk_prop11_grid_hit_coset_step (e : ℕ) (he : 0 < e) (c : ℕ) (hc : Nat.Coprime c e)
    (b y w : ℝ) (hw : 1 / (e : ℝ) ≤ w) (hy0 : 0 ≤ y) (hy1 : y + w ≤ 1) :
    ∃ t : ℤ, Int.fract (b + (t : ℝ) * c / e) ∈ Set.Icc y (y + w) := by
  obtain ⟨t', ht'⟩ := bhk_prop11_grid_hit_coset e he b y w hw hy0 hy1
  have hcop : IsCoprime (c : ℤ) (e : ℤ) := by
    rw [Int.isCoprime_iff_gcd_eq_one]; simpa [Int.gcd] using hc
  obtain ⟨a, b', hab⟩ := hcop
  have hab' : (a : ℝ) * c + b' * e = 1 := by exact_mod_cast hab
  have he0 : (e : ℝ) ≠ 0 := by positivity
  refine ⟨t' * a, ?_⟩
  have heq : b + ((t' * a : ℤ) : ℝ) * (c : ℝ) / e
      = (b + (t' : ℝ) / e) + ((-(t' * b') : ℤ) : ℝ) := by
    push_cast; field_simp; linear_combination (t' : ℝ) * hab'
  rw [heq, Int.fract_add_intCast]
  exact ht'

/-- **Anti-diagonal divisibility.**  If `q ∣ i·m` then `q / gcd(i,q)` divides `m` and so
is `≤ gcd(m, q)`.  Applied with `m = r + p` and the exceptional relation `q ∣ i·(r+p)` of
the pair `(i, -i)`: the slope-`-1` circles of `L_{i,-i}` carry the coset on a
`1/gcd(r+p,q)`-spaced grid, and `gcd(r+p,q) ≥ q/gcd(i,q) ≥ 6` once `q ≥ 6·gcd(i,q)`. -/
lemma bhk_prop11_antidiag_arith (i q m : ℕ) (hi : 0 < i) (hq : 0 < q) (hdvd : q ∣ i * m) :
    (q / Nat.gcd i q) ∣ m ∧ q / Nat.gcd i q ≤ Nat.gcd m q := by
  have hgpos : 0 < Nat.gcd i q := Nat.gcd_pos_of_pos_left q hi
  set d := Nat.gcd i q with hd
  have hdi : d ∣ i := Nat.gcd_dvd_left i q
  have hdq : d ∣ q := Nat.gcd_dvd_right i q
  have hcop : Nat.Coprime (q / d) (i / d) := (Nat.coprime_div_gcd_div_gcd hgpos).symm
  have key : (q / d) ∣ (i / d) * m := by
    have e1 : d * (q / d) ∣ d * ((i / d) * m) := by
      rw [Nat.mul_div_cancel' hdq, ← mul_assoc, Nat.mul_div_cancel' hdi]; exact hdvd
    exact (Nat.mul_dvd_mul_iff_left hgpos).mp e1
  have hm : (q / d) ∣ m := hcop.dvd_of_dvd_mul_left key
  exact ⟨hm, Nat.le_of_dvd (Nat.gcd_pos_of_pos_right m hq)
    (Nat.dvd_gcd hm ⟨d, (Nat.div_mul_cancel hdq).symm⟩)⟩

end BHK

end


/-
───────────────────────────────────────────────────────────────────────────────
  PART 14: IntLRC_6_BHK_Section7.lean
───────────────────────────────────────────────────────────────────────────────
-/
section

/-!
# BHK §§2+7 — the generic case (`3 v_1 < v_3`, both fracts nonzero)

Infrastructure for `bhk_case_v1_small_generic` (stated in
`IntLRC_6_BHK_Cases.lean`). The argument (BHK §2 extended by §7):

Let `d := v_3 - v_2`, `t_0 := 1/d` (the meeting period of runners 2 and 3),
and let `G ⊆ T = (ℝ/ℤ)²` be the cyclic subgroup generated by
`({v_3 t_0}, {v_1 t_0})`. With `g := gcd(d, v_3, v_1)`, `n := d / g`,
`c_3 := v_3 / g`, `c_1 := v_1 / g`, the group `G` is the `IsBHKLift` of
`H := ⟨(c_3, c_1)⟩ ⊆ (ZMod n)²`, which has order exactly `n`
(`gcd(n, c_3, c_1) = 1`).

A point of `G` in the parallelogram `P` of BHK (8)–(9) corresponds to a
meeting time `τ = k/d` whose surrounding 3-gap is a full 123-gap of length
`2/(3 v_3)`; `bhk_corollary_5` then yields a lonely time. `P` contains the
rectangle `R = [1/6, 5/6] × [7/18, 11/18]` (width `2/3`, height `2/9`) for
every `v_1 ≤ v_3 / 3`, so `bhk_corollary_6` (with `α = 2/3`, `β = 2/9`,
valid for `n ≥ 7`) either hits `R` or produces an exceptional minimal pair
`(i, j)`.

* `bhk_fract_translate`      — `{v(τ+δ)} = {vτ} + vδ` when no wraparound
* `bhk_fract_window`         — rectangle fract-condition → interval bounds
* `bhk_fract_nat_div`        — `{a/n} = (a % n)/n`
* `bhk_s7_window_lonely`     — the bridge: window conditions at `τ` → lonely time
* `bhkS7Group`               — the explicit lift of `⟨(c_3, c_1)⟩`
* `bhk_s7_card`              — `|⟨(c_3, c_1)⟩| = n` when `gcd(n, c_3, c_1) = 1`
* `bhk_s7_lift`              — `IsBHKLift (bhkS7Group n c₃ c₁) n`
* `bhk_s7_extract`           — `p ∈ bhkS7Group` → fract coords are `{c·k/n}`
* `bhk_s7_exceptional`       — Tables 9/10 + `G_4`/`G_7` (PROVED)
* `bhk_s7_small_n`           — ad hoc `2 ≤ n ≤ 6` analysis (PROVED)
* `bhk_s7_main`              — assembly, called from `IntLRC_6_BHK_Cases.lean`

## Source

T. Bohman, R. Holzman, D. Kleitman, *Six Lonely Runners*, EJC **8** (2001)
R3, §2 and §7.
-/

open MeasureTheory Set

namespace BHK

/-! ## Fract helpers -/

/-- **No-wraparound fract translation.** If `{vτ} + vδ` stays in `[0, 1)`
    then `{v(τ+δ)} = {vτ} + vδ`. -/
lemma bhk_fract_translate (v τ δ : ℝ)
    (h0 : 0 ≤ Int.fract (v * τ) + v * δ)
    (h1 : Int.fract (v * τ) + v * δ < 1) :
    Int.fract (v * (τ + δ)) = Int.fract (v * τ) + v * δ := by
  have hsplit : v * (τ + δ) = (⌊v * τ⌋ : ℝ) + (Int.fract (v * τ) + v * δ) := by
    have h : Int.fract (v * τ) + ⌊v * τ⌋ = v * τ := Int.fract_add_floor (v * τ)
    nlinarith [h]
  rw [hsplit, Int.fract_intCast_add, Int.fract_eq_self.mpr ⟨h0, h1⟩]

/-- **Rectangle fract-condition to interval bounds.** For `ρ ∈ [0, 1)` and
    an anchored window `[c, c + L]` with `c ≥ 0`, `c + L < 1`:
    `{ρ - c} ≤ L` forces `c ≤ ρ ≤ c + L`. -/
lemma bhk_fract_window (ρ c L : ℝ) (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1)
    (hc : 0 ≤ c) (hcL : c + L < 1) (h : Int.fract (ρ - c) ≤ L) :
    c ≤ ρ ∧ ρ ≤ c + L := by
  have hL0 : 0 ≤ L := le_trans (Int.fract_nonneg _) h
  by_cases hge : c ≤ ρ
  · have hin : Int.fract (ρ - c) = ρ - c :=
      Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩
    rw [hin] at h
    exact ⟨hge, by linarith⟩
  · -- ρ < c: then ρ - c ∈ (-1, 0), so {ρ - c} = ρ - c + 1 ≤ L gives ρ < 0.
    exfalso
    have hlt : ρ < c := not_le.mp hge
    have hin : Int.fract (ρ - c) = ρ - c + 1 := by
      have h1 : Int.fract (ρ - c) = Int.fract (ρ - c + 1) :=
        (Int.fract_add_one _).symm
      rw [h1, Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩]
    rw [hin] at h
    linarith

/-- **Fract of a rational with natural numerator.** For naturals `a`, `n`
    with `0 < n`: `{a/n} = (a % n)/n`. -/
lemma bhk_fract_nat_div (a n : ℕ) (hn : 0 < n) :
    Int.fract ((a : ℝ) / n) = ((a % n : ℕ) : ℝ) / n := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hdecomp : (a : ℝ) / n = ((a % n : ℕ) : ℝ) / n + ((a / n : ℕ) : ℤ) := by
    have h : (a : ℝ) = ((a % n : ℕ) : ℝ) + ((a / n : ℕ) : ℝ) * n := by
      exact_mod_cast (Nat.mod_add_div' a n).symm
    have h2 : (((a / n : ℕ) : ℤ) : ℝ) = ((a / n : ℕ) : ℝ) := Int.cast_natCast _
    rw [h2, h]
    field_simp
  rw [hdecomp, Int.fract_add_intCast, Int.fract_eq_self.mpr ⟨by positivity, by
    rw [div_lt_one hnR]
    exact_mod_cast Nat.mod_lt a hn⟩]

/-- **Fract-zero iff divides.** For naturals `a`, `d` with `0 < d`:
    `{a/d} = 0 ↔ d ∣ a`. -/
lemma bhk_fract_nat_div_eq_zero_iff (a d : ℕ) (hd : 0 < d) :
    Int.fract ((a : ℝ) / d) = 0 ↔ d ∣ a := by
  have hdR : (0 : ℝ) < d := by exact_mod_cast hd
  rw [bhk_fract_nat_div a d hd, div_eq_zero_iff]
  have hdne : ((d : ℝ)) ≠ 0 := ne_of_gt hdR
  simp only [hdne, or_false, Nat.cast_eq_zero]
  omega

/-! ## The bridge: torus window → lonely time -/

/-- **BHK §2 bridge.** If at time `τ` runners 2 and 3 share fractional
    position `u ∈ [1/6, 5/6]` and runner 1's fractional position `w`
    satisfies BHK condition (6),
    `1/6 + (u - 1/6)·v₁/v₃ ≤ w ≤ 5/6 - (5/6 - u)·v₁/v₃`,
    then the 3-gap around `τ` is a 123-gap of length `2/(3v₃)` and
    `bhk_corollary_5` produces a lonely time. -/
lemma bhk_s7_window_lonely (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i) (τ : ℝ)
    (hu_lo : 1/6 ≤ Int.fract ((speeds ⟨2, by omega⟩ : ℝ) * τ))
    (hu_hi : Int.fract ((speeds ⟨2, by omega⟩ : ℝ) * τ) ≤ 5/6)
    (h2eq : Int.fract ((speeds ⟨1, by omega⟩ : ℝ) * τ)
          = Int.fract ((speeds ⟨2, by omega⟩ : ℝ) * τ))
    (hw_lo : 1/6 + (Int.fract ((speeds ⟨2, by omega⟩ : ℝ) * τ) - 1/6) *
               (speeds ⟨0, by omega⟩ : ℝ) / (speeds ⟨2, by omega⟩ : ℝ)
             ≤ Int.fract ((speeds ⟨0, by omega⟩ : ℝ) * τ))
    (hw_hi : Int.fract ((speeds ⟨0, by omega⟩ : ℝ) * τ)
             ≤ 5/6 - (5/6 - Int.fract ((speeds ⟨2, by omega⟩ : ℝ) * τ)) *
               (speeds ⟨0, by omega⟩ : ℝ) / (speeds ⟨2, by omega⟩ : ℝ)) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 6 := by
  have hv1pos : (0 : ℝ) < speeds ⟨0, by omega⟩ := by exact_mod_cast hpos _
  have hv2pos : (0 : ℝ) < speeds ⟨1, by omega⟩ := by exact_mod_cast hpos _
  have hv3pos : (0 : ℝ) < speeds ⟨2, by omega⟩ := by exact_mod_cast hpos _
  have hv12 : (speeds ⟨0, by omega⟩ : ℝ) < (speeds ⟨1, by omega⟩ : ℝ) := by
    have : speeds ⟨0, by omega⟩ < speeds ⟨1, by omega⟩ := hmono (by decide)
    exact_mod_cast this
  have hv23 : (speeds ⟨1, by omega⟩ : ℝ) < (speeds ⟨2, by omega⟩ : ℝ) := by
    have : speeds ⟨1, by omega⟩ < speeds ⟨2, by omega⟩ := hmono (by decide)
    exact_mod_cast this
  set v1 : ℝ := (speeds ⟨0, by omega⟩ : ℝ) with hv1_def
  set v2 : ℝ := (speeds ⟨1, by omega⟩ : ℝ) with hv2_def
  set v3 : ℝ := (speeds ⟨2, by omega⟩ : ℝ) with hv3_def
  set u : ℝ := Int.fract (v3 * τ) with hu_def
  set w : ℝ := Int.fract (v1 * τ) with hw_def
  -- The 3-gap around τ.
  set a : ℝ := τ - (u - 1/6) / v3 with ha_def
  set b : ℝ := τ + (5/6 - u) / v3 with hb_def
  have hab : a ≤ b := by
    have h1 : 0 ≤ (u - 1/6) / v3 := div_nonneg (by linarith) hv3pos.le
    have h2 : 0 ≤ (5/6 - u) / v3 := div_nonneg (by linarith) hv3pos.le
    rw [ha_def, hb_def]; linarith
  refine bhk_corollary_5 speeds hmono hpos a b hab ?_ ?_
  · -- The 3-gap [a, b] is a 123-gap.
    intro s hs
    obtain ⟨hsa, hsb⟩ := Set.mem_Icc.mp hs
    have hδlo : -((u - 1/6) / v3) ≤ s - τ := by
      rw [ha_def] at hsa; linarith
    have hδhi : s - τ ≤ (5/6 - u) / v3 := by
      rw [hb_def] at hsb; linarith
    -- Uniform safety: a runner with speed v at fractional position ω at τ
    -- whose window condition (6) holds stays in [1/6, 5/6] across [a, b].
    have key : ∀ v ω : ℝ, 0 < v →
        Int.fract (v * τ) = ω →
        1/6 + (u - 1/6) * v / v3 ≤ ω →
        ω ≤ 5/6 - (5/6 - u) * v / v3 →
        1/6 ≤ Int.fract (v * s) ∧ Int.fract (v * s) ≤ 5/6 := by
      intro v ω hv hfr hlo hhi
      have hm_lo : -((u - 1/6) * v / v3) ≤ v * (s - τ) := by
        have h := mul_le_mul_of_nonneg_left hδlo hv.le
        rwa [show v * -((u - 1/6) / v3) = -((u - 1/6) * v / v3) from by ring] at h
      have hm_hi : v * (s - τ) ≤ (5/6 - u) * v / v3 := by
        have h := mul_le_mul_of_nonneg_left hδhi hv.le
        rwa [show v * ((5/6 - u) / v3) = (5/6 - u) * v / v3 from by ring] at h
      have h0 : 0 ≤ Int.fract (v * τ) + v * (s - τ) := by
        rw [hfr]; linarith
      have h1 : Int.fract (v * τ) + v * (s - τ) < 1 := by
        rw [hfr]; linarith
      have hfs : Int.fract (v * s) = ω + v * (s - τ) := by
        have h := bhk_fract_translate v τ (s - τ) h0 h1
        rw [show τ + (s - τ) = s from by ring, hfr] at h
        exact h
      rw [hfs]
      exact ⟨by linarith, by linarith⟩
    have hself : ∀ c : ℝ, c * v3 / v3 = c := fun c => by
      field_simp
    have k3 := key v3 u hv3pos hu_def.symm
      (by rw [hself]; linarith) (by rw [hself]; linarith)
    have k2 := key v2 u hv2pos h2eq
      (by
        have h : (u - 1/6) * v2 / v3 ≤ u - 1/6 := by
          rw [div_le_iff₀ hv3pos]
          nlinarith [mul_nonneg (show (0:ℝ) ≤ u - 1/6 by linarith)
            (show (0:ℝ) ≤ v3 - v2 by linarith)]
        linarith)
      (by
        have h : (5/6 - u) * v2 / v3 ≤ 5/6 - u := by
          rw [div_le_iff₀ hv3pos]
          nlinarith [mul_nonneg (show (0:ℝ) ≤ 5/6 - u by linarith)
            (show (0:ℝ) ≤ v3 - v2 by linarith)]
        linarith)
    have k1 := key v1 w hv1pos hw_def.symm hw_lo hw_hi
    rw [Set.mem_compl_iff]
    intro hmem
    have hsafe : ∀ x : ℝ, 1/6 ≤ Int.fract x → Int.fract x ≤ 5/6 →
        ¬ circDist x < 1/6 := by
      intro x hx1 hx2
      rw [not_lt]
      unfold circDist
      exact le_min hx1 (by linarith)
    rcases hmem with (h | h) | h
    · exact hsafe _ k1.1 k1.2 ((mem_unsafeOf_iff _ _ _).mp h)
    · exact hsafe _ k2.1 k2.2 ((mem_unsafeOf_iff _ _ _).mp h)
    · exact hsafe _ k3.1 k3.2 ((mem_unsafeOf_iff _ _ _).mp h)
  · -- Length: b - a = 2/(3 v₃).
    have hba : b - a = 2 / (3 * v3) := by
      rw [hb_def, ha_def]
      field_simp
      ring
    show 2 / (3 * v3) ≤ b - a
    rw [hba]

/-! ## The cyclic torus group and its lift -/

/-- The ℤ²-periodic lift of the cyclic subgroup `⟨(c₃, c₁)⟩ ⊆ (ZMod n)²`. -/
def bhkS7Group (n c₃ c₁ : ℕ) : Set (ℝ × ℝ) :=
  { p | ∃ h ∈ AddSubgroup.zmultiples ((c₃ : ZMod n), (c₁ : ZMod n)),
        ∃ i j : ℤ,
          p = (((h.1.val : ℝ) / n) + (i : ℝ), ((h.2.val : ℝ) / n) + (j : ℝ)) }

/-- **Order of the cyclic group.** If `gcd(n, gcd(c₃, c₁)) = 1` then
    `(c₃, c₁)` has additive order exactly `n` in `(ZMod n)²`, so its
    cyclic subgroup has cardinality `n`. -/
lemma bhk_s7_card (n c₃ c₁ : ℕ) (hn : 1 < n)
    (hg : Nat.gcd n (Nat.gcd c₃ c₁) = 1) :
    Nat.card (AddSubgroup.zmultiples ((c₃ : ZMod n), (c₁ : ZMod n))) = n := by
  have hn0 : n ≠ 0 := by omega
  rw [Nat.card_zmultiples, Prod.addOrderOf_mk,
      ZMod.addOrderOf_coe c₃ hn0, ZMod.addOrderOf_coe c₁ hn0]
  -- ⊢ (n / n.gcd c₃).lcm (n / n.gcd c₁) = n
  set a := n.gcd c₃ with ha_def
  set b := n.gcd c₁ with hb_def
  have ha : a ∣ n := Nat.gcd_dvd_left _ _
  have hb : b ∣ n := Nat.gcd_dvd_left _ _
  have hapos : 0 < a := Nat.gcd_pos_of_pos_left c₃ (by omega)
  have hbpos : 0 < b := Nat.gcd_pos_of_pos_left c₁ (by omega)
  have hab : Nat.Coprime a b := by
    have h1 : Nat.gcd a b ∣ n := (Nat.gcd_dvd_left a b).trans ha
    have h2 : Nat.gcd a b ∣ Nat.gcd c₃ c₁ :=
      Nat.dvd_gcd ((Nat.gcd_dvd_left a b).trans (Nat.gcd_dvd_right n c₃))
                  ((Nat.gcd_dvd_right a b).trans (Nat.gcd_dvd_right n c₁))
    have h3 := Nat.dvd_gcd h1 h2
    rw [hg] at h3
    exact Nat.dvd_one.mp h3
  obtain ⟨m, hm⟩ := Nat.Coprime.mul_dvd_of_dvd_of_dvd hab ha hb
  have hna : n / a = b * m := by
    rw [hm, mul_assoc, Nat.mul_div_cancel_left _ hapos]
  have hnb : n / b = a * m := by
    rw [hm, show a * b * m = b * (a * m) from by ring,
        Nat.mul_div_cancel_left _ hbpos]
  have hmpos : 0 < m := by
    rcases Nat.eq_zero_or_pos m with h0 | h
    · subst h0; simp at hm; omega
    · exact h
  have hgba : Nat.gcd b a = 1 := hab.symm
  rw [hna, hnb, Nat.lcm, Nat.gcd_mul_right, hgba, one_mul,
      show b * m * (a * m) = a * b * m * m from by ring,
      Nat.mul_div_cancel _ hmpos, hm]

/-- **`bhkS7Group` is a BHK lift.** -/
lemma bhk_s7_lift (n c₃ c₁ : ℕ) (hn : 1 < n)
    (hg : Nat.gcd n (Nat.gcd c₃ c₁) = 1) :
    IsBHKLift (bhkS7Group n c₃ c₁) n :=
  ⟨AddSubgroup.zmultiples ((c₃ : ZMod n), (c₁ : ZMod n)),
   bhk_s7_card n c₃ c₁ hn hg, fun _ => Iff.rfl⟩

/-- **Coordinate extraction.** Every point of `bhkS7Group n c₃ c₁` has
    fractional coordinates `({c₃ k / n}, {c₁ k / n})` for some `k : ℕ`. -/
lemma bhk_s7_extract (n c₃ c₁ : ℕ) (hn : 1 < n) (p : ℝ × ℝ)
    (hp : p ∈ bhkS7Group n c₃ c₁) :
    ∃ k : ℕ, Int.fract p.1 = Int.fract ((c₃ * k : ℕ) / (n : ℝ)) ∧
             Int.fract p.2 = Int.fract ((c₁ * k : ℕ) / (n : ℝ)) := by
  have hn0 : n ≠ 0 := by omega
  have hnpos : 0 < n := by omega
  have hnR : (0 : ℝ) < n := by exact_mod_cast hnpos
  haveI : NeZero n := ⟨hn0⟩
  obtain ⟨h, hh_mem, i, j, hp_eq⟩ := hp
  obtain ⟨z, hz⟩ := AddSubgroup.mem_zmultiples_iff.mp hh_mem
  -- Reduce the ℤ-multiple to a ℕ-multiple mod n.
  set k : ℕ := (z % (n : ℤ)).toNat with hk_def
  have hk_cast : ((k : ℕ) : ℤ) = z % (n : ℤ) :=
    Int.toNat_of_nonneg (Int.emod_nonneg z (by exact_mod_cast hn0))
  have hzk : ((z : ℤ) : ZMod n) = ((k : ℕ) : ZMod n) := by
    rw [show ((k : ℕ) : ZMod n) = (((k : ℕ) : ℤ) : ZMod n) from by push_cast; rfl,
        hk_cast, ZMod.intCast_mod]
  -- Componentwise identification of the group element.
  have hfst : h.1 = ((c₃ * k : ℕ) : ZMod n) := by
    have h1 : h.1 = z • (c₃ : ZMod n) := by rw [← hz]; simp
    rw [h1, zsmul_eq_mul, hzk]
    push_cast
    ring
  have hsnd : h.2 = ((c₁ * k : ℕ) : ZMod n) := by
    have h1 : h.2 = z • (c₁ : ZMod n) := by rw [← hz]; simp
    rw [h1, zsmul_eq_mul, hzk]
    push_cast
    ring
  -- Fract computations.
  have hval_fract : ∀ x : ZMod n, Int.fract ((x.val : ℝ) / n) = (x.val : ℝ) / n := by
    intro x
    refine Int.fract_eq_self.mpr ⟨by positivity, ?_⟩
    rw [div_lt_one hnR]
    exact_mod_cast ZMod.val_lt x
  refine ⟨k, ?_, ?_⟩
  · rw [hp_eq]
    show Int.fract ((h.1.val : ℝ) / n + (i : ℝ)) = _
    rw [Int.fract_add_intCast, hval_fract, bhk_fract_nat_div _ _ hnpos,
        hfst, ZMod.val_natCast]
  · rw [hp_eq]
    show Int.fract ((h.2.val : ℝ) / n + (j : ℝ)) = _
    rw [Int.fract_add_intCast, hval_fract, bhk_fract_nat_div _ _ hnpos,
        hsnd, ZMod.val_natCast]

/-! ## Explicit-witness plumbing -/

/-- **Lonely time from an explicit meeting index.** Given the reduced group
    data `(n, c₃, c₁, g)` and an explicit `k` whose torus point
    `(c₃k/n, c₁k/n)` satisfies the parallelogram conditions (8)–(9)
    (exact form, with the true ratio `v₁/v₃`), the meeting time
    `τ = k/(v₃ - v₂)` yields a lonely time via the §2 bridge. -/
lemma bhk_s7_witness (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i)
    (n c₃ c₁ g : ℕ) (hnpos : 0 < n) (hgpos : 0 < g)
    (hd : g * n = speeds ⟨2, by omega⟩ - speeds ⟨1, by omega⟩)
    (hc3 : g * c₃ = speeds ⟨2, by omega⟩)
    (hc1 : g * c₁ = speeds ⟨0, by omega⟩)
    (k : ℕ)
    (hu_lo : 1/6 ≤ ((c₃ * k % n : ℕ) : ℝ) / n)
    (hu_hi : ((c₃ * k % n : ℕ) : ℝ) / n ≤ 5/6)
    (hw_lo : 1/6 + (((c₃ * k % n : ℕ) : ℝ) / n - 1/6) *
               (speeds ⟨0, by omega⟩ : ℝ) / (speeds ⟨2, by omega⟩ : ℝ)
             ≤ ((c₁ * k % n : ℕ) : ℝ) / n)
    (hw_hi : ((c₁ * k % n : ℕ) : ℝ) / n
             ≤ 5/6 - (5/6 - ((c₃ * k % n : ℕ) : ℝ) / n) *
               (speeds ⟨0, by omega⟩ : ℝ) / (speeds ⟨2, by omega⟩ : ℝ)) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 6 := by
  have hV23 : speeds ⟨1, by omega⟩ < speeds ⟨2, by omega⟩ :=
    hmono (Fin.mk_lt_mk.mpr (by omega))
  set V1 : ℕ := speeds ⟨0, by omega⟩ with hV1_def
  set V2 : ℕ := speeds ⟨1, by omega⟩ with hV2_def
  set V3 : ℕ := speeds ⟨2, by omega⟩ with hV3_def
  set D : ℕ := V3 - V2 with hD_def
  have hDpos : 0 < D := by omega
  have hD_cast : ((D : ℕ) : ℝ) = (V3 : ℝ) - V2 := by
    rw [hD_def, Nat.cast_sub hV23.le]
  set τ : ℝ := (k : ℝ) / D with hτ_def
  have hDR : ((D : ℕ) : ℝ) = (g : ℝ) * n := by exact_mod_cast hd.symm
  have hV3R : ((V3 : ℕ) : ℝ) = (g : ℝ) * c₃ := by exact_mod_cast hc3.symm
  have hV1R : ((V1 : ℕ) : ℝ) = (g : ℝ) * c₁ := by exact_mod_cast hc1.symm
  have hgR : (0 : ℝ) < g := by exact_mod_cast hgpos
  have hnR : (0 : ℝ) < n := by exact_mod_cast hnpos
  have e3 : (V3 : ℝ) * τ = ((c₃ * k : ℕ) : ℝ) / n := by
    rw [hτ_def, hV3R, hDR]
    push_cast
    field_simp
  have e1 : (V1 : ℝ) * τ = ((c₁ * k : ℕ) : ℝ) / n := by
    rw [hτ_def, hV1R, hDR]
    push_cast
    field_simp
  have hu3 : Int.fract ((V3 : ℝ) * τ) = ((c₃ * k % n : ℕ) : ℝ) / n := by
    rw [e3, bhk_fract_nat_div _ _ hnpos]
  have hw1 : Int.fract ((V1 : ℝ) * τ) = ((c₁ * k % n : ℕ) : ℝ) / n := by
    rw [e1, bhk_fract_nat_div _ _ hnpos]
  have e2 : (V2 : ℝ) * τ = (V3 : ℝ) * τ - ((k : ℤ) : ℝ) := by
    have hV2R : (V2 : ℝ) = (V3 : ℝ) - D := by rw [hD_cast]; ring
    rw [hV2R, hτ_def]
    field_simp
    push_cast
    ring
  have h2eq : Int.fract ((V2 : ℝ) * τ) = Int.fract ((V3 : ℝ) * τ) := by
    rw [e2, Int.fract_sub_intCast]
  exact bhk_s7_window_lonely speeds hmono hpos τ
    (by rw [hu3]; exact hu_lo) (by rw [hu3]; exact hu_hi) h2eq
    (by rw [hu3, hw1]; exact hw_lo) (by rw [hu3, hw1]; exact hw_hi)

/-- **Sufficient-window witness.** The conditions
    `u ∈ [1/6, 5/6]`, `w ∈ [1/9 + u/3, 5/9 + u/3]` imply the exact
    parallelogram conditions for every ratio `v₁/v₃ ≤ 1/3` (here `< 1/3`
    from `hsmall`), eliminating the speed-dependence: a single `k` then
    works for the whole case. -/
lemma bhk_s7_witness_suff (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i)
    (hsmall : 3 * speeds ⟨0, by omega⟩ < speeds ⟨2, by omega⟩)
    (n c₃ c₁ g : ℕ) (k : ℕ) (hnpos : 0 < n) (hgpos : 0 < g)
    (hd : g * n = speeds ⟨2, by omega⟩ - speeds ⟨1, by omega⟩)
    (hc3 : g * c₃ = speeds ⟨2, by omega⟩)
    (hc1 : g * c₁ = speeds ⟨0, by omega⟩)
    (hu_lo : 1/6 ≤ ((c₃ * k % n : ℕ) : ℝ) / n)
    (hu_hi : ((c₃ * k % n : ℕ) : ℝ) / n ≤ 5/6)
    (hw_lo : 1/9 + ((c₃ * k % n : ℕ) : ℝ) / n / 3 ≤ ((c₁ * k % n : ℕ) : ℝ) / n)
    (hw_hi : ((c₁ * k % n : ℕ) : ℝ) / n ≤ 5/9 + ((c₃ * k % n : ℕ) : ℝ) / n / 3) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 6 := by
  have hV1Rpos : (0 : ℝ) < speeds ⟨0, by omega⟩ := by exact_mod_cast hpos _
  have hV3Rpos : (0 : ℝ) < speeds ⟨2, by omega⟩ := by exact_mod_cast hpos _
  have hsmallR : 3 * (speeds ⟨0, by omega⟩ : ℝ) < speeds ⟨2, by omega⟩ := by
    exact_mod_cast hsmall
  set u : ℝ := ((c₃ * k % n : ℕ) : ℝ) / n with hu_def
  set w : ℝ := ((c₁ * k % n : ℕ) : ℝ) / n with hw_def
  apply bhk_s7_witness speeds hmono hpos n c₃ c₁ g hnpos hgpos hd hc3 hc1 k
    hu_lo hu_hi ?_ ?_
  · -- 1/6 + (u - 1/6)·v₁/v₃ ≤ w, since (u - 1/6)·v₁/v₃ ≤ (u - 1/6)/3.
    have hterm : (u - 1/6) * (speeds ⟨0, by omega⟩ : ℝ) / (speeds ⟨2, by omega⟩ : ℝ)
        ≤ (u - 1/6) / 3 := by
      rw [div_le_div_iff₀ hV3Rpos (by norm_num : (0:ℝ) < 3)]
      have h := mul_le_mul_of_nonneg_left hsmallR.le
        (show (0:ℝ) ≤ u - 1/6 by linarith)
      linarith [h]
    linarith
  · have hterm : (5/6 - u) * (speeds ⟨0, by omega⟩ : ℝ) / (speeds ⟨2, by omega⟩ : ℝ)
        ≤ (5/6 - u) / 3 := by
      rw [div_le_div_iff₀ hV3Rpos (by norm_num : (0:ℝ) < 3)]
      have h := mul_le_mul_of_nonneg_left hsmallR.le
        (show (0:ℝ) ≤ 5/6 - u by linarith)
      linarith [h]
    linarith

/-- **Natural-number form of the sufficient window.** With `a := c₃k mod n`,
    `b := c₁k mod n`, the sufficient window `u ∈ [1/6, 5/6]`,
    `w ∈ [1/9 + u/3, 5/9 + u/3]` is equivalent to the four ℕ-inequalities
    `n ≤ 6a`, `6a ≤ 5n`, `n + 3a ≤ 9b`, `9b ≤ 5n + 3a` — all decidable by
    `omega` once `c₃ % n`, `c₁ % n` are pinned. -/
lemma bhk_s7_witness_num (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i)
    (hsmall : 3 * speeds ⟨0, by omega⟩ < speeds ⟨2, by omega⟩)
    (n c₃ c₁ g k : ℕ) (hnpos : 0 < n) (hgpos : 0 < g)
    (hd : g * n = speeds ⟨2, by omega⟩ - speeds ⟨1, by omega⟩)
    (hc3 : g * c₃ = speeds ⟨2, by omega⟩)
    (hc1 : g * c₁ = speeds ⟨0, by omega⟩)
    (h_ulo : n ≤ 6 * (c₃ * k % n)) (h_uhi : 6 * (c₃ * k % n) ≤ 5 * n)
    (h_wlo : n + 3 * (c₃ * k % n) ≤ 9 * (c₁ * k % n))
    (h_whi : 9 * (c₁ * k % n) ≤ 5 * n + 3 * (c₃ * k % n)) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 6 := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hnpos
  have haR : (n : ℝ) ≤ 6 * ((c₃ * k % n : ℕ) : ℝ) := by exact_mod_cast h_ulo
  have haR' : 6 * ((c₃ * k % n : ℕ) : ℝ) ≤ 5 * n := by exact_mod_cast h_uhi
  have hbR : (n : ℝ) + 3 * ((c₃ * k % n : ℕ) : ℝ)
      ≤ 9 * ((c₁ * k % n : ℕ) : ℝ) := by exact_mod_cast h_wlo
  have hbR' : 9 * ((c₁ * k % n : ℕ) : ℝ)
      ≤ 5 * (n : ℝ) + 3 * ((c₃ * k % n : ℕ) : ℝ) := by exact_mod_cast h_whi
  apply bhk_s7_witness_suff speeds hmono hpos hsmall n c₃ c₁ g k hnpos hgpos
    hd hc3 hc1
  · rw [le_div_iff₀ hnR]; linarith
  · rw [div_le_iff₀ hnR]; linarith
  · have key : ((c₁ * k % n : ℕ) : ℝ) / n
        - (1/9 + ((c₃ * k % n : ℕ) : ℝ) / n / 3)
        = (9 * ((c₁ * k % n : ℕ) : ℝ) - n - 3 * ((c₃ * k % n : ℕ) : ℝ))
          / (9 * n) := by
      field_simp
      ring
    have hq : (0 : ℝ)
        ≤ (9 * ((c₁ * k % n : ℕ) : ℝ) - n - 3 * ((c₃ * k % n : ℕ) : ℝ))
          / (9 * n) :=
      div_nonneg (by linarith) (by positivity)
    rw [← key] at hq
    linarith
  · have key : (5/9 + ((c₃ * k % n : ℕ) : ℝ) / n / 3)
        - ((c₁ * k % n : ℕ) : ℝ) / n
        = (5 * n + 3 * ((c₃ * k % n : ℕ) : ℝ) - 9 * ((c₁ * k % n : ℕ) : ℝ))
          / (9 * n) := by
      field_simp
      ring
    have hq : (0 : ℝ)
        ≤ (5 * (n:ℝ) + 3 * ((c₃ * k % n : ℕ) : ℝ) - 9 * ((c₁ * k % n : ℕ) : ℝ))
          / (9 * n) :=
      div_nonneg (by linarith) (by positivity)
    rw [← key] at hq
    linarith

/-! ## Modular-arithmetic helpers for the exceptional-pair analysis -/

/-- **Mod of a scaled multiple.** `c·(m·m₀) ≡ (c·m₀ mod n)·m (mod n)`. -/
lemma bhk_s7_mul_mod (c m₀ m n : ℕ) :
    c * (m * m₀) % n = (c * m₀ % n) * m % n := by
  rw [show c * (m * m₀) = (c * m₀) * m from by ring,
      Nat.mul_mod (c * m₀) m n, Nat.mul_mod (c * m₀ % n) m n,
      Nat.mod_mod_of_dvd _ dvd_rfl]

/-- **Mod of a negative-residue multiple.** For `0 < r`, `0 < m`,
    `r·m < n`: `(n − r)·m ≡ n − r·m (mod n)`. -/
lemma bhk_s7_neg_mod (n r m : ℕ) (hr : 0 < r) (hm : 0 < m) (hrm : r * m < n) :
    (n - r) * m % n = n - r * m := by
  have h3 : r ≤ r * m := by
    calc r = r * 1 := (mul_one r).symm
    _ ≤ r * m := Nat.mul_le_mul_left r hm
  have hppos : 0 < r * m := Nat.mul_pos hr hm
  have hn0 : 0 < n := lt_of_le_of_lt (Nat.zero_le (r * m)) hrm
  have h1 : (n - r) * m = n * (m - 1) + (n - r * m) := by
    zify [show r ≤ n by omega, show 1 ≤ m from hm, show r * m ≤ n from hrm.le]
    ring
  rw [h1, Nat.mul_add_mod, Nat.mod_eq_of_lt (Nat.sub_lt hn0 hppos)]

/-- **Window form of mod.** If `q·n ≤ x < (q+1)·n` then `x % n = x − q·n`. -/
lemma bhk_s7_mod_window (x q n : ℕ) (h1 : q * n ≤ x) (h2 : x < (q + 1) * n) :
    x % n = x - q * n := by
  have h3 : (q + 1) * n = q * n + n := by ring
  conv_lhs => rw [show x = (x - q * n) + q * n from by omega]
  rw [Nat.add_mul_mod_self_right]
  exact Nat.mod_eq_of_lt (by omega)

/-- **Bezout witness mod `n`.** For every `c` there is a `t` with
    `c·t ≡ gcd(n, c) (mod n)`. -/
lemma bhk_s7_bezout_mod (n c : ℕ) (hn : 0 < n) :
    ∃ t : ℕ, c * t % n = Nat.gcd n c % n := by
  have hB : (Nat.gcd n c : ℤ) = n * Nat.gcdA n c + c * Nat.gcdB n c :=
    Nat.gcd_eq_gcd_ab n c
  set b : ℤ := Nat.gcdB n c with hb_def
  have hnZ : (0 : ℤ) < n := by exact_mod_cast hn
  refine ⟨(b % n).toNat, ?_⟩
  have hbt : (((b % n).toNat : ℕ) : ℤ) = b % n :=
    Int.toNat_of_nonneg (Int.emod_nonneg b hnZ.ne')
  have key : ((c * (b % n).toNat : ℕ) : ℤ) % n = ((Nat.gcd n c : ℕ) : ℤ) % n := by
    push_cast
    rw [hbt]
    have h2 : ((c : ℤ) * (b % n)) % n = ((c : ℤ) * b) % n := by
      conv_lhs => rw [Int.mul_emod, Int.emod_emod_of_dvd _ dvd_rfl, ← Int.mul_emod]
    have h1 : (c : ℤ) * b = (Nat.gcd n c : ℤ) - n * Nat.gcdA n c := by
      rw [hB]; ring
    rw [h2, h1, Int.sub_mul_emod_self_left]
  have keyN : (((c * (b % n).toNat) % n : ℕ) : ℤ) = ((Nat.gcd n c % n : ℕ) : ℤ) := by
    push_cast
    exact key
  exact_mod_cast keyN

/-- **Gcd is determined by residues.**
    `gcd(n, gcd(a mod n, b mod n)) = gcd(n, gcd(a, b))`. -/
lemma bhk_s7_gcd_mod (n a b : ℕ) :
    Nat.gcd n (Nat.gcd (a % n) (b % n)) = Nat.gcd n (Nat.gcd a b) := by
  apply Nat.dvd_antisymm
  · apply Nat.dvd_gcd (Nat.gcd_dvd_left _ _)
    have hn := Nat.gcd_dvd_left n (Nat.gcd (a % n) (b % n))
    have ha := (Nat.gcd_dvd_right n _).trans (Nat.gcd_dvd_left (a % n) (b % n))
    have hb := (Nat.gcd_dvd_right n _).trans (Nat.gcd_dvd_right (a % n) (b % n))
    exact Nat.dvd_gcd ((Nat.dvd_mod_iff hn).mp ha) ((Nat.dvd_mod_iff hn).mp hb)
  · apply Nat.dvd_gcd (Nat.gcd_dvd_left _ _)
    have hn := Nat.gcd_dvd_left n (Nat.gcd a b)
    have ha := (Nat.gcd_dvd_right n _).trans (Nat.gcd_dvd_left a b)
    have hb := (Nat.gcd_dvd_right n _).trans (Nat.gcd_dvd_right a b)
    exact Nat.dvd_gcd ((Nat.dvd_mod_iff hn).mpr ha) ((Nat.dvd_mod_iff hn).mpr hb)

/-- **Membership from a multiple.** The torus point of the `k`-th multiple
    of the generator, shifted by any integer offsets, lies in
    `bhkS7Group n c₃ c₁`. -/
lemma bhk_s7_mem_mul (n c₃ c₁ k : ℕ) (hn : 0 < n) (zi zj : ℤ) :
    ((((c₃ * k % n : ℕ) : ℝ) / n + (zi : ℝ), ((c₁ * k % n : ℕ) : ℝ) / n + (zj : ℝ))
      : ℝ × ℝ) ∈ bhkS7Group n c₃ c₁ := by
  haveI : NeZero n := ⟨hn.ne'⟩
  refine ⟨(k : ℤ) • ((c₃ : ZMod n), (c₁ : ZMod n)),
    AddSubgroup.mem_zmultiples_iff.mpr ⟨(k : ℤ), rfl⟩, zi, zj, ?_⟩
  have hfst : ((k : ℤ) • ((c₃ : ZMod n), (c₁ : ZMod n))).1.val = c₃ * k % n := by
    have h1 : ((k : ℤ) • ((c₃ : ZMod n), (c₁ : ZMod n))).1 = ((c₃ * k : ℕ) : ZMod n) := by
      show (k : ℤ) • (c₃ : ZMod n) = _
      rw [zsmul_eq_mul]
      push_cast
      ring
    rw [h1, ZMod.val_natCast]
  have hsnd : ((k : ℤ) • ((c₃ : ZMod n), (c₁ : ZMod n))).2.val = c₁ * k % n := by
    have h1 : ((k : ℤ) • ((c₃ : ZMod n), (c₁ : ZMod n))).2 = ((c₁ * k : ℕ) : ZMod n) := by
      show (k : ℤ) • (c₁ : ZMod n) = _
      rw [zsmul_eq_mul]
      push_cast
      ring
    rw [h1, ZMod.val_natCast]
  rw [hfst, hsnd]

/-- **Torus membership with small nonnegative coordinates.** Specialisation
    of `bhk_s7_mem_mul` with zero integer shifts, for instantiating the
    (13)-minimality hypothesis at explicit violators. -/
lemma bhk_s7_mem_pos (n c₃ c₁ k x y : ℕ) (hn : 0 < n)
    (hres3 : c₃ * k % n = x) (hres1 : c₁ * k % n = y) :
    (((x : ℕ) : ℝ) / n, ((y : ℕ) : ℝ) / n) ∈ bhkS7Group n c₃ c₁ := by
  have h := bhk_s7_mem_mul n c₃ c₁ k hn 0 0
  rw [hres3, hres1] at h
  simpa using h

/-- **Congruence-solver kernel.** If `a·m = q·n + Δ` with `Δ < n` then
    `a·m ≡ Δ (mod n)`. -/
lemma bhk_s7_solve_aux (n a m q Δ : ℕ) (hΔ : Δ < n)
    (key : a * m = q * n + Δ) :
    a * m % n = Δ := by
  rw [key, Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hΔ]

/-- Solve `2m ≡ Δ (mod n)` when `Δ` is even or `n` is odd. -/
lemma bhk_s7_solve2 (n Δ : ℕ) (hΔ : Δ < n) (h : Δ % 2 = 0 ∨ n % 2 = 1) :
    ∃ m : ℕ, 2 * m % n = Δ := by
  rcases h with h | h
  · exact ⟨Δ / 2, by
      rw [show 2 * (Δ / 2) = Δ from by omega, Nat.mod_eq_of_lt hΔ]⟩
  · refine ⟨Δ * ((n + 1) / 2), bhk_s7_solve_aux n 2 _ Δ Δ hΔ ?_⟩
    have he : 2 * ((n + 1) / 2) = n + 1 := by omega
    calc 2 * (Δ * ((n + 1) / 2)) = Δ * (2 * ((n + 1) / 2)) := by ring
      _ = Δ * (n + 1) := by rw [he]
      _ = Δ * n + Δ := by ring

/-- Solve `3m ≡ Δ (mod n)` when `3 ∣ Δ` or `3 ∤ n`. -/
lemma bhk_s7_solve3 (n Δ : ℕ) (hΔ : Δ < n) (h : Δ % 3 = 0 ∨ n % 3 ≠ 0) :
    ∃ m : ℕ, 3 * m % n = Δ := by
  rcases h with h | h
  · exact ⟨Δ / 3, by
      rw [show 3 * (Δ / 3) = Δ from by omega, Nat.mod_eq_of_lt hΔ]⟩
  · rcases (by omega : n % 3 = 1 ∨ n % 3 = 2) with h3 | h3
    · refine ⟨Δ * ((2 * n + 1) / 3), bhk_s7_solve_aux n 3 _ (2 * Δ) Δ hΔ ?_⟩
      have he : 3 * ((2 * n + 1) / 3) = 2 * n + 1 := by omega
      calc 3 * (Δ * ((2 * n + 1) / 3)) = Δ * (3 * ((2 * n + 1) / 3)) := by ring
        _ = Δ * (2 * n + 1) := by rw [he]
        _ = 2 * Δ * n + Δ := by ring
    · refine ⟨Δ * ((n + 1) / 3), bhk_s7_solve_aux n 3 _ Δ Δ hΔ ?_⟩
      have he : 3 * ((n + 1) / 3) = n + 1 := by omega
      calc 3 * (Δ * ((n + 1) / 3)) = Δ * (3 * ((n + 1) / 3)) := by ring
        _ = Δ * (n + 1) := by rw [he]
        _ = Δ * n + Δ := by ring

/-- Solve `4m ≡ Δ (mod n)` when `4 ∣ Δ`, or `n` is odd, or
    `n ≡ 2 (mod 4)` and `Δ` is even. -/
lemma bhk_s7_solve4 (n Δ : ℕ) (hΔ : Δ < n)
    (h : Δ % 4 = 0 ∨ n % 2 = 1 ∨ (n % 4 = 2 ∧ Δ % 2 = 0)) :
    ∃ m : ℕ, 4 * m % n = Δ := by
  rcases h with h | h | ⟨h4, hΔ2⟩
  · exact ⟨Δ / 4, by
      rw [show 4 * (Δ / 4) = Δ from by omega, Nat.mod_eq_of_lt hΔ]⟩
  · rcases (by omega : n % 4 = 1 ∨ n % 4 = 3) with h4 | h4
    · refine ⟨Δ * ((3 * n + 1) / 4), bhk_s7_solve_aux n 4 _ (3 * Δ) Δ hΔ ?_⟩
      have he : 4 * ((3 * n + 1) / 4) = 3 * n + 1 := by omega
      calc 4 * (Δ * ((3 * n + 1) / 4)) = Δ * (4 * ((3 * n + 1) / 4)) := by ring
        _ = Δ * (3 * n + 1) := by rw [he]
        _ = 3 * Δ * n + Δ := by ring
    · refine ⟨Δ * ((n + 1) / 4), bhk_s7_solve_aux n 4 _ Δ Δ hΔ ?_⟩
      have he : 4 * ((n + 1) / 4) = n + 1 := by omega
      calc 4 * (Δ * ((n + 1) / 4)) = Δ * (4 * ((n + 1) / 4)) := by ring
        _ = Δ * (n + 1) := by rw [he]
        _ = Δ * n + Δ := by ring
  · refine ⟨Δ / 2 * ((n + 2) / 4), bhk_s7_solve_aux n 4 _ (Δ / 2) Δ hΔ ?_⟩
    have he : 4 * ((n + 2) / 4) = n + 2 := by omega
    have hΔ' : 2 * (Δ / 2) = Δ := by omega
    calc 4 * (Δ / 2 * ((n + 2) / 4)) = Δ / 2 * (4 * ((n + 2) / 4)) := by ring
      _ = Δ / 2 * (n + 2) := by rw [he]
      _ = Δ / 2 * n + 2 * (Δ / 2) := by ring
      _ = Δ / 2 * n + Δ := by rw [hΔ']

/-! ## (13)-minimal selection (BHK §3.3) -/

/-- **Minimal-element selection.** From any nonzero `G`-element in the box
    `[-B, B] × [-C, C]`, produce one that is additionally *(13)-minimal*:
    no other nonzero `G`-element lies in its centered box
    `[-|i|, |i|] × [-|j|, |j|]` except the four corners `(±i, ±j)`.

    Proof: descend on the measure `(|i|+1)·(|j|+1)` — any (13)-violator is
    strictly smaller in measure and stays in the outer box. -/
lemma bhk_s7_minimal_select (G : Set (ℝ × ℝ)) (n : ℕ) (B C : ℝ)
    (h_ex : ∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
      |(ij.1 : ℝ)| ≤ B ∧ |(ij.2 : ℝ)| ≤ C) :
    ∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
      |(ij.1 : ℝ)| ≤ B ∧ |(ij.2 : ℝ)| ≤ C ∧
      ∀ kl : ℤ × ℤ, kl ≠ (0, 0) → |kl.1| ≤ |ij.1| → |kl.2| ≤ |ij.2| →
        ¬(|kl.1| = |ij.1| ∧ |kl.2| = |ij.2|) →
        ((kl.1 : ℝ) / n, (kl.2 : ℝ) / n) ∉ G := by
  obtain ⟨ij₀, h₀⟩ := h_ex
  -- Descend on the measure m = (|i|+1)(|j|+1).
  suffices key : ∀ m : ℕ, ∀ ij : ℤ × ℤ,
      (ij.1.natAbs + 1) * (ij.2.natAbs + 1) ≤ m →
      ij ≠ (0, 0) → ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G →
      |(ij.1 : ℝ)| ≤ B → |(ij.2 : ℝ)| ≤ C →
      ∃ ij' : ℤ × ℤ, ij' ≠ (0, 0) ∧
        ((ij'.1 : ℝ) / n, (ij'.2 : ℝ) / n) ∈ G ∧
        |(ij'.1 : ℝ)| ≤ B ∧ |(ij'.2 : ℝ)| ≤ C ∧
        ∀ kl : ℤ × ℤ, kl ≠ (0, 0) → |kl.1| ≤ |ij'.1| → |kl.2| ≤ |ij'.2| →
          ¬(|kl.1| = |ij'.1| ∧ |kl.2| = |ij'.2|) →
          ((kl.1 : ℝ) / n, (kl.2 : ℝ) / n) ∉ G by
    exact key ((ij₀.1.natAbs + 1) * (ij₀.2.natAbs + 1)) ij₀ le_rfl
      h₀.1 h₀.2.1 h₀.2.2.1 h₀.2.2.2
  intro m
  induction m with
  | zero =>
    intro ij hm _ _ _ _
    have hpos : 0 < (ij.1.natAbs + 1) * (ij.2.natAbs + 1) :=
      Nat.mul_pos (by omega) (by omega)
    omega
  | succ m ih =>
    intro ij hm hne hmem hB hC
    by_cases hmin : ∀ kl : ℤ × ℤ, kl ≠ (0, 0) → |kl.1| ≤ |ij.1| →
        |kl.2| ≤ |ij.2| → ¬(|kl.1| = |ij.1| ∧ |kl.2| = |ij.2|) →
        ((kl.1 : ℝ) / n, (kl.2 : ℝ) / n) ∉ G
    · exact ⟨ij, hne, hmem, hB, hC, hmin⟩
    · push_neg at hmin
      obtain ⟨kl, hkl_ne, hkl_i, hkl_j, hkl_corner, hkl_mem⟩ := hmin
      -- The violator is strictly smaller in measure and stays in the box.
      have habs_i : kl.1.natAbs ≤ ij.1.natAbs := by
        rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs] at hkl_i
        exact_mod_cast hkl_i
      have habs_j : kl.2.natAbs ≤ ij.2.natAbs := by
        rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs] at hkl_j
        exact_mod_cast hkl_j
      have habs_ne : kl.1.natAbs ≠ ij.1.natAbs ∨ kl.2.natAbs ≠ ij.2.natAbs := by
        by_contra hcon
        push_neg at hcon
        have h1 : |kl.1| = |ij.1| := by
          rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs]
          exact_mod_cast hcon.1
        have h2 : |kl.2| = |ij.2| := by
          rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs]
          exact_mod_cast hcon.2
        exact hkl_corner h1 h2
      have hmeas : (kl.1.natAbs + 1) * (kl.2.natAbs + 1)
          < (ij.1.natAbs + 1) * (ij.2.natAbs + 1) := by
        rcases habs_ne with h | h
        · exact Nat.mul_lt_mul_of_lt_of_le (by omega) (by omega) (by omega)
        · exact Nat.mul_lt_mul_of_le_of_lt (by omega) (by omega) (by omega)
      have hkl_B : |(kl.1 : ℝ)| ≤ B := by
        refine le_trans ?_ hB
        rw [← Int.cast_abs, ← Int.cast_abs]
        exact_mod_cast hkl_i
      have hkl_C : |(kl.2 : ℝ)| ≤ C := by
        refine le_trans ?_ hC
        rw [← Int.cast_abs, ← Int.cast_abs]
        exact_mod_cast hkl_j
      exact ih kl (by omega) hkl_ne hkl_mem hkl_B hkl_C

/-- **Corollary 6 with (13)-minimality (BHK §3.3).** Either `G` hits every
    `α × β` rectangle, or there is a nonzero `(i, j)` in the cone (10) that
    is additionally *(13)-minimal*: no nonzero `G`-element lies in
    `[-|i|, |i|] × [-|j|, |j|]` other than the corners `(±i, ±j)`. This is
    the form needed for Lemma 7's order bound (14) and the Table-9
    circle-period analysis. Requires `n ≥ 1/β` (Cases A & B only; our
    application has `n ≥ 7 > 9/2 = 1/β`). -/
theorem bhk_s7_corollary_6_minimal
    (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (hG_lift : IsBHKLift G n)
    (α β : ℝ) (hα : 0 < α) (hα' : α < 1) (hβ : 0 < β) (hβ' : β < 1)
    (hαβ : α * β ≥ 1 / (n : ℝ)) (h_nβ : 1 / β ≤ (n : ℝ)) :
    (∀ x₁ x₂, (G ∩ bhkRectangle x₁ x₂ α β).Nonempty) ∨
    (∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
      0 ≤ ij.1 ∧ (ij.1 : ℝ) < 1 / β ∧
      -1 / α - β / α * ij.1 < (ij.2 : ℝ) ∧
      (ij.2 : ℝ) < 1 / α + β / α * ij.1 ∧
      (∀ kl : ℤ × ℤ, kl ≠ (0, 0) → |kl.1| ≤ |ij.1| → |kl.2| ≤ |ij.2| →
        ¬(|kl.1| = |ij.1| ∧ |kl.2| = |ij.2|) →
        ((kl.1 : ℝ) / n, (kl.2 : ℝ) / n) ∉ G)) := by
  have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
  have h_1β_pos : (0 : ℝ) < 1/β := one_div_pos.mpr hβ
  have hβn_pos : (0 : ℝ) < β * n := mul_pos hβ hn_pos
  have h_1β_le_αn : (1 : ℝ) / β ≤ α * n := by
    have hαβn_ge_one : (1 : ℝ) ≤ α * β * n := by
      have h := hαβ
      rw [ge_iff_le, div_le_iff₀ hn_pos] at h
      linarith
    rw [div_le_iff₀ hβ]
    nlinarith
  by_cases h_all_hit : ∀ x₁ x₂, (G ∩ bhkRectangle x₁ x₂ α β).Nonempty
  · exact Or.inl h_all_hit
  refine Or.inr ?_
  push_neg at h_all_hit
  obtain ⟨x₁, x₂, h_miss_eq⟩ := h_all_hit
  have h_miss : ¬ (G ∩ bhkRectangle x₁ x₂ α β).Nonempty := by
    rw [Set.not_nonempty_iff_eq_empty]; exact h_miss_eq
  obtain ⟨H, hH_card, hG_iff⟩ := id hG_lift
  haveI : NeZero n := ⟨by omega⟩
  have hn_ne_real : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  have hG_int_iff : ∀ a b : ℤ, ((a : ℝ) / n, (b : ℝ) / n) ∈ G ↔
      ((a : ZMod n), (b : ZMod n)) ∈ H :=
    fun a b => bhk_lift_int_mem_iff G n hn H hG_iff a b
  obtain ⟨B, hB_nn, hB_lt, ij₀, hij₀_ne, hij₀_H, hij₀_B, hij₀_β⟩ :=
    bhk_corollary_6_small_i_witness n hn H hH_card β hβ
  -- (13)-minimal selection within the box [-B, B] × [-βn, βn].
  obtain ⟨ij', hij'_ne, hij'_G, hij'_B, hij'_β, hij'_min⟩ :=
    bhk_s7_minimal_select G n B (β * n)
      ⟨ij₀, hij₀_ne, (hG_int_iff ij₀.1 ij₀.2).mpr hij₀_H, hij₀_B, hij₀_β⟩
  have hij'_i_lt : |(ij'.1 : ℝ)| < 1 / β := lt_of_le_of_lt hij'_B hB_lt
  have hij'_box_αn : |(ij'.1 : ℝ)| ≤ α * n := le_trans hij'_i_lt.le h_1β_le_αn
  -- (13)-minimality implies the multiple-minimality `rectangle_minimal` needs.
  have hij'_mult_min : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ℝ) / n, (j₀ : ℝ) / n) ∈ G → (ij'.1, ij'.2) ≠ (k * i₀, k * j₀) := by
    intro i₀ j₀ k hk h₀_G heq
    have hi_eq : ij'.1 = k * i₀ := congr_arg Prod.fst heq
    have hj_eq : ij'.2 = k * j₀ := congr_arg Prod.snd heq
    have hk1 : (1 : ℤ) ≤ |k| := by
      rw [abs_of_pos (by omega : (0:ℤ) < k)]; omega
    have hk2 : (2 : ℤ) ≤ |k| := by
      rw [abs_of_pos (by omega : (0:ℤ) < k)]; omega
    have hne₀ : (i₀, j₀) ≠ ((0 : ℤ), (0 : ℤ)) := by
      intro h00
      have hi₀ : i₀ = 0 := congr_arg Prod.fst h00
      have hj₀ : j₀ = 0 := congr_arg Prod.snd h00
      apply hij'_ne
      exact Prod.ext (by rw [hi_eq, hi₀, mul_zero])
        (by rw [hj_eq, hj₀, mul_zero])
    have habs_i : |i₀| ≤ |ij'.1| := by
      rw [hi_eq, abs_mul]
      exact le_mul_of_one_le_left (abs_nonneg _) hk1
    have habs_j : |j₀| ≤ |ij'.2| := by
      rw [hj_eq, abs_mul]
      exact le_mul_of_one_le_left (abs_nonneg _) hk1
    have hcorner : ¬(|i₀| = |ij'.1| ∧ |j₀| = |ij'.2|) := by
      rintro ⟨h1, h2⟩
      rw [hi_eq, abs_mul] at h1
      rw [hj_eq, abs_mul] at h2
      have hmul_i : 2 * |i₀| ≤ |k| * |i₀| :=
        mul_le_mul_of_nonneg_right hk2 (abs_nonneg i₀)
      have hmul_j : 2 * |j₀| ≤ |k| * |j₀| :=
        mul_le_mul_of_nonneg_right hk2 (abs_nonneg j₀)
      have hi0 : i₀ = 0 := by
        have := abs_nonneg i₀
        have h_le : |i₀| ≤ 0 := by linarith
        have : |i₀| = 0 := le_antisymm h_le (abs_nonneg i₀)
        exact abs_eq_zero.mp this
      have hj0 : j₀ = 0 := by
        have := abs_nonneg j₀
        have h_le : |j₀| ≤ 0 := by linarith
        have : |j₀| = 0 := le_antisymm h_le (abs_nonneg j₀)
        exact abs_eq_zero.mp this
      exact hne₀ (by rw [hi0, hj0])
    exact hij'_min (i₀, j₀) hne₀ habs_i habs_j hcorner h₀_G
  -- BHK (12) for the minimal element.
  have h_bound := bhk_main_lemma_rectangle_minimal G n hn hG_lift α β hα hα'
    hβ hβ' ij'.1 ij'.2 (by exact hij'_ne) ⟨hij'_box_αn, hij'_β⟩
    (by exact hij'_G) hij'_mult_min ⟨x₁, x₂, h_miss⟩
  -- G-negation symmetry for the sign normalization.
  have hG_neg : ∀ a b : ℤ, ((a : ℝ) / n, (b : ℝ) / n) ∈ G →
      (((-a : ℤ) : ℝ) / n, ((-b : ℤ) : ℝ) / n) ∈ G := by
    intro a b hab
    have h_in_H : ((a : ZMod n), (b : ZMod n)) ∈ H := (hG_int_iff a b).mp hab
    rw [hG_int_iff]
    have : (((-a : ℤ) : ZMod n), ((-b : ℤ) : ZMod n)) =
        -((a : ZMod n), (b : ZMod n)) := by
      ext
      · push_cast; simp
      · push_cast; simp
    rw [this]; exact H.neg_mem h_in_H
  -- From (12) + |j| ≤ βn: α·|j| < 1 + β·|i|.
  have h_j_alpha_bound : α * |(ij'.2 : ℝ)| < 1 + β * |(ij'.1 : ℝ)| := by
    have h_abs_i_nn : (0 : ℝ) ≤ |(ij'.1 : ℝ)| := abs_nonneg _
    have h_key : 2 / (n : ℝ) * |(ij'.1 : ℝ)| * |(ij'.2 : ℝ)| ≤
        2 * β * |(ij'.1 : ℝ)| := by
      have h_abs_j_nn : (0 : ℝ) ≤ |(ij'.2 : ℝ)| := abs_nonneg _
      have h_step : (2 / (n : ℝ)) * |(ij'.2 : ℝ)| ≤ 2 * β := by
        rw [div_mul_eq_mul_div, div_le_iff₀ hn_pos]
        linarith [hij'_β]
      nlinarith [h_step, h_abs_i_nn]
    linarith [h_bound, h_key]
  by_cases h_pos : 0 ≤ ij'.1
  swap
  · -- ij'.1 < 0: use (-ij'.1, -ij'.2).
    have h_neg_i : ij'.1 < 0 := by omega
    have h_i_abs : |(ij'.1 : ℝ)| = -(ij'.1 : ℝ) :=
      abs_of_neg (by exact_mod_cast h_neg_i)
    refine ⟨(-ij'.1, -ij'.2), ?_, ?_, by omega, ?_, ?_, ?_, ?_⟩
    · intro h_eq
      apply hij'_ne
      have h1 : -ij'.1 = 0 := congr_arg Prod.fst h_eq
      have h2 : -ij'.2 = 0 := congr_arg Prod.snd h_eq
      exact Prod.ext (by omega) (by omega)
    · have := hG_neg ij'.1 ij'.2 hij'_G
      convert this using 2 <;> push_cast <;> ring
    · push_cast
      linarith [hij'_i_lt]
    · have h_j_abs_ge : (ij'.2 : ℝ) ≤ |(ij'.2 : ℝ)| := le_abs_self _
      have h_α_j_le : α * (ij'.2 : ℝ) ≤ α * |(ij'.2 : ℝ)| :=
        mul_le_mul_of_nonneg_left h_j_abs_ge hα.le
      have h_total : α * (ij'.2 : ℝ) < 1 + β * (-(ij'.1 : ℝ)) := by
        rw [show β * (-(ij'.1 : ℝ)) = β * |(ij'.1 : ℝ)| from by rw [h_i_abs]]
        linarith [h_j_alpha_bound, h_α_j_le]
      have h_div : (ij'.2 : ℝ) < (1 + β * (-(ij'.1 : ℝ))) / α :=
        (lt_div_iff₀ hα).mpr (by linarith)
      have h_eq : (-1 : ℝ)/α - β/α * ((-ij'.1 : ℤ) : ℝ) =
          -((1 + β * (-(ij'.1 : ℝ))) / α) := by
        push_cast; field_simp; ring
      push_cast at h_eq ⊢
      linarith [h_div, h_eq]
    · have h_j_abs_ge : -(ij'.2 : ℝ) ≤ |(ij'.2 : ℝ)| := neg_le_abs _
      have h_α_j_lt : α * (-(ij'.2 : ℝ)) ≤ α * |(ij'.2 : ℝ)| :=
        mul_le_mul_of_nonneg_left h_j_abs_ge hα.le
      have h_total : α * (-(ij'.2 : ℝ)) < 1 + β * (-(ij'.1 : ℝ)) := by
        rw [show β * (-(ij'.1 : ℝ)) = β * |(ij'.1 : ℝ)| from by rw [h_i_abs]]
        linarith [h_j_alpha_bound, h_α_j_lt]
      have h_div : -(ij'.2 : ℝ) < (1 + β * (-(ij'.1 : ℝ))) / α :=
        (lt_div_iff₀ hα).mpr (by linarith)
      have h_eq : (1 : ℝ)/α + β/α * ((-ij'.1 : ℤ) : ℝ) =
          (1 + β * (-(ij'.1 : ℝ))) / α := by
        push_cast; field_simp
      push_cast at h_eq ⊢
      linarith [h_div, h_eq]
    · -- minimality is invariant under negation.
      intro kl hkl hk1 hk2 hcorner
      refine hij'_min kl hkl ?_ ?_ ?_
      · simpa [abs_neg] using hk1
      · simpa [abs_neg] using hk2
      · simpa [abs_neg] using hcorner
  · -- ij'.1 ≥ 0: use ij' itself.
    have h_i_abs : |(ij'.1 : ℝ)| = (ij'.1 : ℝ) :=
      abs_of_nonneg (by exact_mod_cast h_pos)
    refine ⟨ij', hij'_ne, hij'_G, h_pos, ?_, ?_, ?_, hij'_min⟩
    · linarith [hij'_i_lt]
    · have h_j_abs_ge : -(ij'.2 : ℝ) ≤ |(ij'.2 : ℝ)| := neg_le_abs _
      have h_α_j_lt : α * (-(ij'.2 : ℝ)) ≤ α * |(ij'.2 : ℝ)| :=
        mul_le_mul_of_nonneg_left h_j_abs_ge hα.le
      have h_total : α * (-(ij'.2 : ℝ)) < 1 + β * (ij'.1 : ℝ) := by
        rw [← h_i_abs]; linarith [h_j_alpha_bound, h_α_j_lt]
      have h_div : -(ij'.2 : ℝ) < (1 + β * (ij'.1 : ℝ)) / α :=
        (lt_div_iff₀ hα).mpr (by linarith)
      have h_eq : (-1 : ℝ)/α - β/α * (ij'.1 : ℝ) =
          -((1 + β * (ij'.1 : ℝ)) / α) := by
        field_simp; ring
      linarith [h_div, h_eq]
    · have h_j_le : (ij'.2 : ℝ) ≤ |(ij'.2 : ℝ)| := le_abs_self _
      have h_α_j_le : α * (ij'.2 : ℝ) ≤ α * |(ij'.2 : ℝ)| :=
        mul_le_mul_of_nonneg_left h_j_le hα.le
      have h_total : α * (ij'.2 : ℝ) < 1 + β * (ij'.1 : ℝ) := by
        rw [← h_i_abs]; linarith [h_j_alpha_bound, h_α_j_le]
      have h_div : (ij'.2 : ℝ) < (1 + β * (ij'.1 : ℝ)) / α :=
        (lt_div_iff₀ hα).mpr (by linarith)
      have h_eq : (1 : ℝ)/α + β/α * (ij'.1 : ℝ) =
          (1 + β * (ij'.1 : ℝ)) / α := by
        field_simp
      linarith [h_div, h_eq]

/-! ## Rectangle hit ⟹ lonely time (extracted bridge) -/

/-! ## The exceptional group `G₄` — covering analysis (BHK pp. 43–44)

Point-based reconstruction of BHK's "4-block flanked by two consecutive
5-blocks" argument. All block bookkeeping goes through
`block_containment` / `block_length_bound` / `not_mem_unsafeOf_of_in_gap`
from `IntLRC_6_BHK_Lemma4.lean`; no measure theory. -/

/-- **Single 4-block dichotomy.** If `[a, b]` is covered by `U₄ ∪ U₅` then
    either no point of `[a, b]` is 4-unsafe, or all its 4-unsafe points lie
    in one 4-block `(m - 1/6, m + 1/6)` (in `v₄`-coordinates), witnessed by
    at least one point. Otherwise the full 4-gap between two distinct
    occupied 4-blocks sits inside `[a, b]`, is 4-safe hence ⊆ `U₅`, and
    `block_length_bound` forces `2 v₅ < v₄` — impossible. -/
lemma bhk_g4_single_block (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i) (a b : ℝ)
    (hI : Set.Icc a b ⊆ unsafeOf speeds ⟨3, by omega⟩ ∪ unsafeOf speeds ⟨4, by omega⟩) :
    (∀ t ∈ Set.Icc a b, t ∉ unsafeOf speeds ⟨3, by omega⟩) ∨
    ∃ m : ℤ, (∃ t₀ ∈ Set.Icc a b, t₀ ∈ unsafeOf speeds ⟨3, by omega⟩) ∧
      ∀ t ∈ Set.Icc a b, t ∈ unsafeOf speeds ⟨3, by omega⟩ →
        (m : ℝ) - 1/6 < (speeds ⟨3, by omega⟩ : ℝ) * t ∧
        (speeds ⟨3, by omega⟩ : ℝ) * t < (m : ℝ) + 1/6 := by
  have hv4pos : (0 : ℝ) < (speeds ⟨3, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv5pos : (0 : ℝ) < (speeds ⟨4, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv45 : (speeds ⟨3, by omega⟩ : ℝ) < (speeds ⟨4, by omega⟩ : ℝ) := by
    have hflt : (⟨3, by omega⟩ : Fin 5) < ⟨4, by omega⟩ :=
      Fin.mk_lt_mk.mpr (by omega)
    exact_mod_cast hmono hflt
  by_cases hne4 : ∃ t₀ ∈ Set.Icc a b, t₀ ∈ unsafeOf speeds ⟨3, by omega⟩
  · right
    obtain ⟨t₀, ht₀I, ht₀U⟩ := hne4
    have ht₀U' := ht₀U
    rw [mem_unsafeOf_iff_bhkB] at ht₀U'
    obtain ⟨m, hm⟩ := ht₀U'
    refine ⟨m, ⟨t₀, ht₀I, ht₀U⟩, ?_⟩
    intro t htI htU
    have htU' := htU
    rw [mem_unsafeOf_iff_bhkB] at htU'
    obtain ⟨m', hm'⟩ := htU'
    -- If m' = m we are done; otherwise derive `2 v₅ < v₄`, a contradiction.
    rcases eq_or_ne m' m with rfl | hne
    · exact ⟨by have := neg_lt_of_abs_lt hm'; linarith,
             by have := lt_of_abs_lt hm'; linarith⟩
    exfalso
    -- Order the two blocks: (mℓ, tℓ) low block/point, (mh, th) high.
    obtain ⟨mℓ, mh, tℓ, th, hmlh, hℓ, hh, htℓI, hthI⟩ :
        ∃ (mℓ mh : ℤ) (tℓ th : ℝ), mℓ < mh ∧
          |(speeds ⟨3, by omega⟩ : ℝ) * tℓ - mℓ| < 1/6 ∧
          |(speeds ⟨3, by omega⟩ : ℝ) * th - mh| < 1/6 ∧
          tℓ ∈ Set.Icc a b ∧ th ∈ Set.Icc a b := by
      rcases lt_or_gt_of_ne hne with h | h
      · exact ⟨m', m, t, t₀, h, hm', hm, htI, ht₀I⟩
      · exact ⟨m, m', t₀, t, h, hm, hm', ht₀I, htI⟩
    -- The 4-gap after block mℓ lies between tℓ and th, hence inside [a, b].
    set gL : ℝ := ((mℓ : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ) with hgL_def
    set gR : ℝ := ((mℓ : ℝ) + 5/6) / (speeds ⟨3, by omega⟩ : ℝ) with hgR_def
    have hmh : (mℓ : ℝ) + 1 ≤ (mh : ℝ) := by exact_mod_cast hmlh
    have htℓ_lt : tℓ < gL := by
      rw [hgL_def, lt_div_iff₀ hv4pos]
      have := lt_of_abs_lt hℓ; linarith
    have hth_gt : gR < th := by
      rw [hgR_def, div_lt_iff₀ hv4pos]
      have := neg_lt_of_abs_lt hh; linarith
    have hgLR : gL ≤ gR := by
      rw [hgL_def, hgR_def, div_le_div_iff₀ hv4pos hv4pos]
      nlinarith
    -- The closed gap [gL, gR] is 4-safe and inside [a, b], hence ⊆ U₅.
    have hgap_sub : Set.Icc gL gR ⊆ unsafeOf speeds ⟨4, by omega⟩ := by
      intro s hs
      have hsI : s ∈ Set.Icc a b :=
        ⟨le_trans htℓI.1 (le_trans htℓ_lt.le hs.1),
         le_trans hs.2 (le_trans hth_gt.le hthI.2)⟩
      have hs4 : s ∉ unsafeOf speeds ⟨3, by omega⟩ :=
        not_mem_unsafeOf_of_in_gap speeds ⟨3, by omega⟩ (hpos _) mℓ s hs.1 hs.2
      rcases hI hsI with h | h
      · exact absurd h hs4
      · exact h
    have hlen := block_length_bound speeds ⟨4, by omega⟩ (hpos _) gL gR hgLR hgap_sub
    -- gR - gL = (2/3)/v₄ < 1/(3 v₅) ⟹ 2 v₅ < v₄ < v₅: contradiction.
    have hglen : gR - gL = (2/3) / (speeds ⟨3, by omega⟩ : ℝ) := by
      rw [hgR_def, hgL_def]
      field_simp
      ring
    rw [hglen, div_lt_div_iff₀ hv4pos (by positivity)] at hlen
    nlinarith
  · left
    intro t htI htU
    exact hne4 ⟨t, htI, htU⟩

/-- **Covering `t* = 1/(6 v₁)` forces `5 v₁ < v₅`** (BHK: "in order to cover
    the point `t = x₁/6` we must have `x₅ < x₁/5`"). At `t*` every runner `j`
    sits at `v_j/(6 v₁) ≥ 1/6`, so whichever runner covers `t*` has its block
    index `m ≥ 1`, forcing `v_j > 5 v₁`; monotonicity lifts this to `v₅`. -/
lemma bhk_g4_five_v1 (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i)
    (hne : ∀ t : ℝ, ∃ i, circDist ((speeds i : ℝ) * t) < 1/6) :
    5 * (speeds ⟨0, by omega⟩ : ℝ) < (speeds ⟨4, by omega⟩ : ℝ) := by
  have hv1pos : (0 : ℝ) < (speeds ⟨0, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  set tstar : ℝ := 1 / (6 * (speeds ⟨0, by omega⟩ : ℝ)) with htstar_def
  obtain ⟨i, hi⟩ := hne tstar
  have hi_unsafe : tstar ∈ unsafeOf speeds i := (mem_unsafeOf_iff speeds i tstar).mpr hi
  rw [mem_unsafeOf_iff_bhkB] at hi_unsafe
  obtain ⟨m, hm⟩ := hi_unsafe
  -- v₁ ≤ v_i ≤ v₅ by monotonicity.
  have hv1i : (speeds ⟨0, by omega⟩ : ℝ) ≤ (speeds i : ℝ) := by
    exact_mod_cast hmono.monotone (show (⟨0, by omega⟩ : Fin 5) ≤ i from i.zero_le)
  have hvi5 : (speeds i : ℝ) ≤ (speeds ⟨4, by omega⟩ : ℝ) := by
    exact_mod_cast hmono.monotone (show i ≤ (⟨4, by omega⟩ : Fin 5) from i.le_last)
  have hx_eq : (speeds i : ℝ) * tstar =
      (speeds i : ℝ) / (6 * (speeds ⟨0, by omega⟩ : ℝ)) := by
    rw [htstar_def]; ring
  rw [hx_eq] at hm
  -- The position is ≥ 1/6, so the covering block index m is ≥ 1.
  have hx_ge : 1/6 ≤ (speeds i : ℝ) / (6 * (speeds ⟨0, by omega⟩ : ℝ)) := by
    rw [le_div_iff₀ (by positivity)]
    linarith
  have hm1R : (1 : ℝ) ≤ (m : ℝ) := by
    have hup := lt_of_abs_lt hm
    by_contra hm0
    push_neg at hm0
    have : (m : ℝ) ≤ 0 := by
      have : m ≤ 0 := by exact_mod_cast Int.lt_add_one_iff.mp (by exact_mod_cast hm0)
      exact_mod_cast this
    linarith
  -- v_i/(6 v₁) > m - 1/6 ≥ 5/6 ⟹ v_i > 5 v₁ ⟹ v₅ > 5 v₁.
  have hlow := neg_lt_of_abs_lt hm
  have h56 : 5/6 < (speeds i : ℝ) / (6 * (speeds ⟨0, by omega⟩ : ℝ)) := by
    linarith
  rw [div_lt_div_iff₀ (by positivity) (by positivity)] at h56
  linarith

/-- **The `G₄` 123-gap.** If at time `τ` the fractional positions are
    `{v₁τ} = 1/4`, `{v₂τ} = {v₃τ} = 1/2`, then on the whole interval
    `[τ - 1/(12 v₁), τ + 1/(3 v₃)]` runners 1, 2, 3 stay safe
    (BHK: `I = [kt₀ - x₁/12, kt₀ + 1/3]` is a 123-gap). Uses
    `3 v₁ < v₃ < 4 v₁` so that the slower runners cannot wrap. -/
lemma bhk_g4_123_gap (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i)
    (hsmall : 3 * speeds ⟨0, by omega⟩ < speeds ⟨2, by omega⟩)
    (h41 : speeds ⟨2, by omega⟩ < 4 * speeds ⟨0, by omega⟩)
    (τ : ℝ)
    (hf1 : Int.fract ((speeds ⟨0, by omega⟩ : ℝ) * τ) = 1/4)
    (hf2 : Int.fract ((speeds ⟨1, by omega⟩ : ℝ) * τ) = 1/2)
    (hf3 : Int.fract ((speeds ⟨2, by omega⟩ : ℝ) * τ) = 1/2)
    (t : ℝ)
    (ht : t ∈ Set.Icc (τ - 1/(12 * (speeds ⟨0, by omega⟩ : ℝ)))
                      (τ + 1/(3 * (speeds ⟨2, by omega⟩ : ℝ)))) :
    t ∉ unsafeOf speeds ⟨0, by omega⟩ ∧ t ∉ unsafeOf speeds ⟨1, by omega⟩ ∧
    t ∉ unsafeOf speeds ⟨2, by omega⟩ := by
  have hv1pos : (0 : ℝ) < (speeds ⟨0, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv2pos : (0 : ℝ) < (speeds ⟨1, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv3pos : (0 : ℝ) < (speeds ⟨2, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv12 : (speeds ⟨0, by omega⟩ : ℝ) < (speeds ⟨1, by omega⟩ : ℝ) := by
    exact_mod_cast hmono (Fin.mk_lt_mk.mpr (by omega : (0:ℕ) < 1))
  have hv23 : (speeds ⟨1, by omega⟩ : ℝ) < (speeds ⟨2, by omega⟩ : ℝ) := by
    exact_mod_cast hmono (Fin.mk_lt_mk.mpr (by omega : (1:ℕ) < 2))
  have hsmallR : 3 * (speeds ⟨0, by omega⟩ : ℝ) < (speeds ⟨2, by omega⟩ : ℝ) := by
    exact_mod_cast hsmall
  have h41R : (speeds ⟨2, by omega⟩ : ℝ) < 4 * (speeds ⟨0, by omega⟩ : ℝ) := by
    exact_mod_cast h41
  obtain ⟨ht_lo, ht_hi⟩ := ht
  -- Generic safety step: runner with fract position f at τ, staying within
  -- [f - 1/3·(v/v wraps)] — done per runner with explicit floor anchors.
  have key : ∀ j : Fin 5, ∀ f : ℝ, Int.fract ((speeds j : ℝ) * τ) = f →
      1/6 ≤ f - (speeds j : ℝ) / (12 * (speeds ⟨0, by omega⟩ : ℝ)) →
      f + (speeds j : ℝ) / (3 * (speeds ⟨2, by omega⟩ : ℝ)) ≤ 5/6 →
      t ∉ unsafeOf speeds j := by
    intro j f hf hlo hhi
    have hvjpos : (0 : ℝ) < (speeds j : ℝ) := by exact_mod_cast hpos _
    have hfloor : ((⌊(speeds j : ℝ) * τ⌋ : ℝ)) + f = (speeds j : ℝ) * τ := by
      rw [← hf]; exact Int.floor_add_fract _
    apply not_mem_unsafeOf_of_in_gap speeds j (hpos _) ⌊(speeds j : ℝ) * τ⌋ t
    · rw [div_le_iff₀ hvjpos]
      have h1 : (speeds j : ℝ) * t ≥ (speeds j : ℝ) * τ -
          (speeds j : ℝ) / (12 * (speeds ⟨0, by omega⟩ : ℝ)) := by
        have := mul_le_mul_of_nonneg_left ht_lo (le_of_lt hvjpos)
        have hxx : (speeds j : ℝ) * (τ - 1/(12 * (speeds ⟨0, by omega⟩ : ℝ))) =
            (speeds j : ℝ) * τ - (speeds j : ℝ) / (12 * (speeds ⟨0, by omega⟩ : ℝ)) := by
          ring
        linarith [hxx ▸ this]
      nlinarith [h1, hfloor, hlo]
    · rw [le_div_iff₀ hvjpos]
      have h2 : (speeds j : ℝ) * t ≤ (speeds j : ℝ) * τ +
          (speeds j : ℝ) / (3 * (speeds ⟨2, by omega⟩ : ℝ)) := by
        have := mul_le_mul_of_nonneg_left ht_hi (le_of_lt hvjpos)
        have hxx : (speeds j : ℝ) * (τ + 1/(3 * (speeds ⟨2, by omega⟩ : ℝ))) =
            (speeds j : ℝ) * τ + (speeds j : ℝ) / (3 * (speeds ⟨2, by omega⟩ : ℝ)) := by
          ring
        linarith [hxx ▸ this]
      nlinarith [h2, hfloor, hhi]
  refine ⟨key _ (1/4) hf1 ?_ ?_, key _ (1/2) hf2 ?_ ?_, key _ (1/2) hf3 ?_ ?_⟩
  · -- 1/6 ≤ 1/4 - v₁/(12 v₁) = 1/4 - 1/12
    have : (speeds ⟨0, by omega⟩ : ℝ) / (12 * (speeds ⟨0, by omega⟩ : ℝ)) = 1/12 := by
      field_simp
    rw [this]; norm_num
  · -- 1/4 + v₁/(3 v₃) ≤ 1/4 + 1/9 ≤ 5/6 since 3 v₁ < v₃
    have : (speeds ⟨0, by omega⟩ : ℝ) / (3 * (speeds ⟨2, by omega⟩ : ℝ)) ≤ 1/9 := by
      rw [div_le_iff₀ (by positivity)]
      linarith
    linarith
  · -- 1/6 ≤ 1/2 - v₂/(12 v₁) since v₂ < 4 v₁
    have : (speeds ⟨1, by omega⟩ : ℝ) / (12 * (speeds ⟨0, by omega⟩ : ℝ)) ≤ 1/3 := by
      rw [div_le_iff₀ (by positivity)]
      linarith
    linarith
  · -- 1/2 + v₂/(3 v₃) ≤ 1/2 + 1/3 = 5/6 since v₂ < v₃
    have : (speeds ⟨1, by omega⟩ : ℝ) / (3 * (speeds ⟨2, by omega⟩ : ℝ)) ≤ 1/3 := by
      rw [div_le_iff₀ (by positivity)]
      linarith
    linarith
  · -- 1/6 ≤ 1/2 - v₃/(12 v₁) since v₃ < 4 v₁
    have : (speeds ⟨2, by omega⟩ : ℝ) / (12 * (speeds ⟨0, by omega⟩ : ℝ)) ≤ 1/3 := by
      rw [div_le_iff₀ (by positivity)]
      linarith
    linarith
  · -- 1/2 + v₃/(3 v₃) = 1/2 + 1/3 = 5/6
    have : (speeds ⟨2, by omega⟩ : ℝ) / (3 * (speeds ⟨2, by omega⟩ : ℝ)) = 1/3 := by
      field_simp
    rw [this]; norm_num

set_option maxHeartbeats 1600000 in
/-- **The flanking bounds** (shared by the `G₄` and `G₇` covering
    arguments). If an interval `[A, B]` of length `> 7/(12 v₃)` is covered
    by `U₄ ∪ U₅`, then BHK's covering analysis forces a single 4-block
    flanked by two *consecutive* 5-blocks, pinning `2 v₄ < v₅` and
    `7 v₅ < 16 v₃`. The caller supplies `h_tail`, which kills the
    degenerate position where the 4-block covers one end of the interval
    (in `G₄` units this is `1/(12 v₁) < 1/(3 v₅)` against `5 v₁ < v₅`; in
    `G₇` units `2/(7 v₃) < 1/(3 v₅)` against `v₅ > 5 v₁ > (5/4) v₃`). -/
lemma bhk_g4_flanking (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i)
    (A B : ℝ)
    (hL : 7/(12 * (speeds ⟨2, by omega⟩ : ℝ)) < B - A)
    (h_tail : B - A - 1/(3 * (speeds ⟨2, by omega⟩ : ℝ)) <
        1/(3 * (speeds ⟨4, by omega⟩ : ℝ)) → False)
    (hsub : Set.Icc A B ⊆
      unsafeOf speeds ⟨3, by omega⟩ ∪ unsafeOf speeds ⟨4, by omega⟩) :
    2 * (speeds ⟨3, by omega⟩ : ℝ) < (speeds ⟨4, by omega⟩ : ℝ) ∧
    7 * (speeds ⟨4, by omega⟩ : ℝ) < 16 * (speeds ⟨2, by omega⟩ : ℝ) := by
  have hv3pos : (0 : ℝ) < (speeds ⟨2, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv4pos : (0 : ℝ) < (speeds ⟨3, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv5pos : (0 : ℝ) < (speeds ⟨4, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv34 : (speeds ⟨2, by omega⟩ : ℝ) < (speeds ⟨3, by omega⟩ : ℝ) := by
    exact_mod_cast hmono (Fin.mk_lt_mk.mpr (by omega : (2:ℕ) < 3))
  have hv45 : (speeds ⟨3, by omega⟩ : ℝ) < (speeds ⟨4, by omega⟩ : ℝ) := by
    exact_mod_cast hmono (Fin.mk_lt_mk.mpr (by omega : (3:ℕ) < 4))
  have hALB : A < B := by
    have h0 : (0:ℝ) < 7/(12 * (speeds ⟨2, by omega⟩ : ℝ)) := by positivity
    linarith
  -- Length lower bound: B − A > 1/(3 v₃).
  have hL_3 : 1/(3 * (speeds ⟨2, by omega⟩ : ℝ)) < B - A := by
    have h0 : 1/(3 * (speeds ⟨2, by omega⟩ : ℝ)) <
        7/(12 * (speeds ⟨2, by omega⟩ : ℝ)) := by
      rw [div_lt_div_iff₀ (by positivity) (by positivity)]
      nlinarith
    linarith
  have hL_7 : 7/(12 * (speeds ⟨2, by omega⟩ : ℝ)) < B - A := hL
  -- Comparison of block lengths.
  have h35 : 1/(3 * (speeds ⟨4, by omega⟩ : ℝ)) <
      1/(3 * (speeds ⟨2, by omega⟩ : ℝ)) := by
    rw [div_lt_div_iff₀ (by positivity) (by positivity)]
    nlinarith
  have h34len : 1/(3 * (speeds ⟨3, by omega⟩ : ℝ)) <
      1/(3 * (speeds ⟨2, by omega⟩ : ℝ)) := by
    rw [div_lt_div_iff₀ (by positivity) (by positivity)]
    nlinarith
  rcases bhk_g4_single_block speeds hmono hpos A B hsub with hno4 | ⟨m, hwit, hall⟩
  · -- No 4-unsafe point: I sits in one 5-block, too short.
    exfalso
    have h5sub : Set.Icc A B ⊆ unsafeOf speeds ⟨4, by omega⟩ := by
      intro s hs
      rcases hsub hs with h | h
      · exact absurd h (hno4 s hs)
      · exact h
    have hlen := block_length_bound speeds ⟨4, by omega⟩ (hpos _) A B hALB.le h5sub
    linarith
  obtain ⟨t₀, ht₀I, ht₀U⟩ := hwit
  have ht₀m := hall t₀ ht₀I ht₀U
  -- Any point of I outside the open 4-block window is 5-unsafe.
  have h5of : ∀ s, s ∈ Set.Icc A B →
      ¬((m : ℝ) - 1/6 < (speeds ⟨3, by omega⟩ : ℝ) * s ∧
        (speeds ⟨3, by omega⟩ : ℝ) * s < (m : ℝ) + 1/6) →
      s ∈ unsafeOf speeds ⟨4, by omega⟩ := by
    intro s hs hnot
    rcases hsub hs with h | h
    · exact absurd (hall s hs h) hnot
    · exact h
  rcases le_or_gt ((m : ℝ) - 1/6) ((speeds ⟨3, by omega⟩ : ℝ) * A) with hpA | hAp <;>
    rcases le_or_gt ((speeds ⟨3, by omega⟩ : ℝ) * B) ((m : ℝ) + 1/6) with hBq | hqB
  · -- 4-block swallows I: I too long.
    exfalso
    have hBA : B - A ≤ 1/(3 * (speeds ⟨3, by omega⟩ : ℝ)) := by
