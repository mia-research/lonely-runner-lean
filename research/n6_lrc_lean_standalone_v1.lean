      mul_nonneg (show (0 : ℝ) ≤ (r : ℝ) - 33 by linarith) (show (0 : ℝ) ≤ (r : ℝ) by positivity)]
  have hq_ub : q ≤ 23 := by omega
  have hp_ub : p ≤ 7 := by omega
  -- enumerate q, r, p; impossible leaves die by arithmetic (omega) or coprimality (decide)
