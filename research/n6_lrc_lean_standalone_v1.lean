lemma bhk_prop11_exc_3_neg2 (p q r : ℕ) (hq18 : 18 ≤ q) (hcop : Nat.Coprime p q)
    (hp : 0 < p) (h3p : 3 * p < q) (hr2 : 2 * r = 3 * q - 3 * p)
    (h_nogood : ∀ k : ℤ,
      ¬ (Int.fract ((r : ℝ) / q * ((k : ℝ) + 1 / 2)) ∈ Set.Icc (1 / 6 : ℝ) (1 / 2) ∧
