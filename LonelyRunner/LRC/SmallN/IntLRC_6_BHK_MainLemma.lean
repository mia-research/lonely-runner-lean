import LonelyRunner.LRC.SmallN.IntLRC_6_BHK_Defs
import Mathlib.MeasureTheory.Group.GeometryOfNumbers
import Mathlib.MeasureTheory.Group.FundamentalDomain
import Mathlib.MeasureTheory.Measure.Haar.OfBasis
import Mathlib.MeasureTheory.Measure.Lebesgue.EqHaar
import Mathlib.Algebra.Module.ZLattice.Basic
import Mathlib.Algebra.Module.ZLattice.Covolume
import Mathlib.Analysis.SpecialFunctions.PolarCoord
import Mathlib.NumberTheory.DiophantineApproximation.Basic

/-!
# BHK §3 — Main Lemma and Corollary 6 (2-torus subgroup ↔ rectangle)

The Main Lemma says: a finite subgroup `G ⊆ T = [0,1)²` of order `n`
intersects every `α × β` rectangle whenever `αβ ≥ 1/n`, modulo an
exceptional small lattice point `(i,j) ∈ ℤ²` with `(i/n, j/n) ∈ G`
satisfying `β|i| + α|j| - (2/n)|i||j| < 1`.

Corollary 6 is the applied form used throughout §§5–8.

## Source

T. Bohman, R. Holzman, D. Kleitman, *Six Lonely Runners*, EJC **8** (2001)
R3, §3 (p5–11). Main Lemma + proof in §3.1; Corollary 6 + proof in §3.2;
minimality refinement in §3.3.

## Proof structure (BHK §3.1)

The proof uses a Minkowski-style covering argument on the 2-torus:

1. Family `ℱ = {(i/n, j/n) + (1/(2n))·K : (i/n, j/n) ∈ G}`. Each set in
   `ℱ` has 2-D Lebesgue area `A(K)/(4n²) ≥ 1/n`, and there are `n` sets.
2. If `A(K) > 4n`, total area `> 1 = area(T)`, so two sets in `ℱ` must
   intersect. Pull back the intersection to get
   `(i,j) := (i_1 - i_2, j_1 - j_2) ∈ K ∩ ℤ² \ {(0,0)}` with
   `(i/n, j/n) ∈ G`.
3. Pick `(i,j)` minimal (no `(i,j) = k(i_0, j_0)` with `k > 1`).
4. Suppose `G` misses some `α × β` rectangle `R`. WLOG `i, j ≥ 0`.
   * `i = 0`: `G` is `n/j` equidistant points on `j` vertical circles. By
     spacing, `j/n > β`, equivalent to (12).
   * `j = 0`: symmetric.
   * `i, j > 0`: circle `L_g` generated by `g = (i/n, j/n)` has period
     `i/n`. Lines parallel to `L_g` cross `R`'s vertical edge at equally
     spaced points; if none have `y`-coord in the rectangle's vertical
     window, then `β - j(2i - αn)/(in) < 1/i`, equivalent to (12).

This file decomposes the proof into named helper lemmas. All are fully
proved (sorry-free): the Minkowski covering (`bhk_main_lemma_existence`),
minimality refinement, Corollary 6 (via a Dirichlet-pigeonhole witness
replacing BHK's half-open box), and the equally-spaced line-segment
argument (`bhk_main_lemma_rectangle_minimal`), the latter via a fully
discrete sliding-window form of BHK's parallel-segment argument
(`bhk_rectangle_minimal_core_hit`): column-basis decomposition,
minimality-as-coprimality, a Bézout companion point with determinant
`n`, and two interval catches whose feasibility is exactly ¬(12).
-/

open MeasureTheory Set

namespace BHK

/-- **G is the ℤ²-periodic lift of a subgroup `H ⊆ (ZMod n)²` of order `n`.**

    BHK's "G is a subgroup of `T = (ℝ/ℤ)²` of order `n`" is encoded by
    making `G ⊆ ℝ²` be the full ℤ²-periodic lift of an honest `H` in
    `(ZMod n × ZMod n)`. Membership `(i/n, j/n) ∈ G` for `(i, j) ∈ ℤ²`
    then literally holds iff `(i mod n, j mod n) ∈ H`.

    Note: under this convention, `G` is countable but not finite as a set
    of `ℝ²` (each `H`-element has a full `ℤ²`-orbit of representatives). -/
def IsBHKLift (G : Set (ℝ × ℝ)) (n : ℕ) : Prop :=
  ∃ H : AddSubgroup (ZMod n × ZMod n), Nat.card H = n ∧
    ∀ p : ℝ × ℝ, p ∈ G ↔
      ∃ h ∈ H, ∃ i j : ℤ,
        p = (((h.1.val : ℝ) / n) + (i : ℝ), ((h.2.val : ℝ) / n) + (j : ℝ))

/-- **Generator order.** The cyclic subgroup generated by `(↑r, ↑p)` in
    `(ZMod q)²` has order `q` when `gcd(p, q) = 1`: the second coordinate already
    has additive order `q`, and the first has order dividing `q`. This supplies
    the order-`q` subgroup `H` needed for `IsBHKLift` in BHK §5 Part 3. -/
lemma bhk_addOrderOf_gen (r p q : ℕ) (hq : 0 < q) (hcop : Nat.gcd p q = 1) :
    addOrderOf ((↑r, ↑p) : ZMod q × ZMod q) = q := by
  rw [Prod.addOrderOf_mk]
  have hp : addOrderOf (↑p : ZMod q) = q := by
    rw [ZMod.addOrderOf_coe p (show q ≠ 0 by omega), Nat.gcd_comm, hcop, Nat.div_one]
  have hr : addOrderOf (↑r : ZMod q) ∣ q := by
    apply addOrderOf_dvd_of_nsmul_eq_zero
    rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  rw [hp]
  exact Nat.lcm_eq_right hr

/-- The order-`q` cyclic subgroup `⟨(↑r, ↑p)⟩ ⊆ (ZMod q)²` from
    `bhk_addOrderOf_gen`, as an `AddSubgroup` with `Nat.card = q`. -/
lemma bhk_card_zmultiples_gen (r p q : ℕ) (hq : 0 < q) (hcop : Nat.gcd p q = 1) :
    Nat.card (AddSubgroup.zmultiples ((↑r, ↑p) : ZMod q × ZMod q)) = q := by
  rw [Nat.card_zmultiples]; exact bhk_addOrderOf_gen r p q hq hcop

/-- **Fractional-part bridge.** The canonical representative `(m : ZMod q).val`
    and the integer `m` have the same `fract` after dividing by `q`: they differ
    by the integer `m / q`. Lets abstract `IsBHKLift` membership (phrased via
    `.val`) be read off directly from the generator multiple `m`. -/
lemma bhk_fract_val_div (q : ℕ) (hq : 0 < q) (m : ℤ) :
    Int.fract ((((m : ZMod q)).val : ℝ) / (q : ℝ)) = Int.fract ((m : ℝ) / (q : ℝ)) := by
  haveI : NeZero q := ⟨by omega⟩
  have hqR : (q : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hval : (((m : ZMod q)).val : ℤ) = m % q := ZMod.val_intCast m
  have hmod : q * (m / q) + m % q = m := Int.ediv_add_emod m q
  have key : (m : ℝ) / q = ((m / q : ℤ) : ℝ) + (((m : ZMod q)).val : ℝ) / q := by
    have e1 : (((m : ZMod q)).val : ℝ) = ((m % q : ℤ) : ℝ) := by exact_mod_cast hval
    have hmodR : (m : ℝ) = (q : ℝ) * ((m / q : ℤ) : ℝ) + ((m % q : ℤ) : ℝ) := by
      exact_mod_cast hmod.symm
    rw [e1, hmodR]; field_simp
  rw [key, Int.fract_intCast_add]

/-- **The Part-3 lift `G`.** The ℤ²-periodic lift of the order-`q` cyclic group
    `⟨(↑r, ↑p)⟩`. It satisfies `IsBHKLift G q`, and every point's torus
    coordinates are read off the generator: `fract x.1 = fract(k r / q)`,
    `fract x.2 = fract(k p / q)` for some `k : ℤ`. (BHK §5 Part 3, `q ≥ 18`.) -/
lemma bhk_isBHKLift_gen (r p q : ℕ) (hq : 0 < q) (hcop : Nat.gcd p q = 1) :
    ∃ G : Set (ℝ × ℝ), IsBHKLift G q ∧
      ∀ x ∈ G, ∃ k : ℤ,
        Int.fract x.1 = Int.fract ((k : ℝ) * r / q) ∧
        Int.fract x.2 = Int.fract ((k : ℝ) * p / q) := by
  refine ⟨{x | ∃ h ∈ AddSubgroup.zmultiples (((r : ZMod q), (p : ZMod q))), ∃ i j : ℤ,
      x = ((h.1.val : ℝ) / q + i, (h.2.val : ℝ) / q + j)},
    ⟨AddSubgroup.zmultiples _, bhk_card_zmultiples_gen r p q hq hcop, fun _ => Iff.rfl⟩, ?_⟩
  rintro x ⟨h, hh, i, j, rfl⟩
  rw [AddSubgroup.mem_zmultiples_iff] at hh
  obtain ⟨k, hk⟩ := hh
  have hh1 : h.1 = ((k * (r : ℤ) : ℤ) : ZMod q) := by
    rw [← hk]; show k • (r : ZMod q) = ((k * (r : ℤ) : ℤ) : ZMod q)
    rw [zsmul_eq_mul]; push_cast; ring
  have hh2 : h.2 = ((k * (p : ℤ) : ℤ) : ZMod q) := by
    rw [← hk]; show k • (p : ZMod q) = ((k * (p : ℤ) : ℤ) : ZMod q)
    rw [zsmul_eq_mul]; push_cast; ring
  refine ⟨k, ?_, ?_⟩
  · show Int.fract ((h.1.val : ℝ) / q + (i : ℝ)) = Int.fract ((k : ℝ) * r / q)
    rw [Int.fract_add_intCast, hh1, bhk_fract_val_div q hq]
    congr 1; push_cast; ring
  · show Int.fract ((h.2.val : ℝ) / q + (j : ℝ)) = Int.fract ((k : ℝ) * p / q)
    rw [Int.fract_add_intCast, hh2, bhk_fract_val_div q hq]
    congr 1; push_cast; ring

/-- **Lattice from subgroup.** From `H ⊆ (ZMod n)²` a subgroup of order `n`,
    construct the sub-lattice `M ⊆ ℝ²` of integer points whose mod-`n`
    reduction lies in `H`, with a fundamental domain `F` of volume `n`.

    This isolates the Minkowski lattice-theory bookkeeping (sub-lattice
    construction, discreteness, fundamental domain, covolume) from the
    rest of the BHK proof. -/
lemma bhk_lattice_from_subgroup (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (_hH_card : Nat.card H = n) :
    ∃ (M : AddSubgroup (ℝ × ℝ)) (F : Set (ℝ × ℝ))
      (_ : Countable M) (_ : DiscreteTopology M),
      MeasureTheory.IsAddFundamentalDomain M F MeasureTheory.volume ∧
      MeasureTheory.volume F = (n : ENNReal) ∧
      (∀ x : (M : Set (ℝ × ℝ)),
        ∃ i j : ℤ, (x : ℝ × ℝ) = ((i : ℝ), (j : ℝ)) ∧
                    ((i : ZMod n), (j : ZMod n)) ∈ H) ∧
      -- The converse: every integer point whose mod-n reduction lies in H is in M.
      (∀ i j : ℤ, ((i : ZMod n), (j : ZMod n)) ∈ H →
        ((i : ℝ), (j : ℝ)) ∈ M) := by
  -- M is the additive subgroup of ℝ² whose elements are integer points
  -- (i, j) ∈ ℤ² with (i mod n, j mod n) ∈ H.
  let M : AddSubgroup (ℝ × ℝ) :=
    { carrier := {p : ℝ × ℝ | ∃ i j : ℤ,
                                p = ((i : ℝ), (j : ℝ)) ∧
                                ((i : ZMod n), (j : ZMod n)) ∈ H}
      zero_mem' := ⟨0, 0, by ext <;> simp, by push_cast; exact H.zero_mem⟩
      add_mem' := by
        rintro a b ⟨i₁, j₁, ha_eq, h₁⟩ ⟨i₂, j₂, hb_eq, h₂⟩
        refine ⟨i₁ + i₂, j₁ + j₂, ?_, ?_⟩
        · rw [ha_eq, hb_eq]; ext <;> simp
        · push_cast; exact H.add_mem h₁ h₂
      neg_mem' := by
        rintro a ⟨i, j, ha_eq, h⟩
        refine ⟨-i, -j, ?_, ?_⟩
        · rw [ha_eq]; ext <;> simp
        · push_cast; exact H.neg_mem h }
  -- Countable: M ⊆ {(↑i, ↑j) : i j : ℤ}, the image of countable ℤ × ℤ.
  have h_countable : Countable M := by
    apply Set.Countable.to_subtype
    apply Set.Countable.mono (s₂ := {p : ℝ × ℝ | ∃ i j : ℤ, p = ((i : ℝ), (j : ℝ))})
    · rintro p ⟨i, j, h_eq, _⟩; exact ⟨i, j, h_eq⟩
    · have : ({p : ℝ × ℝ | ∃ i j : ℤ, p = ((i : ℝ), (j : ℝ))} : Set (ℝ × ℝ)) =
             Set.range (fun (ij : ℤ × ℤ) => ((ij.1 : ℝ), (ij.2 : ℝ))) := by
        ext p; simp; tauto
      rw [this]; exact Set.countable_range _
  -- DiscreteTopology: 0 ∈ M has open neighborhood (-1/2, 1/2)² in ℝ² intersecting M only at 0.
  have h_discrete : DiscreteTopology M := by
    rw [discreteTopology_iff_isOpen_singleton_zero]
    rw [isOpen_induced_iff]
    refine ⟨Set.Ioo (-1/2 : ℝ) (1/2) ×ˢ Set.Ioo (-1/2 : ℝ) (1/2),
            isOpen_Ioo.prod isOpen_Ioo, ?_⟩
    ext ⟨x, hx⟩
    simp only [Set.mem_preimage, Set.mem_singleton_iff, AddSubgroup.mk_eq_zero]
    obtain ⟨i, j, hij_eq, _⟩ := hx
    subst hij_eq
    simp only [Set.mem_prod, Set.mem_Ioo]
    constructor
    · rintro ⟨⟨h1, h2⟩, h3, h4⟩
      have hi_zero : i = 0 := by
        have hi_lt : (i : ℝ) < 1 := by linarith
        have hi_gt : -1 < (i : ℝ) := by linarith
        have hi_lt' : i < 1 := by exact_mod_cast hi_lt
        have hi_gt' : (-1 : ℤ) < i := by exact_mod_cast hi_gt
        omega
      have hj_zero : j = 0 := by
        have hj_lt : (j : ℝ) < 1 := by linarith
        have hj_gt : -1 < (j : ℝ) := by linarith
        have hj_lt' : j < 1 := by exact_mod_cast hj_lt
        have hj_gt' : (-1 : ℤ) < j := by exact_mod_cast hj_gt
        omega
      simp [hi_zero, hj_zero]
    · intro h_zero
      have hi_zero : i = 0 := by
        have := congr_arg Prod.fst h_zero
        simpa using (Int.cast_eq_zero (α := ℝ)).mp this
      have hj_zero : j = 0 := by
        have := congr_arg Prod.snd h_zero
        simpa using (Int.cast_eq_zero (α := ℝ)).mp this
      subst hi_zero; subst hj_zero
      refine ⟨⟨?_, ?_⟩, ?_, ?_⟩ <;> norm_num
  -- Build a basis of M via Submodule.basisOfPid applied to the preimage in ℤ × ℤ.
  -- ψ : ℤ × ℤ → ZMod n × ZMod n is the natural mod-n reduction.
  let ψ_hom : (ℤ × ℤ) →+ (ZMod n × ZMod n) :=
    AddMonoidHom.prodMap
      ((Int.castRingHom (ZMod n)).toAddMonoidHom)
      ((Int.castRingHom (ZMod n)).toAddMonoidHom)
  -- N_sub : preimage of H in ℤ × ℤ as Submodule ℤ.
  let N_sub : Submodule ℤ (ℤ × ℤ) :=
    AddSubgroup.toIntSubmodule (H.comap ψ_hom)
  -- Get a basis of N_sub via basisOfPid (using the standard basis of ℤ × ℤ).
  let basis_pkg : (k : ℕ) × Module.Basis (Fin k) ℤ N_sub :=
    Submodule.basisOfPid (Module.Basis.finTwoProd ℤ) N_sub
  -- N_sub has rank 2: contains nℤ × nℤ which spans ℝ² as ℝ-module, hence rank ≥ 2.
  -- And N_sub ⊆ ℤ × ℤ which has rank 2, hence rank = 2.
  have h_rank_eq : basis_pkg.1 = 2 := by
    have h_finrank_eq_basis : Module.finrank ℤ ↥N_sub = basis_pkg.1 := by
      rw [Module.finrank_eq_card_basis basis_pkg.2, Fintype.card_fin]
    rw [← h_finrank_eq_basis]
    -- Goal: Module.finrank ℤ ↥N_sub = 2.
    -- Use Submodule.finiteQuotient_iff: finrank N = finrank M ↔ Finite (M/N).
    have hψ_surj : Function.Surjective ψ_hom := by
      intro ⟨a, b⟩
      haveI : NeZero n := ⟨by omega⟩
      refine ⟨((a.val : ℤ), (b.val : ℤ)), ?_⟩
      show (((a.val : ℤ) : ZMod n), ((b.val : ℤ) : ZMod n)) = (a, b)
      ext
      · push_cast; exact ZMod.natCast_zmod_val a
      · push_cast; exact ZMod.natCast_zmod_val b
    have h_index_eq : (H.comap ψ_hom).index = H.index :=
      AddSubgroup.index_comap_of_surjective H hψ_surj
    -- H.index = n²/|H| = n²/n = n.  Hence finite index, hence finite quotient.
    -- The two quotient flavors (Submodule vs AddSubgroup) coincide for ℤ-modules.
    have h_finite_quot : Finite ((ℤ × ℤ) ⧸ N_sub) := by
      haveI : NeZero n := ⟨by omega⟩
      have h_H_idx : H.index = n := by
        have h_im_card := AddSubgroup.index_mul_card H
        have h_prod_card : Nat.card (ZMod n × ZMod n) = n * n := by
          rw [Nat.card_prod]; simp [Nat.card_zmod]
        rw [h_prod_card, _hH_card] at h_im_card
        have hn_pos : 0 < n := by omega
        exact Nat.eq_of_mul_eq_mul_right hn_pos h_im_card
      have h_idx_n : (H.comap ψ_hom).index = n := by
        rw [h_index_eq]; exact h_H_idx
      haveI : (H.comap ψ_hom).FiniteIndex := ⟨by rw [h_idx_n]; omega⟩
      -- AddSubgroup quotient is finite.
      have h_AG_finite : Finite ((ℤ × ℤ) ⧸ H.comap ψ_hom) :=
        AddSubgroup.finite_quotient_of_finiteIndex
      -- N_sub.toAddSubgroup = H.comap ψ_hom (by definition).
      -- The Submodule quotient and AddSubgroup quotient give the same type for ℤ-modules.
      exact h_AG_finite
    have h_eq_finrank :=
      (Submodule.finiteQuotient_iff N_sub).mp h_finite_quot
    rw [h_eq_finrank]
    simp [Module.finrank_prod, Module.finrank_self]
  -- Reindex the basis to Fin 2.
  let b_N : Module.Basis (Fin 2) ℤ N_sub :=
    basis_pkg.2.reindex (finCongr h_rank_eq)
  -- The ℤ-linear inclusion ι : ℤ × ℤ → ℝ × ℝ.
  let ι_lin : (ℤ × ℤ) →ₗ[ℤ] (ℝ × ℝ) :=
    LinearMap.prod
      ((Int.castRingHom ℝ).toIntLinearMap.comp (LinearMap.fst ℤ ℤ ℤ))
      ((Int.castRingHom ℝ).toIntLinearMap.comp (LinearMap.snd ℤ ℤ ℤ))
  -- The real basis: b_real i := ι(b_N i) ∈ ℝ × ℝ.
  let b_real : Fin 2 → (ℝ × ℝ) := fun i => ι_lin (b_N i : ℤ × ℤ)
  -- b_real is ℝ-linearly independent (since b_N is ℤ-linearly independent and the
  -- inclusion preserves linear independence over ℝ for integer vectors).
  -- Show ⊤ ≤ span_ℝ(b_real) first, then derive ℝ-linear independence.
  -- Strategy: (n, 0) and (0, n) ∈ N_sub (since their mod-n reductions are zero, which is in H),
  -- so ι_lin (n, 0) = (↑n, 0) and ι_lin (0, n) = (0, ↑n) are in span_ℤ(b_real) ⊆ span_ℝ(b_real).
  -- Scaling by (n : ℝ)⁻¹ gives the standard basis vectors (1, 0) and (0, 1), which span ℝ × ℝ.
  have h_spans : ⊤ ≤ Submodule.span ℝ (Set.range b_real) := by
    haveI : NeZero n := ⟨by omega⟩
    have hn_real : (n : ℝ) > 0 := by exact_mod_cast (by omega : 0 < n)
    have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_real
    have h_n_z_mem : ((n : ℤ), (0 : ℤ)) ∈ N_sub := by
      change (((n : ℤ) : ZMod n), ((0 : ℤ) : ZMod n)) ∈ H
      simp only [Int.cast_natCast, CharP.cast_eq_zero, Int.cast_zero]
      exact H.zero_mem
    have h_z_n_mem : ((0 : ℤ), (n : ℤ)) ∈ N_sub := by
      change (((0 : ℤ) : ZMod n), ((n : ℤ) : ZMod n)) ∈ H
      simp only [Int.cast_natCast, CharP.cast_eq_zero, Int.cast_zero]
      exact H.zero_mem
    -- span_ℤ(b_N viewed in ℤ × ℤ) = N_sub.
    have h_subN : Submodule.span ℤ (Set.range (fun i : Fin 2 => (b_N i : ℤ × ℤ))) = N_sub := by
      have h_top : Submodule.span ℤ (Set.range ⇑b_N) = (⊤ : Submodule ℤ N_sub) := b_N.span_eq
      have h_map : Submodule.map (Submodule.subtype N_sub)
            (Submodule.span ℤ (Set.range ⇑b_N)) =
          Submodule.map (Submodule.subtype N_sub) ⊤ := by
        rw [h_top]
      rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype] at h_map
      have h_rng : (⇑(Submodule.subtype N_sub) '' Set.range ⇑b_N) =
                   Set.range (fun i : Fin 2 => (b_N i : ℤ × ℤ)) := by
        ext y
        constructor
        · rintro ⟨_, ⟨i, rfl⟩, rfl⟩; exact ⟨i, rfl⟩
        · rintro ⟨i, rfl⟩; exact ⟨b_N i, ⟨i, rfl⟩, rfl⟩
      rw [h_rng] at h_map
      exact h_map
    -- ι_lin maps N_sub into span_ℤ(b_real).
    have h_imN : ∀ x ∈ N_sub, ι_lin x ∈ Submodule.span ℤ (Set.range b_real) := by
      intro x hx
      rw [← h_subN] at hx
      have h_lin : Submodule.span ℤ (Set.range b_real) =
          Submodule.map ι_lin
            (Submodule.span ℤ (Set.range (fun i : Fin 2 => (b_N i : ℤ × ℤ)))) := by
        rw [Submodule.map_span]
        congr 1
        rw [← Set.range_comp]; rfl
      rw [h_lin]
      exact ⟨x, hx, rfl⟩
    -- Lift span_ℤ ≤ span_ℝ.
    have h_Z_le_R : Submodule.span ℤ (Set.range b_real) ≤
        Submodule.restrictScalars ℤ (Submodule.span ℝ (Set.range b_real)) :=
      Submodule.span_le_restrictScalars ℤ ℝ _
    have h_iota_n_zero : ι_lin ((n : ℤ), (0 : ℤ)) = ((n : ℝ), (0 : ℝ)) := by simp [ι_lin]
    have h_iota_zero_n : ι_lin ((0 : ℤ), (n : ℤ)) = ((0 : ℝ), (n : ℝ)) := by simp [ι_lin]
    have h_n_zero_R : ((n : ℝ), (0 : ℝ)) ∈ Submodule.span ℝ (Set.range b_real) := by
      rw [← h_iota_n_zero]
      exact (Submodule.restrictScalars_mem ℤ _ _).mp (h_Z_le_R (h_imN _ h_n_z_mem))
    have h_zero_n_R : ((0 : ℝ), (n : ℝ)) ∈ Submodule.span ℝ (Set.range b_real) := by
      rw [← h_iota_zero_n]
      exact (Submodule.restrictScalars_mem ℤ _ _).mp (h_Z_le_R (h_imN _ h_z_n_mem))
    -- Scale to get the standard basis vectors.
    have h_unit1 : ((1 : ℝ), (0 : ℝ)) ∈ Submodule.span ℝ (Set.range b_real) := by
      have h_smul := Submodule.smul_mem (Submodule.span ℝ (Set.range b_real))
        ((n : ℝ)⁻¹) h_n_zero_R
      convert h_smul using 1
      ext
      · show (1 : ℝ) = (n : ℝ)⁻¹ * (n : ℝ); field_simp
      · show (0 : ℝ) = (n : ℝ)⁻¹ * 0; ring
    have h_unit2 : ((0 : ℝ), (1 : ℝ)) ∈ Submodule.span ℝ (Set.range b_real) := by
      have h_smul := Submodule.smul_mem (Submodule.span ℝ (Set.range b_real))
        ((n : ℝ)⁻¹) h_zero_n_R
      convert h_smul using 1
      ext
      · show (0 : ℝ) = (n : ℝ)⁻¹ * 0; ring
      · show (1 : ℝ) = (n : ℝ)⁻¹ * (n : ℝ); field_simp
    -- Any (x, y) ∈ ℝ × ℝ is x • (1, 0) + y • (0, 1).
    intro x _
    have h1 := Submodule.smul_mem (Submodule.span ℝ (Set.range b_real)) x.1 h_unit1
    have h2 := Submodule.smul_mem (Submodule.span ℝ (Set.range b_real)) x.2 h_unit2
    have h_sum := Submodule.add_mem _ h1 h2
    convert h_sum using 1
    ext
    · show x.1 = x.1 * 1 + x.2 * 0; ring
    · show x.2 = x.1 * 0 + x.2 * 1; ring
  have h_lin_indep : LinearIndependent ℝ b_real :=
    linearIndependent_of_top_le_span_of_card_eq_finrank h_spans
      (by simp [Fintype.card_fin, Module.finrank_prod, Module.finrank_self])
  -- Build a Module.Basis (Fin 2) ℝ (ℝ × ℝ) from b_real.
  let basis_real : Module.Basis (Fin 2) ℝ (ℝ × ℝ) :=
    Module.Basis.mk h_lin_indep h_spans
  -- F = the fundamental parallelepiped of basis_real.
  let F : Set (ℝ × ℝ) := ZSpan.fundamentalDomain basis_real
  -- Connect: Submodule.span ℤ (Set.range b_real) = M.toIntSubmodule.
  -- Recompute h_subN / h_imN since they were local to the h_spans proof above.
  have h_subN : Submodule.span ℤ (Set.range (fun i : Fin 2 => (b_N i : ℤ × ℤ))) = N_sub := by
    have h_top : Submodule.span ℤ (Set.range ⇑b_N) = (⊤ : Submodule ℤ N_sub) := b_N.span_eq
    have h_map : Submodule.map (Submodule.subtype N_sub)
          (Submodule.span ℤ (Set.range ⇑b_N)) =
        Submodule.map (Submodule.subtype N_sub) ⊤ := by
      rw [h_top]
    rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype] at h_map
    have h_rng : (⇑(Submodule.subtype N_sub) '' Set.range ⇑b_N) =
                 Set.range (fun i : Fin 2 => (b_N i : ℤ × ℤ)) := by
      ext y
      constructor
      · rintro ⟨_, ⟨i, rfl⟩, rfl⟩; exact ⟨i, rfl⟩
      · rintro ⟨i, rfl⟩; exact ⟨b_N i, ⟨i, rfl⟩, rfl⟩
    rw [h_rng] at h_map
    exact h_map
  have h_real_eq_map : Submodule.span ℤ (Set.range b_real) =
      Submodule.map ι_lin
        (Submodule.span ℤ (Set.range (fun i : Fin 2 => (b_N i : ℤ × ℤ)))) := by
    rw [Submodule.map_span]
    congr 1
    rw [← Set.range_comp]; rfl
  have h_span_eq : (M.toIntSubmodule : Set (ℝ × ℝ)) =
                   (Submodule.span ℤ (Set.range b_real) : Set (ℝ × ℝ)) := by
    apply Set.eq_of_subset_of_subset
    · -- M ⊆ span ℤ (range b_real): every x ∈ M is integer pair with mod-n in H,
      -- hence lies in N_sub; b_N spans N_sub, push through ι_lin.
      intro x hx
      change x ∈ M at hx
      obtain ⟨i, j, hx_eq, h_H⟩ := hx
      -- (i, j) ∈ N_sub by definition of N_sub (preimage under ψ_hom).
      have h_ij_N : ((i, j) : ℤ × ℤ) ∈ N_sub := by
        change (((i : ZMod n), (j : ZMod n)) : ZMod n × ZMod n) ∈ H
        exact h_H
      -- (i, j) ∈ span ℤ (range (b_N · : ℤ × ℤ)) via h_subN.
      have h_ij_span : ((i, j) : ℤ × ℤ) ∈
          Submodule.span ℤ (Set.range (fun i : Fin 2 => (b_N i : ℤ × ℤ))) := by
        rw [h_subN]; exact h_ij_N
      -- Push through ι_lin.
      have h_real_in : ι_lin ((i, j) : ℤ × ℤ) ∈ Submodule.span ℤ (Set.range b_real) := by
        rw [h_real_eq_map]; exact ⟨(i, j), h_ij_span, rfl⟩
      have h_iota_eq : ι_lin ((i, j) : ℤ × ℤ) = ((i : ℝ), (j : ℝ)) := by simp [ι_lin]
      rw [h_iota_eq] at h_real_in
      change x ∈ (Submodule.span ℤ (Set.range b_real) : Set (ℝ × ℝ))
      rw [hx_eq]
      exact h_real_in
    · -- span ℤ (range b_real) ⊆ M: each b_real i ∈ M.
      intro x hx
      change x ∈ Submodule.span ℤ (Set.range b_real) at hx
      have h_each : ∀ i : Fin 2, b_real i ∈ M.toIntSubmodule := by
        intro i
        -- b_real i = ι_lin (b_N i : ℤ × ℤ); b_N i ∈ N_sub gives mod-n in H.
        have h_bN_in : ((b_N i : ℤ × ℤ).1, (b_N i : ℤ × ℤ).2) ∈ N_sub := by
          have := (b_N i).property
          convert this
        have h_mod : ((((b_N i : ℤ × ℤ).1 : ZMod n)),
                       ((b_N i : ℤ × ℤ).2 : ZMod n)) ∈ H := h_bN_in
        have hb_eq : b_real i = (((b_N i : ℤ × ℤ).1 : ℝ), ((b_N i : ℤ × ℤ).2 : ℝ)) := by
          simp [b_real, ι_lin]
        change b_real i ∈ M
        rw [hb_eq]
        exact ⟨(b_N i : ℤ × ℤ).1, (b_N i : ℤ × ℤ).2, rfl, h_mod⟩
      have h_range_sub : Set.range b_real ⊆ (M.toIntSubmodule : Set (ℝ × ℝ)) := by
        rintro _ ⟨i, rfl⟩; exact h_each i
      exact Submodule.span_le.mpr h_range_sub hx
  -- Set.range basis_real = Set.range b_real (since basis_real = Basis.mk h_lin_indep h_spans).
  have h_range_eq : Set.range basis_real = Set.range b_real := by
    change Set.range (Module.Basis.mk h_lin_indep h_spans) = Set.range b_real
    congr 1; rw [Module.Basis.coe_mk]
  -- Span equality as Submodules: span ℤ (range basis_real) = M.toIntSubmodule.
  have h_span_eq_sub : Submodule.span ℤ (Set.range basis_real) = M.toIntSubmodule := by
    rw [h_range_eq]
    exact (SetLike.coe_set_eq.mp h_span_eq.symm)
  refine ⟨M, F, h_countable, h_discrete, ?_, ?_, ?_, ?_⟩
  -- IsAddFundamentalDomain: comes from ZSpan.isAddFundamentalDomain (with span identification).
  · -- Note: ↥(M.toIntSubmodule) and ↥M are definitionally the same type;
    -- the VAdd actions agree, so IsAddFundamentalDomain transports along Submodule equality.
    have h_ZF : MeasureTheory.IsAddFundamentalDomain
        (Submodule.span ℤ (Set.range basis_real)) F MeasureTheory.volume :=
      ZSpan.isAddFundamentalDomain basis_real MeasureTheory.volume
    change MeasureTheory.IsAddFundamentalDomain M.toIntSubmodule F MeasureTheory.volume
    exact h_span_eq_sub ▸ h_ZF
  -- volume F = n: from ZSpan.measure_fundamentalDomain + |det| = index of N_sub = n.
  · -- Step A: volume F = ENNReal.ofReal |b₀.det basis_real| * volume (fundDom b₀)
    have step_A : MeasureTheory.volume F =
        ENNReal.ofReal |(Module.Basis.finTwoProd ℝ).det basis_real| *
        MeasureTheory.volume (ZSpan.fundamentalDomain (Module.Basis.finTwoProd ℝ)) :=
      ZSpan.measure_fundamentalDomain basis_real MeasureTheory.volume
        (b₀ := Module.Basis.finTwoProd ℝ)
    -- Step B: volume (fundDom (finTwoProd ℝ)) = 1 (unit square).
    have step_B : MeasureTheory.volume
        (ZSpan.fundamentalDomain (Module.Basis.finTwoProd ℝ)) = 1 := by
      have h_eq : ZSpan.fundamentalDomain (Module.Basis.finTwoProd ℝ) =
          Set.Ico (0:ℝ) 1 ×ˢ Set.Ico (0:ℝ) 1 := by
        ext p; simp [ZSpan.mem_fundamentalDomain]
      rw [h_eq,
        show (MeasureTheory.volume : MeasureTheory.Measure (ℝ × ℝ)) =
          MeasureTheory.volume.prod MeasureTheory.volume from rfl,
        MeasureTheory.Measure.prod_prod, Real.volume_Ico, sub_zero, ENNReal.ofReal_one, mul_one]
    -- Step C: |(finTwoProd ℝ).det basis_real| = n.
    -- (i) The ℝ-det of basis_real equals the ℤ-det of b_N (cast to ℝ).
    have h_basis_real_explicit : ∀ i : Fin 2,
        basis_real i = (((b_N i : ℤ × ℤ).1 : ℝ), ((b_N i : ℤ × ℤ).2 : ℝ)) := by
      intro i
      simp only [basis_real, Module.Basis.coe_mk]
      simp [b_real, ι_lin]
    have h_det_R_eq_cast :
        (Module.Basis.finTwoProd ℝ).det basis_real =
        (((Module.Basis.finTwoProd ℤ).det (fun i => ((b_N i : ℤ × ℤ))) : ℤ) : ℝ) := by
      have h_v : basis_real = (fun i =>
          (((b_N i : ℤ × ℤ).1 : ℝ), ((b_N i : ℤ × ℤ).2 : ℝ))) := by
        funext i; exact h_basis_real_explicit i
      rw [h_v]
      rw [Module.Basis.det_apply, Module.Basis.det_apply]
      simp [Matrix.det_fin_two, Module.Basis.toMatrix, Module.Basis.coe_finTwoProd_repr]
    -- (ii) The natAbs of the ℤ-det of b_N equals the index of N_sub.toAddSubgroup, which is n.
    -- First, restate the index calculation we already did above.
    have hψ_surj : Function.Surjective ψ_hom := by
      intro ⟨a, b⟩
      haveI : NeZero n := ⟨by omega⟩
      refine ⟨((a.val : ℤ), (b.val : ℤ)), ?_⟩
      change (((a.val : ℤ) : ZMod n), ((b.val : ℤ) : ZMod n)) = (a, b)
      ext
      · push_cast; exact ZMod.natCast_zmod_val a
      · push_cast; exact ZMod.natCast_zmod_val b
    have h_H_idx : H.index = n := by
      have h_im_card := AddSubgroup.index_mul_card H
      have h_prod_card : Nat.card (ZMod n × ZMod n) = n * n := by
        rw [Nat.card_prod]; simp
      rw [h_prod_card, _hH_card] at h_im_card
      have hn_pos : 0 < n := by omega
      exact Nat.eq_of_mul_eq_mul_right hn_pos h_im_card
    have h_index_eq : (H.comap ψ_hom).index = H.index :=
      AddSubgroup.index_comap_of_surjective H hψ_surj
    have h_idx_n : (H.comap ψ_hom).index = n := by rw [h_index_eq]; exact h_H_idx
    -- N_sub.toAddSubgroup = H.comap ψ_hom (by definition).
    -- Apply AddSubgroup.index_eq_natAbs_det directly with b_N as basis of N_sub.toIntSubmodule.
    -- Since N_sub.toAddSubgroup = H.comap ψ_hom (defl), its index = n.
    have h_NsubAS_idx : (N_sub : Submodule ℤ (ℤ × ℤ)).toAddSubgroup.index = n := h_idx_n
    have h_det_natAbs : ((Module.Basis.finTwoProd ℤ).det
        (fun i => ((b_N i : ℤ × ℤ)))).natAbs = n := by
      have h1 := AddSubgroup.index_eq_natAbs_det (Module.Basis.finTwoProd ℤ)
        (N_sub : Submodule ℤ (ℤ × ℤ)).toAddSubgroup b_N
      rw [h_NsubAS_idx] at h1
      exact h1.symm
    -- (iii) Combine: |det| in ℝ = (natAbs : ℝ) = n.
    have step_C : |(Module.Basis.finTwoProd ℝ).det basis_real| = (n : ℝ) := by
      rw [h_det_R_eq_cast]
      -- Goal: |((det_ℤ : ℤ) : ℝ)| = n. Use Int.cast_abs and Int.cast_natAbs.
      rw [show |(((Module.Basis.finTwoProd ℤ).det (fun i => ((b_N i : ℤ × ℤ))) : ℤ) : ℝ)| =
            (((Module.Basis.finTwoProd ℤ).det (fun i => ((b_N i : ℤ × ℤ)))).natAbs : ℝ) from by
              rw [← Int.cast_abs, ← Nat.cast_natAbs]]
      rw [h_det_natAbs]
    -- Step D: combine.
    rw [step_A, step_B, mul_one, step_C]
    -- Goal: ENNReal.ofReal n = (n : ENNReal)
    exact ENNReal.ofReal_natCast n
  -- M-to-integer: trivial from carrier definition.
  · rintro ⟨x, hx⟩
    obtain ⟨i, j, h_eq, h_mem⟩ := hx
    exact ⟨i, j, h_eq, h_mem⟩
  -- Integer-to-M: trivial.
  · intro i j h_mem
    exact ⟨i, j, rfl, h_mem⟩

/-! ## §3.1 helpers: family ℱ, minimality, rectangle-missing analysis -/

/-- **BHK Main Lemma — existence step.** Given a finite subgroup `G` of
    `T` with `|G| = n > 1`, and a symmetric closed convex neighborhood
    `K` of `(0,0)` in `ℝ²` contained in `[-αn, αn] × [-βn, βn]` with
    `A(K) ≥ 4n`, there exists a nonzero lattice point `(i,j) ∈ K ∩ ℤ²`
    such that `(i/n, j/n) ∈ G`.

    Proof (BHK p9): Minkowski-style covering. We use mathlib's
    `MeasureTheory.exists_ne_zero_mem_lattice_of_measure_mul_two_pow_le_measure`
    applied to the sub-lattice
    `M = {(i, j) ∈ ℤ² | (i mod n, j mod n) ∈ H} ⊆ ℝ²` of covolume `n`.

    Requires `K` to be symmetric, convex, compact (since mathlib's
    Minkowski needs these). -/
theorem bhk_main_lemma_existence
    (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (hG_lift : IsBHKLift G n)
    (α β : ℝ) (hα : 0 < α) (hβ : 0 < β)
    (K : Set (ℝ × ℝ)) (hK_sub : K ⊆ Set.Icc (-(α * n)) (α * n) ×ˢ
                                  Set.Icc (-(β * n)) (β * n))
    (hK_sym : ∀ x ∈ K, -x ∈ K) (hK_conv : Convex ℝ K) (hK_compact : IsCompact K)
    (hK_area : (4 * n : ℝ) ≤ (MeasureTheory.volume K).toReal) :
    ∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ℝ), (ij.2 : ℝ)) ∈ K ∧
      ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G := by
  -- Extract H, the algebraic subgroup behind G.
  obtain ⟨H, hH_card, hG_eq⟩ := hG_lift
  -- Build the sub-lattice M ⊆ ℝ² of integer points whose mod-n reduction
  -- lies in H, along with a fundamental domain F of volume n.
  obtain ⟨M, F, h_count, h_disc, hF_FD, hF_vol, h_M_to_int, _h_int_to_M⟩ :=
    bhk_lattice_from_subgroup n hn H hH_card
  -- Promote h_count, h_disc to instances for Minkowski's typeclass inference.
  haveI : Countable M := h_count
  haveI : DiscreteTopology M := h_disc
  -- Apply mathlib's Minkowski theorem to L = M, F as above, s = K.
  -- The hypothesis vol(K) ≥ 4n matches vol(F) · 2^2 = n · 4 = 4n.
  have hn_pos_nat : 0 < n := by omega
  have hn_pos_real : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn_pos_nat
  have h_finrank : Module.finrank ℝ (ℝ × ℝ) = 2 := by
    simp [Module.finrank_prod, Module.finrank_self]
  have h_two_pow : (2 : ℕ∞) ^ Module.finrank ℝ (ℝ × ℝ) = 4 := by
    rw [h_finrank]; norm_num
  have hvol_K : MeasureTheory.volume F * 2 ^ Module.finrank ℝ (ℝ × ℝ) ≤
                MeasureTheory.volume K := by
    rw [hF_vol, h_finrank]
    -- (n : ENNReal) * 2^2 = 4n ≤ vol(K)
    have h_2sq : (2 : ENNReal) ^ 2 = 4 := by norm_num
    rw [h_2sq]
    -- Goal: (n : ENNReal) * 4 ≤ volume K
    -- We have hK_area : 4 * n ≤ (volume K).toReal
    have h_vol_lt_top : MeasureTheory.volume K ≠ ⊤ := IsCompact.measure_ne_top hK_compact
    have h_n_real_nn : (0 : ℝ) ≤ 4 * n := by positivity
    calc (n : ENNReal) * 4
        = ENNReal.ofReal (4 * n) := by
          rw [mul_comm]
          rw [show (4 : ENNReal) = ENNReal.ofReal 4 from by
            rw [ENNReal.ofReal_ofNat]]
          rw [show ((n : ENNReal)) = ENNReal.ofReal n from by
            rw [ENNReal.ofReal_natCast]]
          rw [← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 4)]
      _ ≤ ENNReal.ofReal (MeasureTheory.volume K).toReal :=
          ENNReal.ofReal_le_ofReal hK_area
      _ = MeasureTheory.volume K := ENNReal.ofReal_toReal h_vol_lt_top
  obtain ⟨x, hx_ne, hx_K⟩ :=
    @MeasureTheory.exists_ne_zero_mem_lattice_of_measure_mul_two_pow_le_measure
      (ℝ × ℝ) _ MeasureTheory.volume F K _ _ _ _ _ _ M _ _
      hF_FD hK_sym hK_conv hK_compact hvol_K
  -- Extract integer coordinates from x ∈ M.
  obtain ⟨i, j, hij_eq, hij_H⟩ := h_M_to_int x
  refine ⟨(i, j), ?_, ?_, ?_⟩
  · -- (i, j) ≠ (0, 0): if it were, then x = 0 in M, contradicting hx_ne.
    intro h_eq
    apply hx_ne
    have hi_zero : i = 0 := (Prod.mk.injEq _ _ _ _).mp h_eq |>.1
    have hj_zero : j = 0 := (Prod.mk.injEq _ _ _ _).mp h_eq |>.2
    apply Subtype.ext
    rw [hij_eq, hi_zero, hj_zero]
    simp [AddSubmonoid.coe_zero]
  · -- (i, j) ∈ K (as reals).
    have h_coe : (x : ℝ × ℝ) = ((i : ℝ), (j : ℝ)) := hij_eq
    rw [← h_coe]; exact hx_K
  · -- (i/n, j/n) ∈ G. We have (i, j) ∈ M means (i mod n, j mod n) ∈ H,
    -- which gives membership in G via hG_eq.
    rw [hG_eq]
    refine ⟨((i : ZMod n), (j : ZMod n)), hij_H, ?_⟩
    -- Need: (i/n, j/n) = ((((i : ZMod n).val : ℝ) / n) + a, ...) for some a, b ∈ ℤ.
    have hn_ne_real : (n : ℝ) ≠ 0 := ne_of_gt hn_pos_real
    haveI : NeZero n := ⟨by omega⟩
    have hi_dvd : (n : ℤ) ∣ (i - ((i : ZMod n).val : ℤ)) := by
      have : ((i - ((i : ZMod n).val : ℤ) : ℤ) : ZMod n) = 0 := by
        push_cast
        rw [ZMod.natCast_zmod_val]
        ring
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp this
    have hj_dvd : (n : ℤ) ∣ (j - ((j : ZMod n).val : ℤ)) := by
      have : ((j - ((j : ZMod n).val : ℤ) : ℤ) : ZMod n) = 0 := by
        push_cast
        rw [ZMod.natCast_zmod_val]
        ring
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp this
    obtain ⟨a, ha⟩ := hi_dvd
    obtain ⟨b, hb⟩ := hj_dvd
    refine ⟨a, b, ?_⟩
    have hi_real : (i : ℝ) = ((i : ZMod n).val : ℝ) + (n : ℝ) * a := by
      have hi_int : (i : ℤ) = ((i : ZMod n).val : ℤ) + n * a := by linarith [ha]
      exact_mod_cast hi_int
    have hj_real : (j : ℝ) = ((j : ZMod n).val : ℝ) + (n : ℝ) * b := by
      have hj_int : (j : ℤ) = ((j : ZMod n).val : ℤ) + n * b := by linarith [hb]
      exact_mod_cast hj_int
    refine Prod.ext ?_ ?_
    · show (i : ℝ) / n = ((i : ZMod n).val : ℝ) / n + a
      rw [hi_real]
      field_simp
    · show (j : ℝ) / n = ((j : ZMod n).val : ℝ) / n + b
      rw [hj_real]
      field_simp

/-- **BHK Main Lemma — minimality refinement (§3.1 picks a "minimal" `(i,j)`).**
    Among nonzero integer points `(i,j)` with `(i/n, j/n) ∈ G`, there is
    one that is "minimal" in the sense that no proper integer scaling
    `(i,j) = k(i₀, j₀)` (`k > 1`, `(i₀/n, j₀/n) ∈ G`) exists.

    Proof: pick a candidate minimizing `|i| + |j|` (as a natural number,
    using `Int.natAbs`). The minimum exists by `Nat.find` applied to the
    well-founded `<` on `ℕ`. Any proper integer scaling `(i,j) = k(i₀,j₀)`
    with `k > 1` (integer) gives `|i| + |j| = k·(|i₀| + |j₀|) ≥ 2·(|i₀| +
    |j₀|) > |i₀| + |j₀|`, so `(i₀, j₀)` would have strictly smaller sum,
    contradicting minimality. -/
theorem bhk_main_lemma_minimality
    (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (α β : ℝ) (hαn : 0 ≤ α * (n : ℝ)) (hβn : 0 ≤ β * (n : ℝ))
    (h_exists : ∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
      |(ij.1 : ℝ)| ≤ α * n ∧ |(ij.2 : ℝ)| ≤ β * n) :
    ∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
      |(ij.1 : ℝ)| ≤ α * n ∧ |(ij.2 : ℝ)| ≤ β * n ∧
      (∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
        ((i₀ : ℝ) / n, (j₀ : ℝ) / n) ∈ G →
        (ij.1, ij.2) ≠ (k * i₀, k * j₀)) := by
  -- P k := "∃ (i,j) ≠ 0 in box with (i/n, j/n) ∈ G and |i| + |j| = k".
  set P : ℕ → Prop := fun k =>
    ∃ ij : ℤ × ℤ, ij ≠ (0,0) ∧ ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
      |(ij.1 : ℝ)| ≤ α * n ∧ |(ij.2 : ℝ)| ≤ β * n ∧
      ij.1.natAbs + ij.2.natAbs = k with hP_def
  have hP_classical : ∀ k, Decidable (P k) := fun _ => Classical.dec _
  have hP_nonempty : ∃ k, P k := by
    obtain ⟨ij, hij_ne, hij_G, hij_α, hij_β⟩ := h_exists
    exact ⟨ij.1.natAbs + ij.2.natAbs, ij, hij_ne, hij_G, hij_α, hij_β, rfl⟩
  classical
  let k₀ := Nat.find hP_nonempty
  have hk₀_spec : P k₀ := Nat.find_spec hP_nonempty
  have hk₀_min : ∀ k, k < k₀ → ¬ P k := fun _ hk => Nat.find_min hP_nonempty hk
  obtain ⟨ij, hij_ne, hij_G, hij_α, hij_β, hij_card⟩ := hk₀_spec
  refine ⟨ij, hij_ne, hij_G, hij_α, hij_β, ?_⟩
  intro i₀ j₀ k hk_gt hG₀
  by_contra h_eq
  -- Extract componentwise equalities.
  have hij1 : ij.1 = k * i₀ := (Prod.mk.injEq _ _ _ _).mp h_eq |>.1
  have hij2 : ij.2 = k * j₀ := (Prod.mk.injEq _ _ _ _).mp h_eq |>.2
  -- (i₀, j₀) ≠ (0, 0) — else ij = (0, 0).
  have hij₀_ne : (i₀, j₀) ≠ (0, 0) := by
    intro hh
    apply hij_ne
    have : i₀ = 0 ∧ j₀ = 0 := Prod.mk.injEq _ _ _ _ |>.mp hh
    have hh1 : ij.1 = 0 := by rw [hij1, this.1]; ring
    have hh2 : ij.2 = 0 := by rw [hij2, this.2]; ring
    rcases ij with ⟨a, b⟩
    simp at hh1 hh2; subst hh1; subst hh2; rfl
  -- |k| ≥ 2 (since k > 1 in ℤ).
  have hk_natAbs_ge_2 : 2 ≤ k.natAbs := by
    have hk_pos : 0 < k := by linarith
    have hk_ge_2 : 2 ≤ k := hk_gt
    have hk_eq : k.natAbs = k.toNat := Int.natAbs_of_nonneg hk_pos.le |>.symm ▸ rfl
    omega
  -- |ij.1| + |ij.2| = |k| · (|i₀| + |j₀|).
  have h_sum_eq : ij.1.natAbs + ij.2.natAbs = k.natAbs * (i₀.natAbs + j₀.natAbs) := by
    rw [hij1, hij2, Int.natAbs_mul, Int.natAbs_mul]; ring
  -- |i₀| + |j₀| > 0 (since (i₀, j₀) ≠ (0, 0)).
  have h_sum₀_pos : 0 < i₀.natAbs + j₀.natAbs := by
    by_contra h
    push_neg at h
    have h1 : i₀.natAbs = 0 := by omega
    have h2 : j₀.natAbs = 0 := by omega
    have hi₀ : i₀ = 0 := Int.natAbs_eq_zero.mp h1
    have hj₀ : j₀ = 0 := Int.natAbs_eq_zero.mp h2
    exact hij₀_ne (by rw [hi₀, hj₀])
  -- Box-closure: (i₀, j₀) is also in the box (smaller absolute values).
  -- |ij.1| = |k| * |i₀|, and |k| ≥ 1, so |i₀| ≤ |ij.1| ≤ α n. Similarly for j₀.
  have hk_R_ge_one : (1 : ℝ) ≤ |(k : ℝ)| := by
    have h_nat : (1 : ℕ) ≤ k.natAbs := by omega
    have h1 : (1 : ℝ) ≤ (k.natAbs : ℝ) := by exact_mod_cast h_nat
    have h_cast : (k.natAbs : ℝ) = |(k : ℝ)| := by
      have h_int : ((k.natAbs : ℤ) : ℝ) = ((|k| : ℤ) : ℝ) := by
        exact_mod_cast (Int.abs_eq_natAbs k).symm
      rw [Int.cast_natCast] at h_int
      rw [Int.cast_abs] at h_int
      exact h_int
    linarith
  have hi₀_box : |(i₀ : ℝ)| ≤ α * n := by
    have h_eq : |(ij.1 : ℝ)| = |(k : ℝ)| * |(i₀ : ℝ)| := by
      rw [hij1]; push_cast; rw [abs_mul]
    have h_le : |(i₀ : ℝ)| ≤ |(ij.1 : ℝ)| := by
      have h_nonneg : (0 : ℝ) ≤ |(i₀ : ℝ)| := abs_nonneg _
      calc |(i₀ : ℝ)| = 1 * |(i₀ : ℝ)| := by ring
        _ ≤ |(k : ℝ)| * |(i₀ : ℝ)| := mul_le_mul_of_nonneg_right hk_R_ge_one h_nonneg
        _ = |(ij.1 : ℝ)| := h_eq.symm
    linarith [hij_α]
  have hj₀_box : |(j₀ : ℝ)| ≤ β * n := by
    have h_eq : |(ij.2 : ℝ)| = |(k : ℝ)| * |(j₀ : ℝ)| := by
      rw [hij2]; push_cast; rw [abs_mul]
    have h_le : |(j₀ : ℝ)| ≤ |(ij.2 : ℝ)| := by
      have h_nonneg : (0 : ℝ) ≤ |(j₀ : ℝ)| := abs_nonneg _
      calc |(j₀ : ℝ)| = 1 * |(j₀ : ℝ)| := by ring
        _ ≤ |(k : ℝ)| * |(j₀ : ℝ)| := mul_le_mul_of_nonneg_right hk_R_ge_one h_nonneg
        _ = |(ij.2 : ℝ)| := h_eq.symm
    linarith [hij_β]
  -- Hence |i₀| + |j₀| < k₀.
  have h_smaller : i₀.natAbs + j₀.natAbs < k₀ := by
    have hk₀_eq : k₀ = k.natAbs * (i₀.natAbs + j₀.natAbs) := by
      rw [← hij_card, h_sum_eq]
    rw [hk₀_eq]
    have h_lt : 1 * (i₀.natAbs + j₀.natAbs) < k.natAbs * (i₀.natAbs + j₀.natAbs) :=
      Nat.mul_lt_mul_of_pos_right (by omega : 1 < k.natAbs) h_sum₀_pos
    linarith
  -- Apply hk₀_min: P (|i₀| + |j₀|) cannot hold, but it does (using box closure).
  exact hk₀_min _ h_smaller ⟨(i₀, j₀), hij₀_ne, hG₀, hi₀_box, hj₀_box, rfl⟩

/-! ## Bridge and structure lemmas for the Main Lemma geometry -/

/-- **Integer-point membership bridge for a BHK lift.** For integers
    `a, b`, the point `(a/n, b/n)` lies in `G` iff the mod-`n`
    reduction `(a, b)` lies in `H`. -/
lemma bhk_lift_int_mem_iff (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n))
    (hG_iff : ∀ p : ℝ × ℝ, p ∈ G ↔ ∃ h ∈ H, ∃ i j : ℤ,
      p = (((h.1.val : ℝ) / n) + (i : ℝ), ((h.2.val : ℝ) / n) + (j : ℝ)))
    (a b : ℤ) :
    ((a : ℝ) / n, (b : ℝ) / n) ∈ G ↔ ((a : ZMod n), (b : ZMod n)) ∈ H := by
  haveI : NeZero n := ⟨by omega⟩
  have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
  have hn_ne_real : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  constructor
  · intro hab
    rw [hG_iff] at hab
    obtain ⟨h, hh_in, k, l, heq⟩ := hab
    have h_a_eq : (a : ℝ) = (h.1.val : ℝ) + (n : ℝ) * (k : ℝ) := by
      have h1 := congr_arg Prod.fst heq
      field_simp at h1
      linarith
    have h_b_eq : (b : ℝ) = (h.2.val : ℝ) + (n : ℝ) * (l : ℝ) := by
      have h2 := congr_arg Prod.snd heq
      field_simp at h2
      linarith
    have h_a_int : a = (h.1.val : ℤ) + (n : ℤ) * k := by
      have h_rhs : (h.1.val : ℝ) + (n : ℝ) * (k : ℝ) =
          (((h.1.val : ℤ) + (n : ℤ) * k : ℤ) : ℝ) := by push_cast; ring
      rw [h_rhs] at h_a_eq
      exact_mod_cast h_a_eq
    have h_b_int : b = (h.2.val : ℤ) + (n : ℤ) * l := by
      have h_rhs : (h.2.val : ℝ) + (n : ℝ) * (l : ℝ) =
          (((h.2.val : ℤ) + (n : ℤ) * l : ℤ) : ℝ) := by push_cast; ring
      rw [h_rhs] at h_b_eq
      exact_mod_cast h_b_eq
    have h_a_zmod : (a : ZMod n) = h.1 := by
      rw [h_a_int]; push_cast; simp [ZMod.natCast_val]
    have h_b_zmod : (b : ZMod n) = h.2 := by
      rw [h_b_int]; push_cast; simp [ZMod.natCast_val]
    have h_pair : ((a : ZMod n), (b : ZMod n)) = (h : ZMod n × ZMod n) := by
      ext
      · exact h_a_zmod
      · exact h_b_zmod
    rw [h_pair]; exact hh_in
  · intro hab
    rw [hG_iff]
    refine ⟨((a : ZMod n), (b : ZMod n)), hab, ?_⟩
    have ha_dvd : (n : ℤ) ∣ (a - ((a : ZMod n).val : ℤ)) := by
      have : ((a - ((a : ZMod n).val : ℤ) : ℤ) : ZMod n) = 0 := by
        push_cast; rw [ZMod.natCast_zmod_val]; ring
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp this
    have hb_dvd : (n : ℤ) ∣ (b - ((b : ZMod n).val : ℤ)) := by
      have : ((b - ((b : ZMod n).val : ℤ) : ℤ) : ZMod n) = 0 := by
        push_cast; rw [ZMod.natCast_zmod_val]; ring
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp this
    obtain ⟨k, hk⟩ := ha_dvd
    obtain ⟨l, hl⟩ := hb_dvd
    refine ⟨k, l, ?_⟩
    have h_a_real : (a : ℝ) = ((a : ZMod n).val : ℝ) + (n : ℝ) * (k : ℝ) := by
      have : (a : ℤ) = ((a : ZMod n).val : ℤ) + (n : ℤ) * k := by linarith [hk]
      exact_mod_cast this
    have h_b_real : (b : ℝ) = ((b : ZMod n).val : ℝ) + (n : ℝ) * (l : ℝ) := by
      have : (b : ℤ) = ((b : ZMod n).val : ℤ) + (n : ℤ) * l := by linarith [hl]
      exact_mod_cast this
    refine Prod.ext ?_ ?_
    · show (a : ℝ) / n = ((a : ZMod n).val : ℝ) / n + k
      rw [h_a_real]; field_simp
    · show (b : ℝ) / n = ((b : ZMod n).val : ℝ) / n + l
      rw [h_b_real]; field_simp

/-- **Closed interval catches a spaced progression.** Any arithmetic
    progression `y₀ + ℤ·s` (step `0 < s`) meets any closed interval
    `[a, a + L]` with `L ≥ s`: take `k = ⌈(a - y₀)/s⌉`. -/
lemma bhk_interval_catch (y₀ s a L : ℝ) (hs : 0 < s) (hsL : s ≤ L) :
    ∃ k : ℤ, a ≤ y₀ + (k : ℝ) * s ∧ y₀ + (k : ℝ) * s ≤ a + L := by
  refine ⟨⌈(a - y₀) / s⌉, ?_, ?_⟩
  · have h1 := mul_le_mul_of_nonneg_right (Int.le_ceil ((a - y₀) / s)) hs.le
    rw [div_mul_cancel₀ _ hs.ne'] at h1
    linarith
  · have h1 := mul_lt_mul_of_pos_right (Int.ceil_lt_add_one ((a - y₀) / s)) hs
    rw [add_mul, div_mul_cancel₀ _ hs.ne', one_mul] at h1
    linarith

/-- **Closed window catches a spaced coset.** Any arithmetic progression
    `y₀ + ℤ·s` (step `0 < s`) meets the fract-window
    `{y | Int.fract (y - x) ≤ L}` whenever `s ≤ L < 1`: take
    `k = ⌈(x - y₀)/s⌉`, so `y₀ + k·s - x ∈ [0, s) ⊆ [0, L]`. -/
lemma bhk_coset_catch (y₀ s x L : ℝ) (hs : 0 < s) (hsL : s ≤ L) (hL : L < 1) :
    ∃ k : ℤ, Int.fract (y₀ + (k : ℝ) * s - x) ≤ L := by
  refine ⟨⌈(x - y₀) / s⌉, ?_⟩
  have h_ceil_ge : (x - y₀) / s ≤ (⌈(x - y₀) / s⌉ : ℝ) := Int.le_ceil _
  have h_ceil_lt : (⌈(x - y₀) / s⌉ : ℝ) < (x - y₀) / s + 1 := Int.ceil_lt_add_one _
  have h_lo : 0 ≤ y₀ + (⌈(x - y₀) / s⌉ : ℝ) * s - x := by
    have h1 := mul_le_mul_of_nonneg_right h_ceil_ge hs.le
    rw [div_mul_cancel₀ _ hs.ne'] at h1
    linarith
  have h_hi : y₀ + (⌈(x - y₀) / s⌉ : ℝ) * s - x < s := by
    have h1 := mul_lt_mul_of_pos_right h_ceil_lt hs
    rw [add_mul, div_mul_cancel₀ _ hs.ne', one_mul] at h1
    linarith
  have h_fract_eq : Int.fract (y₀ + (⌈(x - y₀) / s⌉ : ℝ) * s - x) =
      y₀ + (⌈(x - y₀) / s⌉ : ℝ) * s - x :=
    Int.fract_eq_self.mpr ⟨h_lo, by linarith⟩
  rw [h_fract_eq]
  linarith

/-- **Generator equality for subgroups of `ZMod n`.** Any subgroup
    `X ≤ ZMod n` *equals* the cyclic subgroup generated by the residue
    `n / |X|`. Proved by sandwiching: every element of `X` is
    `|X|`-torsion, so `X` lies inside `⟨n/|X|⟩`; both have `|X|`
    elements, hence are equal. -/
lemma bhk_zmod_div_card_eq (n : ℕ) (hn : 0 < n) (X : AddSubgroup (ZMod n)) :
    X = AddSubgroup.zmultiples ((n / Nat.card X : ℕ) : ZMod n) := by
  haveI : NeZero n := ⟨hn.ne'⟩
  set m : ℕ := Nat.card X with hm_def
  have hm_pos : 0 < m := Nat.card_pos
  have hm_dvd : m ∣ n := by
    have h := AddSubgroup.card_addSubgroup_dvd_card X
    rwa [Nat.card_zmod] at h
  set d : ℕ := n / m with hd_def
  have hdm : d * m = n := Nat.div_mul_cancel hm_dvd
  have hd_pos : 0 < d := Nat.div_pos (Nat.le_of_dvd hn hm_dvd) hm_pos
  have hd_dvd : d ∣ n := ⟨m, hdm.symm⟩
  -- Every element of X is m-torsion.
  have h_torsion : ∀ x ∈ X, ((m : ℕ) : ZMod n) * x = 0 := by
    intro x hx
    have h1 : m • (⟨x, hx⟩ : X) = 0 := by
      rw [hm_def]; exact card_nsmul_eq_zero'
    have h2 := congrArg (X.subtype) h1
    rw [map_nsmul, map_zero] at h2
    simp only [AddSubgroup.subtype_apply] at h2
    rwa [nsmul_eq_mul] at h2
  -- Hence X is contained in the m-torsion subgroup ⟨(d : ZMod n)⟩.
  have h_le : X ≤ AddSubgroup.zmultiples ((d : ℕ) : ZMod n) := by
    intro x hx
    have h_zero : ((m * x.val : ℕ) : ZMod n) = 0 := by
      push_cast
      rw [ZMod.natCast_zmod_val]
      exact h_torsion x hx
    have h_n_dvd : n ∣ m * x.val := by
      have h3 : ((m * x.val : ℕ) : ZMod n) = ((0 : ℕ) : ZMod n) := by
        rw [h_zero]; norm_num
      exact (Nat.modEq_zero_iff_dvd).mp ((ZMod.natCast_eq_natCast_iff _ _ _).mp h3)
    have h_d_dvd : d ∣ x.val := by
      obtain ⟨t, ht⟩ := h_n_dvd
      refine ⟨t, ?_⟩
      have hmx : m * x.val = m * (d * t) := by
        rw [ht, ← hdm]; ring
      exact Nat.eq_of_mul_eq_mul_left hm_pos hmx
    obtain ⟨t, ht⟩ := h_d_dvd
    rw [AddSubgroup.mem_zmultiples_iff]
    refine ⟨(t : ℤ), ?_⟩
    have hx_eq : ((x.val : ℕ) : ZMod n) = x := ZMod.natCast_zmod_val x
    rw [← hx_eq, ht, zsmul_eq_mul]
    push_cast
    ring
  -- Card comparison: |⟨d⟩| = m = |X| forces equality.
  have h_card_z : Nat.card (AddSubgroup.zmultiples ((d : ℕ) : ZMod n)) = m := by
    rw [Nat.card_zmultiples, ZMod.addOrderOf_coe d hn.ne', Nat.gcd_eq_right hd_dvd,
        ← hdm, Nat.mul_div_cancel_left m hd_pos]
  exact AddSubgroup.eq_of_le_of_card_ge h_le (by rw [h_card_z, hm_def])

/-- **Generator membership for subgroups of `ZMod n`** (corollary of
    `bhk_zmod_div_card_eq`). -/
lemma bhk_zmod_div_card_mem (n : ℕ) (hn : 0 < n) (X : AddSubgroup (ZMod n)) :
    ((n / Nat.card X : ℕ) : ZMod n) ∈ X :=
  (bhk_zmod_div_card_eq n hn X).ge (AddSubgroup.mem_zmultiples _)

/-- **Column structure of an order-`n` subgroup of `(ZMod n)²`.**

    Any `H ≤ (ZMod n)²` with `|H| = n` determines positive integers
    `e, f` with `e * f = n` and a residue `c` such that `(e, c) ∈ H` and
    `(0, f) ∈ H`, and moreover `f` *generates* the kernel column
    `{y : (0, y) ∈ H}` (order `n/f`); `e` generates the
    first-coordinate image `π₁(H)` (order `n/e`).

    The identity `e · f = n` is the first isomorphism theorem
    `|H| = |im π₁| · |ker π₁|` combined with `|H| = n`. -/
lemma bhk_subgroup_column_structure (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n) :
    ∃ e f c : ℕ, 0 < e ∧ 0 < f ∧ e * f = n ∧
      (((e : ℕ) : ZMod n), ((c : ℕ) : ZMod n)) ∈ H ∧
      ((0 : ZMod n), ((f : ℕ) : ZMod n)) ∈ H ∧
      (∀ y : ZMod n, ((0 : ZMod n), y) ∈ H →
        y ∈ AddSubgroup.zmultiples (((f : ℕ) : ℕ) : ZMod n)) ∧
      (∀ p : ZMod n × ZMod n, p ∈ H →
        p.1 ∈ AddSubgroup.zmultiples (((e : ℕ) : ℕ) : ZMod n)) := by
  haveI : NeZero n := ⟨by omega⟩
  haveI : Finite H := Nat.finite_of_card_ne_zero (by rw [hH_card]; omega)
  -- First-coordinate projection of H.
  set π : H →+ ZMod n := (AddMonoidHom.fst (ZMod n) (ZMod n)).comp H.subtype
    with hπ_def
  -- First isomorphism theorem: |range π| · |ker π| = n.
  have h_iso : Nat.card (H ⧸ π.ker) = Nat.card π.range :=
    Nat.card_congr (QuotientAddGroup.quotientKerEquivRange π).toEquiv
  have h_lagrange := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup π.ker
  have h_prod : Nat.card π.range * Nat.card π.ker = n := by
    rw [← h_iso, ← h_lagrange, hH_card]
  -- The kernel column as a subgroup of ZMod n.
  set Y : AddSubgroup (ZMod n) :=
    { carrier := {y : ZMod n | ((0 : ZMod n), y) ∈ H}
      zero_mem' := H.zero_mem
      add_mem' := by
        intro a b ha hb
        have h := H.add_mem ha hb
        simpa using h
      neg_mem' := by
        intro a ha
        have h := H.neg_mem ha
        simpa using h } with hY_def
  have hY_mem_iff : ∀ y : ZMod n, y ∈ Y ↔ ((0 : ZMod n), y) ∈ H := by
    intro y; rfl
  -- Y is (equinumerous with) the kernel of π.
  have h_card_Y : Nat.card Y = Nat.card π.ker := by
    refine Nat.card_congr (Equiv.symm ?_)
    refine Equiv.ofBijective
      (fun k => (⟨(k.val.val).2, ?_⟩ : Y)) ⟨?_, ?_⟩
    · -- membership: (0, k.val.val.2) ∈ H
      have hk_mem : k.val.val ∈ H := k.val.prop
      have hk_fst : (k.val.val).1 = 0 := by
        have hk := k.prop
        rw [AddMonoidHom.mem_ker] at hk
        exact hk
      have h_pair : k.val.val = ((0 : ZMod n), (k.val.val).2) :=
        Prod.ext hk_fst rfl
      rw [hY_mem_iff, ← h_pair]
      exact hk_mem
    · -- injective
      intro k₁ k₂ h_eq
      have h_snd : (k₁.val.val).2 = (k₂.val.val).2 := congrArg Subtype.val h_eq
      have h_fst : (k₁.val.val).1 = (k₂.val.val).1 := by
        have h1 := k₁.prop
        have h2 := k₂.prop
        rw [AddMonoidHom.mem_ker] at h1 h2
        rw [show ((k₁.val.val).1 : ZMod n) = π k₁.val from rfl, h1,
            show ((k₂.val.val).1 : ZMod n) = π k₂.val from rfl, h2]
      exact Subtype.ext (Subtype.ext (Prod.ext h_fst h_snd))
    · -- surjective
      intro y
      have hy_mem : ((0 : ZMod n), y.val) ∈ H := (hY_mem_iff y.val).mp y.prop
      have h_in_ker : (⟨((0 : ZMod n), y.val), hy_mem⟩ : H) ∈ π.ker := by
        rw [AddMonoidHom.mem_ker]
        rfl
      exact ⟨⟨⟨((0 : ZMod n), y.val), hy_mem⟩, h_in_ker⟩, Subtype.ext rfl⟩
  -- Extract e from the image, f from the kernel column.
  have h_e_mem := bhk_zmod_div_card_mem n (by omega) π.range
  have h_f_mem := bhk_zmod_div_card_mem n (by omega) Y
  have h_Y_eq := bhk_zmod_div_card_eq n (by omega) Y
  have h_X_eq := bhk_zmod_div_card_eq n (by omega) π.range
  set mX : ℕ := Nat.card π.range with hmX_def
  set mY : ℕ := Nat.card Y with hmY_def
  have hmX_pos : 0 < mX := Nat.card_pos
  have hmY_pos : 0 < mY := Nat.card_pos
  have h_prod' : mX * mY = n := by rw [h_card_Y]; exact h_prod
  -- e = n / mX and f = n / mY multiply back to n.
  have he_eq : n / mX = mY := by
    rw [← h_prod', Nat.mul_div_cancel_left mY hmX_pos]
  have hf_eq : n / mY = mX := by
    have h2 : mY * mX = n := by rw [mul_comm]; exact h_prod'
    rw [← h2, Nat.mul_div_cancel_left mX hmY_pos]
  -- Unpack the image membership: some h₁ ∈ H has first coordinate e.
  obtain ⟨h₁, hπh₁⟩ := AddMonoidHom.mem_range.mp h_e_mem
  refine ⟨n / mX, n / mY, ((h₁.val).2).val, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- 0 < e
    rw [he_eq]; exact hmY_pos
  · -- 0 < f
    rw [hf_eq]; exact hmX_pos
  · -- e * f = n
    rw [he_eq, hf_eq, mul_comm]; exact h_prod'
  · -- ((e : ZMod n), (c : ZMod n)) ∈ H
    have h_fst : (h₁.val).1 = ((n / mX : ℕ) : ZMod n) := by
      rw [← hπh₁]; rfl
    have h_snd : ((((h₁.val).2).val : ℕ) : ZMod n) = (h₁.val).2 :=
      ZMod.natCast_zmod_val _
    have h_pair : (((n / mX : ℕ) : ZMod n), ((((h₁.val).2).val : ℕ) : ZMod n)) =
        h₁.val := by
      refine Prod.ext ?_ ?_
      · exact h_fst.symm
      · exact h_snd
    rw [h_pair]
    exact h₁.prop
  · -- ((0 : ZMod n), (f : ZMod n)) ∈ H
    exact (hY_mem_iff _).mp h_f_mem
  · -- f generates the kernel column.
    intro y hy
    have hy_Y : y ∈ Y := (hY_mem_iff y).mpr hy
    rw [h_Y_eq] at hy_Y
    exact hy_Y
  · -- e generates the first-coordinate image.
    intro p hp
    have hp1 : p.1 ∈ π.range := AddMonoidHom.mem_range.mpr ⟨⟨p, hp⟩, rfl⟩
    rw [h_X_eq] at hp1
    exact hp1

/-- **Row structure of an order-`n` subgroup of `(ZMod n)²`** — the
    coordinate swap of `bhk_subgroup_column_structure`: `e·f = n` with
    `(c, e) ∈ H`, `(f, 0) ∈ H`, and `f` generating the row kernel
    `{x : (x, 0) ∈ H}`. -/
lemma bhk_subgroup_row_structure (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n) :
    ∃ e f c : ℕ, 0 < e ∧ 0 < f ∧ e * f = n ∧
      (((c : ℕ) : ZMod n), ((e : ℕ) : ZMod n)) ∈ H ∧
      (((f : ℕ) : ZMod n), (0 : ZMod n)) ∈ H ∧
      (∀ x : ZMod n, (x, (0 : ZMod n)) ∈ H →
        x ∈ AddSubgroup.zmultiples (((f : ℕ) : ℕ) : ZMod n)) := by
  -- Transport along the coordinate swap.
  set σ : (ZMod n × ZMod n) ≃+ (ZMod n × ZMod n) :=
    AddEquiv.prodComm with hσ_def
  set H' : AddSubgroup (ZMod n × ZMod n) := H.map σ.toAddMonoidHom with hH'_def
  have hH'_mem : ∀ p : ZMod n × ZMod n, p ∈ H' ↔ (p.2, p.1) ∈ H := by
    intro p
    constructor
    · rintro ⟨q, hq, rfl⟩
      simpa [hσ_def] using hq
    · intro hp
      exact ⟨(p.2, p.1), hp, rfl⟩
  have hH'_card : Nat.card H' = n := by
    rw [hH'_def,
        ← Nat.card_congr (AddSubgroup.equivMapOfInjective H σ.toAddMonoidHom
          (AddEquiv.injective σ)).toEquiv]
    exact hH_card
  obtain ⟨e, f, c, he, hf, hef, h_ec, h_0f, h_gen, -⟩ :=
    bhk_subgroup_column_structure n hn H' hH'_card
  refine ⟨e, f, c, he, hf, hef, ?_, ?_, ?_⟩
  · exact (hH'_mem _).mp h_ec
  · exact (hH'_mem _).mp h_0f
  · intro x hx
    exact h_gen x ((hH'_mem _).mpr (by simpa using hx))

/-- **Vertical-axis case of the rectangle-minimal bound (`i = 0`).**

    If `(0, j)` (with `j ≠ 0`, `|j| ≤ βn`) reduces into `G` and is
    minimal, and `G` misses some `α × β` rectangle, then `α·|j| < 1`
    (the `i = 0` instance of BHK (12)).

    Geometry (BHK p10): minimality forces `|j| = f`, the generator of
    the kernel column of `H`; the column structure provides a slope
    point `(e, c) ∈ H` with `e·f = n`. If `α·f ≥ 1` then the
    `e`-multiples are `e/n = 1/f ≤ α`-dense horizontally and each
    occupied column is `f/n ≤ β`-dense vertically, so every rectangle
    is hit — contradiction. -/
lemma bhk_rectangle_minimal_vertical_axis
    (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (hG_lift : IsBHKLift G n)
    (α β : ℝ) (hα' : α < 1) (hβ' : β < 1)
    (j : ℤ) (hj : j ≠ 0)
    (hj_box : |(j : ℝ)| ≤ β * n)
    (hij_in_G : ((((0 : ℤ)) : ℝ) / n, (j : ℝ) / n) ∈ G)
    (hij_minimal : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ℝ) / n, (j₀ : ℝ) / n) ∈ G →
      ((0 : ℤ), j) ≠ (k * i₀, k * j₀))
    (h_misses : ∃ x₁ x₂, ¬ (G ∩ bhkRectangle x₁ x₂ α β).Nonempty) :
    α * |(j : ℝ)| < 1 := by
  by_contra h_ge
  push_neg at h_ge
  obtain ⟨x₁, x₂, h_miss⟩ := h_misses
  haveI : NeZero n := ⟨by omega⟩
  have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
  obtain ⟨H, hH_card, hG_iff⟩ := hG_lift
  have h_bridge := bhk_lift_int_mem_iff G n hn H hG_iff
  obtain ⟨e, f, c, he_pos, hf_pos, hef, h_ec_mem, h_0f_mem, h_gen, -⟩ :=
    bhk_subgroup_column_structure n hn H hH_card
  have he_pos_R : (0 : ℝ) < e := by exact_mod_cast he_pos
  have hf_pos_R : (0 : ℝ) < f := by exact_mod_cast hf_pos
  have hef_R : (e : ℝ) * f = n := by exact_mod_cast hef
  -- (0, j) reduces into H.
  have hj_H : (((0 : ℤ) : ZMod n), (j : ZMod n)) ∈ H := (h_bridge 0 j).mp hij_in_G
  -- f ∣ j (j lies in the kernel column, generated by f).
  have h_f_dvd : ((f : ℕ) : ℤ) ∣ j := by
    have h_zm : (j : ZMod n) ∈ AddSubgroup.zmultiples (((f : ℕ) : ℕ) : ZMod n) := by
      apply h_gen
      have h0 : ((0 : ℤ) : ZMod n) = (0 : ZMod n) := by push_cast; ring
      rwa [h0] at hj_H
    rw [AddSubgroup.mem_zmultiples_iff] at h_zm
    obtain ⟨m, hm⟩ := h_zm
    have h_zero : ((j - m * (f : ℕ) : ℤ) : ZMod n) = 0 := by
      push_cast
      rw [show ((j : ZMod n) : ZMod n) = m • ((f : ℕ) : ZMod n) from hm.symm,
          zsmul_eq_mul]
      ring
    have h_n_dvd : (n : ℤ) ∣ (j - m * (f : ℕ)) :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp h_zero
    obtain ⟨t, ht⟩ := h_n_dvd
    refine ⟨m + (e : ℤ) * t, ?_⟩
    have hef_Z : ((e : ℕ) : ℤ) * ((f : ℕ) : ℤ) = (n : ℤ) := by exact_mod_cast hef
    have h_j_eq : j = m * (f : ℕ) + (n : ℤ) * t := by linarith [ht]
    rw [h_j_eq, ← hef_Z]
    ring
  -- Minimality forces |j| = f.
  have h_abs_j : j.natAbs = f := by
    obtain ⟨q, hq⟩ := h_f_dvd
    have hq_ne : q ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at hq
      exact hj hq
    by_contra h_ne
    have h_natAbs_eq : j.natAbs = f * q.natAbs := by
      rw [hq, Int.natAbs_mul, Int.natAbs_natCast]
    have h_q_ge_2 : 2 ≤ q.natAbs := by
      have h1 : q.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hq_ne
      have h2 : q.natAbs ≠ 1 := by
        intro h1'
        rw [h1', mul_one] at h_natAbs_eq
        exact h_ne h_natAbs_eq
      omega
    rcases lt_or_gt_of_ne hq_ne with h_neg | h_pos
    · -- q < 0: (0, j) = ((-q)·0, (-q)·(-f)) violates minimality.
      have h_0negf_G : ((((0 : ℤ)) : ℝ) / n, ((-(f : ℕ) : ℤ) : ℝ) / n) ∈ G := by
        apply (h_bridge 0 (-(f : ℕ))).mpr
        have h_negf : ((-(f : ℕ) : ℤ) : ZMod n) = -((f : ℕ) : ZMod n) := by
          push_cast; ring
        rw [h_negf]
        have h0 : ((0 : ℤ) : ZMod n) = (0 : ZMod n) := by push_cast; ring
        rw [h0]
        have := H.neg_mem h_0f_mem
        simpa using this
      have h_k_gt : (1 : ℤ) < -q := by omega
      apply hij_minimal 0 (-(f : ℕ)) (-q) h_k_gt h_0negf_G
      refine Prod.ext ?_ ?_
      · simp
      · show j = -q * -(f : ℕ)
        rw [hq]; ring
    · -- q > 0: (0, j) = (q·0, q·f) violates minimality.
      have h_0f_G : ((((0 : ℤ)) : ℝ) / n, (((f : ℕ) : ℤ) : ℝ) / n) ∈ G := by
        apply (h_bridge 0 (f : ℕ)).mpr
        have h0 : ((0 : ℤ) : ZMod n) = (0 : ZMod n) := by push_cast; ring
        have hf_cast : (((f : ℕ) : ℤ) : ZMod n) = ((f : ℕ) : ZMod n) := by
          push_cast; ring
        rw [h0, hf_cast]
        exact h_0f_mem
      have h_k_gt : (1 : ℤ) < q := by omega
      apply hij_minimal 0 (f : ℕ) q h_k_gt h_0f_G
      refine Prod.ext ?_ ?_
      · simp
      · show j = q * (f : ℕ)
        rw [hq]; ring
  -- Real form: f = |j|.
  have h_f_eq_absj : (f : ℝ) = |(j : ℝ)| := by
    rw [← h_abs_j]
    exact_mod_cast (Int.cast_natAbs (α := ℝ) j)
  -- Density bounds for the two catching steps.
  have h_αf : 1 ≤ α * f := by rw [h_f_eq_absj]; exact h_ge
  have h_en_le : (e : ℝ) / n ≤ α := by
    have h_en : (e : ℝ) / n = 1 / f := by
      rw [← hef_R]
      field_simp
    rw [h_en, div_le_iff₀ hf_pos_R]
    linarith
  have h_fn_le : (f : ℝ) / n ≤ β := by
    rw [div_le_iff₀ hn_pos, h_f_eq_absj]
    exact hj_box
  -- Catch the rectangle: x-step then y-step.
  obtain ⟨k, hk⟩ := bhk_coset_catch 0 ((e : ℝ) / n) x₁ α (by positivity) h_en_le hα'
  obtain ⟨m, hm⟩ := bhk_coset_catch ((k : ℝ) * c / n) ((f : ℝ) / n) x₂ β
    (by positivity) h_fn_le hβ'
  -- The caught point of G.
  have hp_H : (((k * (e : ℕ) : ℤ) : ZMod n),
      ((k * (c : ℕ) + m * (f : ℕ) : ℤ) : ZMod n)) ∈ H := by
    have h_pair_eq :
        (((k * (e : ℕ) : ℤ) : ZMod n), ((k * (c : ℕ) + m * (f : ℕ) : ℤ) : ZMod n)) =
          k • (((e : ℕ) : ZMod n), ((c : ℕ) : ZMod n)) +
          m • ((0 : ZMod n), ((f : ℕ) : ZMod n)) := by
      refine Prod.ext ?_ ?_
      · show ((k * (e : ℕ) : ℤ) : ZMod n) =
            k • ((e : ℕ) : ZMod n) + m • (0 : ZMod n)
        rw [smul_zero, add_zero, zsmul_eq_mul]
        push_cast
        ring
      · show ((k * (c : ℕ) + m * (f : ℕ) : ℤ) : ZMod n) =
            k • ((c : ℕ) : ZMod n) + m • ((f : ℕ) : ZMod n)
        rw [zsmul_eq_mul, zsmul_eq_mul]
        push_cast
        ring
    rw [h_pair_eq]
    exact H.add_mem (H.zsmul_mem h_ec_mem k) (H.zsmul_mem h_0f_mem m)
  have hp_G : (((k * (e : ℕ) : ℤ) : ℝ) / n,
      ((k * (c : ℕ) + m * (f : ℕ) : ℤ) : ℝ) / n) ∈ G :=
    (h_bridge _ _).mpr hp_H
  -- The caught point lies in the missed rectangle: contradiction.
  apply h_miss
  refine ⟨(((k * (e : ℕ) : ℤ) : ℝ) / n,
    ((k * (c : ℕ) + m * (f : ℕ) : ℤ) : ℝ) / n), hp_G, ?_⟩
  refine ⟨Int.fract_nonneg _, ?_, Int.fract_nonneg _, ?_⟩
  · -- x-window
    have h_x_eq : ((k * (e : ℕ) : ℤ) : ℝ) / n = 0 + (k : ℝ) * ((e : ℝ) / n) := by
      push_cast
      ring
    show Int.fract (((k * (e : ℕ) : ℤ) : ℝ) / n - x₁) ≤ α
    rw [h_x_eq]
    exact hk
  · -- y-window
    have h_y_eq : ((k * (c : ℕ) + m * (f : ℕ) : ℤ) : ℝ) / n =
        (k : ℝ) * c / n + (m : ℝ) * ((f : ℝ) / n) := by
      push_cast
      ring
    show Int.fract (((k * (c : ℕ) + m * (f : ℕ) : ℤ) : ℝ) / n - x₂) ≤ β
    rw [h_y_eq]
    exact hm

/-- **Horizontal-axis case of the rectangle-minimal bound (`j = 0`).**

    Mirror image of `bhk_rectangle_minimal_vertical_axis`: if `(i, 0)`
    (with `i ≠ 0`, `|i| ≤ αn`) reduces into `G` and is minimal, and `G`
    misses some `α × β` rectangle, then `β·|i| < 1`. -/
lemma bhk_rectangle_minimal_horizontal_axis
    (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (hG_lift : IsBHKLift G n)
    (α β : ℝ) (hα' : α < 1) (hβ' : β < 1)
    (i : ℤ) (hi : i ≠ 0)
    (hi_box : |(i : ℝ)| ≤ α * n)
    (hij_in_G : ((i : ℝ) / n, (((0 : ℤ)) : ℝ) / n) ∈ G)
    (hij_minimal : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ℝ) / n, (j₀ : ℝ) / n) ∈ G →
      (i, (0 : ℤ)) ≠ (k * i₀, k * j₀))
    (h_misses : ∃ x₁ x₂, ¬ (G ∩ bhkRectangle x₁ x₂ α β).Nonempty) :
    β * |(i : ℝ)| < 1 := by
  by_contra h_ge
  push_neg at h_ge
  obtain ⟨x₁, x₂, h_miss⟩ := h_misses
  haveI : NeZero n := ⟨by omega⟩
  have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
  obtain ⟨H, hH_card, hG_iff⟩ := hG_lift
  have h_bridge := bhk_lift_int_mem_iff G n hn H hG_iff
  obtain ⟨e, f, c, he_pos, hf_pos, hef, h_ce_mem, h_f0_mem, h_gen⟩ :=
    bhk_subgroup_row_structure n hn H hH_card
  have he_pos_R : (0 : ℝ) < e := by exact_mod_cast he_pos
  have hf_pos_R : (0 : ℝ) < f := by exact_mod_cast hf_pos
  have hef_R : (e : ℝ) * f = n := by exact_mod_cast hef
  -- (i, 0) reduces into H.
  have hi_H : ((i : ZMod n), ((0 : ℤ) : ZMod n)) ∈ H := (h_bridge i 0).mp hij_in_G
  -- f ∣ i (i lies in the row kernel, generated by f).
  have h_f_dvd : ((f : ℕ) : ℤ) ∣ i := by
    have h_zm : (i : ZMod n) ∈ AddSubgroup.zmultiples (((f : ℕ) : ℕ) : ZMod n) := by
      apply h_gen
      have h0 : ((0 : ℤ) : ZMod n) = (0 : ZMod n) := by push_cast; ring
      rwa [h0] at hi_H
    rw [AddSubgroup.mem_zmultiples_iff] at h_zm
    obtain ⟨m, hm⟩ := h_zm
    have h_zero : ((i - m * (f : ℕ) : ℤ) : ZMod n) = 0 := by
      push_cast
      rw [show ((i : ZMod n) : ZMod n) = m • ((f : ℕ) : ZMod n) from hm.symm,
          zsmul_eq_mul]
      ring
    have h_n_dvd : (n : ℤ) ∣ (i - m * (f : ℕ)) :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp h_zero
    obtain ⟨t, ht⟩ := h_n_dvd
    refine ⟨m + (e : ℤ) * t, ?_⟩
    have hef_Z : ((e : ℕ) : ℤ) * ((f : ℕ) : ℤ) = (n : ℤ) := by exact_mod_cast hef
    have h_i_eq : i = m * (f : ℕ) + (n : ℤ) * t := by linarith [ht]
    rw [h_i_eq, ← hef_Z]
    ring
  -- Minimality forces |i| = f.
  have h_abs_i : i.natAbs = f := by
    obtain ⟨q, hq⟩ := h_f_dvd
    have hq_ne : q ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at hq
      exact hi hq
    by_contra h_ne
    have h_natAbs_eq : i.natAbs = f * q.natAbs := by
      rw [hq, Int.natAbs_mul, Int.natAbs_natCast]
    have h_q_ge_2 : 2 ≤ q.natAbs := by
      have h1 : q.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hq_ne
      have h2 : q.natAbs ≠ 1 := by
        intro h1'
        rw [h1', mul_one] at h_natAbs_eq
        exact h_ne h_natAbs_eq
      omega
    rcases lt_or_gt_of_ne hq_ne with h_neg | h_pos
    · -- q < 0: (i, 0) = ((-q)·(-f), (-q)·0) violates minimality.
      have h_negf0_G : (((-(f : ℕ) : ℤ) : ℝ) / n, (((0 : ℤ)) : ℝ) / n) ∈ G := by
        apply (h_bridge (-(f : ℕ)) 0).mpr
        have h_negf : ((-(f : ℕ) : ℤ) : ZMod n) = -((f : ℕ) : ZMod n) := by
          push_cast; ring
        have h0 : ((0 : ℤ) : ZMod n) = (0 : ZMod n) := by push_cast; ring
        rw [h_negf, h0]
        have := H.neg_mem h_f0_mem
        simpa using this
      have h_k_gt : (1 : ℤ) < -q := by omega
      apply hij_minimal (-(f : ℕ)) 0 (-q) h_k_gt h_negf0_G
      refine Prod.ext ?_ ?_
      · show i = -q * -(f : ℕ)
        rw [hq]; ring
      · simp
    · -- q > 0: (i, 0) = (q·f, q·0) violates minimality.
      have h_f0_G : ((((f : ℕ) : ℤ) : ℝ) / n, (((0 : ℤ)) : ℝ) / n) ∈ G := by
        apply (h_bridge (f : ℕ) 0).mpr
        have h0 : ((0 : ℤ) : ZMod n) = (0 : ZMod n) := by push_cast; ring
        have hf_cast : (((f : ℕ) : ℤ) : ZMod n) = ((f : ℕ) : ZMod n) := by
          push_cast; ring
        rw [h0, hf_cast]
        exact h_f0_mem
      have h_k_gt : (1 : ℤ) < q := by omega
      apply hij_minimal (f : ℕ) 0 q h_k_gt h_f0_G
      refine Prod.ext ?_ ?_
      · show i = q * (f : ℕ)
        rw [hq]; ring
      · simp
  -- Real form: f = |i|.
  have h_f_eq_absi : (f : ℝ) = |(i : ℝ)| := by
    rw [← h_abs_i]
    exact_mod_cast (Int.cast_natAbs (α := ℝ) i)
  -- Density bounds for the two catching steps.
  have h_βf : 1 ≤ β * f := by rw [h_f_eq_absi]; exact h_ge
  have h_en_le : (e : ℝ) / n ≤ β := by
    have h_en : (e : ℝ) / n = 1 / f := by
      rw [← hef_R]
      field_simp
    rw [h_en, div_le_iff₀ hf_pos_R]
    linarith
  have h_fn_le : (f : ℝ) / n ≤ α := by
    rw [div_le_iff₀ hn_pos, h_f_eq_absi]
    exact hi_box
  -- Catch the rectangle: y-step then x-step.
  obtain ⟨m, hm⟩ := bhk_coset_catch 0 ((e : ℝ) / n) x₂ β (by positivity) h_en_le hβ'
  obtain ⟨k, hk⟩ := bhk_coset_catch ((m : ℝ) * c / n) ((f : ℝ) / n) x₁ α
    (by positivity) h_fn_le hα'
  -- The caught point of G.
  have hp_H : (((m * (c : ℕ) + k * (f : ℕ) : ℤ) : ZMod n),
      ((m * (e : ℕ) : ℤ) : ZMod n)) ∈ H := by
    have h_pair_eq :
        (((m * (c : ℕ) + k * (f : ℕ) : ℤ) : ZMod n), ((m * (e : ℕ) : ℤ) : ZMod n)) =
          m • (((c : ℕ) : ZMod n), ((e : ℕ) : ZMod n)) +
          k • (((f : ℕ) : ZMod n), (0 : ZMod n)) := by
      refine Prod.ext ?_ ?_
      · show ((m * (c : ℕ) + k * (f : ℕ) : ℤ) : ZMod n) =
            m • ((c : ℕ) : ZMod n) + k • ((f : ℕ) : ZMod n)
        rw [zsmul_eq_mul, zsmul_eq_mul]
        push_cast
        ring
      · show ((m * (e : ℕ) : ℤ) : ZMod n) =
            m • ((e : ℕ) : ZMod n) + k • (0 : ZMod n)
        rw [smul_zero, add_zero, zsmul_eq_mul]
        push_cast
        ring
    rw [h_pair_eq]
    exact H.add_mem (H.zsmul_mem h_ce_mem m) (H.zsmul_mem h_f0_mem k)
  have hp_G : (((m * (c : ℕ) + k * (f : ℕ) : ℤ) : ℝ) / n,
      ((m * (e : ℕ) : ℤ) : ℝ) / n) ∈ G :=
    (h_bridge _ _).mpr hp_H
  -- The caught point lies in the missed rectangle: contradiction.
  apply h_miss
  refine ⟨(((m * (c : ℕ) + k * (f : ℕ) : ℤ) : ℝ) / n,
    ((m * (e : ℕ) : ℤ) : ℝ) / n), hp_G, ?_⟩
  refine ⟨Int.fract_nonneg _, ?_, Int.fract_nonneg _, ?_⟩
  · -- x-window
    have h_x_eq : ((m * (c : ℕ) + k * (f : ℕ) : ℤ) : ℝ) / n =
        (m : ℝ) * c / n + (k : ℝ) * ((f : ℝ) / n) := by
      push_cast
      ring
    show Int.fract (((m * (c : ℕ) + k * (f : ℕ) : ℤ) : ℝ) / n - x₁) ≤ α
    rw [h_x_eq]
    exact hk
  · -- y-window
    have h_y_eq : ((m * (e : ℕ) : ℤ) : ℝ) / n = 0 + (m : ℝ) * ((e : ℝ) / n) := by
      push_cast
      ring
    show Int.fract (((m * (e : ℕ) : ℤ) : ℝ) / n - x₂) ≤ β
    rw [h_y_eq]
    exact hm

/-- **ℤ-linear combinations of two `H`-pairs reduce into `H`.** -/
lemma bhk_int_comb_mem (n : ℕ) (H : AddSubgroup (ZMod n × ZMod n))
    (p₁ p₂ q₁ q₂ : ℤ)
    (hp : ((p₁ : ZMod n), (p₂ : ZMod n)) ∈ H)
    (hq : ((q₁ : ZMod n), (q₂ : ZMod n)) ∈ H) (A B : ℤ) :
    (((A * p₁ + B * q₁ : ℤ) : ZMod n), ((A * p₂ + B * q₂ : ℤ) : ZMod n)) ∈ H := by
  have h_pair :
      (((A * p₁ + B * q₁ : ℤ) : ZMod n), ((A * p₂ + B * q₂ : ℤ) : ZMod n)) =
        A • ((p₁ : ZMod n), (p₂ : ZMod n)) + B • ((q₁ : ZMod n), (q₂ : ZMod n)) := by
    refine Prod.ext ?_ ?_
    · show ((A * p₁ + B * q₁ : ℤ) : ZMod n) = A • (p₁ : ZMod n) + B • (q₁ : ZMod n)
      rw [zsmul_eq_mul, zsmul_eq_mul]
      push_cast
      ring
    · show ((A * p₂ + B * q₂ : ℤ) : ZMod n) = A • (p₂ : ZMod n) + B • (q₂ : ZMod n)
      rw [zsmul_eq_mul, zsmul_eq_mul]
      push_cast
      ring
  rw [h_pair]
  exact H.add_mem (H.zsmul_mem hp A) (H.zsmul_mem hq B)

/-- **From `(x : ZMod n) ∈ ⟨g⟩` with `g ∣ n`, conclude `g ∣ x` over ℤ.** -/
lemma bhk_zmultiples_int_dvd (n : ℕ) (hn : 0 < n) (g : ℕ)
    (hg_dvd : (g : ℤ) ∣ (n : ℤ)) (x : ℤ)
    (hx : (x : ZMod n) ∈ AddSubgroup.zmultiples ((g : ℕ) : ZMod n)) :
    (g : ℤ) ∣ x := by
  haveI : NeZero n := ⟨hn.ne'⟩
  rw [AddSubgroup.mem_zmultiples_iff] at hx
  obtain ⟨m, hm⟩ := hx
  have h_zero : ((x - m * (g : ℕ) : ℤ) : ZMod n) = 0 := by
    push_cast
    rw [show ((x : ZMod n) : ZMod n) = m • ((g : ℕ) : ZMod n) from hm.symm,
        zsmul_eq_mul]
    ring
  have h_n_dvd : (n : ℤ) ∣ (x - m * (g : ℕ)) :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp h_zero
  obtain ⟨t, ht⟩ := h_n_dvd
  obtain ⟨w, hw⟩ := hg_dvd
  refine ⟨m + w * t, ?_⟩
  have h_x_eq : x = m * (g : ℕ) + (n : ℤ) * t := by linarith [ht]
  rw [h_x_eq, hw]
  ring

/-- **Integer basis decomposition for an `H`-pair.** Given the column
    structure data `(e, c)`, `(0, f)` of `H` with the generator
    properties, every integer pair reducing into `H` decomposes as
    `(u, v) = k·(e, c) + l·(0, f)` over ℤ — i.e. the two column
    generators form a ℤ-basis of the lifted lattice. -/
lemma bhk_int_pair_basis (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n))
    (e f c : ℕ) (he_pos : 0 < e) (hf_pos : 0 < f) (hef : e * f = n)
    (h_ec_mem : (((e : ℕ) : ZMod n), ((c : ℕ) : ZMod n)) ∈ H)
    (h_kergen : ∀ y : ZMod n, ((0 : ZMod n), y) ∈ H →
        y ∈ AddSubgroup.zmultiples (((f : ℕ) : ℕ) : ZMod n))
    (h_imggen : ∀ p : ZMod n × ZMod n, p ∈ H →
        p.1 ∈ AddSubgroup.zmultiples (((e : ℕ) : ℕ) : ZMod n))
    (u v : ℤ) (h_uv : ((u : ZMod n), (v : ZMod n)) ∈ H) :
    ∃ k l : ℤ, u = k * e ∧ v = k * c + l * f := by
  haveI : NeZero n := ⟨by omega⟩
  have he_dvd_n : ((e : ℕ) : ℤ) ∣ (n : ℤ) := ⟨(f : ℤ), by exact_mod_cast hef.symm⟩
  have hf_dvd_n : ((f : ℕ) : ℤ) ∣ (n : ℤ) := ⟨(e : ℤ), by
    have : (f : ℤ) * e = (n : ℤ) := by
      have := hef
      push_cast [← this]
      ring
    exact this.symm⟩
  -- e ∣ u from the image generator property.
  have h_e_dvd : ((e : ℕ) : ℤ) ∣ u :=
    bhk_zmultiples_int_dvd n (by omega) e he_dvd_n u
      (h_imggen ((u : ZMod n), (v : ZMod n)) h_uv)
  obtain ⟨k, hk⟩ := h_e_dvd
  -- (0, v - k·c) reduces into H.
  have h_col : ((0 : ZMod n), ((v - k * c : ℤ) : ZMod n)) ∈ H := by
    have h_comb := bhk_int_comb_mem n H u v (e : ℕ) (c : ℕ)
      h_uv (by push_cast; exact h_ec_mem) 1 (-k)
    have h_fst : ((1 * u + (-k) * (e : ℕ) : ℤ) : ZMod n) = (0 : ZMod n) := by
      rw [show (1 * u + (-k) * (e : ℕ) : ℤ) = u - k * e from by ring, hk]
      push_cast
      ring
    have h_snd : ((1 * v + (-k) * (c : ℕ) : ℤ) : ZMod n) =
        ((v - k * c : ℤ) : ZMod n) := by
      congr 1
      ring
    rwa [h_fst, h_snd] at h_comb
  -- f ∣ (v - k·c) from the kernel generator property.
  have h_f_dvd : ((f : ℕ) : ℤ) ∣ (v - k * c) :=
    bhk_zmultiples_int_dvd n (by omega) f hf_dvd_n (v - k * c)
      (h_kergen _ h_col)
  obtain ⟨l, hl⟩ := h_f_dvd
  exact ⟨k, l, by linarith [hk], by linarith [hl]⟩

set_option maxHeartbeats 1000000 in
/-- **Core case of the rectangle-minimal bound (`i, j > 0`): hit
    construction.** If `(i, j)` (both positive, inside the
    `[αn] × [βn]` box) reduces into `H`, is minimal, and the BHK (12)
    bound *fails* (`n ≤ βn·i + αn·j - 2ij`), then every `α × β`
    rectangle contains a point of the lift.

    Discrete form of BHK's parallel-segment argument (p10): write
    `(i, j) = d·(e, c) + t·(0, f)` in the column basis; minimality says
    exactly `gcd(d, t) = 1`; Bézout yields `B ∈ M` with
    `i·B₂ - j·B₁ = n`, so `{(i, j), B}` is a ℤ-basis of the lattice
    and the parallel lines of BHK are the `b`-fibres `a ↦ a(i,j) + bB`.
    The rectangle hit reduces to a sliding-window overlap (windows of
    lengths `αn` and `i·βn/j`, sliding at step `n/j`), whose
    feasibility is *exactly* the failed (12); two interval catches
    finish. -/
lemma bhk_rectangle_minimal_core_hit (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n)
    (α β : ℝ) (hα' : α < 1) (hβ' : β < 1)
    (i j : ℤ) (hi : 0 < i) (hj : 0 < j)
    (hi_box : (i : ℝ) ≤ α * n) (hj_box : (j : ℝ) ≤ β * n)
    (hij_H : ((i : ZMod n), (j : ZMod n)) ∈ H)
    (hij_min_H : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H → (i, j) ≠ (k * i₀, k * j₀))
    (h12 : (n : ℝ) ≤ β * n * i + α * n * j - 2 * i * j)
    (x₁ x₂ : ℝ) :
    ∃ u v : ℤ, ((u : ZMod n), (v : ZMod n)) ∈ H ∧
      Int.fract ((u : ℝ) / n - x₁) ≤ α ∧ Int.fract ((v : ℝ) / n - x₂) ≤ β := by
  haveI : NeZero n := ⟨by omega⟩
  have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
  have hi_R : (0 : ℝ) < i := by exact_mod_cast hi
  have hj_R : (0 : ℝ) < j := by exact_mod_cast hj
  obtain ⟨e, f, c, he_pos, hf_pos, hef, h_ec_mem, h_0f_mem, h_kergen, h_imggen⟩ :=
    bhk_subgroup_column_structure n hn H hH_card
  have hef_Z : ((e : ℕ) : ℤ) * ((f : ℕ) : ℤ) = (n : ℤ) := by exact_mod_cast hef
  -- ℤ-cast forms of the two generators' memberships.
  have h_ec_Z : ((((e : ℕ) : ℤ) : ZMod n), (((c : ℕ) : ℤ) : ZMod n)) ∈ H := by
    push_cast
    exact h_ec_mem
  have h_0f_Z : ((((0 : ℕ) : ℤ) : ZMod n), (((f : ℕ) : ℤ) : ZMod n)) ∈ H := by
    push_cast
    exact h_0f_mem
  -- Basis decomposition of the minimal point: (i, j) = d·(e, c) + t·(0, f).
  obtain ⟨d, t, hd_eq, ht_eq⟩ := bhk_int_pair_basis n hn H e f c he_pos hf_pos hef
    h_ec_mem h_kergen h_imggen i j hij_H
  have he_Z_pos : (0 : ℤ) < (e : ℕ) := by exact_mod_cast he_pos
  have hd_pos : 0 < d := by
    rcases lt_trichotomy d 0 with h | h | h
    · nlinarith [hd_eq]
    · rw [h, zero_mul] at hd_eq
      omega
    · exact h
  -- Minimality in basis coordinates is coprimality.
  have h_gcd : Int.gcd d t = 1 := by
    by_contra h_ne
    have hg_ne : Int.gcd d t ≠ 0 := by
      rw [Ne, Int.gcd_eq_zero_iff]
      rintro ⟨h0, -⟩
      omega
    have hg_ge_2 : 2 ≤ Int.gcd d t := by omega
    obtain ⟨d', hd'⟩ := Int.gcd_dvd_left (a := d) (b := t)
    obtain ⟨t', ht'⟩ := Int.gcd_dvd_right (a := d) (b := t)
    have h_cand := bhk_int_comb_mem n H ((e : ℕ) : ℤ) ((c : ℕ) : ℤ)
      ((0 : ℕ) : ℤ) ((f : ℕ) : ℤ) h_ec_Z h_0f_Z d' t'
    apply hij_min_H (d' * (e : ℕ)) (d' * (c : ℕ) + t' * (f : ℕ))
      (Int.gcd d t) (by exact_mod_cast hg_ge_2) (by
        have h_fst : (d' * ((e : ℕ) : ℤ) + t' * ((0 : ℕ) : ℤ) : ℤ) =
            d' * (e : ℕ) := by push_cast; ring
        rwa [h_fst] at h_cand)
    refine Prod.ext ?_ ?_
    · show i = (Int.gcd d t : ℤ) * (d' * (e : ℕ))
      linear_combination hd_eq + ((e : ℕ) : ℤ) * hd'
    · show j = (Int.gcd d t : ℤ) * (d' * (c : ℕ) + t' * (f : ℕ))
      linear_combination ht_eq + ((c : ℕ) : ℤ) * hd' + ((f : ℕ) : ℤ) * ht'
  -- Bézout: ν·d - μ·t = 1.
  obtain ⟨ν, μ', h_bez⟩ := (Int.isCoprime_iff_gcd_eq_one.mpr h_gcd)
  set μ : ℤ := -μ' with hμ_def
  have h_unim : d * ν - t * μ = 1 := by
    rw [hμ_def]
    linarith [h_bez]
  -- The Bézout companion point B with i·B₂ - j·B₁ = n.
  set B₁ : ℤ := μ * (e : ℕ) with hB₁_def
  set B₂ : ℤ := μ * (c : ℕ) + ν * (f : ℕ) with hB₂_def
  have hB_mem : ((B₁ : ZMod n), (B₂ : ZMod n)) ∈ H := by
    have h_comb := bhk_int_comb_mem n H ((e : ℕ) : ℤ) ((c : ℕ) : ℤ)
      ((0 : ℕ) : ℤ) ((f : ℕ) : ℤ) h_ec_Z h_0f_Z μ ν
    have h_fst : (μ * ((e : ℕ) : ℤ) + ν * ((0 : ℕ) : ℤ) : ℤ) = B₁ := by
      rw [hB₁_def]
      all_goals push_cast; ring
    have h_snd : (μ * ((c : ℕ) : ℤ) + ν * ((f : ℕ) : ℤ) : ℤ) = B₂ := by
      rw [hB₂_def]
      all_goals push_cast; ring
    rwa [h_fst, h_snd] at h_comb
  have h_det : i * B₂ - j * B₁ = (n : ℤ) := by
    have h_expand : i * B₂ - j * B₁ =
        (((e : ℕ) : ℤ) * ((f : ℕ) : ℤ)) * (d * ν - t * μ) := by
      rw [hd_eq, ht_eq, hB₁_def, hB₂_def]
      ring
    rw [h_expand, h_unim, mul_one, hef_Z]
  -- ===== Sliding-window selection of the line index b =====
  -- Window 1: u ∈ [n·x₁, n·x₁ + αn].  Window 2 (line b): u such that
  -- the line height lands in the y-window — slides at step n/j.
  have h_sL : (n : ℝ) / j ≤ (α * n + (i : ℝ) * (β * n) / j - 2 * i) := by
    rw [div_le_iff₀ hj_R]
    have h_expand : (α * n + (i : ℝ) * (β * n) / j - 2 * i) * j =
        α * n * j + i * (β * n) - 2 * i * j := by
      field_simp
      try ring
    rw [h_expand]
    linarith [h12]
  obtain ⟨kb, hkb₁, hkb₂⟩ := bhk_interval_catch
    ((i : ℝ) * (n * x₂) / j - n * x₁) ((n : ℝ) / j)
    ((i : ℝ) - (i : ℝ) * (β * n) / j)
    (α * n + (i : ℝ) * (β * n) / j - 2 * i)
    (by positivity) h_sL
  set b : ℤ := -kb with hb_def
  set y : ℝ := (i : ℝ) * (n * x₂) / j - n * x₁ + (kb : ℝ) * ((n : ℝ) / j)
    with hy_def
  -- y-range: i - i·βn/j ≤ y ≤ αn - i.
  have hy_lo : (i : ℝ) - (i : ℝ) * (β * n) / j ≤ y := hkb₁
  have hy_hi : y ≤ α * n - (i : ℝ) := by
    linarith [hkb₂]
  -- The window-2 left endpoint P, and its product identity P·j = i·n·x₂ - b·n.
  set P : ℝ := y + n * x₁ with hP_def
  have hP_j : P * j = (i : ℝ) * (n * x₂) - (b : ℝ) * n := by
    rw [hP_def, hy_def, hb_def]
    push_cast
    field_simp
    ring
  -- ===== Catch u inside the overlap =====
  set cc : ℝ := n * x₁ + max 0 y with hcc_def
  obtain ⟨ka, hka₁, hka₂⟩ := bhk_interval_catch
    ((b : ℝ) * (B₁ : ℝ)) (i : ℝ) cc (i : ℝ) hi_R le_rfl
  set u : ℤ := b * B₁ + ka * i with hu_def
  have hu_cast : (u : ℝ) = (b : ℝ) * (B₁ : ℝ) + (ka : ℝ) * i := by
    rw [hu_def]
    push_cast
    ring
  -- u lies in window 1: n·x₁ ≤ u ≤ n·x₁ + αn.
  have hu_w1_lo : n * x₁ ≤ (u : ℝ) := by
    rw [hu_cast]
    have h_max : (0 : ℝ) ≤ max 0 y := le_max_left 0 y
    have : cc ≥ n * x₁ := by rw [hcc_def]; linarith
    linarith [hka₁]
  have hu_w1_hi : (u : ℝ) ≤ n * x₁ + α * n := by
    rw [hu_cast]
    rcases le_total 0 y with hy0 | hy0
    · have h_max : max 0 y = y := max_eq_right hy0
      have hcc_eq : cc = n * x₁ + y := by rw [hcc_def, h_max]
      have := hka₂
      rw [hcc_eq] at this
      linarith [hy_hi]
    · have h_max : max 0 y = 0 := max_eq_left hy0
      have hcc_eq : cc = n * x₁ := by rw [hcc_def, h_max]; ring
      have := hka₂
      rw [hcc_eq] at this
      linarith [hi_box]
  -- u lies in window 2: P ≤ u ≤ P + i·βn/j.
  have hu_w2_lo : P ≤ (u : ℝ) := by
    rw [hu_cast, hP_def]
    rcases le_total 0 y with hy0 | hy0
    · have h_max : max 0 y = y := max_eq_right hy0
      have hcc_eq : cc = n * x₁ + y := by rw [hcc_def, h_max]
      have := hka₁
      rw [hcc_eq] at this
      linarith
    · have h_max : max 0 y = 0 := max_eq_left hy0
      have hcc_eq : cc = n * x₁ := by rw [hcc_def, h_max]; ring
      have := hka₁
      rw [hcc_eq] at this
      linarith
  have hu_w2_hi : (u : ℝ) ≤ P + (i : ℝ) * (β * n) / j := by
    rw [hu_cast, hP_def]
    have h_ij_le : (i : ℝ) ≤ (i : ℝ) * (β * n) / j := by
      rw [le_div_iff₀ hj_R]
      nlinarith [hj_box, hi_R.le]
    rcases le_total 0 y with hy0 | hy0
    · have h_max : max 0 y = y := max_eq_right hy0
      have hcc_eq : cc = n * x₁ + y := by rw [hcc_def, h_max]
      have := hka₂
      rw [hcc_eq] at this
      linarith
    · have h_max : max 0 y = 0 := max_eq_left hy0
      have hcc_eq : cc = n * x₁ := by rw [hcc_def, h_max]; ring
      have := hka₂
      rw [hcc_eq] at this
      linarith [hy_lo]
  -- ===== Assemble the hit point =====
  set v : ℤ := b * B₂ + ka * j with hv_def
  have h_iv : i * v = b * (n : ℤ) + u * j := by
    rw [hv_def, hu_def]
    linear_combination b * h_det
  -- y-window for v: n·x₂ ≤ v ≤ n·x₂ + βn.
  have h_uj_lo : (i : ℝ) * (n * x₂) ≤ (b : ℝ) * n + (u : ℝ) * j := by
    have h1 := mul_le_mul_of_nonneg_right hu_w2_lo hj_R.le
    rw [hP_j] at h1
    linarith
  have h_uj_hi : (b : ℝ) * n + (u : ℝ) * j ≤ (i : ℝ) * (n * x₂) + (i : ℝ) * (β * n) := by
    have h1 := mul_le_mul_of_nonneg_right hu_w2_hi hj_R.le
    rw [add_mul, hP_j, div_mul_cancel₀ _ hj_R.ne'] at h1
    linarith
  have h_iv_R : (i : ℝ) * (v : ℝ) = (b : ℝ) * n + (u : ℝ) * j := by
    exact_mod_cast congrArg (Int.cast : ℤ → ℝ) h_iv
  have hv_lo : n * x₂ ≤ (v : ℝ) := by
    have h1 : (i : ℝ) * (n * x₂) ≤ (i : ℝ) * (v : ℝ) := by rw [h_iv_R]; linarith
    exact le_of_mul_le_mul_left h1 hi_R
  have hv_hi : (v : ℝ) ≤ n * x₂ + β * n := by
    have h1 : (i : ℝ) * (v : ℝ) ≤ (i : ℝ) * (n * x₂ + β * n) := by
      rw [h_iv_R, mul_add]
      linarith
    exact le_of_mul_le_mul_left h1 hi_R
  -- Membership of (u, v).
  have h_uv_mem : ((u : ZMod n), (v : ZMod n)) ∈ H := by
    have h_comb := bhk_int_comb_mem n H B₁ B₂ i j hB_mem hij_H b ka
    have h_fst : (b * B₁ + ka * i : ℤ) = u := by rw [hu_def]
    have h_snd : (b * B₂ + ka * j : ℤ) = v := by rw [hv_def]
    rwa [h_fst, h_snd] at h_comb
  -- α, β are positive (from the box and positivity of i, j).
  have hα_pos : (0 : ℝ) < α := by nlinarith [hi_box, hi_R, hn_pos]
  have hβ_pos : (0 : ℝ) < β := by nlinarith [hj_box, hj_R, hn_pos]
  -- The fract conditions.
  refine ⟨u, v, h_uv_mem, ?_, ?_⟩
  · have h_arg : (u : ℝ) / n - x₁ = ((u : ℝ) - n * x₁) / n := by
      field_simp
    rw [h_arg]
    have h_in : 0 ≤ ((u : ℝ) - n * x₁) / n ∧ ((u : ℝ) - n * x₁) / n ≤ α := by
      constructor
      · apply div_nonneg _ hn_pos.le
        linarith
      · rw [div_le_iff₀ hn_pos]
        linarith [hu_w1_hi]
    rw [Int.fract_eq_self.mpr ⟨h_in.1, lt_of_le_of_lt h_in.2 hα'⟩]
    exact h_in.2
  · have h_arg : (v : ℝ) / n - x₂ = ((v : ℝ) - n * x₂) / n := by
      field_simp
    rw [h_arg]
    have h_in : 0 ≤ ((v : ℝ) - n * x₂) / n ∧ ((v : ℝ) - n * x₂) / n ≤ β := by
      constructor
      · apply div_nonneg _ hn_pos.le
        linarith
      · rw [div_le_iff₀ hn_pos]
        linarith [hv_hi]
    rw [Int.fract_eq_self.mpr ⟨h_in.1, lt_of_le_of_lt h_in.2 hβ'⟩]
    exact h_in.2

/-- **Fract reflection.** If the fractional position of `w` relative to
    the reflected target `-x - γ` is within `γ`, then the fractional
    position of `-w` relative to `x` is within `γ`. Pure `Int.fract`
    algebra: transports a rectangle hit through the coordinate
    reflection `w ↦ -w`. -/
lemma bhk_fract_reflect (w x γ : ℝ) (hγ : 0 ≤ γ) (hγ' : γ < 1)
    (h : Int.fract (w - (-x - γ)) ≤ γ) : Int.fract (-w - x) ≤ γ := by
  have hs0 : 0 ≤ Int.fract (w + x + γ) := Int.fract_nonneg _
  have hsγ : Int.fract (w + x + γ) ≤ γ := by
    have harg : w - (-x - γ) = w + x + γ := by ring
    rwa [harg] at h
  have hfr : Int.fract (w + x + γ) = (w + x + γ) - (⌊w + x + γ⌋ : ℤ) := rfl
  have hkey : -w - x =
      (γ - Int.fract (w + x + γ)) - ((⌊w + x + γ⌋ : ℤ) : ℝ) := by
    rw [hfr]
    ring
  rw [hkey, Int.fract_sub_intCast,
    Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩]
  linarith

/-- **Sign handling for the core hit, step 1: `i > 0`, `j ≠ 0`.**

    The case `j < 0` is transported through the `y`-reflection
    automorphism `σ : (x, y) ↦ (x, -y)` of `(ZMod n)²`: the reflected
    subgroup `H' = σ(H)` has the same order, `(i, -j)` lies in `H'`
    positively and minimally, and a hit for `H'` at the reflected
    target `(x₁, -x₂ - β)` reflects back to a hit for `H` at
    `(x₁, x₂)` via `bhk_fract_reflect`. -/
lemma bhk_rectangle_minimal_core_hit_pos_i (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n)
    (α β : ℝ) (hα' : α < 1) (hβ : 0 ≤ β) (hβ' : β < 1)
    (i j : ℤ) (hi : 0 < i) (hj : j ≠ 0)
    (hi_box : (i : ℝ) ≤ α * n) (hj_box : |(j : ℝ)| ≤ β * n)
    (hij_H : ((i : ZMod n), (j : ZMod n)) ∈ H)
    (hij_min_H : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H → (i, j) ≠ (k * i₀, k * j₀))
    (h12 : (n : ℝ) ≤ β * n * i + α * n * |(j : ℝ)| - 2 * i * |(j : ℝ)|)
    (x₁ x₂ : ℝ) :
    ∃ u v : ℤ, ((u : ZMod n), (v : ZMod n)) ∈ H ∧
      Int.fract ((u : ℝ) / n - x₁) ≤ α ∧ Int.fract ((v : ℝ) / n - x₂) ≤ β := by
  rcases lt_or_gt_of_ne hj with hj_neg | hj_pos
  · -- j < 0: reflect the second coordinate.
    set σ : (ZMod n × ZMod n) ≃+ (ZMod n × ZMod n) :=
      (AddEquiv.refl (ZMod n)).prodCongr (AddEquiv.neg (ZMod n)) with hσ_def
    set H' : AddSubgroup (ZMod n × ZMod n) := H.map σ.toAddMonoidHom with hH'_def
    -- Membership characterisation of H' on integer casts.
    have h_mem' : ∀ u v : ℤ, ((u : ZMod n), (v : ZMod n)) ∈ H' ↔
        ((u : ZMod n), ((-v : ℤ) : ZMod n)) ∈ H := by
      intro u v
      have hcast : ((-v : ℤ) : ZMod n) = -((v : ℤ) : ZMod n) := by
        push_cast; ring
      rw [hH'_def, AddSubgroup.mem_map_equiv, hcast]
      rfl
    have hH'_card : Nat.card H' = n := by
      have hcongr : Nat.card (H.map σ.toAddMonoidHom) = Nat.card H :=
        (Nat.card_congr
          (AddSubgroup.equivMapOfInjective H σ.toAddMonoidHom σ.injective).toEquiv).symm
      rw [hH'_def]
      exact hcongr.trans hH_card
    -- (i, -j) ∈ H', positively.
    have hij_H' : ((i : ZMod n), ((-j : ℤ) : ZMod n)) ∈ H' := by
      rw [h_mem' i (-j)]
      simpa using hij_H
    -- Minimality transports through the reflection.
    have hij_min' : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
        ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H' → (i, -j) ≠ (k * i₀, k * j₀) := by
      intro i₀ j₀ k hk h₀ h_eq
      have h₀H : ((i₀ : ZMod n), ((-j₀ : ℤ) : ZMod n)) ∈ H := (h_mem' i₀ j₀).mp h₀
      apply hij_min_H i₀ (-j₀) k hk h₀H
      have h1 : i = k * i₀ := congrArg Prod.fst h_eq
      have h2 : -j = k * j₀ := congrArg Prod.snd h_eq
      refine Prod.ext h1 ?_
      show j = k * -j₀
      linear_combination -h2
    have habs : |(j : ℝ)| = -(j : ℝ) := abs_of_neg (by exact_mod_cast hj_neg)
    -- Core hit for H' at the reflected target.
    obtain ⟨u, v, h_uv', hu, hv⟩ := bhk_rectangle_minimal_core_hit n hn H' hH'_card
      α β hα' hβ' i (-j) hi (by omega)
      hi_box (by push_cast; linarith [hj_box, habs.symm.le, habs.le])
      hij_H' hij_min'
      (by push_cast; rw [habs] at h12; linarith) x₁ (-x₂ - β)
    -- Reflect the hit back.
    refine ⟨u, -v, (h_mem' u v).mp h_uv', hu, ?_⟩
    have harg : (((-v : ℤ) : ℝ)) / n - x₂ = -((v : ℝ) / n) - x₂ := by
      push_cast; ring
    rw [harg]
    exact bhk_fract_reflect ((v : ℝ) / n) x₂ β hβ hβ' hv
  · -- j > 0: direct.
    have habs : |(j : ℝ)| = (j : ℝ) := abs_of_pos (by exact_mod_cast hj_pos)
    exact bhk_rectangle_minimal_core_hit n hn H hH_card α β hα' hβ' i j hi hj_pos
      hi_box (habs ▸ hj_box) hij_H hij_min_H (habs ▸ h12) x₁ x₂

/-- **Sign handling for the core hit, step 2: `i ≠ 0`, `j ≠ 0`.**

    The case `i < 0` is handled by negating the point: `(-i, -j) ∈ H`
    with `-i > 0`, minimality and the box/(12) data transport (all are
    stated in `|i|`, `|j|` form) — and the conclusion does not mention
    `(i, j)`, so the hit needs no transport at all. -/
lemma bhk_rectangle_minimal_core_hit_signed (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n)
    (α β : ℝ) (hα' : α < 1) (hβ : 0 ≤ β) (hβ' : β < 1)
    (i j : ℤ) (hi : i ≠ 0) (hj : j ≠ 0)
    (hi_box : |(i : ℝ)| ≤ α * n) (hj_box : |(j : ℝ)| ≤ β * n)
    (hij_H : ((i : ZMod n), (j : ZMod n)) ∈ H)
    (hij_min_H : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H → (i, j) ≠ (k * i₀, k * j₀))
    (h12 : (n : ℝ) ≤ β * n * |(i : ℝ)| + α * n * |(j : ℝ)| -
      2 * |(i : ℝ)| * |(j : ℝ)|)
    (x₁ x₂ : ℝ) :
    ∃ u v : ℤ, ((u : ZMod n), (v : ZMod n)) ∈ H ∧
      Int.fract ((u : ℝ) / n - x₁) ≤ α ∧ Int.fract ((v : ℝ) / n - x₂) ≤ β := by
  rcases lt_or_gt_of_ne hi with hi_neg | hi_pos
  · -- i < 0: negate the point inside the same H.
    have habs_i : |(i : ℝ)| = -(i : ℝ) := abs_of_neg (by exact_mod_cast hi_neg)
    have h_neg_mem : (((-i : ℤ) : ZMod n), ((-j : ℤ) : ZMod n)) ∈ H := by
      push_cast
      simpa using H.neg_mem hij_H
    have h_neg_min : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
        ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H → (-i, -j) ≠ (k * i₀, k * j₀) := by
      intro i₀ j₀ k hk h₀ h_eq
      have h₀' : (((-i₀ : ℤ) : ZMod n), ((-j₀ : ℤ) : ZMod n)) ∈ H := by
        push_cast
        simpa using H.neg_mem h₀
      apply hij_min_H (-i₀) (-j₀) k hk h₀'
      have h1 : -i = k * i₀ := congrArg Prod.fst h_eq
      have h2 : -j = k * j₀ := congrArg Prod.snd h_eq
      refine Prod.ext ?_ ?_
      · show i = k * -i₀
        linear_combination -h1
      · show j = k * -j₀
        linear_combination -h2
    have habs_negi : ((-i : ℤ) : ℝ) = |(i : ℝ)| := by
      push_cast
      rw [habs_i]
    have habs_negj : |((-j : ℤ) : ℝ)| = |(j : ℝ)| := by
      push_cast
      rw [abs_neg]
    exact bhk_rectangle_minimal_core_hit_pos_i n hn H hH_card α β hα' hβ hβ'
      (-i) (-j) (by omega) (by omega)
      (habs_negi ▸ hi_box) (habs_negj ▸ hj_box)
      h_neg_mem h_neg_min
      (by rw [habs_negi, habs_negj]; exact h12) x₁ x₂
  · -- i > 0: feed directly.
    have habs_i : |(i : ℝ)| = (i : ℝ) := abs_of_pos (by exact_mod_cast hi_pos)
    exact bhk_rectangle_minimal_core_hit_pos_i n hn H hH_card α β hα' hβ hβ'
      i j hi_pos hj
      (habs_i ▸ hi_box) hj_box hij_H hij_min_H (habs_i ▸ h12) x₁ x₂

/-- **BHK Main Lemma — rectangle-missing implies (12) for minimal (i,j).**

    If `G` misses some `α × β` rectangle `R` in `T`, then any *minimal*
    nonzero lattice point `(i,j) ∈ K ∩ ℤ²` with `(i/n, j/n) ∈ G` and
    `(i, j) ∈ [-αn, αn] × [-βn, βn]` satisfies
    `β|i| + α|j| - (2/n)|i||j| < 1`.

    Proof (BHK p9–10): split on whether `i = 0`, `j = 0`, or `i, j > 0`.

    * `i = 0`: `G` is `n/j` equidistant points on `j` vertical circles,
      separated horizontally by `1/j ≤ α`. The internal point spacing
      `j/n` would have to exceed `β` (else `G` hits any vertical strip),
      i.e. `α|j| < α·βn = β·n·α ≤ β·j` — gives (12).
    * `j = 0`: symmetric.
    * `i, j > 0`: circle `L_g` generated by `g = (i/n, j/n)` has period
      `i/n`. The family `ℒ` of equally-spaced segments parallel to
      `L_g` cross the rectangle's left edge `{x_1} × [x_2, x_2+β]` at
      `i` equally distributed points; if none falls in the y-range,
      `β - j(2i - αn)/(in) < 1/i`, equivalent to (12).

    **Status:** fully proved. The axis cases `i = 0` and `j = 0` go
    through `bhk_rectangle_minimal_vertical_axis` /
    `bhk_rectangle_minimal_horizontal_axis` (column/row structure of
    `H` and coset catching). The `i ≠ 0 ∧ j ≠ 0` core goes through
    `bhk_rectangle_minimal_core_hit_signed`, the discrete
    sliding-window form of the line-segment family argument, with
    signs handled by point negation and the `y`-reflection
    automorphism of `(ZMod n)²`. -/
theorem bhk_main_lemma_rectangle_minimal
    (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (hG_lift : IsBHKLift G n)
    (α β : ℝ) (hα : 0 < α) (hα' : α < 1) (hβ : 0 < β) (hβ' : β < 1)
    (i j : ℤ) (hij : (i, j) ≠ (0, 0))
    (hij_in_box : (|(i : ℝ)| ≤ α * n) ∧ (|(j : ℝ)| ≤ β * n))
    (hij_in_G : ((i : ℝ) / n, (j : ℝ) / n) ∈ G)
    (hij_minimal : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ℝ) / n, (j₀ : ℝ) / n) ∈ G →
      (i, j) ≠ (k * i₀, k * j₀))
    (h_misses : ∃ x₁ x₂, ¬ (G ∩ bhkRectangle x₁ x₂ α β).Nonempty) :
    β * |(i : ℝ)| + α * |(j : ℝ)| - 2 / n * |(i : ℝ)| * |(j : ℝ)| < 1 := by
  by_cases hi0 : i = 0
  · -- i = 0: the bound reduces to α·|j| < 1.
    have hj0 : j ≠ 0 := by
      intro hj0
      exact hij (by rw [hi0, hj0])
    subst hi0
    have h_axis := bhk_rectangle_minimal_vertical_axis G n hn hG_lift α β hα' hβ'
      j hj0 hij_in_box.2 hij_in_G hij_minimal h_misses
    simp only [Int.cast_zero, abs_zero, mul_zero, zero_mul, sub_zero, zero_add]
    linarith
  by_cases hj0 : j = 0
  · -- j = 0: the bound reduces to β·|i| < 1.
    subst hj0
    have h_axis := bhk_rectangle_minimal_horizontal_axis G n hn hG_lift α β hα' hβ'
      i hi0 hij_in_box.1 hij_in_G hij_minimal h_misses
    simp only [Int.cast_zero, abs_zero, mul_zero, zero_mul, sub_zero, add_zero]
    linarith
  · -- i ≠ 0 ∧ j ≠ 0: the discrete line-segment family argument
    -- (`bhk_rectangle_minimal_core_hit_signed`): if (12) failed, the
    -- sliding-window construction would hit the missed rectangle.
    by_contra h_ge
    push_neg at h_ge
    obtain ⟨x₁, x₂, h_miss⟩ := h_misses
    haveI : NeZero n := ⟨by omega⟩
    have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
    obtain ⟨H, hH_card, hG_iff⟩ := hG_lift
    have h_bridge := bhk_lift_int_mem_iff G n hn H hG_iff
    have hij_H : ((i : ZMod n), (j : ZMod n)) ∈ H := (h_bridge i j).mp hij_in_G
    have hij_min_H : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
        ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H → (i, j) ≠ (k * i₀, k * j₀) :=
      fun i₀ j₀ k hk h₀ => hij_minimal i₀ j₀ k hk ((h_bridge i₀ j₀).mpr h₀)
    -- ¬(12) in the n-scaled form needed by the core hit.
    have h12 : (n : ℝ) ≤ β * n * |(i : ℝ)| + α * n * |(j : ℝ)| -
        2 * |(i : ℝ)| * |(j : ℝ)| := by
      have hkey := mul_le_mul_of_nonneg_right h_ge hn_pos.le
      have hdiv : 2 / (n : ℝ) * |(i : ℝ)| * |(j : ℝ)| * n =
          2 * |(i : ℝ)| * |(j : ℝ)| := by
        field_simp
      nlinarith [hkey, hdiv]
    obtain ⟨u, v, h_uv, hu, hv⟩ := bhk_rectangle_minimal_core_hit_signed n hn
      H hH_card α β hα' hβ.le hβ' i j hi0 hj0 hij_in_box.1 hij_in_box.2
      hij_H hij_min_H h12 x₁ x₂
    exact h_miss ⟨((u : ℝ) / n, (v : ℝ) / n), (h_bridge u v).mpr h_uv,
      Int.fract_nonneg _, hu, Int.fract_nonneg _, hv⟩

/-! ## Main statement (BHK Main Lemma) -/

/-- **BHK Main Lemma.** Let `G ⊆ ℝ²` be a finite subgroup of `T` of
    order `n > 1`. Let `0 < α, β < 1` with `α · β ≥ 1/n`. Then either
    `G` intersects every `α × β` rectangle, OR there exists a nonzero
    lattice point `(i, j) ∈ ℤ²` with `(i/n, j/n) ∈ G` satisfying
    `β|i| + α|j| - (2/n)|i||j| < 1`.

    Proof: combine `bhk_main_lemma_existence` (Minkowski) with
    `bhk_main_lemma_minimality` (minimal representative) and
    `bhk_main_lemma_rectangle_minimal` (the bound when `G` misses a
    rectangle). -/
theorem bhk_main_lemma
    (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (hG_lift : IsBHKLift G n)
    (α β : ℝ) (hα : 0 < α) (hα' : α < 1) (hβ : 0 < β) (hβ' : β < 1)
    (hαβ : α * β ≥ 1 / (n : ℝ)) :
    (∀ x₁ x₂, (G ∩ bhkRectangle x₁ x₂ α β).Nonempty) ∨
    (∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
      β * |(ij.1 : ℝ)| + α * |(ij.2 : ℝ)| - 2 / n * |(ij.1 : ℝ)| * |(ij.2 : ℝ)| < 1) := by
  -- Classical disjunction: either every rectangle is hit, or some is missed.
  by_cases h_all_hit : ∀ x₁ x₂, (G ∩ bhkRectangle x₁ x₂ α β).Nonempty
  · exact Or.inl h_all_hit
  · refine Or.inr ?_
    push_neg at h_all_hit
    obtain ⟨x₁, x₂, h_miss_eq⟩ := h_all_hit
    have h_miss : ¬ (G ∩ bhkRectangle x₁ x₂ α β).Nonempty := by
      rw [Set.not_nonempty_iff_eq_empty]; exact h_miss_eq
    -- Choose K = [-αn, αn] × [-βn, βn] (the maximum allowed box).
    set K : Set (ℝ × ℝ) :=
      Set.Icc (-(α * n)) (α * n) ×ˢ Set.Icc (-(β * n)) (β * n) with hK_def
    have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
    have hαn_pos : (0 : ℝ) < α * n := mul_pos hα hn_pos
    have hβn_pos : (0 : ℝ) < β * n := mul_pos hβ hn_pos
    -- K is symmetric, convex, compact.
    have hK_sym : ∀ x ∈ K, -x ∈ K := by
      intro x hx
      rw [hK_def] at hx ⊢
      obtain ⟨⟨hL1, hR1⟩, hL2, hR2⟩ := hx
      refine ⟨⟨?_, ?_⟩, ?_, ?_⟩
      · simp; linarith
      · simp; linarith
      · simp; linarith
      · simp; linarith
    have hK_conv : Convex ℝ K := by
      rw [hK_def]; exact (convex_Icc _ _).prod (convex_Icc _ _)
    have hK_compact : IsCompact K := by
      rw [hK_def]; exact (isCompact_Icc).prod isCompact_Icc
    -- Area of K is 4αβn² ≥ 4n (since αβ ≥ 1/n).
    have hK_area : (4 * n : ℝ) ≤ (MeasureTheory.volume K).toReal := by
      rw [hK_def, MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod,
          Real.volume_Icc, Real.volume_Icc]
      have h1 : (α * (n : ℝ) - -(α * (n : ℝ))) = 2 * α * n := by ring
      have h2 : (β * (n : ℝ) - -(β * (n : ℝ))) = 2 * β * n := by ring
      rw [h1, h2,
          ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ 2 * α * n),
          ENNReal.toReal_ofReal (by positivity : (0 : ℝ) ≤ 2 * α * n * (2 * β * n))]
      have hone : (1 : ℝ) ≤ α * β * (n : ℝ) := by
        rw [ge_iff_le, div_le_iff₀ hn_pos] at hαβ
        linarith
      nlinarith [hone, hn_pos, hα, hβ]
    -- Apply existence to find (i,j) ∈ K ∩ ℤ² \ {(0,0)} with (i/n,j/n) ∈ G.
    obtain ⟨ij, hij_ne, hij_K, hij_G⟩ :=
      bhk_main_lemma_existence G n hn hG_lift α β hα hβ K subset_rfl
        hK_sym hK_conv hK_compact hK_area
    have hαn_nn : (0 : ℝ) ≤ α * n := hαn_pos.le
    have hβn_nn : (0 : ℝ) ≤ β * n := hβn_pos.le
    have hij_box : |((ij.1 : ℝ))| ≤ α * n ∧ |((ij.2 : ℝ))| ≤ β * n := by
      have hK1 : ((ij.1 : ℝ), (ij.2 : ℝ)) ∈
                  Icc (-(α * (n : ℝ))) (α * n) ×ˢ Icc (-(β * (n : ℝ))) (β * n) := by
        rw [hK_def] at hij_K; exact hij_K
      rcases hK1 with ⟨⟨hL1, hR1⟩, hL2, hR2⟩
      exact ⟨abs_le.mpr ⟨hL1, hR1⟩, abs_le.mpr ⟨hL2, hR2⟩⟩
    -- Refine to minimal (i,j), preserving box membership.
    obtain ⟨ij', hij'_ne, hij'_G, hij'_α, hij'_β, hij'_min⟩ :=
      bhk_main_lemma_minimality G n hn α β hαn_nn hβn_nn
        ⟨ij, hij_ne, hij_G, hij_box.1, hij_box.2⟩
    have hij'_box : |((ij'.1 : ℝ))| ≤ α * n ∧ |((ij'.2 : ℝ))| ≤ β * n := ⟨hij'_α, hij'_β⟩
    have h_bound := bhk_main_lemma_rectangle_minimal G n hn hG_lift α β
      hα hα' hβ hβ' ij'.1 ij'.2 hij'_ne hij'_box hij'_G hij'_min
      ⟨x₁, x₂, h_miss⟩
    exact ⟨ij', hij'_ne, hij'_G, h_bound⟩

/-! ## Corollary 6 (BHK §3.2)

The applied form of the Main Lemma. The convex polygon `X` is the
region in `ℤ²` bounded by `0 ≤ i < 1/β` and
`-1/α - (β/α)·i < j < 1/α + (β/α)·i`. -/

/-- The BHK Corollary 6 region `X ⊆ ℤ²`. -/
def bhkCor6Region (α β : ℝ) : Set (ℤ × ℤ) :=
  {ij | 0 ≤ ij.1 ∧ (ij.1 : ℝ) < 1 / β ∧
        -1 / α - β / α * ij.1 < (ij.2 : ℝ) ∧
        (ij.2 : ℝ) < 1 / α + β / α * ij.1} \ {(0, 0)}

/-- **Group-theoretic helper for Corollary 6 Case C.**

    Any AddSubgroup `H ⊆ ZMod n × ZMod n` of order `n` (with `n > 1`)
    contains a nonzero element whose second coordinate is `0` or `1`.

    Proof: Consider the homomorphism `f : H → ZMod n` from second
    projection. Two cases:
    * `f` injective: since `|H| = n = |ZMod n|`, `f` is also surjective.
      Pick `h ∈ H` with `f(h) = 1`. Then `h ≠ 0` (else `f(h) = 0 ≠ 1`)
      and `h.2 = 1`.
    * `f` not injective: ∃ `a, b ∈ H` with `a ≠ b` and `f(a) = f(b)`,
      i.e., `a - b ≠ 0` and `f(a - b) = 0`. So `(a - b).2 = 0`. -/
lemma bhk_corollary_6_case_C_helper
    (n : ℕ) (hn : 1 < n) (H : AddSubgroup (ZMod n × ZMod n))
    (hH_card : Nat.card H = n) :
    ∃ ab : ZMod n × ZMod n, ab ∈ H ∧ ab ≠ 0 ∧ (ab.2 = 0 ∨ ab.2 = 1) := by
  haveI : Fact (1 < n) := ⟨hn⟩
  haveI hn_pos : NeZero n := ⟨by omega⟩
  haveI : Finite H := Nat.finite_of_card_ne_zero (by rw [hH_card]; exact hn_pos.out)
  let f : H →+ ZMod n := (AddMonoidHom.snd (ZMod n) (ZMod n)).comp H.subtype
  by_cases hf_inj : Function.Injective f
  · have h_card_eq : Nat.card H = Nat.card (ZMod n) := by
      rw [hH_card, Nat.card_zmod]
    have hf_surj : Function.Surjective f := by
      have hα : Fintype H := Fintype.ofFinite H
      have hβ : Fintype (ZMod n) := Fintype.ofFinite (ZMod n)
      have h_card' : Fintype.card H = Fintype.card (ZMod n) := by
        rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, h_card_eq]
      exact (Fintype.bijective_iff_injective_and_card f).mpr ⟨hf_inj, h_card'⟩ |>.surjective
    obtain ⟨h, h_eq⟩ := hf_surj 1
    refine ⟨h.val, h.property, ?_, Or.inr ?_⟩
    · intro h_zero
      have hh_zero : h = (0 : H) := Subtype.ext h_zero
      rw [hh_zero] at h_eq
      simp [f] at h_eq
    · have := h_eq
      simp [f] at this
      exact this
  · obtain ⟨a, b, hfab, hab⟩ := Function.not_injective_iff.mp hf_inj
    have h_sub_ne : a - b ≠ 0 := sub_ne_zero.mpr hab
    have h_sub_in : (a - b).val ∈ H := (a - b).property
    have h_sub_proj : (a - b).val.2 = 0 := by
      have hk : f (a - b) = 0 := by
        rw [map_sub, hfab, sub_self]
      simpa [f] using hk
    refine ⟨(a - b).val, h_sub_in, ?_, Or.inl h_sub_proj⟩
    intro h_val_zero
    apply h_sub_ne
    exact Subtype.ext h_val_zero

/-- **Small-`i` witness for Corollary 6 (Cases A & B).**

    A nonzero integer pair `(i, j)` reducing into `H`, with `|i| ≤ B` for
    some bound `B` *strictly* below `1/β`, and `|j| ≤ βn`.

    This replaces the closed-box Minkowski step: the closed box
    `[-1/β, 1/β] × [-βn, βn]` has area exactly `4n`, so Minkowski only
    yields the non-strict `|i| ≤ 1/β`, with a genuine boundary case
    `|i| = 1/β` possible when `1/β ∈ ℤ`. BHK (p10) instead take the box
    half-open in `x` and argue "although it is only half-closed, n
    translates of it cannot be disjoint" — a measure-density argument
    that is awkward to formalize. We avoid both via the column structure
    of `H` and Dirichlet's approximation theorem:

    * if `eβ ≥ 1`, the column point `(0, f)` works since `f = n/e ≤ βn`;
    * if `eβ < 1`, Dirichlet with `κ = ⌈1/(βe)⌉ ≥ 2` gives `1 ≤ k ≤ κ-1`
      and `j` with `|k·c - j·f| ≤ f/κ ≤ βn`; the witness is
      `(k·e, k·c - j·f)` with `|k·e| ≤ (κ-1)·e < 1/β`. -/
lemma bhk_corollary_6_small_i_witness (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n)
    (β : ℝ) (hβ : 0 < β) :
    ∃ B : ℝ, 0 ≤ B ∧ B < 1 / β ∧ ∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ZMod n), (ij.2 : ZMod n)) ∈ H ∧
      |(ij.1 : ℝ)| ≤ B ∧ |(ij.2 : ℝ)| ≤ β * n := by
  obtain ⟨e, f, c, he_pos, hf_pos, hef, h_ec_mem, h_0f_mem, -, -⟩ :=
    bhk_subgroup_column_structure n hn H hH_card
  have hn_pos_R : (0 : ℝ) < n := by exact_mod_cast (by omega : 0 < n)
  have he_pos_R : (0 : ℝ) < e := by exact_mod_cast he_pos
  have hf_pos_R : (0 : ℝ) < f := by exact_mod_cast hf_pos
  have hef_R : (e : ℝ) * f = n := by exact_mod_cast hef
  have h_1β_pos : (0 : ℝ) < 1 / β := by positivity
  by_cases h_eβ : 1 ≤ (e : ℝ) * β
  · -- Case `eβ ≥ 1`: vertical witness (0, f), B = 0.
    refine ⟨0, le_refl 0, h_1β_pos, ((0 : ℤ), (f : ℤ)), ?_, ?_, ?_, ?_⟩
    · -- (0, f) ≠ (0, 0)
      intro h_eq
      have h2 : ((f : ℕ) : ℤ) = 0 := congrArg Prod.snd h_eq
      have : f = 0 := by exact_mod_cast h2
      omega
    · -- membership, modulo ℤ-vs-ℕ casts
      have h_fst : (((0 : ℤ) : ZMod n)) = (0 : ZMod n) := by push_cast; ring
      have h_snd : ((((f : ℕ) : ℤ) : ZMod n)) = ((f : ℕ) : ZMod n) := by
        push_cast; ring
      rw [show ((((0 : ℤ), (f : ℤ)) : ℤ × ℤ).1 : ZMod n) = (0 : ZMod n) from h_fst,
          show ((((0 : ℤ), (f : ℤ)) : ℤ × ℤ).2 : ZMod n) = ((f : ℕ) : ZMod n) from h_snd]
      exact h_0f_mem
    · simp
    · -- |f| ≤ βn: from βe ≥ 1, βn = (βe)·f ≥ f.
      have h_abs : |(((f : ℕ) : ℤ) : ℝ)| = (f : ℝ) := by
        rw [abs_of_nonneg (by positivity : (0 : ℝ) ≤ (((f : ℕ) : ℤ) : ℝ))]
        push_cast
        ring
      rw [show ((((0 : ℤ), (f : ℤ)) : ℤ × ℤ).2 : ℝ) = (((f : ℕ) : ℤ) : ℝ) from rfl,
          h_abs]
      have h_expand : ((e : ℝ) * β - 1) * f = β * n - f := by
        rw [← hef_R]; ring
      have h_nonneg : (0 : ℝ) ≤ ((e : ℝ) * β - 1) * f :=
        mul_nonneg (by linarith) hf_pos_R.le
      linarith
  · -- Case `eβ < 1`: Dirichlet pigeonhole on the column slope c/f.
    push_neg at h_eβ
    have h_βe_pos : (0 : ℝ) < β * e := by positivity
    set κ : ℕ := ⌈1 / (β * (e : ℝ))⌉₊ with hκ_def
    have hκ_ge : 1 / (β * (e : ℝ)) ≤ (κ : ℝ) := Nat.le_ceil _
    have hκ_lt : (κ : ℝ) < 1 / (β * e) + 1 := by
      rw [hκ_def]
      exact Nat.ceil_lt_add_one (by positivity)
    have hκ_gt_one : 1 < κ := by
      rw [hκ_def, Nat.lt_ceil]
      push_cast
      rw [lt_div_iff₀ h_βe_pos]
      nlinarith
    have hκ_pos_R : (0 : ℝ) < κ := by
      exact_mod_cast (by omega : 0 < κ)
    have hκ_pred : 0 < κ - 1 := by omega
    obtain ⟨j, k, hk_pos, hk_le, h_dir⟩ :=
      Real.exists_int_int_abs_mul_sub_le ((c : ℝ) / f) hκ_pred
    have hκ_cast : ((κ - 1 : ℕ) : ℝ) = (κ : ℝ) - 1 := by
      have h1 : (1 : ℕ) ≤ κ := by omega
      push_cast [h1]
      ring
    have h_dir' : |(k : ℝ) * ((c : ℝ) / f) - (j : ℝ)| ≤ 1 / κ := by
      have h1 : ((κ - 1 : ℕ) : ℝ) + 1 = κ := by rw [hκ_cast]; ring
      rwa [h1] at h_dir
    have hk_le_R : (k : ℝ) ≤ (κ : ℝ) - 1 := by
      rw [← hκ_cast]; exact_mod_cast hk_le
    have hk_pos_R : (0 : ℝ) < k := by exact_mod_cast hk_pos
    -- The witness pair (k·e, k·c - j·f).
    refine ⟨((κ : ℝ) - 1) * e, by nlinarith, ?_,
        ((k * (e : ℕ) : ℤ), (k * (c : ℕ) - j * (f : ℕ) : ℤ)), ?_, ?_, ?_, ?_⟩
    · -- B < 1/β: (κ-1)·e < (1/(βe))·e = 1/β.
      have h1 : (κ : ℝ) - 1 < 1 / (β * e) := by linarith
      calc ((κ : ℝ) - 1) * e < (1 / (β * e)) * e :=
            mul_lt_mul_of_pos_right h1 he_pos_R
        _ = 1 / β := by field_simp
    · -- nonzero: first coordinate k·e > 0.
      intro h_eq
      have h1 : (k * (e : ℕ) : ℤ) = 0 := congrArg Prod.fst h_eq
      have he_int : (0 : ℤ) < ((e : ℕ) : ℤ) := by exact_mod_cast he_pos
      nlinarith
    · -- membership: the pair is k•(e, c) - j•(0, f) in (ZMod n)².
      have h_pair_eq :
          (((k * (e : ℕ) : ℤ) : ZMod n), ((k * (c : ℕ) - j * (f : ℕ) : ℤ) : ZMod n)) =
            k • (((e : ℕ) : ZMod n), ((c : ℕ) : ZMod n)) -
            j • ((0 : ZMod n), ((f : ℕ) : ZMod n)) := by
        refine Prod.ext ?_ ?_
        · show ((k * (e : ℕ) : ℤ) : ZMod n) =
              k • ((e : ℕ) : ZMod n) - j • (0 : ZMod n)
          rw [smul_zero, sub_zero, zsmul_eq_mul]
          push_cast
          ring
        · show ((k * (c : ℕ) - j * (f : ℕ) : ℤ) : ZMod n) =
              k • ((c : ℕ) : ZMod n) - j • ((f : ℕ) : ZMod n)
          rw [zsmul_eq_mul, zsmul_eq_mul]
          push_cast
          ring
      rw [show ((((k * (e : ℕ) : ℤ), (k * (c : ℕ) - j * (f : ℕ) : ℤ)) : ℤ × ℤ).1 : ZMod n) =
            (((k * (e : ℕ) : ℤ)) : ZMod n) from rfl]
      rw [show ((((k * (e : ℕ) : ℤ), (k * (c : ℕ) - j * (f : ℕ) : ℤ)) : ℤ × ℤ).2 : ZMod n) =
            (((k * (c : ℕ) - j * (f : ℕ) : ℤ)) : ZMod n) from rfl]
      rw [show ((((k * (e : ℕ) : ℤ)) : ZMod n), (((k * (c : ℕ) - j * (f : ℕ) : ℤ)) : ZMod n)) =
            k • (((e : ℕ) : ZMod n), ((c : ℕ) : ZMod n)) -
            j • ((0 : ZMod n), ((f : ℕ) : ZMod n)) from h_pair_eq]
      exact H.sub_mem (H.zsmul_mem h_ec_mem k) (H.zsmul_mem h_0f_mem j)
    · -- |k·e| ≤ (κ-1)·e.
      have h_pos : (0 : ℝ) < (k : ℝ) * (e : ℕ) := by
        nlinarith
      rw [show (((k * (e : ℕ) : ℤ)) : ℝ) = (k : ℝ) * ((e : ℕ) : ℝ) from by push_cast; ring,
          abs_of_pos h_pos]
      nlinarith
    · -- |k·c - j·f| = |k·(c/f) - j|·f ≤ f/κ ≤ (βe)·f = βn.
      have h_abs_eq : |((k * (c : ℕ) - j * (f : ℕ) : ℤ) : ℝ)| =
          |(k : ℝ) * ((c : ℝ) / f) - (j : ℝ)| * f := by
        have h1 : ((k * (c : ℕ) - j * (f : ℕ) : ℤ) : ℝ) =
            ((k : ℝ) * ((c : ℝ) / f) - (j : ℝ)) * f := by
          push_cast
          field_simp
        rw [h1, abs_mul, abs_of_pos hf_pos_R]
      rw [show (((k * (c : ℕ) - j * (f : ℕ) : ℤ)) : ℝ) =
            ((k * (c : ℕ) - j * (f : ℕ) : ℤ) : ℝ) from rfl, h_abs_eq]
      have h_1κ_le : (1 : ℝ) / κ ≤ β * e := by
        rw [div_le_iff₀ hκ_pos_R]
        calc (1 : ℝ) = (1 / (β * e)) * (β * e) := by field_simp
          _ ≤ (κ : ℝ) * (β * e) := mul_le_mul_of_nonneg_right hκ_ge h_βe_pos.le
          _ = β * e * κ := by ring
      calc |(k : ℝ) * ((c : ℝ) / f) - (j : ℝ)| * f ≤ (1 / κ) * f :=
            mul_le_mul_of_nonneg_right h_dir' hf_pos_R.le
        _ ≤ (β * e) * f := mul_le_mul_of_nonneg_right h_1κ_le hf_pos_R.le
        _ = β * n := by rw [mul_assoc, hef_R]

/-- **BHK Corollary 6.** Either `G` intersects every `α × β` rectangle,
    or there exists `(i, j) ∈ bhkCor6Region α β` with `(i/n, j/n) ∈ G`.

    Proof (BHK §3.2, p10–11): three cases on `n` vs `1/(αβ)` and `1/β`.

    * **Cases A & B** `n ≥ 1/β` (unified): a pigeonhole witness
      (`bhk_corollary_6_small_i_witness`, replacing BHK's half-open-box
      Minkowski argument) gives a nonzero `(i, j)` in `H`-coords with
      `|i| ≤ B < 1/β` *strictly* and `|j| ≤ βn`. Refine to a minimal
      representative (`bhk_main_lemma_minimality`, with `α' := B/n`, so
      the strict bound is inherited), then `rectangle_minimal` gives the
      BHK (12) bound, from which the cone bounds on `j` follow since
      `|j| ≤ βn`. WLOG `i ≥ 0` by group symmetry; this gives
      `(i, j) ∈ X`.

    * **Case C** `n < 1/β`: `X` contains the set `{0,...,n-1} × {-1,0,1}
      \ {(0,0)}` (since `n < 1/β` and `α < 1` imply `n-1 < 1/β` and
      `1 < 1/α`). Cyclic-subgroup theory: `G` contains some
      `(i/n, j/n)` with `i ∈ {0,...,n-1}` and `j ∈ {-1, 0, 1}` (i.e.,
      a generator can be chosen with second coordinate in this range
      using the cyclic group structure mod `n`). -/
theorem bhk_corollary_6
    (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (hG_lift : IsBHKLift G n)
    (α β : ℝ) (hα : 0 < α) (hα' : α < 1) (hβ : 0 < β) (hβ' : β < 1)
    (hαβ : α * β ≥ 1 / (n : ℝ)) :
    (∀ x₁ x₂, (G ∩ bhkRectangle x₁ x₂ α β).Nonempty) ∨
    (∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
      0 ≤ ij.1 ∧ (ij.1 : ℝ) < 1 / β ∧
      -1 / α - β / α * ij.1 < (ij.2 : ℝ) ∧
      (ij.2 : ℝ) < 1 / α + β / α * ij.1) := by
  by_cases h_n_lt_1_β : (n : ℝ) < 1 / β
  · -- ===== Case C: `n < 1/β` (combinatorial) =====
    refine Or.inr ?_
    obtain ⟨H, hH_card, hG_iff⟩ := hG_lift
    obtain ⟨ab, hab_in, hab_ne, hab_proj⟩ :=
      bhk_corollary_6_case_C_helper n hn H hH_card
    haveI : Fact (1 < n) := ⟨hn⟩
    haveI : NeZero n := ⟨by omega⟩
    have hab1_val_lt : ab.1.val < n := ZMod.val_lt _
    have habval_nonneg : (0 : ℝ) ≤ (ab.1.val : ℝ) := Nat.cast_nonneg _
    have habval_lt_n : (ab.1.val : ℝ) < (n : ℝ) := by exact_mod_cast hab1_val_lt
    have h_1α_pos : (0 : ℝ) < 1/α := one_div_pos.mpr hα
    have h_1_lt_1α : (1 : ℝ) < 1/α := by rw [lt_div_iff₀ hα]; linarith
    have hβα_nonneg : (0 : ℝ) ≤ β/α := div_nonneg hβ.le hα.le
    have h_prod_nonneg : (0 : ℝ) ≤ β/α * (ab.1.val : ℝ) :=
      mul_nonneg hβα_nonneg habval_nonneg
    rcases hab_proj with hab_0 | hab_1
    · -- ab.2 = 0. Witness: ((ab.1.val : ℤ), 0).
      refine ⟨((ab.1.val : ℤ), 0), ?_, ?_, ?_, ?_, ?_, ?_⟩
      · -- (i, j) ≠ (0, 0). Else i = 0 → ab.1 = 0 → ab = (0, 0).
        intro h_eq
        have h_i_zero : ((ab.1.val : ℤ)) = (0 : ℤ) := congr_arg Prod.fst h_eq
        have h_val_zero : ab.1.val = 0 := by exact_mod_cast h_i_zero
        have h_ab1_zero : ab.1 = 0 := (ZMod.val_eq_zero ab.1).mp h_val_zero
        exact hab_ne (Prod.ext h_ab1_zero hab_0)
      · -- (i/n, 0/n) ∈ G.
        rw [hG_iff]
        refine ⟨ab, hab_in, 0, 0, ?_⟩
        have h_val_2 : ab.2.val = 0 := by rw [hab_0]; exact ZMod.val_zero
        refine Prod.ext ?_ ?_
        · show ((ab.1.val : ℤ) : ℝ) / (n : ℝ) = (ab.1.val : ℝ) / n + ((0 : ℤ) : ℝ)
          push_cast; ring
        · show ((0 : ℤ) : ℝ) / (n : ℝ) = (ab.2.val : ℝ) / n + ((0 : ℤ) : ℝ)
          rw [h_val_2]; push_cast; ring
      · exact Int.ofNat_nonneg _
      · show ((ab.1.val : ℤ) : ℝ) < 1 / β
        push_cast; linarith
      · show -1/α - β/α * ((ab.1.val : ℤ) : ℝ) < ((0 : ℤ) : ℝ)
        push_cast
        have h_pos : (0 : ℝ) < 1/α + β/α * (ab.1.val : ℝ) :=
          add_pos_of_pos_of_nonneg h_1α_pos h_prod_nonneg
        have h_neg_form : (-1 : ℝ) / α - β / α * (ab.1.val : ℝ) =
                          -(1/α + β/α * (ab.1.val : ℝ)) := by ring
        linarith [h_pos, h_neg_form]
      · show ((0 : ℤ) : ℝ) < 1/α + β/α * ((ab.1.val : ℤ) : ℝ)
        push_cast; linarith
    · -- ab.2 = 1. Witness: ((ab.1.val : ℤ), 1).
      refine ⟨((ab.1.val : ℤ), 1), ?_, ?_, ?_, ?_, ?_, ?_⟩
      · intro h_eq
        have : (1 : ℤ) = 0 := congr_arg Prod.snd h_eq
        exact one_ne_zero this
      · rw [hG_iff]
        refine ⟨ab, hab_in, 0, 0, ?_⟩
        have h_val_2 : ab.2.val = 1 := by rw [hab_1]; exact ZMod.val_one n
        refine Prod.ext ?_ ?_
        · show ((ab.1.val : ℤ) : ℝ) / (n : ℝ) = (ab.1.val : ℝ) / n + ((0 : ℤ) : ℝ)
          push_cast; ring
        · show ((1 : ℤ) : ℝ) / (n : ℝ) = (ab.2.val : ℝ) / n + ((0 : ℤ) : ℝ)
          rw [h_val_2]; push_cast; ring
      · exact Int.ofNat_nonneg _
      · show ((ab.1.val : ℤ) : ℝ) < 1 / β
        push_cast; linarith
      · show -1/α - β/α * ((ab.1.val : ℤ) : ℝ) < ((1 : ℤ) : ℝ)
        push_cast
        have h_pos : (0 : ℝ) < 1/α + β/α * (ab.1.val : ℝ) :=
          add_pos_of_pos_of_nonneg h_1α_pos h_prod_nonneg
        have h_neg_form : (-1 : ℝ) / α - β / α * (ab.1.val : ℝ) =
                          -(1/α + β/α * (ab.1.val : ℝ)) := by ring
        linarith [h_pos, h_neg_form]
      · show ((1 : ℤ) : ℝ) < 1/α + β/α * ((ab.1.val : ℤ) : ℝ)
        push_cast; linarith
  · -- ===== Cases A & B: `n ≥ 1/β`. Apply Main Lemma with the small K =====
    push_neg at h_n_lt_1_β  -- h_n_lt_1_β : 1/β ≤ ↑n
    have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
    have h_1β_pos : (0 : ℝ) < 1/β := one_div_pos.mpr hβ
    have hβn_pos : (0 : ℝ) < β * n := mul_pos hβ hn_pos
    have hβn_nn : (0 : ℝ) ≤ β * n := hβn_pos.le
    -- αβn ≥ 1 (from hαβ : αβ ≥ 1/n), hence 1/β ≤ αn.
    have hαβn_ge_one : (1 : ℝ) ≤ α * β * n := by
      have := hαβ
      rw [ge_iff_le, div_le_iff₀ hn_pos] at this
      linarith
    have h_1β_le_αn : (1 : ℝ) / β ≤ α * n := by
      rw [div_le_iff₀ hβ]; linarith
    -- Classical disjunction
    by_cases h_all_hit : ∀ x₁ x₂, (G ∩ bhkRectangle x₁ x₂ α β).Nonempty
    · exact Or.inl h_all_hit
    refine Or.inr ?_
    push_neg at h_all_hit
    obtain ⟨x₁, x₂, h_miss_eq⟩ := h_all_hit
    have h_miss : ¬ (G ∩ bhkRectangle x₁ x₂ α β).Nonempty := by
      rw [Set.not_nonempty_iff_eq_empty]; exact h_miss_eq
    -- Unpack the lift once (a copy survives for the Main Lemma applications).
    obtain ⟨H, hH_card, hG_iff⟩ := id hG_lift
    haveI : NeZero n := ⟨by omega⟩
    have hn_ne_real : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
    -- Integer-coordinate characterization of G-membership.
    have hG_int_iff : ∀ a b : ℤ, ((a : ℝ) / n, (b : ℝ) / n) ∈ G ↔
        ((a : ZMod n), (b : ZMod n)) ∈ H :=
      fun a b => bhk_lift_int_mem_iff G n hn H hG_iff a b
    -- Pigeonhole witness: nonzero (i,j) in H-coords with |i| ≤ B < 1/β, |j| ≤ βn.
    -- (Strictness of B < 1/β is what the closed-box Minkowski step cannot give.)
    obtain ⟨B, hB_nn, hB_lt, ij₀, hij₀_ne, hij₀_H, hij₀_B, hij₀_β⟩ :=
      bhk_corollary_6_small_i_witness n hn H hH_card β hβ
    -- Feed it to minimality with α' := B/n (so that α'·n = B).
    have h_Bn_eq : (B / n) * (n : ℝ) = B := div_mul_cancel₀ B hn_ne_real
    have h_Bn_nn : (0 : ℝ) ≤ (B / n) * (n : ℝ) := by rw [h_Bn_eq]; exact hB_nn
    have hij₀_ex : ∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
        ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
        |(ij.1 : ℝ)| ≤ (B / n) * n ∧ |(ij.2 : ℝ)| ≤ β * n := by
      refine ⟨ij₀, hij₀_ne, (hG_int_iff ij₀.1 ij₀.2).mpr hij₀_H, ?_, hij₀_β⟩
      rw [h_Bn_eq]; exact hij₀_B
    obtain ⟨ij', hij'_ne, hij'_G, hij'_α', hij'_β, hij'_min⟩ :=
      bhk_main_lemma_minimality G n hn (B / n) β h_Bn_nn hβn_nn hij₀_ex
    -- Strict bound |i| < 1/β, inherited from B < 1/β.
    have hij'_i_lt : |(ij'.1 : ℝ)| < 1 / β := by
      rw [h_Bn_eq] at hij'_α'
      exact lt_of_le_of_lt hij'_α' hB_lt
    have hij'_box_αn : |(ij'.1 : ℝ)| ≤ α * n := le_trans hij'_i_lt.le h_1β_le_αn
    -- Apply rectangle_minimal to get the BHK (12) bound on (i,j).
    have h_bound := bhk_main_lemma_rectangle_minimal G n hn hG_lift α β
      hα hα' hβ hβ' ij'.1 ij'.2 hij'_ne ⟨hij'_box_αn, hij'_β⟩ hij'_G hij'_min
      ⟨x₁, x₂, h_miss⟩
    -- WLOG ij'.1 ≥ 0 via G-negation symmetry (G is the ℤ²-lift of H closed under neg).
    -- G-negation: from (a/n, b/n) ∈ G derive (-a/n, -b/n) ∈ G.
    have hG_neg : ∀ a b : ℤ, ((a : ℝ) / n, (b : ℝ) / n) ∈ G →
        (((-a : ℤ) : ℝ) / n, ((-b : ℤ) : ℝ) / n) ∈ G := by
      intro a b hab
      have h_in_H : ((a : ZMod n), (b : ZMod n)) ∈ H := (hG_int_iff a b).mp hab
      apply (hG_int_iff (-a) (-b)).mpr
      have : (((-a : ℤ) : ZMod n), ((-b : ℤ) : ZMod n)) =
              -((a : ZMod n), (b : ZMod n)) := by
        ext
        · push_cast; simp
        · push_cast; simp
      rw [this]; exact H.neg_mem h_in_H
    -- Step 2: WLOG ij'.1 ≥ 0.
    -- Helper proof for the j bound and the (|j| < 1/α + β/α·|i|) bound — works for either sign.
    -- From h_bound + |ij'.2| ≤ βn, derive α·|j| < 1 + β·|i|.
    have h_j_alpha_bound : α * |(ij'.2 : ℝ)| < 1 + β * |(ij'.1 : ℝ)| := by
      -- β·|i| + α·|j| - 2/n·|i||j| < 1
      -- α·|j| < 1 - β·|i| + 2/n·|i||j|
      -- α·|j| - β·|i| < 1 + 2·|i|·(|j|/n - β); and |j| ≤ βn, so |j|/n ≤ β.
      have h_abs_i_nn : (0 : ℝ) ≤ |(ij'.1 : ℝ)| := abs_nonneg _
      have h_jn_le_β : |(ij'.2 : ℝ)| / n ≤ β := by
        rw [div_le_iff₀ hn_pos]; linarith [hij'_β]
      -- Equivalently: 2/n · |i| · |j| ≤ 2β · |i|.
      have h_key : 2 / (n : ℝ) * |(ij'.1 : ℝ)| * |(ij'.2 : ℝ)| ≤
                   2 * β * |(ij'.1 : ℝ)| := by
        have h_abs_j_nn : (0 : ℝ) ≤ |(ij'.2 : ℝ)| := abs_nonneg _
        have h_step : (2 / (n : ℝ)) * |(ij'.2 : ℝ)| ≤ 2 * β := by
          rw [div_mul_eq_mul_div]
          rw [div_le_iff₀ hn_pos]
          linarith [hij'_β]
        nlinarith [h_step, h_abs_i_nn]
      linarith [h_bound, h_key]
    -- Now the case split. The new (i, j) is (ij'.1, ij'.2) or (-ij'.1, -ij'.2)
    -- depending on sign of ij'.1.
    by_cases h_pos : 0 ≤ ij'.1
    swap
    · -- Case: ij'.1 < 0. Use (-ij'.1, -ij'.2).
      have h_neg_i : ij'.1 < 0 := by omega
      refine ⟨(-ij'.1, -ij'.2), ?_, ?_, by omega, ?_, ?_, ?_⟩
      · -- (-ij'.1, -ij'.2) ≠ (0, 0)
        intro h_eq
        apply hij'_ne
        ext
        · have h1 : (-ij'.1, -ij'.2).1 = (0 : ℤ × ℤ).1 := congr_arg Prod.fst h_eq
          simp at h1; omega
        · have h2 : (-ij'.1, -ij'.2).2 = (0 : ℤ × ℤ).2 := congr_arg Prod.snd h_eq
          simp at h2; omega
      · -- ((-ij'.1 : ℝ)/n, (-ij'.2 : ℝ)/n) ∈ G via G-negation.
        have := hG_neg ij'.1 ij'.2 hij'_G
        convert this using 2 <;> push_cast <;> ring
      · -- (-ij'.1 : ℝ) < 1/β: strict, since |ij'.1| < 1/β.
        have h_i_abs : |(ij'.1 : ℝ)| = -(ij'.1 : ℝ) :=
          abs_of_neg (by exact_mod_cast h_neg_i)
        push_cast
        linarith [hij'_i_lt]
      · -- -1/α - β/α·(-ij'.1) < -ij'.2
        have h_α_pos : (0 : ℝ) < α := hα
        have h_i_abs : |(ij'.1 : ℝ)| = -(ij'.1 : ℝ) := abs_of_neg (by exact_mod_cast h_neg_i)
        have h_j_le : (ij'.2 : ℝ) ≤ |(ij'.2 : ℝ)| := le_abs_self _
        have h_α_j_le : α * (ij'.2 : ℝ) ≤ α * |(ij'.2 : ℝ)| :=
          mul_le_mul_of_nonneg_left h_j_le h_α_pos.le
        have h_total : α * (ij'.2 : ℝ) < 1 + β * (-(ij'.1 : ℝ)) := by
          rw [show β * (-(ij'.1 : ℝ)) = β * |(ij'.1 : ℝ)| from by rw [h_i_abs]]
          linarith [h_j_alpha_bound, h_α_j_le]
        have h_div : (ij'.2 : ℝ) < (1 + β * (-(ij'.1 : ℝ))) / α :=
          (lt_div_iff₀ h_α_pos).mpr (by linarith)
        have h_eq : (-1 : ℝ)/α - β/α * ((-ij'.1 : ℤ) : ℝ) =
                    -((1 + β * (-(ij'.1 : ℝ))) / α) := by
          push_cast; field_simp; ring
        push_cast at h_eq ⊢
        linarith [h_div, h_eq]
      · -- (-ij'.2 : ℝ) < 1/α + β/α·(-ij'.1)
        have h_α_pos : (0 : ℝ) < α := hα
        have h_i_abs : |(ij'.1 : ℝ)| = -(ij'.1 : ℝ) := abs_of_neg (by exact_mod_cast h_neg_i)
        have h_j_abs_ge : -(ij'.2 : ℝ) ≤ |(ij'.2 : ℝ)| := neg_le_abs _
        have h_α_j_lt : α * (-(ij'.2 : ℝ)) ≤ α * |(ij'.2 : ℝ)| :=
          mul_le_mul_of_nonneg_left h_j_abs_ge h_α_pos.le
        have h_total : α * (-(ij'.2 : ℝ)) < 1 + β * (-(ij'.1 : ℝ)) := by
          rw [show β * (-(ij'.1 : ℝ)) = β * |(ij'.1 : ℝ)| from by rw [h_i_abs]]
          linarith [h_j_alpha_bound, h_α_j_lt]
        have h_div : -(ij'.2 : ℝ) < (1 + β * (-(ij'.1 : ℝ))) / α :=
          (lt_div_iff₀ h_α_pos).mpr (by linarith)
        have h_eq : (1 : ℝ)/α + β/α * ((-ij'.1 : ℤ) : ℝ) =
                    (1 + β * (-(ij'.1 : ℝ))) / α := by
          push_cast; field_simp
        push_cast at h_eq ⊢
        linarith [h_div, h_eq]
    · -- Case: ij'.1 ≥ 0. Use (ij'.1, ij'.2).
      refine ⟨ij', hij'_ne, hij'_G, h_pos, ?_, ?_, ?_⟩
      · -- ij'.1 < 1/β: strict, since |ij'.1| < 1/β.
        have h_i_abs : |(ij'.1 : ℝ)| = (ij'.1 : ℝ) := abs_of_nonneg (by exact_mod_cast h_pos)
        linarith [hij'_i_lt]
      · -- -1/α - β/α·ij'.1 < ij'.2
        have h_α_pos : (0 : ℝ) < α := hα
        have h_i_abs : |(ij'.1 : ℝ)| = (ij'.1 : ℝ) := abs_of_nonneg (by exact_mod_cast h_pos)
        have h_j_abs_ge : -(ij'.2 : ℝ) ≤ |(ij'.2 : ℝ)| := neg_le_abs _
        have h_α_j_lt : α * (-(ij'.2 : ℝ)) ≤ α * |(ij'.2 : ℝ)| :=
          mul_le_mul_of_nonneg_left h_j_abs_ge h_α_pos.le
        have h_total : α * (-(ij'.2 : ℝ)) < 1 + β * (ij'.1 : ℝ) := by
          rw [← h_i_abs]; linarith [h_j_alpha_bound, h_α_j_lt]
        -- α · (-j) < 1 + β·i  ⟹  -j < (1 + β·i)/α  ⟹  j > -(1 + β·i)/α = -1/α - β/α·i
        have h_div : -(ij'.2 : ℝ) < (1 + β * (ij'.1 : ℝ)) / α :=
          (lt_div_iff₀ h_α_pos).mpr (by linarith)
        have h_eq : (-1 : ℝ)/α - β/α * (ij'.1 : ℝ) = -((1 + β * (ij'.1 : ℝ)) / α) := by
          field_simp; ring
        linarith [h_div, h_eq]
      · -- ij'.2 < 1/α + β/α·ij'.1
        have h_α_pos : (0 : ℝ) < α := hα
        have h_i_abs : |(ij'.1 : ℝ)| = (ij'.1 : ℝ) := abs_of_nonneg (by exact_mod_cast h_pos)
        have h_j_le : (ij'.2 : ℝ) ≤ |(ij'.2 : ℝ)| := le_abs_self _
        have h_α_j_le : α * (ij'.2 : ℝ) ≤ α * |(ij'.2 : ℝ)| :=
          mul_le_mul_of_nonneg_left h_j_le h_α_pos.le
        have h_total : α * (ij'.2 : ℝ) < 1 + β * (ij'.1 : ℝ) := by
          rw [← h_i_abs]; linarith [h_j_alpha_bound, h_α_j_le]
        have h_div : (ij'.2 : ℝ) < (1 + β * (ij'.1 : ℝ)) / α :=
          (lt_div_iff₀ h_α_pos).mpr (by linarith)
        have h_eq : (1 : ℝ)/α + β/α * (ij'.1 : ℝ) = (1 + β * (ij'.1 : ℝ)) / α := by
          field_simp
        linarith [h_div, h_eq]

end BHK
