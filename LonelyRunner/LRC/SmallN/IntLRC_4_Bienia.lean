import LonelyRunner.LRC.Defs
import LonelyRunner.LRC.SmallN.IntLRC_3

/-!
# Bienia et al. 1998 — proof of `intLRC 4`

Source: Bienia, Goddyn, Gvozdjak, Sebő, Tarsi (1998), "Flows, View
Obstructions and the Lonely Runner", JCTB 72:1-9, §3.

Their `k = 3` case = our `intLRC 4` (3 moving + observer, target gap 1/4).

This file builds up the proof in pieces:
1. **`intLRC_four_all_odd`** — if all three speeds are odd, `t = 1/2` works.
   (Fully proved.)
2. **`intLRC_four_pre_jump`** — TODO. If gcd of two speeds doesn't divide
   the third, reduce to `intLRC_three`.
3. **`intLRC_four_main`** — TODO. The T-interval connectedness argument
   under WLOG hypotheses.
4. **`intLRC_four_classical`** — combine 1–3.
-/

open MeasureTheory Set

/-- Periodicity of `Int.fract` under adding a natural-number cast. -/
private lemma fract_add_nat (x : ℝ) (n : ℕ) :
    Int.fract ((n : ℝ) + x) = Int.fract x :=
  Int.fract_natCast_add n x

/-- `circDist` is invariant under adding an integer. -/
private lemma circDist_add_int (x : ℝ) (n : ℤ) : circDist (x + (n : ℝ)) = circDist x := by
  unfold circDist
  rw [Int.fract_add_intCast]

/-- `circDist (1/2) = 1/2`. -/
private lemma circDist_half : circDist (1 / 2 : ℝ) = 1 / 2 := by
  unfold circDist
  have h_floor : ⌊(1 / 2 : ℝ)⌋ = 0 := Int.floor_eq_zero_iff.mpr (by norm_num)
  have h_fract : Int.fract (1 / 2 : ℝ) = 1 / 2 := by
    simp only [Int.fract, h_floor, Int.cast_zero, sub_zero]
  rw [h_fract]
  norm_num

/-- **Geometric core of the pre-jump shift.**
    Among the `m` equally spaced shifts `k/m` (`k : ℤ`), at least one places
    `y` into the closed distant arc `[1/4, 3/4]`, i.e. at `circDist ≥ 1/4`.
    Holds whenever `m ≥ 2`: consecutive shifts are `1/m ≤ 1/2` apart and the
    distant arc has width `1/2`, so no shift can "jump over" it.

    Concretely the witness is `k = ⌈m·(1/4 − y)⌉`, which forces
    `y + k/m ∈ [1/4, 1/4 + 1/m] ⊆ [1/4, 3/4]`. -/
lemma exists_shift_distant (m : ℕ) (hm : 2 ≤ m) (y : ℝ) :
    ∃ k : ℤ, circDist (y + (k : ℝ) / (m : ℝ)) ≥ (1 : ℝ) / 4 := by
  have hmR : (2 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
  have hm0 : (0 : ℝ) < (m : ℝ) := by linarith
  have hmne : (m : ℝ) ≠ 0 := ne_of_gt hm0
  have hinvm : (1 : ℝ) / (m : ℝ) ≤ 1 / 2 :=
    one_div_le_one_div_of_le (by norm_num) hmR
  refine ⟨⌈(m : ℝ) * (1 / 4 - y)⌉, ?_⟩
  set K : ℤ := ⌈(m : ℝ) * (1 / 4 - y)⌉ with hK
  have hk_lb : (m : ℝ) * (1 / 4 - y) ≤ (K : ℝ) := Int.le_ceil _
  have hk_ub : (K : ℝ) < (m : ℝ) * (1 / 4 - y) + 1 := Int.ceil_lt_add_one _
  -- Lower bound: 1/4 ≤ y + K/m.
  have hz_lb : (1 : ℝ) / 4 ≤ y + (K : ℝ) / (m : ℝ) := by
    have h : (1 / 4 - y) ≤ (K : ℝ) / (m : ℝ) :=
      (le_div_iff₀ hm0).mpr (by rw [mul_comm]; exact hk_lb)
    linarith
  -- Upper bound: y + K/m ≤ 3/4.
  have hz_ub : y + (K : ℝ) / (m : ℝ) ≤ 3 / 4 := by
    have h : (K : ℝ) / (m : ℝ) < (1 / 4 - y) + 1 / (m : ℝ) := by
      rw [div_lt_iff₀ hm0]
      have hid : ((1 / 4 - y) + 1 / (m : ℝ)) * (m : ℝ) = (m : ℝ) * (1 / 4 - y) + 1 := by
        field_simp
      rw [hid]; exact hk_ub
    linarith
  -- Conclude via circDist of a point already inside [1/4, 3/4].
  have hfr : Int.fract (y + (K : ℝ) / (m : ℝ)) = y + (K : ℝ) / (m : ℝ) :=
    Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩
  unfold circDist
  rw [hfr, ge_iff_le, le_min_iff]
  exact ⟨by linarith, by linarith⟩

/-- **Pre-jump shift, arbitrary multiplier.**
    If `d ≥ 2` and `d ∤ v`, some shift `v·K/d` (`K : ℤ`) places `y` into the
    distant arc `[1/4, 3/4]`.  The orbit `{v·K/d mod 1}` is the cyclic subgroup
    of `ℝ/ℤ` generated by `gcd(v,d)/d`, of order `d/gcd(v,d) ≥ 2`; combine
    `exists_shift_distant` (a distant point exists in any `≥2`-point equispaced
    set) with Bézout (the orbit reaches that point). -/
lemma exists_step_distant (v d : ℕ) (hd : 2 ≤ d) (hdvd : ¬ (d ∣ v)) (y : ℝ) :
    ∃ K : ℤ, circDist (y + (v : ℝ) * (K : ℝ) / (d : ℝ)) ≥ (1 : ℝ) / 4 := by
  have hd0 : 0 < d := by omega
  have he_pos : 0 < Nat.gcd v d := Nat.gcd_pos_of_pos_right v hd0
  set e : ℕ := Nat.gcd v d with he
  have he_dvd_d : e ∣ d := Nat.gcd_dvd_right v d
  have he_dvd_v : e ∣ v := Nat.gcd_dvd_left v d
  have he_ne_d : e ≠ d := fun h => hdvd (h ▸ he_dvd_v)
  have he_lt_d : e < d := lt_of_le_of_ne (Nat.le_of_dvd hd0 he_dvd_d) he_ne_d
  -- D := d / e is the order of the orbit; D ≥ 2.
  obtain ⟨mm, hmm⟩ := id he_dvd_d                  -- hmm : d = e * mm  (keep he_dvd_d)
  have hmm2 : 2 ≤ mm := by rcases mm with _ | _ | mm <;> omega
  set D : ℕ := d / e with hD
  have hD_eq : D = mm := by rw [hD, hmm, Nat.mul_div_cancel_left mm he_pos]
  have hD_ge2 : 2 ≤ D := by rw [hD_eq]; exact hmm2
  -- real-number bookkeeping
  set V : ℕ := v / e with hV
  have hveq : (e : ℝ) * (V : ℝ) = (v : ℝ) := by exact_mod_cast Nat.mul_div_cancel' he_dvd_v
  have hdeq : (e : ℝ) * (D : ℝ) = (d : ℝ) := by exact_mod_cast Nat.mul_div_cancel' he_dvd_d
  have heR : (e : ℝ) ≠ 0 := by exact_mod_cast he_pos.ne'
  have hDR : (D : ℝ) ≠ 0 := by exact_mod_cast (by omega : D ≠ 0)
  -- coprimality V, D in ℤ, then Bézout.
  have hcop : Nat.Coprime V D := Nat.coprime_div_gcd_div_gcd he_pos
  have hcopZ : IsCoprime (V : ℤ) (D : ℤ) := Nat.isCoprime_iff_coprime.mpr hcop
  obtain ⟨a, b, hab⟩ := hcopZ                       -- hab : a * V + b * D = 1
  have habR : (a : ℝ) * (V : ℝ) + (b : ℝ) * (D : ℝ) = 1 := by exact_mod_cast hab
  -- distant orbit point from the equispaced lemma
  obtain ⟨k₀, hk₀⟩ := exists_shift_distant D hD_ge2 y
  refine ⟨a * k₀, ?_⟩
  have hfinal :
      y + (v : ℝ) * ((a * k₀ : ℤ) : ℝ) / (d : ℝ)
        = (y + (k₀ : ℝ) / (D : ℝ)) + ((-(b * k₀) : ℤ) : ℝ) := by
    have h1 : (v : ℝ) * ((a * k₀ : ℤ) : ℝ) / (d : ℝ)
        = ((V : ℝ) * ((a * k₀ : ℤ) : ℝ)) / (D : ℝ) := by
      rw [← hveq, ← hdeq, mul_assoc, mul_div_mul_left _ _ heR]
    have hVa : (V : ℝ) * ((a * k₀ : ℤ) : ℝ) = (k₀ : ℝ) - (b : ℝ) * (k₀ : ℝ) * (D : ℝ) := by
      push_cast; linear_combination (k₀ : ℝ) * habR
    rw [h1, hVa]
    push_cast
    field_simp
    ring
  rw [hfinal, circDist_add_int]
  exact hk₀

/-- **Integer shift absorbs `a·K/d` when `d ∣ a`.**
    If `d ∣ a` (and `d ≠ 0`), then `a·K/d` is an integer for every `K : ℤ`,
    so adding it leaves `circDist` unchanged.  This is what keeps the *kept*
    pair `(a, b)` distant while the pre-jump shift fixes the dropped runner:
    `d = gcd(a,b)` divides both `a` and `b`. -/
lemma circDist_add_natMul_div (a d : ℕ) (hd : d ≠ 0) (hdvd : d ∣ a) (K : ℤ) (x : ℝ) :
    circDist (x + (a : ℝ) * (K : ℝ) / (d : ℝ)) = circDist x := by
  obtain ⟨m, hm⟩ := hdvd
  have hdR : (d : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hd
  have hstep : (a : ℝ) * (K : ℝ) / (d : ℝ) = (((m : ℤ) * K : ℤ) : ℝ) := by
    rw [hm]; push_cast; field_simp
  rw [hstep, circDist_add_int]

/-- **Two-runner witness, gap `1/3`, ordered coprime pair.**
    For coprime `p < q` (both positive) there is a time placing both runners
    in the distant arc at gap `1/3`.  This is exactly `intLRC 3` (two moving
    runners + observer), specialised to the explicit pair `![p, q]`. -/
lemma two_runner_third_ordered (p q : ℕ) (hp : 0 < p) (hpq : p < q)
    (hcop : Nat.Coprime p q) :
    ∃ t : ℝ, circDist ((p : ℝ) * t) ≥ (1 : ℝ) / 3 ∧ circDist ((q : ℝ) * t) ≥ (1 : ℝ) / 3 := by
  have hspeeds : StrictMono (![p, q] : Fin 2 → ℕ) := by
    intro i j hij; fin_cases i <;> fin_cases j <;> simp_all [Fin.lt_def]
  have hpos : ∀ i, 0 < (![p, q] : Fin 2 → ℕ) i := by
    rw [Fin.forall_fin_two]; exact ⟨hp, lt_trans hp hpq⟩
  have hgcd : Finset.gcd Finset.univ (![p, q] : Fin 2 → ℕ) = 1 := by
    rw [show (Finset.univ : Finset (Fin 2)) = {0, 1} from by decide,
        Finset.gcd_insert, Finset.gcd_singleton]
    simpa using hcop
  obtain ⟨t, ht⟩ := intLRC_three ![p, q] hspeeds hpos hgcd
  have h0 := ht 0; have h1 := ht 1
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Nat.cast_ofNat] at h0 h1
  exact ⟨t, h0, h1⟩

/-- **Two-runner witness, gap `1/4`, arbitrary distinct pair.**
    Divide the pair by `g = gcd(a,b)` to a coprime pair, apply
    `two_runner_third_ordered` (gap `1/3 ≥ 1/4`), and rescale time by `1/g`. -/
lemma two_runner_quarter (a b : ℕ) (ha : 0 < a) (hb : 0 < b) (hab : a ≠ b) :
    ∃ t : ℝ, circDist ((a : ℝ) * t) ≥ (1 : ℝ) / 4 ∧ circDist ((b : ℝ) * t) ≥ (1 : ℝ) / 4 := by
  have hg0 : 0 < Nat.gcd a b := Nat.gcd_pos_iff.mpr (Or.inl ha)
  have hgR : (Nat.gcd a b : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hg0.ne'
  have hcop : Nat.Coprime (a / Nat.gcd a b) (b / Nat.gcd a b) := Nat.coprime_div_gcd_div_gcd hg0
  have ha'0 : 0 < a / Nat.gcd a b := Nat.div_pos (Nat.le_of_dvd ha (Nat.gcd_dvd_left a b)) hg0
  have hb'0 : 0 < b / Nat.gcd a b := Nat.div_pos (Nat.le_of_dvd hb (Nat.gcd_dvd_right a b)) hg0
  have hae : (a : ℝ) = (a / Nat.gcd a b : ℕ) * (Nat.gcd a b : ℝ) := by
    rw [← Nat.cast_mul, Nat.div_mul_cancel (Nat.gcd_dvd_left a b)]
  have hbe : (b : ℝ) = (b / Nat.gcd a b : ℕ) * (Nat.gcd a b : ℝ) := by
    rw [← Nat.cast_mul, Nat.div_mul_cancel (Nat.gcd_dvd_right a b)]
  have ha'b' : a / Nat.gcd a b ≠ b / Nat.gcd a b := by
    intro h; apply hab
    have hreal : (a : ℝ) = (b : ℝ) := by rw [hae, hbe, h]
    exact_mod_cast hreal
  rcases lt_or_gt_of_ne ha'b' with hlt | hgt
  · obtain ⟨t', h1, h2⟩ := two_runner_third_ordered _ _ ha'0 hlt hcop
    refine ⟨t' / (Nat.gcd a b : ℝ), ?_, ?_⟩
    · rw [show (a : ℝ) * (t' / (Nat.gcd a b : ℝ)) = (a / Nat.gcd a b : ℕ) * t' from by
            rw [hae]; field_simp]; linarith
    · rw [show (b : ℝ) * (t' / (Nat.gcd a b : ℝ)) = (b / Nat.gcd a b : ℕ) * t' from by
            rw [hbe]; field_simp]; linarith
  · obtain ⟨t', h1, h2⟩ := two_runner_third_ordered _ _ hb'0 hgt hcop.symm
    refine ⟨t' / (Nat.gcd a b : ℝ), ?_, ?_⟩
    · rw [show (a : ℝ) * (t' / (Nat.gcd a b : ℝ)) = (a / Nat.gcd a b : ℕ) * t' from by
            rw [hae]; field_simp]; linarith
    · rw [show (b : ℝ) * (t' / (Nat.gcd a b : ℝ)) = (b / Nat.gcd a b : ℕ) * t' from by
            rw [hbe]; field_simp]; linarith

/-- **Pre-jump reduction (Bienia §3, step 2).**
    Keep the pair `(a, b)` with `d := gcd(a,b) ≥ 2`, drop `c` with `d ∤ c`.
    Take a base time `t₀` making `a, b` distant (`two_runner_quarter`), then
    shift by `K/d` chosen (`exists_step_distant`) so that `c` becomes distant
    too.  The shift moves `a, b` by `a·K/d, b·K/d`, both integers (`d ∣ a, b`),
    so they stay distant (`circDist_add_natMul_div`). -/
lemma pre_jump (a b c : ℕ) (ha : 0 < a) (hb : 0 < b) (hab : a ≠ b)
    (hd2 : 2 ≤ Nat.gcd a b) (hdvd : ¬ (Nat.gcd a b ∣ c)) :
    ∃ t : ℝ, circDist ((a : ℝ) * t) ≥ (1 : ℝ) / 4 ∧ circDist ((b : ℝ) * t) ≥ (1 : ℝ) / 4
           ∧ circDist ((c : ℝ) * t) ≥ (1 : ℝ) / 4 := by
  obtain ⟨t₀, ha₀, hb₀⟩ := two_runner_quarter a b ha hb hab
  obtain ⟨K, hK⟩ := exists_step_distant c (Nat.gcd a b) hd2 hdvd ((c : ℝ) * t₀)
  have hdne : Nat.gcd a b ≠ 0 := by omega
  refine ⟨t₀ + (K : ℝ) / (Nat.gcd a b : ℝ), ?_, ?_, ?_⟩
  · have he : (a : ℝ) * (t₀ + (K : ℝ) / (Nat.gcd a b : ℝ))
        = (a : ℝ) * t₀ + (a : ℝ) * (K : ℝ) / (Nat.gcd a b : ℝ) := by ring
    rw [he, circDist_add_natMul_div a (Nat.gcd a b) hdne (Nat.gcd_dvd_left a b) K ((a : ℝ) * t₀)]
    exact ha₀
  · have he : (b : ℝ) * (t₀ + (K : ℝ) / (Nat.gcd a b : ℝ))
        = (b : ℝ) * t₀ + (b : ℝ) * (K : ℝ) / (Nat.gcd a b : ℝ) := by ring
    rw [he, circDist_add_natMul_div b (Nat.gcd a b) hdne (Nat.gcd_dvd_right a b) K ((b : ℝ) * t₀)]
    exact hb₀
  · have he : (c : ℝ) * (t₀ + (K : ℝ) / (Nat.gcd a b : ℝ))
        = (c : ℝ) * t₀ + (c : ℝ) * (K : ℝ) / (Nat.gcd a b : ℝ) := by ring
    rw [he]; exact hK

/-- **Bienia §3 Step 1 — all-odd case.**
    If three positive distinct integer speeds are all odd, then `t = 1/2`
    is a witness (every runner is at distance `1/2 ≥ 1/4` from origin). -/
theorem intLRC_four_all_odd (speeds : Fin 3 → ℕ) (hodd : ∀ i, Odd (speeds i)) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 4 := by
  refine ⟨1 / 2, fun i => ?_⟩
  obtain ⟨k, hk⟩ := hodd i
  -- speeds i = 2k+1, so (speeds i : ℝ) * (1/2) = k + 1/2
  have hcast : (speeds i : ℝ) * (1 / 2) = (k : ℝ) + 1 / 2 := by
    have hnat : (speeds i : ℝ) = ((2 * k + 1 : ℕ) : ℝ) := by exact_mod_cast hk
    rw [hnat]
    push_cast
    ring
  rw [hcast]
  -- circDist((k : ℝ) + 1/2) = circDist(1/2) by periodicity
  have hperiod : circDist ((k : ℝ) + 1 / 2) = circDist (1 / 2 : ℝ) := by
    unfold circDist
    rw [fract_add_nat (1 / 2) k]
  rw [hperiod, circDist_half]
  norm_num

/-! ### Path B machinery — Bienia's T-interval connectedness argument

The pairwise-coprime, not-all-odd case has exactly one even speed `e` and two odd
speeds `o₁, o₂`.  Track `T = [1/(4e), 3/(4e)]`, the first interval on which runner `e`
is distant.  Either some `t ∈ T` has *neither* odd runner distant — then the `+1/2`
pre-jump makes all three distant — or `T ⊆ G(o₁) ∪ G(o₂)`, and connectedness of `T`
with closedness of the good-sets forces a common point `t ∈ T ∩ G(o₁) ∩ G(o₂)`. -/

private theorem circDist_le_abs_sub_int (x : ℝ) (m : ℤ) : circDist x ≤ |x - (m : ℝ)| := by
  rw [circDist_eq_infDist, ← Real.dist_eq]; exact Metric.infDist_le_dist_of_mem ⟨m, rfl⟩

/-- Any closed interval of length `> 1/2` contains a point within `1/4` of an integer. -/
theorem bad_point_of_long (α L : ℝ) (hL : 1 / 2 < L) :
    ∃ s ∈ Set.Icc α (α + L), circDist s < 1 / 4 := by
  obtain ⟨m, hm_lo, hm_hi⟩ : ∃ m : ℤ, α - 1 / 4 < (m : ℝ) ∧ (m : ℝ) ≤ α + 3 / 4 := by
    refine ⟨⌊α - 1 / 4⌋ + 1, ?_, ?_⟩
    · push_cast; linarith [Int.lt_floor_add_one (α - 1 / 4)]
    · push_cast; linarith [Int.floor_le (α - 1 / 4)]
  rcases le_or_gt α (m : ℝ) with hαm | hαm
  · rcases le_or_gt (m : ℝ) (α + L) with hmL | hmL
    · refine ⟨(m : ℝ), ⟨hαm, hmL⟩, ?_⟩
      have : circDist (m : ℝ) = 0 := by unfold circDist; rw [Int.fract_intCast]; simp
      rw [this]; norm_num
    · refine ⟨α + L, ⟨by linarith, le_refl _⟩, ?_⟩
      calc circDist (α + L) ≤ |(α + L) - (m : ℝ)| := circDist_le_abs_sub_int (α + L) m
        _ = (m : ℝ) - (α + L) := by rw [abs_of_nonpos (by linarith)]; ring
        _ < 1 / 4 := by linarith
  · refine ⟨α, ⟨le_refl _, by linarith⟩, ?_⟩
    calc circDist α ≤ |α - (m : ℝ)| := circDist_le_abs_sub_int α m
      _ = α - (m : ℝ) := by rw [abs_of_nonneg (by linarith)]
      _ < 1 / 4 := by linarith

/-- On the even runner's first-distant interval `T`, any *other* runner `v_o ≠ vₑ`
    fails to be distant somewhere: `T ⊄ goodSet v_o 4`. -/
theorem T_has_bad_point (v_e v_o : ℕ) (hve : 0 < v_e) (hvo : 0 < v_o) (hne : v_o ≠ v_e) :
    ∃ t ∈ Set.Icc (1 / (4 * (v_e : ℝ))) (3 / (4 * (v_e : ℝ))),
      circDist ((v_o : ℝ) * t) < 1 / 4 := by
  have hveR : (0 : ℝ) < (v_e : ℝ) := by exact_mod_cast hve
  have hvoR : (0 : ℝ) < (v_o : ℝ) := by exact_mod_cast hvo
  rcases lt_or_gt_of_ne hne with hlt | hgt
  · have hvolt : (v_o : ℝ) < (v_e : ℝ) := by exact_mod_cast hlt
    refine ⟨1 / (4 * (v_e : ℝ)), ⟨le_refl _, by gcongr; norm_num⟩, ?_⟩
    rw [show (v_o : ℝ) * (1 / (4 * (v_e : ℝ))) = (v_o : ℝ) / (4 * (v_e : ℝ)) from by ring]
    set x := (v_o : ℝ) / (4 * (v_e : ℝ)) with hx
    have hx0 : 0 < x := by rw [hx]; positivity
    have hx14 : x < 1 / 4 := by rw [hx, div_lt_iff₀ (by positivity)]; linarith
    unfold circDist
    rw [Int.fract_eq_self.mpr ⟨le_of_lt hx0, by linarith⟩, min_eq_left (by linarith)]; exact hx14
  · have hvogt : (v_e : ℝ) < (v_o : ℝ) := by exact_mod_cast hgt
    have hLgt : 1 / 2 < (v_o : ℝ) / (2 * (v_e : ℝ)) := by rw [lt_div_iff₀ (by positivity)]; linarith
    obtain ⟨s, hs_mem, hs_bad⟩ :=
      bad_point_of_long ((v_o : ℝ) / (4 * (v_e : ℝ))) ((v_o : ℝ) / (2 * (v_e : ℝ))) hLgt
    obtain ⟨hs_lo, hs_hi⟩ := hs_mem
    refine ⟨s / (v_o : ℝ), ⟨?_, ?_⟩, ?_⟩
    · rw [le_div_iff₀ hvoR,
        show 1 / (4 * (v_e : ℝ)) * (v_o : ℝ) = (v_o : ℝ) / (4 * (v_e : ℝ)) from by ring]
      exact hs_lo
    · rw [div_le_iff₀ hvoR, show 3 / (4 * (v_e : ℝ)) * (v_o : ℝ)
        = (v_o : ℝ) / (4 * (v_e : ℝ)) + (v_o : ℝ) / (2 * (v_e : ℝ)) from by ring]
      exact hs_hi
    · rw [mul_div_cancel₀ s (ne_of_gt hvoR)]; exact hs_bad

/-- On `T = [1/(4vₑ), 3/(4vₑ)]` the runner with speed `vₑ` is distant. -/
theorem even_runner_distant_on_T (v_e : ℕ) (hve : 0 < v_e) (t : ℝ)
    (ht : t ∈ Set.Icc (1 / (4 * (v_e : ℝ))) (3 / (4 * (v_e : ℝ)))) :
    circDist ((v_e : ℝ) * t) ≥ 1 / 4 := by
  have hveR : (0 : ℝ) < (v_e : ℝ) := by exact_mod_cast hve
  obtain ⟨hlo, hhi⟩ := ht
  have hne : (v_e : ℝ) ≠ 0 := ne_of_gt hveR
  have key1 : (v_e : ℝ) * (1 / (4 * (v_e : ℝ))) = 1 / 4 := by field_simp
  have key2 : (v_e : ℝ) * (3 / (4 * (v_e : ℝ))) = 3 / 4 := by field_simp
  have h1 : (1 : ℝ) / 4 ≤ (v_e : ℝ) * t := by
    calc (1 : ℝ) / 4 = (v_e : ℝ) * (1 / (4 * (v_e : ℝ))) := key1.symm
      _ ≤ (v_e : ℝ) * t := mul_le_mul_of_nonneg_left hlo (le_of_lt hveR)
  have h2 : (v_e : ℝ) * t ≤ 3 / 4 := by
    calc (v_e : ℝ) * t
        ≤ (v_e : ℝ) * (3 / (4 * (v_e : ℝ))) := mul_le_mul_of_nonneg_left hhi (le_of_lt hveR)
      _ = 3 / 4 := key2
  unfold circDist
  rw [Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩, ge_iff_le, le_min_iff]
  exact ⟨by linarith, by linarith⟩

/-- The `+1/2` pre-jump turns a *non-distant* point into a distant one. -/
theorem circDist_add_half_of_lt (y : ℝ) (hy : circDist y < 1 / 4) :
    circDist (y + 1 / 2) ≥ 1 / 4 := by
  rw [circDist] at hy
  have hf0 := Int.fract_nonneg y
  have hf1 := Int.fract_lt_one y
  rw [ge_iff_le, circDist]
  have hshift : Int.fract (y + 1 / 2) = Int.fract (Int.fract y + 1 / 2) := by
    conv_lhs => rw [← Int.floor_add_fract y]
    rw [show (↑⌊y⌋ + Int.fract y + 1 / 2 : ℝ) = (Int.fract y + 1 / 2) + ↑⌊y⌋ from by ring,
      Int.fract_add_intCast]
  rw [hshift]
  set f := Int.fract y with hfdef
  rcases lt_or_ge f (1 / 2) with hlt | hge
  · rw [Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩]
    have hf14 : f < 1 / 4 := by rw [min_eq_left (by linarith)] at hy; exact hy
    rw [le_min_iff]; constructor <;> linarith
  · have hfr : Int.fract (f + 1 / 2) = f - 1 / 2 := by
      rw [show f + 1 / 2 = (f - 1 / 2) + 1 from by ring, Int.fract_add_one,
        Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩]
    rw [hfr]
    have hf34 : 3 / 4 < f := by rw [min_eq_right (by linarith)] at hy; linarith
    rw [le_min_iff]; constructor <;> linarith

/-- An even-speed runner is invariant under the `+1/2` pre-jump. -/
theorem circDist_even_add_half (e : ℕ) (he : Even e) (t : ℝ) :
    circDist ((e : ℝ) * (t + 1 / 2)) = circDist ((e : ℝ) * t) := by
  obtain ⟨k, hk⟩ := he
  have hcast : (e : ℝ) * (t + 1 / 2) = (e : ℝ) * t + (k : ℝ) := by rw [hk]; push_cast; ring
  rw [hcast]; unfold circDist; simp only [Int.fract_add_natCast]

/-- An odd-speed runner under the `+1/2` pre-jump shifts its phase by exactly `1/2`. -/
theorem circDist_odd_add_half (o : ℕ) (ho : Odd o) (t : ℝ) :
    circDist ((o : ℝ) * (t + 1 / 2)) = circDist ((o : ℝ) * t + 1 / 2) := by
  obtain ⟨k, hk⟩ := ho
  have hcast : (o : ℝ) * (t + 1 / 2) = ((o : ℝ) * t + 1 / 2) + (k : ℝ) := by
    rw [hk]; push_cast; ring
  rw [hcast]; unfold circDist; simp only [Int.fract_add_natCast]

/-- **Bienia §3 core (Path B).** Even runner `e`, odd runners `o1, o2`, both distinct
    from `e`. The witness comes either directly from `T ∩ G(o1) ∩ G(o2)` (connectedness)
    or from the `+1/2` pre-jump of a point where neither odd runner is distant. -/
theorem pathB_core (e o1 o2 : ℕ) (hpe : 0 < e) (hpo1 : 0 < o1) (hpo2 : 0 < o2)
    (he : Even e) (ho1 : Odd o1) (ho2 : Odd o2) (h1e : o1 ≠ e) (h2e : o2 ≠ e) :
    ∃ t : ℝ, circDist ((e : ℝ) * t) ≥ 1 / 4 ∧ circDist ((o1 : ℝ) * t) ≥ 1 / 4 ∧
      circDist ((o2 : ℝ) * t) ≥ 1 / 4 := by
  set T := Set.Icc (1 / (4 * (e : ℝ))) (3 / (4 * (e : ℝ))) with hT
  have getlt : ∀ (v : ℕ) (s : ℝ), s ∉ goodSet v 4 → circDist ((v : ℝ) * s) < 1 / 4 := by
    intro v s hs; rw [goodSet, Set.mem_setOf_eq] at hs; push_cast at hs; exact not_le.mp hs
  have getge : ∀ (v : ℕ) (s : ℝ), s ∈ goodSet v 4 → circDist ((v : ℝ) * s) ≥ 1 / 4 := by
    intro v s hs; rw [goodSet, Set.mem_setOf_eq] at hs; push_cast at hs; exact hs
  by_cases hsub : T ⊆ goodSet o1 4 ∪ goodSet o2 4
  · have hG1ne : (T ∩ goodSet o1 4).Nonempty := by
      by_contra hempty
      rw [Set.not_nonempty_iff_eq_empty] at hempty
      have hTG2 : T ⊆ goodSet o2 4 := fun x hx => (hsub hx).resolve_left
        (fun h => Set.notMem_empty x (hempty ▸ Set.mem_inter hx h))
      obtain ⟨t, htT, htbad⟩ := T_has_bad_point e o2 hpe hpo2 h2e
      exact absurd (getge o2 t (hTG2 htT)) (not_le.mpr htbad)
    have hG2ne : (T ∩ goodSet o2 4).Nonempty := by
      by_contra hempty
      rw [Set.not_nonempty_iff_eq_empty] at hempty
      have hTG1 : T ⊆ goodSet o1 4 := fun x hx => (hsub hx).resolve_right
        (fun h => Set.notMem_empty x (hempty ▸ Set.mem_inter hx h))
      obtain ⟨t, htT, htbad⟩ := T_has_bad_point e o1 hpe hpo1 h1e
      exact absurd (getge o1 t (hTG1 htT)) (not_le.mpr htbad)
    have hpre : IsPreconnected T := isPreconnected_Icc
    obtain ⟨t, htT, ht1, ht2⟩ := (isPreconnected_closed_iff.mp hpre) (goodSet o1 4) (goodSet o2 4)
      (goodSet_isClosed o1 4) (goodSet_isClosed o2 4) hsub hG1ne hG2ne
    exact ⟨t, even_runner_distant_on_T e hpe t htT, getge o1 t ht1, getge o2 t ht2⟩
  · rw [Set.not_subset] at hsub
    obtain ⟨t, htT, htnotin⟩ := hsub
    rw [Set.mem_union, not_or] at htnotin
    obtain ⟨hn1, hn2⟩ := htnotin
    refine ⟨t + 1 / 2, ?_, ?_, ?_⟩
    · rw [circDist_even_add_half e he t]; exact even_runner_distant_on_T e hpe t htT
    · rw [circDist_odd_add_half o1 ho1 t]; exact circDist_add_half_of_lt _ (getlt o1 t hn1)
    · rw [circDist_odd_add_half o2 ho2 t]; exact circDist_add_half_of_lt _ (getlt o2 t hn2)

/-- **Bienia §3 — not-all-odd case.**
    Case split on pairwise coprimality of the three speeds.

    * **Some pair non-coprime.**  Say `d := gcd(sᵢ, sⱼ) ≥ 2`.  Since the three
      speeds have overall gcd `1`, `d` cannot divide the remaining speed `sₖ`
      (else `d ∣ gcd = 1`).  So `pre_jump` applies: solve `{sᵢ, sⱼ}` at gap
      `1/4` via `intLRC 3`, then shift `sₖ` into the distant arc while keeping
      `sᵢ, sⱼ` fixed.  **(Path A — fully proved.)**

    * **Pairwise coprime.**  Then at most one speed is even; not-all-odd forces
      exactly one even speed, and Bienia's T-interval connectedness argument
      produces the witness.  **(Path B — `sorry`, the residual hard core.)** -/
theorem intLRC_four_not_all_odd (speeds : Fin 3 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i) (hgcd : Finset.gcd Finset.univ speeds = 1)
    (hnotodd : ¬ ∀ i, Odd (speeds i)) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 4 := by
  set s0 := speeds ⟨0, by omega⟩
  set s1 := speeds ⟨1, by omega⟩
  set s2 := speeds ⟨2, by omega⟩
  have hp0 : 0 < s0 := hpos _
  have hp1 : 0 < s1 := hpos _
  have hp2 : 0 < s2 := hpos _
  have h01 : s0 < s1 := hmono (Fin.mk_lt_mk.mpr (by norm_num))
  have h02 : s0 < s2 := hmono (Fin.mk_lt_mk.mpr (by norm_num))
  have h12 : s1 < s2 := hmono (Fin.mk_lt_mk.mpr (by norm_num))
  -- Any common divisor of all three speeds divides the overall gcd = 1.
  have hcommon : ∀ d : ℕ, d ∣ s0 → d ∣ s1 → d ∣ s2 → d ∣ 1 := by
    intro d hd0 hd1 hd2
    have hdg : d ∣ Finset.gcd Finset.univ speeds := by
      apply Finset.dvd_gcd
      intro i _; fin_cases i
      · exact hd0
      · exact hd1
      · exact hd2
    rwa [hgcd] at hdg
  -- Assemble a 3-conjunction witness into the `∀ i` goal.
  have mk : ∀ t : ℝ, circDist ((s0 : ℝ) * t) ≥ 1 / 4 → circDist ((s1 : ℝ) * t) ≥ 1 / 4 →
      circDist ((s2 : ℝ) * t) ≥ 1 / 4 →
      ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 4 := by
    intro t q0 q1 q2
    refine ⟨t, fun i => ?_⟩
    fin_cases i
    · exact q0
    · exact q1
    · exact q2
  by_cases h01c : Nat.Coprime s0 s1
  · by_cases h02c : Nat.Coprime s0 s2
    · by_cases h12c : Nat.Coprime s1 s2
      · -- All pairwise coprime ⇒ exactly one even speed; Bienia's T-interval argument.
        -- Coprimality forbids two even speeds, so the even one's partners are odd.
        have other_odd : ∀ a b : ℕ, Nat.Coprime a b → Even a → Odd b := by
          intro a b hcop ha
          rw [← Nat.not_even_iff_odd]
          intro hb
          have hdvd : 2 ∣ Nat.gcd a b := Nat.dvd_gcd ha.two_dvd hb.two_dvd
          have hce : Nat.gcd a b = 1 := hcop
          omega
        -- Not-all-odd ⇒ at least one even speed.
        have heven_or : Even s0 ∨ Even s1 ∨ Even s2 := by
          by_contra h
          simp only [not_or] at h
          obtain ⟨hno0, hno1, hno2⟩ := h
          rw [Nat.not_even_iff_odd] at hno0 hno1 hno2
          refine hnotodd (fun i => ?_)
          fin_cases i
          · exact hno0
          · exact hno1
          · exact hno2
        rcases heven_or with he0 | he1 | he2
        · -- s0 even; s1, s2 odd
          have ho1 : Odd s1 := other_odd s0 s1 h01c he0
          have ho2 : Odd s2 := other_odd s0 s2 h02c he0
          obtain ⟨t, pe, p1, p2⟩ := pathB_core s0 s1 s2 hp0 hp1 hp2 he0 ho1 ho2 h01.ne' h02.ne'
          exact mk t pe p1 p2
        · -- s1 even; s0, s2 odd
          have ho0 : Odd s0 := other_odd s1 s0 h01c.symm he1
          have ho2 : Odd s2 := other_odd s1 s2 h12c he1
          obtain ⟨t, pe, p0, p2⟩ := pathB_core s1 s0 s2 hp1 hp0 hp2 he1 ho0 ho2 h01.ne h12.ne'
          exact mk t p0 pe p2
        · -- s2 even; s0, s1 odd
          have ho0 : Odd s0 := other_odd s2 s0 h02c.symm he2
          have ho1 : Odd s1 := other_odd s2 s1 h12c.symm he2
          obtain ⟨t, pe, p0, p1⟩ := pathB_core s2 s0 s1 hp2 hp0 hp1 he2 ho0 ho1 h02.ne h12.ne
          exact mk t p0 p1 pe
      · -- ¬ Coprime s1 s2: pre-jump keeping (s1, s2), dropping s0.
        have hd2 : 2 ≤ Nat.gcd s1 s2 := by
          have hpos12 : 0 < Nat.gcd s1 s2 := Nat.gcd_pos_iff.mpr (Or.inl hp1)
          have hne12 : Nat.gcd s1 s2 ≠ 1 := h12c
          omega
        have hnd : ¬ (Nat.gcd s1 s2 ∣ s0) := by
          intro hdvd0
          have hdo : Nat.gcd s1 s2 ∣ 1 :=
            hcommon _ hdvd0 (Nat.gcd_dvd_left s1 s2) (Nat.gcd_dvd_right s1 s2)
          have hg1 : Nat.gcd s1 s2 = 1 := Nat.dvd_one.mp hdo
          omega
        obtain ⟨t, p1, p2, p0⟩ := pre_jump s1 s2 s0 hp1 hp2 h12.ne hd2 hnd
        exact mk t p0 p1 p2
    · -- ¬ Coprime s0 s2: pre-jump keeping (s0, s2), dropping s1.
      have hd2 : 2 ≤ Nat.gcd s0 s2 := by
        have hpos02 : 0 < Nat.gcd s0 s2 := Nat.gcd_pos_iff.mpr (Or.inl hp0)
        have hne02 : Nat.gcd s0 s2 ≠ 1 := h02c
        omega
      have hnd : ¬ (Nat.gcd s0 s2 ∣ s1) := by
        intro hdvd1
        have hdo : Nat.gcd s0 s2 ∣ 1 :=
          hcommon _ (Nat.gcd_dvd_left s0 s2) hdvd1 (Nat.gcd_dvd_right s0 s2)
        have hg1 : Nat.gcd s0 s2 = 1 := Nat.dvd_one.mp hdo
        omega
      obtain ⟨t, p0, p2, p1⟩ := pre_jump s0 s2 s1 hp0 hp2 h02.ne hd2 hnd
      exact mk t p0 p1 p2
  · -- ¬ Coprime s0 s1: pre-jump keeping (s0, s1), dropping s2.
    have hd2 : 2 ≤ Nat.gcd s0 s1 := by
      have hpos01 : 0 < Nat.gcd s0 s1 := Nat.gcd_pos_iff.mpr (Or.inl hp0)
      have hne01 : Nat.gcd s0 s1 ≠ 1 := h01c
      omega
    have hnd : ¬ (Nat.gcd s0 s1 ∣ s2) := by
      intro hdvd2
      have hdo : Nat.gcd s0 s1 ∣ 1 :=
        hcommon _ (Nat.gcd_dvd_left s0 s1) (Nat.gcd_dvd_right s0 s1) hdvd2
      have hg1 : Nat.gcd s0 s1 = 1 := Nat.dvd_one.mp hdo
      omega
    obtain ⟨t, p0, p1, p2⟩ := pre_jump s0 s1 s2 hp0 hp1 h01.ne hd2 hnd
    exact mk t p0 p1 p2
