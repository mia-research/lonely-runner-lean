import LonelyRunner.LRC.SmallN.IntLRC_6_BHK_Lemma4
import LonelyRunner.LRC.SmallN.IntLRC_6_BHK_MainLemma

/-!
# BHK §§2+7 — the generic case (`3 v_1 < v_3`, both fracts nonzero)

Infrastructure for `bhk_case_v1_small_generic` (stated in
`IntLRC_6_BHK_Cases.lean`). The argument (BHK §2 extended by §7):

Let `d := v_3 - v_2`, `t_0 := 1/d` (the meeting period of runners 2 and 3),
and let `G ⊆ T = (ℝ/ℤ)²` be the cyclic subgroup generated by
`({v_3 t_0}, {v_1 t_0})`. With `g := gcd(d, v_3, v_1)`, `n := d / g`,
`c_3 := v_3 / g`, `c_1 := v_1 / g`, the group `G` is the `IsBHKLift` of
`H := ⟨(c_3, c_1)⟩ ⊆ (ZMod n)²`, which has order exactly `n`
(`gcd(n, c_3, c_1) = 1`).

A point of `G` in the parallelogram `P` of BHK (8)–(9) corresponds to a
meeting time `τ = k/d` whose surrounding 3-gap is a full 123-gap of length
`2/(3 v_3)`; `bhk_corollary_5` then yields a lonely time. `P` contains the
rectangle `R = [1/6, 5/6] × [7/18, 11/18]` (width `2/3`, height `2/9`) for
every `v_1 ≤ v_3 / 3`, so `bhk_corollary_6` (with `α = 2/3`, `β = 2/9`,
valid for `n ≥ 7`) either hits `R` or produces an exceptional minimal pair
`(i, j)`.

* `bhk_fract_translate`      — `{v(τ+δ)} = {vτ} + vδ` when no wraparound
* `bhk_fract_window`         — rectangle fract-condition → interval bounds
* `bhk_fract_nat_div`        — `{a/n} = (a % n)/n`
* `bhk_s7_window_lonely`     — the bridge: window conditions at `τ` → lonely time
* `bhkS7Group`               — the explicit lift of `⟨(c_3, c_1)⟩`
* `bhk_s7_card`              — `|⟨(c_3, c_1)⟩| = n` when `gcd(n, c_3, c_1) = 1`
* `bhk_s7_lift`              — `IsBHKLift (bhkS7Group n c₃ c₁) n`
* `bhk_s7_extract`           — `p ∈ bhkS7Group` → fract coords are `{c·k/n}`
* `bhk_s7_exceptional`       — Tables 9/10 + `G_4`/`G_7` (OPEN, sorry)
* `bhk_s7_small_n`           — ad hoc `2 ≤ n ≤ 6` analysis (OPEN, sorry)
* `bhk_s7_main`              — assembly, called from `IntLRC_6_BHK_Cases.lean`

## Source

T. Bohman, R. Holzman, D. Kleitman, *Six Lonely Runners*, EJC **8** (2001)
R3, §2 and §7.
-/

open MeasureTheory Set

namespace BHK

/-! ## Fract helpers -/

/-- **No-wraparound fract translation.** If `{vτ} + vδ` stays in `[0, 1)`
    then `{v(τ+δ)} = {vτ} + vδ`. -/
lemma bhk_fract_translate (v τ δ : ℝ)
    (h0 : 0 ≤ Int.fract (v * τ) + v * δ)
    (h1 : Int.fract (v * τ) + v * δ < 1) :
    Int.fract (v * (τ + δ)) = Int.fract (v * τ) + v * δ := by
  have hsplit : v * (τ + δ) = (⌊v * τ⌋ : ℝ) + (Int.fract (v * τ) + v * δ) := by
    have h : Int.fract (v * τ) + ⌊v * τ⌋ = v * τ := Int.fract_add_floor (v * τ)
    nlinarith [h]
  rw [hsplit, Int.fract_intCast_add, Int.fract_eq_self.mpr ⟨h0, h1⟩]

/-- **Rectangle fract-condition to interval bounds.** For `ρ ∈ [0, 1)` and
    an anchored window `[c, c + L]` with `c ≥ 0`, `c + L < 1`:
    `{ρ - c} ≤ L` forces `c ≤ ρ ≤ c + L`. -/
lemma bhk_fract_window (ρ c L : ℝ) (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1)
    (hc : 0 ≤ c) (hcL : c + L < 1) (h : Int.fract (ρ - c) ≤ L) :
    c ≤ ρ ∧ ρ ≤ c + L := by
  have hL0 : 0 ≤ L := le_trans (Int.fract_nonneg _) h
  by_cases hge : c ≤ ρ
  · have hin : Int.fract (ρ - c) = ρ - c :=
      Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩
    rw [hin] at h
    exact ⟨hge, by linarith⟩
  · -- ρ < c: then ρ - c ∈ (-1, 0), so {ρ - c} = ρ - c + 1 ≤ L gives ρ < 0.
    exfalso
    have hlt : ρ < c := not_le.mp hge
    have hin : Int.fract (ρ - c) = ρ - c + 1 := by
      have h1 : Int.fract (ρ - c) = Int.fract (ρ - c + 1) :=
        (Int.fract_add_one _).symm
      rw [h1, Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩]
    rw [hin] at h
    linarith

/-- **Fract of a rational with natural numerator.** For naturals `a`, `n`
    with `0 < n`: `{a/n} = (a % n)/n`. -/
lemma bhk_fract_nat_div (a n : ℕ) (hn : 0 < n) :
    Int.fract ((a : ℝ) / n) = ((a % n : ℕ) : ℝ) / n := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hdecomp : (a : ℝ) / n = ((a % n : ℕ) : ℝ) / n + ((a / n : ℕ) : ℤ) := by
    have h : (a : ℝ) = ((a % n : ℕ) : ℝ) + ((a / n : ℕ) : ℝ) * n := by
      exact_mod_cast (Nat.mod_add_div' a n).symm
    have h2 : (((a / n : ℕ) : ℤ) : ℝ) = ((a / n : ℕ) : ℝ) := Int.cast_natCast _
    rw [h2, h]
    field_simp
  rw [hdecomp, Int.fract_add_intCast, Int.fract_eq_self.mpr ⟨by positivity, by
    rw [div_lt_one hnR]
    exact_mod_cast Nat.mod_lt a hn⟩]

/-- **Fract-zero iff divides.** For naturals `a`, `d` with `0 < d`:
    `{a/d} = 0 ↔ d ∣ a`. -/
lemma bhk_fract_nat_div_eq_zero_iff (a d : ℕ) (hd : 0 < d) :
    Int.fract ((a : ℝ) / d) = 0 ↔ d ∣ a := by
  have hdR : (0 : ℝ) < d := by exact_mod_cast hd
  rw [bhk_fract_nat_div a d hd, div_eq_zero_iff]
  have hdne : ((d : ℝ)) ≠ 0 := ne_of_gt hdR
  simp only [hdne, or_false, Nat.cast_eq_zero]
  omega

/-! ## The bridge: torus window → lonely time -/

/-- **BHK §2 bridge.** If at time `τ` runners 2 and 3 share fractional
    position `u ∈ [1/6, 5/6]` and runner 1's fractional position `w`
    satisfies BHK condition (6),
    `1/6 + (u - 1/6)·v₁/v₃ ≤ w ≤ 5/6 - (5/6 - u)·v₁/v₃`,
    then the 3-gap around `τ` is a 123-gap of length `2/(3v₃)` and
    `bhk_corollary_5` produces a lonely time. -/
lemma bhk_s7_window_lonely (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i) (τ : ℝ)
    (hu_lo : 1/6 ≤ Int.fract ((speeds ⟨2, by omega⟩ : ℝ) * τ))
    (hu_hi : Int.fract ((speeds ⟨2, by omega⟩ : ℝ) * τ) ≤ 5/6)
    (h2eq : Int.fract ((speeds ⟨1, by omega⟩ : ℝ) * τ)
          = Int.fract ((speeds ⟨2, by omega⟩ : ℝ) * τ))
    (hw_lo : 1/6 + (Int.fract ((speeds ⟨2, by omega⟩ : ℝ) * τ) - 1/6) *
               (speeds ⟨0, by omega⟩ : ℝ) / (speeds ⟨2, by omega⟩ : ℝ)
             ≤ Int.fract ((speeds ⟨0, by omega⟩ : ℝ) * τ))
    (hw_hi : Int.fract ((speeds ⟨0, by omega⟩ : ℝ) * τ)
             ≤ 5/6 - (5/6 - Int.fract ((speeds ⟨2, by omega⟩ : ℝ) * τ)) *
               (speeds ⟨0, by omega⟩ : ℝ) / (speeds ⟨2, by omega⟩ : ℝ)) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 6 := by
  have hv1pos : (0 : ℝ) < speeds ⟨0, by omega⟩ := by exact_mod_cast hpos _
  have hv2pos : (0 : ℝ) < speeds ⟨1, by omega⟩ := by exact_mod_cast hpos _
  have hv3pos : (0 : ℝ) < speeds ⟨2, by omega⟩ := by exact_mod_cast hpos _
  have hv12 : (speeds ⟨0, by omega⟩ : ℝ) < (speeds ⟨1, by omega⟩ : ℝ) := by
    have : speeds ⟨0, by omega⟩ < speeds ⟨1, by omega⟩ := hmono (by decide)
    exact_mod_cast this
  have hv23 : (speeds ⟨1, by omega⟩ : ℝ) < (speeds ⟨2, by omega⟩ : ℝ) := by
    have : speeds ⟨1, by omega⟩ < speeds ⟨2, by omega⟩ := hmono (by decide)
    exact_mod_cast this
  set v1 : ℝ := (speeds ⟨0, by omega⟩ : ℝ) with hv1_def
  set v2 : ℝ := (speeds ⟨1, by omega⟩ : ℝ) with hv2_def
  set v3 : ℝ := (speeds ⟨2, by omega⟩ : ℝ) with hv3_def
  set u : ℝ := Int.fract (v3 * τ) with hu_def
  set w : ℝ := Int.fract (v1 * τ) with hw_def
  -- The 3-gap around τ.
  set a : ℝ := τ - (u - 1/6) / v3 with ha_def
  set b : ℝ := τ + (5/6 - u) / v3 with hb_def
  have hab : a ≤ b := by
    have h1 : 0 ≤ (u - 1/6) / v3 := div_nonneg (by linarith) hv3pos.le
    have h2 : 0 ≤ (5/6 - u) / v3 := div_nonneg (by linarith) hv3pos.le
    rw [ha_def, hb_def]; linarith
  refine bhk_corollary_5 speeds hmono hpos a b hab ?_ ?_
  · -- The 3-gap [a, b] is a 123-gap.
    intro s hs
    obtain ⟨hsa, hsb⟩ := Set.mem_Icc.mp hs
    have hδlo : -((u - 1/6) / v3) ≤ s - τ := by
      rw [ha_def] at hsa; linarith
    have hδhi : s - τ ≤ (5/6 - u) / v3 := by
      rw [hb_def] at hsb; linarith
    -- Uniform safety: a runner with speed v at fractional position ω at τ
    -- whose window condition (6) holds stays in [1/6, 5/6] across [a, b].
    have key : ∀ v ω : ℝ, 0 < v →
        Int.fract (v * τ) = ω →
        1/6 + (u - 1/6) * v / v3 ≤ ω →
        ω ≤ 5/6 - (5/6 - u) * v / v3 →
        1/6 ≤ Int.fract (v * s) ∧ Int.fract (v * s) ≤ 5/6 := by
      intro v ω hv hfr hlo hhi
      have hm_lo : -((u - 1/6) * v / v3) ≤ v * (s - τ) := by
        have h := mul_le_mul_of_nonneg_left hδlo hv.le
        rwa [show v * -((u - 1/6) / v3) = -((u - 1/6) * v / v3) from by ring] at h
      have hm_hi : v * (s - τ) ≤ (5/6 - u) * v / v3 := by
        have h := mul_le_mul_of_nonneg_left hδhi hv.le
        rwa [show v * ((5/6 - u) / v3) = (5/6 - u) * v / v3 from by ring] at h
      have h0 : 0 ≤ Int.fract (v * τ) + v * (s - τ) := by
        rw [hfr]; linarith
      have h1 : Int.fract (v * τ) + v * (s - τ) < 1 := by
        rw [hfr]; linarith
      have hfs : Int.fract (v * s) = ω + v * (s - τ) := by
        have h := bhk_fract_translate v τ (s - τ) h0 h1
        rw [show τ + (s - τ) = s from by ring, hfr] at h
        exact h
      rw [hfs]
      exact ⟨by linarith, by linarith⟩
    have hself : ∀ c : ℝ, c * v3 / v3 = c := fun c => by
      field_simp
    have k3 := key v3 u hv3pos hu_def.symm
      (by rw [hself]; linarith) (by rw [hself]; linarith)
    have k2 := key v2 u hv2pos h2eq
      (by
        have h : (u - 1/6) * v2 / v3 ≤ u - 1/6 := by
          rw [div_le_iff₀ hv3pos]
          nlinarith [mul_nonneg (show (0:ℝ) ≤ u - 1/6 by linarith)
            (show (0:ℝ) ≤ v3 - v2 by linarith)]
        linarith)
      (by
        have h : (5/6 - u) * v2 / v3 ≤ 5/6 - u := by
          rw [div_le_iff₀ hv3pos]
          nlinarith [mul_nonneg (show (0:ℝ) ≤ 5/6 - u by linarith)
            (show (0:ℝ) ≤ v3 - v2 by linarith)]
        linarith)
    have k1 := key v1 w hv1pos hw_def.symm hw_lo hw_hi
    rw [Set.mem_compl_iff]
    intro hmem
    have hsafe : ∀ x : ℝ, 1/6 ≤ Int.fract x → Int.fract x ≤ 5/6 →
        ¬ circDist x < 1/6 := by
      intro x hx1 hx2
      rw [not_lt]
      unfold circDist
      exact le_min hx1 (by linarith)
    rcases hmem with (h | h) | h
    · exact hsafe _ k1.1 k1.2 ((mem_unsafeOf_iff _ _ _).mp h)
    · exact hsafe _ k2.1 k2.2 ((mem_unsafeOf_iff _ _ _).mp h)
    · exact hsafe _ k3.1 k3.2 ((mem_unsafeOf_iff _ _ _).mp h)
  · -- Length: b - a = 2/(3 v₃).
    have hba : b - a = 2 / (3 * v3) := by
      rw [hb_def, ha_def]
      field_simp
      ring
    show 2 / (3 * v3) ≤ b - a
    rw [hba]

/-! ## The cyclic torus group and its lift -/

/-- The ℤ²-periodic lift of the cyclic subgroup `⟨(c₃, c₁)⟩ ⊆ (ZMod n)²`. -/
def bhkS7Group (n c₃ c₁ : ℕ) : Set (ℝ × ℝ) :=
  { p | ∃ h ∈ AddSubgroup.zmultiples ((c₃ : ZMod n), (c₁ : ZMod n)),
        ∃ i j : ℤ,
          p = (((h.1.val : ℝ) / n) + (i : ℝ), ((h.2.val : ℝ) / n) + (j : ℝ)) }

/-- **Order of the cyclic group.** If `gcd(n, gcd(c₃, c₁)) = 1` then
    `(c₃, c₁)` has additive order exactly `n` in `(ZMod n)²`, so its
    cyclic subgroup has cardinality `n`. -/
lemma bhk_s7_card (n c₃ c₁ : ℕ) (hn : 1 < n)
    (hg : Nat.gcd n (Nat.gcd c₃ c₁) = 1) :
    Nat.card (AddSubgroup.zmultiples ((c₃ : ZMod n), (c₁ : ZMod n))) = n := by
  have hn0 : n ≠ 0 := by omega
  rw [Nat.card_zmultiples, Prod.addOrderOf_mk,
      ZMod.addOrderOf_coe c₃ hn0, ZMod.addOrderOf_coe c₁ hn0]
  -- ⊢ (n / n.gcd c₃).lcm (n / n.gcd c₁) = n
  set a := n.gcd c₃ with ha_def
  set b := n.gcd c₁ with hb_def
  have ha : a ∣ n := Nat.gcd_dvd_left _ _
  have hb : b ∣ n := Nat.gcd_dvd_left _ _
  have hapos : 0 < a := Nat.gcd_pos_of_pos_left c₃ (by omega)
  have hbpos : 0 < b := Nat.gcd_pos_of_pos_left c₁ (by omega)
  have hab : Nat.Coprime a b := by
    have h1 : Nat.gcd a b ∣ n := (Nat.gcd_dvd_left a b).trans ha
    have h2 : Nat.gcd a b ∣ Nat.gcd c₃ c₁ :=
      Nat.dvd_gcd ((Nat.gcd_dvd_left a b).trans (Nat.gcd_dvd_right n c₃))
                  ((Nat.gcd_dvd_right a b).trans (Nat.gcd_dvd_right n c₁))
    have h3 := Nat.dvd_gcd h1 h2
    rw [hg] at h3
    exact Nat.dvd_one.mp h3
  obtain ⟨m, hm⟩ := Nat.Coprime.mul_dvd_of_dvd_of_dvd hab ha hb
  have hna : n / a = b * m := by
    rw [hm, mul_assoc, Nat.mul_div_cancel_left _ hapos]
  have hnb : n / b = a * m := by
    rw [hm, show a * b * m = b * (a * m) from by ring,
        Nat.mul_div_cancel_left _ hbpos]
  have hmpos : 0 < m := by
    rcases Nat.eq_zero_or_pos m with h0 | h
    · subst h0; simp at hm; omega
    · exact h
  have hgba : Nat.gcd b a = 1 := hab.symm
  rw [hna, hnb, Nat.lcm, Nat.gcd_mul_right, hgba, one_mul,
      show b * m * (a * m) = a * b * m * m from by ring,
      Nat.mul_div_cancel _ hmpos, hm]

/-- **`bhkS7Group` is a BHK lift.** -/
lemma bhk_s7_lift (n c₃ c₁ : ℕ) (hn : 1 < n)
    (hg : Nat.gcd n (Nat.gcd c₃ c₁) = 1) :
    IsBHKLift (bhkS7Group n c₃ c₁) n :=
  ⟨AddSubgroup.zmultiples ((c₃ : ZMod n), (c₁ : ZMod n)),
   bhk_s7_card n c₃ c₁ hn hg, fun _ => Iff.rfl⟩

/-- **Coordinate extraction.** Every point of `bhkS7Group n c₃ c₁` has
    fractional coordinates `({c₃ k / n}, {c₁ k / n})` for some `k : ℕ`. -/
lemma bhk_s7_extract (n c₃ c₁ : ℕ) (hn : 1 < n) (p : ℝ × ℝ)
    (hp : p ∈ bhkS7Group n c₃ c₁) :
    ∃ k : ℕ, Int.fract p.1 = Int.fract ((c₃ * k : ℕ) / (n : ℝ)) ∧
             Int.fract p.2 = Int.fract ((c₁ * k : ℕ) / (n : ℝ)) := by
  have hn0 : n ≠ 0 := by omega
  have hnpos : 0 < n := by omega
  have hnR : (0 : ℝ) < n := by exact_mod_cast hnpos
  haveI : NeZero n := ⟨hn0⟩
  obtain ⟨h, hh_mem, i, j, hp_eq⟩ := hp
  obtain ⟨z, hz⟩ := AddSubgroup.mem_zmultiples_iff.mp hh_mem
  -- Reduce the ℤ-multiple to a ℕ-multiple mod n.
  set k : ℕ := (z % (n : ℤ)).toNat with hk_def
  have hk_cast : ((k : ℕ) : ℤ) = z % (n : ℤ) :=
    Int.toNat_of_nonneg (Int.emod_nonneg z (by exact_mod_cast hn0))
  have hzk : ((z : ℤ) : ZMod n) = ((k : ℕ) : ZMod n) := by
    rw [show ((k : ℕ) : ZMod n) = (((k : ℕ) : ℤ) : ZMod n) from by push_cast; rfl,
        hk_cast, ZMod.intCast_mod]
  -- Componentwise identification of the group element.
  have hfst : h.1 = ((c₃ * k : ℕ) : ZMod n) := by
    have h1 : h.1 = z • (c₃ : ZMod n) := by rw [← hz]; simp
    rw [h1, zsmul_eq_mul, hzk]
    push_cast
    ring
  have hsnd : h.2 = ((c₁ * k : ℕ) : ZMod n) := by
    have h1 : h.2 = z • (c₁ : ZMod n) := by rw [← hz]; simp
    rw [h1, zsmul_eq_mul, hzk]
    push_cast
    ring
  -- Fract computations.
  have hval_fract : ∀ x : ZMod n, Int.fract ((x.val : ℝ) / n) = (x.val : ℝ) / n := by
    intro x
    refine Int.fract_eq_self.mpr ⟨by positivity, ?_⟩
    rw [div_lt_one hnR]
    exact_mod_cast ZMod.val_lt x
  refine ⟨k, ?_, ?_⟩
  · rw [hp_eq]
    show Int.fract ((h.1.val : ℝ) / n + (i : ℝ)) = _
    rw [Int.fract_add_intCast, hval_fract, bhk_fract_nat_div _ _ hnpos,
        hfst, ZMod.val_natCast]
  · rw [hp_eq]
    show Int.fract ((h.2.val : ℝ) / n + (j : ℝ)) = _
    rw [Int.fract_add_intCast, hval_fract, bhk_fract_nat_div _ _ hnpos,
        hsnd, ZMod.val_natCast]

/-! ## Open residuals -/

/-- **BHK §§2+7 exceptional pairs (OPEN).** When Corollary 6 returns a
    minimal pair `(i, j) ≠ (0, 0)` with `0 ≤ i < 9/2` and
    `-3/2 - i/3 < j < 3/2 + i/3` such that `(i/n, j/n) ∈ G`, conclude.

    BHK's treatment: `(0, ±1)` and `(1, 0)` are excluded by the axis
    hypotheses (`ht0`, `hv1t0`); `(2, 0)`, `(1, ±1)`, `(2, ±2)` are §2
    cases 2.1–2.3; ten further pairs go through circle-period counting
    (Table 9); `(2, ±1)` goes through Table 10, with the exceptional
    groups `G₄ = ⟨(1/2, 1/4)⟩` and `G₇ = ⟨(4/7, 2/7)⟩` handled by direct
    uncovered-interval arguments (`[2/3, 35/48]` resp. `[2/3, 65/84]`). -/
lemma bhk_s7_exceptional (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i) (hgcd : Finset.univ.gcd speeds = 1)
    (hsmall : 3 * speeds ⟨0, by omega⟩ < speeds ⟨2, by omega⟩)
    (n c₃ c₁ g : ℕ) (hn : 1 < n)
    (hgpos : 0 < g)
    (hd : g * n = speeds ⟨2, by omega⟩ - speeds ⟨1, by omega⟩)
    (hc3 : g * c₃ = speeds ⟨2, by omega⟩)
    (hc1 : g * c₁ = speeds ⟨0, by omega⟩)
    (hg1 : Nat.gcd n (Nat.gcd c₃ c₁) = 1)
    (hc3_ne : ¬ n ∣ c₃) (hc1_ne : ¬ n ∣ c₁)
    (ij : ℤ × ℤ) (hij_ne : ij ≠ (0, 0))
    (hij_mem : ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ bhkS7Group n c₃ c₁)
    (hi_lo : 0 ≤ ij.1) (hi_hi : (ij.1 : ℝ) < 1 / (2/9 : ℝ))
    (hj_lo : -1 / (2/3 : ℝ) - (2/9 : ℝ) / (2/3 : ℝ) * ij.1 < (ij.2 : ℝ))
    (hj_hi : (ij.2 : ℝ) < 1 / (2/3 : ℝ) + (2/9 : ℝ) / (2/3 : ℝ) * ij.1) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 6 := by
  sorry

/-- **BHK §§2+7 small group order (OPEN).** When `2 ≤ n ≤ 6` the rectangle
    `2/3 × 2/9` is too small for Corollary 6 (`αβ = 4/27 < 1/n`); handle
    by direct enumeration of the cyclic group `⟨(c₃/n, c₁/n)⟩` against the
    parallelogram `P` (both coordinates nonzero mod `n`, so e.g. `n = 2`
    gives `(1/2, 1/2) ∈ P` always). -/
lemma bhk_s7_small_n (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i) (hgcd : Finset.univ.gcd speeds = 1)
    (hsmall : 3 * speeds ⟨0, by omega⟩ < speeds ⟨2, by omega⟩)
    (n c₃ c₁ g : ℕ) (hn : 1 < n) (hn6 : n ≤ 6)
    (hgpos : 0 < g)
    (hd : g * n = speeds ⟨2, by omega⟩ - speeds ⟨1, by omega⟩)
    (hc3 : g * c₃ = speeds ⟨2, by omega⟩)
    (hc1 : g * c₁ = speeds ⟨0, by omega⟩)
    (hg1 : Nat.gcd n (Nat.gcd c₃ c₁) = 1)
    (hc3_ne : ¬ n ∣ c₃) (hc1_ne : ¬ n ∣ c₁) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 6 := by
  sorry

/-! ## Assembly -/

/-- **BHK §§2+7, master assembly.** Decomposes the generic case: build the
    torus group from `(c₃, c₁) = (v₃, v₁)/g mod n` with `n = (v₃ - v₂)/g`,
    apply Corollary 6 to the `2/3 × 2/9` rectangle when `n ≥ 7`, convert a
    rectangle hit into a lonely time via the §2 bridge, and dispatch the
    exceptional-pair and small-`n` branches to the dedicated lemmas. -/
theorem bhk_s7_main (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i) (hgcd : Finset.univ.gcd speeds = 1)
    (hsmall : 3 * speeds ⟨0, by omega⟩ < speeds ⟨2, by omega⟩)
    (ht0 : Int.fract ((speeds ⟨2, by omega⟩ : ℝ) *
              (1 / ((speeds ⟨2, by omega⟩ : ℝ) - speeds ⟨1, by omega⟩))) ≠ 0)
    (hv1t0 : Int.fract ((speeds ⟨0, by omega⟩ : ℝ) *
              (1 / ((speeds ⟨2, by omega⟩ : ℝ) - speeds ⟨1, by omega⟩))) ≠ 0) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 6 := by
  set V1 : ℕ := speeds ⟨0, by omega⟩ with hV1_def
  set V2 : ℕ := speeds ⟨1, by omega⟩ with hV2_def
  set V3 : ℕ := speeds ⟨2, by omega⟩ with hV3_def
  have hV23 : V2 < V3 := hmono (Fin.mk_lt_mk.mpr (by omega))
  have hV1pos : 0 < V1 := hpos _
  have hV3pos : 0 < V3 := hpos _
  set D : ℕ := V3 - V2 with hD_def
  have hDpos : 0 < D := by omega
  have hD_cast : ((D : ℕ) : ℝ) = (V3 : ℝ) - V2 := by
    rw [hD_def, Nat.cast_sub hV23.le]
  -- The axis hypotheses as divisibility statements.
  have hdvd3 : ¬ D ∣ V3 := by
    intro hdvd
    apply ht0
    rw [show (V3 : ℝ) * (1 / ((V3 : ℝ) - V2)) = (V3 : ℝ) / D from by
      rw [hD_cast]; ring]
    exact (bhk_fract_nat_div_eq_zero_iff V3 D hDpos).mpr hdvd
  have hdvd1 : ¬ D ∣ V1 := by
    intro hdvd
    apply hv1t0
    rw [show (V1 : ℝ) * (1 / ((V3 : ℝ) - V2)) = (V1 : ℝ) / D from by
      rw [hD_cast]; ring]
    exact (bhk_fract_nat_div_eq_zero_iff V1 D hDpos).mpr hdvd
  -- Reduced group data.
  set g : ℕ := Nat.gcd D (Nat.gcd V3 V1) with hg_def
  have hgpos : 0 < g := Nat.gcd_pos_of_pos_left _ hDpos
  have hgD : g ∣ D := Nat.gcd_dvd_left _ _
  have hgV3 : g ∣ V3 := (Nat.gcd_dvd_right _ _).trans (Nat.gcd_dvd_left V3 V1)
  have hgV1 : g ∣ V1 := (Nat.gcd_dvd_right _ _).trans (Nat.gcd_dvd_right V3 V1)
  set n : ℕ := D / g with hn_def
  set c₃ : ℕ := V3 / g with hc3_def
  set c₁ : ℕ := V1 / g with hc1_def
  have hgn : g * n = D := Nat.mul_div_cancel' hgD
  have hgc3 : g * c₃ = V3 := Nat.mul_div_cancel' hgV3
  have hgc1 : g * c₁ = V1 := Nat.mul_div_cancel' hgV1
  have hg1 : Nat.gcd n (Nat.gcd c₃ c₁) = 1 := by
    set e := Nat.gcd n (Nat.gcd c₃ c₁) with he_def
    have he_n : e ∣ n := Nat.gcd_dvd_left _ _
    have he_c3 : e ∣ c₃ := (Nat.gcd_dvd_right _ _).trans (Nat.gcd_dvd_left c₃ c₁)
    have he_c1 : e ∣ c₁ := (Nat.gcd_dvd_right _ _).trans (Nat.gcd_dvd_right c₃ c₁)
    have hge_D : g * e ∣ D := hgn ▸ mul_dvd_mul_left g he_n
    have hge_V3 : g * e ∣ V3 := hgc3 ▸ mul_dvd_mul_left g he_c3
    have hge_V1 : g * e ∣ V1 := hgc1 ▸ mul_dvd_mul_left g he_c1
    have hge_g : g * e ∣ g := by
      rw [hg_def]
      exact Nat.dvd_gcd hge_D (Nat.dvd_gcd hge_V3 hge_V1)
    have he1 : e ∣ 1 :=
      Nat.dvd_of_mul_dvd_mul_left hgpos (by rwa [mul_one g])
    exact Nat.dvd_one.mp he1
  have hnpos : 0 < n := by
    rcases Nat.eq_zero_or_pos n with h0 | h
    · rw [h0, mul_zero] at hgn; omega
    · exact h
  have hn1 : 1 < n := by
    rcases Nat.lt_or_ge n 2 with h | h
    · have hn_eq : n = 1 := by omega
      rw [hn_eq, mul_one] at hgn
      exact absurd (hgn ▸ hgV1) hdvd1
    · omega
  have hc3_ne : ¬ n ∣ c₃ := by
    rintro ⟨e, he⟩
    exact hdvd3 ⟨e, by rw [← hgc3, he, ← hgn]; ring⟩
  have hc1_ne : ¬ n ∣ c₁ := by
    rintro ⟨e, he⟩
    exact hdvd1 ⟨e, by rw [← hgc1, he, ← hgn]; ring⟩
  by_cases hn7 : 7 ≤ n
  · -- Corollary 6 applies: αβ = 4/27 ≥ 1/n.
    have hnR : (0 : ℝ) < n := by exact_mod_cast hnpos
    have hαβ : (2/3 : ℝ) * (2/9 : ℝ) ≥ 1 / (n : ℝ) := by
      rw [ge_iff_le, div_le_iff₀ hnR]
      have h7 : (7 : ℝ) ≤ n := by exact_mod_cast hn7
      nlinarith
    rcases bhk_corollary_6 (bhkS7Group n c₃ c₁) n hn1 (bhk_s7_lift n c₃ c₁ hn1 hg1)
        (2/3) (2/9) (by norm_num) (by norm_num) (by norm_num) (by norm_num) hαβ with
      hAll | ⟨ij, hij_ne, hij_mem, hi_lo, hi_hi, hj_lo, hj_hi⟩
    · -- Rectangle branch: hit at anchor (1/6, 7/18), convert to lonely time.
      obtain ⟨p, hpG, hpR⟩ := hAll (1/6) (7/18)
      obtain ⟨k, hk1, hk2⟩ := bhk_s7_extract n c₃ c₁ hn1 p hpG
      obtain ⟨hpR1a, hpR1b, hpR2a, hpR2b⟩ := hpR
      -- Anchored fract conditions transfer to {p.1}, {p.2}.
      have hshift : ∀ x c : ℝ, Int.fract (x - c) = Int.fract (Int.fract x - c) := by
        intro x c
        conv_lhs => rw [← Int.fract_add_floor x]
        rw [show Int.fract x + (⌊x⌋ : ℝ) - c = Int.fract x - c + (⌊x⌋ : ℤ) from by
          push_cast; ring, Int.fract_add_intCast]
      have hu_win := bhk_fract_window (Int.fract p.1) (1/6) (2/3)
        (Int.fract_nonneg _) (Int.fract_lt_one _) (by norm_num) (by norm_num)
        (by rw [← hshift]; exact hpR1b)
      have hw_win := bhk_fract_window (Int.fract p.2) (7/18) (2/9)
        (Int.fract_nonneg _) (Int.fract_lt_one _) (by norm_num) (by norm_num)
        (by rw [← hshift]; exact hpR2b)
      -- The meeting time.
      set τ : ℝ := (k : ℝ) / D with hτ_def
      have hgR : (0 : ℝ) < g := by exact_mod_cast hgpos
      have hDR_pos : (0 : ℝ) < D := by exact_mod_cast hDpos
      have hDR : ((D : ℕ) : ℝ) = (g : ℝ) * n := by exact_mod_cast hgn.symm
      have hV3R : ((V3 : ℕ) : ℝ) = (g : ℝ) * c₃ := by exact_mod_cast hgc3.symm
      have hV1R : ((V1 : ℕ) : ℝ) = (g : ℝ) * c₁ := by exact_mod_cast hgc1.symm
      have e3 : (V3 : ℝ) * τ = ((c₃ * k : ℕ) : ℝ) / n := by
        rw [hτ_def, hV3R, hDR]
        push_cast
        field_simp
      have e1 : (V1 : ℝ) * τ = ((c₁ * k : ℕ) : ℝ) / n := by
        rw [hτ_def, hV1R, hDR]
        push_cast
        field_simp
      have hu3 : Int.fract ((V3 : ℝ) * τ) = Int.fract p.1 := by rw [e3, hk1]
      have hw1 : Int.fract ((V1 : ℝ) * τ) = Int.fract p.2 := by rw [e1, hk2]
      have e2 : (V2 : ℝ) * τ = (V3 : ℝ) * τ - ((k : ℤ) : ℝ) := by
        have hV2R : (V2 : ℝ) = (V3 : ℝ) - D := by rw [hD_cast]; ring
        rw [hV2R, hτ_def]
        field_simp
        push_cast
        ring
      have h2eq : Int.fract ((V2 : ℝ) * τ) = Int.fract ((V3 : ℝ) * τ) := by
        rw [e2, Int.fract_sub_intCast]
      -- Window conditions (6) from the rectangle bounds and 3 V₁ < V₃.
      have hsmallR : 3 * (V1 : ℝ) < V3 := by exact_mod_cast hsmall
      have hV1Rpos : (0 : ℝ) < V1 := by exact_mod_cast hV1pos
      have hV3Rpos : (0 : ℝ) < V3 := by exact_mod_cast hV3pos
      have hu_lo : 1/6 ≤ Int.fract ((V3 : ℝ) * τ) := by rw [hu3]; exact hu_win.1
      have hu_hi : Int.fract ((V3 : ℝ) * τ) ≤ 5/6 := by
        rw [hu3]; have := hu_win.2; linarith
      have hterm_lo : (Int.fract ((V3 : ℝ) * τ) - 1/6) * (V1 : ℝ) / (V3 : ℝ) ≤ 2/9 := by
        rw [div_le_iff₀ hV3Rpos]
        have hb := mul_le_mul_of_nonneg_right
          (show Int.fract ((V3 : ℝ) * τ) - 1/6 ≤ 2/3 by linarith) hV1Rpos.le
        linarith
      have hterm_hi : (5/6 - Int.fract ((V3 : ℝ) * τ)) * (V1 : ℝ) / (V3 : ℝ) ≤ 2/9 := by
        rw [div_le_iff₀ hV3Rpos]
        have hb := mul_le_mul_of_nonneg_right
          (show 5/6 - Int.fract ((V3 : ℝ) * τ) ≤ 2/3 by linarith) hV1Rpos.le
        linarith
      have hw_lo : 1/6 + (Int.fract ((V3 : ℝ) * τ) - 1/6) * (V1 : ℝ) / (V3 : ℝ)
          ≤ Int.fract ((V1 : ℝ) * τ) := by
        rw [hw1]
        have := hw_win.1
        linarith
      have hw_hi : Int.fract ((V1 : ℝ) * τ)
          ≤ 5/6 - (5/6 - Int.fract ((V3 : ℝ) * τ)) * (V1 : ℝ) / (V3 : ℝ) := by
        rw [hw1]
        have := hw_win.2
        linarith
      exact bhk_s7_window_lonely speeds hmono hpos τ hu_lo hu_hi h2eq hw_lo hw_hi
    · exact bhk_s7_exceptional speeds hmono hpos hgcd hsmall n c₃ c₁ g hn1 hgpos
        hgn hgc3 hgc1 hg1 hc3_ne hc1_ne ij hij_ne hij_mem hi_lo hi_hi hj_lo hj_hi
  · exact bhk_s7_small_n speeds hmono hpos hgcd hsmall n c₃ c₁ g hn1 (by omega)
      hgpos hgn hgc3 hgc1 hg1 hc3_ne hc1_ne

end BHK
