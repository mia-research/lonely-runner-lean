  · -- n = 6: k ∈ {1, 2, 3}; pairs with a common factor 2 or 3 are excluded.
    have h3 : c₃ % 6 = 1 ∨ c₃ % 6 = 2 ∨ c₃ % 6 = 3 ∨ c₃ % 6 = 4 ∨ c₃ % 6 = 5 := by
