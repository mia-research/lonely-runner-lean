import LonelyRunner.LRC.SmallN.IntLRC_6_BHK_Lemma4
import LonelyRunner.LRC.SmallN.IntLRC_6_BHK_MainLemma

/-!
# BHK §§2+7 — the generic case (`3 v_1 < v_3`, both fracts nonzero)

Infrastructure for `bhk_case_v1_small_generic` (stated in
`IntLRC_6_BHK_Cases.lean`). The argument (BHK §2 extended by §7):

Let `d := v_3 - v_2`, `t_0 := 1/d` (the meeting period of runners 2 and 3),
and let `G ⊆ T = (ℝ/ℤ)²` be the cyclic subgroup generated by
`({v_3 t_0}, {v_1 t_0})`. With `g := gcd(d, v_3, v_1)`, `n := d / g`,
`c_3 := v_3 / g`, `c_1 := v_1 / g`, the group `G` is the `IsBHKLift` of
`H := ⟨(c_3, c_1)⟩ ⊆ (ZMod n)²`, which has order exactly `n`
(`gcd(n, c_3, c_1) = 1`).

A point of `G` in the parallelogram `P` of BHK (8)–(9) corresponds to a
meeting time `τ = k/d` whose surrounding 3-gap is a full 123-gap of length
`2/(3 v_3)`; `bhk_corollary_5` then yields a lonely time. `P` contains the
rectangle `R = [1/6, 5/6] × [7/18, 11/18]` (width `2/3`, height `2/9`) for
every `v_1 ≤ v_3 / 3`, so `bhk_corollary_6` (with `α = 2/3`, `β = 2/9`,
valid for `n ≥ 7`) either hits `R` or produces an exceptional minimal pair
`(i, j)`.

* `bhk_fract_translate`      — `{v(τ+δ)} = {vτ} + vδ` when no wraparound
* `bhk_fract_window`         — rectangle fract-condition → interval bounds
* `bhk_fract_nat_div`        — `{a/n} = (a % n)/n`
* `bhk_s7_window_lonely`     — the bridge: window conditions at `τ` → lonely time
* `bhkS7Group`               — the explicit lift of `⟨(c_3, c_1)⟩`
* `bhk_s7_card`              — `|⟨(c_3, c_1)⟩| = n` when `gcd(n, c_3, c_1) = 1`
* `bhk_s7_lift`              — `IsBHKLift (bhkS7Group n c₃ c₁) n`
* `bhk_s7_extract`           — `p ∈ bhkS7Group` → fract coords are `{c·k/n}`
* `bhk_s7_exceptional`       — Tables 9/10 + `G_4`/`G_7` (OPEN, sorry)
* `bhk_s7_small_n`           — ad hoc `2 ≤ n ≤ 6` analysis (OPEN, sorry)
* `bhk_s7_main`              — assembly, called from `IntLRC_6_BHK_Cases.lean`

## Source

T. Bohman, R. Holzman, D. Kleitman, *Six Lonely Runners*, EJC **8** (2001)
R3, §2 and §7.
-/

open MeasureTheory Set

namespace BHK

/-! ## Fract helpers -/

/-- **No-wraparound fract translation.** If `{vτ} + vδ` stays in `[0, 1)`
    then `{v(τ+δ)} = {vτ} + vδ`. -/
lemma bhk_fract_translate (v τ δ : ℝ)
    (h0 : 0 ≤ Int.fract (v * τ) + v * δ)
    (h1 : Int.fract (v * τ) + v * δ < 1) :
    Int.fract (v * (τ + δ)) = Int.fract (v * τ) + v * δ := by
  have hsplit : v * (τ + δ) = (⌊v * τ⌋ : ℝ) + (Int.fract (v * τ) + v * δ) := by
    have h : Int.fract (v * τ) + ⌊v * τ⌋ = v * τ := Int.fract_add_floor (v * τ)
    nlinarith [h]
  rw [hsplit, Int.fract_intCast_add, Int.fract_eq_self.mpr ⟨h0, h1⟩]

/-- **Rectangle fract-condition to interval bounds.** For `ρ ∈ [0, 1)` and
    an anchored window `[c, c + L]` with `c ≥ 0`, `c + L < 1`:
    `{ρ - c} ≤ L` forces `c ≤ ρ ≤ c + L`. -/
lemma bhk_fract_window (ρ c L : ℝ) (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1)
    (hc : 0 ≤ c) (hcL : c + L < 1) (h : Int.fract (ρ - c) ≤ L) :
    c ≤ ρ ∧ ρ ≤ c + L := by
  have hL0 : 0 ≤ L := le_trans (Int.fract_nonneg _) h
  by_cases hge : c ≤ ρ
  · have hin : Int.fract (ρ - c) = ρ - c :=
      Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩
    rw [hin] at h
    exact ⟨hge, by linarith⟩
  · -- ρ < c: then ρ - c ∈ (-1, 0), so {ρ - c} = ρ - c + 1 ≤ L gives ρ < 0.
    exfalso
    have hlt : ρ < c := not_le.mp hge
    have hin : Int.fract (ρ - c) = ρ - c + 1 := by
      have h1 : Int.fract (ρ - c) = Int.fract (ρ - c + 1) :=
        (Int.fract_add_one _).symm
      rw [h1, Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩]
    rw [hin] at h
    linarith

/-- **Fract of a rational with natural numerator.** For naturals `a`, `n`
    with `0 < n`: `{a/n} = (a % n)/n`. -/
lemma bhk_fract_nat_div (a n : ℕ) (hn : 0 < n) :
    Int.fract ((a : ℝ) / n) = ((a % n : ℕ) : ℝ) / n := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hdecomp : (a : ℝ) / n = ((a % n : ℕ) : ℝ) / n + ((a / n : ℕ) : ℤ) := by
    have h : (a : ℝ) = ((a % n : ℕ) : ℝ) + ((a / n : ℕ) : ℝ) * n := by
      exact_mod_cast (Nat.mod_add_div' a n).symm
    have h2 : (((a / n : ℕ) : ℤ) : ℝ) = ((a / n : ℕ) : ℝ) := Int.cast_natCast _
    rw [h2, h]
    field_simp
  rw [hdecomp, Int.fract_add_intCast, Int.fract_eq_self.mpr ⟨by positivity, by
    rw [div_lt_one hnR]
    exact_mod_cast Nat.mod_lt a hn⟩]

/-- **Fract-zero iff divides.** For naturals `a`, `d` with `0 < d`:
    `{a/d} = 0 ↔ d ∣ a`. -/
lemma bhk_fract_nat_div_eq_zero_iff (a d : ℕ) (hd : 0 < d) :
    Int.fract ((a : ℝ) / d) = 0 ↔ d ∣ a := by
  have hdR : (0 : ℝ) < d := by exact_mod_cast hd
  rw [bhk_fract_nat_div a d hd, div_eq_zero_iff]
  have hdne : ((d : ℝ)) ≠ 0 := ne_of_gt hdR
  simp only [hdne, or_false, Nat.cast_eq_zero]
  omega

/-! ## The bridge: torus window → lonely time -/

/-- **BHK §2 bridge.** If at time `τ` runners 2 and 3 share fractional
    position `u ∈ [1/6, 5/6]` and runner 1's fractional position `w`
    satisfies BHK condition (6),
    `1/6 + (u - 1/6)·v₁/v₃ ≤ w ≤ 5/6 - (5/6 - u)·v₁/v₃`,
    then the 3-gap around `τ` is a 123-gap of length `2/(3v₃)` and
    `bhk_corollary_5` produces a lonely time. -/
lemma bhk_s7_window_lonely (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i) (τ : ℝ)
    (hu_lo : 1/6 ≤ Int.fract ((speeds ⟨2, by omega⟩ : ℝ) * τ))
    (hu_hi : Int.fract ((speeds ⟨2, by omega⟩ : ℝ) * τ) ≤ 5/6)
    (h2eq : Int.fract ((speeds ⟨1, by omega⟩ : ℝ) * τ)
          = Int.fract ((speeds ⟨2, by omega⟩ : ℝ) * τ))
    (hw_lo : 1/6 + (Int.fract ((speeds ⟨2, by omega⟩ : ℝ) * τ) - 1/6) *
               (speeds ⟨0, by omega⟩ : ℝ) / (speeds ⟨2, by omega⟩ : ℝ)
             ≤ Int.fract ((speeds ⟨0, by omega⟩ : ℝ) * τ))
    (hw_hi : Int.fract ((speeds ⟨0, by omega⟩ : ℝ) * τ)
             ≤ 5/6 - (5/6 - Int.fract ((speeds ⟨2, by omega⟩ : ℝ) * τ)) *
               (speeds ⟨0, by omega⟩ : ℝ) / (speeds ⟨2, by omega⟩ : ℝ)) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 6 := by
  have hv1pos : (0 : ℝ) < speeds ⟨0, by omega⟩ := by exact_mod_cast hpos _
  have hv2pos : (0 : ℝ) < speeds ⟨1, by omega⟩ := by exact_mod_cast hpos _
  have hv3pos : (0 : ℝ) < speeds ⟨2, by omega⟩ := by exact_mod_cast hpos _
  have hv12 : (speeds ⟨0, by omega⟩ : ℝ) < (speeds ⟨1, by omega⟩ : ℝ) := by
    have : speeds ⟨0, by omega⟩ < speeds ⟨1, by omega⟩ := hmono (by decide)
    exact_mod_cast this
  have hv23 : (speeds ⟨1, by omega⟩ : ℝ) < (speeds ⟨2, by omega⟩ : ℝ) := by
    have : speeds ⟨1, by omega⟩ < speeds ⟨2, by omega⟩ := hmono (by decide)
    exact_mod_cast this
  set v1 : ℝ := (speeds ⟨0, by omega⟩ : ℝ) with hv1_def
  set v2 : ℝ := (speeds ⟨1, by omega⟩ : ℝ) with hv2_def
  set v3 : ℝ := (speeds ⟨2, by omega⟩ : ℝ) with hv3_def
  set u : ℝ := Int.fract (v3 * τ) with hu_def
  set w : ℝ := Int.fract (v1 * τ) with hw_def
  -- The 3-gap around τ.
  set a : ℝ := τ - (u - 1/6) / v3 with ha_def
  set b : ℝ := τ + (5/6 - u) / v3 with hb_def
  have hab : a ≤ b := by
    have h1 : 0 ≤ (u - 1/6) / v3 := div_nonneg (by linarith) hv3pos.le
    have h2 : 0 ≤ (5/6 - u) / v3 := div_nonneg (by linarith) hv3pos.le
    rw [ha_def, hb_def]; linarith
  refine bhk_corollary_5 speeds hmono hpos a b hab ?_ ?_
  · -- The 3-gap [a, b] is a 123-gap.
    intro s hs
    obtain ⟨hsa, hsb⟩ := Set.mem_Icc.mp hs
    have hδlo : -((u - 1/6) / v3) ≤ s - τ := by
      rw [ha_def] at hsa; linarith
    have hδhi : s - τ ≤ (5/6 - u) / v3 := by
      rw [hb_def] at hsb; linarith
    -- Uniform safety: a runner with speed v at fractional position ω at τ
    -- whose window condition (6) holds stays in [1/6, 5/6] across [a, b].
    have key : ∀ v ω : ℝ, 0 < v →
        Int.fract (v * τ) = ω →
        1/6 + (u - 1/6) * v / v3 ≤ ω →
        ω ≤ 5/6 - (5/6 - u) * v / v3 →
        1/6 ≤ Int.fract (v * s) ∧ Int.fract (v * s) ≤ 5/6 := by
      intro v ω hv hfr hlo hhi
      have hm_lo : -((u - 1/6) * v / v3) ≤ v * (s - τ) := by
        have h := mul_le_mul_of_nonneg_left hδlo hv.le
        rwa [show v * -((u - 1/6) / v3) = -((u - 1/6) * v / v3) from by ring] at h
      have hm_hi : v * (s - τ) ≤ (5/6 - u) * v / v3 := by
        have h := mul_le_mul_of_nonneg_left hδhi hv.le
        rwa [show v * ((5/6 - u) / v3) = (5/6 - u) * v / v3 from by ring] at h
      have h0 : 0 ≤ Int.fract (v * τ) + v * (s - τ) := by
        rw [hfr]; linarith
      have h1 : Int.fract (v * τ) + v * (s - τ) < 1 := by
        rw [hfr]; linarith
      have hfs : Int.fract (v * s) = ω + v * (s - τ) := by
        have h := bhk_fract_translate v τ (s - τ) h0 h1
        rw [show τ + (s - τ) = s from by ring, hfr] at h
        exact h
      rw [hfs]
      exact ⟨by linarith, by linarith⟩
    have hself : ∀ c : ℝ, c * v3 / v3 = c := fun c => by
      field_simp
    have k3 := key v3 u hv3pos hu_def.symm
      (by rw [hself]; linarith) (by rw [hself]; linarith)
    have k2 := key v2 u hv2pos h2eq
      (by
        have h : (u - 1/6) * v2 / v3 ≤ u - 1/6 := by
          rw [div_le_iff₀ hv3pos]
          nlinarith [mul_nonneg (show (0:ℝ) ≤ u - 1/6 by linarith)
            (show (0:ℝ) ≤ v3 - v2 by linarith)]
        linarith)
      (by
        have h : (5/6 - u) * v2 / v3 ≤ 5/6 - u := by
          rw [div_le_iff₀ hv3pos]
          nlinarith [mul_nonneg (show (0:ℝ) ≤ 5/6 - u by linarith)
            (show (0:ℝ) ≤ v3 - v2 by linarith)]
        linarith)
    have k1 := key v1 w hv1pos hw_def.symm hw_lo hw_hi
    rw [Set.mem_compl_iff]
    intro hmem
    have hsafe : ∀ x : ℝ, 1/6 ≤ Int.fract x → Int.fract x ≤ 5/6 →
        ¬ circDist x < 1/6 := by
      intro x hx1 hx2
      rw [not_lt]
      unfold circDist
      exact le_min hx1 (by linarith)
    rcases hmem with (h | h) | h
    · exact hsafe _ k1.1 k1.2 ((mem_unsafeOf_iff _ _ _).mp h)
    · exact hsafe _ k2.1 k2.2 ((mem_unsafeOf_iff _ _ _).mp h)
    · exact hsafe _ k3.1 k3.2 ((mem_unsafeOf_iff _ _ _).mp h)
  · -- Length: b - a = 2/(3 v₃).
    have hba : b - a = 2 / (3 * v3) := by
      rw [hb_def, ha_def]
      field_simp
      ring
    show 2 / (3 * v3) ≤ b - a
    rw [hba]

/-! ## The cyclic torus group and its lift -/

/-- The ℤ²-periodic lift of the cyclic subgroup `⟨(c₃, c₁)⟩ ⊆ (ZMod n)²`. -/
def bhkS7Group (n c₃ c₁ : ℕ) : Set (ℝ × ℝ) :=
  { p | ∃ h ∈ AddSubgroup.zmultiples ((c₃ : ZMod n), (c₁ : ZMod n)),
        ∃ i j : ℤ,
          p = (((h.1.val : ℝ) / n) + (i : ℝ), ((h.2.val : ℝ) / n) + (j : ℝ)) }

/-- **Order of the cyclic group.** If `gcd(n, gcd(c₃, c₁)) = 1` then
    `(c₃, c₁)` has additive order exactly `n` in `(ZMod n)²`, so its
    cyclic subgroup has cardinality `n`. -/
lemma bhk_s7_card (n c₃ c₁ : ℕ) (hn : 1 < n)
    (hg : Nat.gcd n (Nat.gcd c₃ c₁) = 1) :
    Nat.card (AddSubgroup.zmultiples ((c₃ : ZMod n), (c₁ : ZMod n))) = n := by
  have hn0 : n ≠ 0 := by omega
  rw [Nat.card_zmultiples, Prod.addOrderOf_mk,
      ZMod.addOrderOf_coe c₃ hn0, ZMod.addOrderOf_coe c₁ hn0]
  -- ⊢ (n / n.gcd c₃).lcm (n / n.gcd c₁) = n
  set a := n.gcd c₃ with ha_def
  set b := n.gcd c₁ with hb_def
  have ha : a ∣ n := Nat.gcd_dvd_left _ _
  have hb : b ∣ n := Nat.gcd_dvd_left _ _
  have hapos : 0 < a := Nat.gcd_pos_of_pos_left c₃ (by omega)
  have hbpos : 0 < b := Nat.gcd_pos_of_pos_left c₁ (by omega)
  have hab : Nat.Coprime a b := by
    have h1 : Nat.gcd a b ∣ n := (Nat.gcd_dvd_left a b).trans ha
    have h2 : Nat.gcd a b ∣ Nat.gcd c₃ c₁ :=
      Nat.dvd_gcd ((Nat.gcd_dvd_left a b).trans (Nat.gcd_dvd_right n c₃))
                  ((Nat.gcd_dvd_right a b).trans (Nat.gcd_dvd_right n c₁))
    have h3 := Nat.dvd_gcd h1 h2
    rw [hg] at h3
    exact Nat.dvd_one.mp h3
  obtain ⟨m, hm⟩ := Nat.Coprime.mul_dvd_of_dvd_of_dvd hab ha hb
  have hna : n / a = b * m := by
    rw [hm, mul_assoc, Nat.mul_div_cancel_left _ hapos]
  have hnb : n / b = a * m := by
    rw [hm, show a * b * m = b * (a * m) from by ring,
        Nat.mul_div_cancel_left _ hbpos]
  have hmpos : 0 < m := by
    rcases Nat.eq_zero_or_pos m with h0 | h
    · subst h0; simp at hm; omega
    · exact h
  have hgba : Nat.gcd b a = 1 := hab.symm
  rw [hna, hnb, Nat.lcm, Nat.gcd_mul_right, hgba, one_mul,
      show b * m * (a * m) = a * b * m * m from by ring,
      Nat.mul_div_cancel _ hmpos, hm]

/-- **`bhkS7Group` is a BHK lift.** -/
lemma bhk_s7_lift (n c₃ c₁ : ℕ) (hn : 1 < n)
    (hg : Nat.gcd n (Nat.gcd c₃ c₁) = 1) :
    IsBHKLift (bhkS7Group n c₃ c₁) n :=
  ⟨AddSubgroup.zmultiples ((c₃ : ZMod n), (c₁ : ZMod n)),
   bhk_s7_card n c₃ c₁ hn hg, fun _ => Iff.rfl⟩

/-- **Coordinate extraction.** Every point of `bhkS7Group n c₃ c₁` has
    fractional coordinates `({c₃ k / n}, {c₁ k / n})` for some `k : ℕ`. -/
lemma bhk_s7_extract (n c₃ c₁ : ℕ) (hn : 1 < n) (p : ℝ × ℝ)
    (hp : p ∈ bhkS7Group n c₃ c₁) :
    ∃ k : ℕ, Int.fract p.1 = Int.fract ((c₃ * k : ℕ) / (n : ℝ)) ∧
             Int.fract p.2 = Int.fract ((c₁ * k : ℕ) / (n : ℝ)) := by
  have hn0 : n ≠ 0 := by omega
  have hnpos : 0 < n := by omega
  have hnR : (0 : ℝ) < n := by exact_mod_cast hnpos
  haveI : NeZero n := ⟨hn0⟩
  obtain ⟨h, hh_mem, i, j, hp_eq⟩ := hp
  obtain ⟨z, hz⟩ := AddSubgroup.mem_zmultiples_iff.mp hh_mem
  -- Reduce the ℤ-multiple to a ℕ-multiple mod n.
  set k : ℕ := (z % (n : ℤ)).toNat with hk_def
  have hk_cast : ((k : ℕ) : ℤ) = z % (n : ℤ) :=
    Int.toNat_of_nonneg (Int.emod_nonneg z (by exact_mod_cast hn0))
  have hzk : ((z : ℤ) : ZMod n) = ((k : ℕ) : ZMod n) := by
    rw [show ((k : ℕ) : ZMod n) = (((k : ℕ) : ℤ) : ZMod n) from by push_cast; rfl,
        hk_cast, ZMod.intCast_mod]
  -- Componentwise identification of the group element.
  have hfst : h.1 = ((c₃ * k : ℕ) : ZMod n) := by
    have h1 : h.1 = z • (c₃ : ZMod n) := by rw [← hz]; simp
    rw [h1, zsmul_eq_mul, hzk]
    push_cast
    ring
  have hsnd : h.2 = ((c₁ * k : ℕ) : ZMod n) := by
    have h1 : h.2 = z • (c₁ : ZMod n) := by rw [← hz]; simp
    rw [h1, zsmul_eq_mul, hzk]
    push_cast
    ring
  -- Fract computations.
  have hval_fract : ∀ x : ZMod n, Int.fract ((x.val : ℝ) / n) = (x.val : ℝ) / n := by
    intro x
    refine Int.fract_eq_self.mpr ⟨by positivity, ?_⟩
    rw [div_lt_one hnR]
    exact_mod_cast ZMod.val_lt x
  refine ⟨k, ?_, ?_⟩
  · rw [hp_eq]
    show Int.fract ((h.1.val : ℝ) / n + (i : ℝ)) = _
    rw [Int.fract_add_intCast, hval_fract, bhk_fract_nat_div _ _ hnpos,
        hfst, ZMod.val_natCast]
  · rw [hp_eq]
    show Int.fract ((h.2.val : ℝ) / n + (j : ℝ)) = _
    rw [Int.fract_add_intCast, hval_fract, bhk_fract_nat_div _ _ hnpos,
        hsnd, ZMod.val_natCast]

/-! ## Explicit-witness plumbing -/

/-- **Lonely time from an explicit meeting index.** Given the reduced group
    data `(n, c₃, c₁, g)` and an explicit `k` whose torus point
    `(c₃k/n, c₁k/n)` satisfies the parallelogram conditions (8)–(9)
    (exact form, with the true ratio `v₁/v₃`), the meeting time
    `τ = k/(v₃ - v₂)` yields a lonely time via the §2 bridge. -/
lemma bhk_s7_witness (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i)
    (n c₃ c₁ g : ℕ) (hnpos : 0 < n) (hgpos : 0 < g)
    (hd : g * n = speeds ⟨2, by omega⟩ - speeds ⟨1, by omega⟩)
    (hc3 : g * c₃ = speeds ⟨2, by omega⟩)
    (hc1 : g * c₁ = speeds ⟨0, by omega⟩)
    (k : ℕ)
    (hu_lo : 1/6 ≤ ((c₃ * k % n : ℕ) : ℝ) / n)
    (hu_hi : ((c₃ * k % n : ℕ) : ℝ) / n ≤ 5/6)
    (hw_lo : 1/6 + (((c₃ * k % n : ℕ) : ℝ) / n - 1/6) *
               (speeds ⟨0, by omega⟩ : ℝ) / (speeds ⟨2, by omega⟩ : ℝ)
             ≤ ((c₁ * k % n : ℕ) : ℝ) / n)
    (hw_hi : ((c₁ * k % n : ℕ) : ℝ) / n
             ≤ 5/6 - (5/6 - ((c₃ * k % n : ℕ) : ℝ) / n) *
               (speeds ⟨0, by omega⟩ : ℝ) / (speeds ⟨2, by omega⟩ : ℝ)) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 6 := by
  have hV23 : speeds ⟨1, by omega⟩ < speeds ⟨2, by omega⟩ :=
    hmono (Fin.mk_lt_mk.mpr (by omega))
  set V1 : ℕ := speeds ⟨0, by omega⟩ with hV1_def
  set V2 : ℕ := speeds ⟨1, by omega⟩ with hV2_def
  set V3 : ℕ := speeds ⟨2, by omega⟩ with hV3_def
  set D : ℕ := V3 - V2 with hD_def
  have hDpos : 0 < D := by omega
  have hD_cast : ((D : ℕ) : ℝ) = (V3 : ℝ) - V2 := by
    rw [hD_def, Nat.cast_sub hV23.le]
  set τ : ℝ := (k : ℝ) / D with hτ_def
  have hDR : ((D : ℕ) : ℝ) = (g : ℝ) * n := by exact_mod_cast hd.symm
  have hV3R : ((V3 : ℕ) : ℝ) = (g : ℝ) * c₃ := by exact_mod_cast hc3.symm
  have hV1R : ((V1 : ℕ) : ℝ) = (g : ℝ) * c₁ := by exact_mod_cast hc1.symm
  have hgR : (0 : ℝ) < g := by exact_mod_cast hgpos
  have hnR : (0 : ℝ) < n := by exact_mod_cast hnpos
  have e3 : (V3 : ℝ) * τ = ((c₃ * k : ℕ) : ℝ) / n := by
    rw [hτ_def, hV3R, hDR]
    push_cast
    field_simp
  have e1 : (V1 : ℝ) * τ = ((c₁ * k : ℕ) : ℝ) / n := by
    rw [hτ_def, hV1R, hDR]
    push_cast
    field_simp
  have hu3 : Int.fract ((V3 : ℝ) * τ) = ((c₃ * k % n : ℕ) : ℝ) / n := by
    rw [e3, bhk_fract_nat_div _ _ hnpos]
  have hw1 : Int.fract ((V1 : ℝ) * τ) = ((c₁ * k % n : ℕ) : ℝ) / n := by
    rw [e1, bhk_fract_nat_div _ _ hnpos]
  have e2 : (V2 : ℝ) * τ = (V3 : ℝ) * τ - ((k : ℤ) : ℝ) := by
    have hV2R : (V2 : ℝ) = (V3 : ℝ) - D := by rw [hD_cast]; ring
    rw [hV2R, hτ_def]
    field_simp
    push_cast
    ring
  have h2eq : Int.fract ((V2 : ℝ) * τ) = Int.fract ((V3 : ℝ) * τ) := by
    rw [e2, Int.fract_sub_intCast]
  exact bhk_s7_window_lonely speeds hmono hpos τ
    (by rw [hu3]; exact hu_lo) (by rw [hu3]; exact hu_hi) h2eq
    (by rw [hu3, hw1]; exact hw_lo) (by rw [hu3, hw1]; exact hw_hi)

/-- **Sufficient-window witness.** The conditions
    `u ∈ [1/6, 5/6]`, `w ∈ [1/9 + u/3, 5/9 + u/3]` imply the exact
    parallelogram conditions for every ratio `v₁/v₃ ≤ 1/3` (here `< 1/3`
    from `hsmall`), eliminating the speed-dependence: a single `k` then
    works for the whole case. -/
lemma bhk_s7_witness_suff (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i)
    (hsmall : 3 * speeds ⟨0, by omega⟩ < speeds ⟨2, by omega⟩)
    (n c₃ c₁ g : ℕ) (k : ℕ) (hnpos : 0 < n) (hgpos : 0 < g)
    (hd : g * n = speeds ⟨2, by omega⟩ - speeds ⟨1, by omega⟩)
    (hc3 : g * c₃ = speeds ⟨2, by omega⟩)
    (hc1 : g * c₁ = speeds ⟨0, by omega⟩)
    (hu_lo : 1/6 ≤ ((c₃ * k % n : ℕ) : ℝ) / n)
    (hu_hi : ((c₃ * k % n : ℕ) : ℝ) / n ≤ 5/6)
    (hw_lo : 1/9 + ((c₃ * k % n : ℕ) : ℝ) / n / 3 ≤ ((c₁ * k % n : ℕ) : ℝ) / n)
    (hw_hi : ((c₁ * k % n : ℕ) : ℝ) / n ≤ 5/9 + ((c₃ * k % n : ℕ) : ℝ) / n / 3) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 6 := by
  have hV1Rpos : (0 : ℝ) < speeds ⟨0, by omega⟩ := by exact_mod_cast hpos _
  have hV3Rpos : (0 : ℝ) < speeds ⟨2, by omega⟩ := by exact_mod_cast hpos _
  have hsmallR : 3 * (speeds ⟨0, by omega⟩ : ℝ) < speeds ⟨2, by omega⟩ := by
    exact_mod_cast hsmall
  set u : ℝ := ((c₃ * k % n : ℕ) : ℝ) / n with hu_def
  set w : ℝ := ((c₁ * k % n : ℕ) : ℝ) / n with hw_def
  apply bhk_s7_witness speeds hmono hpos n c₃ c₁ g hnpos hgpos hd hc3 hc1 k
    hu_lo hu_hi ?_ ?_
  · -- 1/6 + (u - 1/6)·v₁/v₃ ≤ w, since (u - 1/6)·v₁/v₃ ≤ (u - 1/6)/3.
    have hterm : (u - 1/6) * (speeds ⟨0, by omega⟩ : ℝ) / (speeds ⟨2, by omega⟩ : ℝ)
        ≤ (u - 1/6) / 3 := by
      rw [div_le_div_iff₀ hV3Rpos (by norm_num : (0:ℝ) < 3)]
      have h := mul_le_mul_of_nonneg_left hsmallR.le
        (show (0:ℝ) ≤ u - 1/6 by linarith)
      linarith [h]
    linarith
  · have hterm : (5/6 - u) * (speeds ⟨0, by omega⟩ : ℝ) / (speeds ⟨2, by omega⟩ : ℝ)
        ≤ (5/6 - u) / 3 := by
      rw [div_le_div_iff₀ hV3Rpos (by norm_num : (0:ℝ) < 3)]
      have h := mul_le_mul_of_nonneg_left hsmallR.le
        (show (0:ℝ) ≤ 5/6 - u by linarith)
      linarith [h]
    linarith

/-- **Natural-number form of the sufficient window.** With `a := c₃k mod n`,
    `b := c₁k mod n`, the sufficient window `u ∈ [1/6, 5/6]`,
    `w ∈ [1/9 + u/3, 5/9 + u/3]` is equivalent to the four ℕ-inequalities
    `n ≤ 6a`, `6a ≤ 5n`, `n + 3a ≤ 9b`, `9b ≤ 5n + 3a` — all decidable by
    `omega` once `c₃ % n`, `c₁ % n` are pinned. -/
lemma bhk_s7_witness_num (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i)
    (hsmall : 3 * speeds ⟨0, by omega⟩ < speeds ⟨2, by omega⟩)
    (n c₃ c₁ g k : ℕ) (hnpos : 0 < n) (hgpos : 0 < g)
    (hd : g * n = speeds ⟨2, by omega⟩ - speeds ⟨1, by omega⟩)
    (hc3 : g * c₃ = speeds ⟨2, by omega⟩)
    (hc1 : g * c₁ = speeds ⟨0, by omega⟩)
    (h_ulo : n ≤ 6 * (c₃ * k % n)) (h_uhi : 6 * (c₃ * k % n) ≤ 5 * n)
    (h_wlo : n + 3 * (c₃ * k % n) ≤ 9 * (c₁ * k % n))
    (h_whi : 9 * (c₁ * k % n) ≤ 5 * n + 3 * (c₃ * k % n)) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 6 := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hnpos
  have haR : (n : ℝ) ≤ 6 * ((c₃ * k % n : ℕ) : ℝ) := by exact_mod_cast h_ulo
  have haR' : 6 * ((c₃ * k % n : ℕ) : ℝ) ≤ 5 * n := by exact_mod_cast h_uhi
  have hbR : (n : ℝ) + 3 * ((c₃ * k % n : ℕ) : ℝ)
      ≤ 9 * ((c₁ * k % n : ℕ) : ℝ) := by exact_mod_cast h_wlo
  have hbR' : 9 * ((c₁ * k % n : ℕ) : ℝ)
      ≤ 5 * (n : ℝ) + 3 * ((c₃ * k % n : ℕ) : ℝ) := by exact_mod_cast h_whi
  apply bhk_s7_witness_suff speeds hmono hpos hsmall n c₃ c₁ g k hnpos hgpos
    hd hc3 hc1
  · rw [le_div_iff₀ hnR]; linarith
  · rw [div_le_iff₀ hnR]; linarith
  · have key : ((c₁ * k % n : ℕ) : ℝ) / n
        - (1/9 + ((c₃ * k % n : ℕ) : ℝ) / n / 3)
        = (9 * ((c₁ * k % n : ℕ) : ℝ) - n - 3 * ((c₃ * k % n : ℕ) : ℝ))
          / (9 * n) := by
      field_simp
      ring
    have hq : (0 : ℝ)
        ≤ (9 * ((c₁ * k % n : ℕ) : ℝ) - n - 3 * ((c₃ * k % n : ℕ) : ℝ))
          / (9 * n) :=
      div_nonneg (by linarith) (by positivity)
    rw [← key] at hq
    linarith
  · have key : (5/9 + ((c₃ * k % n : ℕ) : ℝ) / n / 3)
        - ((c₁ * k % n : ℕ) : ℝ) / n
        = (5 * n + 3 * ((c₃ * k % n : ℕ) : ℝ) - 9 * ((c₁ * k % n : ℕ) : ℝ))
          / (9 * n) := by
      field_simp
      ring
    have hq : (0 : ℝ)
        ≤ (5 * (n:ℝ) + 3 * ((c₃ * k % n : ℕ) : ℝ) - 9 * ((c₁ * k % n : ℕ) : ℝ))
          / (9 * n) :=
      div_nonneg (by linarith) (by positivity)
    rw [← key] at hq
    linarith

/-! ## Modular-arithmetic helpers for the exceptional-pair analysis -/

/-- **Mod of a scaled multiple.** `c·(m·m₀) ≡ (c·m₀ mod n)·m (mod n)`. -/
lemma bhk_s7_mul_mod (c m₀ m n : ℕ) :
    c * (m * m₀) % n = (c * m₀ % n) * m % n := by
  rw [show c * (m * m₀) = (c * m₀) * m from by ring,
      Nat.mul_mod (c * m₀) m n, Nat.mul_mod (c * m₀ % n) m n,
      Nat.mod_mod_of_dvd _ dvd_rfl]

/-- **Mod of a negative-residue multiple.** For `0 < r`, `0 < m`,
    `r·m < n`: `(n − r)·m ≡ n − r·m (mod n)`. -/
lemma bhk_s7_neg_mod (n r m : ℕ) (hr : 0 < r) (hm : 0 < m) (hrm : r * m < n) :
    (n - r) * m % n = n - r * m := by
  have h3 : r ≤ r * m := by
    calc r = r * 1 := (mul_one r).symm
    _ ≤ r * m := Nat.mul_le_mul_left r hm
  have hppos : 0 < r * m := Nat.mul_pos hr hm
  have hn0 : 0 < n := lt_of_le_of_lt (Nat.zero_le (r * m)) hrm
  have h1 : (n - r) * m = n * (m - 1) + (n - r * m) := by
    zify [show r ≤ n by omega, show 1 ≤ m from hm, show r * m ≤ n from hrm.le]
    ring
  rw [h1, Nat.mul_add_mod, Nat.mod_eq_of_lt (Nat.sub_lt hn0 hppos)]

/-- **Fract-to-residue conversion.** If `{a/n} = x/n` with `x < n` natural,
    then `x = a mod n` (as integers). -/
lemma bhk_s7_fract_int_eq (n : ℕ) (hn : 0 < n) (a : ℤ) (x : ℕ) (hx : x < n)
    (h : Int.fract ((a : ℝ) / n) = (x : ℝ) / n) :
    (x : ℤ) = a % n := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hnz : ((n : ℕ) : ℤ) ≠ 0 := by exact_mod_cast hn.ne'
  have hmod : Int.fract ((a : ℝ) / n) = ((a % n : ℤ) : ℝ) / n := by
    have h0 : a % (n : ℤ) + (n : ℤ) * (a / (n : ℤ)) = a := Int.emod_add_ediv a n
    have hsplit : (a : ℝ) / n = ((a % n : ℤ) : ℝ) / n + ((a / (n : ℤ) : ℤ) : ℝ) := by
      have hcast : (a : ℝ) = ((a % n : ℤ) : ℝ) + (n : ℝ) * ((a / (n : ℤ) : ℤ) : ℝ) := by
        exact_mod_cast h0.symm
      rw [hcast]
      field_simp
    rw [hsplit, Int.fract_add_intCast]
    refine Int.fract_eq_self.mpr ⟨?_, ?_⟩
    · exact div_nonneg (by exact_mod_cast Int.emod_nonneg a hnz) hnR.le
    · rw [div_lt_one hnR]
      exact_mod_cast Int.emod_lt_of_pos a (by exact_mod_cast hn)
  rw [hmod] at h
  rw [div_eq_div_iff hnR.ne' hnR.ne'] at h
  have hcast : ((a % n : ℤ) : ℝ) = (x : ℝ) := mul_right_cancel₀ hnR.ne' h
  exact_mod_cast hcast.symm

/-- **Negative residues mod `n` over ℤ.** For `0 < r < n`:
    `(−r) mod n = n − r`. -/
lemma bhk_s7_int_neg_mod (n r : ℕ) (hr : 0 < r) (hrn : r < n) :
    (-(r : ℤ)) % (n : ℤ) = (n : ℤ) - r := by
  rw [show (-(r : ℤ)) = ((n : ℤ) - r) + (n : ℤ) * (-1) from by ring,
      Int.add_mul_emod_self_left, Int.emod_eq_of_lt (by omega) (by omega)]

/-! ## (13)-minimal selection (BHK §3.3) -/

/-- **Minimal-element selection.** From any nonzero `G`-element in the box
    `[-B, B] × [-C, C]`, produce one that is additionally *(13)-minimal*:
    no other nonzero `G`-element lies in its centered box
    `[-|i|, |i|] × [-|j|, |j|]` except the four corners `(±i, ±j)`.

    Proof: descend on the measure `(|i|+1)·(|j|+1)` — any (13)-violator is
    strictly smaller in measure and stays in the outer box. -/
lemma bhk_s7_minimal_select (G : Set (ℝ × ℝ)) (n : ℕ) (B C : ℝ)
    (h_ex : ∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
      |(ij.1 : ℝ)| ≤ B ∧ |(ij.2 : ℝ)| ≤ C) :
    ∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
      |(ij.1 : ℝ)| ≤ B ∧ |(ij.2 : ℝ)| ≤ C ∧
      ∀ kl : ℤ × ℤ, kl ≠ (0, 0) → |kl.1| ≤ |ij.1| → |kl.2| ≤ |ij.2| →
        ¬(|kl.1| = |ij.1| ∧ |kl.2| = |ij.2|) →
        ((kl.1 : ℝ) / n, (kl.2 : ℝ) / n) ∉ G := by
  obtain ⟨ij₀, h₀⟩ := h_ex
  -- Descend on the measure m = (|i|+1)(|j|+1).
  suffices key : ∀ m : ℕ, ∀ ij : ℤ × ℤ,
      (ij.1.natAbs + 1) * (ij.2.natAbs + 1) ≤ m →
      ij ≠ (0, 0) → ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G →
      |(ij.1 : ℝ)| ≤ B → |(ij.2 : ℝ)| ≤ C →
      ∃ ij' : ℤ × ℤ, ij' ≠ (0, 0) ∧
        ((ij'.1 : ℝ) / n, (ij'.2 : ℝ) / n) ∈ G ∧
        |(ij'.1 : ℝ)| ≤ B ∧ |(ij'.2 : ℝ)| ≤ C ∧
        ∀ kl : ℤ × ℤ, kl ≠ (0, 0) → |kl.1| ≤ |ij'.1| → |kl.2| ≤ |ij'.2| →
          ¬(|kl.1| = |ij'.1| ∧ |kl.2| = |ij'.2|) →
          ((kl.1 : ℝ) / n, (kl.2 : ℝ) / n) ∉ G by
    exact key ((ij₀.1.natAbs + 1) * (ij₀.2.natAbs + 1)) ij₀ le_rfl
      h₀.1 h₀.2.1 h₀.2.2.1 h₀.2.2.2
  intro m
  induction m with
  | zero =>
    intro ij hm _ _ _ _
    have hpos : 0 < (ij.1.natAbs + 1) * (ij.2.natAbs + 1) :=
      Nat.mul_pos (by omega) (by omega)
    omega
  | succ m ih =>
    intro ij hm hne hmem hB hC
    by_cases hmin : ∀ kl : ℤ × ℤ, kl ≠ (0, 0) → |kl.1| ≤ |ij.1| →
        |kl.2| ≤ |ij.2| → ¬(|kl.1| = |ij.1| ∧ |kl.2| = |ij.2|) →
        ((kl.1 : ℝ) / n, (kl.2 : ℝ) / n) ∉ G
    · exact ⟨ij, hne, hmem, hB, hC, hmin⟩
    · push_neg at hmin
      obtain ⟨kl, hkl_ne, hkl_i, hkl_j, hkl_corner, hkl_mem⟩ := hmin
      -- The violator is strictly smaller in measure and stays in the box.
      have habs_i : kl.1.natAbs ≤ ij.1.natAbs := by
        rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs] at hkl_i
        exact_mod_cast hkl_i
      have habs_j : kl.2.natAbs ≤ ij.2.natAbs := by
        rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs] at hkl_j
        exact_mod_cast hkl_j
      have habs_ne : kl.1.natAbs ≠ ij.1.natAbs ∨ kl.2.natAbs ≠ ij.2.natAbs := by
        by_contra hcon
        push_neg at hcon
        have h1 : |kl.1| = |ij.1| := by
          rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs]
          exact_mod_cast hcon.1
        have h2 : |kl.2| = |ij.2| := by
          rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs]
          exact_mod_cast hcon.2
        exact hkl_corner h1 h2
      have hmeas : (kl.1.natAbs + 1) * (kl.2.natAbs + 1)
          < (ij.1.natAbs + 1) * (ij.2.natAbs + 1) := by
        rcases habs_ne with h | h
        · exact Nat.mul_lt_mul_of_lt_of_le (by omega) (by omega) (by omega)
        · exact Nat.mul_lt_mul_of_le_of_lt (by omega) (by omega) (by omega)
      have hkl_B : |(kl.1 : ℝ)| ≤ B := by
        refine le_trans ?_ hB
        rw [← Int.cast_abs, ← Int.cast_abs]
        exact_mod_cast hkl_i
      have hkl_C : |(kl.2 : ℝ)| ≤ C := by
        refine le_trans ?_ hC
        rw [← Int.cast_abs, ← Int.cast_abs]
        exact_mod_cast hkl_j
      exact ih kl (by omega) hkl_ne hkl_mem hkl_B hkl_C

/-- **Corollary 6 with (13)-minimality (BHK §3.3).** Either `G` hits every
    `α × β` rectangle, or there is a nonzero `(i, j)` in the cone (10) that
    is additionally *(13)-minimal*: no nonzero `G`-element lies in
    `[-|i|, |i|] × [-|j|, |j|]` other than the corners `(±i, ±j)`. This is
    the form needed for Lemma 7's order bound (14) and the Table-9
    circle-period analysis. Requires `n ≥ 1/β` (Cases A & B only; our
    application has `n ≥ 7 > 9/2 = 1/β`). -/
theorem bhk_s7_corollary_6_minimal
    (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (hG_lift : IsBHKLift G n)
    (α β : ℝ) (hα : 0 < α) (hα' : α < 1) (hβ : 0 < β) (hβ' : β < 1)
    (hαβ : α * β ≥ 1 / (n : ℝ)) (h_nβ : 1 / β ≤ (n : ℝ)) :
    (∀ x₁ x₂, (G ∩ bhkRectangle x₁ x₂ α β).Nonempty) ∨
    (∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
      0 ≤ ij.1 ∧ (ij.1 : ℝ) < 1 / β ∧
      -1 / α - β / α * ij.1 < (ij.2 : ℝ) ∧
      (ij.2 : ℝ) < 1 / α + β / α * ij.1 ∧
      (∀ kl : ℤ × ℤ, kl ≠ (0, 0) → |kl.1| ≤ |ij.1| → |kl.2| ≤ |ij.2| →
        ¬(|kl.1| = |ij.1| ∧ |kl.2| = |ij.2|) →
        ((kl.1 : ℝ) / n, (kl.2 : ℝ) / n) ∉ G)) := by
  have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
  have h_1β_pos : (0 : ℝ) < 1/β := one_div_pos.mpr hβ
  have hβn_pos : (0 : ℝ) < β * n := mul_pos hβ hn_pos
  have h_1β_le_αn : (1 : ℝ) / β ≤ α * n := by
    have hαβn_ge_one : (1 : ℝ) ≤ α * β * n := by
      have h := hαβ
      rw [ge_iff_le, div_le_iff₀ hn_pos] at h
      linarith
    rw [div_le_iff₀ hβ]
    nlinarith
  by_cases h_all_hit : ∀ x₁ x₂, (G ∩ bhkRectangle x₁ x₂ α β).Nonempty
  · exact Or.inl h_all_hit
  refine Or.inr ?_
  push_neg at h_all_hit
  obtain ⟨x₁, x₂, h_miss_eq⟩ := h_all_hit
  have h_miss : ¬ (G ∩ bhkRectangle x₁ x₂ α β).Nonempty := by
    rw [Set.not_nonempty_iff_eq_empty]; exact h_miss_eq
  obtain ⟨H, hH_card, hG_iff⟩ := id hG_lift
  haveI : NeZero n := ⟨by omega⟩
  have hn_ne_real : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  have hG_int_iff : ∀ a b : ℤ, ((a : ℝ) / n, (b : ℝ) / n) ∈ G ↔
      ((a : ZMod n), (b : ZMod n)) ∈ H :=
    fun a b => bhk_lift_int_mem_iff G n hn H hG_iff a b
  obtain ⟨B, hB_nn, hB_lt, ij₀, hij₀_ne, hij₀_H, hij₀_B, hij₀_β⟩ :=
    bhk_corollary_6_small_i_witness n hn H hH_card β hβ
  -- (13)-minimal selection within the box [-B, B] × [-βn, βn].
  obtain ⟨ij', hij'_ne, hij'_G, hij'_B, hij'_β, hij'_min⟩ :=
    bhk_s7_minimal_select G n B (β * n)
      ⟨ij₀, hij₀_ne, (hG_int_iff ij₀.1 ij₀.2).mpr hij₀_H, hij₀_B, hij₀_β⟩
  have hij'_i_lt : |(ij'.1 : ℝ)| < 1 / β := lt_of_le_of_lt hij'_B hB_lt
  have hij'_box_αn : |(ij'.1 : ℝ)| ≤ α * n := le_trans hij'_i_lt.le h_1β_le_αn
  -- (13)-minimality implies the multiple-minimality `rectangle_minimal` needs.
  have hij'_mult_min : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ℝ) / n, (j₀ : ℝ) / n) ∈ G → (ij'.1, ij'.2) ≠ (k * i₀, k * j₀) := by
    intro i₀ j₀ k hk h₀_G heq
    have hi_eq : ij'.1 = k * i₀ := congr_arg Prod.fst heq
    have hj_eq : ij'.2 = k * j₀ := congr_arg Prod.snd heq
    have hk1 : (1 : ℤ) ≤ |k| := by
      rw [abs_of_pos (by omega : (0:ℤ) < k)]; omega
    have hk2 : (2 : ℤ) ≤ |k| := by
      rw [abs_of_pos (by omega : (0:ℤ) < k)]; omega
    have hne₀ : (i₀, j₀) ≠ ((0 : ℤ), (0 : ℤ)) := by
      intro h00
      have hi₀ : i₀ = 0 := congr_arg Prod.fst h00
      have hj₀ : j₀ = 0 := congr_arg Prod.snd h00
      apply hij'_ne
      exact Prod.ext (by rw [hi_eq, hi₀, mul_zero])
        (by rw [hj_eq, hj₀, mul_zero])
    have habs_i : |i₀| ≤ |ij'.1| := by
      rw [hi_eq, abs_mul]
      exact le_mul_of_one_le_left (abs_nonneg _) hk1
    have habs_j : |j₀| ≤ |ij'.2| := by
      rw [hj_eq, abs_mul]
      exact le_mul_of_one_le_left (abs_nonneg _) hk1
    have hcorner : ¬(|i₀| = |ij'.1| ∧ |j₀| = |ij'.2|) := by
      rintro ⟨h1, h2⟩
      rw [hi_eq, abs_mul] at h1
      rw [hj_eq, abs_mul] at h2
      have hmul_i : 2 * |i₀| ≤ |k| * |i₀| :=
        mul_le_mul_of_nonneg_right hk2 (abs_nonneg i₀)
      have hmul_j : 2 * |j₀| ≤ |k| * |j₀| :=
        mul_le_mul_of_nonneg_right hk2 (abs_nonneg j₀)
      have hi0 : i₀ = 0 := by
        have := abs_nonneg i₀
        have h_le : |i₀| ≤ 0 := by linarith
        have : |i₀| = 0 := le_antisymm h_le (abs_nonneg i₀)
        exact abs_eq_zero.mp this
      have hj0 : j₀ = 0 := by
        have := abs_nonneg j₀
        have h_le : |j₀| ≤ 0 := by linarith
        have : |j₀| = 0 := le_antisymm h_le (abs_nonneg j₀)
        exact abs_eq_zero.mp this
      exact hne₀ (by rw [hi0, hj0])
    exact hij'_min (i₀, j₀) hne₀ habs_i habs_j hcorner h₀_G
  -- BHK (12) for the minimal element.
  have h_bound := bhk_main_lemma_rectangle_minimal G n hn hG_lift α β hα hα'
    hβ hβ' ij'.1 ij'.2 (by exact hij'_ne) ⟨hij'_box_αn, hij'_β⟩
    (by exact hij'_G) hij'_mult_min ⟨x₁, x₂, h_miss⟩
  -- G-negation symmetry for the sign normalization.
  have hG_neg : ∀ a b : ℤ, ((a : ℝ) / n, (b : ℝ) / n) ∈ G →
      (((-a : ℤ) : ℝ) / n, ((-b : ℤ) : ℝ) / n) ∈ G := by
    intro a b hab
    have h_in_H : ((a : ZMod n), (b : ZMod n)) ∈ H := (hG_int_iff a b).mp hab
    rw [hG_int_iff]
    have : (((-a : ℤ) : ZMod n), ((-b : ℤ) : ZMod n)) =
        -((a : ZMod n), (b : ZMod n)) := by
      ext
      · push_cast; simp
      · push_cast; simp
    rw [this]; exact H.neg_mem h_in_H
  -- From (12) + |j| ≤ βn: α·|j| < 1 + β·|i|.
  have h_j_alpha_bound : α * |(ij'.2 : ℝ)| < 1 + β * |(ij'.1 : ℝ)| := by
    have h_abs_i_nn : (0 : ℝ) ≤ |(ij'.1 : ℝ)| := abs_nonneg _
    have h_key : 2 / (n : ℝ) * |(ij'.1 : ℝ)| * |(ij'.2 : ℝ)| ≤
        2 * β * |(ij'.1 : ℝ)| := by
      have h_abs_j_nn : (0 : ℝ) ≤ |(ij'.2 : ℝ)| := abs_nonneg _
      have h_step : (2 / (n : ℝ)) * |(ij'.2 : ℝ)| ≤ 2 * β := by
        rw [div_mul_eq_mul_div, div_le_iff₀ hn_pos]
        linarith [hij'_β]
      nlinarith [h_step, h_abs_i_nn]
    linarith [h_bound, h_key]
  by_cases h_pos : 0 ≤ ij'.1
  swap
  · -- ij'.1 < 0: use (-ij'.1, -ij'.2).
    have h_neg_i : ij'.1 < 0 := by omega
    have h_i_abs : |(ij'.1 : ℝ)| = -(ij'.1 : ℝ) :=
      abs_of_neg (by exact_mod_cast h_neg_i)
    refine ⟨(-ij'.1, -ij'.2), ?_, ?_, by omega, ?_, ?_, ?_, ?_⟩
    · intro h_eq
      apply hij'_ne
      have h1 : -ij'.1 = 0 := congr_arg Prod.fst h_eq
      have h2 : -ij'.2 = 0 := congr_arg Prod.snd h_eq
      exact Prod.ext (by omega) (by omega)
    · have := hG_neg ij'.1 ij'.2 hij'_G
      convert this using 2 <;> push_cast <;> ring
    · push_cast
      linarith [hij'_i_lt]
    · have h_j_abs_ge : (ij'.2 : ℝ) ≤ |(ij'.2 : ℝ)| := le_abs_self _
      have h_α_j_le : α * (ij'.2 : ℝ) ≤ α * |(ij'.2 : ℝ)| :=
        mul_le_mul_of_nonneg_left h_j_abs_ge hα.le
      have h_total : α * (ij'.2 : ℝ) < 1 + β * (-(ij'.1 : ℝ)) := by
        rw [show β * (-(ij'.1 : ℝ)) = β * |(ij'.1 : ℝ)| from by rw [h_i_abs]]
        linarith [h_j_alpha_bound, h_α_j_le]
      have h_div : (ij'.2 : ℝ) < (1 + β * (-(ij'.1 : ℝ))) / α :=
        (lt_div_iff₀ hα).mpr (by linarith)
      have h_eq : (-1 : ℝ)/α - β/α * ((-ij'.1 : ℤ) : ℝ) =
          -((1 + β * (-(ij'.1 : ℝ))) / α) := by
        push_cast; field_simp; ring
      push_cast at h_eq ⊢
      linarith [h_div, h_eq]
    · have h_j_abs_ge : -(ij'.2 : ℝ) ≤ |(ij'.2 : ℝ)| := neg_le_abs _
      have h_α_j_lt : α * (-(ij'.2 : ℝ)) ≤ α * |(ij'.2 : ℝ)| :=
        mul_le_mul_of_nonneg_left h_j_abs_ge hα.le
      have h_total : α * (-(ij'.2 : ℝ)) < 1 + β * (-(ij'.1 : ℝ)) := by
        rw [show β * (-(ij'.1 : ℝ)) = β * |(ij'.1 : ℝ)| from by rw [h_i_abs]]
        linarith [h_j_alpha_bound, h_α_j_lt]
      have h_div : -(ij'.2 : ℝ) < (1 + β * (-(ij'.1 : ℝ))) / α :=
        (lt_div_iff₀ hα).mpr (by linarith)
      have h_eq : (1 : ℝ)/α + β/α * ((-ij'.1 : ℤ) : ℝ) =
          (1 + β * (-(ij'.1 : ℝ))) / α := by
        push_cast; field_simp
      push_cast at h_eq ⊢
      linarith [h_div, h_eq]
    · -- minimality is invariant under negation.
      intro kl hkl hk1 hk2 hcorner
      refine hij'_min kl hkl ?_ ?_ ?_
      · simpa [abs_neg] using hk1
      · simpa [abs_neg] using hk2
      · simpa [abs_neg] using hcorner
  · -- ij'.1 ≥ 0: use ij' itself.
    have h_i_abs : |(ij'.1 : ℝ)| = (ij'.1 : ℝ) :=
      abs_of_nonneg (by exact_mod_cast h_pos)
    refine ⟨ij', hij'_ne, hij'_G, h_pos, ?_, ?_, ?_, hij'_min⟩
    · linarith [hij'_i_lt]
    · have h_j_abs_ge : -(ij'.2 : ℝ) ≤ |(ij'.2 : ℝ)| := neg_le_abs _
      have h_α_j_lt : α * (-(ij'.2 : ℝ)) ≤ α * |(ij'.2 : ℝ)| :=
        mul_le_mul_of_nonneg_left h_j_abs_ge hα.le
      have h_total : α * (-(ij'.2 : ℝ)) < 1 + β * (ij'.1 : ℝ) := by
        rw [← h_i_abs]; linarith [h_j_alpha_bound, h_α_j_lt]
      have h_div : -(ij'.2 : ℝ) < (1 + β * (ij'.1 : ℝ)) / α :=
        (lt_div_iff₀ hα).mpr (by linarith)
      have h_eq : (-1 : ℝ)/α - β/α * (ij'.1 : ℝ) =
          -((1 + β * (ij'.1 : ℝ)) / α) := by
        field_simp; ring
      linarith [h_div, h_eq]
    · have h_j_le : (ij'.2 : ℝ) ≤ |(ij'.2 : ℝ)| := le_abs_self _
      have h_α_j_le : α * (ij'.2 : ℝ) ≤ α * |(ij'.2 : ℝ)| :=
        mul_le_mul_of_nonneg_left h_j_le hα.le
      have h_total : α * (ij'.2 : ℝ) < 1 + β * (ij'.1 : ℝ) := by
        rw [← h_i_abs]; linarith [h_j_alpha_bound, h_α_j_le]
      have h_div : (ij'.2 : ℝ) < (1 + β * (ij'.1 : ℝ)) / α :=
        (lt_div_iff₀ hα).mpr (by linarith)
      have h_eq : (1 : ℝ)/α + β/α * (ij'.1 : ℝ) =
          (1 + β * (ij'.1 : ℝ)) / α := by
        field_simp
      linarith [h_div, h_eq]

/-! ## Rectangle hit ⟹ lonely time (extracted bridge) -/

/-- **Rectangle hit ⟹ lonely time.** If the lifted group hits every
    `2/3 × 2/9` rectangle — in particular the anchored rectangle
    `[1/6, 5/6] × [7/18, 11/18]` — the §2 bridge produces a lonely time.
    Extracted from the Corollary-6 branch of `bhk_s7_main` so the
    exceptional-pair analysis (BHK (12) contrapositive) can reuse it. -/
lemma bhk_s7_rect_hit_lonely (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i)
    (hsmall : 3 * speeds ⟨0, by omega⟩ < speeds ⟨2, by omega⟩)
    (n c₃ c₁ g : ℕ) (hn1 : 1 < n) (hgpos : 0 < g)
    (hd : g * n = speeds ⟨2, by omega⟩ - speeds ⟨1, by omega⟩)
    (hc3 : g * c₃ = speeds ⟨2, by omega⟩)
    (hc1 : g * c₁ = speeds ⟨0, by omega⟩)
    (hAll : ∀ x₁ x₂,
      (bhkS7Group n c₃ c₁ ∩ bhkRectangle x₁ x₂ (2/3) (2/9)).Nonempty) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 6 := by
  set V1 : ℕ := speeds ⟨0, by omega⟩ with hV1_def
  set V2 : ℕ := speeds ⟨1, by omega⟩ with hV2_def
  set V3 : ℕ := speeds ⟨2, by omega⟩ with hV3_def
  have hV23 : V2 < V3 := hmono (Fin.mk_lt_mk.mpr (by omega))
  have hV1pos : 0 < V1 := hpos _
  have hV3pos : 0 < V3 := hpos _
  set D : ℕ := V3 - V2 with hD_def
  have hDpos : 0 < D := by omega
  have hD_cast : ((D : ℕ) : ℝ) = (V3 : ℝ) - V2 := by
    rw [hD_def, Nat.cast_sub hV23.le]
  have hnpos : 0 < n := by omega
  obtain ⟨p, hpG, hpR⟩ := hAll (1/6) (7/18)
  obtain ⟨k, hk1, hk2⟩ := bhk_s7_extract n c₃ c₁ hn1 p hpG
  obtain ⟨hpR1a, hpR1b, hpR2a, hpR2b⟩ := hpR
  -- Anchored fract conditions transfer to {p.1}, {p.2}.
  have hshift : ∀ x c : ℝ, Int.fract (x - c) = Int.fract (Int.fract x - c) := by
    intro x c
    conv_lhs => rw [← Int.fract_add_floor x]
    rw [show Int.fract x + (⌊x⌋ : ℝ) - c = Int.fract x - c + (⌊x⌋ : ℤ) from by
      push_cast; ring, Int.fract_add_intCast]
  have hu_win := bhk_fract_window (Int.fract p.1) (1/6) (2/3)
    (Int.fract_nonneg _) (Int.fract_lt_one _) (by norm_num) (by norm_num)
    (by rw [← hshift]; exact hpR1b)
  have hw_win := bhk_fract_window (Int.fract p.2) (7/18) (2/9)
    (Int.fract_nonneg _) (Int.fract_lt_one _) (by norm_num) (by norm_num)
    (by rw [← hshift]; exact hpR2b)
  -- The meeting time.
  set τ : ℝ := (k : ℝ) / D with hτ_def
  have hgR : (0 : ℝ) < g := by exact_mod_cast hgpos
  have hDR_pos : (0 : ℝ) < D := by exact_mod_cast hDpos
  have hDR : ((D : ℕ) : ℝ) = (g : ℝ) * n := by exact_mod_cast hd.symm
  have hV3R : ((V3 : ℕ) : ℝ) = (g : ℝ) * c₃ := by exact_mod_cast hc3.symm
  have hV1R : ((V1 : ℕ) : ℝ) = (g : ℝ) * c₁ := by exact_mod_cast hc1.symm
  have e3 : (V3 : ℝ) * τ = ((c₃ * k : ℕ) : ℝ) / n := by
    rw [hτ_def, hV3R, hDR]
    push_cast
    field_simp
  have e1 : (V1 : ℝ) * τ = ((c₁ * k : ℕ) : ℝ) / n := by
    rw [hτ_def, hV1R, hDR]
    push_cast
    field_simp
  have hu3 : Int.fract ((V3 : ℝ) * τ) = Int.fract p.1 := by rw [e3, hk1]
  have hw1 : Int.fract ((V1 : ℝ) * τ) = Int.fract p.2 := by rw [e1, hk2]
  have e2 : (V2 : ℝ) * τ = (V3 : ℝ) * τ - ((k : ℤ) : ℝ) := by
    have hV2R : (V2 : ℝ) = (V3 : ℝ) - D := by rw [hD_cast]; ring
    rw [hV2R, hτ_def]
    field_simp
    push_cast
    ring
  have h2eq : Int.fract ((V2 : ℝ) * τ) = Int.fract ((V3 : ℝ) * τ) := by
    rw [e2, Int.fract_sub_intCast]
  -- Window conditions (6) from the rectangle bounds and 3 V₁ < V₃.
  have hsmallR : 3 * (V1 : ℝ) < V3 := by exact_mod_cast hsmall
  have hV1Rpos : (0 : ℝ) < V1 := by exact_mod_cast hV1pos
  have hV3Rpos : (0 : ℝ) < V3 := by exact_mod_cast hV3pos
  have hu_lo : 1/6 ≤ Int.fract ((V3 : ℝ) * τ) := by rw [hu3]; exact hu_win.1
  have hu_hi : Int.fract ((V3 : ℝ) * τ) ≤ 5/6 := by
    rw [hu3]; have := hu_win.2; linarith
  have hterm_lo : (Int.fract ((V3 : ℝ) * τ) - 1/6) * (V1 : ℝ) / (V3 : ℝ) ≤ 2/9 := by
    rw [div_le_iff₀ hV3Rpos]
    have hb := mul_le_mul_of_nonneg_right
      (show Int.fract ((V3 : ℝ) * τ) - 1/6 ≤ 2/3 by linarith) hV1Rpos.le
    linarith
  have hterm_hi : (5/6 - Int.fract ((V3 : ℝ) * τ)) * (V1 : ℝ) / (V3 : ℝ) ≤ 2/9 := by
    rw [div_le_iff₀ hV3Rpos]
    have hb := mul_le_mul_of_nonneg_right
      (show 5/6 - Int.fract ((V3 : ℝ) * τ) ≤ 2/3 by linarith) hV1Rpos.le
    linarith
  have hw_lo : 1/6 + (Int.fract ((V3 : ℝ) * τ) - 1/6) * (V1 : ℝ) / (V3 : ℝ)
      ≤ Int.fract ((V1 : ℝ) * τ) := by
    rw [hw1]
    have := hw_win.1
    linarith
  have hw_hi : Int.fract ((V1 : ℝ) * τ)
      ≤ 5/6 - (5/6 - Int.fract ((V3 : ℝ) * τ)) * (V1 : ℝ) / (V3 : ℝ) := by
    rw [hw1]
    have := hw_win.2
    linarith
  exact bhk_s7_window_lonely speeds hmono hpos τ hu_lo hu_hi h2eq hw_lo hw_hi

/-! ## The exceptional group `G₄` — covering analysis (BHK pp. 43–44)

Point-based reconstruction of BHK's "4-block flanked by two consecutive
5-blocks" argument. All block bookkeeping goes through
`block_containment` / `block_length_bound` / `not_mem_unsafeOf_of_in_gap`
from `IntLRC_6_BHK_Lemma4.lean`; no measure theory. -/

/-- **Single 4-block dichotomy.** If `[a, b]` is covered by `U₄ ∪ U₅` then
    either no point of `[a, b]` is 4-unsafe, or all its 4-unsafe points lie
    in one 4-block `(m - 1/6, m + 1/6)` (in `v₄`-coordinates), witnessed by
    at least one point. Otherwise the full 4-gap between two distinct
    occupied 4-blocks sits inside `[a, b]`, is 4-safe hence ⊆ `U₅`, and
    `block_length_bound` forces `2 v₅ < v₄` — impossible. -/
lemma bhk_g4_single_block (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i) (a b : ℝ)
    (hI : Set.Icc a b ⊆ unsafeOf speeds ⟨3, by omega⟩ ∪ unsafeOf speeds ⟨4, by omega⟩) :
    (∀ t ∈ Set.Icc a b, t ∉ unsafeOf speeds ⟨3, by omega⟩) ∨
    ∃ m : ℤ, (∃ t₀ ∈ Set.Icc a b, t₀ ∈ unsafeOf speeds ⟨3, by omega⟩) ∧
      ∀ t ∈ Set.Icc a b, t ∈ unsafeOf speeds ⟨3, by omega⟩ →
        (m : ℝ) - 1/6 < (speeds ⟨3, by omega⟩ : ℝ) * t ∧
        (speeds ⟨3, by omega⟩ : ℝ) * t < (m : ℝ) + 1/6 := by
  have hv4pos : (0 : ℝ) < (speeds ⟨3, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv5pos : (0 : ℝ) < (speeds ⟨4, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv45 : (speeds ⟨3, by omega⟩ : ℝ) < (speeds ⟨4, by omega⟩ : ℝ) := by
    have hflt : (⟨3, by omega⟩ : Fin 5) < ⟨4, by omega⟩ :=
      Fin.mk_lt_mk.mpr (by omega)
    exact_mod_cast hmono hflt
  by_cases hne4 : ∃ t₀ ∈ Set.Icc a b, t₀ ∈ unsafeOf speeds ⟨3, by omega⟩
  · right
    obtain ⟨t₀, ht₀I, ht₀U⟩ := hne4
    have ht₀U' := ht₀U
    rw [mem_unsafeOf_iff_bhkB] at ht₀U'
    obtain ⟨m, hm⟩ := ht₀U'
    refine ⟨m, ⟨t₀, ht₀I, ht₀U⟩, ?_⟩
    intro t htI htU
    have htU' := htU
    rw [mem_unsafeOf_iff_bhkB] at htU'
    obtain ⟨m', hm'⟩ := htU'
    -- If m' = m we are done; otherwise derive `2 v₅ < v₄`, a contradiction.
    rcases eq_or_ne m' m with rfl | hne
    · exact ⟨by have := neg_lt_of_abs_lt hm'; linarith,
             by have := lt_of_abs_lt hm'; linarith⟩
    exfalso
    -- Order the two blocks: (mℓ, tℓ) low block/point, (mh, th) high.
    obtain ⟨mℓ, mh, tℓ, th, hmlh, hℓ, hh, htℓI, hthI⟩ :
        ∃ (mℓ mh : ℤ) (tℓ th : ℝ), mℓ < mh ∧
          |(speeds ⟨3, by omega⟩ : ℝ) * tℓ - mℓ| < 1/6 ∧
          |(speeds ⟨3, by omega⟩ : ℝ) * th - mh| < 1/6 ∧
          tℓ ∈ Set.Icc a b ∧ th ∈ Set.Icc a b := by
      rcases lt_or_gt_of_ne hne with h | h
      · exact ⟨m', m, t, t₀, h, hm', hm, htI, ht₀I⟩
      · exact ⟨m, m', t₀, t, h, hm, hm', ht₀I, htI⟩
    -- The 4-gap after block mℓ lies between tℓ and th, hence inside [a, b].
    set gL : ℝ := ((mℓ : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ) with hgL_def
    set gR : ℝ := ((mℓ : ℝ) + 5/6) / (speeds ⟨3, by omega⟩ : ℝ) with hgR_def
    have hmh : (mℓ : ℝ) + 1 ≤ (mh : ℝ) := by exact_mod_cast hmlh
    have htℓ_lt : tℓ < gL := by
      rw [hgL_def, lt_div_iff₀ hv4pos]
      have := lt_of_abs_lt hℓ; linarith
    have hth_gt : gR < th := by
      rw [hgR_def, div_lt_iff₀ hv4pos]
      have := neg_lt_of_abs_lt hh; linarith
    have hgLR : gL ≤ gR := by
      rw [hgL_def, hgR_def, div_le_div_iff₀ hv4pos hv4pos]
      nlinarith
    -- The closed gap [gL, gR] is 4-safe and inside [a, b], hence ⊆ U₅.
    have hgap_sub : Set.Icc gL gR ⊆ unsafeOf speeds ⟨4, by omega⟩ := by
      intro s hs
      have hsI : s ∈ Set.Icc a b :=
        ⟨le_trans htℓI.1 (le_trans htℓ_lt.le hs.1),
         le_trans hs.2 (le_trans hth_gt.le hthI.2)⟩
      have hs4 : s ∉ unsafeOf speeds ⟨3, by omega⟩ :=
        not_mem_unsafeOf_of_in_gap speeds ⟨3, by omega⟩ (hpos _) mℓ s hs.1 hs.2
      rcases hI hsI with h | h
      · exact absurd h hs4
      · exact h
    have hlen := block_length_bound speeds ⟨4, by omega⟩ (hpos _) gL gR hgLR hgap_sub
    -- gR - gL = (2/3)/v₄ < 1/(3 v₅) ⟹ 2 v₅ < v₄ < v₅: contradiction.
    have hglen : gR - gL = (2/3) / (speeds ⟨3, by omega⟩ : ℝ) := by
      rw [hgR_def, hgL_def]
      field_simp
      ring
    rw [hglen, div_lt_div_iff₀ hv4pos (by positivity)] at hlen
    nlinarith
  · left
    intro t htI htU
    exact hne4 ⟨t, htI, htU⟩

/-- **Covering `t* = 1/(6 v₁)` forces `5 v₁ < v₅`** (BHK: "in order to cover
    the point `t = x₁/6` we must have `x₅ < x₁/5`"). At `t*` every runner `j`
    sits at `v_j/(6 v₁) ≥ 1/6`, so whichever runner covers `t*` has its block
    index `m ≥ 1`, forcing `v_j > 5 v₁`; monotonicity lifts this to `v₅`. -/
lemma bhk_g4_five_v1 (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i)
    (hne : ∀ t : ℝ, ∃ i, circDist ((speeds i : ℝ) * t) < 1/6) :
    5 * (speeds ⟨0, by omega⟩ : ℝ) < (speeds ⟨4, by omega⟩ : ℝ) := by
  have hv1pos : (0 : ℝ) < (speeds ⟨0, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  set tstar : ℝ := 1 / (6 * (speeds ⟨0, by omega⟩ : ℝ)) with htstar_def
  obtain ⟨i, hi⟩ := hne tstar
  have hi_unsafe : tstar ∈ unsafeOf speeds i := (mem_unsafeOf_iff speeds i tstar).mpr hi
  rw [mem_unsafeOf_iff_bhkB] at hi_unsafe
  obtain ⟨m, hm⟩ := hi_unsafe
  -- v₁ ≤ v_i ≤ v₅ by monotonicity.
  have hv1i : (speeds ⟨0, by omega⟩ : ℝ) ≤ (speeds i : ℝ) := by
    exact_mod_cast hmono.monotone (show (⟨0, by omega⟩ : Fin 5) ≤ i from i.zero_le)
  have hvi5 : (speeds i : ℝ) ≤ (speeds ⟨4, by omega⟩ : ℝ) := by
    exact_mod_cast hmono.monotone (show i ≤ (⟨4, by omega⟩ : Fin 5) from i.le_last)
  have hx_eq : (speeds i : ℝ) * tstar =
      (speeds i : ℝ) / (6 * (speeds ⟨0, by omega⟩ : ℝ)) := by
    rw [htstar_def]; ring
  rw [hx_eq] at hm
  -- The position is ≥ 1/6, so the covering block index m is ≥ 1.
  have hx_ge : 1/6 ≤ (speeds i : ℝ) / (6 * (speeds ⟨0, by omega⟩ : ℝ)) := by
    rw [le_div_iff₀ (by positivity)]
    linarith
  have hm1R : (1 : ℝ) ≤ (m : ℝ) := by
    have hup := lt_of_abs_lt hm
    by_contra hm0
    push_neg at hm0
    have : (m : ℝ) ≤ 0 := by
      have : m ≤ 0 := by exact_mod_cast Int.lt_add_one_iff.mp (by exact_mod_cast hm0)
      exact_mod_cast this
    linarith
  -- v_i/(6 v₁) > m - 1/6 ≥ 5/6 ⟹ v_i > 5 v₁ ⟹ v₅ > 5 v₁.
  have hlow := neg_lt_of_abs_lt hm
  have h56 : 5/6 < (speeds i : ℝ) / (6 * (speeds ⟨0, by omega⟩ : ℝ)) := by
    linarith
  rw [div_lt_div_iff₀ (by positivity) (by positivity)] at h56
  linarith

/-- **The `G₄` 123-gap.** If at time `τ` the fractional positions are
    `{v₁τ} = 1/4`, `{v₂τ} = {v₃τ} = 1/2`, then on the whole interval
    `[τ - 1/(12 v₁), τ + 1/(3 v₃)]` runners 1, 2, 3 stay safe
    (BHK: `I = [kt₀ - x₁/12, kt₀ + 1/3]` is a 123-gap). Uses
    `3 v₁ < v₃ < 4 v₁` so that the slower runners cannot wrap. -/
lemma bhk_g4_123_gap (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i)
    (hsmall : 3 * speeds ⟨0, by omega⟩ < speeds ⟨2, by omega⟩)
    (h41 : speeds ⟨2, by omega⟩ < 4 * speeds ⟨0, by omega⟩)
    (τ : ℝ)
    (hf1 : Int.fract ((speeds ⟨0, by omega⟩ : ℝ) * τ) = 1/4)
    (hf2 : Int.fract ((speeds ⟨1, by omega⟩ : ℝ) * τ) = 1/2)
    (hf3 : Int.fract ((speeds ⟨2, by omega⟩ : ℝ) * τ) = 1/2)
    (t : ℝ)
    (ht : t ∈ Set.Icc (τ - 1/(12 * (speeds ⟨0, by omega⟩ : ℝ)))
                      (τ + 1/(3 * (speeds ⟨2, by omega⟩ : ℝ)))) :
    t ∉ unsafeOf speeds ⟨0, by omega⟩ ∧ t ∉ unsafeOf speeds ⟨1, by omega⟩ ∧
    t ∉ unsafeOf speeds ⟨2, by omega⟩ := by
  have hv1pos : (0 : ℝ) < (speeds ⟨0, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv2pos : (0 : ℝ) < (speeds ⟨1, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv3pos : (0 : ℝ) < (speeds ⟨2, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv12 : (speeds ⟨0, by omega⟩ : ℝ) < (speeds ⟨1, by omega⟩ : ℝ) := by
    exact_mod_cast hmono (Fin.mk_lt_mk.mpr (by omega : (0:ℕ) < 1))
  have hv23 : (speeds ⟨1, by omega⟩ : ℝ) < (speeds ⟨2, by omega⟩ : ℝ) := by
    exact_mod_cast hmono (Fin.mk_lt_mk.mpr (by omega : (1:ℕ) < 2))
  have hsmallR : 3 * (speeds ⟨0, by omega⟩ : ℝ) < (speeds ⟨2, by omega⟩ : ℝ) := by
    exact_mod_cast hsmall
  have h41R : (speeds ⟨2, by omega⟩ : ℝ) < 4 * (speeds ⟨0, by omega⟩ : ℝ) := by
    exact_mod_cast h41
  obtain ⟨ht_lo, ht_hi⟩ := ht
  -- Generic safety step: runner with fract position f at τ, staying within
  -- [f - 1/3·(v/v wraps)] — done per runner with explicit floor anchors.
  have key : ∀ j : Fin 5, ∀ f : ℝ, Int.fract ((speeds j : ℝ) * τ) = f →
      1/6 ≤ f - (speeds j : ℝ) / (12 * (speeds ⟨0, by omega⟩ : ℝ)) →
      f + (speeds j : ℝ) / (3 * (speeds ⟨2, by omega⟩ : ℝ)) ≤ 5/6 →
      t ∉ unsafeOf speeds j := by
    intro j f hf hlo hhi
    have hvjpos : (0 : ℝ) < (speeds j : ℝ) := by exact_mod_cast hpos _
    have hfloor : ((⌊(speeds j : ℝ) * τ⌋ : ℝ)) + f = (speeds j : ℝ) * τ := by
      rw [← hf]; exact Int.floor_add_fract _
    apply not_mem_unsafeOf_of_in_gap speeds j (hpos _) ⌊(speeds j : ℝ) * τ⌋ t
    · rw [div_le_iff₀ hvjpos]
      have h1 : (speeds j : ℝ) * t ≥ (speeds j : ℝ) * τ -
          (speeds j : ℝ) / (12 * (speeds ⟨0, by omega⟩ : ℝ)) := by
        have := mul_le_mul_of_nonneg_left ht_lo (le_of_lt hvjpos)
        have hxx : (speeds j : ℝ) * (τ - 1/(12 * (speeds ⟨0, by omega⟩ : ℝ))) =
            (speeds j : ℝ) * τ - (speeds j : ℝ) / (12 * (speeds ⟨0, by omega⟩ : ℝ)) := by
          ring
        linarith [hxx ▸ this]
      nlinarith [h1, hfloor, hlo]
    · rw [le_div_iff₀ hvjpos]
      have h2 : (speeds j : ℝ) * t ≤ (speeds j : ℝ) * τ +
          (speeds j : ℝ) / (3 * (speeds ⟨2, by omega⟩ : ℝ)) := by
        have := mul_le_mul_of_nonneg_left ht_hi (le_of_lt hvjpos)
        have hxx : (speeds j : ℝ) * (τ + 1/(3 * (speeds ⟨2, by omega⟩ : ℝ))) =
            (speeds j : ℝ) * τ + (speeds j : ℝ) / (3 * (speeds ⟨2, by omega⟩ : ℝ)) := by
          ring
        linarith [hxx ▸ this]
      nlinarith [h2, hfloor, hhi]
  refine ⟨key _ (1/4) hf1 ?_ ?_, key _ (1/2) hf2 ?_ ?_, key _ (1/2) hf3 ?_ ?_⟩
  · -- 1/6 ≤ 1/4 - v₁/(12 v₁) = 1/4 - 1/12
    have : (speeds ⟨0, by omega⟩ : ℝ) / (12 * (speeds ⟨0, by omega⟩ : ℝ)) = 1/12 := by
      field_simp
    rw [this]; norm_num
  · -- 1/4 + v₁/(3 v₃) ≤ 1/4 + 1/9 ≤ 5/6 since 3 v₁ < v₃
    have : (speeds ⟨0, by omega⟩ : ℝ) / (3 * (speeds ⟨2, by omega⟩ : ℝ)) ≤ 1/9 := by
      rw [div_le_iff₀ (by positivity)]
      linarith
    linarith
  · -- 1/6 ≤ 1/2 - v₂/(12 v₁) since v₂ < 4 v₁
    have : (speeds ⟨1, by omega⟩ : ℝ) / (12 * (speeds ⟨0, by omega⟩ : ℝ)) ≤ 1/3 := by
      rw [div_le_iff₀ (by positivity)]
      linarith
    linarith
  · -- 1/2 + v₂/(3 v₃) ≤ 1/2 + 1/3 = 5/6 since v₂ < v₃
    have : (speeds ⟨1, by omega⟩ : ℝ) / (3 * (speeds ⟨2, by omega⟩ : ℝ)) ≤ 1/3 := by
      rw [div_le_iff₀ (by positivity)]
      linarith
    linarith
  · -- 1/6 ≤ 1/2 - v₃/(12 v₁) since v₃ < 4 v₁
    have : (speeds ⟨2, by omega⟩ : ℝ) / (12 * (speeds ⟨0, by omega⟩ : ℝ)) ≤ 1/3 := by
      rw [div_le_iff₀ (by positivity)]
      linarith
    linarith
  · -- 1/2 + v₃/(3 v₃) = 1/2 + 1/3 = 5/6
    have : (speeds ⟨2, by omega⟩ : ℝ) / (3 * (speeds ⟨2, by omega⟩ : ℝ)) = 1/3 := by
      field_simp
    rw [this]; norm_num

set_option maxHeartbeats 1600000 in
/-- **The flanking bounds.** If an interval of length `1/(12 v₁) + 1/(3 v₃)`
    is covered by `U₄ ∪ U₅` and `5 v₁ < v₅` (the `t*` argument), then BHK's
    covering analysis forces a single 4-block flanked by two *consecutive*
    5-blocks, pinning `2 v₄ < v₅` and `7 v₅ < 16 v₃`. All degenerate block
    positions contradict the interval length. -/
lemma bhk_g4_flanking (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i)
    (hsmall : 3 * speeds ⟨0, by omega⟩ < speeds ⟨2, by omega⟩)
    (hv15 : 5 * (speeds ⟨0, by omega⟩ : ℝ) < (speeds ⟨4, by omega⟩ : ℝ))
    (A B : ℝ)
    (hAB : B - A = 1/(12 * (speeds ⟨0, by omega⟩ : ℝ)) +
                   1/(3 * (speeds ⟨2, by omega⟩ : ℝ)))
    (hsub : Set.Icc A B ⊆
      unsafeOf speeds ⟨3, by omega⟩ ∪ unsafeOf speeds ⟨4, by omega⟩) :
    2 * (speeds ⟨3, by omega⟩ : ℝ) < (speeds ⟨4, by omega⟩ : ℝ) ∧
    7 * (speeds ⟨4, by omega⟩ : ℝ) < 16 * (speeds ⟨2, by omega⟩ : ℝ) := by
  have hv1pos : (0 : ℝ) < (speeds ⟨0, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv3pos : (0 : ℝ) < (speeds ⟨2, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv4pos : (0 : ℝ) < (speeds ⟨3, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv5pos : (0 : ℝ) < (speeds ⟨4, by omega⟩ : ℝ) := by exact_mod_cast hpos _
  have hv34 : (speeds ⟨2, by omega⟩ : ℝ) < (speeds ⟨3, by omega⟩ : ℝ) := by
    exact_mod_cast hmono (Fin.mk_lt_mk.mpr (by omega : (2:ℕ) < 3))
  have hv45 : (speeds ⟨3, by omega⟩ : ℝ) < (speeds ⟨4, by omega⟩ : ℝ) := by
    exact_mod_cast hmono (Fin.mk_lt_mk.mpr (by omega : (3:ℕ) < 4))
  have hsmallR : 3 * (speeds ⟨0, by omega⟩ : ℝ) < (speeds ⟨2, by omega⟩ : ℝ) := by
    exact_mod_cast hsmall
  have hALB : A < B := by
    have h0 : (0:ℝ) < 1/(12 * (speeds ⟨0, by omega⟩ : ℝ)) +
        1/(3 * (speeds ⟨2, by omega⟩ : ℝ)) := by positivity
    linarith [hAB ▸ h0]
  -- Length lower bounds: B − A > 1/(3 v₃) and B − A > 7/(12 v₃).
  have hL_3 : 1/(3 * (speeds ⟨2, by omega⟩ : ℝ)) < B - A := by
    have h0 : (0:ℝ) < 1/(12 * (speeds ⟨0, by omega⟩ : ℝ)) := by positivity
    linarith [hAB]
  have hL_7 : 7/(12 * (speeds ⟨2, by omega⟩ : ℝ)) < B - A := by
    have h14 : 1/(4 * (speeds ⟨2, by omega⟩ : ℝ)) <
        1/(12 * (speeds ⟨0, by omega⟩ : ℝ)) := by
      rw [div_lt_div_iff₀ (by positivity) (by positivity)]
      linarith
    have hsplit : (7:ℝ)/(12 * (speeds ⟨2, by omega⟩ : ℝ)) =
        1/(4 * (speeds ⟨2, by omega⟩ : ℝ)) +
        1/(3 * (speeds ⟨2, by omega⟩ : ℝ)) := by ring
    rw [hsplit, hAB]
    linarith
  -- Comparison of block lengths.
  have h35 : 1/(3 * (speeds ⟨4, by omega⟩ : ℝ)) <
      1/(3 * (speeds ⟨2, by omega⟩ : ℝ)) := by
    rw [div_lt_div_iff₀ (by positivity) (by positivity)]
    nlinarith
  have h34len : 1/(3 * (speeds ⟨3, by omega⟩ : ℝ)) <
      1/(3 * (speeds ⟨2, by omega⟩ : ℝ)) := by
    rw [div_lt_div_iff₀ (by positivity) (by positivity)]
    nlinarith
  rcases bhk_g4_single_block speeds hmono hpos A B hsub with hno4 | ⟨m, hwit, hall⟩
  · -- No 4-unsafe point: I sits in one 5-block, too short.
    exfalso
    have h5sub : Set.Icc A B ⊆ unsafeOf speeds ⟨4, by omega⟩ := by
      intro s hs
      rcases hsub hs with h | h
      · exact absurd h (hno4 s hs)
      · exact h
    have hlen := block_length_bound speeds ⟨4, by omega⟩ (hpos _) A B hALB.le h5sub
    linarith
  obtain ⟨t₀, ht₀I, ht₀U⟩ := hwit
  have ht₀m := hall t₀ ht₀I ht₀U
  -- Any point of I outside the open 4-block window is 5-unsafe.
  have h5of : ∀ s, s ∈ Set.Icc A B →
      ¬((m : ℝ) - 1/6 < (speeds ⟨3, by omega⟩ : ℝ) * s ∧
        (speeds ⟨3, by omega⟩ : ℝ) * s < (m : ℝ) + 1/6) →
      s ∈ unsafeOf speeds ⟨4, by omega⟩ := by
    intro s hs hnot
    rcases hsub hs with h | h
    · exact absurd (hall s hs h) hnot
    · exact h
  rcases le_or_gt ((m : ℝ) - 1/6) ((speeds ⟨3, by omega⟩ : ℝ) * A) with hpA | hAp <;>
    rcases le_or_gt ((speeds ⟨3, by omega⟩ : ℝ) * B) ((m : ℝ) + 1/6) with hBq | hqB
  · -- 4-block swallows I: I too long.
    exfalso
    have hBA : B - A ≤ 1/(3 * (speeds ⟨3, by omega⟩ : ℝ)) := by
      rw [le_div_iff₀ (by positivity)]
      nlinarith
    linarith
  · -- 4-block covers the left end: right tail in one 5-block, forces v₅ < 4 v₁.
    exfalso
    have hq_lt_B : ((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ) < B := by
      rw [div_lt_iff₀ hv4pos]
      nlinarith
    have hA_le_q : A ≤ ((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ) := by
      rw [le_div_iff₀ hv4pos]
      have h0 := mul_le_mul_of_nonneg_left ht₀I.1 hv4pos.le
      nlinarith [ht₀m.2]
    have h5tail : Set.Icc (((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ)) B ⊆
        unsafeOf speeds ⟨4, by omega⟩ := by
      intro s hs
      have hsI : s ∈ Set.Icc A B := ⟨le_trans hA_le_q hs.1, hs.2⟩
      apply h5of s hsI
      rintro ⟨-, hup⟩
      have h1 := (div_le_iff₀ hv4pos).mp hs.1
      linarith [mul_comm s (speeds ⟨3, by omega⟩ : ℝ)]
    have hlen := block_length_bound speeds ⟨4, by omega⟩ (hpos _) _ B
      hq_lt_B.le h5tail
    -- q − A ≤ 1/(3 v₄), so 1/(12 v₁) < 1/(3 v₅): v₅ < 4 v₁, against 5 v₁ < v₅.
    have hq_eq : (speeds ⟨3, by omega⟩ : ℝ) *
        (((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ)) = (m : ℝ) + 1/6 := by
      field_simp
    have hqA : ((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ) - A ≤
        1/(3 * (speeds ⟨3, by omega⟩ : ℝ)) := by
      have hexp : (speeds ⟨3, by omega⟩ : ℝ) *
          (((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ) - A) =
          (speeds ⟨3, by omega⟩ : ℝ) *
            (((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ)) -
          (speeds ⟨3, by omega⟩ : ℝ) * A := by ring
      have h1 : (speeds ⟨3, by omega⟩ : ℝ) *
          (((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ) - A) ≤ 1/3 := by
        rw [hexp, hq_eq]
        linarith
      rw [le_div_iff₀ (by positivity)]
      have hexp2 : (((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ) - A) *
          (3 * (speeds ⟨3, by omega⟩ : ℝ)) =
          3 * ((speeds ⟨3, by omega⟩ : ℝ) *
            (((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ) - A)) := by ring
      rw [hexp2]
      linarith
    have h15 : 1/(12 * (speeds ⟨0, by omega⟩ : ℝ)) <
        1/(3 * (speeds ⟨4, by omega⟩ : ℝ)) := by
      linarith [hAB]
    rw [div_lt_div_iff₀ (by positivity) (by positivity)] at h15
    linarith
  · -- 4-block covers the right end: symmetric, left head in one 5-block.
    exfalso
    have hA_lt_p : A < ((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ) := by
      rw [lt_div_iff₀ hv4pos]
      nlinarith
    have hp_le_B : ((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ) ≤ B := by
      rw [div_le_iff₀ hv4pos]
      have h0 := mul_le_mul_of_nonneg_left ht₀I.2 hv4pos.le
      nlinarith [ht₀m.1]
    have h5head : Set.Icc A (((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ)) ⊆
        unsafeOf speeds ⟨4, by omega⟩ := by
      intro s hs
      have hsI : s ∈ Set.Icc A B := ⟨hs.1, le_trans hs.2 hp_le_B⟩
      apply h5of s hsI
      rintro ⟨hlo, -⟩
      have h1 := (le_div_iff₀ hv4pos).mp hs.2
      linarith [mul_comm s (speeds ⟨3, by omega⟩ : ℝ)]
    have hlen := block_length_bound speeds ⟨4, by omega⟩ (hpos _) A _
      hA_lt_p.le h5head
    have hp_eq : (speeds ⟨3, by omega⟩ : ℝ) *
        (((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ)) = (m : ℝ) - 1/6 := by
      field_simp
    have hpB : B - ((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ) ≤
        1/(3 * (speeds ⟨3, by omega⟩ : ℝ)) := by
      have hexp : (speeds ⟨3, by omega⟩ : ℝ) *
          (B - ((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ)) =
          (speeds ⟨3, by omega⟩ : ℝ) * B -
          (speeds ⟨3, by omega⟩ : ℝ) *
            (((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ)) := by ring
      have h1 : (speeds ⟨3, by omega⟩ : ℝ) *
          (B - ((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ)) ≤ 1/3 := by
        rw [hexp, hp_eq]
        linarith
      rw [le_div_iff₀ (by positivity)]
      have hexp2 : (B - ((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ)) *
          (3 * (speeds ⟨3, by omega⟩ : ℝ)) =
          3 * ((speeds ⟨3, by omega⟩ : ℝ) *
            (B - ((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ))) := by ring
      rw [hexp2]
      linarith
    have h15 : 1/(12 * (speeds ⟨0, by omega⟩ : ℝ)) <
        1/(3 * (speeds ⟨4, by omega⟩ : ℝ)) := by
      linarith [hAB]
    rw [div_lt_div_iff₀ (by positivity) (by positivity)] at h15
    linarith
  · -- Interior 4-block: head and tail are 5-covered; analyse the 5-block indices.
    have hA_lt_p : A < ((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ) := by
      rw [lt_div_iff₀ hv4pos]
      nlinarith
    have hq_lt_B : ((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ) < B := by
      rw [div_lt_iff₀ hv4pos]
      nlinarith
    have hp_eq : (speeds ⟨3, by omega⟩ : ℝ) *
        (((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ)) = (m : ℝ) - 1/6 := by
      field_simp
    have hq_eq : (speeds ⟨3, by omega⟩ : ℝ) *
        (((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ)) = (m : ℝ) + 1/6 := by
      field_simp
    have hpq : ((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ) <
        ((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ) := by
      rw [div_lt_div_iff₀ hv4pos hv4pos]
      nlinarith
    have h5head : Set.Icc A (((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ)) ⊆
        unsafeOf speeds ⟨4, by omega⟩ := by
      intro s hs
      have hsB : s ≤ B := le_trans hs.2 (le_trans hpq.le hq_lt_B.le)
      apply h5of s ⟨hs.1, hsB⟩
      rintro ⟨hlo, -⟩
      have h1 := (le_div_iff₀ hv4pos).mp hs.2
      linarith [mul_comm s (speeds ⟨3, by omega⟩ : ℝ)]
    have h5tail : Set.Icc (((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ)) B ⊆
        unsafeOf speeds ⟨4, by omega⟩ := by
      intro s hs
      have hsA : A ≤ s := le_trans (le_trans hA_lt_p.le hpq.le) hs.1
      apply h5of s ⟨hsA, hs.2⟩
      rintro ⟨-, hup⟩
      have h1 := (div_le_iff₀ hv4pos).mp hs.1
      linarith [mul_comm s (speeds ⟨3, by omega⟩ : ℝ)]
    obtain ⟨k₁, hk₁A, hk₁p⟩ := block_containment speeds ⟨4, by omega⟩ (hpos _)
      A _ hA_lt_p.le h5head
    obtain ⟨k₂, hk₂q, hk₂B⟩ := block_containment speeds ⟨4, by omega⟩ (hpos _)
      _ B hq_lt_B.le h5tail
    -- v₅ A < k₁ + 1/6 and k₂ − 1/6 < v₅ B (via the head/tail endpoints).
    have hv5Ap : (speeds ⟨4, by omega⟩ : ℝ) * A ≤ (speeds ⟨4, by omega⟩ : ℝ) *
        (((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ)) :=
      mul_le_mul_of_nonneg_left hA_lt_p.le hv5pos.le
    have hv5qB : (speeds ⟨4, by omega⟩ : ℝ) *
        (((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ)) ≤
        (speeds ⟨4, by omega⟩ : ℝ) * B :=
      mul_le_mul_of_nonneg_left hq_lt_B.le hv5pos.le
    -- k₁ ≤ k₂.
    have hk12 : k₁ ≤ k₂ := by
      by_contra hcon
      push_neg at hcon
      have hcast : (k₂ : ℝ) + 1 ≤ (k₁ : ℝ) := by exact_mod_cast hcon
      have hABv : (speeds ⟨4, by omega⟩ : ℝ) * A ≤ (speeds ⟨4, by omega⟩ : ℝ) * B :=
        mul_le_mul_of_nonneg_left hALB.le hv5pos.le
      linarith [hk₁A, hk₂B]
    rcases eq_or_lt_of_le hk12 with rfl | hk12'
    · -- Same 5-block: I too short.
      exfalso
      have hBA : B - A < 1/(3 * (speeds ⟨4, by omega⟩ : ℝ)) := by
        rw [lt_div_iff₀ (by positivity)]
        nlinarith [hk₁A, hk₂B, hk₁p, hk₂q, hv5Ap, hv5qB]
      linarith
    have hk21 : k₁ + 1 ≤ k₂ := hk12'
    rcases eq_or_lt_of_le hk21 with heq | hge2
    · -- Consecutive 5-blocks: the main configuration. Derive both bounds.
      have hcast : (k₂ : ℝ) = (k₁ : ℝ) + 1 := by exact_mod_cast heq.symm
      -- Bound 2: B − A < 4/(3 v₅) gives 7 v₅ < 16 v₃.
      have hBA45 : B - A < 4/(3 * (speeds ⟨4, by omega⟩ : ℝ)) := by
        rw [lt_div_iff₀ (by positivity)]
        nlinarith [hk₁A, hk₂B]
      have hbound2 : 7 * (speeds ⟨4, by omega⟩ : ℝ) <
          16 * (speeds ⟨2, by omega⟩ : ℝ) := by
        have h74 := lt_trans hL_7 hBA45
        rw [div_lt_div_iff₀ (by positivity) (by positivity)] at h74
        linarith
      -- Bound 1: the 5-gap between the consecutive blocks sits inside the
      -- 4-block, so 2/(3 v₅) < 1/(3 v₄), i.e. 2 v₄ < v₅.
      have hs₁_eq : (speeds ⟨4, by omega⟩ : ℝ) *
          (((k₁ : ℝ) + 1/6) / (speeds ⟨4, by omega⟩ : ℝ)) = (k₁ : ℝ) + 1/6 := by
        field_simp
      have hs₂_eq : (speeds ⟨4, by omega⟩ : ℝ) *
          (((k₁ : ℝ) + 5/6) / (speeds ⟨4, by omega⟩ : ℝ)) = (k₁ : ℝ) + 5/6 := by
        field_simp
      have hs₁I : ((k₁ : ℝ) + 1/6) / (speeds ⟨4, by omega⟩ : ℝ) ∈ Set.Icc A B := by
        constructor
        · rw [le_div_iff₀ hv5pos]
          nlinarith [hk₁p, hv5Ap, hp_eq]
        · rw [div_le_iff₀ hv5pos]
          nlinarith [hk₂q, hv5qB, hq_eq]
      have hs₂I : ((k₁ : ℝ) + 5/6) / (speeds ⟨4, by omega⟩ : ℝ) ∈ Set.Icc A B := by
        constructor
        · rw [le_div_iff₀ hv5pos]
          nlinarith [hk₁p, hv5Ap, hp_eq]
        · rw [div_le_iff₀ hv5pos]
          nlinarith [hk₂q, hv5qB, hq_eq]
      have hs₁n5 : ((k₁ : ℝ) + 1/6) / (speeds ⟨4, by omega⟩ : ℝ) ∉
          unsafeOf speeds ⟨4, by omega⟩ := by
        apply not_mem_unsafeOf_of_in_gap speeds _ (hpos _) k₁
        · exact le_refl _
        · rw [div_le_div_iff₀ hv5pos hv5pos]
          nlinarith
      have hs₂n5 : ((k₁ : ℝ) + 5/6) / (speeds ⟨4, by omega⟩ : ℝ) ∉
          unsafeOf speeds ⟨4, by omega⟩ := by
        apply not_mem_unsafeOf_of_in_gap speeds _ (hpos _) k₁
        · rw [div_le_div_iff₀ hv5pos hv5pos]
          nlinarith
        · exact le_refl _
      have hs₁4 : ((k₁ : ℝ) + 1/6) / (speeds ⟨4, by omega⟩ : ℝ) ∈
          unsafeOf speeds ⟨3, by omega⟩ := by
        rcases hsub hs₁I with h | h
        · exact h
        · exact absurd h hs₁n5
      have hs₂4 : ((k₁ : ℝ) + 5/6) / (speeds ⟨4, by omega⟩ : ℝ) ∈
          unsafeOf speeds ⟨3, by omega⟩ := by
        rcases hsub hs₂I with h | h
        · exact h
        · exact absurd h hs₂n5
      have h₁ := hall _ hs₁I hs₁4
      have h₂ := hall _ hs₂I hs₂4
      have hgap : ((k₁ : ℝ) + 5/6) / (speeds ⟨4, by omega⟩ : ℝ) -
          ((k₁ : ℝ) + 1/6) / (speeds ⟨4, by omega⟩ : ℝ) =
          (2/3) / (speeds ⟨4, by omega⟩ : ℝ) := by
        ring
      have h2v45 : 2 * (speeds ⟨3, by omega⟩ : ℝ) <
          (speeds ⟨4, by omega⟩ : ℝ) := by
        have hd4 : (speeds ⟨3, by omega⟩ : ℝ) *
            (((k₁ : ℝ) + 5/6) / (speeds ⟨4, by omega⟩ : ℝ) -
             ((k₁ : ℝ) + 1/6) / (speeds ⟨4, by omega⟩ : ℝ)) < 1/3 := by
          nlinarith [h₁.1, h₂.2]
        rw [hgap] at hd4
        have hd4' : (speeds ⟨3, by omega⟩ : ℝ) *
            ((2/3) / (speeds ⟨4, by omega⟩ : ℝ)) =
            (2/3) * (speeds ⟨3, by omega⟩ : ℝ) / (speeds ⟨4, by omega⟩ : ℝ) := by
          ring
        rw [hd4', div_lt_iff₀ hv5pos] at hd4
        linarith
      exact ⟨h2v45, hbound2⟩
    · -- 5-blocks two or more apart: the 4-block must bridge ≥ 5/(3 v₅),
      -- forcing 5 v₄ < v₅ and then I is too short. Contradiction.
      exfalso
      have hk2ge : (k₁ : ℝ) + 2 ≤ (k₂ : ℝ) := by
        have : k₁ + 2 ≤ k₂ := by omega
        exact_mod_cast this
      have hs₁_eq : (speeds ⟨4, by omega⟩ : ℝ) *
          (((k₁ : ℝ) + 1/6) / (speeds ⟨4, by omega⟩ : ℝ)) = (k₁ : ℝ) + 1/6 := by
        field_simp
      have hs₂_eq : (speeds ⟨4, by omega⟩ : ℝ) *
          (((k₂ : ℝ) - 1/6) / (speeds ⟨4, by omega⟩ : ℝ)) = (k₂ : ℝ) - 1/6 := by
        field_simp
      have hs₁I : ((k₁ : ℝ) + 1/6) / (speeds ⟨4, by omega⟩ : ℝ) ∈ Set.Icc A B := by
        constructor
        · rw [le_div_iff₀ hv5pos]
          nlinarith [hk₁p, hv5Ap, hp_eq]
        · rw [div_le_iff₀ hv5pos]
          nlinarith [hk₂q, hv5qB, hq_eq]
      have hs₂I : ((k₂ : ℝ) - 1/6) / (speeds ⟨4, by omega⟩ : ℝ) ∈ Set.Icc A B := by
        constructor
        · rw [le_div_iff₀ hv5pos]
          nlinarith [hk₁p, hv5Ap, hp_eq]
        · rw [div_le_iff₀ hv5pos]
          nlinarith [hk₂q, hv5qB, hq_eq]
      have hs₁n5 : ((k₁ : ℝ) + 1/6) / (speeds ⟨4, by omega⟩ : ℝ) ∉
          unsafeOf speeds ⟨4, by omega⟩ := by
        apply not_mem_unsafeOf_of_in_gap speeds _ (hpos _) k₁
        · exact le_refl _
        · rw [div_le_div_iff₀ hv5pos hv5pos]
          nlinarith
      have hs₂n5 : ((k₂ : ℝ) - 1/6) / (speeds ⟨4, by omega⟩ : ℝ) ∉
          unsafeOf speeds ⟨4, by omega⟩ := by
        apply not_mem_unsafeOf_of_in_gap speeds _ (hpos _) (k₂ - 1)
        · rw [div_le_div_iff₀ hv5pos hv5pos]
          push_cast
          nlinarith
        · rw [div_le_div_iff₀ hv5pos hv5pos]
          push_cast
          nlinarith
      have hs₁4 : ((k₁ : ℝ) + 1/6) / (speeds ⟨4, by omega⟩ : ℝ) ∈
          unsafeOf speeds ⟨3, by omega⟩ := by
        rcases hsub hs₁I with h | h
        · exact h
        · exact absurd h hs₁n5
      have hs₂4 : ((k₂ : ℝ) - 1/6) / (speeds ⟨4, by omega⟩ : ℝ) ∈
          unsafeOf speeds ⟨3, by omega⟩ := by
        rcases hsub hs₂I with h | h
        · exact h
        · exact absurd h hs₂n5
      have h₁ := hall _ hs₁I hs₁4
      have h₂ := hall _ hs₂I hs₂4
      -- v₄ · (s₂ − s₁) < 1/3 with s₂ − s₁ ≥ 5/(3 v₅) forces 5 v₄ < v₅.
      have hgap : ((k₂ : ℝ) - 1/6) / (speeds ⟨4, by omega⟩ : ℝ) -
          ((k₁ : ℝ) + 1/6) / (speeds ⟨4, by omega⟩ : ℝ) =
          ((k₂ : ℝ) - (k₁ : ℝ) - 1/3) / (speeds ⟨4, by omega⟩ : ℝ) := by
        ring
      have h5v45 : 5 * (speeds ⟨3, by omega⟩ : ℝ) <
          (speeds ⟨4, by omega⟩ : ℝ) := by
        have hd4 : (speeds ⟨3, by omega⟩ : ℝ) *
            (((k₂ : ℝ) - 1/6) / (speeds ⟨4, by omega⟩ : ℝ) -
             ((k₁ : ℝ) + 1/6) / (speeds ⟨4, by omega⟩ : ℝ)) < 1/3 := by
          nlinarith [h₁.1, h₂.2]
        rw [hgap] at hd4
        have hd4' : (speeds ⟨3, by omega⟩ : ℝ) *
            (((k₂ : ℝ) - (k₁ : ℝ) - 1/3) / (speeds ⟨4, by omega⟩ : ℝ)) =
            ((k₂ : ℝ) - (k₁ : ℝ) - 1/3) * (speeds ⟨3, by omega⟩ : ℝ) /
              (speeds ⟨4, by omega⟩ : ℝ) := by
          ring
        rw [hd4', div_lt_iff₀ hv5pos] at hd4
        -- (k₂ − k₁ − 1/3) v₄ < v₅/3 with k₂ − k₁ ≥ 2 gives (5/3) v₄ < v₅/3.
        nlinarith [hk2ge, hv4pos]
      -- Lengths: B − A = (p − A) + (q − p) + (B − q) < 1/(3v₄) + 2/(3v₅)
      --          < 7/(15 v₄), against B − A > 7/(12 v₃) and v₃ < v₄.
      -- 5-coordinates of the head/tail endpoints.
      have hv5p : (speeds ⟨4, by omega⟩ : ℝ) *
          (((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ)) < (k₁ : ℝ) + 1/6 := hk₁p
      have hv5q : (k₂ : ℝ) - 1/6 < (speeds ⟨4, by omega⟩ : ℝ) *
          (((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ)) := hk₂q
      -- Head and tail each shorter than a 5-block; middle is one 4-block.
      have h_pA : ((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ) - A <
          1/(3 * (speeds ⟨4, by omega⟩ : ℝ)) := by
        rw [lt_div_iff₀ (by positivity)]
        have hexp : (((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ) - A) *
            (3 * (speeds ⟨4, by omega⟩ : ℝ)) =
            3 * ((speeds ⟨4, by omega⟩ : ℝ) *
              (((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ))) -
            3 * ((speeds ⟨4, by omega⟩ : ℝ) * A) := by ring
        rw [hexp]
        linarith [hk₁A, hv5p]
      have h_Bq : B - ((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ) <
          1/(3 * (speeds ⟨4, by omega⟩ : ℝ)) := by
        rw [lt_div_iff₀ (by positivity)]
        have hexp : (B - ((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ)) *
            (3 * (speeds ⟨4, by omega⟩ : ℝ)) =
            3 * ((speeds ⟨4, by omega⟩ : ℝ) * B) -
            3 * ((speeds ⟨4, by omega⟩ : ℝ) *
              (((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ))) := by ring
        rw [hexp]
        linarith [hk₂B, hv5q]
      have h_qp : ((m : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ) -
          ((m : ℝ) - 1/6) / (speeds ⟨3, by omega⟩ : ℝ) =
          1/(3 * (speeds ⟨3, by omega⟩ : ℝ)) := by
        field_simp
        ring
      -- 1/(3 v₅) < 1/(15 v₄) since 5 v₄ < v₅.
      have h_5lt : 1/(3 * (speeds ⟨4, by omega⟩ : ℝ)) <
          1/(15 * (speeds ⟨3, by omega⟩ : ℝ)) := by
        rw [div_lt_div_iff₀ (by positivity) (by positivity)]
        nlinarith [h5v45]
      have h_sum : B - A < 7/(15 * (speeds ⟨3, by omega⟩ : ℝ)) := by
        have hsplit : 1/(15 * (speeds ⟨3, by omega⟩ : ℝ)) +
            1/(3 * (speeds ⟨3, by omega⟩ : ℝ)) +
            1/(15 * (speeds ⟨3, by omega⟩ : ℝ)) =
            7/(15 * (speeds ⟨3, by omega⟩ : ℝ)) := by ring
        linarith [h_pA, h_Bq, h_qp, h_5lt, hsplit]
      have h_contr := lt_trans hL_7 h_sum
      rw [div_lt_div_iff₀ (by positivity) (by positivity)] at h_contr
      linarith only [h_contr, hv34]

/-! ## Open residuals -/

/-- **BHK exceptional group `G₄` (OPEN).** `n = 4` with generator class
    `±(2, 1)`: the group `{(0,0), (2,1), (0,2), (2,3)}/4` misses the open
    parallelogram `P` exactly when `v₃ < 4 v₁` (i.e. `3 < x₁ < 4`).
    BHK pp. 43–44: pick `k` with `{v₃kt₀} = 1/2`, `{v₁kt₀} = 1/4`; the
    interval `I = [kt₀ - x₁/12, kt₀ + 1/3]` (normalized) is a 123-gap;
    covering `I` forces a 4-block flanked by two consecutive 5-blocks,
    yielding `7/16 < x₅ < 1/2`, `7/8 < x₄ < 1`, under which
    `[2/3, 35/48]` is uncovered — contradiction, so a lonely time exists. -/
lemma bhk_s7_g4_hard (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i) (hgcd : Finset.univ.gcd speeds = 1)
    (hsmall : 3 * speeds ⟨0, by omega⟩ < speeds ⟨2, by omega⟩)
    (h41 : speeds ⟨2, by omega⟩ < 4 * speeds ⟨0, by omega⟩)
    (c₃ c₁ g : ℕ) (hgpos : 0 < g)
    (hd : g * 4 = speeds ⟨2, by omega⟩ - speeds ⟨1, by omega⟩)
    (hc3 : g * c₃ = speeds ⟨2, by omega⟩)
    (hc1 : g * c₁ = speeds ⟨0, by omega⟩)
    (hm3 : c₃ % 4 = 2) (hm1 : c₁ % 4 = 1 ∨ c₁ % 4 = 3) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 6 := by
  sorry

/-- **BHK §§2+7 exceptional pairs (OPEN).** When Corollary 6 returns a
    minimal pair `(i, j) ≠ (0, 0)` with `0 ≤ i < 9/2` and
    `-3/2 - i/3 < j < 3/2 + i/3` such that `(i/n, j/n) ∈ G`, conclude.

    BHK's treatment: `(0, ±1)` and `(1, 0)` are excluded by the axis
    hypotheses (`ht0`, `hv1t0`); `(2, 0)`, `(1, ±1)`, `(2, ±2)` are §2
    cases 2.1–2.3; ten further pairs go through circle-period counting
    (Table 9); `(2, ±1)` goes through Table 10, with the exceptional
    groups `G₄ = ⟨(1/2, 1/4)⟩` and `G₇ = ⟨(4/7, 2/7)⟩` handled by direct
    uncovered-interval arguments (`[2/3, 35/48]` resp. `[2/3, 65/84]`). -/
lemma bhk_s7_exceptional (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i) (hgcd : Finset.univ.gcd speeds = 1)
    (hsmall : 3 * speeds ⟨0, by omega⟩ < speeds ⟨2, by omega⟩)
    (n c₃ c₁ g : ℕ) (hn : 1 < n)
    (hgpos : 0 < g)
    (hd : g * n = speeds ⟨2, by omega⟩ - speeds ⟨1, by omega⟩)
    (hc3 : g * c₃ = speeds ⟨2, by omega⟩)
    (hc1 : g * c₁ = speeds ⟨0, by omega⟩)
    (hg1 : Nat.gcd n (Nat.gcd c₃ c₁) = 1)
    (hc3_ne : ¬ n ∣ c₃) (hc1_ne : ¬ n ∣ c₁)
    (ij : ℤ × ℤ) (hij_ne : ij ≠ (0, 0))
    (hij_mem : ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ bhkS7Group n c₃ c₁)
    (hi_lo : 0 ≤ ij.1) (hi_hi : (ij.1 : ℝ) < 1 / (2/9 : ℝ))
    (hj_lo : -1 / (2/3 : ℝ) - (2/9 : ℝ) / (2/3 : ℝ) * ij.1 < (ij.2 : ℝ))
    (hj_hi : (ij.2 : ℝ) < 1 / (2/3 : ℝ) + (2/9 : ℝ) / (2/3 : ℝ) * ij.1)
    (hij_min : ∀ kl : ℤ × ℤ, kl ≠ (0, 0) → |kl.1| ≤ |ij.1| → |kl.2| ≤ |ij.2| →
      ¬(|kl.1| = |ij.1| ∧ |kl.2| = |ij.2|) →
      ((kl.1 : ℝ) / n, (kl.2 : ℝ) / n) ∉ bhkS7Group n c₃ c₁) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 6 := by
  sorry

/-- **BHK §§2+7 small group order.** When `2 ≤ n ≤ 6` the rectangle
    `2/3 × 2/9` is too small for Corollary 6 (`αβ = 4/27 < 1/n`); handle
    by direct enumeration of the cyclic group `⟨(c₃/n, c₁/n)⟩` against the
    parallelogram `P` (both coordinates nonzero mod `n`).

    Empirically verified landscape (47 of 49 generator classes): a single
    multiple `k ≤ 3` lands in the speed-independent sufficient window
    `u ∈ [1/6, 5/6]`, `w ∈ [1/9 + u/3, 5/9 + u/3]`. The only exceptions
    are `n = 4` with generator class `±(2, 1)` — BHK's `G₄` — where the
    exact window works iff `4 v₁ ≤ v₃`, and the residual `v₃ < 4 v₁` goes
    to the ad hoc covering argument (`bhk_s7_g4_hard`). -/
lemma bhk_s7_small_n (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i) (hgcd : Finset.univ.gcd speeds = 1)
    (hsmall : 3 * speeds ⟨0, by omega⟩ < speeds ⟨2, by omega⟩)
    (n c₃ c₁ g : ℕ) (hn : 1 < n) (hn6 : n ≤ 6)
    (hgpos : 0 < g)
    (hd : g * n = speeds ⟨2, by omega⟩ - speeds ⟨1, by omega⟩)
    (hc3 : g * c₃ = speeds ⟨2, by omega⟩)
    (hc1 : g * c₁ = speeds ⟨0, by omega⟩)
    (hg1 : Nat.gcd n (Nat.gcd c₃ c₁) = 1)
    (hc3_ne : ¬ n ∣ c₃) (hc1_ne : ¬ n ∣ c₁) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 6 := by
  have Wn := bhk_s7_witness_num speeds hmono hpos hsmall
  interval_cases n
  · -- n = 2: the only generator is (1, 1); k = 1.
    have h3 : c₃ % 2 = 1 := by omega
    have h1 : c₁ % 2 = 1 := by omega
