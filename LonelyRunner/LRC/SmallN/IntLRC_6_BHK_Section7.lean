/-! ## Assembly -/

/-- **BHK §§2+7, master assembly.** Decomposes the generic case: build the
    torus group from `(c₃, c₁) = (v₃, v₁)/g mod n` with `n = (v₃ - v₂)/g`,
    apply Corollary 6 to the `2/3 × 2/9` rectangle when `n ≥ 7`, convert a
    rectangle hit into a lonely time via the §2 bridge, and dispatch the
    exceptional-pair and small-`n` branches to the dedicated lemmas. -/
theorem bhk_s7_main (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i) (hgcd : Finset.univ.gcd speeds = 1)
    (hsmall : 3 * speeds ⟨0, by omega⟩ < speeds ⟨2, by omega⟩)
    (ht0 : Int.fract ((speeds ⟨2, by omega⟩ : ℝ) *
              (1 / ((speeds ⟨2, by omega⟩ : ℝ) - speeds ⟨1, by omega⟩))) ≠ 0)
    (hv1t0 : Int.fract ((speeds ⟨0, by omega⟩ : ℝ) *
              (1 / ((speeds ⟨2, by omega⟩ : ℝ) - speeds ⟨1, by omega⟩))) ≠ 0) :
    ∃ t : ℝ, ∀ i, circDist ((speeds i : ℝ) * t) ≥ (1 : ℝ) / 6 := by
  set V1 : ℕ := speeds ⟨0, by omega⟩ with hV1_def
  set V2 : ℕ := speeds ⟨1, by omega⟩ with hV2_def
  set V3 : ℕ := speeds ⟨2, by omega⟩ with hV3_def
  have hV23 : V2 < V3 := hmono (Fin.mk_lt_mk.mpr (by omega))
  have hV1pos : 0 < V1 := hpos _
  have hV3pos : 0 < V3 := hpos _
  set D : ℕ := V3 - V2 with hD_def
  have hDpos : 0 < D := by omega
  have hD_cast : ((D : ℕ) : ℝ) = (V3 : ℝ) - V2 := by
    rw [hD_def, Nat.cast_sub hV23.le]
  -- The axis hypotheses as divisibility statements.
  have hdvd3 : ¬ D ∣ V3 := by
    intro hdvd
    apply ht0
    rw [show (V3 : ℝ) * (1 / ((V3 : ℝ) - V2)) = (V3 : ℝ) / D from by
      rw [hD_cast]; ring]
    exact (bhk_fract_nat_div_eq_zero_iff V3 D hDpos).mpr hdvd
  have hdvd1 : ¬ D ∣ V1 := by
    intro hdvd
    apply hv1t0
    rw [show (V1 : ℝ) * (1 / ((V3 : ℝ) - V2)) = (V1 : ℝ) / D from by
      rw [hD_cast]; ring]
    exact (bhk_fract_nat_div_eq_zero_iff V1 D hDpos).mpr hdvd
  -- Reduced group data.
  set g : ℕ := Nat.gcd D (Nat.gcd V3 V1) with hg_def
  have hgpos : 0 < g := Nat.gcd_pos_of_pos_left _ hDpos
  have hgD : g ∣ D := Nat.gcd_dvd_left _ _
  have hgV3 : g ∣ V3 := (Nat.gcd_dvd_right _ _).trans (Nat.gcd_dvd_left V3 V1)
  have hgV1 : g ∣ V1 := (Nat.gcd_dvd_right _ _).trans (Nat.gcd_dvd_right V3 V1)
  set n : ℕ := D / g with hn_def
  set c₃ : ℕ := V3 / g with hc3_def
  set c₁ : ℕ := V1 / g with hc1_def
  have hgn : g * n = D := Nat.mul_div_cancel' hgD
  have hgc3 : g * c₃ = V3 := Nat.mul_div_cancel' hgV3
  have hgc1 : g * c₁ = V1 := Nat.mul_div_cancel' hgV1
  have hg1 : Nat.gcd n (Nat.gcd c₃ c₁) = 1 := by
    set e := Nat.gcd n (Nat.gcd c₃ c₁) with he_def
    have he_n : e ∣ n := Nat.gcd_dvd_left _ _
    have he_c3 : e ∣ c₃ := (Nat.gcd_dvd_right _ _).trans (Nat.gcd_dvd_left c₃ c₁)
    have he_c1 : e ∣ c₁ := (Nat.gcd_dvd_right _ _).trans (Nat.gcd_dvd_right c₃ c₁)
    have hge_D : g * e ∣ D := hgn ▸ mul_dvd_mul_left g he_n
    have hge_V3 : g * e ∣ V3 := hgc3 ▸ mul_dvd_mul_left g he_c3
    have hge_V1 : g * e ∣ V1 := hgc1 ▸ mul_dvd_mul_left g he_c1
    have hge_g : g * e ∣ g := by
      rw [hg_def]
      exact Nat.dvd_gcd hge_D (Nat.dvd_gcd hge_V3 hge_V1)
    have he1 : e ∣ 1 :=
      Nat.dvd_of_mul_dvd_mul_left hgpos (by rwa [mul_one g])
    exact Nat.dvd_one.mp he1
  have hnpos : 0 < n := by
    rcases Nat.eq_zero_or_pos n with h0 | h
    · rw [h0, mul_zero] at hgn; omega
    · exact h
  have hn1 : 1 < n := by
    rcases Nat.lt_or_ge n 2 with h | h
    · have hn_eq : n = 1 := by omega
      rw [hn_eq, mul_one] at hgn
      exact absurd (hgn ▸ hgV1) hdvd1
    · omega
  have hc3_ne : ¬ n ∣ c₃ := by
    rintro ⟨e, he⟩
    exact hdvd3 ⟨e, by rw [← hgc3, he, ← hgn]; ring⟩
  have hc1_ne : ¬ n ∣ c₁ := by
    rintro ⟨e, he⟩
    exact hdvd1 ⟨e, by rw [← hgc1, he, ← hgn]; ring⟩
  by_cases hn7 : 7 ≤ n
  · -- Corollary 6 applies: αβ = 4/27 ≥ 1/n.
    have hnR : (0 : ℝ) < n := by exact_mod_cast hnpos
    have hαβ : (2/3 : ℝ) * (2/9 : ℝ) ≥ 1 / (n : ℝ) := by
      rw [ge_iff_le, div_le_iff₀ hnR]
      have h7 : (7 : ℝ) ≤ n := by exact_mod_cast hn7
      nlinarith
    have h_nβ : 1 / (2/9 : ℝ) ≤ (n : ℝ) := by
      have h7 : (7 : ℝ) ≤ n := by exact_mod_cast hn7
      norm_num
      linarith
    rcases bhk_s7_corollary_6_minimal (bhkS7Group n c₃ c₁) n hn1
        (bhk_s7_lift n c₃ c₁ hn1 hg1)
        (2/3) (2/9) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
        hαβ h_nβ with
      hAll | ⟨ij, hij_ne, hij_mem, hi_lo, hi_hi, hj_lo, hj_hi, hij_min⟩
    · -- Rectangle branch: hit at anchor (1/6, 7/18), convert to lonely time.
      obtain ⟨p, hpG, hpR⟩ := hAll (1/6) (7/18)
      obtain ⟨k, hk1, hk2⟩ := bhk_s7_extract n c₃ c₁ hn1 p hpG
      obtain ⟨hpR1a, hpR1b, hpR2a, hpR2b⟩ := hpR
      -- Anchored fract conditions transfer to {p.1}, {p.2}.
      have hshift : ∀ x c : ℝ, Int.fract (x - c) = Int.fract (Int.fract x - c) := by
        intro x c
        conv_lhs => rw [← Int.fract_add_floor x]
        rw [show Int.fract x + (⌊x⌋ : ℝ) - c = Int.fract x - c + (⌊x⌋ : ℤ) from by
          push_cast; ring, Int.fract_add_intCast]
      have hu_win := bhk_fract_window (Int.fract p.1) (1/6) (2/3)
        (Int.fract_nonneg _) (Int.fract_lt_one _) (by norm_num) (by norm_num)
        (by rw [← hshift]; exact hpR1b)
      have hw_win := bhk_fract_window (Int.fract p.2) (7/18) (2/9)
        (Int.fract_nonneg _) (Int.fract_lt_one _) (by norm_num) (by norm_num)
        (by rw [← hshift]; exact hpR2b)
      -- The meeting time.
      set τ : ℝ := (k : ℝ) / D with hτ_def
      have hgR : (0 : ℝ) < g := by exact_mod_cast hgpos
      have hDR_pos : (0 : ℝ) < D := by exact_mod_cast hDpos
      have hDR : ((D : ℕ) : ℝ) = (g : ℝ) * n := by exact_mod_cast hgn.symm
      have hV3R : ((V3 : ℕ) : ℝ) = (g : ℝ) * c₃ := by exact_mod_cast hgc3.symm
      have hV1R : ((V1 : ℕ) : ℝ) = (g : ℝ) * c₁ := by exact_mod_cast hgc1.symm
      have e3 : (V3 : ℝ) * τ = ((c₃ * k : ℕ) : ℝ) / n := by
        rw [hτ_def, hV3R, hDR]
        push_cast
        field_simp
      have e1 : (V1 : ℝ) * τ = ((c₁ * k : ℕ) : ℝ) / n := by
        rw [hτ_def, hV1R, hDR]
        push_cast
        field_simp
      have hu3 : Int.fract ((V3 : ℝ) * τ) = Int.fract p.1 := by rw [e3, hk1]
      have hw1 : Int.fract ((V1 : ℝ) * τ) = Int.fract p.2 := by rw [e1, hk2]
      have e2 : (V2 : ℝ) * τ = (V3 : ℝ) * τ - ((k : ℤ) : ℝ) := by
        have hV2R : (V2 : ℝ) = (V3 : ℝ) - D := by rw [hD_cast]; ring
        rw [hV2R, hτ_def]
        field_simp
        push_cast
        ring
      have h2eq : Int.fract ((V2 : ℝ) * τ) = Int.fract ((V3 : ℝ) * τ) := by
        rw [e2, Int.fract_sub_intCast]
      -- Window conditions (6) from the rectangle bounds and 3 V₁ < V₃.
      have hsmallR : 3 * (V1 : ℝ) < V3 := by exact_mod_cast hsmall
      have hV1Rpos : (0 : ℝ) < V1 := by exact_mod_cast hV1pos
      have hV3Rpos : (0 : ℝ) < V3 := by exact_mod_cast hV3pos
      have hu_lo : 1/6 ≤ Int.fract ((V3 : ℝ) * τ) := by rw [hu3]; exact hu_win.1
      have hu_hi : Int.fract ((V3 : ℝ) * τ) ≤ 5/6 := by
        rw [hu3]; have := hu_win.2; linarith
      have hterm_lo : (Int.fract ((V3 : ℝ) * τ) - 1/6) * (V1 : ℝ) / (V3 : ℝ) ≤ 2/9 := by
        rw [div_le_iff₀ hV3Rpos]
        have hb := mul_le_mul_of_nonneg_right
          (show Int.fract ((V3 : ℝ) * τ) - 1/6 ≤ 2/3 by linarith) hV1Rpos.le
        linarith
      have hterm_hi : (5/6 - Int.fract ((V3 : ℝ) * τ)) * (V1 : ℝ) / (V3 : ℝ) ≤ 2/9 := by
        rw [div_le_iff₀ hV3Rpos]
        have hb := mul_le_mul_of_nonneg_right
          (show 5/6 - Int.fract ((V3 : ℝ) * τ) ≤ 2/3 by linarith) hV1Rpos.le
        linarith
      have hw_lo : 1/6 + (Int.fract ((V3 : ℝ) * τ) - 1/6) * (V1 : ℝ) / (V3 : ℝ)
          ≤ Int.fract ((V1 : ℝ) * τ) := by
        rw [hw1]
        have := hw_win.1
        linarith
      have hw_hi : Int.fract ((V1 : ℝ) * τ)
          ≤ 5/6 - (5/6 - Int.fract ((V3 : ℝ) * τ)) * (V1 : ℝ) / (V3 : ℝ) := by
        rw [hw1]
        have := hw_win.2
        linarith
      exact bhk_s7_window_lonely speeds hmono hpos τ hu_lo hu_hi h2eq hw_lo hw_hi
    · exact bhk_s7_exceptional speeds hmono hpos hgcd hsmall n c₃ c₁ g hn1 hgpos
        hgn hgc3 hgc1 hg1 hc3_ne hc1_ne ij hij_ne hij_mem hi_lo hi_hi hj_lo hj_hi
        hij_min
  · exact bhk_s7_small_n speeds hmono hpos hgcd hsmall n c₃ c₁ g hn1 (by omega)
      hgpos hgn hgc3 hgc1 hg1 hc3_ne hc1_ne

end BHK
