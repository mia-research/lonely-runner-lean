/-- BHK's real-plane group: the lifts of an order-`n` subgroup of `(ZMod n)²`. -/
def IsBHKLift (G : Set (ℝ × ℝ)) (n : ℕ) : Prop :=
  ∃ H : AddSubgroup (ZMod n × ZMod n), Nat.card H = n ∧
    ∀ p : ℝ × ℝ, p ∈ G ↔
      ∃ h ∈ H, ∃ i j : ℤ,
        p = (((h.1.val : ℝ) / n) + (i : ℝ), ((h.2.val : ℝ) / n) + (j : ℝ))

/-- **Generator order.** The cyclic subgroup generated by `(↑r, ↑p)` in
    `(ZMod q)²` has order `q` when `gcd(p, q) = 1`: the second coordinate already
    has additive order `q`, and the first has order dividing `q`. This supplies
    the order-`q` subgroup `H` needed for `IsBHKLift` in BHK §5 Part 3. -/
lemma bhk_addOrderOf_gen (r p q : ℕ) (hq : 0 < q) (hcop : Nat.gcd p q = 1) :
    addOrderOf ((↑r, ↑p) : ZMod q × ZMod q) = q := by
  rw [Prod.addOrderOf_mk]
  have hp : addOrderOf (↑p : ZMod q) = q := by
    rw [ZMod.addOrderOf_coe p (show q ≠ 0 by omega), Nat.gcd_comm, hcop, Nat.div_one]
  have hr : addOrderOf (↑r : ZMod q) ∣ q := by
    apply addOrderOf_dvd_of_nsmul_eq_zero
    rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  rw [hp]
  exact Nat.lcm_eq_right hr

/-- The order-`q` cyclic subgroup `⟨(↑r, ↑p)⟩ ⊆ (ZMod q)²` from
    `bhk_addOrderOf_gen`, as an `AddSubgroup` with `Nat.card = q`. -/
lemma bhk_card_zmultiples_gen (r p q : ℕ) (hq : 0 < q) (hcop : Nat.gcd p q = 1) :
    Nat.card (AddSubgroup.zmultiples ((↑r, ↑p) : ZMod q × ZMod q)) = q := by
  rw [Nat.card_zmultiples]; exact bhk_addOrderOf_gen r p q hq hcop

/-- **Fractional-part bridge.** The canonical representative `(m : ZMod q).val`
    and the integer `m` have the same `fract` after dividing by `q`: they differ
    by the integer `m / q`. Lets abstract `IsBHKLift` membership (phrased via
    `.val`) be read off directly from the generator multiple `m`. -/
lemma bhk_fract_val_div (q : ℕ) (hq : 0 < q) (m : ℤ) :
    Int.fract ((((m : ZMod q)).val : ℝ) / (q : ℝ)) = Int.fract ((m : ℝ) / (q : ℝ)) := by
  haveI : NeZero q := ⟨by omega⟩
  have hqR : (q : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hval : (((m : ZMod q)).val : ℤ) = m % q := ZMod.val_intCast m
  have hmod : q * (m / q) + m % q = m := Int.ediv_add_emod m q
  have key : (m : ℝ) / q = ((m / q : ℤ) : ℝ) + (((m : ZMod q)).val : ℝ) / q := by
    have e1 : (((m : ZMod q)).val : ℝ) = ((m % q : ℤ) : ℝ) := by exact_mod_cast hval
    have hmodR : (m : ℝ) = (q : ℝ) * ((m / q : ℤ) : ℝ) + ((m % q : ℤ) : ℝ) := by
      exact_mod_cast hmod.symm
    rw [e1, hmodR]; field_simp
  rw [key, Int.fract_intCast_add]

/-- **The Part-3 lift `G`.** The ℤ²-periodic lift of the order-`q` cyclic group
    `⟨(↑r, ↑p)⟩`. It satisfies `IsBHKLift G q`, and every point's torus
    coordinates are read off the generator: `fract x.1 = fract(k r / q)`,
    `fract x.2 = fract(k p / q)` for some `k : ℤ`. (BHK §5 Part 3, `q ≥ 18`.) -/
lemma bhk_isBHKLift_gen (r p q : ℕ) (hq : 0 < q) (hcop : Nat.gcd p q = 1) :
    ∃ G : Set (ℝ × ℝ), IsBHKLift G q ∧
      ∀ x ∈ G, ∃ k : ℤ,
        Int.fract x.1 = Int.fract ((k : ℝ) * r / q) ∧
        Int.fract x.2 = Int.fract ((k : ℝ) * p / q) := by
  refine ⟨{x | ∃ h ∈ AddSubgroup.zmultiples (((r : ZMod q), (p : ZMod q))), ∃ i j : ℤ,
      x = ((h.1.val : ℝ) / q + i, (h.2.val : ℝ) / q + j)},
    ⟨AddSubgroup.zmultiples _, bhk_card_zmultiples_gen r p q hq hcop, fun _ => Iff.rfl⟩, ?_⟩
  rintro x ⟨h, hh, i, j, rfl⟩
  rw [AddSubgroup.mem_zmultiples_iff] at hh
  obtain ⟨k, hk⟩ := hh
  have hh1 : h.1 = ((k * (r : ℤ) : ℤ) : ZMod q) := by
    rw [← hk]; show k • (r : ZMod q) = ((k * (r : ℤ) : ℤ) : ZMod q)
    rw [zsmul_eq_mul]; push_cast; ring
  have hh2 : h.2 = ((k * (p : ℤ) : ℤ) : ZMod q) := by
    rw [← hk]; show k • (p : ZMod q) = ((k * (p : ℤ) : ℤ) : ZMod q)
    rw [zsmul_eq_mul]; push_cast; ring
  refine ⟨k, ?_, ?_⟩
  · show Int.fract ((h.1.val : ℝ) / q + (i : ℝ)) = Int.fract ((k : ℝ) * r / q)
    rw [Int.fract_add_intCast, hh1, bhk_fract_val_div q hq]
    congr 1; push_cast; ring
  · show Int.fract ((h.2.val : ℝ) / q + (j : ℝ)) = Int.fract ((k : ℝ) * p / q)
    rw [Int.fract_add_intCast, hh2, bhk_fract_val_div q hq]
    congr 1; push_cast; ring

/-- Fractional part absorbs the integer part of the first summand. -/
lemma bhk_fract_add_fract (x c : ℝ) :
    Int.fract (x + c) = Int.fract (Int.fract x + c) := by
  conv_lhs => rw [← Int.floor_add_fract x]
  rw [add_assoc, Int.fract_intCast_add]

/-- **Window from a `fract`.** If a torus value `S ∈ [0,1)` has
    `fract (S - 1/6) ≤ β` with `β < 5/6`, then `S ∈ [1/6, 1/6 + β]`. (The
    `S < 1/6` branch is impossible since then `fract (S - 1/6) = S + 5/6 ≥ 5/6`.) -/
lemma bhk_window_from_fract {S β : ℝ} (hS0 : 0 ≤ S) (hS1 : S < 1)
    (hβ : β < 5 / 6) (hb : Int.fract (S - 1 / 6) ≤ β) : 1 / 6 ≤ S ∧ S ≤ 1 / 6 + β := by
  by_cases h : 1 / 6 ≤ S
  · refine ⟨h, ?_⟩
    rw [Int.fract_eq_self.2 ⟨by linarith, by linarith⟩] at hb; linarith
  · push_neg at h
    exfalso
    rw [show S - 1 / 6 = (S + 5 / 6) + ((-1 : ℤ) : ℝ) from by push_cast; ring,
      Int.fract_add_intCast, Int.fract_eq_self.2 ⟨by linarith, by linarith⟩] at hb
    linarith


/-- **Integer-point membership bridge for a BHK lift.** For integers
    `a, b`, the point `(a/n, b/n)` lies in `G` iff the mod-`n`
    reduction `(a, b)` lies in `H`. -/
lemma bhk_lift_int_mem_iff (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n))
    (hG_iff : ∀ p : ℝ × ℝ, p ∈ G ↔ ∃ h ∈ H, ∃ i j : ℤ,
      p = (((h.1.val : ℝ) / n) + (i : ℝ), ((h.2.val : ℝ) / n) + (j : ℝ)))
    (a b : ℤ) :
    ((a : ℝ) / n, (b : ℝ) / n) ∈ G ↔ ((a : ZMod n), (b : ZMod n)) ∈ H := by
  haveI : NeZero n := ⟨by omega⟩
  have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
  have hn_ne_real : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  constructor
  · intro hab
    rw [hG_iff] at hab
    obtain ⟨h, hh_in, k, l, heq⟩ := hab
    have h_a_eq : (a : ℝ) = (h.1.val : ℝ) + (n : ℝ) * (k : ℝ) := by
      have h1 := congr_arg Prod.fst heq
      field_simp at h1
      linarith
    have h_b_eq : (b : ℝ) = (h.2.val : ℝ) + (n : ℝ) * (l : ℝ) := by
      have h2 := congr_arg Prod.snd heq
      field_simp at h2
      linarith
    have h_a_int : a = (h.1.val : ℤ) + (n : ℤ) * k := by
      have h_rhs : (h.1.val : ℝ) + (n : ℝ) * (k : ℝ) =
          (((h.1.val : ℤ) + (n : ℤ) * k : ℤ) : ℝ) := by push_cast; ring
      rw [h_rhs] at h_a_eq
      exact_mod_cast h_a_eq
    have h_b_int : b = (h.2.val : ℤ) + (n : ℤ) * l := by
      have h_rhs : (h.2.val : ℝ) + (n : ℝ) * (l : ℝ) =
          (((h.2.val : ℤ) + (n : ℤ) * l : ℤ) : ℝ) := by push_cast; ring
      rw [h_rhs] at h_b_eq
      exact_mod_cast h_b_eq
    have h_a_zmod : (a : ZMod n) = h.1 := by
      rw [h_a_int]; push_cast; simp [ZMod.natCast_val]
    have h_b_zmod : (b : ZMod n) = h.2 := by
      rw [h_b_int]; push_cast; simp [ZMod.natCast_val]
    have h_pair : ((a : ZMod n), (b : ZMod n)) = (h : ZMod n × ZMod n) := by
      ext
      · exact h_a_zmod
      · exact h_b_zmod
    rw [h_pair]; exact hh_in
  · intro hab
    rw [hG_iff]
    refine ⟨((a : ZMod n), (b : ZMod n)), hab, ?_⟩
    have ha_dvd : (n : ℤ) ∣ (a - ((a : ZMod n).val : ℤ)) := by
      have : ((a - ((a : ZMod n).val : ℤ) : ℤ) : ZMod n) = 0 := by
        push_cast; rw [ZMod.natCast_zmod_val]; ring
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp this
    have hb_dvd : (n : ℤ) ∣ (b - ((b : ZMod n).val : ℤ)) := by
      have : ((b - ((b : ZMod n).val : ℤ) : ℤ) : ZMod n) = 0 := by
        push_cast; rw [ZMod.natCast_zmod_val]; ring
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp this
    obtain ⟨k, hk⟩ := ha_dvd
    obtain ⟨l, hl⟩ := hb_dvd
    refine ⟨k, l, ?_⟩
    have h_a_real : (a : ℝ) = ((a : ZMod n).val : ℝ) + (n : ℝ) * (k : ℝ) := by
      have : (a : ℤ) = ((a : ZMod n).val : ℤ) + (n : ℤ) * k := by linarith [hk]
      exact_mod_cast this
    have h_b_real : (b : ℝ) = ((b : ZMod n).val : ℝ) + (n : ℝ) * (l : ℝ) := by
      have : (b : ℤ) = ((b : ZMod n).val : ℤ) + (n : ℤ) * l := by linarith [hl]
      exact_mod_cast this
    refine Prod.ext ?_ ?_
    · show (a : ℝ) / n = ((a : ZMod n).val : ℝ) / n + k
      rw [h_a_real]; field_simp
    · show (b : ℝ) / n = ((b : ZMod n).val : ℝ) / n + l
      rw [h_b_real]; field_simp


/-! ## BHK's forms of the framework's global isolation and window rules -/

/-- **BHK Main Lemma, real-plane form** — from global isolation in two dimensions
(`isolation_or_short_step`), reading lifts as residues. -/
theorem bhk_main_lemma
    (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (hG_lift : IsBHKLift G n)
    (α β : ℝ) (hα : 0 < α) (hα' : α < 1) (hβ : 0 < β) (hβ' : β < 1)
    (hαβ : α * β ≥ 1 / (n : ℝ)) :
    (∀ x₁ x₂, (G ∩ bhkRectangle x₁ x₂ α β).Nonempty) ∨
    (∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
      β * |(ij.1 : ℝ)| + α * |(ij.2 : ℝ)| - 2 / n * |(ij.1 : ℝ)| * |(ij.2 : ℝ)| < 1) := by
  obtain ⟨H, hH, hG⟩ := hG_lift
  have hn0 : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
  have h1 : 1 ≤ α * β * n := by rw [ge_iff_le, div_le_iff₀ hn0] at hαβ; linarith
  rcases isolation_or_short_step n hn H hH α β hα' hβ hβ' h1 with
    hall | ⟨i, j, hij, hmem, -, -, -, h12, -, -⟩
  · left
    intro x₁ x₂
    obtain ⟨u, v, huv, hu, hv⟩ := hall x₁ x₂
    exact ⟨((u : ℝ) / n, (v : ℝ) / n), (bhk_lift_int_mem_iff G n hn H hG u v).mpr huv,
      Int.fract_nonneg _, hu, Int.fract_nonneg _, hv⟩
  · right
    exact ⟨(i, j), hij, (bhk_lift_int_mem_iff G n hn H hG i j).mpr hmem, h12⟩

/-- **BHK Corollary 6, real-plane form** — from global isolation in two dimensions. -/
theorem bhk_corollary_6
    (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (hG_lift : IsBHKLift G n)
    (α β : ℝ) (hα : 0 < α) (hα' : α < 1) (hβ : 0 < β) (hβ' : β < 1)
    (hαβ : α * β ≥ 1 / (n : ℝ)) :
    (∀ x₁ x₂, (G ∩ bhkRectangle x₁ x₂ α β).Nonempty) ∨
    (∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
      0 ≤ ij.1 ∧ (ij.1 : ℝ) < 1 / β ∧
      -1 / α - β / α * ij.1 < (ij.2 : ℝ) ∧
      (ij.2 : ℝ) < 1 / α + β / α * ij.1) := by
  obtain ⟨H, hH, hG⟩ := hG_lift
  have hn0 : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
  have h1 : 1 ≤ α * β * n := by rw [ge_iff_le, div_le_iff₀ hn0] at hαβ; linarith
  rcases isolation_or_short_step n hn H hH α β hα' hβ hβ' h1 with
    hall | ⟨i, j, hij, hmem, hi0, hi1, -, -, hcone, -⟩
  · left
    intro x₁ x₂
    obtain ⟨u, v, huv, hu, hv⟩ := hall x₁ x₂
    exact ⟨((u : ℝ) / n, (v : ℝ) / n), (bhk_lift_int_mem_iff G n hn H hG u v).mpr huv,
      Int.fract_nonneg _, hu, Int.fract_nonneg _, hv⟩
  · right
    have ha := abs_nonneg (j : ℝ)
    have hle := neg_abs_le (j : ℝ)
    have hge := le_abs_self (j : ℝ)
    refine ⟨(i, j), hij, (bhk_lift_int_mem_iff G n hn H hG i j).mpr hmem, hi0, hi1, ?_, ?_⟩
    · rw [show -1 / α - β / α * (i : ℝ) = -(1 + β * i) / α by ring, div_lt_iff₀ hα]
      nlinarith
    · rw [show 1 / α + β / α * (i : ℝ) = (1 + β * i) / α by ring, lt_div_iff₀ hα]
      nlinarith

/-- **BHK Corollary 6 with the minimal pair (13), real-plane form.** -/
theorem bhk_s7_corollary_6_minimal
    (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n)
    (hG_lift : IsBHKLift G n)
    (α β : ℝ) (hα : 0 < α) (hα' : α < 1) (hβ : 0 < β) (hβ' : β < 1)
    (hαβ : α * β ≥ 1 / (n : ℝ)) (h_nβ : 1 / β ≤ (n : ℝ)) :
    (∀ x₁ x₂, (G ∩ bhkRectangle x₁ x₂ α β).Nonempty) ∨
    (∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ℝ) / n, (ij.2 : ℝ) / n) ∈ G ∧
      0 ≤ ij.1 ∧ (ij.1 : ℝ) < 1 / β ∧
      -1 / α - β / α * ij.1 < (ij.2 : ℝ) ∧
      (ij.2 : ℝ) < 1 / α + β / α * ij.1 ∧
      (∀ kl : ℤ × ℤ, kl ≠ (0, 0) → |kl.1| ≤ |ij.1| → |kl.2| ≤ |ij.2| →
        ¬(|kl.1| = |ij.1| ∧ |kl.2| = |ij.2|) →
        ((kl.1 : ℝ) / n, (kl.2 : ℝ) / n) ∉ G)) := by
  obtain ⟨H, hH, hG⟩ := hG_lift
  have hn0 : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
  have h1 : 1 ≤ α * β * n := by rw [ge_iff_le, div_le_iff₀ hn0] at hαβ; linarith
  rcases isolation_or_short_step n hn H hH α β hα' hβ hβ' h1 with
    hall | ⟨i, j, hij, hmem, hi0, hi1, -, -, hcone, hmin⟩
  · left
    intro x₁ x₂
    obtain ⟨u, v, huv, hu, hv⟩ := hall x₁ x₂
    exact ⟨((u : ℝ) / n, (v : ℝ) / n), (bhk_lift_int_mem_iff G n hn H hG u v).mpr huv,
      Int.fract_nonneg _, hu, Int.fract_nonneg _, hv⟩
  · right
    have ha := abs_nonneg (j : ℝ)
    have hle := neg_abs_le (j : ℝ)
    have hge := le_abs_self (j : ℝ)
    refine ⟨(i, j), hij, (bhk_lift_int_mem_iff G n hn H hG i j).mpr hmem, hi0, hi1, ?_, ?_, ?_⟩
    · rw [show -1 / α - β / α * (i : ℝ) = -(1 + β * i) / α by ring, div_lt_iff₀ hα]
      nlinarith
    · rw [show 1 / α + β / α * (i : ℝ) = (1 + β * i) / α by ring, lt_div_iff₀ hα]
      nlinarith
    · intro kl h0 h1 h2 h3 hG'
      exact hmin kl.1 kl.2 h0 h1 h2 h3 ((bhk_lift_int_mem_iff G n hn H hG kl.1 kl.2).mp hG')

/-- **BHK Lemma 7, real-plane form** — from the order bound of a minimal step. -/
lemma bhk_lemma7 (G : Set (ℝ × ℝ)) (n : ℕ) (hn : 1 < n) (hG_lift : IsBHKLift G n)
    (i j : ℤ) (hi : i ≠ 0) (hj : j ≠ 0)
    (hin : i.natAbs < n) (hjn : j.natAbs < n)
    (hmin : ∀ kl : ℤ × ℤ, kl ≠ (0, 0) → |kl.1| ≤ |i| → |kl.2| ≤ |j| →
        ¬(|kl.1| = |i| ∧ |kl.2| = |j|) → ((kl.1 : ℝ) / n, (kl.2 : ℝ) / n) ∉ G) :
    (i.natAbs + 1) * (j.natAbs + 1) - 2 ≤ n := by
  obtain ⟨H, hH, hG⟩ := hG_lift
  exact order_bound_of_minimal n hn H hH i j hi hj hin hjn
    (fun k l h0 h1 h2 h3 hmem => hmin (k, l) h0 h1 h2 h3 ((bhk_lift_int_mem_iff G n hn H hG k l).mpr hmem))

/-- **BHK Lemma 4, blocked-zone form** — the two-flank window rule read backwards
(`blocked_cover_short`). -/
theorem bhk_lemma_4 (speeds : Fin 5 → ℕ) (hmono : StrictMono speeds)
    (hpos : ∀ i, 0 < speeds i)
    (a b : ℝ) (hab : a ≤ b)
    (hI : Set.Icc a b ⊆ unsafeOf speeds ⟨3, by omega⟩ ∪ unsafeOf speeds ⟨4, by omega⟩) :
    b - a < 2 / (3 * (speeds ⟨3, by omega⟩ : ℝ)) := by
  have h4 : (0 : ℝ) < speeds ⟨3, by omega⟩ := by exact_mod_cast hpos _
  have h45 : (speeds ⟨3, by omega⟩ : ℝ) < speeds ⟨4, by omega⟩ := by
    exact_mod_cast hmono (Fin.mk_lt_mk.mpr (by norm_num) : (Fin.mk 3 (by norm_num) : Fin 5) < Fin.mk 4 (by norm_num))
  refine LRC.SpecN.blocked_cover_short h4 h45 (fun t h1 h2 => ?_)
  rcases hI ⟨h1, h2⟩ with h | h
  · left; have := (mem_unsafeOf_iff speeds _ t).mp h; simpa [one_div] using this
  · right; have := (mem_unsafeOf_iff speeds _ t).mp h; simpa [one_div] using this


/-- **BHK §5 Part 3 — extraction of an exceptional pair (`q ≥ 18`).** Given the
    "no good time" fact (the set `S = {({v₄(l+½)}, {v₁(l+½)})}` avoids the
    `1/3 × 1/6` rectangle `R`, phrased as `h_nogood`), the main lemma
    (`bhk_corollary_6`) forces the generator `(r/q, p/q)` to land in a finite
    *exceptional* region: there is a nonzero `(i, j)` with `(i/q, j/q)` a multiple
    of `(r/q, p/q)` on the torus, `0 ≤ i < 6`, and `|j| < 3 + i/2`.

    The bridge: `S` avoids `R` ⟺ the lift `G` of `⟨(↑r,↑p)⟩` misses the rectangle
    anchored at `(1/6 − r/(2q), 1/6 − p/(2q))` (the `½`-offset), so the
    "hits every rectangle" disjunct of Corollary 6 fails. -/
theorem bhk_part3_exceptional (r p q : ℕ) (hq18 : 18 ≤ q) (hcop : Nat.gcd p q = 1)
    (h_nogood : ∀ k : ℤ,
      ¬ (Int.fract ((r : ℝ) / q * ((k : ℝ) + 1 / 2)) ∈ Set.Icc (1 / 6 : ℝ) (1 / 2) ∧
         Int.fract ((p : ℝ) / q * ((k : ℝ) + 1 / 2)) ∈ Set.Icc (1 / 6 : ℝ) (1 / 3))) :
    ∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      (∃ k : ℤ, Int.fract ((ij.1 : ℝ) / q) = Int.fract ((k : ℝ) * r / q) ∧
                Int.fract ((ij.2 : ℝ) / q) = Int.fract ((k : ℝ) * p / q)) ∧
      0 ≤ ij.1 ∧ (ij.1 : ℝ) < 6 ∧
      -3 - 1 / 2 * (ij.1 : ℝ) < (ij.2 : ℝ) ∧ (ij.2 : ℝ) < 3 + 1 / 2 * (ij.1 : ℝ) := by
  have hq0 : 0 < q := by omega
  obtain ⟨G, hGlift, hGmem⟩ := bhk_isBHKLift_gen r p q hq0 hcop
  set x₁ : ℝ := 1 / 6 - (r : ℝ) / (2 * q) with hx1def
  set x₂ : ℝ := 1 / 6 - (p : ℝ) / (2 * q) with hx2def
  have hmiss : ¬ ∀ a b, (G ∩ bhkRectangle a b (1 / 3) (1 / 6)).Nonempty := by
    intro hall
    obtain ⟨g, hgG, hgR⟩ := hall x₁ x₂
    obtain ⟨k, hk1, hk2⟩ := hGmem g hgG
    rw [bhkRectangle, Set.mem_setOf_eq] at hgR
    obtain ⟨_, hg1u, _, hg2u⟩ := hgR
    have hb1 : Int.fract (Int.fract (g.1 + (r : ℝ) / (2 * q)) - 1 / 6) ≤ 1 / 3 := by
      rw [show Int.fract (g.1 + (r : ℝ) / (2 * q)) - 1 / 6
            = Int.fract (g.1 + (r : ℝ) / (2 * q)) + (-(1 / 6) : ℝ) from by ring,
          ← bhk_fract_add_fract,
          show g.1 + (r : ℝ) / (2 * q) + (-(1 / 6) : ℝ) = g.1 - x₁ from by rw [hx1def]; ring]
      exact hg1u
    have hwin1 := bhk_window_from_fract (Int.fract_nonneg _) (Int.fract_lt_one _)
      (by norm_num : (1 : ℝ) / 3 < 5 / 6) hb1
    have hSeq1 : Int.fract (g.1 + (r : ℝ) / (2 * q))
        = Int.fract ((r : ℝ) / q * ((k : ℝ) + 1 / 2)) := by
      rw [bhk_fract_add_fract g.1, hk1, ← bhk_fract_add_fract]; congr 1; ring
    rw [hSeq1] at hwin1
    have hb2 : Int.fract (Int.fract (g.2 + (p : ℝ) / (2 * q)) - 1 / 6) ≤ 1 / 6 := by
      rw [show Int.fract (g.2 + (p : ℝ) / (2 * q)) - 1 / 6
            = Int.fract (g.2 + (p : ℝ) / (2 * q)) + (-(1 / 6) : ℝ) from by ring,
          ← bhk_fract_add_fract,
          show g.2 + (p : ℝ) / (2 * q) + (-(1 / 6) : ℝ) = g.2 - x₂ from by rw [hx2def]; ring]
      exact hg2u
    have hwin2 := bhk_window_from_fract (Int.fract_nonneg _) (Int.fract_lt_one _)
      (by norm_num : (1 : ℝ) / 6 < 5 / 6) hb2
    have hSeq2 : Int.fract (g.2 + (p : ℝ) / (2 * q))
        = Int.fract ((p : ℝ) / q * ((k : ℝ) + 1 / 2)) := by
      rw [bhk_fract_add_fract g.2, hk2, ← bhk_fract_add_fract]; congr 1; ring
    rw [hSeq2] at hwin2
    exact h_nogood k ⟨⟨hwin1.1, by linarith [hwin1.2]⟩, ⟨hwin2.1, by linarith [hwin2.2]⟩⟩
  rcases bhk_corollary_6 G q (by omega) hGlift (1 / 3) (1 / 6) (by norm_num) (by norm_num)
      (by norm_num) (by norm_num)
      (by rw [show (1 : ℝ) / 3 * (1 / 6) = 1 / 18 from by norm_num]
          exact one_div_le_one_div_of_le (by norm_num) (by exact_mod_cast hq18)) with
    hhit | ⟨ij, hne, hmemij, h0, h1β, hc1, hc2⟩
  · exact absurd hhit hmiss
  · refine ⟨ij, hne, hGmem _ hmemij, h0, ?_, ?_, ?_⟩
    · norm_num at h1β; exact h1β
    · norm_num at hc1; linarith [hc1]
    · norm_num at hc2; linarith [hc2]


/-- **Grid pigeonhole (the `q < 6|j|` equidistribution engine).**  When `m ∣ q`
(`0 < m ≤ q`) the multiples of `m/q` form an `m/q`-spaced grid on the circle, so
every window `[y, y + m/q]` lying in `[0, 1]` contains one.  This is the kernel of
BHK's Part-4 "a segment of `L_{i,j}` meets `R` with full vertical length `1/6`,
hence `C ∩ R = ∅ ⇒ q < 6|j|`" argument (Cases 5.2.2/5.2.3): the coset's coordinates
on the segment are `|j|/q`-spaced, so avoiding the length-`1/6` crossing forces
`|j|/q > 1/6`. -/
lemma bhk_prop11_grid_hit (m q : ℕ) (hm : 0 < m) (hq : 0 < q) (hmdvd : m ∣ q)
    (y : ℝ) (hy0 : 0 ≤ y) (hy1 : y + (m : ℝ) / q ≤ 1) :
    ∃ t : ℕ, Int.fract ((t * m : ℝ) / q) ∈ Set.Icc y (y + (m : ℝ) / q) := by
  obtain ⟨d, hd⟩ := hmdvd
  have hd0 : 0 < d := by
    rcases Nat.eq_zero_or_pos d with h | h
    · rw [h, Nat.mul_zero] at hd; omega
    · exact h
  have hdR : (0 : ℝ) < d := by exact_mod_cast hd0
  have hmR : (0 : ℝ) < m := by exact_mod_cast hm
  have hqmd : (q : ℝ) = (m : ℝ) * d := by exact_mod_cast hd
  have hmq_eq : (m : ℝ) / q = 1 / d := by rw [hqmd]; field_simp
  rw [hmq_eq] at hy1 ⊢
  set s : ℕ := ⌈y * d⌉₊ with hs
  -- `s ≤ d - 1`, so `s < d` and the grid point `s/d` lies in `[0, 1)`.
  have hyd_le : y * d ≤ (d : ℝ) - 1 := by
    have hy' : y ≤ 1 - 1 / d := by linarith
    have h1 : y * d ≤ (1 - 1 / d) * d := mul_le_mul_of_nonneg_right hy' hdR.le
    have h2 : (1 - 1 / d) * d = (d : ℝ) - 1 := by field_simp
    linarith
  have hsd : s < d := by
    have : s ≤ d - 1 := by
      rw [hs, Nat.ceil_le, Nat.cast_sub hd0, Nat.cast_one]; exact hyd_le
    omega
  have hsmq : (s * m : ℝ) / q = (s : ℝ) / d := by rw [hqmd]; field_simp
  have hfract : Int.fract ((s * m : ℝ) / q) = (s : ℝ) / d := by
    rw [hsmq, Int.fract_eq_self.mpr ⟨by positivity, ?_⟩]
    rw [div_lt_one hdR]; exact_mod_cast hsd
  refine ⟨s, ?_⟩
  rw [hfract]
  refine ⟨?_, ?_⟩
  · rw [le_div_iff₀ hdR, hs]; exact Nat.le_ceil _
  · rw [div_le_iff₀ hdR]
    have hub : (s : ℝ) < y * d + 1 := by rw [hs]; exact Nat.ceil_lt_add_one (by positivity)
    have he : (y + 1 / d) * d = y * d + 1 := by field_simp
    rw [he]; linarith

/-- **`q < 6m` from a missed window (the Part-4 `q < 6|j|` bound).**  If the
`m/q`-spaced grid (`m ∣ q`) avoids a closed window `[y, y + 1/6]` inside `[0, 1]`,
then its spacing exceeds `1/6`, i.e. `q < 6m`.  This is the directly-usable form of
BHK's Case 5.2.2/5.2.3 conclusion: with `m = |j|` and the missed window the
full-height crossing of `R`, `C ∩ R = ∅` yields `q < 6|j|`.  (The remaining Part-4
obligation is to exhibit the coset's coordinates on the segment as this grid and the
crossing as the missed window.) -/
lemma bhk_prop11_grid_avoid (m q : ℕ) (hm : 0 < m) (hq : 0 < q) (hmdvd : m ∣ q)
    (y : ℝ) (hy0 : 0 ≤ y) (hy1 : y + 1 / 6 ≤ 1)
    (havoid : ∀ t : ℕ, Int.fract ((t * m : ℝ) / q) ∉ Set.Icc y (y + 1 / 6)) :
    q < 6 * m := by
  by_contra hle
  push_neg at hle
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq
  have hmq6 : (m : ℝ) / q ≤ 1 / 6 := by
    rw [div_le_iff₀ hqR]
    have h6 : (6 : ℝ) * m ≤ q := by exact_mod_cast hle
    linarith
  have hy1' : y + (m : ℝ) / q ≤ 1 := by linarith
  obtain ⟨t, ht⟩ := bhk_prop11_grid_hit m q hm hq hmdvd y hy0 hy1'
  exact havoid t ⟨ht.1, le_trans ht.2 (by linarith)⟩

/-- **Coset grid pigeonhole.**  A `1/e`-spaced coset `{ b + t/e : t ∈ ℤ }` meets every
closed window `[y, y + w]` of length `w ≥ 1/e` lying inside `[0, 1]`.  This is the coset
form of `bhk_prop11_grid_hit` needed for the anti-diagonal Case 5.2.2: on a slope-`-1`
circle of `L_{i,-i}` the coset's second coordinates are `1/e`-spaced (`e = gcd(r+p, q)`),
so any crossing of `R` of vertical length `≥ 1/e` contains one. -/
lemma bhk_prop11_grid_hit_coset (e : ℕ) (he : 0 < e) (b y w : ℝ)
    (hw : 1 / (e : ℝ) ≤ w) (hy0 : 0 ≤ y) (hy1 : y + w ≤ 1) :
    ∃ t : ℤ, Int.fract (b + (t : ℝ) / e) ∈ Set.Icc y (y + w) := by
  have heR : (0 : ℝ) < e := by exact_mod_cast he
  refine ⟨⌈(y - b) * (e : ℝ)⌉, ?_⟩
  have hlo : y ≤ b + ((⌈(y - b) * (e : ℝ)⌉ : ℤ) : ℝ) / e := by
    have h : y - b ≤ ((⌈(y - b) * (e : ℝ)⌉ : ℤ) : ℝ) / e :=
      (le_div_iff₀ heR).mpr (Int.le_ceil _)
    linarith
  have hhi0 : ((⌈(y - b) * (e : ℝ)⌉ : ℤ) : ℝ) / e < (y - b) + 1 / e := by
    rw [div_lt_iff₀ heR, show ((y - b) + 1 / (e : ℝ)) * e = (y - b) * e + 1 from by field_simp]
    exact Int.ceil_lt_add_one _
  have hhi : b + ((⌈(y - b) * (e : ℝ)⌉ : ℤ) : ℝ) / e < y + w := by linarith
  rw [Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩]
  exact ⟨hlo, le_of_lt hhi⟩

/-- **Coprime-step coset grid pigeonhole.**  When `gcd(c, e) = 1`, the coset
`{ b + t·c/e : t ∈ ℤ }` equals the plain `1/e`-coset, so it too meets every window of
length `≥ 1/e` in `[0,1]`.  On a slope-`-1` circle of `L_{i,-i}` the second coordinate
advances by `p/e` per step (with `gcd(p,e) = 1`), so this is the form the anti-diagonal
witness search consumes. -/
lemma bhk_prop11_grid_hit_coset_step (e : ℕ) (he : 0 < e) (c : ℕ) (hc : Nat.Coprime c e)
    (b y w : ℝ) (hw : 1 / (e : ℝ) ≤ w) (hy0 : 0 ≤ y) (hy1 : y + w ≤ 1) :
    ∃ t : ℤ, Int.fract (b + (t : ℝ) * c / e) ∈ Set.Icc y (y + w) := by
  obtain ⟨t', ht'⟩ := bhk_prop11_grid_hit_coset e he b y w hw hy0 hy1
  have hcop : IsCoprime (c : ℤ) (e : ℤ) := by
    rw [Int.isCoprime_iff_gcd_eq_one]; simpa [Int.gcd] using hc
  obtain ⟨a, b', hab⟩ := hcop
  have hab' : (a : ℝ) * c + b' * e = 1 := by exact_mod_cast hab
  have he0 : (e : ℝ) ≠ 0 := by positivity
  refine ⟨t' * a, ?_⟩
  have heq : b + ((t' * a : ℤ) : ℝ) * (c : ℝ) / e
      = (b + (t' : ℝ) / e) + ((-(t' * b') : ℤ) : ℝ) := by
    push_cast; field_simp; linear_combination (t' : ℝ) * hab'
  rw [heq, Int.fract_add_intCast]
  exact ht'

/-- **Anti-diagonal divisibility.**  If `q ∣ i·m` then `q / gcd(i,q)` divides `m` and so
is `≤ gcd(m, q)`.  Applied with `m = r + p` and the exceptional relation `q ∣ i·(r+p)` of
the pair `(i, -i)`: the slope-`-1` circles of `L_{i,-i}` carry the coset on a
`1/gcd(r+p,q)`-spaced grid, and `gcd(r+p,q) ≥ q/gcd(i,q) ≥ 6` once `q ≥ 6·gcd(i,q)`. -/
lemma bhk_prop11_antidiag_arith (i q m : ℕ) (hi : 0 < i) (hq : 0 < q) (hdvd : q ∣ i * m) :
    (q / Nat.gcd i q) ∣ m ∧ q / Nat.gcd i q ≤ Nat.gcd m q := by
  have hgpos : 0 < Nat.gcd i q := Nat.gcd_pos_of_pos_left q hi
  set d := Nat.gcd i q with hd
  have hdi : d ∣ i := Nat.gcd_dvd_left i q
  have hdq : d ∣ q := Nat.gcd_dvd_right i q
  have hcop : Nat.Coprime (q / d) (i / d) := (Nat.coprime_div_gcd_div_gcd hgpos).symm
  have key : (q / d) ∣ (i / d) * m := by
    have e1 : d * (q / d) ∣ d * ((i / d) * m) := by
      rw [Nat.mul_div_cancel' hdq, ← mul_assoc, Nat.mul_div_cancel' hdi]; exact hdvd
    exact (Nat.mul_dvd_mul_iff_left hgpos).mp e1
  have hm : (q / d) ∣ m := hcop.dvd_of_dvd_mul_left key
  exact ⟨hm, Nat.le_of_dvd (Nat.gcd_pos_of_pos_right m hq)
    (Nat.dvd_gcd hm ⟨d, (Nat.div_mul_cancel hdq).symm⟩)⟩


/-- **Sub-lemma B (gap-piece bound).** A closed sub-interval of `[a, b]` that is
    disjoint from `unsafeOf speeds 3` lies in `unsafeOf speeds 4`, and hence
    has length `< 1 / (3 v_5)`. Specifically, for any integer `k`, the closed
    sub-interval `[max(a, (k+1/6)/v_4), min(b, (k+5/6)/v_4)]` (if non-trivial)
    is in `unsafeOf 4`, and has length `< 1/(3 v_5)`. -/
lemma gap_piece_bound (speeds : Fin 5 → ℕ)
    (hpos : ∀ i, 0 < speeds i)
    (a b : ℝ) (hab : a ≤ b)
    (hI : Set.Icc a b ⊆ unsafeOf speeds ⟨3, by omega⟩ ∪ unsafeOf speeds ⟨4, by omega⟩)
    (k : ℤ)
    (sL sR : ℝ) (hsL_a : a ≤ sL) (hsR_b : sR ≤ b) (hsLR : sL ≤ sR)
    (hgapL : ((k : ℝ) + 1/6) / (speeds ⟨3, by omega⟩ : ℝ) ≤ sL)
    (hgapR : sR ≤ ((k : ℝ) + 5/6) / (speeds ⟨3, by omega⟩ : ℝ)) :
    sR - sL < 1 / (3 * (speeds ⟨4, by omega⟩ : ℝ)) := by
  -- Show [sL, sR] ⊆ unsafeOf 4
  have hv3pos : 0 < speeds ⟨3, by omega⟩ := hpos _
  have hv4pos : 0 < speeds ⟨4, by omega⟩ := hpos _
  have hsub_U4 : Set.Icc sL sR ⊆ unsafeOf speeds ⟨4, by omega⟩ := by
    intro t ht
    obtain ⟨htL, htR⟩ := ht
    have ht_ab : t ∈ Set.Icc a b := ⟨le_trans hsL_a htL, le_trans htR hsR_b⟩
    have ht_S : t ∈ unsafeOf speeds ⟨3, by omega⟩ ∪ unsafeOf speeds ⟨4, by omega⟩ := hI ht_ab
    -- Need to rule out t ∈ unsafeOf 3
    have ht_notU3 : t ∉ unsafeOf speeds ⟨3, by omega⟩ :=
      not_mem_unsafeOf_of_in_gap speeds ⟨3, by omega⟩ hv3pos k t
        (le_trans hgapL htL) (le_trans htR hgapR)
    rcases ht_S with h | h
    · exact absurd h ht_notU3
    · exact h
  exact block_length_bound speeds ⟨4, by omega⟩ hv4pos sL sR hsLR hsub_U4


end LRC.OrderSixN.S7
