namespace LRC.S5K1Mid

structure Bx where
  a0 : ℚ
  a1 : ℚ
  k0 : ℚ
  k1 : ℚ
  b0 : ℚ
  b1 : Option ℚ
  n0 : ℚ
  n1 : Option ℚ

inductive T5
  | L (k m0 m1 m2 m3 m4 : ℕ)
  | E
  | S (d : ℕ) (l r : T5)

def lo (B : Bx) : Fin 5 → ℚ := ![B.a0, 1, 1 + B.a0 * B.k0, 1 + B.b0, (1 + B.b0) * B.n0]

def hiO (B : Bx) : Fin 5 → Option ℚ :=
  ![some B.a1, some 1, some (1 + B.a1 * B.k1), B.b1.map (fun b => 1 + b),
    match B.b1, B.n1 with
    | some b, some n => some ((1 + b) * n)
    | _, _ => none]

def hv (B : Bx) (i : Fin 5) : ℚ := (hiO B i).getD 1

def inB (k : ℕ) (i : Fin 5) : Bool := k == 0 || (k == 5 && decide (i.val < 3)) || (decide (1 ≤ k) && decide (k ≤ 4) && i.val != k)

def loV (B : Bx) (m : Fin 5 → ℕ) (i : Fin 5) : ℚ := ((m i : ℚ) + 1 / 6) / lo B i
def hiV (B : Bx) (m : Fin 5 → ℕ) (i : Fin 5) : ℚ := ((m i : ℚ) + 5 / 6) / hv B i

def ya (B : Bx) (k : ℕ) (m : Fin 5 → ℕ) : ℚ :=
  max (loV B m 0) (max (if inB k 1 then loV B m 1 else 0) (max (if inB k 2 then loV B m 2 else 0)
    (max (if inB k 3 then loV B m 3 else 0) (if inB k 4 then loV B m 4 else 0))))

def yb (B : Bx) (k : ℕ) (m : Fin 5 → ℕ) : ℚ :=
  min (hiV B m 0) (min (if inB k 1 then hiV B m 1 else hiV B m 0) (min (if inB k 2 then hiV B m 2 else hiV B m 0)
    (min (if inB k 3 then hiV B m 3 else hiV B m 0) (if inB k 4 then hiV B m 4 else hiV B m 0))))

def foldLo (B : Bx) (k : ℕ) : ℚ := lo B ⟨k % 5, Nat.mod_lt _ (by norm_num)⟩

/-- Kind 6: the box lies in the neighbourhood `N₁` of `(1, 3, 4, 5, 9)` (`tight_13459`), with `κ = 1`. -/
def tp1OK (B : Bx) : Bool :=
  decide (B.k0 = 1) && decide (B.k1 = 1) && decide (0 < B.a0) && decide (0 ≤ B.b0) && decide (1 ≤ B.n0) &&
    match B.b1, B.n1 with
    | some b1, some n1 => decide (14 * B.a1 ≤ 5) && decide (5 ≤ 17 * B.a0) && decide (5 * (1 + b1) ≤ 29 * B.a0) &&
        decide (43 * B.a1 ≤ 5 * (1 + B.b0) * B.n0) && decide (5 * (1 + b1) * n1 ≤ 47 * B.a0)
    | _, _ => false

/-- Kind 7: the box lies in the neighbourhood `N₂` of `(1, 2, 3, 4, 5)` (`tight_12345`), with `κ = 1`. -/
def tp2OK (B : Bx) : Bool :=
  decide (B.k0 = 1) && decide (B.k1 = 1) && decide (0 < B.a0) && decide (0 ≤ B.b0) && decide (1 ≤ B.n0) &&
    match B.b1, B.n1 with
    | some b1, some n1 => decide (5 ≤ 11 * B.a0) && decide (19 * B.a1 ≤ 5 * (1 + B.b0)) &&
        decide (5 * (1 + b1) ≤ 23 * B.a0) && decide (5 * (1 + b1) * n1 ≤ 29 * B.a0)
    | _, _ => false

def leafOK0 (B : Bx) (k : ℕ) (m : Fin 5 → ℕ) : Bool :=
  decide (0 < B.a0) && decide (0 ≤ B.k0) && decide (0 ≤ B.b0) && decide (1 ≤ B.n0) && decide (k ≤ 5) &&
    (List.finRange 5).all (fun i => !inB k i || (hiO B i).isSome) &&
    decide (ya B k m ≤ yb B k m) &&
    (if k = 0 then true
     else if k = 5 then decide (2 / 3 ≤ lo B 3 * (yb B k m - ya B k m))
     else decide (1 / 3 ≤ foldLo B k * (yb B k m - ya B k m)))

def leafOK (B : Bx) (k : ℕ) (m : Fin 5 → ℕ) : Bool :=
  if k = 6 then tp1OK B else if k = 7 then tp2OK B else leafOK0 B k m

def emptyB (B : Bx) : Bool :=
  decide (0 ≤ B.a0) && decide (0 ≤ B.k0) && decide (1 ≤ B.a0 * (3 - B.k1)) ||
    (decide (0 ≤ B.a0) && decide (0 ≤ B.k0) && match B.b1 with
     | some b1 => decide (b1 ≤ B.a0 * B.k0)
     | none => false)

def splitB (B : Bx) (d : ℕ) : Bx × Bx :=
  if d = 0 then
    (⟨B.a0, (B.a0 + B.a1) / 2, B.k0, B.k1, B.b0, B.b1, B.n0, B.n1⟩, ⟨(B.a0 + B.a1) / 2, B.a1, B.k0, B.k1, B.b0, B.b1, B.n0, B.n1⟩)
  else if d = 1 then
    (⟨B.a0, B.a1, B.k0, (B.k0 + B.k1) / 2, B.b0, B.b1, B.n0, B.n1⟩, ⟨B.a0, B.a1, (B.k0 + B.k1) / 2, B.k1, B.b0, B.b1, B.n0, B.n1⟩)
  else if d = 2 then
    let x := match B.b1 with
      | some b1 => (B.b0 + b1) / 2
      | none => max 1 (2 * B.b0)
    (⟨B.a0, B.a1, B.k0, B.k1, B.b0, some x, B.n0, B.n1⟩, ⟨B.a0, B.a1, B.k0, B.k1, x, B.b1, B.n0, B.n1⟩)
  else
    let x := match B.n1 with
      | some n1 => (B.n0 + n1) / 2
      | none => max 2 (2 * B.n0)
    (⟨B.a0, B.a1, B.k0, B.k1, B.b0, B.b1, B.n0, some x⟩, ⟨B.a0, B.a1, B.k0, B.k1, B.b0, B.b1, x, B.n1⟩)

def check : T5 → Bx → Bool
  | .L k m0 m1 m2 m3 m4, B => leafOK B k ![m0, m1, m2, m3, m4]
  | .E, B => emptyB B
  | .S d l r, B => check l (splitB B d).1 && check r (splitB B d).2

def root : Bx := ⟨1 / 50, 1 / 25, 1, 1, 0, none, 1, none⟩


