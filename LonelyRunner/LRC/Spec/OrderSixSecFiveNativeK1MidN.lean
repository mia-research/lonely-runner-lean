/-! ### Soundness -/

open LRC.S7Native LRC.S8Native LRC.S6Native

def InBox (B : Bx) (α κ β ν : ℝ) : Prop :=
  (B.a0 : ℝ) ≤ α ∧ α ≤ B.a1 ∧ (B.k0 : ℝ) ≤ κ ∧ κ ≤ B.k1 ∧ (B.b0 : ℝ) ≤ β ∧ (∀ b, B.b1 = some b → β ≤ (b : ℝ)) ∧
    (B.n0 : ℝ) ≤ ν ∧ (∀ n, B.n1 = some n → ν ≤ (n : ℝ))

/-- The domain: `0 < α`, `0 ≤ κ`, `0 ≤ β`, `1 ≤ ν`, `α(3 − κ) < 1` (`3v₁ < v₃`), `ακ < β` (`v₃ < v₄`). -/
def Dom (α κ β ν : ℝ) : Prop := 0 < α ∧ 0 ≤ κ ∧ κ ≤ 1 ∧ 0 ≤ β ∧ 1 ≤ ν ∧ α * (3 - κ) < 1 ∧ α * κ < β

def cs (α κ β ν : ℝ) : Fin 5 → ℝ := ![α, 1, 1 + α * κ, 1 + β, (1 + β) * ν]

def LonelyF (w : Fin 5 → ℝ) : Prop := ∃ t : ℝ, ∀ i, (6 : ℝ)⁻¹ ≤ circDist (w i * t)

theorem emptyB_sound {B : Bx} {α κ β ν : ℝ} (h : emptyB B = true) (hb : InBox B α κ β ν) (hd : Dom α κ β ν) :
    False := by
  obtain ⟨ha0, ha1, hk0, hk1, hb0, hb1, hn0, hn1⟩ := hb
  obtain ⟨hα, hκ, hκ2, hβ, hν, h3, hακ⟩ := hd
  unfold emptyB at h
  simp only [Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq] at h
  rcases h with ⟨⟨hA, hK⟩, h⟩ | ⟨⟨hA, hK⟩, h⟩
  · have hA' : (0 : ℝ) ≤ B.a0 := by exact_mod_cast hA
    have h' : ((1 : ℚ) : ℝ) ≤ ((B.a0 * (3 - B.k1) : ℚ) : ℝ) := by exact_mod_cast h
    push_cast at h'
    have e1 : (B.a0 : ℝ) * (3 - B.k1) ≤ B.a0 * (3 - κ) := mul_le_mul_of_nonneg_left (by linarith) hA'
    have e2 : (B.a0 : ℝ) * (3 - κ) ≤ α * (3 - κ) := mul_le_mul_of_nonneg_right ha0 (by linarith)
    linarith
  · have hA' : (0 : ℝ) ≤ B.a0 := by exact_mod_cast hA
    have hK' : (0 : ℝ) ≤ B.k0 := by exact_mod_cast hK
    rcases hB1 : B.b1 with _ | b1 <;> rw [hB1] at h
    · simp at h
    · simp only [decide_eq_true_eq] at h
      have h' : ((b1 : ℚ) : ℝ) ≤ ((B.a0 * B.k0 : ℚ) : ℝ) := by exact_mod_cast h
      push_cast at h'
      have := hb1 b1 hB1
      have : (B.a0 : ℝ) * B.k0 ≤ α * κ := mul_le_mul ha0 hk0 hK' hα.le
      linarith

theorem splitB_sound (B : Bx) (d : ℕ) {α κ β ν : ℝ} (hb : InBox B α κ β ν) :
    InBox (splitB B d).1 α κ β ν ∨ InBox (splitB B d).2 α κ β ν := by
  obtain ⟨ha0, ha1, hk0, hk1, hb0, hb1, hn0, hn1⟩ := hb
  unfold splitB
  split_ifs with h0 h1 h2
  · rcases le_total α (((B.a0 + B.a1) / 2 : ℚ) : ℝ) with h | h
    · exact Or.inl ⟨ha0, h, hk0, hk1, hb0, hb1, hn0, hn1⟩
    · exact Or.inr ⟨h, ha1, hk0, hk1, hb0, hb1, hn0, hn1⟩
  · rcases le_total κ (((B.k0 + B.k1) / 2 : ℚ) : ℝ) with h | h
    · exact Or.inl ⟨ha0, ha1, hk0, h, hb0, hb1, hn0, hn1⟩
    · exact Or.inr ⟨ha0, ha1, h, hk1, hb0, hb1, hn0, hn1⟩
  · generalize hx : (match B.b1 with
      | some b1 => (B.b0 + b1) / 2
      | none => max 1 (2 * B.b0) : ℚ) = x
    rcases le_total β (x : ℝ) with h | h
    · exact Or.inl ⟨ha0, ha1, hk0, hk1, hb0, fun b hb => by simp at hb; rw [← hb]; exact h, hn0, hn1⟩
    · exact Or.inr ⟨ha0, ha1, hk0, hk1, h, hb1, hn0, hn1⟩
  · generalize hx : (match B.n1 with
      | some n1 => (B.n0 + n1) / 2
      | none => max 2 (2 * B.n0) : ℚ) = x
    rcases le_total ν (x : ℝ) with h | h
    · exact Or.inl ⟨ha0, ha1, hk0, hk1, hb0, hb1, hn0, fun n hn => by simp at hn; rw [← hn]; exact h⟩
    · exact Or.inr ⟨ha0, ha1, hk0, hk1, hb0, hb1, h, hn1⟩

theorem band_of {lo c hv m y : ℝ} (hlo : lo ≤ c) (hlo0 : 0 < lo) (hhi : c ≤ hv) (h1 : (m + 1 / 6) / lo ≤ y)
    (h2 : y ≤ (m + 5 / 6) / hv) (hy0 : 0 ≤ y) : m + 1 / 6 ≤ c * y ∧ c * y ≤ m + 5 / 6 := by
  have hv0 : 0 < hv := by linarith
  rw [div_le_iff₀ hlo0] at h1; rw [le_div_iff₀ hv0] at h2
  constructor <;> nlinarith

theorem lo_hi {B : Bx} {α κ β ν : ℝ} (hb : InBox B α κ β ν) (hd : Dom α κ β ν) (hA : 0 < B.a0) (hK : 0 ≤ B.k0)
    (hB0 : 0 ≤ B.b0) (hN : 1 ≤ B.n0) (i : Fin 5) :
    ((lo B i : ℚ) : ℝ) ≤ cs α κ β ν i ∧ 0 < ((lo B i : ℚ) : ℝ) ∧
      ((hiO B i).isSome = true → cs α κ β ν i ≤ ((hv B i : ℚ) : ℝ)) := by
  obtain ⟨ha0, ha1, hk0, hk1, hb0, hb1, hn0, hn1⟩ := hb
  obtain ⟨hα, hκ, hκ2, hβ, hν, h3, hακ⟩ := hd
  have hA' : (0 : ℝ) < B.a0 := by exact_mod_cast hA
  have hK' : (0 : ℝ) ≤ B.k0 := by exact_mod_cast hK
  have hB0' : (0 : ℝ) ≤ B.b0 := by exact_mod_cast hB0
  have hN' : (1 : ℝ) ≤ B.n0 := by exact_mod_cast hN
  fin_cases i
  · refine ⟨by simp [lo, cs]; exact ha0, by simp [lo]; exact hA, fun _ => by simp [hv, hiO, cs]; exact ha1⟩
  · refine ⟨by simp [lo, cs], by simp [lo], fun _ => by simp [hv, hiO, cs]⟩
  · refine ⟨?_, ?_, fun _ => ?_⟩
    · simp [lo, cs]; exact mul_le_mul ha0 hk0 hK' hα.le
    · simp [lo]; positivity
    · simp [hv, hiO, cs]; exact mul_le_mul ha1 hk1 hκ (by linarith)
  · refine ⟨by simp [lo, cs]; linarith, by simp [lo]; linarith, fun hs => ?_⟩
    rcases hB1 : B.b1 with _ | b
    · simp [hiO, hB1] at hs
    · simp [hv, hiO, hB1, cs]; linarith [hb1 b hB1]
  · refine ⟨?_, ?_, fun hs => ?_⟩
    · simp [lo, cs]; exact mul_le_mul (by linarith) hn0 (by linarith) (by linarith)
    · simp [lo]; positivity
    · rcases hB1 : B.b1 with _ | b <;> rcases hN1 : B.n1 with _ | n <;> simp [hiO, hB1, hN1] at hs
      simp [hv, hiO, hB1, hN1, cs]
      exact mul_le_mul (by linarith [hb1 b hB1]) (hn1 n hN1) (by linarith) (by linarith [hb1 b hB1])

set_option maxHeartbeats 4000000 in
theorem leaf0_sound {B : Bx} {k : ℕ} {m : Fin 5 → ℕ} (hok : leafOK0 B k m = true) {α κ β ν V : ℝ} (hV : 0 < V)
    (hb : InBox B α κ β ν) (hd : Dom α κ β ν) : LonelyF (fun i => cs α κ β ν i * V) := by
  unfold leafOK0 at hok
  simp only [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, List.mem_finRange, true_implies,
    Bool.or_eq_true, Bool.not_eq_true'] at hok
  obtain ⟨⟨⟨⟨⟨⟨⟨hA, hK⟩, hB0⟩, hN⟩, hk5⟩, hsome⟩, hy⟩, hkind⟩ := hok
  have LH := lo_hi hb hd hA hK hB0 hN
  set Y1 := ya B k m with hY1
  set Y2 := yb B k m with hY2
  have hy' : (Y1 : ℝ) ≤ Y2 := by exact_mod_cast hy
  have hY0 : (0 : ℝ) ≤ Y1 := by
    have : (0 : ℚ) ≤ loV B m 0 := by
      unfold loV; apply div_nonneg (by positivity)
      have := (LH 0).2.1; exact_mod_cast this.le
    have h2 : loV B m 0 ≤ Y1 := by rw [hY1]; unfold ya; exact le_max_left _ _
    exact_mod_cast le_trans this h2
  -- the block runners are in their bands across [Y1, Y2]
  have hlo : ∀ i, inB k i = true → loV B m i ≤ Y1 := by
    intro i hi; rw [hY1]; unfold ya
    fin_cases i
    · exact le_max_left _ _
    · have hi' : inB k 1 = true := hi
      rw [if_pos hi']; exact le_max_of_le_right (le_max_left _ _)
    · have hi' : inB k 2 = true := hi
      rw [if_pos hi']; exact le_max_of_le_right (le_max_of_le_right (le_max_left _ _))
    · have hi' : inB k 3 = true := hi
      rw [if_pos hi']; exact le_max_of_le_right (le_max_of_le_right (le_max_of_le_right (le_max_left _ _)))
    · have hi' : inB k 4 = true := hi
      rw [if_pos hi']; exact le_max_of_le_right (le_max_of_le_right (le_max_of_le_right (le_max_right _ _)))
  have hhi : ∀ i, inB k i = true → Y2 ≤ hiV B m i := by
    intro i hi; rw [hY2]; unfold yb
    fin_cases i
    · exact min_le_left _ _
    · have hi' : inB k 1 = true := hi
      rw [if_pos hi']; exact min_le_of_right_le (min_le_left _ _)
    · have hi' : inB k 2 = true := hi
      rw [if_pos hi']; exact min_le_of_right_le (min_le_of_right_le (min_le_left _ _))
    · have hi' : inB k 3 = true := hi
      rw [if_pos hi']; exact min_le_of_right_le (min_le_of_right_le (min_le_of_right_le (min_le_left _ _)))
    · have hi' : inB k 4 = true := hi
      rw [if_pos hi']; exact min_le_of_right_le (min_le_of_right_le (min_le_of_right_le (min_le_right _ _)))
  have band : ∀ i, inB k i = true → ∀ y : ℝ, (Y1 : ℝ) ≤ y → y ≤ Y2 →
      (6 : ℝ)⁻¹ ≤ circDist (cs α κ β ν i * V * (y / V)) := by
    intro i hi y h1 h2
    have hs : (hiO B i).isSome = true := by
      rcases hsome i with h | h
      · rw [hi] at h; exact absurd h (by decide)
      · exact h
    have l1 : ((m i : ℝ) + 1 / 6) / ((lo B i : ℚ) : ℝ) ≤ y := by
      have := hlo i hi; unfold loV at this
      have := (Rat.cast_le (K := ℝ)).mpr this; push_cast at this; linarith
    have l2 : y ≤ ((m i : ℝ) + 5 / 6) / ((hv B i : ℚ) : ℝ) := by
      have := hhi i hi; unfold hiV at this
      have := (Rat.cast_le (K := ℝ)).mpr this; push_cast at this; linarith
    obtain ⟨b1, b2⟩ := band_of (LH i).1 (LH i).2.1 ((LH i).2.2 hs) l1 l2 (by linarith)
    rw [show cs α κ β ν i * V * (y / V) = cs α κ β ν i * y by field_simp]
    exact clear_of_band (p := (m i : ℤ)) (by push_cast; linarith) (by push_cast; linarith)
  have hlen : ((Y2 : ℝ) - Y1) / V ≥ 0 := div_nonneg (by linarith) hV.le
  -- three closers
  have closeBox : (∀ i, inB k i = true) → LonelyF (fun i => cs α κ β ν i * V) := by
    intro hall
    exact ⟨(Y1 : ℝ) / V, fun i => band i (hall i) Y1 le_rfl hy'⟩
  have closeFold : ∀ r : Fin 5, (∀ i, i ≠ r → inB k i = true) → 1 / 3 ≤ lo B r * (Y2 - Y1) →
      LonelyF (fun i => cs α κ β ν i * V) := by
    intro r hr hf
    have hf' : (1 / 3 : ℝ) ≤ (lo B r : ℝ) * ((Y2 : ℝ) - Y1) := by
      have := (Rat.cast_le (K := ℝ)).mpr hf; push_cast at this; exact this
    have hc : (lo B r : ℝ) ≤ cs α κ β ν r := (LH r).1
    have hc0 : 0 < cs α κ β ν r := lt_of_lt_of_le (LH r).2.1 hc
    obtain ⟨t, ht1, ht2, ht⟩ := fold_one (b := cs α κ β ν r * V) (J₀ := (Y1 : ℝ) / V) (ℓ := ((Y2 : ℝ) - Y1) / V)
      (by positivity) (by
        rw [div_le_div_iff₀ (by positivity) hV]
        have : (lo B r : ℝ) * ((Y2 : ℝ) - Y1) ≤ cs α κ β ν r * ((Y2 : ℝ) - Y1) :=
          mul_le_mul_of_nonneg_right hc (by linarith)
        nlinarith)
    refine ⟨t, fun i => ?_⟩
    by_cases hir : i = r
    · subst hir; exact ht
    · have e : t = (t * V) / V := by field_simp
      rw [e]
      apply band i (hr i hir) (t * V)
      · have : (Y1 : ℝ) / V ≤ t := ht1
        rw [div_le_iff₀ hV] at this; linarith
      · have : t ≤ (Y1 : ℝ) / V + ((Y2 : ℝ) - Y1) / V := ht2
        rw [← add_div, le_div_iff₀ hV] at this; linarith
  have closeW : (∀ i : Fin 5, i.val < 3 → inB k i = true) → 2 / 3 ≤ lo B 3 * (Y2 - Y1) →
      LonelyF (fun i => cs α κ β ν i * V) := by
    intro hr hf
    have hf' : (2 / 3 : ℝ) ≤ (lo B 3 : ℝ) * ((Y2 : ℝ) - Y1) := by
      have := (Rat.cast_le (K := ℝ)).mpr hf; push_cast at this; exact this
    have hc : (lo B 3 : ℝ) ≤ cs α κ β ν 3 := (LH 3).1
    have hc0 : 0 < cs α κ β ν 3 := lt_of_lt_of_le (LH 3).2.1 hc
    have h34 : cs α κ β ν 3 * V ≤ cs α κ β ν 4 * V := by
      obtain ⟨-, -, -, hβ, hν, -, -⟩ := hd
      have e3 : cs α κ β ν 3 = 1 + β := rfl
      have e4 : cs α κ β ν 4 = (1 + β) * ν := rfl
      rw [e3, e4]
      have : (1 + β) * 1 ≤ (1 + β) * ν := mul_le_mul_of_nonneg_left hν (by linarith)
      nlinarith
    obtain ⟨t, ht1, ht2, c3, c4⟩ := window_two_uniform (a := cs α κ β ν 3 * V) (b := cs α κ β ν 4 * V)
      (J₀ := (Y1 : ℝ) / V) (ℓ := ((Y2 : ℝ) - Y1) / V) (by positivity) h34 (by
        rw [div_le_div_iff₀ (by positivity) hV]
        have : (lo B 3 : ℝ) * ((Y2 : ℝ) - Y1) ≤ cs α κ β ν 3 * ((Y2 : ℝ) - Y1) :=
          mul_le_mul_of_nonneg_right hc (by linarith)
        nlinarith)
    refine ⟨t, fun i => ?_⟩
    fin_cases i
    · have e : t = (t * V) / V := by field_simp
      rw [e]; apply band 0 (hr 0 (by decide)) (t * V)
      · have : (Y1 : ℝ) / V ≤ t := ht1
        rw [div_le_iff₀ hV] at this; linarith
      · have : t ≤ (Y1 : ℝ) / V + ((Y2 : ℝ) - Y1) / V := ht2
        rw [← add_div, le_div_iff₀ hV] at this; linarith
    · have e : t = (t * V) / V := by field_simp
      rw [e]; apply band 1 (hr 1 (by decide)) (t * V)
      · have : (Y1 : ℝ) / V ≤ t := ht1
        rw [div_le_iff₀ hV] at this; linarith
      · have : t ≤ (Y1 : ℝ) / V + ((Y2 : ℝ) - Y1) / V := ht2
        rw [← add_div, le_div_iff₀ hV] at this; linarith
    · have e : t = (t * V) / V := by field_simp
      rw [e]; apply band 2 (hr 2 (by decide)) (t * V)
      · have : (Y1 : ℝ) / V ≤ t := ht1
        rw [div_le_iff₀ hV] at this; linarith
      · have : t ≤ (Y1 : ℝ) / V + ((Y2 : ℝ) - Y1) / V := ht2
        rw [← add_div, le_div_iff₀ hV] at this; linarith
    · exact c3
    · exact c4
  -- by kind
  interval_cases k
  · exact closeBox (fun i => by fin_cases i <;> rfl)
  · exact closeFold 1 (fun i hi => by fin_cases i <;> first | rfl | exact absurd rfl hi) (by simpa [foldLo] using hkind)
  · exact closeFold 2 (fun i hi => by fin_cases i <;> first | rfl | exact absurd rfl hi) (by simpa [foldLo] using hkind)
  · exact closeFold 3 (fun i hi => by fin_cases i <;> first | rfl | exact absurd rfl hi) (by simpa [foldLo] using hkind)
  · exact closeFold 4 (fun i hi => by fin_cases i <;> first | rfl | exact absurd rfl hi) (by simpa [foldLo] using hkind)
  · exact closeW (fun i hi => by fin_cases i <;> first | rfl | (simp at hi)) (by simpa using hkind)

theorem tp1_sound {B : Bx} (h : tp1OK B = true) {α κ β ν V : ℝ} (hV : 0 < V) (hb : InBox B α κ β ν)
    (hd : Dom α κ β ν) : LonelyF (fun i => cs α κ β ν i * V) := by
  obtain ⟨ha0, ha1, hk0, hk1, hb0, hb1, hn0, hn1⟩ := hb
  obtain ⟨hα, hκ, hκ2, hβ, hν, h3, hακ⟩ := hd
  unfold tp1OK at h
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨⟨hK0, hK1⟩, hA⟩, hB0⟩, hN0⟩, h⟩ := h
  rcases hB1 : B.b1 with _ | b1 <;> rcases hN1 : B.n1 with _ | n1 <;> rw [hB1, hN1] at h <;> simp at h
  obtain ⟨⟨⟨⟨q1, q2⟩, q3⟩, q4⟩, q5⟩ := h
  have hb1' := hb1 b1 hB1; have hn1' := hn1 n1 hN1
  rw [hK0] at hk0; rw [hK1] at hk1; push_cast at hk0 hk1
  have hκ1 : κ = 1 := le_antisymm hk1 hk0
  subst hκ1
  have c1 : ((14 * B.a1 : ℚ) : ℝ) ≤ ((5 : ℚ) : ℝ) := by exact_mod_cast q1
  have c2 : ((5 : ℚ) : ℝ) ≤ ((17 * B.a0 : ℚ) : ℝ) := by exact_mod_cast q2
  have c3 : ((5 * (1 + b1) : ℚ) : ℝ) ≤ ((29 * B.a0 : ℚ) : ℝ) := by exact_mod_cast q3
  have c4 : ((43 * B.a1 : ℚ) : ℝ) ≤ ((5 * (1 + B.b0) * B.n0 : ℚ) : ℝ) := by exact_mod_cast q4
  have c5 : ((5 * (1 + b1) * n1 : ℚ) : ℝ) ≤ ((47 * B.a0 : ℚ) : ℝ) := by exact_mod_cast q5
  push_cast at c1 c2 c3 c4 c5
  have hB0' : (0 : ℝ) ≤ B.b0 := by exact_mod_cast hB0
  have hN0' : (1 : ℝ) ≤ B.n0 := by exact_mod_cast hN0
  have p4 : (5 : ℝ) * (1 + B.b0) * B.n0 ≤ 5 * (1 + β) * ν :=
    by have := mul_le_mul (show (1 + (B.b0 : ℝ)) ≤ 1 + β by linarith) hn0 (by linarith) (by linarith); nlinarith
  have p5 : (5 : ℝ) * (1 + β) * ν ≤ 5 * (1 + b1) * n1 :=
    by have := mul_le_mul (show 1 + β ≤ 1 + (b1 : ℝ) by linarith) hn1' (by linarith) (by linarith); nlinarith
  have s1 : 14 * α ≤ 5 := by linarith
  have s2 : 5 ≤ 17 * α := by linarith
  have s3 : 1 + α * 1 ≤ 1 + β := by linarith
  have s4 : 5 * (1 + β) ≤ 29 * α := by linarith
  have s5 : 43 * α ≤ 5 * (1 + β) * ν := by linarith
  have s6 : 5 * (1 + β) * ν ≤ 47 * α := by linarith
  have mv := fun {x y : ℝ} (h : x ≤ y) => mul_le_mul_of_nonneg_right h hV.le
  obtain ⟨t, a1, a2, a3, a4, a5⟩ := tight_13459' (v1 := α * V) (v2 := V) (v3 := (1 + α * 1) * V) (v4 := (1 + β) * V)
    (v5 := (1 + β) * ν * V) (by positivity) (by ring) (by nlinarith [mv s1]) (by nlinarith [mv s2])
    (mv s3) (by nlinarith [mv s4]) (by nlinarith [mv s5]) (by nlinarith [mv s6])
  refine ⟨t, fun i => ?_⟩
  fin_cases i
  · simpa [cs] using a1
  · simpa [cs] using a2
  · simpa [cs] using a3
  · simpa [cs] using a4
  · simpa [cs] using a5

theorem tp2_sound {B : Bx} (h : tp2OK B = true) {α κ β ν V : ℝ} (hV : 0 < V) (hb : InBox B α κ β ν)
    (hd : Dom α κ β ν) : LonelyF (fun i => cs α κ β ν i * V) := by
  obtain ⟨ha0, ha1, hk0, hk1, hb0, hb1, hn0, hn1⟩ := hb
  obtain ⟨hα, hκ, hκ2, hβ, hν, h3, hακ⟩ := hd
  unfold tp2OK at h
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨⟨hK0, hK1⟩, hA⟩, hB0⟩, hN0⟩, h⟩ := h
  rcases hB1 : B.b1 with _ | b1 <;> rcases hN1 : B.n1 with _ | n1 <;> rw [hB1, hN1] at h <;> simp at h
  obtain ⟨⟨⟨q1, q2⟩, q3⟩, q4⟩ := h
  have hb1' := hb1 b1 hB1; have hn1' := hn1 n1 hN1
  rw [hK0] at hk0; rw [hK1] at hk1; push_cast at hk0 hk1
  have hκ1 : κ = 1 := le_antisymm hk1 hk0
  subst hκ1
  have c1 : ((5 : ℚ) : ℝ) ≤ ((11 * B.a0 : ℚ) : ℝ) := by exact_mod_cast q1
  have c2 : ((19 * B.a1 : ℚ) : ℝ) ≤ ((5 * (1 + B.b0) : ℚ) : ℝ) := by exact_mod_cast q2
  have c3 : ((5 * (1 + b1) : ℚ) : ℝ) ≤ ((23 * B.a0 : ℚ) : ℝ) := by exact_mod_cast q3
  have c4 : ((5 * (1 + b1) * n1 : ℚ) : ℝ) ≤ ((29 * B.a0 : ℚ) : ℝ) := by exact_mod_cast q4
  push_cast at c1 c2 c3 c4
  have p5 : (5 : ℝ) * (1 + β) * ν ≤ 5 * (1 + b1) * n1 :=
    by have := mul_le_mul (show 1 + β ≤ 1 + (b1 : ℝ) by linarith) hn1' (by linarith) (by linarith); nlinarith
  have s1 : 2 * α ≤ 1 := by linarith
  have s2 : 5 ≤ 11 * α := by linarith
  have s3 : 19 * α ≤ 5 * (1 + β) := by linarith
  have s4 : 5 * (1 + β) ≤ 23 * α := by linarith
  have s5 : 1 + β ≤ (1 + β) * ν := by nlinarith
  have s6 : 5 * (1 + β) * ν ≤ 29 * α := by linarith
  have mv := fun {x y : ℝ} (h : x ≤ y) => mul_le_mul_of_nonneg_right h hV.le
  obtain ⟨t, a1, a2, a3, a4, a5⟩ := tight_12345' (v1 := α * V) (v2 := V) (v3 := (1 + α * 1) * V) (v4 := (1 + β) * V)
    (v5 := (1 + β) * ν * V) (by positivity) (by ring) (by nlinarith [mv s1]) (by nlinarith [mv s2])
    (by nlinarith [mv s3]) (by nlinarith [mv s4]) (mv s5) (by nlinarith [mv s6])
  refine ⟨t, fun i => ?_⟩
  fin_cases i
  · simpa [cs] using a1
  · simpa [cs] using a2
  · simpa [cs] using a3
  · simpa [cs] using a4
  · simpa [cs] using a5

theorem leaf_sound {B : Bx} {k : ℕ} {m : Fin 5 → ℕ} (hok : leafOK B k m = true) {α κ β ν V : ℝ} (hV : 0 < V)
    (hb : InBox B α κ β ν) (hd : Dom α κ β ν) : LonelyF (fun i => cs α κ β ν i * V) := by
  unfold leafOK at hok
  split_ifs at hok with h6 h7
  · exact tp1_sound hok hV hb hd
  · exact tp2_sound hok hV hb hd
  · exact leaf0_sound hok hV hb hd

theorem check_sound (T : T5) : ∀ (B : Bx), check T B = true → ∀ {α κ β ν V : ℝ}, 0 < V → InBox B α κ β ν →
    Dom α κ β ν → LonelyF (fun i => cs α κ β ν i * V) := by
  induction T with
  | L k m0 m1 m2 m3 m4 => intro B h α κ β ν V hV hb hd; exact leaf_sound h hV hb hd
  | E => intro B h α κ β ν V hV hb hd; exact (emptyB_sound h hb hd).elim
  | S d l r ihl ihr =>
    intro B h α κ β ν V hV hb hd
    simp only [check, Bool.and_eq_true] at h
    rcases splitB_sound B d hb with h1 | h1
    · exact ihl _ h.1 hV h1 hd
    · exact ihr _ h.2 hV h1 hd

/-- **§5, `k = 1`, `1/50 ≤ α = v₁/v₂ ≤ 1/25`**, from a certificate tree `T` that checks on the root box. -/
theorem s5k1_large_of {T : T5} (hT : check T root = true) {v1 v2 v3 v4 v5 D : ℕ} (h0 : 0 < v1) (h12 : v1 < v2)
    (hv3 : v3 = v2 + D) (hD0 : 0 < D) (hDv : D = v1) (h34 : v3 < v4) (h45 : v4 < v5) (hsmall : 3 * v1 < v3)
    (hα1 : 25 * v1 ≤ v2) (hα2 : v2 ≤ 50 * v1) :
    ∃ t : ℝ, (6 : ℝ)⁻¹ ≤ circDist (v1 * t) ∧ (6 : ℝ)⁻¹ ≤ circDist (v2 * t) ∧ (6 : ℝ)⁻¹ ≤ circDist (v3 * t) ∧
      (6 : ℝ)⁻¹ ≤ circDist (v4 * t) ∧ (6 : ℝ)⁻¹ ≤ circDist (v5 * t) := by
  have h1R : (0 : ℝ) < v1 := by exact_mod_cast h0
  have h2R : (0 : ℝ) < v2 := by exact_mod_cast (show 0 < v2 by omega)
  have hDR : (0 : ℝ) < D := by exact_mod_cast hD0
  have hv3R : (v3 : ℝ) = v2 + D := by rw [hv3]; push_cast; ring
  have h34R : (v3 : ℝ) < v4 := by exact_mod_cast h34
  have h45R : (v4 : ℝ) < v5 := by exact_mod_cast h45
  have h4R : (0 : ℝ) < v4 := by linarith
  have hDvR : (D : ℝ) = v1 := by exact_mod_cast hDv
  have hsR : 3 * (v1 : ℝ) < v3 := by exact_mod_cast hsmall
  have hαR1 : 25 * (v1 : ℝ) ≤ v2 := by exact_mod_cast hα1
  have hαR2 : (v2 : ℝ) ≤ 50 * v1 := by exact_mod_cast hα2
  set α : ℝ := (v1 : ℝ) / v2 with hαd
  set κ : ℝ := (D : ℝ) / v1 with hκd
  set β : ℝ := ((v4 : ℝ) - v2) / v2 with hβd
  set ν : ℝ := (v5 : ℝ) / v4 with hνd
  have hακ : α * κ = (D : ℝ) / v2 := by rw [hαd, hκd]; field_simp
  have hb : InBox root α κ β ν := by
    refine ⟨?_, ?_, ?_, ?_, ?_, fun b hb => by simp [root] at hb, ?_, fun n hn => by simp [root] at hn⟩
    · simp only [root]; push_cast; rw [hαd, le_div_iff₀ h2R]; linarith
    · simp only [root]; push_cast; rw [hαd, div_le_iff₀ h2R]; linarith
    · simp only [root]; push_cast; rw [hκd, le_div_iff₀ h1R]; linarith
    · simp only [root]; push_cast; rw [hκd, div_le_iff₀ h1R]; linarith
    · simp only [root]; push_cast; rw [hβd]; apply div_nonneg _ h2R.le; linarith
    · simp only [root]; push_cast; rw [hνd, le_div_iff₀ h4R]; linarith
  have hd : Dom α κ β ν := by
    refine ⟨by positivity, by positivity, by rw [hκd, div_le_iff₀ h1R]; linarith, ?_, ?_, ?_, ?_⟩
    · rw [hβd]; apply div_nonneg _ h2R.le; linarith
    · rw [hνd, le_div_iff₀ h4R]; linarith
    · have e : α * (3 - κ) = (3 * (v1 : ℝ) - D) / v2 := by rw [hαd, hκd]; field_simp
      rw [e, div_lt_one h2R]; linarith
    · rw [hακ, hβd]; apply div_lt_div_of_pos_right _ h2R; linarith
  obtain ⟨t, ht⟩ := check_sound T root hT h2R hb hd
  have c0 : cs α κ β ν 0 * (v2 : ℝ) = v1 := by show α * (v2 : ℝ) = v1; rw [hαd]; field_simp
  have c1 : cs α κ β ν 1 * (v2 : ℝ) = v2 := by show 1 * (v2 : ℝ) = v2; ring
  have c2 : cs α κ β ν 2 * (v2 : ℝ) = v3 := by show (1 + α * κ) * (v2 : ℝ) = v3; rw [hακ, hv3R]; field_simp
  have c3 : cs α κ β ν 3 * (v2 : ℝ) = v4 := by show (1 + β) * (v2 : ℝ) = v4; rw [hβd]; field_simp; ring
  have c4 : cs α κ β ν 4 * (v2 : ℝ) = v5 := by
    show (1 + β) * ν * (v2 : ℝ) = v5; rw [hβd, hνd]; field_simp; ring
  refine ⟨t, ?_, ?_, ?_, ?_, ?_⟩
  · have := ht 0; simp only at this; rwa [c0] at this
  · have := ht 1; simp only at this; rwa [c1] at this
  · have := ht 2; simp only at this; rwa [c2] at this
  · have := ht 3; simp only at this; rwa [c3] at this
  · have := ht 4; simp only at this; rwa [c4] at this


/-- **§5, `k = 1`, `25 v₁ ≤ v₂ ≤ 50 v₁`.** -/
theorem s5k1_mid {v1 v2 v3 v4 v5 : ℕ} (h0 : 0 < v1) (h12 : v1 < v2) (hv3 : v3 = v2 + v1) (h34 : v3 < v4)
    (h45 : v4 < v5) (hsmall : 3 * v1 < v3) (hα1 : 25 * v1 ≤ v2) (hα2 : v2 ≤ 50 * v1) :
    ∃ t : ℝ, (6 : ℝ)⁻¹ ≤ circDist (v1 * t) ∧ (6 : ℝ)⁻¹ ≤ circDist (v2 * t) ∧ (6 : ℝ)⁻¹ ≤ circDist (v3 * t) ∧
      (6 : ℝ)⁻¹ ≤ circDist (v4 * t) ∧ (6 : ℝ)⁻¹ ≤ circDist (v5 * t) :=
  s5k1_large_of tree_ok h0 h12 hv3 h0 rfl h34 h45 hsmall hα1 hα2

end LRC.S5K1Mid


