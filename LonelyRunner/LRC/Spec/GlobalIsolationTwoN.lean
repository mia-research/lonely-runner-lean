import Mathlib.NumberTheory.DiophantineApproximation.Basic
import Mathlib.Data.ZMod.QuotientGroup
import Mathlib.Tactic.LinearCombination

/-!
# Global isolation in two dimensions: the orbit of meeting times meets every box

2026-09-24.  R6, global isolation, is a statement about one orbit on the circle: at `t = k/n`
the readings `{d·k/n}` of the runners stand on the grid `(1/n)ℤ`, so every `d` with `n ∤ d` is at
least `1/n` from the integers, and there are `φ(n)` such moments per period.  In one dimension
the orbit `k ↦ {c·k/n}` of a unit `c` is the whole grid, so it meets **every** window of length
`1/n`.

This file is the same mechanism one dimension up.  At order six, BHK §7 watches two runners
at once, at the meeting times of a third pair, and reads the orbit

    k ↦ ({c₃·k/n}, {c₁·k/n})      (k = 0, 1, …, n − 1),

the cyclic group generated by `(c₃, c₁)` in `(ZMod n)²`.  It has exactly `n` points when
`gcd(n, c₃, c₁) = 1`.  The two-dimensional global isolation says that these `n` points meet
every `α × β` box with `αβ ≥ 1/n`, **unless** the orbit has a short step: a nonzero whole-number
pair `(i, j) ≡ (c₃·k, c₁·k) (mod n)` with `β|i| + α|j| − 2|i||j|/n < 1`.  That is the exact
content of the BHK Main Lemma, Corollary 6 and Lemma 7, re-proved here in whole numbers and
residues.

* **The orbit is a lattice with a column basis** (`column_basis`, `row_basis`): an order-`n`
  group of meeting points has generators `(e, c)` and `(0, f)` with `e·f = n`, and every lift
  `(u, v)` of a point is `k·(e, c) + l·(0, f)` (`int_pair_basis`).
* **The short step exists, discretely** (`short_step_witness`): Dirichlet's pigeonhole on the
  column slope `c/f` gives a nonzero lift with `|i| < 1/β` and `|j| ≤ βn`; descent on
  `(|i| + 1)(|j| + 1)` makes it minimal (`minimal_select`).  No area, no Minkowski.
* **A minimal step that is not short does not let the orbit miss a box**
  (`short_step_bound`, BHK (12)): on an axis the orbit is a grid of spacing `1/f` by `f/n`
  (`axis_vertical`, `axis_horizontal`); off the axes a Bézout companion of determinant `n` makes
  the orbit a family of parallel rows, and two interval catches land a point in the box
  (`core_meets`).
* **Assembly**: `isolation_or_short_step` (the Main Lemma, with Corollary 6's cone
  `α|j| < 1 + β·i`, read as BHK's region by `cone_of_bound`, and the minimal pair of §3.3), and
  `order_bound_of_minimal` (Lemma 7: `n ≥ (|i| + 1)(|j| + 1) − 2`).
* **On the multiples directly** (§7): `orbit_isolation_two` states it all on
  `k ↦ ((c₃·k) % n, (c₁·k) % n)`; `orbit_isolation_two_bhk` is BHK's constants, box `2/3 × 2/9`,
  `n ≥ 7`, the box `R = [1/6, 5/6] × [7/18, 11/18]` read in whole numbers, exceptional steps
  `0 ≤ i ≤ 4`, `|6j| < 9 + 2i`.

The two readings of "the orbit meets the box", on the group and on the multiples `k < n`, are
equivalent in both directions (`mem_meetingOrbit_iff`, `meetsBox_iff_orbitMeets`), and the
exceptional case is a named whole-number pair on the orbit.  The dichotomy needs only `αβn ≥ 1`:
the classical side condition `n ≥ 1/β` (BHK's Case C) is implied, since `α < 1`.

Everything here is proved; no `sorry`, no `native_decide`, no measure theory.
-/

set_option linter.unusedSectionVars false
set_option linter.style.longLine false

namespace LRC.OrderSixN

/-! ## 0. the box, and the orbit meeting it -/

/-- **An order-`n` group of meeting points meets the box** of width `α` and height `β` anchored at
`(x₁, x₂)`: some lift `(u, v)` of a point has `{u/n − x₁} ≤ α` and `{v/n − x₂} ≤ β`. -/
def MeetsBox {n : ℕ} (H : AddSubgroup (ZMod n × ZMod n)) (α β x₁ x₂ : ℝ) : Prop :=
  ∃ u v : ℤ, ((u : ZMod n), (v : ZMod n)) ∈ H ∧
    Int.fract ((u : ℝ) / n - x₁) ≤ α ∧ Int.fract ((v : ℝ) / n - x₂) ≤ β

/-! ## 1. the column basis of an order-`n` group -/

/-- **A subgroup of `ZMod n` is the multiples of `n / |X|`.** -/
theorem zmod_eq_zmultiples_div_card (n : ℕ) (hn : 0 < n) (X : AddSubgroup (ZMod n)) :
    X = AddSubgroup.zmultiples ((n / Nat.card X : ℕ) : ZMod n) := by
  haveI : NeZero n := ⟨hn.ne'⟩
  set m : ℕ := Nat.card X with hm_def
  have hm_pos : 0 < m := Nat.card_pos
  have hm_dvd : m ∣ n := by
    have h := AddSubgroup.card_addSubgroup_dvd_card X
    rwa [Nat.card_zmod] at h
  set d : ℕ := n / m with hd_def
  have hdm : d * m = n := Nat.div_mul_cancel hm_dvd
  have hd_pos : 0 < d := Nat.div_pos (Nat.le_of_dvd hn hm_dvd) hm_pos
  have hd_dvd : d ∣ n := ⟨m, hdm.symm⟩
  have h_torsion : ∀ x ∈ X, ((m : ℕ) : ZMod n) * x = 0 := by
    intro x hx
    have h1 : m • (⟨x, hx⟩ : X) = 0 := by
      rw [hm_def]; exact card_nsmul_eq_zero'
    have h2 := congrArg (X.subtype) h1
    rw [map_nsmul, map_zero] at h2
    simp only [AddSubgroup.subtype_apply] at h2
    rwa [nsmul_eq_mul] at h2
  have h_le : X ≤ AddSubgroup.zmultiples ((d : ℕ) : ZMod n) := by
    intro x hx
    have h_zero : ((m * x.val : ℕ) : ZMod n) = 0 := by
      push_cast
      rw [ZMod.natCast_zmod_val]
      exact h_torsion x hx
    have h_n_dvd : n ∣ m * x.val := by
      have h3 : ((m * x.val : ℕ) : ZMod n) = ((0 : ℕ) : ZMod n) := by
        rw [h_zero]; norm_num
      exact (Nat.modEq_zero_iff_dvd).mp ((ZMod.natCast_eq_natCast_iff _ _ _).mp h3)
    have h_d_dvd : d ∣ x.val := by
      obtain ⟨t, ht⟩ := h_n_dvd
      refine ⟨t, ?_⟩
      have hmx : m * x.val = m * (d * t) := by
        rw [ht, ← hdm]; ring
      exact Nat.eq_of_mul_eq_mul_left hm_pos hmx
    obtain ⟨t, ht⟩ := h_d_dvd
    rw [AddSubgroup.mem_zmultiples_iff]
    refine ⟨(t : ℤ), ?_⟩
    have hx_eq : ((x.val : ℕ) : ZMod n) = x := ZMod.natCast_zmod_val x
    rw [← hx_eq, ht, zsmul_eq_mul]
    push_cast
    ring
  have h_card_z : Nat.card (AddSubgroup.zmultiples ((d : ℕ) : ZMod n)) = m := by
    rw [Nat.card_zmultiples, ZMod.addOrderOf_coe d hn.ne', Nat.gcd_eq_right hd_dvd,
        ← hdm, Nat.mul_div_cancel_left m hd_pos]
  exact AddSubgroup.eq_of_le_of_card_ge h_le (by rw [h_card_z, hm_def])

theorem mem_zmultiples_div_card (n : ℕ) (hn : 0 < n) (X : AddSubgroup (ZMod n)) :
    ((n / Nat.card X : ℕ) : ZMod n) ∈ X :=
  (zmod_eq_zmultiples_div_card n hn X).ge (AddSubgroup.mem_zmultiples _)

/-- **The column basis.**  An order-`n` group `H ≤ (ZMod n)²` has `e·f = n` with `(e, c) ∈ H`,
`(0, f) ∈ H`, `f` generating the column `{y : (0, y) ∈ H}` and `e` the first-coordinate image. -/
theorem column_basis (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n) :
    ∃ e f c : ℕ, 0 < e ∧ 0 < f ∧ e * f = n ∧
      (((e : ℕ) : ZMod n), ((c : ℕ) : ZMod n)) ∈ H ∧
      ((0 : ZMod n), ((f : ℕ) : ZMod n)) ∈ H ∧
      (∀ y : ZMod n, ((0 : ZMod n), y) ∈ H →
        y ∈ AddSubgroup.zmultiples (((f : ℕ) : ℕ) : ZMod n)) ∧
      (∀ p : ZMod n × ZMod n, p ∈ H →
        p.1 ∈ AddSubgroup.zmultiples (((e : ℕ) : ℕ) : ZMod n)) := by
  haveI : NeZero n := ⟨by omega⟩
  haveI : Finite H := Nat.finite_of_card_ne_zero (by rw [hH_card]; omega)
  set π : H →+ ZMod n := (AddMonoidHom.fst (ZMod n) (ZMod n)).comp H.subtype
    with hπ_def
  have h_iso : Nat.card (H ⧸ π.ker) = Nat.card π.range :=
    Nat.card_congr (QuotientAddGroup.quotientKerEquivRange π).toEquiv
  have h_lagrange := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup π.ker
  have h_prod : Nat.card π.range * Nat.card π.ker = n := by
    rw [← h_iso, ← h_lagrange, hH_card]
  set Y : AddSubgroup (ZMod n) :=
    { carrier := {y : ZMod n | ((0 : ZMod n), y) ∈ H}
      zero_mem' := H.zero_mem
      add_mem' := by
        intro a b ha hb
        have h := H.add_mem ha hb
        simpa using h
      neg_mem' := by
        intro a ha
        have h := H.neg_mem ha
        simpa using h } with hY_def
  have hY_mem_iff : ∀ y : ZMod n, y ∈ Y ↔ ((0 : ZMod n), y) ∈ H := by
    intro y; rfl
  have h_card_Y : Nat.card Y = Nat.card π.ker := by
    refine Nat.card_congr (Equiv.symm ?_)
    refine Equiv.ofBijective
      (fun k => (⟨(k.val.val).2, ?_⟩ : Y)) ⟨?_, ?_⟩
    · have hk_mem : k.val.val ∈ H := k.val.prop
      have hk_fst : (k.val.val).1 = 0 := by
        have hk := k.prop
        rw [AddMonoidHom.mem_ker] at hk
        exact hk
      have h_pair : k.val.val = ((0 : ZMod n), (k.val.val).2) :=
        Prod.ext hk_fst rfl
      rw [hY_mem_iff, ← h_pair]
      exact hk_mem
    · intro k₁ k₂ h_eq
      have h_snd : (k₁.val.val).2 = (k₂.val.val).2 := congrArg Subtype.val h_eq
      have h_fst : (k₁.val.val).1 = (k₂.val.val).1 := by
        have h1 := k₁.prop
        have h2 := k₂.prop
        rw [AddMonoidHom.mem_ker] at h1 h2
        rw [show ((k₁.val.val).1 : ZMod n) = π k₁.val from rfl, h1,
            show ((k₂.val.val).1 : ZMod n) = π k₂.val from rfl, h2]
      exact Subtype.ext (Subtype.ext (Prod.ext h_fst h_snd))
    · intro y
      have hy_mem : ((0 : ZMod n), y.val) ∈ H := (hY_mem_iff y.val).mp y.prop
      have h_in_ker : (⟨((0 : ZMod n), y.val), hy_mem⟩ : H) ∈ π.ker := by
        rw [AddMonoidHom.mem_ker]
        rfl
      exact ⟨⟨⟨((0 : ZMod n), y.val), hy_mem⟩, h_in_ker⟩, Subtype.ext rfl⟩
  have h_e_mem := mem_zmultiples_div_card n (by omega) π.range
  have h_f_mem := mem_zmultiples_div_card n (by omega) Y
  have h_Y_eq := zmod_eq_zmultiples_div_card n (by omega) Y
  have h_X_eq := zmod_eq_zmultiples_div_card n (by omega) π.range
  set mX : ℕ := Nat.card π.range with hmX_def
  set mY : ℕ := Nat.card Y with hmY_def
  have hmX_pos : 0 < mX := Nat.card_pos
  have hmY_pos : 0 < mY := Nat.card_pos
  have h_prod' : mX * mY = n := by rw [h_card_Y]; exact h_prod
  have he_eq : n / mX = mY := by
    rw [← h_prod', Nat.mul_div_cancel_left mY hmX_pos]
  have hf_eq : n / mY = mX := by
    have h2 : mY * mX = n := by rw [mul_comm]; exact h_prod'
    rw [← h2, Nat.mul_div_cancel_left mX hmY_pos]
  obtain ⟨h₁, hπh₁⟩ := AddMonoidHom.mem_range.mp h_e_mem
  refine ⟨n / mX, n / mY, ((h₁.val).2).val, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [he_eq]; exact hmY_pos
  · rw [hf_eq]; exact hmX_pos
  · rw [he_eq, hf_eq, mul_comm]; exact h_prod'
  · have h_fst : (h₁.val).1 = ((n / mX : ℕ) : ZMod n) := by
      rw [← hπh₁]; rfl
    have h_snd : ((((h₁.val).2).val : ℕ) : ZMod n) = (h₁.val).2 :=
      ZMod.natCast_zmod_val _
    have h_pair : (((n / mX : ℕ) : ZMod n), ((((h₁.val).2).val : ℕ) : ZMod n)) =
        h₁.val := by
      refine Prod.ext ?_ ?_
      · exact h_fst.symm
      · exact h_snd
    rw [h_pair]
    exact h₁.prop
  · exact (hY_mem_iff _).mp h_f_mem
  · intro y hy
    have hy_Y : y ∈ Y := (hY_mem_iff y).mpr hy
    rw [h_Y_eq] at hy_Y
    exact hy_Y
  · intro p hp
    have hp1 : p.1 ∈ π.range := AddMonoidHom.mem_range.mpr ⟨⟨p, hp⟩, rfl⟩
    rw [h_X_eq] at hp1
    exact hp1

/-- **The row basis**: the coordinate swap of `column_basis`. -/
theorem row_basis (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n) :
    ∃ e f c : ℕ, 0 < e ∧ 0 < f ∧ e * f = n ∧
      (((c : ℕ) : ZMod n), ((e : ℕ) : ZMod n)) ∈ H ∧
      (((f : ℕ) : ZMod n), (0 : ZMod n)) ∈ H ∧
      (∀ x : ZMod n, (x, (0 : ZMod n)) ∈ H →
        x ∈ AddSubgroup.zmultiples (((f : ℕ) : ℕ) : ZMod n)) := by
  set σ : (ZMod n × ZMod n) ≃+ (ZMod n × ZMod n) :=
    AddEquiv.prodComm with hσ_def
  set H' : AddSubgroup (ZMod n × ZMod n) := H.map σ.toAddMonoidHom with hH'_def
  have hH'_mem : ∀ p : ZMod n × ZMod n, p ∈ H' ↔ (p.2, p.1) ∈ H := by
    intro p
    constructor
    · rintro ⟨q, hq, rfl⟩
      simpa [hσ_def] using hq
    · intro hp
      exact ⟨(p.2, p.1), hp, rfl⟩
  have hH'_card : Nat.card H' = n := by
    rw [hH'_def,
        ← Nat.card_congr (AddSubgroup.equivMapOfInjective H σ.toAddMonoidHom
          (AddEquiv.injective σ)).toEquiv]
    exact hH_card
  obtain ⟨e, f, c, he, hf, hef, h_ec, h_0f, h_gen, -⟩ :=
    column_basis n hn H' hH'_card
  refine ⟨e, f, c, he, hf, hef, ?_, ?_, ?_⟩
  · exact (hH'_mem _).mp h_ec
  · exact (hH'_mem _).mp h_0f
  · intro x hx
    exact h_gen x ((hH'_mem _).mpr (by simpa using hx))

/-! ## 2. catching: a spaced progression meets every long enough window -/

/-- **A closed interval of length `L ≥ s` catches the progression `y₀ + ℤ·s`.** -/
theorem interval_catch (y₀ s a L : ℝ) (hs : 0 < s) (hsL : s ≤ L) :
    ∃ k : ℤ, a ≤ y₀ + (k : ℝ) * s ∧ y₀ + (k : ℝ) * s ≤ a + L := by
  refine ⟨⌈(a - y₀) / s⌉, ?_, ?_⟩
  · have h1 := mul_le_mul_of_nonneg_right (Int.le_ceil ((a - y₀) / s)) hs.le
    rw [div_mul_cancel₀ _ hs.ne'] at h1
    linarith
  · have h1 := mul_lt_mul_of_pos_right (Int.ceil_lt_add_one ((a - y₀) / s)) hs
    rw [add_mul, div_mul_cancel₀ _ hs.ne', one_mul] at h1
    linarith

/-- **A circular window of length `L ≥ s` catches the progression `y₀ + ℤ·s`**: the
one-dimensional global isolation, with spacing `s`. -/
theorem window_catch (y₀ s x L : ℝ) (hs : 0 < s) (hsL : s ≤ L) (hL : L < 1) :
    ∃ k : ℤ, Int.fract (y₀ + (k : ℝ) * s - x) ≤ L := by
  refine ⟨⌈(x - y₀) / s⌉, ?_⟩
  have h_ceil_ge : (x - y₀) / s ≤ (⌈(x - y₀) / s⌉ : ℝ) := Int.le_ceil _
  have h_ceil_lt : (⌈(x - y₀) / s⌉ : ℝ) < (x - y₀) / s + 1 := Int.ceil_lt_add_one _
  have h_lo : 0 ≤ y₀ + (⌈(x - y₀) / s⌉ : ℝ) * s - x := by
    have h1 := mul_le_mul_of_nonneg_right h_ceil_ge hs.le
    rw [div_mul_cancel₀ _ hs.ne'] at h1
    linarith
  have h_hi : y₀ + (⌈(x - y₀) / s⌉ : ℝ) * s - x < s := by
    have h1 := mul_lt_mul_of_pos_right h_ceil_lt hs
    rw [add_mul, div_mul_cancel₀ _ hs.ne', one_mul] at h1
    linarith
  rw [Int.fract_eq_self.mpr ⟨h_lo, by linarith⟩]
  linarith

/-- **Reflection of a window**: a hit for `w` at `−x − γ` is a hit for `−w` at `x`. -/
theorem fract_reflect (w x γ : ℝ) (_hγ : 0 ≤ γ) (hγ' : γ < 1)
    (h : Int.fract (w - (-x - γ)) ≤ γ) : Int.fract (-w - x) ≤ γ := by
  have hs0 : 0 ≤ Int.fract (w + x + γ) := Int.fract_nonneg _
  have hsγ : Int.fract (w + x + γ) ≤ γ := by
    have harg : w - (-x - γ) = w + x + γ := by ring
    rwa [harg] at h
  have hfr : Int.fract (w + x + γ) = (w + x + γ) - (⌊w + x + γ⌋ : ℤ) := rfl
  have hkey : -w - x =
      (γ - Int.fract (w + x + γ)) - ((⌊w + x + γ⌋ : ℤ) : ℝ) := by
    rw [hfr]
    ring
  rw [hkey, Int.fract_sub_intCast,
    Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩]
  linarith

/-! ## 3. whole-number lifts of the orbit -/

/-- **Whole-number combinations of two lifts are lifts.** -/
theorem int_comb_mem (n : ℕ) (H : AddSubgroup (ZMod n × ZMod n))
    (p₁ p₂ q₁ q₂ : ℤ)
    (hp : ((p₁ : ZMod n), (p₂ : ZMod n)) ∈ H)
    (hq : ((q₁ : ZMod n), (q₂ : ZMod n)) ∈ H) (A B : ℤ) :
    (((A * p₁ + B * q₁ : ℤ) : ZMod n), ((A * p₂ + B * q₂ : ℤ) : ZMod n)) ∈ H := by
  have h_pair :
      (((A * p₁ + B * q₁ : ℤ) : ZMod n), ((A * p₂ + B * q₂ : ℤ) : ZMod n)) =
        A • ((p₁ : ZMod n), (p₂ : ZMod n)) + B • ((q₁ : ZMod n), (q₂ : ZMod n)) := by
    refine Prod.ext ?_ ?_
    · change ((A * p₁ + B * q₁ : ℤ) : ZMod n) = A • (p₁ : ZMod n) + B • (q₁ : ZMod n)
      rw [zsmul_eq_mul, zsmul_eq_mul]
      push_cast
      ring
    · change ((A * p₂ + B * q₂ : ℤ) : ZMod n) = A • (p₂ : ZMod n) + B • (q₂ : ZMod n)
      rw [zsmul_eq_mul, zsmul_eq_mul]
      push_cast
      ring
  rw [h_pair]
  exact H.add_mem (H.zsmul_mem hp A) (H.zsmul_mem hq B)

/-- **A residue among the multiples of `g ∣ n` has every lift divisible by `g`.** -/
theorem int_dvd_of_mem_zmultiples (n : ℕ) (_hn : 0 < n) (g : ℕ)
    (hg_dvd : (g : ℤ) ∣ (n : ℤ)) (x : ℤ)
    (hx : (x : ZMod n) ∈ AddSubgroup.zmultiples ((g : ℕ) : ZMod n)) :
    (g : ℤ) ∣ x := by
  rw [AddSubgroup.mem_zmultiples_iff] at hx
  obtain ⟨m, hm⟩ := hx
  have h_zero : ((x - m * (g : ℕ) : ℤ) : ZMod n) = 0 := by
    push_cast
    rw [show ((x : ZMod n) : ZMod n) = m • ((g : ℕ) : ZMod n) from hm.symm,
        zsmul_eq_mul]
    ring
  have h_n_dvd : (n : ℤ) ∣ (x - m * (g : ℕ)) :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp h_zero
  obtain ⟨t, ht⟩ := h_n_dvd
  obtain ⟨w, hw⟩ := hg_dvd
  refine ⟨m + w * t, ?_⟩
  have h_x_eq : x = m * (g : ℕ) + (n : ℤ) * t := by linarith [ht]
  rw [h_x_eq, hw]
  ring

/-- **Every lift is a whole-number combination of the column basis**:
`(u, v) = k·(e, c) + l·(0, f)`. -/
theorem int_pair_basis (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n))
    (e f c : ℕ) (_he_pos : 0 < e) (_hf_pos : 0 < f) (hef : e * f = n)
    (h_ec_mem : (((e : ℕ) : ZMod n), ((c : ℕ) : ZMod n)) ∈ H)
    (h_kergen : ∀ y : ZMod n, ((0 : ZMod n), y) ∈ H →
        y ∈ AddSubgroup.zmultiples (((f : ℕ) : ℕ) : ZMod n))
    (h_imggen : ∀ p : ZMod n × ZMod n, p ∈ H →
        p.1 ∈ AddSubgroup.zmultiples (((e : ℕ) : ℕ) : ZMod n))
    (u v : ℤ) (h_uv : ((u : ZMod n), (v : ZMod n)) ∈ H) :
    ∃ k l : ℤ, u = k * e ∧ v = k * c + l * f := by
  haveI : NeZero n := ⟨by omega⟩
  have he_dvd_n : ((e : ℕ) : ℤ) ∣ (n : ℤ) := ⟨(f : ℤ), by exact_mod_cast hef.symm⟩
  have hf_dvd_n : ((f : ℕ) : ℤ) ∣ (n : ℤ) := ⟨(e : ℤ), by
    have : (f : ℤ) * e = (n : ℤ) := by
      have := hef
      push_cast [← this]
      ring
    exact this.symm⟩
  have h_e_dvd : ((e : ℕ) : ℤ) ∣ u :=
    int_dvd_of_mem_zmultiples n (by omega) e he_dvd_n u
      (h_imggen ((u : ZMod n), (v : ZMod n)) h_uv)
  obtain ⟨k, hk⟩ := h_e_dvd
  have h_col : ((0 : ZMod n), ((v - k * c : ℤ) : ZMod n)) ∈ H := by
    have h_comb := int_comb_mem n H u v (e : ℕ) (c : ℕ)
      h_uv (by push_cast; exact h_ec_mem) 1 (-k)
    have h_fst : ((1 * u + (-k) * (e : ℕ) : ℤ) : ZMod n) = (0 : ZMod n) := by
      rw [show (1 * u + (-k) * (e : ℕ) : ℤ) = u - k * e from by ring, hk]
      push_cast
      ring
    have h_snd : ((1 * v + (-k) * (c : ℕ) : ℤ) : ZMod n) =
        ((v - k * c : ℤ) : ZMod n) := by
      congr 1
      ring
    rwa [h_fst, h_snd] at h_comb
  have h_f_dvd : ((f : ℕ) : ℤ) ∣ (v - k * c) :=
    int_dvd_of_mem_zmultiples n (by omega) f hf_dvd_n (v - k * c)
      (h_kergen _ h_col)
  obtain ⟨l, hl⟩ := h_f_dvd
  exact ⟨k, l, by linarith [hk], by linarith [hl]⟩

/-! ## 4. a minimal step that is not short cannot let the orbit miss a box -/

/-- **On the vertical axis (`i = 0`).**  If `(0, j)` is a minimal lift with `|j| ≤ βn` and the
group misses a box, then `α·|j| < 1`.  Minimality makes `|j| = f`, the column generator; if
`α·f ≥ 1` the orbit is a grid of spacing `e/n = 1/f ≤ α` across and `f/n ≤ β` up, which meets
every box. -/
theorem axis_vertical (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n)
    (α β : ℝ) (hα' : α < 1) (hβ' : β < 1)
    (j : ℤ) (hj : j ≠ 0)
    (hj_box : |(j : ℝ)| ≤ β * n)
    (hj_H : (((0 : ℤ) : ZMod n), (j : ZMod n)) ∈ H)
    (hmin : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H → ((0 : ℤ), j) ≠ (k * i₀, k * j₀))
    (x₁ x₂ : ℝ) (hmiss : ¬ MeetsBox H α β x₁ x₂) :
    α * |(j : ℝ)| < 1 := by
  by_contra h_ge
  push Not at h_ge
  haveI : NeZero n := ⟨by omega⟩
  have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
  obtain ⟨e, f, c, he_pos, hf_pos, hef, h_ec_mem, h_0f_mem, h_gen, -⟩ :=
    column_basis n hn H hH_card
  have he_pos_R : (0 : ℝ) < e := by exact_mod_cast he_pos
  have hf_pos_R : (0 : ℝ) < f := by exact_mod_cast hf_pos
  have hef_R : (e : ℝ) * f = n := by exact_mod_cast hef
  have h_f_dvd : ((f : ℕ) : ℤ) ∣ j := by
    have h_zm : (j : ZMod n) ∈ AddSubgroup.zmultiples (((f : ℕ) : ℕ) : ZMod n) := by
      apply h_gen
      have h0 : ((0 : ℤ) : ZMod n) = (0 : ZMod n) := by push_cast; ring
      rwa [h0] at hj_H
    refine int_dvd_of_mem_zmultiples n (by omega) f ⟨(e : ℤ), ?_⟩ j h_zm
    have : ((e : ℕ) : ℤ) * ((f : ℕ) : ℤ) = (n : ℤ) := by exact_mod_cast hef
    linarith
  have h_abs_j : j.natAbs = f := by
    obtain ⟨q, hq⟩ := h_f_dvd
    have hq_ne : q ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at hq
      exact hj hq
    by_contra h_ne
    have h_natAbs_eq : j.natAbs = f * q.natAbs := by
      rw [hq, Int.natAbs_mul, Int.natAbs_natCast]
    have h_q_ge_2 : 2 ≤ q.natAbs := by
      have h1 : q.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hq_ne
      have h2 : q.natAbs ≠ 1 := by
        intro h1'
        rw [h1', mul_one] at h_natAbs_eq
        exact h_ne h_natAbs_eq
      omega
    rcases lt_or_gt_of_ne hq_ne with h_neg | h_pos
    · have h_0negf : (((0 : ℤ) : ZMod n), ((-(f : ℕ) : ℤ) : ZMod n)) ∈ H := by
        have h_negf : ((-(f : ℕ) : ℤ) : ZMod n) = -((f : ℕ) : ZMod n) := by
          push_cast; ring
        rw [h_negf]
        have h0 : ((0 : ℤ) : ZMod n) = (0 : ZMod n) := by push_cast; ring
        rw [h0]
        have := H.neg_mem h_0f_mem
        simpa using this
      have h_k_gt : (1 : ℤ) < -q := by omega
      apply hmin 0 (-(f : ℕ)) (-q) h_k_gt h_0negf
      refine Prod.ext ?_ ?_
      · simp
      · change j = -q * -(f : ℕ)
        rw [hq]; ring
    · have h_0f : (((0 : ℤ) : ZMod n), (((f : ℕ) : ℤ) : ZMod n)) ∈ H := by
        have h0 : ((0 : ℤ) : ZMod n) = (0 : ZMod n) := by push_cast; ring
        have hf_cast : (((f : ℕ) : ℤ) : ZMod n) = ((f : ℕ) : ZMod n) := by
          push_cast; ring
        rw [h0, hf_cast]
        exact h_0f_mem
      have h_k_gt : (1 : ℤ) < q := by omega
      apply hmin 0 (f : ℕ) q h_k_gt h_0f
      refine Prod.ext ?_ ?_
      · simp
      · change j = q * (f : ℕ)
        rw [hq]; ring
  have h_f_eq_absj : (f : ℝ) = |(j : ℝ)| := by
    rw [← h_abs_j]
    exact_mod_cast (Nat.cast_natAbs (α := ℝ) j)
  have h_en_le : (e : ℝ) / n ≤ α := by
    have h_en : (e : ℝ) / n = 1 / f := by
      rw [← hef_R]
      field_simp
    rw [h_en, div_le_iff₀ hf_pos_R]
    rw [h_f_eq_absj]
    linarith
  have h_fn_le : (f : ℝ) / n ≤ β := by
    rw [div_le_iff₀ hn_pos, h_f_eq_absj]
    exact hj_box
  obtain ⟨k, hk⟩ := window_catch 0 ((e : ℝ) / n) x₁ α (by positivity) h_en_le hα'
  obtain ⟨m, hm⟩ := window_catch ((k : ℝ) * c / n) ((f : ℝ) / n) x₂ β
    (by positivity) h_fn_le hβ'
  have hp_H := int_comb_mem n H ((e : ℕ) : ℤ) ((c : ℕ) : ℤ) 0 ((f : ℕ) : ℤ)
    (by push_cast; exact h_ec_mem) (by push_cast; exact h_0f_mem) k m
  apply hmiss
  refine ⟨k * (e : ℕ) + m * 0, k * (c : ℕ) + m * (f : ℕ), hp_H, ?_, ?_⟩
  · have h_x_eq : ((k * (e : ℕ) + m * 0 : ℤ) : ℝ) / n = 0 + (k : ℝ) * ((e : ℝ) / n) := by
      push_cast
      ring
    rw [h_x_eq]
    exact hk
  · have h_y_eq : ((k * (c : ℕ) + m * (f : ℕ) : ℤ) : ℝ) / n =
        (k : ℝ) * c / n + (m : ℝ) * ((f : ℝ) / n) := by
      push_cast
      ring
    rw [h_y_eq]
    exact hm

/-- **On the horizontal axis (`j = 0`)**: the mirror image, `β·|i| < 1`. -/
theorem axis_horizontal (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n)
    (α β : ℝ) (hα' : α < 1) (hβ' : β < 1)
    (i : ℤ) (hi : i ≠ 0)
    (hi_box : |(i : ℝ)| ≤ α * n)
    (hi_H : ((i : ZMod n), ((0 : ℤ) : ZMod n)) ∈ H)
    (hmin : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H → (i, (0 : ℤ)) ≠ (k * i₀, k * j₀))
    (x₁ x₂ : ℝ) (hmiss : ¬ MeetsBox H α β x₁ x₂) :
    β * |(i : ℝ)| < 1 := by
  by_contra h_ge
  push Not at h_ge
  haveI : NeZero n := ⟨by omega⟩
  have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
  obtain ⟨e, f, c, he_pos, hf_pos, hef, h_ce_mem, h_f0_mem, h_gen⟩ :=
    row_basis n hn H hH_card
  have he_pos_R : (0 : ℝ) < e := by exact_mod_cast he_pos
  have hf_pos_R : (0 : ℝ) < f := by exact_mod_cast hf_pos
  have hef_R : (e : ℝ) * f = n := by exact_mod_cast hef
  have h_f_dvd : ((f : ℕ) : ℤ) ∣ i := by
    have h_zm : (i : ZMod n) ∈ AddSubgroup.zmultiples (((f : ℕ) : ℕ) : ZMod n) := by
      apply h_gen
      have h0 : ((0 : ℤ) : ZMod n) = (0 : ZMod n) := by push_cast; ring
      rwa [h0] at hi_H
    refine int_dvd_of_mem_zmultiples n (by omega) f ⟨(e : ℤ), ?_⟩ i h_zm
    have : ((e : ℕ) : ℤ) * ((f : ℕ) : ℤ) = (n : ℤ) := by exact_mod_cast hef
    linarith
  have h_abs_i : i.natAbs = f := by
    obtain ⟨q, hq⟩ := h_f_dvd
    have hq_ne : q ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at hq
      exact hi hq
    by_contra h_ne
    have h_natAbs_eq : i.natAbs = f * q.natAbs := by
      rw [hq, Int.natAbs_mul, Int.natAbs_natCast]
    have h_q_ge_2 : 2 ≤ q.natAbs := by
      have h1 : q.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hq_ne
      have h2 : q.natAbs ≠ 1 := by
        intro h1'
        rw [h1', mul_one] at h_natAbs_eq
        exact h_ne h_natAbs_eq
      omega
    rcases lt_or_gt_of_ne hq_ne with h_neg | h_pos
    · have h_negf0 : (((-(f : ℕ) : ℤ) : ZMod n), ((0 : ℤ) : ZMod n)) ∈ H := by
        have h_negf : ((-(f : ℕ) : ℤ) : ZMod n) = -((f : ℕ) : ZMod n) := by
          push_cast; ring
        have h0 : ((0 : ℤ) : ZMod n) = (0 : ZMod n) := by push_cast; ring
        rw [h_negf, h0]
        have := H.neg_mem h_f0_mem
        simpa using this
      have h_k_gt : (1 : ℤ) < -q := by omega
      apply hmin (-(f : ℕ)) 0 (-q) h_k_gt h_negf0
      refine Prod.ext ?_ ?_
      · change i = -q * -(f : ℕ)
        rw [hq]; ring
      · simp
    · have h_f0 : ((((f : ℕ) : ℤ) : ZMod n), ((0 : ℤ) : ZMod n)) ∈ H := by
        have h0 : ((0 : ℤ) : ZMod n) = (0 : ZMod n) := by push_cast; ring
        have hf_cast : (((f : ℕ) : ℤ) : ZMod n) = ((f : ℕ) : ZMod n) := by
          push_cast; ring
        rw [h0, hf_cast]
        exact h_f0_mem
      have h_k_gt : (1 : ℤ) < q := by omega
      apply hmin (f : ℕ) 0 q h_k_gt h_f0
      refine Prod.ext ?_ ?_
      · change i = q * (f : ℕ)
        rw [hq]; ring
      · simp
  have h_f_eq_absi : (f : ℝ) = |(i : ℝ)| := by
    rw [← h_abs_i]
    exact_mod_cast (Nat.cast_natAbs (α := ℝ) i)
  have h_en_le : (e : ℝ) / n ≤ β := by
    have h_en : (e : ℝ) / n = 1 / f := by
      rw [← hef_R]
      field_simp
    rw [h_en, div_le_iff₀ hf_pos_R]
    rw [h_f_eq_absi]
    linarith
  have h_fn_le : (f : ℝ) / n ≤ α := by
    rw [div_le_iff₀ hn_pos, h_f_eq_absi]
    exact hi_box
  obtain ⟨m, hm⟩ := window_catch 0 ((e : ℝ) / n) x₂ β (by positivity) h_en_le hβ'
  obtain ⟨k, hk⟩ := window_catch ((m : ℝ) * c / n) ((f : ℝ) / n) x₁ α
    (by positivity) h_fn_le hα'
  have hp_H := int_comb_mem n H ((c : ℕ) : ℤ) ((e : ℕ) : ℤ) ((f : ℕ) : ℤ) 0
    (by push_cast; exact h_ce_mem) (by push_cast; exact h_f0_mem) m k
  apply hmiss
  refine ⟨m * (c : ℕ) + k * (f : ℕ), m * (e : ℕ) + k * 0, hp_H, ?_, ?_⟩
  · have h_x_eq : ((m * (c : ℕ) + k * (f : ℕ) : ℤ) : ℝ) / n =
        (m : ℝ) * c / n + (k : ℝ) * ((f : ℝ) / n) := by
      push_cast
      ring
    rw [h_x_eq]
    exact hk
  · have h_y_eq : ((m * (e : ℕ) + k * 0 : ℤ) : ℝ) / n = 0 + (m : ℝ) * ((e : ℝ) / n) := by
      push_cast
      ring
    rw [h_y_eq]
    exact hm

set_option maxHeartbeats 1000000 in
-- The sliding-window assembly carries many real-number `set`s and `linarith` calls in one proof.
/-- **Off the axes (`i, j > 0`): the orbit is a family of parallel rows.**  If `(i, j)` is a
minimal lift inside the `αn × βn` box and the step is **not** short (`n ≤ βn·i + αn·j − 2ij`,
the failure of BHK (12)), the group meets every box.  In the column basis
`(i, j) = d·(e, c) + t·(0, f)`, minimality is `gcd(d, t) = 1`; Bézout gives a companion lift
`B` with `i·B₂ − j·B₁ = n`, so the orbit is the rows `a ↦ a·(i, j) + b·B`.  Choosing the row `b`
is a sliding-window overlap whose feasibility is exactly the failed (12); two interval catches
finish. -/
theorem core_meets (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n)
    (α β : ℝ) (hα' : α < 1) (hβ' : β < 1)
    (i j : ℤ) (hi : 0 < i) (hj : 0 < j)
    (hi_box : (i : ℝ) ≤ α * n) (hj_box : (j : ℝ) ≤ β * n)
    (hij_H : ((i : ZMod n), (j : ZMod n)) ∈ H)
    (hij_min_H : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H → (i, j) ≠ (k * i₀, k * j₀))
    (h12 : (n : ℝ) ≤ β * n * i + α * n * j - 2 * i * j)
    (x₁ x₂ : ℝ) :
    MeetsBox H α β x₁ x₂ := by
  haveI : NeZero n := ⟨by omega⟩
  have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
  have hi_R : (0 : ℝ) < i := by exact_mod_cast hi
  have hj_R : (0 : ℝ) < j := by exact_mod_cast hj
  obtain ⟨e, f, c, he_pos, hf_pos, hef, h_ec_mem, h_0f_mem, h_kergen, h_imggen⟩ :=
    column_basis n hn H hH_card
  have hef_Z : ((e : ℕ) : ℤ) * ((f : ℕ) : ℤ) = (n : ℤ) := by exact_mod_cast hef
  -- ℤ-cast forms of the two generators' memberships.
  have h_ec_Z : ((((e : ℕ) : ℤ) : ZMod n), (((c : ℕ) : ℤ) : ZMod n)) ∈ H := by
    push_cast
    exact h_ec_mem
  have h_0f_Z : ((((0 : ℕ) : ℤ) : ZMod n), (((f : ℕ) : ℤ) : ZMod n)) ∈ H := by
    push_cast
    exact h_0f_mem
  -- Basis decomposition of the minimal point: (i, j) = d·(e, c) + t·(0, f).
  obtain ⟨d, t, hd_eq, ht_eq⟩ := int_pair_basis n hn H e f c he_pos hf_pos hef
    h_ec_mem h_kergen h_imggen i j hij_H
  have he_Z_pos : (0 : ℤ) < (e : ℕ) := by exact_mod_cast he_pos
  have hd_pos : 0 < d := by
    rcases lt_trichotomy d 0 with h | h | h
    · nlinarith [hd_eq]
    · rw [h, zero_mul] at hd_eq
      omega
    · exact h
  -- Minimality in basis coordinates is coprimality.
  have h_gcd : Int.gcd d t = 1 := by
    by_contra h_ne
    have hg_ne : Int.gcd d t ≠ 0 := by
      rw [Ne, Int.gcd_eq_zero_iff]
      rintro ⟨h0, -⟩
      omega
    have hg_ge_2 : 2 ≤ Int.gcd d t := by omega
    obtain ⟨d', hd'⟩ := Int.gcd_dvd_left (a := d) (b := t)
    obtain ⟨t', ht'⟩ := Int.gcd_dvd_right (a := d) (b := t)
    have h_cand := int_comb_mem n H ((e : ℕ) : ℤ) ((c : ℕ) : ℤ)
      ((0 : ℕ) : ℤ) ((f : ℕ) : ℤ) h_ec_Z h_0f_Z d' t'
    apply hij_min_H (d' * (e : ℕ)) (d' * (c : ℕ) + t' * (f : ℕ))
      (Int.gcd d t) (by exact_mod_cast hg_ge_2) (by
        have h_fst : (d' * ((e : ℕ) : ℤ) + t' * ((0 : ℕ) : ℤ) : ℤ) =
            d' * (e : ℕ) := by push_cast; ring
        rwa [h_fst] at h_cand)
    refine Prod.ext ?_ ?_
    · change i = (Int.gcd d t : ℤ) * (d' * (e : ℕ))
      linear_combination hd_eq + ((e : ℕ) : ℤ) * hd'
    · change j = (Int.gcd d t : ℤ) * (d' * (c : ℕ) + t' * (f : ℕ))
      linear_combination ht_eq + ((c : ℕ) : ℤ) * hd' + ((f : ℕ) : ℤ) * ht'
  -- Bézout: ν·d - μ·t = 1.
  obtain ⟨ν, μ', h_bez⟩ := (Int.isCoprime_iff_gcd_eq_one.mpr h_gcd)
  set μ : ℤ := -μ' with hμ_def
  have h_unim : d * ν - t * μ = 1 := by
    rw [hμ_def]
    linarith [h_bez]
  -- The Bézout companion point B with i·B₂ - j·B₁ = n.
  set B₁ : ℤ := μ * (e : ℕ) with hB₁_def
  set B₂ : ℤ := μ * (c : ℕ) + ν * (f : ℕ) with hB₂_def
  have hB_mem : ((B₁ : ZMod n), (B₂ : ZMod n)) ∈ H := by
    have h_comb := int_comb_mem n H ((e : ℕ) : ℤ) ((c : ℕ) : ℤ)
      ((0 : ℕ) : ℤ) ((f : ℕ) : ℤ) h_ec_Z h_0f_Z μ ν
    have h_fst : (μ * ((e : ℕ) : ℤ) + ν * ((0 : ℕ) : ℤ) : ℤ) = B₁ := by
      rw [hB₁_def]
      all_goals push_cast; ring
    have h_snd : (μ * ((c : ℕ) : ℤ) + ν * ((f : ℕ) : ℤ) : ℤ) = B₂ := by
      rw [hB₂_def]
    rwa [h_fst, h_snd] at h_comb
  have h_det : i * B₂ - j * B₁ = (n : ℤ) := by
    have h_expand : i * B₂ - j * B₁ =
        (((e : ℕ) : ℤ) * ((f : ℕ) : ℤ)) * (d * ν - t * μ) := by
      rw [hd_eq, ht_eq, hB₁_def, hB₂_def]
      ring
    rw [h_expand, h_unim, mul_one, hef_Z]
  -- ===== Sliding-window selection of the line index b =====
  -- Window 1: u ∈ [n·x₁, n·x₁ + αn].  Window 2 (line b): u such that
  -- the line height lands in the y-window — slides at step n/j.
  have h_sL : (n : ℝ) / j ≤ (α * n + (i : ℝ) * (β * n) / j - 2 * i) := by
    rw [div_le_iff₀ hj_R]
    have h_expand : (α * n + (i : ℝ) * (β * n) / j - 2 * i) * j =
        α * n * j + i * (β * n) - 2 * i * j := by
      field_simp
      try ring
    rw [h_expand]
    linarith [h12]
  obtain ⟨kb, hkb₁, hkb₂⟩ := interval_catch
    ((i : ℝ) * (n * x₂) / j - n * x₁) ((n : ℝ) / j)
    ((i : ℝ) - (i : ℝ) * (β * n) / j)
    (α * n + (i : ℝ) * (β * n) / j - 2 * i)
    (by positivity) h_sL
  set b : ℤ := -kb with hb_def
  set y : ℝ := (i : ℝ) * (n * x₂) / j - n * x₁ + (kb : ℝ) * ((n : ℝ) / j)
    with hy_def
  -- y-range: i - i·βn/j ≤ y ≤ αn - i.
  have hy_lo : (i : ℝ) - (i : ℝ) * (β * n) / j ≤ y := hkb₁
  have hy_hi : y ≤ α * n - (i : ℝ) := by
    linarith [hkb₂]
  -- The window-2 left endpoint P, and its product identity P·j = i·n·x₂ - b·n.
  set P : ℝ := y + n * x₁ with hP_def
  have hP_j : P * j = (i : ℝ) * (n * x₂) - (b : ℝ) * n := by
    rw [hP_def, hy_def, hb_def]
    push_cast
    field_simp
    ring
  -- ===== Catch u inside the overlap =====
  set cc : ℝ := n * x₁ + max 0 y with hcc_def
  obtain ⟨ka, hka₁, hka₂⟩ := interval_catch
    ((b : ℝ) * (B₁ : ℝ)) (i : ℝ) cc (i : ℝ) hi_R le_rfl
  set u : ℤ := b * B₁ + ka * i with hu_def
  have hu_cast : (u : ℝ) = (b : ℝ) * (B₁ : ℝ) + (ka : ℝ) * i := by
    rw [hu_def]
    push_cast
    ring
  -- u lies in window 1: n·x₁ ≤ u ≤ n·x₁ + αn.
  have hu_w1_lo : n * x₁ ≤ (u : ℝ) := by
    rw [hu_cast]
    have h_max : (0 : ℝ) ≤ max 0 y := le_max_left 0 y
    have : cc ≥ n * x₁ := by rw [hcc_def]; linarith
    linarith [hka₁]
  have hu_w1_hi : (u : ℝ) ≤ n * x₁ + α * n := by
    rw [hu_cast]
    rcases le_total 0 y with hy0 | hy0
    · have h_max : max 0 y = y := max_eq_right hy0
      have hcc_eq : cc = n * x₁ + y := by rw [hcc_def, h_max]
      have := hka₂
      rw [hcc_eq] at this
      linarith [hy_hi]
    · have h_max : max 0 y = 0 := max_eq_left hy0
      have hcc_eq : cc = n * x₁ := by rw [hcc_def, h_max]; ring
      have := hka₂
      rw [hcc_eq] at this
      linarith [hi_box]
  -- u lies in window 2: P ≤ u ≤ P + i·βn/j.
  have hu_w2_lo : P ≤ (u : ℝ) := by
    rw [hu_cast, hP_def]
    rcases le_total 0 y with hy0 | hy0
    · have h_max : max 0 y = y := max_eq_right hy0
      have hcc_eq : cc = n * x₁ + y := by rw [hcc_def, h_max]
      have := hka₁
      rw [hcc_eq] at this
      linarith
    · have h_max : max 0 y = 0 := max_eq_left hy0
      have hcc_eq : cc = n * x₁ := by rw [hcc_def, h_max]; ring
      have := hka₁
      rw [hcc_eq] at this
      linarith
  have hu_w2_hi : (u : ℝ) ≤ P + (i : ℝ) * (β * n) / j := by
    rw [hu_cast, hP_def]
    have h_ij_le : (i : ℝ) ≤ (i : ℝ) * (β * n) / j := by
      rw [le_div_iff₀ hj_R]
      nlinarith [hj_box, hi_R.le]
    rcases le_total 0 y with hy0 | hy0
    · have h_max : max 0 y = y := max_eq_right hy0
      have hcc_eq : cc = n * x₁ + y := by rw [hcc_def, h_max]
      have := hka₂
      rw [hcc_eq] at this
      linarith
    · have h_max : max 0 y = 0 := max_eq_left hy0
      have hcc_eq : cc = n * x₁ := by rw [hcc_def, h_max]; ring
      have := hka₂
      rw [hcc_eq] at this
      linarith [hy_lo]
  -- ===== Assemble the hit point =====
  set v : ℤ := b * B₂ + ka * j with hv_def
  have h_iv : i * v = b * (n : ℤ) + u * j := by
    rw [hv_def, hu_def]
    linear_combination b * h_det
  -- y-window for v: n·x₂ ≤ v ≤ n·x₂ + βn.
  have h_uj_lo : (i : ℝ) * (n * x₂) ≤ (b : ℝ) * n + (u : ℝ) * j := by
    have h1 := mul_le_mul_of_nonneg_right hu_w2_lo hj_R.le
    rw [hP_j] at h1
    linarith
  have h_uj_hi : (b : ℝ) * n + (u : ℝ) * j ≤ (i : ℝ) * (n * x₂) + (i : ℝ) * (β * n) := by
    have h1 := mul_le_mul_of_nonneg_right hu_w2_hi hj_R.le
    rw [add_mul, hP_j, div_mul_cancel₀ _ hj_R.ne'] at h1
    linarith
  have h_iv_R : (i : ℝ) * (v : ℝ) = (b : ℝ) * n + (u : ℝ) * j := by
    exact_mod_cast congrArg (Int.cast : ℤ → ℝ) h_iv
  have hv_lo : n * x₂ ≤ (v : ℝ) := by
    have h1 : (i : ℝ) * (n * x₂) ≤ (i : ℝ) * (v : ℝ) := by rw [h_iv_R]; linarith
    exact le_of_mul_le_mul_left h1 hi_R
  have hv_hi : (v : ℝ) ≤ n * x₂ + β * n := by
    have h1 : (i : ℝ) * (v : ℝ) ≤ (i : ℝ) * (n * x₂ + β * n) := by
      rw [h_iv_R, mul_add]
      linarith
    exact le_of_mul_le_mul_left h1 hi_R
  -- Membership of (u, v).
  have h_uv_mem : ((u : ZMod n), (v : ZMod n)) ∈ H := by
    have h_comb := int_comb_mem n H B₁ B₂ i j hB_mem hij_H b ka
    have h_fst : (b * B₁ + ka * i : ℤ) = u := by rw [hu_def]
    have h_snd : (b * B₂ + ka * j : ℤ) = v := by rw [hv_def]
    rwa [h_fst, h_snd] at h_comb
  -- α, β are positive (from the box and positivity of i, j).
  have hα_pos : (0 : ℝ) < α := by nlinarith [hi_box, hi_R, hn_pos]
  have hβ_pos : (0 : ℝ) < β := by nlinarith [hj_box, hj_R, hn_pos]
  -- The fract conditions.
  refine ⟨u, v, h_uv_mem, ?_, ?_⟩
  · have h_arg : (u : ℝ) / n - x₁ = ((u : ℝ) - n * x₁) / n := by
      field_simp
    rw [h_arg]
    have h_in : 0 ≤ ((u : ℝ) - n * x₁) / n ∧ ((u : ℝ) - n * x₁) / n ≤ α := by
      constructor
      · apply div_nonneg _ hn_pos.le
        linarith
      · rw [div_le_iff₀ hn_pos]
        linarith [hu_w1_hi]
    rw [Int.fract_eq_self.mpr ⟨h_in.1, lt_of_le_of_lt h_in.2 hα'⟩]
    exact h_in.2
  · have h_arg : (v : ℝ) / n - x₂ = ((v : ℝ) - n * x₂) / n := by
      field_simp
    rw [h_arg]
    have h_in : 0 ≤ ((v : ℝ) - n * x₂) / n ∧ ((v : ℝ) - n * x₂) / n ≤ β := by
      constructor
      · apply div_nonneg _ hn_pos.le
        linarith
      · rw [div_le_iff₀ hn_pos]
        linarith [hv_hi]
    rw [Int.fract_eq_self.mpr ⟨h_in.1, lt_of_le_of_lt h_in.2 hβ'⟩]
    exact h_in.2

/-- **Off the axes, `i > 0`**: `j < 0` is carried to `j > 0` by the reflection
`(x, y) ↦ (x, −y)` of `(ZMod n)²`, and the hit reflected back (`fract_reflect`). -/
theorem core_meets_pos (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n)
    (α β : ℝ) (hα' : α < 1) (hβ : 0 ≤ β) (hβ' : β < 1)
    (i j : ℤ) (hi : 0 < i) (hj : j ≠ 0)
    (hi_box : (i : ℝ) ≤ α * n) (hj_box : |(j : ℝ)| ≤ β * n)
    (hij_H : ((i : ZMod n), (j : ZMod n)) ∈ H)
    (hij_min_H : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H → (i, j) ≠ (k * i₀, k * j₀))
    (h12 : (n : ℝ) ≤ β * n * i + α * n * |(j : ℝ)| - 2 * i * |(j : ℝ)|)
    (x₁ x₂ : ℝ) :
    MeetsBox H α β x₁ x₂ := by
  rcases lt_or_gt_of_ne hj with hj_neg | hj_pos
  · -- j < 0: reflect the second coordinate.
    set σ : (ZMod n × ZMod n) ≃+ (ZMod n × ZMod n) :=
      (AddEquiv.refl (ZMod n)).prodCongr (AddEquiv.neg (ZMod n)) with hσ_def
    set H' : AddSubgroup (ZMod n × ZMod n) := H.map σ.toAddMonoidHom with hH'_def
    -- Membership characterisation of H' on integer casts.
    have h_mem' : ∀ u v : ℤ, ((u : ZMod n), (v : ZMod n)) ∈ H' ↔
        ((u : ZMod n), ((-v : ℤ) : ZMod n)) ∈ H := by
      intro u v
      have hcast : ((-v : ℤ) : ZMod n) = -((v : ℤ) : ZMod n) := by
        push_cast; ring
      rw [hH'_def, AddSubgroup.mem_map_equiv, hcast]
      rfl
    have hH'_card : Nat.card H' = n := by
      have hcongr : Nat.card (H.map σ.toAddMonoidHom) = Nat.card H :=
        (Nat.card_congr
          (AddSubgroup.equivMapOfInjective H σ.toAddMonoidHom σ.injective).toEquiv).symm
      rw [hH'_def]
      exact hcongr.trans hH_card
    -- (i, -j) ∈ H', positively.
    have hij_H' : ((i : ZMod n), ((-j : ℤ) : ZMod n)) ∈ H' := by
      rw [h_mem' i (-j)]
      simpa using hij_H
    -- Minimality transports through the reflection.
    have hij_min' : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
        ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H' → (i, -j) ≠ (k * i₀, k * j₀) := by
      intro i₀ j₀ k hk h₀ h_eq
      have h₀H : ((i₀ : ZMod n), ((-j₀ : ℤ) : ZMod n)) ∈ H := (h_mem' i₀ j₀).mp h₀
      apply hij_min_H i₀ (-j₀) k hk h₀H
      have h1 : i = k * i₀ := congrArg Prod.fst h_eq
      have h2 : -j = k * j₀ := congrArg Prod.snd h_eq
      refine Prod.ext h1 ?_
      change j = k * -j₀
      linear_combination -h2
    have habs : |(j : ℝ)| = -(j : ℝ) := abs_of_neg (by exact_mod_cast hj_neg)
    -- Core hit for H' at the reflected target.
    obtain ⟨u, v, h_uv', hu, hv⟩ := core_meets n hn H' hH'_card
      α β hα' hβ' i (-j) hi (by omega)
      hi_box (by push_cast; linarith [hj_box, habs.symm.le, habs.le])
      hij_H' hij_min'
      (by push_cast; rw [habs] at h12; linarith) x₁ (-x₂ - β)
    -- Reflect the hit back.
    refine ⟨u, -v, (h_mem' u v).mp h_uv', hu, ?_⟩
    have harg : (((-v : ℤ) : ℝ)) / n - x₂ = -((v : ℝ) / n) - x₂ := by
      push_cast; ring
    rw [harg]
    exact fract_reflect ((v : ℝ) / n) x₂ β hβ hβ' hv
  · -- j > 0: direct.
    have habs : |(j : ℝ)| = (j : ℝ) := abs_of_pos (by exact_mod_cast hj_pos)
    exact core_meets n hn H hH_card α β hα' hβ' i j hi hj_pos
      hi_box (habs ▸ hj_box) hij_H hij_min_H (habs ▸ h12) x₁ x₂

/-- **Off the axes, any signs**: `i < 0` is handled by the lift `(−i, −j)` of the same group. -/
theorem core_meets_signed (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n)
    (α β : ℝ) (hα' : α < 1) (hβ : 0 ≤ β) (hβ' : β < 1)
    (i j : ℤ) (hi : i ≠ 0) (hj : j ≠ 0)
    (hi_box : |(i : ℝ)| ≤ α * n) (hj_box : |(j : ℝ)| ≤ β * n)
    (hij_H : ((i : ZMod n), (j : ZMod n)) ∈ H)
    (hij_min_H : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H → (i, j) ≠ (k * i₀, k * j₀))
    (h12 : (n : ℝ) ≤ β * n * |(i : ℝ)| + α * n * |(j : ℝ)| -
      2 * |(i : ℝ)| * |(j : ℝ)|)
    (x₁ x₂ : ℝ) :
    MeetsBox H α β x₁ x₂ := by
  rcases lt_or_gt_of_ne hi with hi_neg | hi_pos
  · -- i < 0: negate the point inside the same H.
    have habs_i : |(i : ℝ)| = -(i : ℝ) := abs_of_neg (by exact_mod_cast hi_neg)
    have h_neg_mem : (((-i : ℤ) : ZMod n), ((-j : ℤ) : ZMod n)) ∈ H := by
      push_cast
      simpa using H.neg_mem hij_H
    have h_neg_min : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
        ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H → (-i, -j) ≠ (k * i₀, k * j₀) := by
      intro i₀ j₀ k hk h₀ h_eq
      have h₀' : (((-i₀ : ℤ) : ZMod n), ((-j₀ : ℤ) : ZMod n)) ∈ H := by
        push_cast
        simpa using H.neg_mem h₀
      apply hij_min_H (-i₀) (-j₀) k hk h₀'
      have h1 : -i = k * i₀ := congrArg Prod.fst h_eq
      have h2 : -j = k * j₀ := congrArg Prod.snd h_eq
      refine Prod.ext ?_ ?_
      · change i = k * -i₀
        linear_combination -h1
      · change j = k * -j₀
        linear_combination -h2
    have habs_negi : ((-i : ℤ) : ℝ) = |(i : ℝ)| := by
      push_cast
      rw [habs_i]
    have habs_negj : |((-j : ℤ) : ℝ)| = |(j : ℝ)| := by
      push_cast
      rw [abs_neg]
    exact core_meets_pos n hn H hH_card α β hα' hβ hβ'
      (-i) (-j) (by omega) (by omega)
      (habs_negi ▸ hi_box) (habs_negj ▸ hj_box)
      h_neg_mem h_neg_min
      (by rw [habs_negi, habs_negj]; exact h12) x₁ x₂
  · -- i > 0: feed directly.
    have habs_i : |(i : ℝ)| = (i : ℝ) := abs_of_pos (by exact_mod_cast hi_pos)
    exact core_meets_pos n hn H hH_card α β hα' hβ hβ'
      i j hi_pos hj
      (habs_i ▸ hi_box) hj_box hij_H hij_min_H (habs_i ▸ h12) x₁ x₂

/-- **BHK (12): a minimal step inside the box, when the group misses a box, is short.**
If `(i, j) ≠ 0` is a lift with `|i| ≤ αn`, `|j| ≤ βn`, no proper multiple of another lift, and
the group misses the box at `(x₁, x₂)`, then `β|i| + α|j| − 2|i||j|/n < 1`. -/
theorem short_step_bound (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n)
    (α β : ℝ) (hα' : α < 1) (hβ : 0 < β) (hβ' : β < 1)
    (i j : ℤ) (hij : (i, j) ≠ (0, 0))
    (hi_box : |(i : ℝ)| ≤ α * n) (hj_box : |(j : ℝ)| ≤ β * n)
    (hij_H : ((i : ZMod n), (j : ZMod n)) ∈ H)
    (hmin : ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H → (i, j) ≠ (k * i₀, k * j₀))
    (x₁ x₂ : ℝ) (hmiss : ¬ MeetsBox H α β x₁ x₂) :
    β * |(i : ℝ)| + α * |(j : ℝ)| - 2 / n * |(i : ℝ)| * |(j : ℝ)| < 1 := by
  by_cases hi0 : i = 0
  · have hj0 : j ≠ 0 := fun hj0 => hij (by rw [hi0, hj0])
    subst hi0
    have h_axis := axis_vertical n hn H hH_card α β hα' hβ' j hj0 hj_box hij_H hmin x₁ x₂ hmiss
    simp only [Int.cast_zero, abs_zero, mul_zero, zero_mul, sub_zero, zero_add]
    linarith
  by_cases hj0 : j = 0
  · subst hj0
    have h_axis := axis_horizontal n hn H hH_card α β hα' hβ' i hi0 hi_box hij_H hmin x₁ x₂ hmiss
    simp only [Int.cast_zero, abs_zero, mul_zero, sub_zero, add_zero]
    linarith
  by_contra h_ge
  push Not at h_ge
  have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
  have h12 : (n : ℝ) ≤ β * n * |(i : ℝ)| + α * n * |(j : ℝ)| -
      2 * |(i : ℝ)| * |(j : ℝ)| := by
    have hkey := mul_le_mul_of_nonneg_right h_ge hn_pos.le
    have hdiv : 2 / (n : ℝ) * |(i : ℝ)| * |(j : ℝ)| * n =
        2 * |(i : ℝ)| * |(j : ℝ)| := by
      field_simp
    nlinarith [hkey, hdiv]
  exact hmiss (core_meets_signed n hn H hH_card α β hα' hβ.le hβ' i j hi0 hj0 hi_box hj_box
    hij_H hmin h12 x₁ x₂)

/-! ## 5. the short step exists, by pigeonhole -/

/-- **A short lift, by Dirichlet's pigeonhole.**  Some nonzero lift `(i, j)` has `|i| ≤ B` for a
bound `B < 1/β` and `|j| ≤ βn`.  If `e·β ≥ 1` the column step `(0, f)` works; otherwise Dirichlet
on the column slope `c/f` with `κ = ⌈1/(βe)⌉` gives `(k·e, k·c − j·f)` with `k < κ`. -/
theorem short_step_witness (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n)
    (β : ℝ) (hβ : 0 < β) :
    ∃ B : ℝ, 0 ≤ B ∧ B < 1 / β ∧ ∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧
      ((ij.1 : ZMod n), (ij.2 : ZMod n)) ∈ H ∧
      |(ij.1 : ℝ)| ≤ B ∧ |(ij.2 : ℝ)| ≤ β * n := by
  obtain ⟨e, f, c, he_pos, hf_pos, hef, h_ec_mem, h_0f_mem, -, -⟩ :=
    column_basis n hn H hH_card
  have hn_pos_R : (0 : ℝ) < n := by exact_mod_cast (by omega : 0 < n)
  have he_pos_R : (0 : ℝ) < e := by exact_mod_cast he_pos
  have hf_pos_R : (0 : ℝ) < f := by exact_mod_cast hf_pos
  have hef_R : (e : ℝ) * f = n := by exact_mod_cast hef
  have h_1β_pos : (0 : ℝ) < 1 / β := by positivity
  by_cases h_eβ : 1 ≤ (e : ℝ) * β
  · -- Case `eβ ≥ 1`: vertical witness (0, f), B = 0.
    refine ⟨0, le_refl 0, h_1β_pos, ((0 : ℤ), (f : ℤ)), ?_, ?_, ?_, ?_⟩
    · -- (0, f) ≠ (0, 0)
      intro h_eq
      have h2 : ((f : ℕ) : ℤ) = 0 := congrArg Prod.snd h_eq
      have : f = 0 := by exact_mod_cast h2
      omega
    · -- membership, modulo ℤ-vs-ℕ casts
      have h_fst : (((0 : ℤ) : ZMod n)) = (0 : ZMod n) := by push_cast; ring
      have h_snd : ((((f : ℕ) : ℤ) : ZMod n)) = ((f : ℕ) : ZMod n) := by
        push_cast; ring
      rw [show ((((0 : ℤ), (f : ℤ)) : ℤ × ℤ).1 : ZMod n) = (0 : ZMod n) from h_fst,
          show ((((0 : ℤ), (f : ℤ)) : ℤ × ℤ).2 : ZMod n) = ((f : ℕ) : ZMod n) from h_snd]
      exact h_0f_mem
    · simp
    · -- |f| ≤ βn: from βe ≥ 1, βn = (βe)·f ≥ f.
      have h_abs : |(((f : ℕ) : ℤ) : ℝ)| = (f : ℝ) := by
        rw [abs_of_nonneg (by positivity : (0 : ℝ) ≤ (((f : ℕ) : ℤ) : ℝ))]
        push_cast
        ring
      rw [show ((((0 : ℤ), (f : ℤ)) : ℤ × ℤ).2 : ℝ) = (((f : ℕ) : ℤ) : ℝ) from rfl,
          h_abs]
      have h_expand : ((e : ℝ) * β - 1) * f = β * n - f := by
        rw [← hef_R]; ring
      have h_nonneg : (0 : ℝ) ≤ ((e : ℝ) * β - 1) * f :=
        mul_nonneg (by linarith) hf_pos_R.le
      linarith
  · -- Case `eβ < 1`: Dirichlet pigeonhole on the column slope c/f.
    push Not at h_eβ
    have h_βe_pos : (0 : ℝ) < β * e := by positivity
    set κ : ℕ := ⌈1 / (β * (e : ℝ))⌉₊ with hκ_def
    have hκ_ge : 1 / (β * (e : ℝ)) ≤ (κ : ℝ) := Nat.le_ceil _
    have hκ_lt : (κ : ℝ) < 1 / (β * e) + 1 := by
      rw [hκ_def]
      exact Nat.ceil_lt_add_one (by positivity)
    have hκ_gt_one : 1 < κ := by
      rw [hκ_def, Nat.lt_ceil]
      push_cast
      rw [lt_div_iff₀ h_βe_pos]
      nlinarith
    have hκ_pos_R : (0 : ℝ) < κ := by
      exact_mod_cast (by omega : 0 < κ)
    have hκ_pred : 0 < κ - 1 := by omega
    obtain ⟨j, k, hk_pos, hk_le, h_dir⟩ :=
      Real.exists_int_int_abs_mul_sub_le ((c : ℝ) / f) hκ_pred
    have hκ_cast : ((κ - 1 : ℕ) : ℝ) = (κ : ℝ) - 1 := by
      have h1 : (1 : ℕ) ≤ κ := by omega
      push_cast [h1]
      ring
    have h_dir' : |(k : ℝ) * ((c : ℝ) / f) - (j : ℝ)| ≤ 1 / κ := by
      have h1 : ((κ - 1 : ℕ) : ℝ) + 1 = κ := by rw [hκ_cast]; ring
      rwa [h1] at h_dir
    have hk_le_R : (k : ℝ) ≤ (κ : ℝ) - 1 := by
      rw [← hκ_cast]; exact_mod_cast hk_le
    have hk_pos_R : (0 : ℝ) < k := by exact_mod_cast hk_pos
    -- The witness pair (k·e, k·c - j·f).
    refine ⟨((κ : ℝ) - 1) * e, by nlinarith, ?_,
        ((k * (e : ℕ) : ℤ), (k * (c : ℕ) - j * (f : ℕ) : ℤ)), ?_, ?_, ?_, ?_⟩
    · -- B < 1/β: (κ-1)·e < (1/(βe))·e = 1/β.
      have h1 : (κ : ℝ) - 1 < 1 / (β * e) := by linarith
      calc ((κ : ℝ) - 1) * e < (1 / (β * e)) * e :=
            mul_lt_mul_of_pos_right h1 he_pos_R
        _ = 1 / β := by field_simp
    · -- nonzero: first coordinate k·e > 0.
      intro h_eq
      have h1 : (k * (e : ℕ) : ℤ) = 0 := congrArg Prod.fst h_eq
      have he_int : (0 : ℤ) < ((e : ℕ) : ℤ) := by exact_mod_cast he_pos
      nlinarith
    · -- membership: the pair is k•(e, c) - j•(0, f) in (ZMod n)².
      have h_pair_eq :
          (((k * (e : ℕ) : ℤ) : ZMod n), ((k * (c : ℕ) - j * (f : ℕ) : ℤ) : ZMod n)) =
            k • (((e : ℕ) : ZMod n), ((c : ℕ) : ZMod n)) -
            j • ((0 : ZMod n), ((f : ℕ) : ZMod n)) := by
        refine Prod.ext ?_ ?_
        · change ((k * (e : ℕ) : ℤ) : ZMod n) =
              k • ((e : ℕ) : ZMod n) - j • (0 : ZMod n)
          rw [smul_zero, sub_zero, zsmul_eq_mul]
          push_cast
          ring
        · change ((k * (c : ℕ) - j * (f : ℕ) : ℤ) : ZMod n) =
              k • ((c : ℕ) : ZMod n) - j • ((f : ℕ) : ZMod n)
          rw [zsmul_eq_mul, zsmul_eq_mul]
          push_cast
          ring
      rw [show ((((k * (e : ℕ) : ℤ), (k * (c : ℕ) - j * (f : ℕ) : ℤ)) : ℤ × ℤ).1 : ZMod n) =
            (((k * (e : ℕ) : ℤ)) : ZMod n) from rfl]
      rw [show ((((k * (e : ℕ) : ℤ), (k * (c : ℕ) - j * (f : ℕ) : ℤ)) : ℤ × ℤ).2 : ZMod n) =
            (((k * (c : ℕ) - j * (f : ℕ) : ℤ)) : ZMod n) from rfl]
      rw [show ((((k * (e : ℕ) : ℤ)) : ZMod n), (((k * (c : ℕ) - j * (f : ℕ) : ℤ)) : ZMod n)) =
            k • (((e : ℕ) : ZMod n), ((c : ℕ) : ZMod n)) -
            j • ((0 : ZMod n), ((f : ℕ) : ZMod n)) from h_pair_eq]
      exact H.sub_mem (H.zsmul_mem h_ec_mem k) (H.zsmul_mem h_0f_mem j)
    · -- |k·e| ≤ (κ-1)·e.
      have h_pos : (0 : ℝ) < (k : ℝ) * (e : ℕ) := by
        nlinarith
      rw [show (((k * (e : ℕ) : ℤ)) : ℝ) = (k : ℝ) * ((e : ℕ) : ℝ) from by push_cast; ring,
          abs_of_pos h_pos]
      nlinarith
    · -- |k·c - j·f| = |k·(c/f) - j|·f ≤ f/κ ≤ (βe)·f = βn.
      have h_abs_eq : |((k * (c : ℕ) - j * (f : ℕ) : ℤ) : ℝ)| =
          |(k : ℝ) * ((c : ℝ) / f) - (j : ℝ)| * f := by
        have h1 : ((k * (c : ℕ) - j * (f : ℕ) : ℤ) : ℝ) =
            ((k : ℝ) * ((c : ℝ) / f) - (j : ℝ)) * f := by
          push_cast
          field_simp
        rw [h1, abs_mul, abs_of_pos hf_pos_R]
      rw [show (((k * (c : ℕ) - j * (f : ℕ) : ℤ)) : ℝ) =
            ((k * (c : ℕ) - j * (f : ℕ) : ℤ) : ℝ) from rfl, h_abs_eq]
      have h_1κ_le : (1 : ℝ) / κ ≤ β * e := by
        rw [div_le_iff₀ hκ_pos_R]
        calc (1 : ℝ) = (1 / (β * e)) * (β * e) := by field_simp
          _ ≤ (κ : ℝ) * (β * e) := mul_le_mul_of_nonneg_right hκ_ge h_βe_pos.le
          _ = β * e * κ := by ring
      calc |(k : ℝ) * ((c : ℝ) / f) - (j : ℝ)| * f ≤ (1 / κ) * f :=
            mul_le_mul_of_nonneg_right h_dir' hf_pos_R.le
        _ ≤ (β * e) * f := mul_le_mul_of_nonneg_right h_1κ_le hf_pos_R.le
        _ = β * n := by rw [mul_assoc, hef_R]

/-- **The minimal step (BHK (13)).**  `(i, j)` is minimal when no nonzero lift lies in the box
`[−|i|, |i|] × [−|j|, |j|]` other than its corners `(±i, ±j)`. -/
def IsMinimalStep {n : ℕ} (H : AddSubgroup (ZMod n × ZMod n)) (i j : ℤ) : Prop :=
  ∀ k l : ℤ, (k, l) ≠ (0, 0) → |k| ≤ |i| → |l| ≤ |j| → ¬(|k| = |i| ∧ |l| = |j|) →
    ((k : ZMod n), (l : ZMod n)) ∉ H

/-- **Descent to a minimal step.**  From a nonzero lift in `[−B, B] × [−C, C]`, descend on
`(|i| + 1)(|j| + 1)` to a minimal one in the same box. -/
theorem minimal_select {n : ℕ} (H : AddSubgroup (ZMod n × ZMod n)) (B C : ℝ)
    (h_ex : ∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧ ((ij.1 : ZMod n), (ij.2 : ZMod n)) ∈ H ∧
      |(ij.1 : ℝ)| ≤ B ∧ |(ij.2 : ℝ)| ≤ C) :
    ∃ ij : ℤ × ℤ, ij ≠ (0, 0) ∧ ((ij.1 : ZMod n), (ij.2 : ZMod n)) ∈ H ∧
      |(ij.1 : ℝ)| ≤ B ∧ |(ij.2 : ℝ)| ≤ C ∧ IsMinimalStep H ij.1 ij.2 := by
  obtain ⟨ij₀, h₀⟩ := h_ex
  suffices key : ∀ m : ℕ, ∀ ij : ℤ × ℤ,
      (ij.1.natAbs + 1) * (ij.2.natAbs + 1) ≤ m →
      ij ≠ (0, 0) → ((ij.1 : ZMod n), (ij.2 : ZMod n)) ∈ H →
      |(ij.1 : ℝ)| ≤ B → |(ij.2 : ℝ)| ≤ C →
      ∃ ij' : ℤ × ℤ, ij' ≠ (0, 0) ∧ ((ij'.1 : ZMod n), (ij'.2 : ZMod n)) ∈ H ∧
        |(ij'.1 : ℝ)| ≤ B ∧ |(ij'.2 : ℝ)| ≤ C ∧ IsMinimalStep H ij'.1 ij'.2 by
    exact key ((ij₀.1.natAbs + 1) * (ij₀.2.natAbs + 1)) ij₀ le_rfl
      h₀.1 h₀.2.1 h₀.2.2.1 h₀.2.2.2
  intro m
  induction m with
  | zero =>
    intro ij hm _ _ _ _
    have hpos : 0 < (ij.1.natAbs + 1) * (ij.2.natAbs + 1) :=
      Nat.mul_pos (by omega) (by omega)
    omega
  | succ m ih =>
    intro ij hm hne hmem hB hC
    by_cases hmin : IsMinimalStep H ij.1 ij.2
    · exact ⟨ij, hne, hmem, hB, hC, hmin⟩
    · unfold IsMinimalStep at hmin
      push Not at hmin
      obtain ⟨k, l, hkl_ne, hkl_i, hkl_j, hkl_corner, hkl_mem⟩ := hmin
      have habs_i : k.natAbs ≤ ij.1.natAbs := by
        rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs] at hkl_i
        exact_mod_cast hkl_i
      have habs_j : l.natAbs ≤ ij.2.natAbs := by
        rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs] at hkl_j
        exact_mod_cast hkl_j
      have habs_ne : k.natAbs ≠ ij.1.natAbs ∨ l.natAbs ≠ ij.2.natAbs := by
        by_contra hcon
        push Not at hcon
        have h1 : |k| = |ij.1| := by
          rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs]
          exact_mod_cast hcon.1
        have h2 : |l| = |ij.2| := by
          rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs]
          exact_mod_cast hcon.2
        exact hkl_corner h1 h2
      have hmeas : (k.natAbs + 1) * (l.natAbs + 1)
          < (ij.1.natAbs + 1) * (ij.2.natAbs + 1) := by
        rcases habs_ne with h | h
        · exact Nat.mul_lt_mul_of_lt_of_le (by omega) (by omega) (by omega)
        · exact Nat.mul_lt_mul_of_le_of_lt (by omega) (by omega) (by omega)
      have hkl_B : |(k : ℝ)| ≤ B := by
        refine le_trans ?_ hB
        rw [← Int.cast_abs, ← Int.cast_abs]
        exact_mod_cast hkl_i
      have hkl_C : |(l : ℝ)| ≤ C := by
        refine le_trans ?_ hC
        rw [← Int.cast_abs, ← Int.cast_abs]
        exact_mod_cast hkl_j
      exact ih (k, l) (by simp only; omega) hkl_ne hkl_mem hkl_B hkl_C

/-- **A minimal step is no proper multiple of another lift.** -/
theorem primitive_of_minimal {n : ℕ} (H : AddSubgroup (ZMod n × ZMod n)) (i j : ℤ)
    (hne : (i, j) ≠ (0, 0)) (hmin : IsMinimalStep H i j) :
    ∀ i₀ j₀ : ℤ, ∀ k : ℤ, 1 < k →
      ((i₀ : ZMod n), (j₀ : ZMod n)) ∈ H → (i, j) ≠ (k * i₀, k * j₀) := by
  intro i₀ j₀ k hk h₀ heq
  have hi_eq : i = k * i₀ := congr_arg Prod.fst heq
  have hj_eq : j = k * j₀ := congr_arg Prod.snd heq
  have hk_abs : |k| = k := abs_of_pos (by omega)
  have hne₀ : (i₀, j₀) ≠ ((0 : ℤ), (0 : ℤ)) := by
    intro h00
    have hi₀ : i₀ = 0 := congr_arg Prod.fst h00
    have hj₀ : j₀ = 0 := congr_arg Prod.snd h00
    exact hne (Prod.ext (by rw [hi_eq, hi₀, mul_zero]) (by rw [hj_eq, hj₀, mul_zero]))
  have hai : |i| = k * |i₀| := by rw [hi_eq, abs_mul, hk_abs]
  have haj : |j| = k * |j₀| := by rw [hj_eq, abs_mul, hk_abs]
  refine hmin i₀ j₀ hne₀ ?_ ?_ ?_ h₀
  · rw [hai]; nlinarith [abs_nonneg i₀]
  · rw [haj]; nlinarith [abs_nonneg j₀]
  · rintro ⟨h1, h2⟩
    rw [hai] at h1
    rw [haj] at h2
    have hi0 : |i₀| = 0 := by nlinarith [abs_nonneg i₀]
    have hj0 : |j₀| = 0 := by nlinarith [abs_nonneg j₀]
    exact hne₀ (by rw [abs_eq_zero.mp hi0, abs_eq_zero.mp hj0])

/-! ## 6. global isolation in two dimensions, for an order-`n` group -/

/-- **Two-dimensional global isolation (BHK Main Lemma with Corollary 6's minimal pair).**
Let `H ≤ (ZMod n)²` have order `n`, and `0 < α, β < 1` with `αβn ≥ 1`.  Either the group meets
every `α × β` box, or it has a **short step**: a nonzero lift `(i, j)` with `0 ≤ i < 1/β`,
`|j| ≤ βn`, BHK's bound `β|i| + α|j| − 2|i||j|/n < 1`, the cone `α|j| < 1 + β·i` of Corollary 6,
and minimal in the sense of (13). -/
theorem isolation_or_short_step (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH_card : Nat.card H = n)
    (α β : ℝ) (hα' : α < 1) (hβ : 0 < β) (hβ' : β < 1)
    (hαβ : 1 ≤ α * β * n) :
    (∀ x₁ x₂ : ℝ, MeetsBox H α β x₁ x₂) ∨
    ∃ i j : ℤ, (i, j) ≠ (0, 0) ∧ ((i : ZMod n), (j : ZMod n)) ∈ H ∧
      0 ≤ i ∧ (i : ℝ) < 1 / β ∧ |(j : ℝ)| ≤ β * n ∧
      β * |(i : ℝ)| + α * |(j : ℝ)| - 2 / n * |(i : ℝ)| * |(j : ℝ)| < 1 ∧
      α * |(j : ℝ)| < 1 + β * i ∧
      IsMinimalStep H i j := by
  by_cases h_all : ∀ x₁ x₂ : ℝ, MeetsBox H α β x₁ x₂
  · exact Or.inl h_all
  refine Or.inr ?_
  push Not at h_all
  obtain ⟨x₁, x₂, hmiss⟩ := h_all
  have hn_pos : (0 : ℝ) < n := by exact_mod_cast (by omega : (0 : ℕ) < n)
  have h_1β_le_αn : (1 : ℝ) / β ≤ α * n := by
    rw [div_le_iff₀ hβ]; linarith
  obtain ⟨B, _hB_nn, hB_lt, ij₀, hij₀_ne, hij₀_H, hij₀_B, hij₀_β⟩ :=
    short_step_witness n hn H hH_card β hβ
  obtain ⟨ij, hij_ne, hij_H, hij_B, hij_β, hij_min⟩ :=
    minimal_select H B (β * n) ⟨ij₀, hij₀_ne, hij₀_H, hij₀_B, hij₀_β⟩
  have hi_lt : |(ij.1 : ℝ)| < 1 / β := lt_of_le_of_lt hij_B hB_lt
  have hbound := short_step_bound n hn H hH_card α β hα' hβ hβ' ij.1 ij.2 hij_ne
    (le_trans hi_lt.le h_1β_le_αn) hij_β hij_H
    (primitive_of_minimal H ij.1 ij.2 hij_ne hij_min) x₁ x₂ hmiss
  -- the cone: `2|i||j|/n ≤ 2β|i|`
  have hcone : α * |(ij.2 : ℝ)| < 1 + β * |(ij.1 : ℝ)| := by
    have h_step : 2 / (n : ℝ) * |(ij.1 : ℝ)| * |(ij.2 : ℝ)| ≤ 2 * β * |(ij.1 : ℝ)| := by
      have h1 : |(ij.2 : ℝ)| / n ≤ β := by rw [div_le_iff₀ hn_pos]; linarith
      have h2 : 2 / (n : ℝ) * |(ij.1 : ℝ)| * |(ij.2 : ℝ)| =
          2 * |(ij.1 : ℝ)| * (|(ij.2 : ℝ)| / n) := by ring
      rw [h2]
      nlinarith [abs_nonneg (ij.1 : ℝ)]
    linarith
  -- sign normalisation: `i ≥ 0`
  rcases le_or_gt 0 ij.1 with h_pos | h_neg
  · have habs : |(ij.1 : ℝ)| = (ij.1 : ℝ) := abs_of_nonneg (by exact_mod_cast h_pos)
    refine ⟨ij.1, ij.2, hij_ne, hij_H, h_pos, by rw [← habs]; exact hi_lt, hij_β, hbound,
      by rw [← habs]; exact hcone, hij_min⟩
  · have habs : |(ij.1 : ℝ)| = ((-ij.1 : ℤ) : ℝ) := by
      push_cast; exact abs_of_neg (by exact_mod_cast h_neg)
    refine ⟨-ij.1, -ij.2, ?_, ?_, by omega, ?_, ?_, ?_, ?_, ?_⟩
    · intro h
      apply hij_ne
      have h1 : -ij.1 = 0 := congr_arg Prod.fst h
      have h2 : -ij.2 = 0 := congr_arg Prod.snd h
      exact Prod.ext (by simp only; omega) (by simp only; omega)
    · push_cast
      simpa using H.neg_mem hij_H
    · rw [← habs]; exact hi_lt
    · push_cast; rw [abs_neg]; exact hij_β
    · push_cast; rw [abs_neg, abs_neg]; exact hbound
    · rw [← habs]; push_cast; rw [abs_neg]; exact hcone
    · intro k l hkl h1 h2 h3
      refine hij_min k l hkl ?_ ?_ ?_
      · simpa [abs_neg] using h1
      · simpa [abs_neg] using h2
      · simpa [abs_neg] using h3

/-- **Corollary 6's cone, in BHK's form**: `α|j| < 1 + β·i` with `α > 0` is
`−1/α − (β/α)·i < j < 1/α + (β/α)·i`. -/
theorem cone_of_bound {α β : ℝ} (hα : 0 < α) {i j : ℝ} (h : α * |j| < 1 + β * i) :
    -1 / α - β / α * i < j ∧ j < 1 / α + β / α * i := by
  have hj1 : α * j < 1 + β * i :=
    lt_of_le_of_lt (mul_le_mul_of_nonneg_left (le_abs_self j) hα.le) h
  have hj2 : α * (-j) < 1 + β * i :=
    lt_of_le_of_lt (mul_le_mul_of_nonneg_left (neg_le_abs j) hα.le) h
  have e1 : -1 / α - β / α * i = -((1 + β * i) / α) := by field_simp; ring
  have e2 : 1 / α + β / α * i = (1 + β * i) / α := by field_simp
  rw [e1, e2]
  constructor
  · have : -j < (1 + β * i) / α := by rw [lt_div_iff₀ hα]; linarith
    linarith
  · rw [lt_div_iff₀ hα]; linarith

/-- **BHK Lemma 7 (the order bound), combinatorial core.**  If `H` has no nonzero lift in
`[−i, i] × [−j, j]` off the corners, then `n ≥ (i + 1)(j + 1) − 2`: the translates of
`[0, i] × [0, j]` minus two corners by the `n` points of the orbit are disjoint in `(ZMod n)²`. -/
theorem order_bound_card (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH : Nat.card H = n)
    (i j : ℕ) (hi : 1 ≤ i) (hj : 1 ≤ j) (hin : i < n) (hjn : j < n)
    (hmin : ∀ k l : ℤ, (k, l) ≠ (0, 0) → |k| ≤ (i : ℤ) → |l| ≤ (j : ℤ) →
        ¬(|k| = (i : ℤ) ∧ |l| = (j : ℤ)) →
        (((k : ZMod n), (l : ZMod n)) : ZMod n × ZMod n) ∉ H) :
    (i + 1) * (j + 1) - 2 ≤ n := by
  classical
  haveI : NeZero n := ⟨by omega⟩
  -- The box of representatives `[0,i] × [0,j]` (as `ℕ × ℕ`) and the two
  -- corner points BHK removes.
  set box : Finset (ℕ × ℕ) := Finset.range (i + 1) ×ˢ Finset.range (j + 1) with hbox
  set corners : Finset (ℕ × ℕ) := {(i, 0), (i, j)} with hcorners
  set Y₀ : Finset (ℕ × ℕ) := box \ corners with hY₀
  -- The embedding into the torus group.
  set emb : ℕ × ℕ → ZMod n × ZMod n := fun ab => ((ab.1 : ZMod n), (ab.2 : ZMod n)) with hemb
  set Y : Finset (ZMod n × ZMod n) := Y₀.image emb with hYdef
  set S : Finset (ZMod n × ZMod n) := Finset.univ.filter (· ∈ H) with hSdef
  -- `emb` is injective on the box (coords `< n`).
  have hcast_inj : ∀ a b : ℕ, a < n → b < n → (a : ZMod n) = (b : ZMod n) → a = b := by
    intro a b ha hb hab
    have := congrArg ZMod.val hab
    rwa [ZMod.val_natCast, ZMod.val_natCast, Nat.mod_eq_of_lt ha, Nat.mod_eq_of_lt hb] at this
  have hemb_injOn : Set.InjOn emb box := by
    intro x hx y hy hxy
    rw [Finset.coe_product, Set.mem_prod] at hx hy
    simp only [Finset.coe_range, Set.mem_Iio] at hx hy
    obtain ⟨hx1, hx2⟩ := hx; obtain ⟨hy1, hy2⟩ := hy
    have h1 : x.1 = y.1 := hcast_inj _ _ (by omega) (by omega) (congrArg Prod.fst hxy)
    have h2 : x.2 = y.2 := hcast_inj _ _ (by omega) (by omega) (congrArg Prod.snd hxy)
    exact Prod.ext h1 h2
  -- `|Y| = (i+1)(j+1) - 2`.
  have hbox_card : box.card = (i + 1) * (j + 1) := by
    rw [hbox, Finset.card_product, Finset.card_range, Finset.card_range]
  have hcorners_sub : corners ⊆ box := by
    rw [hcorners, Finset.insert_subset_iff, Finset.singleton_subset_iff, hbox]
    exact ⟨Finset.mk_mem_product (Finset.mem_range.mpr (by omega)) (Finset.mem_range.mpr (by omega)),
           Finset.mk_mem_product (Finset.mem_range.mpr (by omega)) (Finset.mem_range.mpr (by omega))⟩
  have hcorners_card : corners.card = 2 := by
    rw [hcorners]
    exact Finset.card_pair (by intro hcon; rw [Prod.mk.injEq] at hcon; omega)
  have hY₀_card : Y₀.card = (i + 1) * (j + 1) - 2 := by
    have hcard := Finset.card_sdiff_add_card_eq_card hcorners_sub
    rw [← hY₀, hbox_card, hcorners_card] at hcard
    omega
  have hY_card : Y.card = (i + 1) * (j + 1) - 2 := by
    rw [hYdef, Finset.card_image_of_injOn (hemb_injOn.mono (by rw [hY₀]; exact Finset.sdiff_subset)),
      hY₀_card]
  -- `|S| = n`.
  have hS_card : S.card = n := by
    rw [hSdef, ← Fintype.card_subtype (· ∈ H), ← Nat.card_eq_fintype_card]
    exact hH
  -- The map `(g, y) ↦ g + y` is injective on `S ×ˢ Y`.
  have hmap_inj : Set.InjOn (fun p : (ZMod n × ZMod n) × (ZMod n × ZMod n) => p.1 + p.2)
      (↑(S ×ˢ Y) : Set ((ZMod n × ZMod n) × (ZMod n × ZMod n))) := by
    intro p hp p' hp' heq
    rw [Finset.mem_coe, Finset.mem_product] at hp hp'
    obtain ⟨hpS, hpY⟩ := hp
    obtain ⟨hp'S, hp'Y⟩ := hp'
    rw [hSdef, Finset.mem_filter] at hpS hp'S
    obtain ⟨-, hpH⟩ := hpS
    obtain ⟨-, hp'H⟩ := hp'S
    rw [hYdef, Finset.mem_image] at hpY hp'Y
    obtain ⟨⟨a₁, b₁⟩, hab₁, hemb₁⟩ := hpY
    obtain ⟨⟨a₂, b₂⟩, hab₂, hemb₂⟩ := hp'Y
    simp only [hemb] at hemb₁ hemb₂
    -- box bounds and corner exclusions for both representatives
    rw [hY₀, Finset.mem_sdiff] at hab₁ hab₂
    obtain ⟨hin₁, hcor₁⟩ := hab₁
    obtain ⟨hin₂, hcor₂⟩ := hab₂
    rw [hbox, Finset.mem_product, Finset.mem_range, Finset.mem_range] at hin₁ hin₂
    obtain ⟨ha₁, hb₁⟩ := hin₁
    obtain ⟨ha₂, hb₂⟩ := hin₂
    rw [hcorners, Finset.mem_insert, Finset.mem_singleton, not_or] at hcor₁ hcor₂
    -- `heq` as an equation of group elements
    have h : p.1 + p.2 = p'.1 + p'.2 := heq
    -- `p'.2 - p.2 ∈ H`
    have hdiff_mem : p'.2 - p.2 ∈ H := by
      have hsub : p'.2 - p.2 = p.1 - p'.1 := by linear_combination -h
      rw [hsub]; exact H.sub_mem hpH hp'H
    -- identify the difference with the integer pair `(a₂-a₁, b₂-b₁)` reduced mod n
    set k : ℤ := (a₂ : ℤ) - (a₁ : ℤ) with hk
    set l : ℤ := (b₂ : ℤ) - (b₁ : ℤ) with hl
    have hmem_kl : (((k : ZMod n), (l : ZMod n)) : ZMod n × ZMod n) ∈ H := by
      have heqkl : (((k : ZMod n), (l : ZMod n)) : ZMod n × ZMod n) = p'.2 - p.2 := by
        rw [← hemb₂, ← hemb₁, hk, hl, Prod.mk_sub_mk, Prod.mk.injEq]
        constructor <;> push_cast <;> ring
      rw [heqkl]; exact hdiff_mem
    have hk_abs : |k| ≤ (i : ℤ) := by rw [hk, abs_le]; omega
    have hl_abs : |l| ≤ (j : ℤ) := by rw [hl, abs_le]; omega
    by_cases hkl0 : (k, l) = (0, 0)
    · -- zero difference: the box reps coincide, hence both coordinates do
      have hk0 : k = 0 := congrArg Prod.fst hkl0
      have hl0 : l = 0 := congrArg Prod.snd hkl0
      have ha : a₁ = a₂ := by rw [hk] at hk0; omega
      have hb : b₁ = b₂ := by rw [hl] at hl0; omega
      have hp2eq : p.2 = p'.2 := by rw [← hemb₁, ← hemb₂, ha, hb]
      have hp1eq : p.1 = p'.1 := by rw [hp2eq] at h; exact add_right_cancel h
      exact Prod.ext hp1eq hp2eq
    · exfalso
      by_cases hcorner : |k| = (i : ℤ) ∧ |l| = (j : ℤ)
      · -- corner difference: one of the box reps is a removed corner
        obtain ⟨hki, hlj⟩ := hcorner
        rw [hk, abs_eq (by positivity)] at hki
        rw [hl, abs_eq (by positivity)] at hlj
        rcases hki with hki | hki <;> rcases hlj with hlj | hlj
        · -- a₂=i,a₁=0,b₂=j,b₁=0 : (a₂,b₂)=(i,j)
          exact hcor₂.2 (Prod.ext (by omega) (by omega))
        · -- a₂=i,a₁=0,b₂=0,b₁=j : (a₂,b₂)=(i,0)
          exact hcor₂.1 (Prod.ext (by omega) (by omega))
        · -- a₂=0,a₁=i,b₂=j,b₁=0 : (a₁,b₁)=(i,0)
          exact hcor₁.1 (Prod.ext (by omega) (by omega))
        · -- a₂=0,a₁=i,b₂=0,b₁=j : (a₁,b₁)=(i,j)
          exact hcor₁.2 (Prod.ext (by omega) (by omega))
      · exact hmin k l hkl0 hk_abs hl_abs hcorner hmem_kl
  -- counting: `|S| · |Y| ≤ n²`
  have hcard_le : (S ×ˢ Y).card ≤ (Finset.univ : Finset (ZMod n × ZMod n)).card :=
    Finset.card_le_card_of_injOn (fun p => p.1 + p.2) (fun _ _ => Finset.mem_univ _) hmap_inj
  have huniv : (Finset.univ : Finset (ZMod n × ZMod n)).card = n * n := by
    simp only [Finset.card_univ, Fintype.card_prod, ZMod.card]
  rw [Finset.card_product, hS_card, hY_card, huniv] at hcard_le
  -- cancel the factor `n`
  exact Nat.le_of_mul_le_mul_left hcard_le (by omega)

/-- **BHK Lemma 7 for a minimal step**: `i, j ≠ 0`, `|i|, |j| < n` give
`n ≥ (|i| + 1)(|j| + 1) − 2` (BHK (14)). -/
theorem order_bound_of_minimal (n : ℕ) (hn : 1 < n)
    (H : AddSubgroup (ZMod n × ZMod n)) (hH : Nat.card H = n)
    (i j : ℤ) (hi : i ≠ 0) (hj : j ≠ 0) (hin : i.natAbs < n) (hjn : j.natAbs < n)
    (hmin : IsMinimalStep H i j) :
    (i.natAbs + 1) * (j.natAbs + 1) - 2 ≤ n := by
  refine order_bound_card n hn H hH i.natAbs j.natAbs (by omega) (by omega) hin hjn ?_
  intro k l hkl0 hk_abs hl_abs hcorner
  refine hmin k l hkl0 ?_ ?_ ?_
  · rw [Int.abs_eq_natAbs i]; exact hk_abs
  · rw [Int.abs_eq_natAbs j]; exact hl_abs
  · rw [Int.abs_eq_natAbs i, Int.abs_eq_natAbs j]; exact hcorner

/-! ## 7. on the multiples: the orbit of meeting times `k ↦ ((c₃·k) % n, (c₁·k) % n)` -/

/-- **The orbit of meeting times**: the cyclic group generated by `(c₃, c₁)` in `(ZMod n)²`. -/
abbrev meetingOrbit (n c₃ c₁ : ℕ) : AddSubgroup (ZMod n × ZMod n) :=
  AddSubgroup.zmultiples ((c₃ : ZMod n), (c₁ : ZMod n))

/-- **The orbit has exactly `n` points** when `gcd(n, c₃, c₁) = 1`. -/
theorem card_meetingOrbit (n c₃ c₁ : ℕ) (hn : 1 < n)
    (hg : Nat.gcd n (Nat.gcd c₃ c₁) = 1) :
    Nat.card (meetingOrbit n c₃ c₁) = n := by
  have hn0 : n ≠ 0 := by omega
  rw [Nat.card_zmultiples, Prod.addOrderOf_mk,
      ZMod.addOrderOf_coe c₃ hn0, ZMod.addOrderOf_coe c₁ hn0]
  set a := n.gcd c₃ with ha_def
  set b := n.gcd c₁ with hb_def
  have ha : a ∣ n := Nat.gcd_dvd_left _ _
  have hb : b ∣ n := Nat.gcd_dvd_left _ _
  have hapos : 0 < a := Nat.gcd_pos_of_pos_left c₃ (by omega)
  have hbpos : 0 < b := Nat.gcd_pos_of_pos_left c₁ (by omega)
  have hab : Nat.Coprime a b := by
    have h1 : Nat.gcd a b ∣ n := (Nat.gcd_dvd_left a b).trans ha
    have h2 : Nat.gcd a b ∣ Nat.gcd c₃ c₁ :=
      Nat.dvd_gcd ((Nat.gcd_dvd_left a b).trans (Nat.gcd_dvd_right n c₃))
                  ((Nat.gcd_dvd_right a b).trans (Nat.gcd_dvd_right n c₁))
    have h3 := Nat.dvd_gcd h1 h2
    rw [hg] at h3
    exact Nat.dvd_one.mp h3
  obtain ⟨m, hm⟩ := Nat.Coprime.mul_dvd_of_dvd_of_dvd hab ha hb
  have hna : n / a = b * m := by
    rw [hm, mul_assoc, Nat.mul_div_cancel_left _ hapos]
  have hnb : n / b = a * m := by
    rw [hm, show a * b * m = b * (a * m) from by ring,
        Nat.mul_div_cancel_left _ hbpos]
  have hmpos : 0 < m := by
    rcases Nat.eq_zero_or_pos m with h0 | h
    · subst h0; simp at hm; omega
    · exact h
  have hgba : Nat.gcd b a = 1 := hab.symm
  rw [hna, hnb, Nat.lcm, Nat.gcd_mul_right, hgba, one_mul,
      show b * m * (a * m) = a * b * m * m from by ring,
      Nat.mul_div_cancel _ hmpos, hm]

/-- **`(i, j)` lifts the `k`-th meeting point**: `i ≡ c₃·k` and `j ≡ c₁·k (mod n)`, `k < n`. -/
def OnOrbit (n c₃ c₁ : ℕ) (i j : ℤ) : Prop :=
  ∃ k : ℕ, k < n ∧ i % n = (((c₃ * k) % n : ℕ) : ℤ) ∧ j % n = (((c₁ * k) % n : ℕ) : ℤ)

/-- **Membership in the orbit is `OnOrbit`**, in both directions. -/
theorem mem_meetingOrbit_iff (n c₃ c₁ : ℕ) (hn : 0 < n) (i j : ℤ) :
    ((i : ZMod n), (j : ZMod n)) ∈ meetingOrbit n c₃ c₁ ↔ OnOrbit n c₃ c₁ i j := by
  haveI : NeZero n := ⟨hn.ne'⟩
  have hcast : ∀ (a : ℤ) (c k : ℕ), (a : ZMod n) = ((c * k : ℕ) : ZMod n) ↔
      a % n = (((c * k) % n : ℕ) : ℤ) := by
    intro a c k
    rw [show ((c * k : ℕ) : ZMod n) = (((c * k : ℕ) : ℤ) : ZMod n) from by push_cast; rfl,
      ZMod.intCast_eq_intCast_iff', Int.natCast_mod]
  constructor
  · intro h
    obtain ⟨z, hz⟩ := AddSubgroup.mem_zmultiples_iff.mp h
    set k : ℕ := (z % (n : ℤ)).toNat with hk_def
    have hk_cast : ((k : ℕ) : ℤ) = z % (n : ℤ) :=
      Int.toNat_of_nonneg (Int.emod_nonneg z (by exact_mod_cast hn.ne'))
    have hk_lt : k < n := by
      have := Int.emod_lt_of_pos z (by exact_mod_cast hn : (0 : ℤ) < n)
      omega
    have hzk : ((z : ℤ) : ZMod n) = ((k : ℕ) : ZMod n) := by
      rw [show ((k : ℕ) : ZMod n) = (((k : ℕ) : ℤ) : ZMod n) from by push_cast; rfl,
          hk_cast, ZMod.intCast_mod]
    rw [Prod.smul_mk, Prod.mk.injEq] at hz
    have h1 : (i : ZMod n) = ((c₃ * k : ℕ) : ZMod n) := by
      rw [← hz.1, zsmul_eq_mul, hzk]; push_cast; ring
    have h2 : (j : ZMod n) = ((c₁ * k : ℕ) : ZMod n) := by
      rw [← hz.2, zsmul_eq_mul, hzk]; push_cast; ring
    exact ⟨k, hk_lt, (hcast i c₃ k).mp h1, (hcast j c₁ k).mp h2⟩
  · rintro ⟨k, -, h1, h2⟩
    rw [AddSubgroup.mem_zmultiples_iff]
    refine ⟨(k : ℤ), ?_⟩
    rw [Prod.smul_mk, (hcast i c₃ k).mpr h1, (hcast j c₁ k).mpr h2, zsmul_eq_mul, zsmul_eq_mul]
    push_cast
    ext <;> ring

/-- **The orbit meets the box at `(x₁, x₂)`, on the multiples**: some `k < n` has
`{(c₃·k) % n / n − x₁} ≤ α` and `{(c₁·k) % n / n − x₂} ≤ β`. -/
def OrbitMeets (n c₃ c₁ : ℕ) (α β x₁ x₂ : ℝ) : Prop :=
  ∃ k : ℕ, k < n ∧ Int.fract ((((c₃ * k) % n : ℕ) : ℝ) / n - x₁) ≤ α ∧
    Int.fract ((((c₁ * k) % n : ℕ) : ℝ) / n - x₂) ≤ β

/-- A lift reads the same as its residue. -/
theorem fract_div_emod (n : ℕ) (hn : 0 < n) (u : ℤ) (x : ℝ) :
    Int.fract ((u : ℝ) / n - x) = Int.fract (((u % n : ℤ) : ℝ) / n - x) := by
  have hnR : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  have hsplit : (u : ℝ) / n - x = (((u % n : ℤ) : ℝ) / n - x) + ((u / n : ℤ) : ℝ) := by
    have h := Int.mul_ediv_add_emod u n
    have hR : (u : ℝ) = (n : ℝ) * ((u / n : ℤ) : ℝ) + ((u % n : ℤ) : ℝ) := by
      exact_mod_cast h.symm
    rw [hR]; field_simp; ring
  rw [hsplit, Int.fract_add_intCast]

/-- **Meeting the box is the same on the group and on the multiples**, in both directions. -/
theorem meetsBox_iff_orbitMeets (n c₃ c₁ : ℕ) (hn : 0 < n) (α β x₁ x₂ : ℝ) :
    MeetsBox (meetingOrbit n c₃ c₁) α β x₁ x₂ ↔ OrbitMeets n c₃ c₁ α β x₁ x₂ := by
  constructor
  · rintro ⟨u, v, huv, hu, hv⟩
    obtain ⟨k, hk, h1, h2⟩ := (mem_meetingOrbit_iff n c₃ c₁ hn u v).mp huv
    refine ⟨k, hk, ?_, ?_⟩
    · rwa [fract_div_emod n hn, h1, Int.cast_natCast] at hu
    · rwa [fract_div_emod n hn, h2, Int.cast_natCast] at hv
  · rintro ⟨k, hk, hu, hv⟩
    refine ⟨(((c₃ * k) % n : ℕ) : ℤ), (((c₁ * k) % n : ℕ) : ℤ), ?_, ?_, ?_⟩
    · rw [mem_meetingOrbit_iff n c₃ c₁ hn]
      refine ⟨k, hk, ?_, ?_⟩ <;>
        rw [Int.emod_eq_of_lt (by positivity)
          (by exact_mod_cast Nat.mod_lt _ hn)]
    · rwa [Int.cast_natCast]
    · rwa [Int.cast_natCast]

/-- **The minimal step on the orbit (BHK (13))**: no nonzero lift of a meeting point lies in
`[−|i|, |i|] × [−|j|, |j|]` off the corners. -/
def MinimalOnOrbit (n c₃ c₁ : ℕ) (i j : ℤ) : Prop :=
  ∀ k l : ℤ, (k, l) ≠ (0, 0) → |k| ≤ |i| → |l| ≤ |j| → ¬(|k| = |i| ∧ |l| = |j|) →
    ¬ OnOrbit n c₃ c₁ k l

/-- **Global isolation in two dimensions, on the meeting times.**  If `gcd(n, c₃, c₁) = 1`,
`0 < α, β < 1` and `αβn ≥ 1`, then either the orbit `k ↦ ({c₃k/n}, {c₁k/n})` meets every
`α × β` box, or it has a short step: a nonzero `(i, j) ≡ (c₃k, c₁k) (mod n)` with `0 ≤ i < 1/β`,
`|j| ≤ βn`, BHK (12), Corollary 6's cone, minimal (13), and — off the axes — Lemma 7's order
bound `n ≥ (|i| + 1)(|j| + 1) − 2`. -/
theorem orbit_isolation_two (n c₃ c₁ : ℕ) (hn : 1 < n)
    (hg : Nat.gcd n (Nat.gcd c₃ c₁) = 1)
    (α β : ℝ) (hα : 0 < α) (hα' : α < 1) (hβ : 0 < β) (hβ' : β < 1)
    (hαβ : 1 ≤ α * β * n) :
    (∀ x₁ x₂ : ℝ, OrbitMeets n c₃ c₁ α β x₁ x₂) ∨
    ∃ i j : ℤ, (i, j) ≠ (0, 0) ∧ OnOrbit n c₃ c₁ i j ∧
      0 ≤ i ∧ (i : ℝ) < 1 / β ∧ |(j : ℝ)| ≤ β * n ∧
      β * |(i : ℝ)| + α * |(j : ℝ)| - 2 / n * |(i : ℝ)| * |(j : ℝ)| < 1 ∧
      -1 / α - β / α * i < (j : ℝ) ∧ (j : ℝ) < 1 / α + β / α * i ∧
      MinimalOnOrbit n c₃ c₁ i j ∧
      (i ≠ 0 → j ≠ 0 → (i.natAbs + 1) * (j.natAbs + 1) - 2 ≤ n) := by
  have hn0 : 0 < n := by omega
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn0
  rcases isolation_or_short_step n hn (meetingOrbit n c₃ c₁) (card_meetingOrbit n c₃ c₁ hn hg)
      α β hα' hβ hβ' hαβ with hall | ⟨i, j, hne, hmem, hi0, hi1, hj, h12, hcone, hmin⟩
  · exact Or.inl fun x₁ x₂ => (meetsBox_iff_orbitMeets n c₃ c₁ hn0 α β x₁ x₂).mp (hall x₁ x₂)
  refine Or.inr ⟨i, j, hne, (mem_meetingOrbit_iff n c₃ c₁ hn0 i j).mp hmem, hi0, hi1, hj, h12,
    (cone_of_bound hα hcone).1, (cone_of_bound hα hcone).2, ?_, ?_⟩
  · intro k l hkl h1 h2 h3 hkl'
    exact hmin k l hkl h1 h2 h3 ((mem_meetingOrbit_iff n c₃ c₁ hn0 k l).mpr hkl')
  · intro hi hj0
    -- `1/β < n` and `βn < n`, so both coordinates are below `n`
    have hβn : 1 < β * n := by nlinarith
    have hin : i.natAbs < n := by
      have h1 : (i : ℝ) < n := by
        have : 1 / β < n := by rw [div_lt_iff₀ hβ]; linarith
        linarith
      have h2 : ((i.natAbs : ℤ) : ℝ) < n := by
        rw [Int.natAbs_of_nonneg hi0]; exact h1
      exact_mod_cast h2
    have hjn : j.natAbs < n := by
      have h1 : |(j : ℝ)| < n := by nlinarith
      have h2 : ((j.natAbs : ℕ) : ℝ) < n := by rw [Nat.cast_natAbs]; exact_mod_cast h1
      exact_mod_cast h2
    exact order_bound_of_minimal n hn _ (card_meetingOrbit n c₃ c₁ hn hg) i j hi hj0 hin hjn hmin

/-! ## 8. BHK's constants: the box `2/3 × 2/9`, `n ≥ 7` -/

/-- A reading in `[0, 1)` within `L` of `c` forward (with `c + L < 1`) lies in `[c, c + L]`. -/
theorem window_of_fract (ρ c L : ℝ) (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1)
    (hc : 0 ≤ c) (hcL : c + L < 1) (h : Int.fract (ρ - c) ≤ L) :
    c ≤ ρ ∧ ρ ≤ c + L := by
  have hL0 : 0 ≤ L := le_trans (Int.fract_nonneg _) h
  by_cases hge : c ≤ ρ
  · rw [Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩] at h
    exact ⟨hge, by linarith⟩
  · exfalso
    have hlt : ρ < c := not_le.mp hge
    have hin : Int.fract (ρ - c) = ρ - c + 1 := by
      rw [← Int.fract_add_one, Int.fract_eq_self.mpr ⟨by linarith, by linarith⟩]
    rw [hin] at h
    linarith

/-- **BHK §7's form.**  With `gcd(n, c₃, c₁) = 1` and `n ≥ 7`: either some meeting time `k < n`
lands in BHK's box `R = [1/6, 5/6] × [7/18, 11/18]`, read in whole numbers as
`n ≤ 6·r₃ ≤ 5n` and `7n ≤ 18·r₁ ≤ 11n` for `r = (c·k) % n`; or the orbit has a short step
`(i, j)` with `0 ≤ i ≤ 4`, `|6j| < 9 + 2i`, `9|j| ≤ 2n`, BHK (12) at `(2/3, 2/9)`, minimal, and
Lemma 7's order bound off the axes. -/
theorem orbit_isolation_two_bhk (n c₃ c₁ : ℕ) (hn7 : 7 ≤ n)
    (hg : Nat.gcd n (Nat.gcd c₃ c₁) = 1) :
    (∃ k : ℕ, k < n ∧ n ≤ 6 * ((c₃ * k) % n) ∧ 6 * ((c₃ * k) % n) ≤ 5 * n ∧
      7 * n ≤ 18 * ((c₁ * k) % n) ∧ 18 * ((c₁ * k) % n) ≤ 11 * n) ∨
    ∃ i j : ℤ, (i, j) ≠ (0, 0) ∧ OnOrbit n c₃ c₁ i j ∧
      0 ≤ i ∧ i ≤ 4 ∧ -(9 + 2 * i) < 6 * j ∧ 6 * j < 9 + 2 * i ∧ 9 * |j| ≤ 2 * n ∧
      2 / 9 * |(i : ℝ)| + 2 / 3 * |(j : ℝ)| - 2 / n * |(i : ℝ)| * |(j : ℝ)| < 1 ∧
      MinimalOnOrbit n c₃ c₁ i j ∧
      (i ≠ 0 → j ≠ 0 → (i.natAbs + 1) * (j.natAbs + 1) - 2 ≤ n) := by
  have hn0 : 0 < n := by omega
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn0
  have h7 : (7 : ℝ) ≤ n := by exact_mod_cast hn7
  rcases orbit_isolation_two n c₃ c₁ (by omega) hg (2 / 3) (2 / 9) (by norm_num) (by norm_num)
      (by norm_num) (by norm_num) (by nlinarith) with
    hall | ⟨i, j, hne, hon, hi0, hi1, hj, h12, hc1, hc2, hmin, hl7⟩
  · left
    obtain ⟨k, hk, hu, hv⟩ := hall (1 / 6) (7 / 18)
    have hread : ∀ c : ℕ, 0 ≤ (((c * k) % n : ℕ) : ℝ) / n ∧ (((c * k) % n : ℕ) : ℝ) / n < 1 :=
      fun c => ⟨by positivity, by
        rw [div_lt_one hnR]; exact_mod_cast Nat.mod_lt _ hn0⟩
    obtain ⟨hu1, hu2⟩ := window_of_fract _ _ _ (hread c₃).1 (hread c₃).2 (by norm_num)
      (by norm_num) hu
    obtain ⟨hv1, hv2⟩ := window_of_fract _ _ _ (hread c₁).1 (hread c₁).2 (by norm_num)
      (by norm_num) hv
    rw [le_div_iff₀ hnR] at hu1 hv1
    rw [div_le_iff₀ hnR] at hu2 hv2
    refine ⟨k, hk, ?_, ?_, ?_, ?_⟩
    · have : (n : ℝ) ≤ 6 * (((c₃ * k) % n : ℕ) : ℝ) := by linarith
      exact_mod_cast this
    · have : 6 * (((c₃ * k) % n : ℕ) : ℝ) ≤ 5 * n := by linarith
      exact_mod_cast this
    · have : 7 * (n : ℝ) ≤ 18 * (((c₁ * k) % n : ℕ) : ℝ) := by linarith
      exact_mod_cast this
    · have : 18 * (((c₁ * k) % n : ℕ) : ℝ) ≤ 11 * n := by linarith
      exact_mod_cast this
  · right
    refine ⟨i, j, hne, hon, hi0, ?_, ?_, ?_, ?_, h12, hmin, hl7⟩
    · have : (i : ℝ) < 5 := by norm_num at hi1; linarith
      exact_mod_cast (show i < 5 by exact_mod_cast this) |> Int.lt_add_one_iff.mp
    · have : -((9 : ℝ) + 2 * i) < 6 * j := by norm_num at hc1; linarith
      exact_mod_cast this
    · have : 6 * (j : ℝ) < 9 + 2 * i := by norm_num at hc2; linarith
      exact_mod_cast this
    · have : 9 * |(j : ℝ)| ≤ 2 * n := by linarith
      rw [← Int.cast_abs] at this
      exact_mod_cast this

end LRC.OrderSixN

