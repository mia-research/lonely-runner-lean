import LonelyRunner.LRC.Spec.TwoPinnerN
import LonelyRunner.LRC.Cascade.Arrangement

/-!
# The neighbourhood of the AP: deviations relocate the isolation, and every instant is named

2026-09-27.  The arithmetic progression `c + i` (`i = 0 … 7`) with every speed deviated by `|eᵢ| ≤ 1/32` of the gap.
Every runner is lonely at a named instant (`apT`, written down; `ap_nbhd_lonely`):

* an interior runner (`k = 1 … 6`): `1/(8 d)`, `d` the nearer of its two speed neighbours.  Every other reading lies
  between `d` and `7 d` (the ratio condition, Thm 4.8, read at the runner's own `d_min`);
* an end runner (`k = 0`, and `k = 7` mirrored), readings `r₁ < … < r₇`: the same, `1/(8 r₁)`, when `r₇ ≤ 7 r₁`;
  otherwise the class-7 instant `49/(8 r₇)`, where the far end sits exactly one eighth away and every other reading keeps
  its class-7 slot.

This is E43/E44's measurement made a theorem on an explicit region: around the AP the deviation only relocates the
isolation, between the class-1 instant and its mirror class 7, with the flank a circle neighbour of that class.  It is an
open set of shapes around the AP (every `|eᵢ| < 1/32`), the first proved piece of the shape space's middle.  Checked
beforehand on 26,561 deviation vectors including every corner (`experiments/nN/redo/ap_nbhd_named_v1.out`); the 56
(runner, reading) cases are generated by `gen_ap_nbhd_lean_v1.py`.  No `sorry`, no `native_decide`.
-/

set_option linter.style.longLine false

namespace LRC.APNbhd

open Arrangement

/-- The arrangement: the AP `c + i` plus deviations. -/
noncomputable def apV (c : ℝ) (e : ℕ → ℝ) (i : Fin 8) : ℝ := c + ((i : ℕ) : ℝ) + e (i : ℕ)

/-- An end runner's instant: its own `d_min` bound, or the class-7 instant of its far end. -/
noncomputable def endT (a f : ℝ) : ℝ := if f ≤ 7 * a then 1 / (8 * a) else 49 / (8 * f)

/-- **The witness map.** -/
noncomputable def apT (e : ℕ → ℝ) : ℕ → ℝ
  | 0 => endT (1 + e 1 - e 0) (7 + e 7 - e 0)
  | 1 => 1 / (8 * min (1 + e 2 - e 1) (1 + e 1 - e 0))
  | 2 => 1 / (8 * min (1 + e 3 - e 2) (1 + e 2 - e 1))
  | 3 => 1 / (8 * min (1 + e 4 - e 3) (1 + e 3 - e 2))
  | 4 => 1 / (8 * min (1 + e 5 - e 4) (1 + e 4 - e 3))
  | 5 => 1 / (8 * min (1 + e 6 - e 5) (1 + e 5 - e 4))
  | 6 => 1 / (8 * min (1 + e 7 - e 6) (1 + e 6 - e 5))
  | 7 => endT (1 + e 7 - e 6) (7 + e 7 - e 0)
  | _ => 1

theorem clear_div {δ P D : ℝ} {N : ℤ} (hD : 0 < D) (h1 : ((N : ℝ) + 1 / 8) * D ≤ δ * P)
    (h2 : δ * P ≤ ((N : ℝ) + 7 / 8) * D) : (8 : ℝ)⁻¹ ≤ circDist (δ * (P / D)) := by
  rw [show δ * (P / D) = δ * P / D by ring]
  apply LRC.TwoPinner.clear_of_band (N := N)
  · rw [le_div_iff₀ hD]; linarith
  · rw [div_le_iff₀ hD]; linarith

/-- The ratio condition at the runner's own scale, a reading ahead. -/
theorem clear_R1_pos {δ m : ℝ} (hm : 0 < m) (h1 : m ≤ δ) (h2 : δ ≤ 7 * m) :
    (8 : ℝ)⁻¹ ≤ circDist (δ * (1 / (8 * m))) :=
  clear_div (N := 0) (by positivity) (by push_cast; nlinarith) (by push_cast; nlinarith)

/-- The ratio condition at the runner's own scale, a reading behind. -/
theorem clear_R1_neg {δ m : ℝ} (hm : 0 < m) (h1 : m ≤ -δ) (h2 : -δ ≤ 7 * m) :
    (8 : ℝ)⁻¹ ≤ circDist (δ * (1 / (8 * m))) :=
  clear_div (N := -1) (by positivity) (by push_cast; nlinarith) (by push_cast; nlinarith)

theorem c_0_1 (e : ℕ → ℝ) (hb : ∀ n, n < 8 → -(1 / 32 : ℝ) ≤ e n ∧ e n ≤ 1 / 32) :
    (8 : ℝ)⁻¹ ≤ circDist (((((1 : ℕ) : ℝ) - ((0 : ℕ) : ℝ) + e 1 - e 0)) * apT e 0) := by
  obtain ⟨b0l, b0u⟩ := hb 0 (by norm_num)
  obtain ⟨b1l, b1u⟩ := hb 1 (by norm_num)
  obtain ⟨b2l, b2u⟩ := hb 2 (by norm_num)
  obtain ⟨b3l, b3u⟩ := hb 3 (by norm_num)
  obtain ⟨b4l, b4u⟩ := hb 4 (by norm_num)
  obtain ⟨b5l, b5u⟩ := hb 5 (by norm_num)
  obtain ⟨b6l, b6u⟩ := hb 6 (by norm_num)
  obtain ⟨b7l, b7u⟩ := hb 7 (by norm_num)
  simp only [apT]
  push_cast
  unfold endT
  split_ifs with hcase
  · exact clear_R1_pos (by linarith) (by linarith) (by linarith)
  · exact clear_div (N := 0) (by linarith) (by push_cast; nlinarith) (by push_cast; nlinarith)

