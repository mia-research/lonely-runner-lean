theorem ap_nbhd_readings (e : ℕ → ℝ) (hb : ∀ n, n < 8 → -(1 / 32 : ℝ) ≤ e n ∧ e n ≤ 1 / 32)
    (k i : ℕ) (hk : k < 8) (hi : i < 8) (hik : i ≠ k) :
    (8 : ℝ)⁻¹ ≤ circDist ((((i : ℕ) : ℝ) - ((k : ℕ) : ℝ) + e i - e k) * apT e k) := by
  interval_cases k <;> interval_cases i <;> first | exact absurd rfl hik | exact c_0_1 e hb | exact c_0_2 e hb | exact c_0_3 e hb | exact c_0_4 e hb | exact c_0_5 e hb | exact c_0_6 e hb | exact c_0_7 e hb | exact c_1_0 e hb | exact c_1_2 e hb | exact c_1_3 e hb | exact c_1_4 e hb | exact c_1_5 e hb | exact c_1_6 e hb | exact c_1_7 e hb | exact c_2_0 e hb | exact c_2_1 e hb | exact c_2_3 e hb | exact c_2_4 e hb | exact c_2_5 e hb | exact c_2_6 e hb | exact c_2_7 e hb | exact c_3_0 e hb | exact c_3_1 e hb | exact c_3_2 e hb | exact c_3_4 e hb | exact c_3_5 e hb | exact c_3_6 e hb | exact c_3_7 e hb | exact c_4_0 e hb | exact c_4_1 e hb | exact c_4_2 e hb | exact c_4_3 e hb | exact c_4_5 e hb | exact c_4_6 e hb | exact c_4_7 e hb | exact c_5_0 e hb | exact c_5_1 e hb | exact c_5_2 e hb | exact c_5_3 e hb | exact c_5_4 e hb | exact c_5_6 e hb | exact c_5_7 e hb | exact c_6_0 e hb | exact c_6_1 e hb | exact c_6_2 e hb | exact c_6_3 e hb | exact c_6_4 e hb | exact c_6_5 e hb | exact c_6_7 e hb | exact c_7_0 e hb | exact c_7_1 e hb | exact c_7_2 e hb | exact c_7_3 e hb | exact c_7_4 e hb | exact c_7_5 e hb | exact c_7_6 e hb

/-- **Every runner of the deviated AP is lonely at its named instant.** -/
theorem ap_nbhd_lonely (c : ℝ) (e : ℕ → ℝ) (he : ∀ n, n < 8 → |e n| ≤ 1 / 32) (k : Fin 8) :
    LonelyAt (apV c e) k (apT e k) := by
  have hb : ∀ n, n < 8 → -(1 / 32 : ℝ) ≤ e n ∧ e n ≤ 1 / 32 := fun n hn => abs_le.mp (he n hn)
  intro i hi
  have hik : (i : ℕ) ≠ (k : ℕ) := fun h => hi (Fin.ext h)
  have := ap_nbhd_readings e hb k i k.isLt i.isLt hik
  rw [sep_eq]
  unfold apV
  convert this using 2
  ring

/-- The arrangement is an arrangement: eight distinct speeds, all positive when `c ≥ 1`. -/
theorem apV_injective (c : ℝ) (e : ℕ → ℝ) (he : ∀ n, n < 8 → |e n| ≤ 1 / 32) :
    Function.Injective (apV c e) := by
  intro i j h
  unfold apV at h
  have hi := abs_le.mp (he i i.isLt); have hj := abs_le.mp (he j j.isLt)
  by_contra hne
  have hne' : (i : ℕ) ≠ (j : ℕ) := fun h' => hne (Fin.ext h')
  rcases lt_or_gt_of_ne hne' with hlt | hgt
  · have : ((i : ℕ) : ℝ) + 1 ≤ ((j : ℕ) : ℝ) := by exact_mod_cast hlt
    linarith
  · have : ((j : ℕ) : ℝ) + 1 ≤ ((i : ℕ) : ℝ) := by exact_mod_cast hgt
    linarith

theorem apV_pos (c : ℝ) (hc : 1 ≤ c) (e : ℕ → ℝ) (he : ∀ n, n < 8 → |e n| ≤ 1 / 32) (i : Fin 8) :
    0 < apV c e i := by
  unfold apV
  have := abs_le.mp (he i i.isLt)
  have : (0 : ℝ) ≤ ((i : ℕ) : ℝ) := by positivity
  linarith

theorem apT_pos (e : ℕ → ℝ) (he : ∀ n, n < 8 → |e n| ≤ 1 / 32) (k : Fin 8) : 0 < apT e k := by
  have hb : ∀ n, n < 8 → -(1 / 32 : ℝ) ≤ e n ∧ e n ≤ 1 / 32 := fun n hn => abs_le.mp (he n hn)
  obtain ⟨b0l, b0u⟩ := hb 0 (by norm_num)
  obtain ⟨b1l, b1u⟩ := hb 1 (by norm_num)
  obtain ⟨b2l, b2u⟩ := hb 2 (by norm_num)
  obtain ⟨b3l, b3u⟩ := hb 3 (by norm_num)
  obtain ⟨b4l, b4u⟩ := hb 4 (by norm_num)
  obtain ⟨b5l, b5u⟩ := hb 5 (by norm_num)
  obtain ⟨b6l, b6u⟩ := hb 6 (by norm_num)
  obtain ⟨b7l, b7u⟩ := hb 7 (by norm_num)
  obtain ⟨k, hk⟩ := k
  simp only
  interval_cases k <;> simp only [apT, endT] <;> (try split_ifs) <;>
    first
      | (apply div_pos (by norm_num); apply mul_pos (by norm_num); apply lt_min <;> linarith)
      | (apply div_pos (by norm_num); linarith)

/-- **As existence**: every runner of every arrangement in the AP's `1/32`-neighbourhood has a positive lonely instant. -/
theorem ap_nbhd_exists (c : ℝ) (e : ℕ → ℝ) (he : ∀ n, n < 8 → |e n| ≤ 1 / 32) (k : Fin 8) :
    ∃ t : ℝ, 0 < t ∧ LonelyAt (apV c e) k t :=
  ⟨apT e k, apT_pos e he k, ap_nbhd_lonely c e he k⟩

