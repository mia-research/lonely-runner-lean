    rw [show (8 * (m : ℝ)) * (25 / 56) = (((((25 * m : ℕ)) : ℤ)) : ℝ) / (((7 : ℕ)) : ℝ) by push_cast; ring]
    refine le_trans ?_ this
    norm_num

