  split_ifs with hd
  · obtain ⟨q, rfl⟩ := hd
    have hq : (0 : ℝ) < q := by exact_mod_cast (show 0 < q by omega)
    have e : (8 * (((7 * q : ℕ)) : ℝ)) * (25 / 56 + 1 / (64 * (((7 * q : ℕ)) : ℝ)))
        = (((25 * q : ℕ)) : ℝ) + 1 / 8 := by
