theorem end_reading (cc m : ℕ) (hc1 : 1 ≤ cc) (hc6 : cc ≤ 6) (hm : 1 ≤ m) (a : ℤ) (ha1 : 1 ≤ a)
    (ha7 : a ≤ 7) (hac : a ≠ (cc : ℤ)) : (8 : ℝ)⁻¹ ≤ circDist ((a : ℝ) * homeEndT cc m) := by
  interval_cases cc <;> interval_cases a <;>
    first | (exact absurd rfl hac) | exact end_1_2 m hm _ rfl | exact end_1_3 m hm _ rfl | exact end_1_4 m hm _ rfl | exact end_1_5 m hm _ rfl | exact end_1_6 m hm _ rfl | exact end_1_7 m hm _ rfl | exact end_2_1 m hm _ rfl | exact end_2_3 m hm _ rfl | exact end_2_4 m hm _ rfl | exact end_2_5 m hm _ rfl | exact end_2_6 m hm _ rfl | exact end_2_7 m hm _ rfl | exact end_3_1 m hm _ rfl | exact end_3_2 m hm _ rfl | exact end_3_4 m hm _ rfl | exact end_3_5 m hm _ rfl | exact end_3_6 m hm _ rfl | exact end_3_7 m hm _ rfl | exact end_4_1 m hm _ rfl | exact end_4_2 m hm _ rfl | exact end_4_3 m hm _ rfl | exact end_4_5 m hm _ rfl | exact end_4_6 m hm _ rfl | exact end_4_7 m hm _ rfl | exact end_5_1 m hm _ rfl | exact end_5_2 m hm _ rfl | exact end_5_3 m hm _ rfl | exact end_5_4 m hm _ rfl | exact end_5_6 m hm _ rfl | exact end_5_7 m hm _ rfl | exact end_6_1 m hm _ rfl | exact end_6_2 m hm _ rfl | exact end_6_3 m hm _ rfl | exact end_6_4 m hm _ rfl | exact end_6_5 m hm _ rfl | exact end_6_7 m hm _ rfl

theorem end_partner (cc m : ℕ) (hc1 : 1 ≤ cc) (hc6 : cc ≤ 6) (hm : 1 ≤ m) :
    (8 : ℝ)⁻¹ ≤ circDist ((8 * (m : ℝ)) * homeEndT cc m) := by
  interval_cases cc <;> first | exact endp_1 hm | exact endp_2 hm | exact endp_3 hm | exact endp_4 hm | exact endp_5 hm | exact endp_6 hm

theorem far_reading (r : ℕ) (hr1 : 1 ≤ r) (hr7 : r ≤ 7) (a : ℤ) (hlo : -8 ≤ a) (hhi : a ≤ -1)
    (har : a ≠ (r : ℤ) - 8) : (8 : ℝ)⁻¹ ≤ circDist ((a : ℝ) * farEx r) := by
  interval_cases r <;> interval_cases a <;>
    first | (exact absurd rfl har) | exact fx_1_8 _ rfl | exact fx_1_6 _ rfl | exact fx_1_5 _ rfl | exact fx_1_4 _ rfl | exact fx_1_3 _ rfl | exact fx_1_2 _ rfl | exact fx_1_1 _ rfl | exact fx_2_8 _ rfl | exact fx_2_7 _ rfl | exact fx_2_5 _ rfl | exact fx_2_4 _ rfl | exact fx_2_3 _ rfl | exact fx_2_2 _ rfl | exact fx_2_1 _ rfl | exact fx_3_8 _ rfl | exact fx_3_7 _ rfl | exact fx_3_6 _ rfl | exact fx_3_4 _ rfl | exact fx_3_3 _ rfl | exact fx_3_2 _ rfl | exact fx_3_1 _ rfl | exact fx_4_8 _ rfl | exact fx_4_7 _ rfl | exact fx_4_6 _ rfl | exact fx_4_5 _ rfl | exact fx_4_3 _ rfl | exact fx_4_2 _ rfl | exact fx_4_1 _ rfl | exact fx_5_8 _ rfl | exact fx_5_7 _ rfl | exact fx_5_6 _ rfl | exact fx_5_5 _ rfl | exact fx_5_4 _ rfl | exact fx_5_2 _ rfl | exact fx_5_1 _ rfl | exact fx_6_8 _ rfl | exact fx_6_7 _ rfl | exact fx_6_6 _ rfl | exact fx_6_5 _ rfl | exact fx_6_4 _ rfl | exact fx_6_3 _ rfl | exact fx_6_1 _ rfl | exact fx_7_8 _ rfl | exact fx_7_7 _ rfl | exact fx_7_6 _ rfl | exact fx_7_5 _ rfl | exact fx_7_4 _ rfl | exact fx_7_3 _ rfl | exact fx_7_2 _ rfl

/-- **Every runner of every member of the family is lonely at its named instant.** -/
theorem ds_lonely (s r m : ℕ) (hs : s < 8) (hr : r < 8) (hsr : s ≠ r) (hm : 1 ≤ m) (k : Fin 8) :
    LonelyAt (dsV s r m) k (dsT s r m k) := by
  apply lonely_of_readings
  intro i hik
  have hi8 := i.isLt
  have hk8 := k.isLt
  have hik' : (i : ℕ) ≠ (k : ℕ) := fun h => hik (Fin.ext h)
  unfold dsT
  by_cases hkr : (k : ℕ) = r
  · -- the far member
    rw [if_pos hkr]
    have hir : (i : ℕ) ≠ r := fun h => hik' (h.trans hkr.symm)
    have hD : dsZ s r m i - dsZ s r m k = ((i : ℕ) : ℤ) - (s + 8 * m) := by
      simp only [dsZ, if_neg hir, if_pos hkr]
    rw [hD]
    unfold farT
    by_cases h49 : 49 ≤ 48 * m + 6 * s
    · rw [if_pos h49]
      exact clear_far h49 (by push_cast; omega) (by push_cast; omega)
    · rw [if_neg h49]
      have hm1 : m = 1 := by omega
      have hs0 : s = 0 := by omega
      subst hm1 hs0
      have := far_reading r (by omega) (by omega) (((i : ℕ) : ℤ) - (0 + 8 * 1)) (by omega) (by omega)
        (by push_cast; omega)
      simpa using this
  · rw [if_neg hkr]
    by_cases hks : (k : ℕ) = s
    · rw [if_pos hks]
      unfold homeT
      by_cases hir : (i : ℕ) = r
      · -- the partner
        have hD : dsZ s r m i - dsZ s r m k = 8 * m := by
          simp only [dsZ, if_pos hir, if_neg hkr]; rw [hks]; ring
        rw [hD]
        push_cast
        split_ifs with hint hs0
        · exact clear_partner_stretch hm
        · exact end_partner _ m (by omega) (by omega) hm
        · exact end_partner _ m (by omega) (by omega) hm
      · have hD : dsZ s r m i - dsZ s r m k = ((i : ℕ) : ℤ) - s := by
          simp only [dsZ, if_neg hir]; rw [hks, if_neg hsr]
        rw [hD]
        split_ifs with hint hs0
        · rcases lt_or_gt_of_ne (show ((i : ℕ) : ℤ) - s ≠ 0 by omega) with hneg | hpos
          · exact clear_stretch_neg (by omega) (by omega) hm
          · exact clear_stretch_pos (by omega) (by omega) hm
        · -- s = 0: the reading is the slot itself
          exact end_reading r m (by omega) (by omega) hm _ (by omega) (by omega) (by omega)
        · -- s = 7: the mirror
          have := end_reading (7 - r) m (by omega) (by omega) hm (7 - ((i : ℕ) : ℤ)) (by omega) (by omega)
            (by push_cast; omega)
          have e : ((((i : ℕ) : ℤ) - (s : ℤ) : ℤ) : ℝ) * homeEndT (7 - r) m
              = -(((7 - ((i : ℕ) : ℤ) : ℤ) : ℝ) * homeEndT (7 - r) m) := by
            have : (s : ℝ) = 7 := by exact_mod_cast (show s = 7 by omega)
            push_cast; rw [this]; ring
          rw [e, circDist_neg_ds]
          exact this
    · -- outside the doubled slot: the grid instant
      rw [if_neg hks]
      apply clear_grid
      simp only [dsZ, if_neg hkr]
      split_ifs <;> omega

/-- **The exhibit, as existence**: every runner of every member of the family has a positive lonely instant. -/
theorem ds_exists (s r m : ℕ) (hs : s < 8) (hr : r < 8) (hsr : s ≠ r) (hm : 1 ≤ m) (k : Fin 8) :
    ∃ t : ℝ, 0 < t ∧ LonelyAt (dsV s r m) k t := by
  refine ⟨dsT s r m k, ?_, ds_lonely s r m hs hr hsr hm k⟩
  have hmR : (1 : ℝ) ≤ m := by exact_mod_cast hm
  unfold dsT farT homeT homeEndT farEx
  split_ifs <;> first
    | positivity
    | (have : (1 : ℝ) ≤ ((8 * m + s : ℕ) : ℝ) - 7 := by
          have : ((49 : ℕ) : ℝ) ≤ ((48 * m + 6 * s : ℕ) : ℝ) := by exact_mod_cast (by assumption)
          push_cast at this ⊢; linarith
       positivity)

