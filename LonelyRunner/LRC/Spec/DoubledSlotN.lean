import LonelyRunner.LRC.Spec.TwoPinnerN
import LonelyRunner.LRC.Cascade.Arrangement
import LonelyRunner.LRC.ConstructionN.LemmaPass

/-!
# Two runners in one slot: the doubled-slot family, exhibited

2026-09-27.  The author's one hard case: two runners in a slot.  Read as a grid (residues mod 8), at a grid instant a
runner is clear unless another runner shares its own slot, so a doubled slot delays only the two runners in it.

**The family.**  Runners indexed by slot `i = 0 … 7`; runner `i` has speed `100 + i`, except the runner of slot `r`,
moved by whole laps into slot `s`: speed `100 + s + 8m`.  Slot `s` is doubled (the pair `8m` apart), slot `r` empty.
Every speed is positive and all eight are distinct (`dsV_injective`).

**The exhibit** (`dsT`, written down; `ds_lonely`, the theorem that it works):
* a runner outside the doubled slot: the grid instant `1/8`;
* the far member of the pair: `1/(8(8m + s − 7))`, where every reading lies in the band `[1/8, 7/8]`
  (`49 ≤ 48m + 6s`), else (`s = 0, m = 1`) one of seven named instants;
* the home member at an interior slot (or at an end whose far neighbour is the missing runner): the grid instant
  stretched by the partner's own opening, `1/8 + 1/(64m)`;
* the home member at an end of the progression: `(8N+1)/(8d)` set by the empty slot (`homeEndT`), plus `1/(64m)` when
  the partner would otherwise read a whole number of laps.

`m` enters only through divisibility, so the family is a finite case split with every instant named.  The constant
cases are generated by `experiments/nN/redo/gen_doubled_slot_lean_v2.py`, which checks each band exactly before
emitting it; Lean re-checks every one.  Checked beforehand on every runner for `m = 1 … 400`
(`experiments/nN/redo/doubled_slot_named_v2.out`).  No `sorry`, no `native_decide`.
-/

set_option linter.style.longLine false
set_option maxHeartbeats 1000000

namespace LRC.DoubledSlot

open Arrangement

/-- Whole-number speeds (before the common `+100`), indexed by slot. -/
def dsZ (s r m : ℕ) (i : Fin 8) : ℤ := if (i : ℕ) = r then (s : ℤ) + 8 * m else ((i : ℕ) : ℤ)

/-- The arrangement: every speed positive. -/
noncomputable def dsV (s r m : ℕ) (i : Fin 8) : ℝ := 100 + (dsZ s r m i : ℝ)

/-- The home member's instant at an end of the progression, by the empty slot's offset `cc`. -/
noncomputable def homeEndT (cc m : ℕ) : ℝ :=
  if cc = 1 then (if 2 ∣ m then 1 / 16 + 1 / (64 * (m : ℝ)) else 1 / 16)
  else if cc = 2 then (if 7 ∣ m then 25 / 56 + 1 / (64 * (m : ℝ)) else 25 / 56)
  else if cc = 3 then (if 7 ∣ m then 17 / 56 + 1 / (64 * (m : ℝ)) else 17 / 56)
  else if cc = 4 then (if 5 ∣ m then 9 / 40 + 1 / (64 * (m : ℝ)) else 9 / 40)
  else if cc = 5 then (if 2 ∣ m then 3 / 16 + 1 / (64 * (m : ℝ)) else 3 / 16)
  else (if 7 ∣ m then 9 / 56 + 1 / (64 * (m : ℝ)) else 9 / 56)

/-- The far member's instant when `s = 0, m = 1`. -/
noncomputable def farEx (r : ℕ) : ℝ :=
  if r = 1 then 9 / 64 else if r = 2 then 9 / 56 else if r = 3 then 3 / 16 else if r = 4 then 9 / 40
  else if r = 5 then 17 / 56 else if r = 6 then 25 / 56 else 1 / 16

noncomputable def homeT (s r m : ℕ) : ℝ :=
  if (1 ≤ s ∧ s ≤ 6) ∨ (s = 0 ∧ r = 7) ∨ (s = 7 ∧ r = 0) then 1 / 8 + 1 / (64 * (m : ℝ))
  else homeEndT (if s = 0 then r else 7 - r) m

noncomputable def farT (s r m : ℕ) : ℝ :=
  if 49 ≤ 48 * m + 6 * s then 1 / (8 * (((8 * m + s : ℕ) : ℝ) - 7)) else farEx r

/-- **The witness map**: a named instant for every runner of every member of the family. -/
noncomputable def dsT (s r m : ℕ) (k : Fin 8) : ℝ :=
  if (k : ℕ) = r then farT s r m else if (k : ℕ) = s then homeT s r m else 1 / 8

theorem dsV_injective {s r m : ℕ} (hs : s < 8) (hr : r < 8) (hsr : s ≠ r) (hm : 1 ≤ m) :
    Function.Injective (dsV s r m) := by
  intro i j h
  have h' : dsZ s r m i = dsZ s r m j := by
    unfold dsV at h; exact_mod_cast (add_left_cancel h)
  apply Fin.ext
  have hi := i.isLt; have hj := j.isLt
  unfold dsZ at h'
  split_ifs at h' <;> omega

theorem circDist_neg_ds (x : ℝ) : circDist (-x) = circDist x := by
  unfold circDist
  rcases eq_or_ne (Int.fract x) 0 with h | h
  · rw [h, Int.fract_neg_eq_zero.mpr h]
  · rw [Int.fract_neg h, min_comm]
    congr 1 <;> ring

theorem lonely_of_readings {s r m : ℕ} {k : Fin 8} {t : ℝ}
    (h : ∀ i : Fin 8, i ≠ k → (8 : ℝ)⁻¹ ≤ circDist (((dsZ s r m i - dsZ s r m k : ℤ) : ℝ) * t)) :
    LonelyAt (dsV s r m) k t := by
  intro i hi
  have := h i hi
  rw [sep_eq]
  unfold dsV
  push_cast at this ⊢
  convert this using 2
  ring

/-- **The grid instant.**  A whole-number difference not divisible by 8 is clear at `1/8`. -/
theorem clear_grid {D : ℤ} (h : ¬ (8 : ℤ) ∣ D) : (8 : ℝ)⁻¹ ≤ circDist ((D : ℝ) * (1 / 8)) := by
  have h' : ¬ ((8 : ℕ) : ℤ) ∣ D := by exact_mod_cast h
  have := ConstructionN.circDist_int_div (n := 8) (by norm_num) h'
  rw [show (D : ℝ) * (1 / 8) = (D : ℝ) / ((8 : ℕ) : ℝ) by push_cast; ring]
  simpa using this

/-- **The stretched grid instant**, a reading of size 1 to 6. -/
theorem clear_stretch_pos {a : ℤ} (ha1 : 1 ≤ a) (ha6 : a ≤ 6) {m : ℕ} (hm : 1 ≤ m) :
    (8 : ℝ)⁻¹ ≤ circDist ((a : ℝ) * (1 / 8 + 1 / (64 * (m : ℝ)))) := by
  have hA1 : (1 : ℝ) ≤ a := by exact_mod_cast ha1
  have hA6 : (a : ℝ) ≤ 6 := by exact_mod_cast ha6
  have hmR : (1 : ℝ) ≤ m := by exact_mod_cast hm
  have h0 : (0 : ℝ) < 1 / (64 * (m : ℝ)) := by positivity
  have h1 : 1 / (64 * (m : ℝ)) ≤ 1 / 64 := one_div_le_one_div_of_le (by norm_num) (by linarith)
  have hp : (0 : ℝ) ≤ (a : ℝ) * (1 / (64 * (m : ℝ))) := by positivity
  have hq : (a : ℝ) * (1 / (64 * (m : ℝ))) ≤ 6 * (1 / 64) := mul_le_mul hA6 h1 h0.le (by norm_num)
  apply LRC.TwoPinner.clear_of_band (N := 0)
  · push_cast; nlinarith
  · push_cast; nlinarith

theorem clear_stretch_neg {a : ℤ} (ha1 : a ≤ -1) (ha6 : -6 ≤ a) {m : ℕ} (hm : 1 ≤ m) :
    (8 : ℝ)⁻¹ ≤ circDist ((a : ℝ) * (1 / 8 + 1 / (64 * (m : ℝ)))) := by
  have := clear_stretch_pos (a := -a) (by omega) (by omega) hm
  rw [show ((-a : ℤ) : ℝ) * (1 / 8 + 1 / (64 * (m : ℝ)))
      = -((a : ℝ) * (1 / 8 + 1 / (64 * (m : ℝ)))) by push_cast; ring, circDist_neg_ds] at this
  exact this

/-- **The partner at the stretched instant** sits exactly one eighth ahead. -/
theorem clear_partner_stretch {m : ℕ} (hm : 1 ≤ m) :
    (8 : ℝ)⁻¹ ≤ circDist ((8 * (m : ℝ)) * (1 / 8 + 1 / (64 * (m : ℝ)))) := by
  have hmR : (0 : ℝ) < m := by exact_mod_cast (show 0 < m by omega)
  have e : (8 * (m : ℝ)) * (1 / 8 + 1 / (64 * (m : ℝ))) = (m : ℝ) + 1 / 8 := by
    field_simp; ring
  rw [e]
  apply LRC.TwoPinner.clear_of_band (N := (m : ℤ)) <;> push_cast <;> linarith

/-- **The far member**: every reading in the band `[1/8, 7/8]` at `1/(8(W − 7))`, `W = 8m + s`. -/
theorem clear_far {s m : ℕ} (h49 : 49 ≤ 48 * m + 6 * s) {D : ℤ}
    (hlo : -((8 * m + s : ℕ) : ℤ) ≤ D) (hhi : D ≤ -((8 * m + s : ℕ) : ℤ) + 7) :
    (8 : ℝ)⁻¹ ≤ circDist ((D : ℝ) * (1 / (8 * (((8 * m + s : ℕ) : ℝ) - 7)))) := by
  have h49' : ((49 : ℕ) : ℝ) ≤ ((48 * m + 6 * s : ℕ) : ℝ) := by exact_mod_cast h49
  have hlo' : -(((8 * m + s : ℕ) : ℤ) : ℝ) ≤ (D : ℝ) := by exact_mod_cast hlo
  have hhi' : (D : ℝ) ≤ -(((8 * m + s : ℕ) : ℤ) : ℝ) + 7 := by exact_mod_cast hhi
  push_cast at h49' hlo' hhi' ⊢
  have hL : (0 : ℝ) < 8 * ((8 * (m : ℝ) + s) - 7) := by linarith
  rw [show (D : ℝ) * (1 / (8 * ((8 * (m : ℝ) + s) - 7))) = (D : ℝ) / (8 * ((8 * (m : ℝ) + s) - 7)) by ring]
  apply LRC.TwoPinner.clear_of_band (N := -1)
  · rw [le_div_iff₀ hL]; push_cast; nlinarith
  · rw [div_le_iff₀ hL]; push_cast; nlinarith

theorem endp_1 {m : ℕ} (hm : 1 ≤ m) : (8 : ℝ)⁻¹ ≤ circDist ((8 * (m : ℝ)) * homeEndT 1 m) := by
  rw [homeEndT, if_pos rfl]
  split_ifs with hd
  · obtain ⟨q, rfl⟩ := hd
    have hq : (0 : ℝ) < q := by exact_mod_cast (show 0 < q by omega)
    have e : (8 * (((2 * q : ℕ)) : ℝ)) * (1 / 16 + 1 / (64 * (((2 * q : ℕ)) : ℝ)))
        = (((1 * q : ℕ)) : ℝ) + 1 / 8 := by
      push_cast; field_simp; ring
    rw [e]
    apply LRC.TwoPinner.clear_of_band (N := (((1 * q : ℕ)) : ℤ)) <;> push_cast <;> linarith
  · have hnd : ¬ ((2 : ℕ) : ℤ) ∣ (((1 * m : ℕ)) : ℤ) := by
      intro h; apply hd; omega
    have := ConstructionN.circDist_int_div (n := 2) (by norm_num) hnd
    rw [show (8 * (m : ℝ)) * (1 / 16) = (((((1 * m : ℕ)) : ℤ)) : ℝ) / (((2 : ℕ)) : ℝ) by push_cast; ring]
    refine le_trans ?_ this
    norm_num

