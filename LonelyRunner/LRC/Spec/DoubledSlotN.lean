theorem end_1_2 (m : ℕ) (hm : 1 ≤ m) (x : ℤ) (hx : x = 2) :
    (8 : ℝ)⁻¹ ≤ circDist ((x : ℝ) * homeEndT 1 m) := by
  subst hx
  rw [homeEndT, if_pos rfl]
  split_ifs with hd
  · have hmin : (2 : ℝ) ≤ m := by exact_mod_cast Nat.le_of_dvd (by omega) hd
    have h0 : (0 : ℝ) ≤ 1 / (64 * (m : ℝ)) := by positivity
    have h1 : 1 / (64 * (m : ℝ)) ≤ 1 / (64 * 2) :=
      one_div_le_one_div_of_le (by norm_num) (by linarith)
    apply LRC.TwoPinner.clear_of_band (N := 0) <;> push_cast <;> linarith
  · apply LRC.TwoPinner.clear_of_band (N := 0) <;> norm_num

