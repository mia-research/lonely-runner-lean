AUDIT PASS: no audited declaration reaches the difference-set form.
def LRC.Spec.LonelyRunnerAt8 : Prop :=
∀ (v : Fin 8 → ℝ),
  Function.Injective v → ∀ (k : Fin 8), ∃ t, 0 < t ∧ ∀ (i : Fin 8), i ≠ k → 8⁻¹ ≤ circDist (v i * t - v k * t)
def LRC.Spec.ExistenceOnArrangements : Prop :=
∀ (v : Fin 8 → ℝ), Function.Injective v → ∀ (k : Fin 8), ∃ t, 0 < t ∧ Arrangement.LonelyAt v k t
def Arrangement.LonelyAt : (Fin 8 → ℝ) → Fin 8 → ℝ → Prop :=
fun v k t => ∀ (i : Fin 8), i ≠ k → 8⁻¹ ≤ circDist (Arrangement.sep v k i t)
def LRC.Spec.LonelyForSubject : (Fin 8 → ℝ) → Fin 8 → Prop :=
fun v k => ∃ t, 0 < t ∧ Arrangement.LonelyAt v k t
def LRC.Spec.DoorFlank : (Fin 8 → ℝ) → Fin 8 → Prop :=
fun v k => ∃ i, i ≠ k ∧ ∃ j, Arrangement.LonelyAt v k (Flanks.flankOpening 8 |v i - v k| j)
def LRC.Spec.DoorArrives : (Fin 8 → ℝ) → Fin 8 → Prop :=
fun v k =>
  ∃ N,
    MomentIterationN.move 8 (Arrangement.diffSet v k)
        ((MomentIterationN.move 8 (Arrangement.diffSet v k))^[N] (LRC.Spec.firstReading v k)) =
      (MomentIterationN.move 8 (Arrangement.diffSet v k))^[N] (LRC.Spec.firstReading v k)
def LRC.Spec.DoorCapped : (Fin 8 → ℝ) → Fin 8 → Prop :=
fun v k => ∃ U, ∀ (N : ℕ), (MomentIterationN.move 8 (Arrangement.diffSet v k))^[N] (LRC.Spec.firstReading v k) ≤ U
def LRC.Spec.DoorFAM : (Fin 8 → ℝ) → Fin 8 → Prop :=
fun v k =>
  ∀ (i : Fin 8),
    i ≠ k →
      {j |
          MomentIterationN.inWay 8 |v i - v k|
            ((MomentIterationN.move 8 (Arrangement.diffSet v k))^[j] (LRC.Spec.firstReading v k))}.Finite
def LRC.Spec.DoorThreeLargest : (Fin 8 → ℝ) → Fin 8 → Prop :=
fun v k =>
  ∃ i,
    i ≠ k ∧
      {d ∈ Arrangement.diffSet v k | |v i - v k| < d}.card ≤ 2 ∧
        ∃ j, Arrangement.LonelyAt v k (Flanks.flankOpening 8 |v i - v k| j)
def Arrangement.diffSet : (Fin 8 → ℝ) → Fin 8 → Finset ℝ :=
fun v k => Finset.image (fun i => |v i - v k|) (Finset.univ.erase k)
def LRC.Spec.blockDegree : (Fin 8 → ℝ) → ℝ → Fin 8 → ℕ :=
fun v t k => {i | i ≠ k ∧ Arrangement.InWay v k i t}.card
def Arrangement.sep : (Fin 8 → ℝ) → Fin 8 → Fin 8 → ℝ → ℝ :=
fun v k i t => v i * t - v k * t
def Arrangement.InWay : (Fin 8 → ℝ) → Fin 8 → Fin 8 → ℝ → Prop :=
fun v k i t => circDist (Arrangement.sep v k i t) < 8⁻¹
def circDist : ℝ → ℝ :=
fun x => min (Int.fract x) (1 - Int.fract x)
def Flanks.flankOpening : ℕ → ℝ → ℕ → ℝ :=
fun n e k => (↑k + (↑n)⁻¹) / e
def LRC.Spec.leastDisp : (Fin 8 → ℝ) → Fin 8 → ℝ :=
fun v k => (Arrangement.diffSet v k).min' ⋯
def LRC.Spec.firstReading : (Fin 8 → ℝ) → Fin 8 → ℝ :=
fun v k => 1 / (8 * LRC.Spec.leastDisp v k)
def MomentIterationN.inWay : ℕ → ℝ → ℝ → Prop :=
fun n d t => circDist (d * t) < (↑n)⁻¹
def MomentIterationN.nextOpening : ℕ → ℝ → ℝ → ℝ :=
fun n d t => (↑⌈d * t - (↑n)⁻¹⌉ + (↑n)⁻¹) / d
def MomentIterationN.move : ℕ → Finset ℝ → ℝ → ℝ :=
fun n ds t =>
  Finset.fold max t (fun d => if MomentIterationN.inWay n d t then MomentIterationN.nextOpening n d t else t) ds
