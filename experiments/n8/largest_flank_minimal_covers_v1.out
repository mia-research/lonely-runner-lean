        ['1/12', '1/4', '5/12', '7/12', '2/3']
        ['1/12', '1/3', '5/12', '1/2', '7/12']
        ['1/12', '1/3', '5/12', '7/12', '3/4']
        ['1/12', '1/3', '1/2', '7/12', '5/6']
        ['1/12', '5/12', '1/2', '7/12', '2/3']
        ... 2 more

