open Classical

namespace Fresh.OneMover

open Fresh

/-- The frozen set [1, 2, 3, 4, 5] is clear on piece 0, `[1/8, 7/40]`. -/
theorem fpieceG12345_0 (s : ℝ) (h1 : (1/8 : ℝ) ≤ s) (h2 : s ≤ (7/40 : ℝ)) : FClear ({1, 2, 3, 4, 5} : Finset ℕ) s := by
  intro i hi
  simp only [Finset.mem_insert, Finset.mem_singleton] at hi
  rcases hi with rfl | rfl | rfl | rfl | rfl
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)

/-- Every instant in `[1/8, 7/40]` clear for the frozen set lies in a listed piece. [PROVISIONAL: covering] -/
theorem coverG12345 (s : ℝ) (h0 : (1/8 : ℝ) ≤ s) (hR : s ≤ (7/40 : ℝ)) (hF : FClear ({1, 2, 3, 4, 5} : Finset ℕ) s) :
    ((1/8 : ℝ) ≤ s ∧ s ≤ (7/40 : ℝ)) := by
  rcases le_or_gt s (7/40 : ℝ) with d0 | d0
  · exact ⟨h0, d0⟩
  exact absurd hR (not_le.2 d0)

/-- Some listed piece holds a clear point of the mover, for every ρ > 1.  [PROVISIONAL: counting tool] -/
theorem holdG12345_exists (ρ : ℝ) (hρ : (1 : ℝ) < ρ) :
    Holds ρ (1/8 : ℝ) (7/40 : ℝ) := by
  by_contra c0
  have hρ0 : 0 < ρ := by linarith
  have hw := not_holds_len hρ0 (by norm_num : (1/8 : ℝ) ≤ (7/40 : ℝ)) c0
  have hB : ρ < 6 := by nlinarith
  obtain ⟨N0, a0, b0⟩ := not_holds_win hρ0 c0
  have lo0 : (1 : ℤ) ≤ N0 := int_ge_of_real (by push_cast; nlinarith)
  have hi0 : N0 ≤ (0 : ℤ) := int_le_of_real (by push_cast; nlinarith)
  interval_cases N0 <;> (push_cast at *; linarith)

/-- The landing: the first piece the mover can hold, at its first clear point. -/
noncomputable def landG12345 (ρ : ℝ) : ℝ :=
  firstPt ρ (1/8 : ℝ)

/-- The landing is the first lonely instant, at least `1/8`, and the opening of a named runner: a frozen runner `(i, j)`
(it stands at exactly `1/8` past lap `j`) when the mover is clear at the left end of the holding piece, else the mover. -/
theorem landSpecG12345 (ρ : ℝ) (hρ : (1 : ℝ) < ρ) :
    IsFirst (insert ρ (fset ({1, 2, 3, 4, 5} : Finset ℕ))) (landG12345 ρ) ∧ (1/8 : ℝ) ≤ landG12345 ρ ∧
    (((Holds ρ (1/8 : ℝ) (7/40 : ℝ) ∧ (1/8 : ℝ) ≤ distInt (ρ * (1/8 : ℝ)) ∧ landG12345 ρ = (1/8 : ℝ) ∧ (1 : ℝ) * (1/8 : ℝ) = 0 + 1/8) ∨ (Holds ρ (1/8 : ℝ) (7/40 : ℝ) ∧ ¬ ((1/8 : ℝ) ≤ distInt (ρ * (1/8 : ℝ))) ∧ landG12345 ρ = (((round (ρ * (1/8 : ℝ)) : ℤ) : ℝ) + 1/8) / ρ))) := by
  have hρ0 : 0 < ρ := by linarith
  have hex := holdG12345_exists ρ hρ
  have hamem := mem_insertG (S := ({1, 2, 3, 4, 5} : Finset ℕ)) ρ (a := 1) (by decide)
  unfold landG12345 IsFirst
  have h0 : Holds ρ (1/8 : ℝ) (7/40 : ℝ) := hex
  obtain ⟨hc, hl, hr, hin⟩ := holds_clear hρ0 (by norm_num : (1/8 : ℝ) ≤ (7/40 : ℝ)) h0
  have hTpos : (1/8 : ℝ) ≤ firstPt ρ (1/8 : ℝ) := by linarith
  have hfz := fpieceG12345_0 _ hl hr
  refine ⟨⟨(lonely_insert_iffG ({1, 2, 3, 4, 5} : Finset ℕ) ρ _).2 ⟨hfz, hc⟩, ?_⟩, hTpos, ?_⟩
  · intro s hs hlon
    have hs8' := lonely_geG hamem (by norm_num) hs hlon
    have hs8 : (1/8 : ℝ) ≤ s := by norm_num at hs8' ⊢; linarith
    rw [lonely_insert_iffG] at hlon
    obtain ⟨hF, hm⟩ := hlon
    by_contra hlt
    push Not at hlt
    have hsR : s ≤ (7/40 : ℝ) := by linarith
    rcases coverG12345 s hs8 hsR hF with ⟨a0, b0⟩
    · exact absurd hm (not_le.2 (hin s a0 hlt))
  · by_cases hcl : (1/8 : ℝ) ≤ distInt (ρ * (1/8 : ℝ))
    · left; refine ⟨h0, hcl, ?_⟩
      have e : firstPt ρ (1/8 : ℝ) = (1/8 : ℝ) := by unfold firstPt; rw [if_pos hcl]
      exact ⟨e, by norm_num⟩
    · right; refine ⟨h0, hcl, ?_⟩
      unfold firstPt; rw [if_neg hcl]

theorem landingG12345 (ρ : ℝ) (hρ : (1 : ℝ) < ρ) :
    (∃ seq : ℕ → ℝ, seq 0 = 1 / (8 * (1 : ℝ)) ∧ (∀ n, IsMove (insert ρ (fset ({1, 2, 3, 4, 5} : Finset ℕ))) (seq n) (seq (n + 1))) ∧ ∃ N, seq (N + 1) = seq N) ∧
      ∀ seq : ℕ → ℝ, seq 0 = 1 / (8 * (1 : ℝ)) → (∀ n, IsMove (insert ρ (fset ({1, 2, 3, 4, 5} : Finset ℕ))) (seq n) (seq (n + 1))) →
        ∀ N, seq (N + 1) = seq N → seq N = landG12345 ρ := by
  obtain ⟨hf, hge, _⟩ := landSpecG12345 ρ hρ
  have hpos := pos_insertG (S := ({1, 2, 3, 4, 5} : Finset ℕ)) (by intro i hi; simp only [Finset.mem_insert, Finset.mem_singleton] at hi; rcases hi with rfl | rfl | rfl | rfl | rfl <;> norm_num) (ρ := ρ) (by linarith)
  have hamem := mem_insertG (S := ({1, 2, 3, 4, 5} : Finset ℕ)) ρ (a := 1) (by decide)
  have := cascade_landsG hpos hamem (T := landG12345 ρ) (lt_of_lt_of_le (by norm_num) hge) hf
  simpa using this

