  · exact clear_scaled 2 (by norm_num) h1 h2 (by norm_num) (by norm_num)

/-- No instant of `[0, 1/8)` is clear for the frozen set: the least reading is in the way. -/
theorem gapBL123_init (s : ℝ) (ha : 0 ≤ s) (hb : s < (1/8 : ℝ)) : ¬ FClear ({1, 2, 3} : Finset ℕ) s :=
  fnot ({1, 2, 3} : Finset ℕ) 1 (by decide) 0 s (by push_cast; linarith) (by push_cast; linarith)

/-- No instant of the open gap `(7/24, 3/8)` after period piece 0 is clear for the frozen set. -/
theorem gapBL123_0 (s : ℝ) (ha : (7/24 : ℝ) < s) (hb : s < (3/8 : ℝ)) : ¬ FClear ({1, 2, 3} : Finset ℕ) s := by
  exact fnot ({1, 2, 3} : Finset ℕ) 3 (by decide) 1 s (by push_cast; linarith) (by push_cast; linarith)

/-- No instant of the open gap `(7/16, 9/16)` after period piece 1 is clear for the frozen set. -/
theorem gapBL123_1 (s : ℝ) (ha : (7/16 : ℝ) < s) (hb : s < (9/16 : ℝ)) : ¬ FClear ({1, 2, 3} : Finset ℕ) s := by
  exact fnot ({1, 2, 3} : Finset ℕ) 2 (by decide) 1 s (by push_cast; linarith) (by push_cast; linarith)

/-- No instant of the open gap `(5/8, 17/24)` after period piece 2 is clear for the frozen set. -/
theorem gapBL123_2 (s : ℝ) (ha : (5/8 : ℝ) < s) (hb : s < (17/24 : ℝ)) : ¬ FClear ({1, 2, 3} : Finset ℕ) s := by
  exact fnot ({1, 2, 3} : Finset ℕ) 3 (by decide) 2 s (by push_cast; linarith) (by push_cast; linarith)

/-- No instant of the open gap `(7/8, 1)` after period piece 3 is clear for the frozen set. -/
theorem gapBL123_3 (s : ℝ) (ha : (7/8 : ℝ) < s) (hb : s < (1 : ℝ)) : ¬ FClear ({1, 2, 3} : Finset ℕ) s := by
  exact fnot ({1, 2, 3} : Finset ℕ) 1 (by decide) 1 s (by push_cast; linarith) (by push_cast; linarith)

/-- Every clear instant of one period lies in a listed piece. [PROVISIONAL: covering] -/
theorem coverBL123 (s : ℝ) (h0 : 0 ≤ s) (h1 : s < 1) (hF : FClear ({1, 2, 3} : Finset ℕ) s) :
    ((1/8 : ℝ) ≤ s ∧ s ≤ (7/24 : ℝ)) ∨ (((3/8 : ℝ) ≤ s ∧ s ≤ (7/16 : ℝ)) ∨ (((9/16 : ℝ) ≤ s ∧ s ≤ (5/8 : ℝ)) ∨ (((17/24 : ℝ) ≤ s ∧ s ≤ (7/8 : ℝ))))) := by
  rcases lt_or_ge s (1/8 : ℝ) with g_1 | dpre
  · exact absurd hF (gapBL123_init s h0 g_1)
  rcases le_or_gt s (7/24 : ℝ) with d0 | d0
  · left; exact ⟨dpre, d0⟩
  rcases lt_or_ge s (3/8 : ℝ) with g0 | d0g
  · exact absurd hF (gapBL123_0 s d0 g0)
  rcases le_or_gt s (7/16 : ℝ) with d1 | d1
  · right; left; exact ⟨d0g, d1⟩
  rcases lt_or_ge s (9/16 : ℝ) with g1 | d1g
  · exact absurd hF (gapBL123_1 s d1 g1)
  rcases le_or_gt s (5/8 : ℝ) with d2 | d2
  · right; right; left; exact ⟨d1g, d2⟩
  rcases lt_or_ge s (17/24 : ℝ) with g2 | d2g
  · exact absurd hF (gapBL123_2 s d2 g2)
  rcases le_or_gt s (7/8 : ℝ) with d3 | d3
  · right; right; right; exact ⟨d2g, d3⟩
  exact absurd hF (gapBL123_3 s d3 h1)

/-- The first frozen-lonely instant at or after `τ ∈ [0, 1)`, as an offset in `[0, 2)`. -/
noncomputable def nfoff123 (τ : ℝ) : ℝ :=
  if τ < (1/8 : ℝ) then (1/8 : ℝ) else if τ ≤ (7/24 : ℝ) then τ else if τ < (3/8 : ℝ) then (3/8 : ℝ) else if τ ≤ (7/16 : ℝ) then τ else if τ < (9/16 : ℝ) then (9/16 : ℝ) else if τ ≤ (5/8 : ℝ) then τ else if τ < (17/24 : ℝ) then (17/24 : ℝ) else if τ ≤ (7/8 : ℝ) then τ else (9/8 : ℝ)

theorem nfoff123_ge (τ : ℝ) (h1 : τ < 1) : τ ≤ nfoff123 τ := by
  unfold nfoff123
  by_cases c0 : τ < (1/8 : ℝ)
  · rw [if_pos c0]
    try linarith
  rw [if_neg c0]
  by_cases c1 : τ ≤ (7/24 : ℝ)
  · rw [if_pos c1]
    try linarith
  rw [if_neg c1]
  by_cases c2 : τ < (3/8 : ℝ)
  · rw [if_pos c2]
    try linarith
  rw [if_neg c2]
  by_cases c3 : τ ≤ (7/16 : ℝ)
  · rw [if_pos c3]
    try linarith
  rw [if_neg c3]
  by_cases c4 : τ < (9/16 : ℝ)
  · rw [if_pos c4]
    try linarith
  rw [if_neg c4]
  by_cases c5 : τ ≤ (5/8 : ℝ)
  · rw [if_pos c5]
    try linarith
  rw [if_neg c5]
  by_cases c6 : τ < (17/24 : ℝ)
  · rw [if_pos c6]
    try linarith
  rw [if_neg c6]
  by_cases c7 : τ ≤ (7/8 : ℝ)
  · rw [if_pos c7]
    try linarith
  rw [if_neg c7]
  try linarith

theorem nfoff123_gap (τ : ℝ) (h0 : 0 ≤ τ) (h1 : τ < 1) : nfoff123 τ - τ ≤ (1/4 : ℝ) := by
  unfold nfoff123
  by_cases c0 : τ < (1/8 : ℝ)
  · rw [if_pos c0]
    try linarith
  rw [if_neg c0]
  by_cases c1 : τ ≤ (7/24 : ℝ)
