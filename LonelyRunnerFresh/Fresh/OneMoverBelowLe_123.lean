  · exact clear_scaled 1 (by norm_num) h1 h2 (by norm_num) (by norm_num)

/-- The frozen set [1, 2, 3] is clear on the period piece 3, `[17/24, 7/8]`. -/
theorem fpieceBL123_3 (s : ℝ) (h1 : (17/24 : ℝ) ≤ s) (h2 : s ≤ (7/8 : ℝ)) : FClear ({1, 2, 3} : Finset ℕ) s := by
  intro i hi
  simp only [Finset.mem_insert, Finset.mem_singleton] at hi
