  rw [if_neg c2]
  by_cases c3 : τ ≤ (7/16 : ℝ)
  · rw [if_pos c3]
    try linarith
  rw [if_neg c3]
  by_cases c4 : τ < (9/16 : ℝ)
  · rw [if_pos c4]
    try linarith
  rw [if_neg c4]
  by_cases c5 : τ ≤ (5/8 : ℝ)
