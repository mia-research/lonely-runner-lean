/-!
# The cascade's landing, mover below the frozen minimum: frozen readings [1, 2, 3], mover 0 < ρ ≤ 1 (GENERATED by `s1_gen_lean_below_v1.py`)

Written 2026-10-22.  New file.  The mover is the smallest disparity, so the cascade starts at `t0 = 1/(8ρ)`.  The frozen set's
lonely instants have period 1; in one period they are [1/8, 7/24], [3/8, 7/16], [9/16, 5/8], [17/24, 7/8].
`nextFL123 t0` is the first frozen-lonely instant at or after `t0`; the mover is clear there because `ρ · gap ≤ 3/4`
(the largest forward gap is 1/4).  `landSpecBelowLe123`: the landing is `nextF (1/(8ρ))`.  Grades: [L]; the gap covers are
[PROVISIONAL: covering].  The cascade's intermediate setters are not claimed.
-/

open Classical

namespace Fresh.OneMover

open Fresh

/-- Shifting by whole laps does not change what is clear for integer readings. -/
theorem fclearBL123_shift (σ : ℝ) (n : ℕ) (h : FClear ({1, 2, 3} : Finset ℕ) σ) : FClear ({1, 2, 3} : Finset ℕ) (σ + n) := by
  intro i hi
  have e : (i : ℝ) * (σ + n) = (i : ℝ) * σ + (((i * n : ℕ) : ℤ) : ℝ) := by push_cast; ring
  rw [e, Fresh.Localisation.distInt_add_int]
  exact h i hi

theorem fclearBL123_unshift (σ : ℝ) (n : ℕ) (h : FClear ({1, 2, 3} : Finset ℕ) (σ + n)) : FClear ({1, 2, 3} : Finset ℕ) σ := by
  intro i hi
  have e : (i : ℝ) * (σ + n) = (i : ℝ) * σ + (((i * n : ℕ) : ℤ) : ℝ) := by push_cast; ring
  have := h i hi
  rw [e, Fresh.Localisation.distInt_add_int] at this
  exact this

/-- The frozen set [1, 2, 3] is clear on the period piece 0, `[1/8, 7/24]`. -/
theorem fpieceBL123_0 (s : ℝ) (h1 : (1/8 : ℝ) ≤ s) (h2 : s ≤ (7/24 : ℝ)) : FClear ({1, 2, 3} : Finset ℕ) s := by
  intro i hi
  simp only [Finset.mem_insert, Finset.mem_singleton] at hi
  rcases hi with rfl | rfl | rfl
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)

/-- The frozen set [1, 2, 3] is clear on the period piece 1, `[3/8, 7/16]`. -/
theorem fpieceBL123_1 (s : ℝ) (h1 : (3/8 : ℝ) ≤ s) (h2 : s ≤ (7/16 : ℝ)) : FClear ({1, 2, 3} : Finset ℕ) s := by
  intro i hi
