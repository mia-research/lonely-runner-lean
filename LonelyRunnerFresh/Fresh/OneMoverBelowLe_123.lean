theorem nfoff123_min (τ : ℝ) (h0 : 0 ≤ τ) (h1 : τ < 1) : ∀ σ : ℝ, τ ≤ σ → σ < nfoff123 τ → ¬ FClear ({1, 2, 3} : Finset ℕ) σ := by
  intro σ hs1 hs2 hF
  have hσ0 : 0 ≤ σ := le_trans h0 hs1
  have hσ2 : σ < 2 := by
    have : nfoff123 τ ≤ 2 := by
      unfold nfoff123
      by_cases c0 : τ < (1/8 : ℝ)
      · rw [if_pos c0]
        try linarith
      rw [if_neg c0]
      by_cases c1 : τ ≤ (7/24 : ℝ)
      · rw [if_pos c1]
        try linarith
      rw [if_neg c1]
      by_cases c2 : τ < (3/8 : ℝ)
      · rw [if_pos c2]
        try linarith
      rw [if_neg c2]
      by_cases c3 : τ ≤ (7/16 : ℝ)
      · rw [if_pos c3]
        try linarith
      rw [if_neg c3]
      by_cases c4 : τ < (9/16 : ℝ)
      · rw [if_pos c4]
        try linarith
      rw [if_neg c4]
      by_cases c5 : τ ≤ (5/8 : ℝ)
      · rw [if_pos c5]
        try linarith
      rw [if_neg c5]
      by_cases c6 : τ < (17/24 : ℝ)
      · rw [if_pos c6]
        try linarith
      rw [if_neg c6]
      by_cases c7 : τ ≤ (7/8 : ℝ)
      · rw [if_pos c7]
        try linarith
      rw [if_neg c7]
      try linarith
    linarith
  rcases lt_or_ge σ 1 with hlt | hge
  · have hcov := coverBL123 σ hσ0 hlt hF
    unfold nfoff123 at hs2
    by_cases c0 : τ < (1/8 : ℝ)
    · rw [if_pos c0] at hs2
      rcases hcov with ⟨p0, q0⟩ | ⟨p1, q1⟩ | ⟨p2, q2⟩ | ⟨p3, q3⟩ <;> linarith
    rw [if_neg c0] at hs2
    by_cases c1 : τ ≤ (7/24 : ℝ)
    · rw [if_pos c1] at hs2
      rcases hcov with ⟨p0, q0⟩ | ⟨p1, q1⟩ | ⟨p2, q2⟩ | ⟨p3, q3⟩ <;> linarith
    rw [if_neg c1] at hs2
    by_cases c2 : τ < (3/8 : ℝ)
    · rw [if_pos c2] at hs2
      rcases hcov with ⟨p0, q0⟩ | ⟨p1, q1⟩ | ⟨p2, q2⟩ | ⟨p3, q3⟩ <;> linarith
    rw [if_neg c2] at hs2
    by_cases c3 : τ ≤ (7/16 : ℝ)
    · rw [if_pos c3] at hs2
      rcases hcov with ⟨p0, q0⟩ | ⟨p1, q1⟩ | ⟨p2, q2⟩ | ⟨p3, q3⟩ <;> linarith
    rw [if_neg c3] at hs2
    by_cases c4 : τ < (9/16 : ℝ)
    · rw [if_pos c4] at hs2
      rcases hcov with ⟨p0, q0⟩ | ⟨p1, q1⟩ | ⟨p2, q2⟩ | ⟨p3, q3⟩ <;> linarith
    rw [if_neg c4] at hs2
    by_cases c5 : τ ≤ (5/8 : ℝ)
    · rw [if_pos c5] at hs2
      rcases hcov with ⟨p0, q0⟩ | ⟨p1, q1⟩ | ⟨p2, q2⟩ | ⟨p3, q3⟩ <;> linarith
    rw [if_neg c5] at hs2
    by_cases c6 : τ < (17/24 : ℝ)
    · rw [if_pos c6] at hs2
      rcases hcov with ⟨p0, q0⟩ | ⟨p1, q1⟩ | ⟨p2, q2⟩ | ⟨p3, q3⟩ <;> linarith
    rw [if_neg c6] at hs2
    by_cases c7 : τ ≤ (7/8 : ℝ)
    · rw [if_pos c7] at hs2
      rcases hcov with ⟨p0, q0⟩ | ⟨p1, q1⟩ | ⟨p2, q2⟩ | ⟨p3, q3⟩ <;> linarith
    rw [if_neg c7] at hs2
    rcases hcov with ⟨p0, q0⟩ | ⟨p1, q1⟩ | ⟨p2, q2⟩ | ⟨p3, q3⟩ <;> linarith
  · have hF' : FClear ({1, 2, 3} : Finset ℕ) (σ - 1 + ((1 : ℕ) : ℝ)) := by
