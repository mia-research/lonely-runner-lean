theorem nfoff123_clear (τ : ℝ) (h0 : 0 ≤ τ) (h1 : τ < 1) : FClear ({1, 2, 3} : Finset ℕ) (nfoff123 τ) := by
  unfold nfoff123
  by_cases c0 : τ < (1/8 : ℝ)
  · rw [if_pos c0]
    exact fpieceBL123_0 _ (le_refl _) (by norm_num)
  rw [if_neg c0]
  by_cases c1 : τ ≤ (7/24 : ℝ)
  · rw [if_pos c1]
    exact fpieceBL123_0 _ (not_lt.1 c0) c1
  rw [if_neg c1]
  by_cases c2 : τ < (3/8 : ℝ)
  · rw [if_pos c2]
    exact fpieceBL123_1 _ (le_refl _) (by norm_num)
  rw [if_neg c2]
  by_cases c3 : τ ≤ (7/16 : ℝ)
  · rw [if_pos c3]
    exact fpieceBL123_1 _ (not_lt.1 c2) c3
  rw [if_neg c3]
  by_cases c4 : τ < (9/16 : ℝ)
  · rw [if_pos c4]
    exact fpieceBL123_2 _ (le_refl _) (by norm_num)
  rw [if_neg c4]
  by_cases c5 : τ ≤ (5/8 : ℝ)
  · rw [if_pos c5]
    exact fpieceBL123_2 _ (not_lt.1 c4) c5
  rw [if_neg c5]
  by_cases c6 : τ < (17/24 : ℝ)
  · rw [if_pos c6]
    exact fpieceBL123_3 _ (le_refl _) (by norm_num)
  rw [if_neg c6]
  by_cases c7 : τ ≤ (7/8 : ℝ)
  · rw [if_pos c7]
    exact fpieceBL123_3 _ (not_lt.1 c6) c7
  rw [if_neg c7]
  have := fclearBL123_shift (1/8 : ℝ) 1 (fpieceBL123_0 (1/8 : ℝ) (le_refl _) (by norm_num))
  have e : (9/8 : ℝ) = (1/8 : ℝ) + ((1 : ℕ) : ℝ) := by push_cast; norm_num
  rw [e]; exact this

