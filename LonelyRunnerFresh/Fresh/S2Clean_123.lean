/-!
# Two movers, frozen readings 123: a common clear instant in the first wide piece for ALL movers beyond the least frozen reading (GENERATED by `s2_gen_lean_clean_v1.py`)

Written 2026-10-23.  New file.  First wide piece `[1/8, 7/24]` (the first lonely piece of the frozen set).  For ALL real `d1, d2 > 1`
(no grid, no threshold) the two movers have a common clear instant in the piece (`exists_common_clear_123`), hence the landing mechanism of
`land2C123` (`land2_all_123`).  Method: a finite box cover of `{d1 ≤ d2}` (`5` columns in `d1`, `7` boxes), each box certified by a lemma of
`S2CleanLemmas` (rule R1 `r1_rect`, or a point witness `wit_pt`) with explicit numerals; `d1 > 6` (D0) by `big_both` [PROVISIONAL: counting tool].
Grades: [L]; the existence statement is discharged by a finite box cover [PROVISIONAL: covering].  Box kinds: {'P': 2, 'R1a': 5}.
Not proved here: the cascade's path inside the piece; movers at or below `1`.
-/

open Classical

namespace Fresh.OneMover

open Fresh

theorem core_123 (d1 d2 : ℝ) (h0 : (1 : ℝ) ≤ d1) (hd : d1 ≤ d2) :
    ∃ t, (1/8 : ℝ) ≤ t ∧ t ≤ (7/24 : ℝ) ∧ Clear2 d1 d2 t := by
  have hp1 : 0 < d1 := by linarith
  have hp2 : 0 < d2 := by linarith
  rcases le_or_gt d1 (2 : ℝ) with c0 | b0
  · -- column d1 in [1, 2]
    rcases le_or_gt d2 (7 : ℝ) with e0_0 | f0_0
    · exact ⟨(1/8 : ℝ), by norm_num, by norm_num, wit_pt (n1 := (0 : ℤ)) (n2 := (0 : ℤ)) (by push_cast; linarith) (by push_cast; linarith) (by push_cast; linarith) (by push_cast; linarith)⟩
    · -- d2 > 7
      exact r1_rect (n := (0 : ℤ)) (p := (1/6 : ℝ)) (q := (1/4 : ℝ)) hp1 hp2 (by norm_num) (by norm_num) (by push_cast; linarith) (by push_cast; linarith) (by linarith)
  · -- d1 > 2
    rcases le_or_gt d1 (3 : ℝ) with c1 | b1
    · -- column d1 in [2, 3]
      exact r1_rect (n := (0 : ℤ)) (p := (1/7 : ℝ)) (q := (2/7 : ℝ)) hp1 hp2 (by norm_num) (by norm_num) (by push_cast; linarith) (by push_cast; linarith) (by linarith)
    · -- d1 > 3
      rcases le_or_gt d1 (4 : ℝ) with c2 | b2
      · -- column d1 in [3, 4]
        exact r1_rect (n := (0 : ℤ)) (p := (1/8 : ℝ)) (q := (3/14 : ℝ)) hp1 hp2 (by norm_num) (by norm_num) (by push_cast; linarith) (by push_cast; linarith) (by linarith)
      · -- d1 > 4
        rcases le_or_gt d1 (5 : ℝ) with c3 | b3
        · -- column d1 in [4, 5]
          rcases le_or_gt d2 (7 : ℝ) with e3_0 | f3_0
          · exact ⟨(1/8 : ℝ), by norm_num, by norm_num, wit_pt (n1 := (0 : ℤ)) (n2 := (0 : ℤ)) (by push_cast; linarith) (by push_cast; linarith) (by push_cast; linarith) (by push_cast; linarith)⟩
          · -- d2 > 7
            exact r1_rect (n := (0 : ℤ)) (p := (1/8 : ℝ)) (q := (4/23 : ℝ)) hp1 hp2 (by norm_num) (by norm_num) (by push_cast; linarith) (by push_cast; linarith) (by linarith)
        · -- d1 > 5
          rcases le_or_gt d1 (6 : ℝ) with c4 | b4
          · -- column d1 in [5, 6]
            exact r1_rect (n := (1 : ℤ)) (p := (3/13 : ℝ)) (q := (2/7 : ℝ)) hp1 hp2 (by norm_num) (by norm_num) (by push_cast; linarith) (by push_cast; linarith) (by linarith)
          · -- d1 > 6
            exact big_both (D := (6 : ℝ)) (l := (1/8 : ℝ)) (r := (7/24 : ℝ)) (by norm_num) (by norm_num) (by linarith) (by linarith)

theorem exists_common_clear_123 (d1 d2 : ℝ) (hd1 : (1 : ℝ) < d1) (hd2 : (1 : ℝ) < d2) :
    ∃ t, (1/8 : ℝ) ≤ t ∧ t ≤ (7/24 : ℝ) ∧ Clear2 d1 d2 t := by
  rcases le_total d1 d2 with h | h
  · exact core_123 d1 d2 hd1.le h
  · obtain ⟨t, a1, a2, a3⟩ := core_123 d2 d1 hd2.le h
    exact ⟨t, a1, a2, clear2_symm a3⟩

theorem land2_all_123 (d1 d2 : ℝ) (hd1 : (1 : ℝ) < d1) (hd2 : (1 : ℝ) < d2) :
    ∃ T, IsFirst (insert d1 (insert d2 (fset ({1, 2, 3} : Finset ℕ)))) T ∧ (1/8 : ℝ) ≤ T ∧
          (((1/8 : ℝ) ≤ T ∧ T ≤ (7/24 : ℝ) ∧ Clear2 d1 d2 T ∧ ∀ s, (1/8 : ℝ) ≤ s → s < T → ¬ Clear2 d1 d2 s)) := 
  land2C123 d1 d2 (by linarith) (by linarith) (exists_common_clear_123 d1 d2 hd1 hd2)

#print axioms exists_common_clear_123
