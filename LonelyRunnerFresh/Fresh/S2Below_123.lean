theorem small123 (d1 d2 : ℝ) (hd1 : 0 < d1) (hd18 : d1 ≤ 1 / 8) (hd : d1 ≤ d2) :
    ∃ t, 0 < t ∧ FClear ({1, 2, 3} : Finset ℕ) t ∧ Clear2 d1 d2 t := by
  have hd2p : 0 < d2 := by linarith
  rcases le_or_gt (2 : ℝ) d2 with hbig | hlt
  · exact small_A (l := (1/8 : ℝ)) (r := (7/24 : ℝ)) (by norm_num) (by norm_num) (by norm_num) (fbp123_0) hd1 hd18 (by linarith)
  · by_cases hfar : d1 / 2 ≤ distInt d2
    · exact small_II (τ0 := (1/8 : ℝ)) (by norm_num) (by norm_num) (fbp123_0 _ (by norm_num) (by norm_num)) hd1 hd18 hfar
    · push Not at hfar
      obtain ⟨j, hj1, hjD, hjd⟩ := near_int (D := 2) hd1 hd18 hd (by exact_mod_cast hlt) hfar
      have hb := abs_lt.mp hjd
      interval_cases j
      · rcases le_total ((1 : ℕ) : ℝ) d2 with q | q
        · exact small_I_pos (τ0 := (1/4 : ℝ)) (by norm_num) (by norm_num) (fbp123_0 _ (by norm_num) (by norm_num)) 1 (0 : ℤ) (by norm_num) (by norm_num) hd1 hd18 q (by linarith [hb.2])
        · exact small_I_neg (τ0 := (1/4 : ℝ)) (by norm_num) (by norm_num) (fbp123_0 _ (by norm_num) (by norm_num)) 1 (0 : ℤ) (by norm_num) (by norm_num) hd1 hd18 q (by linarith [hb.1])
      · rcases le_total ((2 : ℕ) : ℝ) d2 with q | q
        · exact small_I_pos (τ0 := (1/4 : ℝ)) (by norm_num) (by norm_num) (fbp123_0 _ (by norm_num) (by norm_num)) 2 (0 : ℤ) (by norm_num) (by norm_num) hd1 hd18 q (by linarith [hb.2])
        · exact small_I_neg (τ0 := (1/4 : ℝ)) (by norm_num) (by norm_num) (fbp123_0 _ (by norm_num) (by norm_num)) 2 (0 : ℤ) (by norm_num) (by norm_num) hd1 hd18 q (by linarith [hb.1])

