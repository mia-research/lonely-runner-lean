theorem coverL13467 (s : ℝ) (h0 : (1/8 : ℝ) ≤ s) (hR : s ≤ (31/56 : ℝ)) (hF : FClear ({1, 3, 4, 6, 7} : Finset ℕ) s) :
    ((1/8 : ℝ) ≤ s ∧ s ≤ (1/8 : ℝ)) ∨ (((3/16 : ℝ) ≤ s ∧ s ≤ (7/32 : ℝ)) ∨ (((3/8 : ℝ) ≤ s ∧ s ≤ (23/56 : ℝ)) ∨ (((25/56 : ℝ) ≤ s ∧ s ≤ (15/32 : ℝ)) ∨ (((17/32 : ℝ) ≤ s ∧ s ≤ (31/56 : ℝ)))))) := by
  rcases le_or_gt s (1/8 : ℝ) with d0 | d0
  · left; exact ⟨h0, d0⟩
  rcases lt_or_ge s (3/16 : ℝ) with g0 | d0g
  · exact absurd hF (gapL13467_0 s d0 g0)
  rcases le_or_gt s (7/32 : ℝ) with d1 | d1
  · right; left; exact ⟨d0g, d1⟩
  rcases lt_or_ge s (3/8 : ℝ) with g1 | d1g
  · exact absurd hF (gapL13467_1 s d1 g1)
  rcases le_or_gt s (23/56 : ℝ) with d2 | d2
  · right; right; left; exact ⟨d1g, d2⟩
  rcases lt_or_ge s (25/56 : ℝ) with g2 | d2g
  · exact absurd hF (gapL13467_2 s d2 g2)
  rcases le_or_gt s (15/32 : ℝ) with d3 | d3
  · right; right; right; left; exact ⟨d2g, d3⟩
  rcases lt_or_ge s (17/32 : ℝ) with g3 | d3g
  · exact absurd hF (gapL13467_3 s d3 g3)
  rcases le_or_gt s (31/56 : ℝ) with d4 | d4
  · right; right; right; right; exact ⟨d3g, d4⟩
  exact absurd hR (not_le.2 d4)

