  have key : ∀ T : ℝ, T ≤ (1/8 : ℝ) → FClear ({1, 3, 4, 6, 7} : Finset ℕ) T → Clear2 d1 d2 T →
      (∀ s, (1/8 : ℝ) ≤ s → s ≤ (1/8 : ℝ) → s < T → FClear ({1, 3, 4, 6, 7} : Finset ℕ) s → Clear2 d1 d2 s → False) →
      IsFirst (insert d1 (insert d2 (fset ({1, 3, 4, 6, 7} : Finset ℕ)))) T := by
    intro T hTr hF hC hmin
    refine ⟨(lonely_insert2_iff ({1, 3, 4, 6, 7} : Finset ℕ) d1 d2 T).2 ⟨hF, hC⟩, ?_⟩
