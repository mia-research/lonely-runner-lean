/-- [PROVISIONAL: covering] -/
theorem coverM124 (s : ℝ) (h0 : (1/8 : ℝ) ≤ s) (hR : s ≤ (23/32 : ℝ)) (hF : FClear ({1, 2, 4} : Finset ℕ) s) :
    ((1/8 : ℝ) ≤ s ∧ s ≤ (7/32 : ℝ)) ∨ (((9/32 : ℝ) ≤ s ∧ s ≤ (7/16 : ℝ)) ∨ (((9/16 : ℝ) ≤ s ∧ s ≤ (23/32 : ℝ)))) := by
  rcases le_or_gt s (7/32 : ℝ) with d0 | d0
  · left; exact ⟨h0, d0⟩
  rcases lt_or_ge s (9/32 : ℝ) with g0 | d0g
  · exact absurd hF (gapM124_0 s d0 g0)
  rcases le_or_gt s (7/16 : ℝ) with d1 | d1
  · right; left; exact ⟨d0g, d1⟩
  rcases lt_or_ge s (9/16 : ℝ) with g1 | d1g
  · exact absurd hF (gapM124_1 s d1 g1)
  rcases le_or_gt s (23/32 : ℝ) with d2 | d2
  · right; right; exact ⟨d1g, d2⟩
  exact absurd hR (not_le.2 d2)

theorem landL3124_0 (d1 d2 d3 : ℝ) (hd1p : 0 < d1) (hd2p : 0 < d2) (hd3p : 0 < d3) (hex : ∃ t, (1/8 : ℝ) ≤ t ∧ t ≤ (7/32 : ℝ) ∧ Clear3 d1 d2 d3 t) :
    ∃ T, IsFirst (insert d1 (insert d2 (insert d3 (fset ({1, 2, 4} : Finset ℕ))))) T ∧ (1/8 : ℝ) ≤ T ∧ (1/8 : ℝ) ≤ T ∧ T ≤ (7/32 : ℝ) ∧ Clear3 d1 d2 d3 T ∧ ∀ s, (1/8 : ℝ) ≤ s → s < T → ¬ Clear3 d1 d2 d3 s := by
  have hamem := mem_insert3 (S := ({1, 2, 4} : Finset ℕ)) d1 d2 d3 (a := 1) (by decide)
  have key : ∀ T : ℝ, T ≤ (7/32 : ℝ) → FClear ({1, 2, 4} : Finset ℕ) T → Clear3 d1 d2 d3 T →
      (∀ s, (1/8 : ℝ) ≤ s → s ≤ (7/32 : ℝ) → s < T → FClear ({1, 2, 4} : Finset ℕ) s → Clear3 d1 d2 d3 s → False) →
      IsFirst (insert d1 (insert d2 (insert d3 (fset ({1, 2, 4} : Finset ℕ))))) T := by
    intro T hTr hF hC hmin
    refine ⟨(lonely_insert3_iff ({1, 2, 4} : Finset ℕ) d1 d2 d3 T).2 ⟨hF, hC⟩, ?_⟩
    intro s hs hlon
    have hs8' := lonely_geG hamem (by norm_num) hs hlon
    have hs8 : (1/8 : ℝ) ≤ s := by norm_num at hs8' ⊢; linarith
    rw [lonely_insert3_iff] at hlon
    by_contra hlt
    push Not at hlt
    exact hmin s hs8 (by linarith) hlt hlon.1 hlon.2
  obtain ⟨ts, hls, hrs, hcs⟩ := hex
  obtain ⟨T, hlT, hCT, hmin⟩ := first_three_clear hd1p hd2p hd3p (by norm_num : (0 : ℝ) < (1/8 : ℝ)) ⟨ts, hls, hcs⟩
  have hTr : T ≤ (7/32 : ℝ) := le_trans (hmin ts hls hcs) hrs
  refine ⟨T, key T hTr (fpieceM124_0 T hlT hTr) hCT ?_, by linarith, hlT, hTr, hCT, fun s hs hlt hc => absurd (hmin s hs hc) (not_le.2 hlt)⟩
  intro s h0 hR hlt hF hC
  rcases coverM124 s h0 (le_trans hR (by norm_num)) hF with ⟨a0, b0⟩ | ⟨a1, b1⟩ | ⟨a2, b2⟩
  · exact absurd (hmin s a0 hC) (not_le.2 hlt)
  · linarith
  · linarith

