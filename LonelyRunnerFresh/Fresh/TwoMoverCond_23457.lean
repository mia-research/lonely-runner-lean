/-!
# Two movers, conditional on a common clear instant in the first wide piece: frozen readings [2, 3, 4, 5, 7] (GENERATED by `s2_gen_lean_large_v1.py`)

Written 2026-10-22.  New file.  Frozen lonely pieces from `1/(8·2)` up to the first wide piece (exact): [1/16, 1/8].
For two movers `d1, d2 > 0` with a common clear instant in the first wide piece (threshold form: `d1, d2 ≥ 16`, `L = 1/16`) the first lonely instant `T` of the frozen set with both movers exists
(`land2C23457`): it is the first listed point at which both movers are clear, or else it lies in the wide piece and is the
first common clear instant there.  Grades: [L]; gap covers [PROVISIONAL: covering]; the wide piece holds a common clear
instant by `two_clear_in` [PROVISIONAL: counting tool].  The cascade's path inside the piece is not described.
-/

open Classical

namespace Fresh.OneMover

open Fresh

theorem fpiece2C23457_0 (s : ℝ) (h1 : (1/16 : ℝ) ≤ s) (h2 : s ≤ (1/8 : ℝ)) : FClear ({2, 3, 4, 5, 7} : Finset ℕ) s := by
  intro i hi
  simp only [Finset.mem_insert, Finset.mem_singleton] at hi
  rcases hi with rfl | rfl | rfl | rfl | rfl
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)

/-- [PROVISIONAL: covering] -/
theorem cover2C23457 (s : ℝ) (h0 : (1/16 : ℝ) ≤ s) (hR : s ≤ (1/8 : ℝ)) (hF : FClear ({2, 3, 4, 5, 7} : Finset ℕ) s) :
    ((1/16 : ℝ) ≤ s ∧ s ≤ (1/8 : ℝ)) := by
  rcases le_or_gt s (1/8 : ℝ) with d0 | d0
  · exact ⟨h0, d0⟩
  exact absurd hR (not_le.2 d0)

theorem land2C23457 (d1 d2 : ℝ) (hd1p : 0 < d1) (hd2p : 0 < d2) (hexw : ∃ t, (1/16 : ℝ) ≤ t ∧ t ≤ (1/8 : ℝ) ∧ Clear2 d1 d2 t) :
    ∃ T, IsFirst (insert d1 (insert d2 (fset ({2, 3, 4, 5, 7} : Finset ℕ)))) T ∧ (1/16 : ℝ) ≤ T ∧
      (((1/16 : ℝ) ≤ T ∧ T ≤ (1/8 : ℝ) ∧ Clear2 d1 d2 T ∧ ∀ s, (1/16 : ℝ) ≤ s → s < T → ¬ Clear2 d1 d2 s)) := by
  have hamem := mem_insert2 (S := ({2, 3, 4, 5, 7} : Finset ℕ)) d1 d2 (a := 2) (by decide)
  have key : ∀ T : ℝ, T ≤ (1/8 : ℝ) → FClear ({2, 3, 4, 5, 7} : Finset ℕ) T → Clear2 d1 d2 T →
      (∀ s, (1/16 : ℝ) ≤ s → s ≤ (1/8 : ℝ) → s < T → FClear ({2, 3, 4, 5, 7} : Finset ℕ) s → Clear2 d1 d2 s → False) →
      IsFirst (insert d1 (insert d2 (fset ({2, 3, 4, 5, 7} : Finset ℕ)))) T := by
    intro T hTr hF hC hmin
    refine ⟨(lonely_insert2_iff ({2, 3, 4, 5, 7} : Finset ℕ) d1 d2 T).2 ⟨hF, hC⟩, ?_⟩
    intro s hs hlon
    have hs8' := lonely_geG hamem (by norm_num) hs hlon
    have hs8 : (1/16 : ℝ) ≤ s := by norm_num at hs8' ⊢; linarith
    rw [lonely_insert2_iff] at hlon
    by_contra hlt
    push Not at hlt
    exact hmin s hs8 (by linarith) hlt hlon.1 hlon.2
  obtain ⟨ts, hls, hrs, hcs⟩ := hexw
  obtain ⟨T, hlT, hCT, hmin⟩ := first_two_clear hd1p hd2p (by norm_num : (0 : ℝ) < (1/16 : ℝ)) ⟨ts, hls, hcs⟩
  have hTr : T ≤ (1/8 : ℝ) := le_trans (hmin ts hls hcs) hrs
  refine ⟨T, key T hTr (fpiece2C23457_0 T hlT hTr) hCT ?_, by linarith, ?_⟩
  · intro s h0 hR hlt hF hC
    rcases cover2C23457 s h0 hR hF with ⟨a0, b0⟩
    · exact absurd (hmin s a0 hC) (not_le.2 hlt)
  · exact ⟨hlT, hTr, hCT, fun s hs hlt hc => absurd (hmin s hs hc) (not_le.2 hlt)⟩

#print axioms land2C23457

end Fresh.OneMover
