theorem landing_twoMoverComplete_123 (c x1 x2 : ℝ) (k m1 m2 : Fin 8) (hk1 : k ≠ m1) (hk2 : k ≠ m2) (h12 : m1 ≠ m2)
    (hS : Sdisp2 k m1 m2 = ({1, 2, 3} : Finset ℕ))
    (hd1 : 0 < |x1 - (c + ((k : ℕ) : ℝ))|) (hd2 : 0 < |x2 - (c + ((k : ℕ) : ℝ))|) :
    ∃ T : ℝ, 1 / (8 * min (1 : ℝ) (min |x1 - (c + ((k : ℕ) : ℝ))| |x2 - (c + ((k : ℕ) : ℝ))|)) ≤ T ∧
      IsFirst (disparitySet (twoMover c x1 x2 m1 m2) k) T ∧
      (∃ seq : ℕ → ℝ, seq 0 = 1 / (8 * min (1 : ℝ) (min |x1 - (c + ((k : ℕ) : ℝ))| |x2 - (c + ((k : ℕ) : ℝ))|)) ∧
        (∀ n, IsMove (disparitySet (twoMover c x1 x2 m1 m2) k) (seq n) (seq (n + 1))) ∧ ∃ N, seq (N + 1) = seq N) ∧
      ∀ seq : ℕ → ℝ, seq 0 = 1 / (8 * min (1 : ℝ) (min |x1 - (c + ((k : ℕ) : ℝ))| |x2 - (c + ((k : ℕ) : ℝ))|)) →
        (∀ n, IsMove (disparitySet (twoMover c x1 x2 m1 m2) k) (seq n) (seq (n + 1))) → ∀ N, seq (N + 1) = seq N → seq N = T := by
  by_cases hm : min |x1 - (c + ((k : ℕ) : ℝ))| |x2 - (c + ((k : ℕ) : ℝ))| ≤ (1 : ℝ)
  · have e : min (1 : ℝ) (min |x1 - (c + ((k : ℕ) : ℝ))| |x2 - (c + ((k : ℕ) : ℝ))|) = min |x1 - (c + ((k : ℕ) : ℝ))| |x2 - (c + ((k : ℕ) : ℝ))| := min_eq_right hm
    rw [e]
    exact landing_twoMoverBelow_123 c x1 x2 k m1 m2 hk1 hk2 h12 hS hd1 hd2 hm
  · push Not at hm
    have h1 : (1 : ℝ) < |x1 - (c + ((k : ℕ) : ℝ))| := lt_of_lt_of_le hm (min_le_left _ _)
    have h2 : (1 : ℝ) < |x2 - (c + ((k : ℕ) : ℝ))| := lt_of_lt_of_le hm (min_le_right _ _)
    have e : min (1 : ℝ) (min |x1 - (c + ((k : ℕ) : ℝ))| |x2 - (c + ((k : ℕ) : ℝ))|) = (1 : ℝ) := min_eq_left hm.le
    rw [e]
    exact landing_twoMoverClean_123 c x1 x2 k m1 m2 hk1 hk2 h12 hS h1 h2

