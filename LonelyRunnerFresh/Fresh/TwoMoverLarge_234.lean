/-!
# Two movers, both large: frozen readings [2, 3, 4] (GENERATED by `s2_gen_lean_large_v1.py`)

Written 2026-10-22.  New file.  Frozen lonely pieces from `1/(8·2)` up to the first wide piece (exact): [1/16, 7/32].
For two movers `d1, d2 ≥ 12` (`= ⌈7/(4L)⌉`, `L = 5/32`) the first lonely instant `T` of the frozen set with both movers exists
(`land2G234`): it is the first listed point at which both movers are clear, or else it lies in the wide piece and is the
first common clear instant there.  Grades: [L]; gap covers [PROVISIONAL: covering]; the wide piece holds a common clear
instant by `two_clear_in` [PROVISIONAL: counting tool].  The cascade's path inside the piece is not described.
-/

open Classical

namespace Fresh.OneMover

open Fresh

theorem fpiece2G234_0 (s : ℝ) (h1 : (1/16 : ℝ) ≤ s) (h2 : s ≤ (7/32 : ℝ)) : FClear ({2, 3, 4} : Finset ℕ) s := by
  intro i hi
  simp only [Finset.mem_insert, Finset.mem_singleton] at hi
  rcases hi with rfl | rfl | rfl
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)

/-- [PROVISIONAL: covering] -/
theorem cover2G234 (s : ℝ) (h0 : (1/16 : ℝ) ≤ s) (hR : s ≤ (7/32 : ℝ)) (hF : FClear ({2, 3, 4} : Finset ℕ) s) :
    ((1/16 : ℝ) ≤ s ∧ s ≤ (7/32 : ℝ)) := by
  rcases le_or_gt s (7/32 : ℝ) with d0 | d0
  · exact ⟨h0, d0⟩
  exact absurd hR (not_le.2 d0)

theorem land2G234 (d1 d2 : ℝ) (hd1 : (12 : ℝ) ≤ d1) (hd2 : (12 : ℝ) ≤ d2) :
    ∃ T, IsFirst (insert d1 (insert d2 (fset ({2, 3, 4} : Finset ℕ)))) T ∧ (1/16 : ℝ) ≤ T ∧
      (((1/16 : ℝ) ≤ T ∧ T ≤ (7/32 : ℝ) ∧ Clear2 d1 d2 T ∧ ∀ s, (1/16 : ℝ) ≤ s → s < T → ¬ Clear2 d1 d2 s)) := by
  have hd1p : 0 < d1 := by linarith
  have hd2p : 0 < d2 := by linarith
  have hamem := mem_insert2 (S := ({2, 3, 4} : Finset ℕ)) d1 d2 (a := 2) (by decide)
  have key : ∀ T : ℝ, T ≤ (7/32 : ℝ) → FClear ({2, 3, 4} : Finset ℕ) T → Clear2 d1 d2 T →
      (∀ s, (1/16 : ℝ) ≤ s → s ≤ (7/32 : ℝ) → s < T → FClear ({2, 3, 4} : Finset ℕ) s → Clear2 d1 d2 s → False) →
      IsFirst (insert d1 (insert d2 (fset ({2, 3, 4} : Finset ℕ)))) T := by
    intro T hTr hF hC hmin
    refine ⟨(lonely_insert2_iff ({2, 3, 4} : Finset ℕ) d1 d2 T).2 ⟨hF, hC⟩, ?_⟩
    intro s hs hlon
    have hs8' := lonely_geG hamem (by norm_num) hs hlon
    have hs8 : (1/16 : ℝ) ≤ s := by norm_num at hs8' ⊢; linarith
    rw [lonely_insert2_iff] at hlon
    by_contra hlt
    push Not at hlt
    exact hmin s hs8 (by linarith) hlt hlon.1 hlon.2
  have hwid : ∀ d : ℝ, (12 : ℝ) ≤ d → (1/16 : ℝ) + 7 / (4 * d) ≤ (7/32 : ℝ) := by
    intro d hd
    have hdp : 0 < d := by linarith
    have h7 : 7 / (4 * d) ≤ (7/32 : ℝ) - (1/16 : ℝ) := by
      rw [div_le_iff₀ (by positivity)]
      have := mul_le_mul_of_nonneg_left hd (by norm_num : (0 : ℝ) ≤ 4 * ((7/32 : ℝ) - (1/16 : ℝ)))
      nlinarith
    linarith
  have hexw : ∃ t, (1/16 : ℝ) ≤ t ∧ t ≤ (7/32 : ℝ) ∧ Clear2 d1 d2 t := by
    rcases le_total d1 d2 with hle | hle
    · exact two_clear_in hd1p hle (hwid d1 hd1)
    · obtain ⟨t, ha, hb, hc⟩ := two_clear_in hd2p hle (hwid d2 hd2)
      exact ⟨t, ha, hb, ⟨hc.2, hc.1⟩⟩
  obtain ⟨ts, hls, hrs, hcs⟩ := hexw
  obtain ⟨T, hlT, hCT, hmin⟩ := first_two_clear hd1p hd2p (by norm_num : (0 : ℝ) < (1/16 : ℝ)) ⟨ts, hls, hcs⟩
  have hTr : T ≤ (7/32 : ℝ) := le_trans (hmin ts hls hcs) hrs
  refine ⟨T, key T hTr (fpiece2G234_0 T hlT hTr) hCT ?_, by linarith, ?_⟩
  · intro s h0 hR hlt hF hC
    rcases cover2G234 s h0 hR hF with ⟨a0, b0⟩
    · exact absurd (hmin s a0 hC) (not_le.2 hlt)
  · exact ⟨hlT, hTr, hCT, fun s hs hlt hc => absurd (hmin s hs hc) (not_le.2 hlt)⟩

#print axioms land2G234

end Fresh.OneMover
