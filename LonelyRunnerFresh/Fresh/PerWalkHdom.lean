/-- The append lift: the select shape propagates over `++` (this keeps the aggregate
free of any reliance on the association simp leaves the membership disjunction in). -/
theorem agg_append {P : (ℕ × ℕ × UTable) → Prop} {l₁ l₂ : List (ℕ × ℕ × UTable)}
    (h₁ : ∀ W ∈ l₁, P W) (h₂ : ∀ W ∈ l₂, P W) :
    ∀ W ∈ l₁ ++ l₂, P W := by
  intro W hW
  rcases List.mem_append.mp hW with h | h
  · exact h₁ W h
  · exact h₂ W h

