set_option maxHeartbeats 10000000
-- the chunked enumeration literals need elaboration depth beyond the default 512;
-- the enumeration itself is chunked (14 appended sublists) to keep every single
-- literal chain shallow (an unchunked 804-element chain aborts the elaborator)
set_option maxRecDepth 2000

