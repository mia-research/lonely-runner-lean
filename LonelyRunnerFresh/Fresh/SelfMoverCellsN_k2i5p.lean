/-- **The landing for the subject 2 at `c + 5 + δ`, every `0 < δ ≤ 1/2` (nearest runner `5`).**  `δ ≤ 1/24`: the cells of `SelfMoverCells_k2i5p`; above: `N0 = 0, 1, 2`. -/
theorem selfLandingAP_k2i5p (c δ : ℝ) (hδ : 0 < δ) (hhalf : δ ≤ 1 / 2) :
    ∃ T : ℝ, 0 < T ∧ (∃ seq : ℕ → ℝ, seq 0 = 1 / (8 * δ) ∧
      (∀ n, IsMove (disparitySet (selfV c 5 (1 : ℝ) δ (⟨2, by norm_num⟩ : Fin 8)) (⟨2, by norm_num⟩ : Fin 8)) (seq n) (seq (n + 1))) ∧ ∃ N, seq (N + 1) = seq N) ∧
      ∀ seq : ℕ → ℝ, seq 0 = 1 / (8 * δ) →
        (∀ n, IsMove (disparitySet (selfV c 5 (1 : ℝ) δ (⟨2, by norm_num⟩ : Fin 8)) (⟨2, by norm_num⟩ : Fin 8)) (seq n) (seq (n + 1))) → ∀ N, seq (N + 1) = seq N → seq N = T := by
  by_cases hs : δ ≤ 1 / (8 * ((2 : ℝ) + 1))
  · exact selfLanding_k2i5p c δ hδ hs
  push Not at hs
  have hA : 1 / (8 * δ) < (2 : ℝ) + 1 := by
    rw [div_lt_iff₀ (by positivity)]; have h := hs; rw [div_lt_iff₀ (by positivity)] at h; nlinarith
  have hB : (1 / 4 : ℝ) ≤ 1 / (8 * δ) := by rw [le_div_iff₀ (by positivity)]; nlinarith
  rcases lt_or_ge (1 / (8 * δ)) 1 with h1 | h1
  · exact selfLandingN0_k2i5p c δ hδ (by positivity) (by linarith) hhalf
  rcases lt_or_ge (1 / (8 * δ)) 2 with h2 | h2
  · exact selfLandingN1_k2i5p c δ hδ (by linarith) (by linarith)
  · exact selfLandingN2_k2i5p c δ hδ (by linarith) (by linarith)

