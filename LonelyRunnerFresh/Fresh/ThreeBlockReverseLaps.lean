-- STANDING: DEFINITION
def ThreeBlockReverseLapsClass (V : Fin 8 → ℝ) : Prop :=
  (∀ i, 0 < V i) ∧ Function.Injective V ∧
  ∃ (c g h B z : ℝ) (m a b : ℤ) (σ : Equiv.Perm (Fin 8)),
    1 ≤ m ∧ 0 < g ∧ 0 < h ∧ g+h ≤ 2 ∧
    (8*(m : ℝ)-1)*g ≤ 8*(a : ℝ)-1 ∧
    (8*(m : ℝ)-1)*h ≤ 8*(b : ℝ)-1 ∧
    8*((a : ℝ)+(b : ℝ))-3 ≤ (8*(m : ℝ)-1)*(g+h) ∧ z ≠ 0 ∧
    V=(fun i => B+z*speeds c g h (σ i))

theorem threeBlockReverseLaps_isolation {V : Fin 8 → ℝ}
    (h : ThreeBlockReverseLapsClass V) (k : Fin 8) : Isolation V k := by
  obtain ⟨hpos,hinj,c,g,h,B,z,m,a,b,σ,hm,hgpos,hhpos,hsmall,hg,hh,hsum,hz,hV⟩ := h
  rw [hV]
  have hi := reverse_laps_all_subjects c g h m a b hm hgpos hhpos hsmall hg hh hsum (σ k)
  have hi' := subject_isolation_affine B z hz hi
  exact (Fresh.isolation_comp_perm _ σ k).2 hi'

#print axioms reverse_laps_all_subjects
#print axioms threeBlockReverseLaps_isolation
end Fresh.ThreeBlockReverseLaps
