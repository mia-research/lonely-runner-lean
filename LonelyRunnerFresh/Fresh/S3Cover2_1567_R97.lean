          obtain ⟨t, ha, hb, cX, cY, cZ⟩ := r3_box (dX := d1) (dY := d2) (dZ := d3) (l := (9/40 : ℝ)) (r := (15/56 : ℝ)) (p := (5/22 : ℝ)) (q := (3/13 : ℝ)) (n := (11 : ℤ)) (le_of_lt s4) hB1 (le_of_lt s3) h23 (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
          exact ⟨t, (Or.inr (Or.inl ⟨ha, hb⟩)), ⟨cX, cY, cZ⟩⟩

