theorem exists_common_clear_23467 (d1 d2 : ℝ) (hd1 : (2 : ℝ) < d1) (hd2 : (2 : ℝ) < d2) :
    ∃ t, (1/16 : ℝ) ≤ t ∧ t ≤ (1/8 : ℝ) ∧ Clear2 d1 d2 t := by
  rcases le_total d1 d2 with h | h
  · exact core_23467 d1 d2 hd1.le h
  · obtain ⟨t, a1, a2, a3⟩ := core_23467 d2 d1 hd2.le h
    exact ⟨t, a1, a2, clear2_symm a3⟩

theorem land2_all_23467 (d1 d2 : ℝ) (hd1 : (2 : ℝ) < d1) (hd2 : (2 : ℝ) < d2) :
    ∃ T, IsFirst (insert d1 (insert d2 (fset ({2, 3, 4, 6, 7} : Finset ℕ)))) T ∧ (1/16 : ℝ) ≤ T ∧
          (((1/16 : ℝ) ≤ T ∧ T ≤ (1/8 : ℝ) ∧ Clear2 d1 d2 T ∧ ∀ s, (1/16 : ℝ) ≤ s → s < T → ¬ Clear2 d1 d2 s)) := 
  land2C23467 d1 d2 (by linarith) (by linarith) (exists_common_clear_23467 d1 d2 hd1 hd2)

