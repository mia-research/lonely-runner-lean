/-!
# The AP with one runner moved to any speed, every subject (GENERATED by `s1_gen_lean_all_landing_v1.py`)

Written 2026-10-23.  New file.  Speeds `c + i` except runner `m` at `x`, with `x` not the speed of any other runner (the arrangement is injective).
For every subject `k` (including `k = m`, the mover itself) some disparity `a` of `k` satisfies `Lands`: a first isolation instant exists, the cascade
from `1/(8a)` reaches a fixed point, and every fixed point is that instant.  Joins `s1_nonsubject` (`k != m`) and `subject_moving_k<k>` (`k = m`).
Grades: [L]; inherits [PROVISIONAL: covering] and [PROVISIONAL: counting tool] from the cases.  NOT covered: two or more movers, the cascade's path.
-/

open Classical

namespace Fresh.OneMover

open Fresh

/-- **S1, complete in this sense.** -/
theorem s1_all_landing (c x : ℝ) (m k : Fin 8) (hx : ∀ i : Fin 8, i ≠ m → x ≠ c + ((i : ℕ) : ℝ)) :
    ∃ a ∈ disparitySet (oneMover c x m) k, Lands (oneMover c x m) k a := by
  by_cases hkm : k = m
  · subst hkm
    have hx' : ∀ i : ℕ, i < 8 → i ≠ (k : ℕ) → x ≠ c + (i : ℝ) := by
      intro i hi hik
      exact hx ⟨i, hi⟩ (fun h => hik (by simpa using congrArg Fin.val h))
    fin_cases k
    · exact subject_moving_k0 c x hx'
    · exact subject_moving_k1 c x hx'
    · exact subject_moving_k2 c x hx'
    · exact subject_moving_k3 c x hx'
    · exact subject_moving_k4 c x hx'
    · exact subject_moving_k5 c x hx'
    · exact subject_moving_k6 c x hx'
    · exact subject_moving_k7 c x hx'
  · have hd0 : 0 < |x - (c + ((k : ℕ) : ℝ))| := by
      apply abs_pos.mpr
      intro h
      exact hx k hkm (by linarith)
    exact s1_nonsubject c x k m hkm hd0

#print axioms s1_all_landing

end Fresh.OneMover
