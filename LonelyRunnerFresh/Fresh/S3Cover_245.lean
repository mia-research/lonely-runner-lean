theorem fpieceM245_0 (s : ℝ) (h1 : (1/16 : ℝ) ≤ s) (h2 : s ≤ (7/40 : ℝ)) : FClear ({2, 4, 5} : Finset ℕ) s := by
  intro i hi
  simp only [Finset.mem_insert, Finset.mem_singleton] at hi
  rcases hi with rfl | rfl | rfl
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)

/-- [PROVISIONAL: covering] -/
theorem coverM245 (s : ℝ) (h0 : (1/16 : ℝ) ≤ s) (hR : s ≤ (7/40 : ℝ)) (hF : FClear ({2, 4, 5} : Finset ℕ) s) :
    ((1/16 : ℝ) ≤ s ∧ s ≤ (7/40 : ℝ)) := by
  rcases le_or_gt s (7/40 : ℝ) with d0 | d0
  · exact ⟨h0, d0⟩
  exact absurd hR (not_le.2 d0)

theorem landL3245_0 (d1 d2 d3 : ℝ) (hd1p : 0 < d1) (hd2p : 0 < d2) (hd3p : 0 < d3) (hex : ∃ t, (1/16 : ℝ) ≤ t ∧ t ≤ (7/40 : ℝ) ∧ Clear3 d1 d2 d3 t) :
    ∃ T, IsFirst (insert d1 (insert d2 (insert d3 (fset ({2, 4, 5} : Finset ℕ))))) T ∧ (1/16 : ℝ) ≤ T ∧ (1/16 : ℝ) ≤ T ∧ T ≤ (7/40 : ℝ) ∧ Clear3 d1 d2 d3 T ∧ ∀ s, (1/16 : ℝ) ≤ s → s < T → ¬ Clear3 d1 d2 d3 s := by
  have hamem := mem_insert3 (S := ({2, 4, 5} : Finset ℕ)) d1 d2 d3 (a := 2) (by decide)
  have key : ∀ T : ℝ, T ≤ (7/40 : ℝ) → FClear ({2, 4, 5} : Finset ℕ) T → Clear3 d1 d2 d3 T →
      (∀ s, (1/16 : ℝ) ≤ s → s ≤ (7/40 : ℝ) → s < T → FClear ({2, 4, 5} : Finset ℕ) s → Clear3 d1 d2 d3 s → False) →
      IsFirst (insert d1 (insert d2 (insert d3 (fset ({2, 4, 5} : Finset ℕ))))) T := by
    intro T hTr hF hC hmin
    refine ⟨(lonely_insert3_iff ({2, 4, 5} : Finset ℕ) d1 d2 d3 T).2 ⟨hF, hC⟩, ?_⟩
    intro s hs hlon
    have hs8' := lonely_geG hamem (by norm_num) hs hlon
    have hs8 : (1/16 : ℝ) ≤ s := by norm_num at hs8' ⊢; linarith
    rw [lonely_insert3_iff] at hlon
    by_contra hlt
    push Not at hlt
    exact hmin s hs8 (by linarith) hlt hlon.1 hlon.2
  obtain ⟨ts, hls, hrs, hcs⟩ := hex
  obtain ⟨T, hlT, hCT, hmin⟩ := first_three_clear hd1p hd2p hd3p (by norm_num : (0 : ℝ) < (1/16 : ℝ)) ⟨ts, hls, hcs⟩
  have hTr : T ≤ (7/40 : ℝ) := le_trans (hmin ts hls hcs) hrs
  refine ⟨T, key T hTr (fpieceM245_0 T hlT hTr) hCT ?_, by linarith, hlT, hTr, hCT, fun s hs hlt hc => absurd (hmin s hs hc) (not_le.2 hlt)⟩
  intro s h0 hR hlt hF hC
  rcases coverM245 s h0 (le_trans hR (by norm_num)) hF with ⟨a0, b0⟩
  · exact absurd (hmin s a0 hC) (not_le.2 hlt)

