theorem middle_partitions_all_subjects (c g h : ℝ) (p q : ℕ)
    (hp : 2≤p) (hq : 1≤q) (hpq : p+q≤6) (m a b : ℤ)
    (hm : 1≤ m) (hgpos : 0<g) (hhpos : 0<h) (hsmall : g+h≤2)
    (hg : 8*(a : ℝ)+1≤(8*(m : ℝ)+1)*g)
    (hh : 8*(b : ℝ)+1≤(8*(m : ℝ)+1)*h)
    (hsum : (8*(m : ℝ)+1)*(g+h)≤8*((a : ℝ)+(b : ℝ))+3) :
    ∀k : Fin 8, Isolation (speeds c g h p q) k := by
  by_cases hq2 : 2≤q
  · exact Fresh.ThreeBlockPartitions.partitions_all_subjects c g h p q hp hq2 hpq m a b hm hgpos hhpos hsmall hg hh hsum
  · have hq1 : q=1 := by omega
    subst q
    have hp5 : p≤5 := by omega
    interval_cases p
    · exact partition_215 c g h m a b hm hgpos hhpos hsmall hg hh hsum
    · exact partition_314 c g h m a b hm hgpos hhpos hsmall hg hh hsum
    · exact partition_413 c g h m a b hm hgpos hhpos hsmall hg hh hsum
    · exact partition_512 c g h m a b hm hgpos hhpos hsmall hg hh hsum

/-- Positive distinct speeds, nontrivial endpoint blocks and possibly singleton middle block, signed physical
scale/mirror, drift and arbitrary labels. -/
-- STANDING: DEFINITION
def ThreeBlockMiddlePartitionsClass (V : Fin 8→ℝ) : Prop :=
  (∀i,0<V i) ∧ Function.Injective V ∧
  ∃ (c g h B z : ℝ) (p q : ℕ) (m a b : ℤ) (σ : Equiv.Perm (Fin 8)),
    2≤p ∧ 1≤q ∧ p+q≤6 ∧ 1≤ m ∧ 0<g ∧ 0<h ∧ g+h≤2 ∧
    8*(a : ℝ)+1≤(8*(m : ℝ)+1)*g ∧
    8*(b : ℝ)+1≤(8*(m : ℝ)+1)*h ∧
    (8*(m : ℝ)+1)*(g+h)≤8*((a : ℝ)+(b : ℝ))+3 ∧ z≠0 ∧
    V=(fun i=>B+z*speeds c g h p q (σ i))

theorem threeBlockMiddlePartitions_isolation {V : Fin 8→ℝ}
    (h : ThreeBlockMiddlePartitionsClass V) (k : Fin 8) : Isolation V k := by
  obtain ⟨hpos,hinj,c,g,h,B,z,p,q,m,a,b,σ,hp,hq,hpq,hm,hgpos,hhpos,hsmall,hg,hh,hsum,hz,hV⟩ := h
  rw [hV]
  have hi := middle_partitions_all_subjects c g h p q hp hq hpq m a b hm hgpos hhpos hsmall hg hh hsum (σ k)
  have hi' := subject_isolation_affine B z hz hi
  exact (Fresh.isolation_comp_perm _ σ k).2 hi'

