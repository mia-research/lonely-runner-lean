total). -/
def bulkRows_28 : List BulkRow := bulkSeg_28_0 ++ bulkSeg_28_1 ++ bulkSeg_28_2 ++ bulkSeg_28_3 ++ bulkSeg_28_4 ++ bulkSeg_28_5 ++ bulkSeg_28_6 ++ bulkSeg_28_7 ++ bulkSeg_28_8 ++ bulkSeg_28_9 ++ bulkSeg_28_10 ++ bulkSeg_28_11 ++ bulkSeg_28_12 ++ bulkSeg_28_13

