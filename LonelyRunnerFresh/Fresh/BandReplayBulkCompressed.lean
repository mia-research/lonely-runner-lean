/-- The full compressed table. -/
def bulkTable : List BulkRow :=
  bulkRows_25 ++ bulkRows_26 ++ bulkRows_27 ++ bulkRows_28

/-- THE totality: every row of the full table satisfies the row condition —
decided per chunk, composed over the append. -/
theorem bulkTable_ok : bulkTable.all rowOKB = true :=
  by simp only [bulkTable, List.all_append, bulkRows_25_ok, bulkRows_26_ok,
      bulkRows_27_ok, bulkRows_28_ok, Bool.and_true]

/-- Membership implies the row condition. -/
theorem rowOK_of_mem {row : BulkRow} (hmem : row ∈ bulkTable) : rowOK row :=
  (rowOKB_iff row).mp (List.all_eq_true.mp bulkTable_ok row hmem)

/-- **The compressed band-bulk theorem (row form)**: any row of the table
certifies every arrangement in its cell box. -/
theorem bandBulk_25_29_rows {row : BulkRow} (hmem : row ∈ bulkTable)
    {g : Fin 7 → ℝ}
    (hbox : ∀ i, rowLo row i ≤ g i ∧ g i ≤ rowHi row i) : BandFixedR0 g :=
  bandBulk_of_rowOK row (rowOK_of_mem hmem) hbox

/-- The table membership, as a cell-tuple + clear-point lookup (the
task-suggested `InBulkBand` form). -/
def InBulkBand (k : Fin 7 → ℤ) (r : ℤ) : Prop :=
  ∃ row : BulkRow, row ∈ bulkTable ∧ rowK row = k ∧ row.r = r

/-- The upper cell tuple is `rowK + 1` off the pinned index (used to transfer
the caller's cell-box faces onto the row's faces). -/
theorem rowHiK_succ (row : BulkRow) (i : Fin 7) (hi : i.val ≠ 0) :
    rowHiK row i = rowK row i + 1 := by
  fin_cases i
  · exact absurd rfl hi
  · simp [rowHiK, rowK, Matrix.cons_val_zero, Matrix.cons_val_succ]
  · simp [rowHiK, rowK, Matrix.cons_val_zero, Matrix.cons_val_succ]
  · simp [rowHiK, rowK, Matrix.cons_val_zero, Matrix.cons_val_succ]
  · simp [rowHiK, rowK, Matrix.cons_val_zero, Matrix.cons_val_succ]
  · simp [rowHiK, rowK, Matrix.cons_val_zero, Matrix.cons_val_succ]
  · simp [rowHiK, rowK, Matrix.cons_val_zero, Matrix.cons_val_succ]

/-- **The compressed band-bulk theorem (tuple-membership form)**: a cell tuple
and clear point in the table certify every arrangement in the tuple's cell box
with ρ1 pinned to 1 (the pinned seventh reading is the certificate's own face).
The per-root certificate was decided once for the whole table, not per box —
the compression that replaces E916's ~70 h per-box projection. -/
theorem bandBulk_25_29 {k : Fin 7 → ℤ} {r : ℤ} (hmem : InBulkBand k r)
    {g : Fin 7 → ℝ}
    (hbox : ∀ i, ((k i : ℤ) : ℝ) ≤ g i ∧ g i ≤ (((k i + 1 : ℤ) : ℝ)))
    (hp : g 0 = 1) : BandFixedR0 g := by
  obtain ⟨row, hmemT, hkr, -⟩ := hmem
  refine bandBulk_of_rowOK row (rowOK_of_mem hmemT) ?_
  intro i
  have hi0 : i.val ≠ 0 ∨ i.val = 0 := by omega
  rcases hi0 with hi | hi
  · have hhi : rowHiK row i = rowK row i + 1 := rowHiK_succ row i hi
    rw [show rowLo row i = ((rowK row i : ℤ) : ℝ) from rfl,
        show rowHi row i = ((rowHiK row i : ℤ) : ℝ) from rfl, hhi, hkr]
    exact hbox i
  · have hi0 : i = 0 := by omega
    subst hi0
    norm_num [rowLo, rowHi, rowK, rowHiK, Matrix.cons_val_zero,
      Matrix.cons_val_succ, hp]

