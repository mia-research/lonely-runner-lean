theorem exists_below_2345 (d1 d2 : ℝ) (hd1 : 0 < d1) (hd : d1 ≤ d2) (ha : d1 ≤ (2 : ℝ)) :
    ∃ t, 0 < t ∧ FClear ({2, 3, 4, 5} : Finset ℕ) t ∧ Clear2 d1 d2 t := by
  rcases le_or_gt d1 (1/8 : ℝ) with c | b
  · exact small2345 d1 d2 hd1 c hd
  rcases le_or_gt d1 (1/4 : ℝ) with c0 | b0
  · exact col2345_0 d1 d2 (by linarith) c0 hd
  rcases le_or_gt d1 (1/2 : ℝ) with c1 | b1
  · exact col2345_1 d1 d2 (by linarith) c1 hd
  rcases le_or_gt d1 (1 : ℝ) with c2 | b2
  · exact col2345_2 d1 d2 (by linarith) c2 hd
  exact col2345_3 d1 d2 (by linarith) ha hd

