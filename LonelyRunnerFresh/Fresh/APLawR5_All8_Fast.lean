/-!
# The AP-neighbourhood landing law, all eight subjects, speeds within `1/8` (E765), on the heartbeat-raised core

Written 2026-11-06.  New file: `Fresh/APLawR5_All8.lean` (2026-11-02, another session, uncommitted, left
untouched) with the single import `Fresh.APLawR4_E_4_Arr` replaced by `Fresh.APLawR4_E_4_Arr_Fast` (which
pulls `apLawR4_E_4_core` from the 16000000-heartbeat `Fresh.APLawR4_E_4_Core_Fast`).  Everything else is
verbatim.  Owner (2026-11-02): *"We should be able to prove 1/8 of AP and further for grid if
the area is clear of its neighbour and that should work for all runner simutaniously."*  Speeds `v i` with
`|v i - (c + i)| <= 1/8`, every runner deviating at once (relative readings within `1/4`).
End subjects 0 and 7: `apLawR4_E_4_end_0`, `apLawR4_E_4_end_7` (GENERATED by `experiments/n8/ap_law_gen_r4_v2.py` from
the 1,130-leaf exact chamber tree of `ap_r4_chambers_v2.py E 4`).  Subjects 1 to 6: `ap_interior_firstIso_8`,
`ap_interior_lands_8` (E575).
`ap_nbhd_firstIso_8speed`: every subject has a first isolation instant.  `ap_nbhd_lands_8speed`: every subject has a
runner `j <> k` with `Lands v k |v j - v k|`.  `APNbhd8Class` and `apNbhd8_isolation`: the same at any AP step `d`
(speeds within `d/8` of `c + i·d`), the class form used by `AdmissiblePlus.APNbhdClass` at `d/16`.  Grades: [L].
-/

open Classical

namespace Fresh.OneMover

open Fresh

theorem ap_nbhd_firstIso_8speed (c : ℝ) (v : Fin 8 → ℝ) (hv : ∀ i : Fin 8, |v i - (c + ((i : ℕ) : ℝ))| ≤ 1 / 8)
    (k : Fin 8) : ∃ T : ℝ, 0 < T ∧ FirstIso v k T := by
  by_cases h0 : k = 0
  · subst h0
    obtain ⟨T, hT, hF, _⟩ := apLawR4_E_4_end_0 c v hv
    exact ⟨T, hT, hF⟩
  by_cases h7 : k = 7
  · subst h7
    obtain ⟨T, hT, hF, _⟩ := apLawR4_E_4_end_7 c v hv
    exact ⟨T, hT, hF⟩
  exact ap_interior_firstIso_8 c v hv k h0 h7

theorem ap_nbhd_lands_8speed (c : ℝ) (v : Fin 8 → ℝ) (hv : ∀ i : Fin 8, |v i - (c + ((i : ℕ) : ℝ))| ≤ 1 / 8)
    (k : Fin 8) : ∃ j : Fin 8, j ≠ k ∧ Lands v k |v j - v k| := by
  by_cases h0 : k = 0
  · subst h0
    obtain ⟨T, hT, hF, _⟩ := apLawR4_E_4_end_0 c v hv
    refine ⟨1, by decide, lands_of_first v 0 _ T ?_ hT hF⟩
    exact Finset.mem_image.mpr ⟨1, Finset.mem_erase.mpr ⟨by decide, Finset.mem_univ _⟩, rfl⟩
  by_cases h7 : k = 7
  · subst h7
    obtain ⟨T, hT, hF, _⟩ := apLawR4_E_4_end_7 c v hv
    refine ⟨6, by decide, lands_of_first v 7 _ T ?_ hT hF⟩
    exact Finset.mem_image.mpr ⟨6, Finset.mem_erase.mpr ⟨by decide, Finset.mem_univ _⟩, rfl⟩
  exact ap_interior_lands_8 c v hv k h0 h7

-- STANDING: DEFINITION
/-- Every speed within `d/8` of the AP `c + i·d`, all runners at once. -/
def APNbhd8Class (v : Fin 8 → ℝ) : Prop :=
  ∃ d c : ℝ, 0 < d ∧ ∀ i : Fin 8, |v i - (c + ((i : ℕ) : ℝ) * d)| ≤ d / 8

theorem apNbhd8_isolation {v : Fin 8 → ℝ} (h : APNbhd8Class v) (k : Fin 8) : Isolation v k := by
  obtain ⟨d, c, hd, hv⟩ := h
  have hu : ∀ i : Fin 8, |(fun j => v j / d) i - (c / d + ((i : ℕ) : ℝ))| ≤ 1 / 8 := by
    intro i
    have h1 := hv i
    show |v i / d - (c / d + ((i : ℕ) : ℝ))| ≤ 1 / 8
    have : v i / d - (c / d + ((i : ℕ) : ℝ)) = (v i - (c + ((i : ℕ) : ℝ) * d)) / d := by field_simp
    rw [this, abs_div, abs_of_pos hd, div_le_iff₀ hd]
    linarith
  obtain ⟨T, hT, hF⟩ := ap_nbhd_firstIso_8speed (c / d) (fun j => v j / d) hu k
  have hiso : Isolation (fun j => v j / d) k := ⟨T, hT, hF.1⟩
  have := Fresh.AdmissiblePlus.isolation_smul hd _ k hiso
  have e : (fun j => d * (v j / d)) = v := by funext j; field_simp
  rwa [e] at this

#print axioms ap_nbhd_firstIso_8speed
#print axioms ap_nbhd_lands_8speed
#print axioms apNbhd8_isolation

end Fresh.OneMover
