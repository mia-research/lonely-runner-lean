theorem landing_twoMoverBelow_123 (c x1 x2 : ℝ) (k m1 m2 : Fin 8) (hk1 : k ≠ m1) (hk2 : k ≠ m2) (h12 : m1 ≠ m2)
    (hS : Sdisp2 k m1 m2 = ({1, 2, 3} : Finset ℕ))
    (hd1 : 0 < |x1 - (c + ((k : ℕ) : ℝ))|) (hd2 : 0 < |x2 - (c + ((k : ℕ) : ℝ))|)
    (hmin : min |x1 - (c + ((k : ℕ) : ℝ))| |x2 - (c + ((k : ℕ) : ℝ))| ≤ (1 : ℝ)) :
    ∃ T : ℝ, 1 / (8 * min |x1 - (c + ((k : ℕ) : ℝ))| |x2 - (c + ((k : ℕ) : ℝ))|) ≤ T ∧
      IsFirst (disparitySet (twoMover c x1 x2 m1 m2) k) T ∧
      (∃ seq : ℕ → ℝ, seq 0 = 1 / (8 * min |x1 - (c + ((k : ℕ) : ℝ))| |x2 - (c + ((k : ℕ) : ℝ))|) ∧
        (∀ n, IsMove (disparitySet (twoMover c x1 x2 m1 m2) k) (seq n) (seq (n + 1))) ∧ ∃ N, seq (N + 1) = seq N) ∧
      ∀ seq : ℕ → ℝ, seq 0 = 1 / (8 * min |x1 - (c + ((k : ℕ) : ℝ))| |x2 - (c + ((k : ℕ) : ℝ))|) →
        (∀ n, IsMove (disparitySet (twoMover c x1 x2 m1 m2) k) (seq n) (seq (n + 1))) → ∀ N, seq (N + 1) = seq N → seq N = T := by
  rw [disparitySet_twoMover c x1 x2 k m1 m2 hk1 hk2 h12, hS]
  have hS1 : ∀ i ∈ ({1, 2, 3} : Finset ℕ), 1 ≤ i := by
    intro i hi
    simp only [Finset.mem_insert, Finset.mem_singleton] at hi
    rcases hi with rfl | rfl | rfl <;> norm_num
  refine landing_of_ex hS1 hd1 hd2 ?_
  rcases le_total |x1 - (c + ((k : ℕ) : ℝ))| |x2 - (c + ((k : ℕ) : ℝ))| with h | h
  · rw [min_eq_left h] at hmin
    exact exists_below_123 _ _ hd1 h hmin
  · rw [min_eq_right h] at hmin
    obtain ⟨t, ht, hF, hC⟩ := exists_below_123 _ _ hd2 h hmin
    exact ⟨t, ht, hF, clear2_symm hC⟩

