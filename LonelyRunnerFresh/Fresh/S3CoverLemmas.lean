/-!
# Three movers: witness lemmas for a common clear instant in an interval (S3Cover)

Written 2026-10-23.  New file.  Lemmas used by the `S3Cover_<set>` files to certify a box of mover triples `(d1, d2, d3)`:
* `clear3_swap12`, `clear3_swap23`: `Clear3` is invariant under permuting its three movers (generated by two adjacent swaps);
* `exists_clear3_perm`: a statement `∃ t, I t ∧ Clear3 x y z t` proved for sorted triples with `a ≤ x` holds for every triple with all entries `≥ a`;
* `wit3` (point witness): `d1 t`, `d2 t`, `d3 t` each inside a clear window `[n + 1/8, n + 7/8]`;
* `r2_rect` (**rule R2**): movers `da`, `db` are both clear on all of `[p, q] ⊆ [l, r]` (one window each) and `1 ≤ 4 dc (q - p)`:
  the third mover has a clear instant in `[p, q]` (`opening_close`, `firstPt`), hence a common clear instant in `[l, r]`;
* `r3_rect` (**rule R3**): mover `dX` is clear on all of `[p, q] ⊆ [l, r]` (one window) and the other two, `dY ≤ dZ` with `A ≤ dY`, satisfy
  `p + 1/A ≤ q`: `two_clear_in2` gives a common clear instant of `dY, dZ` in `[p, q]`, and `dX` is clear there;
* `big3` (rule H): the three movers all at least `D` with `l + 4/D ≤ r` (`three_clear_in_all`).
Grades: [L]; `r2_rect`, `r3_rect`, `big3` are **[PROVISIONAL: counting tool]** (a clear window of one mover against the period of another).
-/

open Classical

namespace Fresh.OneMover

open Fresh

theorem clear3_swap12 {a b c t : ℝ} (h : Clear3 a b c t) : Clear3 b a c t := ⟨h.2.1, h.1, h.2.2⟩

theorem clear3_swap23 {a b c t : ℝ} (h : Clear3 a b c t) : Clear3 a c b t := ⟨h.1, h.2.2, h.2.1⟩

/-- Sorted triples suffice. -/
theorem exists_clear3_perm {I : ℝ → Prop} {a : ℝ}
    (hs : ∀ x y z : ℝ, a ≤ x → x ≤ y → y ≤ z → ∃ t, I t ∧ Clear3 x y z t)
    (x y z : ℝ) (hx : a ≤ x) (hy : a ≤ y) (hz : a ≤ z) : ∃ t, I t ∧ Clear3 x y z t := by
  rcases le_total x y with h1 | h1 <;> rcases le_total y z with h2 | h2 <;> rcases le_total x z with h3 | h3
  · exact hs x y z hx h1 h2
  · exact hs x y z hx h1 h2
  · obtain ⟨t, ht, hc⟩ := hs x z y hx h3 h2
    exact ⟨t, ht, clear3_swap23 hc⟩
  · obtain ⟨t, ht, hc⟩ := hs z x y hz h3 h1
    exact ⟨t, ht, ⟨hc.2.1, hc.2.2, hc.1⟩⟩
  · obtain ⟨t, ht, hc⟩ := hs y x z hy h1 h3
    exact ⟨t, ht, clear3_swap12 hc⟩
  · obtain ⟨t, ht, hc⟩ := hs y z x hy h2 h3
    exact ⟨t, ht, ⟨hc.2.2, hc.1, hc.2.1⟩⟩
  · obtain ⟨t, ht, hc⟩ := hs z y x hz h2 h1
    exact ⟨t, ht, ⟨hc.2.2, hc.2.1, hc.1⟩⟩
  · obtain ⟨t, ht, hc⟩ := hs z y x hz h2 h1
    exact ⟨t, ht, ⟨hc.2.2, hc.2.1, hc.1⟩⟩

/-- A point witness. -/
theorem wit3 {d1 d2 d3 t : ℝ} (n1 n2 n3 : ℤ) (h1 : (n1 : ℝ) + 1 / 8 ≤ d1 * t) (h1' : d1 * t ≤ (n1 : ℝ) + 7 / 8)
    (h2 : (n2 : ℝ) + 1 / 8 ≤ d2 * t) (h2' : d2 * t ≤ (n2 : ℝ) + 7 / 8)
    (h3 : (n3 : ℝ) + 1 / 8 ≤ d3 * t) (h3' : d3 * t ≤ (n3 : ℝ) + 7 / 8) : Clear3 d1 d2 d3 t :=
  ⟨Fresh.Localisation.clear_of_window n1 h1 h1', Fresh.Localisation.clear_of_window n2 h2 h2',
    Fresh.Localisation.clear_of_window n3 h3 h3'⟩

/-- **Rule R2.**  `da` and `db` are clear on the whole of `[p, q]`, and `[p, q]` is at least `1/(4 dc)` long. -/
theorem r2_rect {da db dc l r p q : ℝ} (na nb : ℤ) (hda : 0 < da) (hdb : 0 < db) (hdc : 0 < dc) (hl : l ≤ p) (hr : q ≤ r)
    (h1 : (na : ℝ) + 1 / 8 ≤ da * p) (h2 : da * q ≤ (na : ℝ) + 7 / 8)
    (h3 : (nb : ℝ) + 1 / 8 ≤ db * p) (h4 : db * q ≤ (nb : ℝ) + 7 / 8) (hw : 1 ≤ 4 * dc * (q - p)) :
    ∃ t, l ≤ t ∧ t ≤ r ∧ (1 / 8 : ℝ) ≤ distInt (da * t) ∧ (1 / 8 : ℝ) ≤ distInt (db * t) ∧ (1 / 8 : ℝ) ≤ distInt (dc * t) := by
  have hq : 1 / (4 * dc) ≤ q - p := by
    rw [div_le_iff₀ (by positivity)]; nlinarith
  have hpq : p ≤ q := by
    have : 0 < 1 / (4 * dc) := by positivity
    linarith
  have hhold : Holds dc p q := by
    by_cases hc : (1 / 8 : ℝ) ≤ distInt (dc * p)
    · exact Or.inl hc
    · right
      have := opening_close hdc hc
      linarith
  obtain ⟨hcl, hl1, hl2, _⟩ := holds_clear hdc hpq hhold
  refine ⟨firstPt dc p, by linarith, by linarith, ?_, ?_, hcl⟩
  · apply Fresh.Localisation.clear_of_window na
    · have := mul_le_mul_of_nonneg_left hl1 hda.le; linarith
    · have := mul_le_mul_of_nonneg_left hl2 hda.le; linarith
  · apply Fresh.Localisation.clear_of_window nb
    · have := mul_le_mul_of_nonneg_left hl1 hdb.le; linarith
    · have := mul_le_mul_of_nonneg_left hl2 hdb.le; linarith

/-- **Rule R3.**  `dX` is clear on the whole of `[p, q]`; the other two movers `dY ≤ dZ`, `A ≤ dY`, and `p + 1/A ≤ q`. -/
theorem r3_rect {dX dY dZ A l r p q : ℝ} (n : ℤ) (hdX : 0 < dX) (hA : 0 < A) (hAY : A ≤ dY) (hYZ : dY ≤ dZ)
    (hl : l ≤ p) (hr : q ≤ r) (h1 : (n : ℝ) + 1 / 8 ≤ dX * p) (h2 : dX * q ≤ (n : ℝ) + 7 / 8) (hw : p + 1 / A ≤ q) :
    ∃ t, l ≤ t ∧ t ≤ r ∧ (1 / 8 : ℝ) ≤ distInt (dX * t) ∧ (1 / 8 : ℝ) ≤ distInt (dY * t) ∧ (1 / 8 : ℝ) ≤ distInt (dZ * t) := by
  have hY : 0 < dY := lt_of_lt_of_le hA hAY
  have hle : 1 / dY ≤ 1 / A := one_div_le_one_div_of_le hA hAY
  obtain ⟨t, ht1, ht2, hc⟩ := two_clear_in2 (l := p) (r := q) hY hYZ (by linarith)
  refine ⟨t, by linarith, by linarith, ?_, hc.1, hc.2⟩
  apply Fresh.Localisation.clear_of_window n
  · have := mul_le_mul_of_nonneg_left ht1 hdX.le; linarith
  · have := mul_le_mul_of_nonneg_left ht2 hdX.le; linarith

/-- All three movers at least `D`, and `l + 4/D ≤ r`. -/
theorem big3 {d1 d2 d3 l r D : ℝ} (hD : 0 < D) (hw : l + 4 / D ≤ r) (h1 : D ≤ d1) (h2 : D ≤ d2) (h3 : D ≤ d3) :
    ∃ t, l ≤ t ∧ t ≤ r ∧ Clear3 d1 d2 d3 t := by
  obtain ⟨t, a, b, c1, c2, c3⟩ := three_clear_in_all hD h1 h2 h3 hw
  exact ⟨t, a, b, c1, c2, c3⟩

