theorem coverM135 (s : ℝ) (h0 : (1/8 : ℝ) ≤ s) (hR : s ≤ (7/8 : ℝ)) (hF : FClear ({1, 3, 5} : Finset ℕ) s) :
    ((1/8 : ℝ) ≤ s ∧ s ≤ (7/40 : ℝ)) ∨ (((9/40 : ℝ) ≤ s ∧ s ≤ (7/24 : ℝ)) ∨ (((3/8 : ℝ) ≤ s ∧ s ≤ (3/8 : ℝ)) ∨ (((17/40 : ℝ) ≤ s ∧ s ≤ (23/40 : ℝ)) ∨ (((5/8 : ℝ) ≤ s ∧ s ≤ (5/8 : ℝ)) ∨ (((17/24 : ℝ) ≤ s ∧ s ≤ (31/40 : ℝ)) ∨ (((33/40 : ℝ) ≤ s ∧ s ≤ (7/8 : ℝ)))))))) := by
  rcases le_or_gt s (7/40 : ℝ) with d0 | d0
  · left; exact ⟨h0, d0⟩
  rcases lt_or_ge s (9/40 : ℝ) with g0 | d0g
  · exact absurd hF (gapM135_0 s d0 g0)
  rcases le_or_gt s (7/24 : ℝ) with d1 | d1
  · right; left; exact ⟨d0g, d1⟩
  rcases lt_or_ge s (3/8 : ℝ) with g1 | d1g
  · exact absurd hF (gapM135_1 s d1 g1)
  rcases le_or_gt s (3/8 : ℝ) with d2 | d2
  · right; right; left; exact ⟨d1g, d2⟩
  rcases lt_or_ge s (17/40 : ℝ) with g2 | d2g
  · exact absurd hF (gapM135_2 s d2 g2)
  rcases le_or_gt s (23/40 : ℝ) with d3 | d3
  · right; right; right; left; exact ⟨d2g, d3⟩
  rcases lt_or_ge s (5/8 : ℝ) with g3 | d3g
  · exact absurd hF (gapM135_3 s d3 g3)
  rcases le_or_gt s (5/8 : ℝ) with d4 | d4
  · right; right; right; right; left; exact ⟨d3g, d4⟩
  rcases lt_or_ge s (17/24 : ℝ) with g4 | d4g
  · exact absurd hF (gapM135_4 s d4 g4)
  rcases le_or_gt s (31/40 : ℝ) with d5 | d5
  · right; right; right; right; right; left; exact ⟨d4g, d5⟩
  rcases lt_or_ge s (33/40 : ℝ) with g5 | d5g
  · exact absurd hF (gapM135_5 s d5 g5)
  rcases le_or_gt s (7/8 : ℝ) with d6 | d6
  · right; right; right; right; right; right; exact ⟨d5g, d6⟩
  exact absurd hR (not_le.2 d6)

theorem landL3135_0 (d1 d2 d3 : ℝ) (hd1p : 0 < d1) (hd2p : 0 < d2) (hd3p : 0 < d3) (hex : ∃ t, (1/8 : ℝ) ≤ t ∧ t ≤ (7/40 : ℝ) ∧ Clear3 d1 d2 d3 t) :
    ∃ T, IsFirst (insert d1 (insert d2 (insert d3 (fset ({1, 3, 5} : Finset ℕ))))) T ∧ (1/8 : ℝ) ≤ T ∧ (1/8 : ℝ) ≤ T ∧ T ≤ (7/40 : ℝ) ∧ Clear3 d1 d2 d3 T ∧ ∀ s, (1/8 : ℝ) ≤ s → s < T → ¬ Clear3 d1 d2 d3 s := by
  have hamem := mem_insert3 (S := ({1, 3, 5} : Finset ℕ)) d1 d2 d3 (a := 1) (by decide)
  have key : ∀ T : ℝ, T ≤ (7/40 : ℝ) → FClear ({1, 3, 5} : Finset ℕ) T → Clear3 d1 d2 d3 T →
      (∀ s, (1/8 : ℝ) ≤ s → s ≤ (7/40 : ℝ) → s < T → FClear ({1, 3, 5} : Finset ℕ) s → Clear3 d1 d2 d3 s → False) →
      IsFirst (insert d1 (insert d2 (insert d3 (fset ({1, 3, 5} : Finset ℕ))))) T := by
    intro T hTr hF hC hmin
    refine ⟨(lonely_insert3_iff ({1, 3, 5} : Finset ℕ) d1 d2 d3 T).2 ⟨hF, hC⟩, ?_⟩
    intro s hs hlon
    have hs8' := lonely_geG hamem (by norm_num) hs hlon
    have hs8 : (1/8 : ℝ) ≤ s := by norm_num at hs8' ⊢; linarith
    rw [lonely_insert3_iff] at hlon
    by_contra hlt
    push Not at hlt
    exact hmin s hs8 (by linarith) hlt hlon.1 hlon.2
  obtain ⟨ts, hls, hrs, hcs⟩ := hex
  obtain ⟨T, hlT, hCT, hmin⟩ := first_three_clear hd1p hd2p hd3p (by norm_num : (0 : ℝ) < (1/8 : ℝ)) ⟨ts, hls, hcs⟩
  have hTr : T ≤ (7/40 : ℝ) := le_trans (hmin ts hls hcs) hrs
  refine ⟨T, key T hTr (fpieceM135_0 T hlT hTr) hCT ?_, by linarith, hlT, hTr, hCT, fun s hs hlt hc => absurd (hmin s hs hc) (not_le.2 hlt)⟩
  intro s h0 hR hlt hF hC
  rcases coverM135 s h0 (le_trans hR (by norm_num)) hF with ⟨a0, b0⟩ | ⟨a1, b1⟩ | ⟨a2, b2⟩ | ⟨a3, b3⟩ | ⟨a4, b4⟩ | ⟨a5, b5⟩ | ⟨a6, b6⟩
  · exact absurd (hmin s a0 hC) (not_le.2 hlt)
  · linarith
  · linarith
  · linarith
  · linarith
  · linarith
  · linarith

