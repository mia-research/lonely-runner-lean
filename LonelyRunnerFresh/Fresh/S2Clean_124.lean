      · exact ⟨(1/8 : ℝ), by norm_num, by norm_num, wit_pt (n1 := (0 : ℤ)) (n2 := (0 : ℤ)) (by push_cast; linarith) (by push_cast; linarith) (by push_cast; linarith) (by push_cast; linarith)⟩
      · -- d2 > 7
        exact r1_rect (n := (0 : ℤ)) (p := (1/7 : ℝ)) (q := (1/5 : ℝ)) hp1 hp2 (by norm_num) (by norm_num) (by push_cast; linarith) (by push_cast; linarith) (by linarith)
    · -- d1 > 3
      rcases le_or_gt d1 (4 : ℝ) with c2 | b2
      · -- column d1 in [3, 4]
        exact r1_rect (n := (0 : ℤ)) (p := (1/8 : ℝ)) (q := (3/14 : ℝ)) hp1 hp2 (by norm_num) (by norm_num) (by push_cast; linarith) (by push_cast; linarith) (by linarith)
      · -- d1 > 4
        rcases le_or_gt d1 (5 : ℝ) with c3 | b3
        · -- column d1 in [4, 5]
          rcases le_or_gt d2 (7 : ℝ) with e3_0 | f3_0
          · exact ⟨(1/8 : ℝ), by norm_num, by norm_num, wit_pt (n1 := (0 : ℤ)) (n2 := (0 : ℤ)) (by push_cast; linarith) (by push_cast; linarith) (by push_cast; linarith) (by push_cast; linarith)⟩
          · -- d2 > 7
            exact r1_rect (n := (0 : ℤ)) (p := (1/8 : ℝ)) (q := (4/23 : ℝ)) hp1 hp2 (by norm_num) (by norm_num) (by push_cast; linarith) (by push_cast; linarith) (by linarith)
        · -- d1 > 5
          rcases le_or_gt d1 (6 : ℝ) with c4 | b4
          · -- column d1 in [5, 6]
            rcases le_or_gt d2 (7 : ℝ) with e4_0 | f4_0
            · exact ⟨(1/8 : ℝ), by norm_num, by norm_num, wit_pt (n1 := (0 : ℤ)) (n2 := (0 : ℤ)) (by push_cast; linarith) (by push_cast; linarith) (by push_cast; linarith) (by push_cast; linarith)⟩
            · -- d2 > 7
              rcases le_or_gt d2 (71/8 : ℝ) with e4_1 | f4_1
              · obtain ⟨t, ha, hb, hc⟩ := r1_rect (d1 := d2) (d2 := d1) (l := (1/8 : ℝ)) (r := (7/32 : ℝ)) (n := (1 : ℤ)) (p := (9/56 : ℝ)) (q := (15/71 : ℝ)) hp2 hp1 (by norm_num) (by norm_num) (by push_cast; linarith) (by push_cast; linarith) (by linarith); exact ⟨t, ha, hb, clear2_symm hc⟩
              · -- d2 > 71/8
                rcases le_or_gt d2 (59/4 : ℝ) with e4_2 | f4_2
                · exact ⟨(8/63 : ℝ), by norm_num, by norm_num, wit_pt (n1 := (0 : ℤ)) (n2 := (1 : ℤ)) (by push_cast; linarith) (by push_cast; linarith) (by push_cast; linarith) (by push_cast; linarith)⟩
