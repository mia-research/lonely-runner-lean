theorem exists_common_clear_124 (d1 d2 : ℝ) (hd1 : (1 : ℝ) < d1) (hd2 : (1 : ℝ) < d2) :
    ∃ t, (1/8 : ℝ) ≤ t ∧ t ≤ (7/32 : ℝ) ∧ Clear2 d1 d2 t := by
  rcases le_total d1 d2 with h | h
  · exact core_124 d1 d2 hd1.le h
  · obtain ⟨t, a1, a2, a3⟩ := core_124 d2 d1 hd2.le h
    exact ⟨t, a1, a2, clear2_symm a3⟩

theorem land2_all_124 (d1 d2 : ℝ) (hd1 : (1 : ℝ) < d1) (hd2 : (1 : ℝ) < d2) :
    ∃ T, IsFirst (insert d1 (insert d2 (fset ({1, 2, 4} : Finset ℕ)))) T ∧ (1/8 : ℝ) ≤ T ∧
          (((1/8 : ℝ) ≤ T ∧ T ≤ (7/32 : ℝ) ∧ Clear2 d1 d2 T ∧ ∀ s, (1/8 : ℝ) ≤ s → s < T → ¬ Clear2 d1 d2 s)) := 
  land2C124 d1 d2 (by linarith) (by linarith) (exists_common_clear_124 d1 d2 hd1 hd2)

#print axioms exists_common_clear_124
#print axioms land2_all_124

