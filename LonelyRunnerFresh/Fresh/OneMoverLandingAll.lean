/-!
# The cascade's landing for the AP with one mover, every subject (GENERATED by `s1_gen_lean_landing_all_v1.py`)

Written 2026-10-22.  New file.  Speeds `c + i` (`i = 0..7`), runner `m` moved to `x`, subject `k ≠ m`.  The subject's
disparities are the frozen readings `Sdisp k m = {|i - k| : i ≠ k, m}` (a set of integers in `1..7`) and the mover's reading
`d = |x - (c + k)|`.  `Sdisp_cases`: for all 56 pairs `Sdisp k m` is one of sixteen sets.  For each of the sixteen,
`landingG<set>` (generated, one file each) gives the cascade's landing for every mover `d` beyond the least frozen reading;
this file transports it to the arrangement.  Grades: [L].  NOT covered here: the mover as the smallest disparity
(`d` at most the least frozen reading) and the mover as the subject (`m = k`).
-/

open Classical

namespace Fresh.OneMover

open Fresh

/-- The frozen disparities seen by subject `k` when runner `m` is the mover. -/
def Sdisp (k m : Fin 8) : Finset ℕ :=
  (((Finset.univ : Finset (Fin 8)).erase k).erase m).image (fun i : Fin 8 => (((i : ℕ) : ℤ) - ((k : ℕ) : ℤ)).natAbs)

theorem disparitySet_oneMover_general (c x : ℝ) (k m : Fin 8) (hkm : k ≠ m) :
    disparitySet (oneMover c x m) k = insert |x - (c + ((k : ℕ) : ℝ))| (fset (Sdisp k m)) := by
  ext d
  simp only [disparitySet, Finset.mem_image, Finset.mem_erase, Finset.mem_univ, and_true, Finset.mem_insert]
  rw [mem_fset]
  have hvk : oneMover c x m k = c + ((k : ℕ) : ℝ) := by simp [oneMover, hkm]
  constructor
  · rintro ⟨i, hik, rfl⟩
    by_cases him : i = m
    · left; rw [hvk]; simp [oneMover, him]
    · right
      refine ⟨(((i : ℕ) : ℤ) - ((k : ℕ) : ℤ)).natAbs, ?_, ?_⟩
      · unfold Sdisp
        simp only [Finset.mem_image, Finset.mem_erase, Finset.mem_univ, and_true]
        exact ⟨i, ⟨him, hik⟩, rfl⟩
      · have hvi : oneMover c x m i = c + ((i : ℕ) : ℝ) := by simp [oneMover, him]
        rw [hvi, hvk]
        have : (((((i : ℕ) : ℤ) - ((k : ℕ) : ℤ)).natAbs : ℕ) : ℝ) = |((i : ℕ) : ℝ) - ((k : ℕ) : ℝ)| := by
          push_cast [Nat.cast_natAbs, Int.cast_abs]; ring_nf
        rw [this]
        congr 1; ring
  · rintro (rfl | ⟨n, hn, rfl⟩)
    · refine ⟨m, ?_, ?_⟩
      · exact fun h => hkm h.symm
      · rw [hvk]; simp [oneMover]
    · unfold Sdisp at hn
      simp only [Finset.mem_image, Finset.mem_erase, Finset.mem_univ, and_true] at hn
      obtain ⟨i, ⟨him, hik⟩, rfl⟩ := hn
      refine ⟨i, hik, ?_⟩
      have hvi : oneMover c x m i = c + ((i : ℕ) : ℝ) := by simp [oneMover, him]
      rw [hvi, hvk]
      have : (((((i : ℕ) : ℤ) - ((k : ℕ) : ℤ)).natAbs : ℕ) : ℝ) = |((i : ℕ) : ℝ) - ((k : ℕ) : ℝ)| := by
        push_cast [Nat.cast_natAbs, Int.cast_abs]; ring_nf
      rw [this]
      congr 1; ring

theorem Sdisp_cases : ∀ k m : Fin 8, k ≠ m →
    Sdisp k m = ({1, 2, 3} : Finset ℕ) ∨
    Sdisp k m = ({1, 2, 3, 4} : Finset ℕ) ∨
    Sdisp k m = ({1, 2, 3, 5} : Finset ℕ) ∨
    Sdisp k m = ({1, 2, 4, 5} : Finset ℕ) ∨
    Sdisp k m = ({1, 2, 3, 4, 5} : Finset ℕ) ∨
    Sdisp k m = ({1, 2, 3, 4, 6} : Finset ℕ) ∨
    Sdisp k m = ({1, 2, 3, 5, 6} : Finset ℕ) ∨
    Sdisp k m = ({1, 2, 4, 5, 6} : Finset ℕ) ∨
    Sdisp k m = ({1, 3, 4, 5, 6} : Finset ℕ) ∨
    Sdisp k m = ({1, 2, 3, 4, 5, 6} : Finset ℕ) ∨
    Sdisp k m = ({1, 2, 3, 4, 5, 7} : Finset ℕ) ∨
    Sdisp k m = ({1, 2, 3, 4, 6, 7} : Finset ℕ) ∨
    Sdisp k m = ({1, 2, 3, 5, 6, 7} : Finset ℕ) ∨
    Sdisp k m = ({1, 2, 4, 5, 6, 7} : Finset ℕ) ∨
    Sdisp k m = ({1, 3, 4, 5, 6, 7} : Finset ℕ) ∨
    Sdisp k m = ({2, 3, 4, 5, 6, 7} : Finset ℕ) := by
  decide

/-- The cascade's landing at the arrangement, for the subjects whose frozen disparities are {1, 2, 3} and a mover farther than 1. -/
theorem landing_oneMover_G123 (c x : ℝ) (k m : Fin 8) (hkm : k ≠ m) (hS : Sdisp k m = ({1, 2, 3} : Finset ℕ))
    (hd : (1 : ℝ) < |x - (c + ((k : ℕ) : ℝ))|) :
    (∃ seq : ℕ → ℝ, seq 0 = 1 / (8 * (1 : ℝ)) ∧ (∀ n, IsMove (disparitySet (oneMover c x m) k) (seq n) (seq (n + 1))) ∧
      ∃ N, seq (N + 1) = seq N) ∧
    ∀ seq : ℕ → ℝ, seq 0 = 1 / (8 * (1 : ℝ)) → (∀ n, IsMove (disparitySet (oneMover c x m) k) (seq n) (seq (n + 1))) →
      ∀ N, seq (N + 1) = seq N → seq N = landG123 |x - (c + ((k : ℕ) : ℝ))| := by
  rw [disparitySet_oneMover_general c x k m hkm, hS]
  exact landingG123 _ hd

