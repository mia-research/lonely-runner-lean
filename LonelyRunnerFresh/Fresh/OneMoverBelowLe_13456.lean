noncomputable def nextFL13456 (t0 : ℝ) : ℝ := (⌊t0⌋₊ : ℝ) + nfoff13456 (t0 - (⌊t0⌋₊ : ℝ))

theorem nextFL13456_facts (t0 : ℝ) (ht0 : 0 ≤ t0) :
    t0 ≤ nextFL13456 t0 ∧ nextFL13456 t0 - t0 ≤ (1/4 : ℝ) ∧ FClear ({1, 3, 4, 5, 6} : Finset ℕ) (nextFL13456 t0) ∧
    (∀ s : ℝ, t0 ≤ s → s < nextFL13456 t0 → ¬ FClear ({1, 3, 4, 5, 6} : Finset ℕ) s) ∧
    ((∃ i ∈ ({1, 3, 4, 5, 6} : Finset ℕ), ∃ n : ℤ, (i : ℝ) * nextFL13456 t0 = n + 1/8) ∨ nextFL13456 t0 = t0) := by
  have f1 := Nat.floor_le ht0
  have f2 := Nat.lt_floor_add_one t0
  have hτ0 : 0 ≤ t0 - (⌊t0⌋₊ : ℝ) := by linarith
  have hτ1 : t0 - (⌊t0⌋₊ : ℝ) < 1 := by linarith
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · have := nfoff13456_ge _ hτ1; unfold nextFL13456; linarith
  · have := nfoff13456_gap _ hτ0 hτ1; unfold nextFL13456; linarith
  · have := fclearBL13456_shift _ ⌊t0⌋₊ (nfoff13456_clear _ hτ0 hτ1)
    unfold nextFL13456; rw [add_comm]; exact this
  · intro s hs1 hs2 hF
    have hF' : FClear ({1, 3, 4, 5, 6} : Finset ℕ) ((s - (⌊t0⌋₊ : ℝ)) + (⌊t0⌋₊ : ℕ)) := by
      have e : (s - (⌊t0⌋₊ : ℝ)) + ((⌊t0⌋₊ : ℕ) : ℝ) = s := by ring
      rw [e]; exact hF
    unfold nextFL13456 at hs2
    exact nfoff13456_min _ hτ0 hτ1 (s - (⌊t0⌋₊ : ℝ)) (by linarith) (by linarith) (fclearBL13456_unshift _ _ hF')
  · rcases nfoff13456_open _ hτ0 hτ1 with ⟨i, hi, n, hn⟩ | hn
    · left
      refine ⟨i, hi, n + (i : ℤ) * (⌊t0⌋₊ : ℤ), ?_⟩
      unfold nextFL13456
      push_cast
      have : (i : ℝ) * ((⌊t0⌋₊ : ℝ) + nfoff13456 (t0 - (⌊t0⌋₊ : ℝ))) = (i : ℝ) * (⌊t0⌋₊ : ℝ) + (i : ℝ) * nfoff13456 (t0 - (⌊t0⌋₊ : ℝ)) := by ring
      rw [this, hn]; ring
    · right; unfold nextFL13456; rw [hn]; ring

/-- **The landing with the mover below the frozen minimum.** -/
theorem landSpecBelowLe13456 (ρ : ℝ) (h0 : 0 < ρ) (ha : ρ ≤ 1) :
    IsFirst (insert ρ (fset ({1, 3, 4, 5, 6} : Finset ℕ))) (nextFL13456 (1 / (8 * ρ))) ∧ 1 / (8 * ρ) ≤ nextFL13456 (1 / (8 * ρ)) ∧
    ((∃ i ∈ ({1, 3, 4, 5, 6} : Finset ℕ), ∃ n : ℤ, (i : ℝ) * nextFL13456 (1 / (8 * ρ)) = n + 1/8) ∨ ρ * nextFL13456 (1 / (8 * ρ)) = 1/8) := by
  have ht0 : 0 < 1 / (8 * ρ) := by positivity
  obtain ⟨hge, hgap, hcl, hmin, hop⟩ := nextFL13456_facts _ ht0.le
  have hρt : ρ * (1 / (8 * ρ)) = 1 / 8 := by field_simp
  have hmov1 : (1 / 8 : ℝ) ≤ ρ * nextFL13456 (1 / (8 * ρ)) := by nlinarith
  have hmov2 : ρ * nextFL13456 (1 / (8 * ρ)) ≤ 7 / 8 := by nlinarith
  have hmov : (1 / 8 : ℝ) ≤ distInt (ρ * nextFL13456 (1 / (8 * ρ))) :=
    Fresh.Localisation.clear_of_window 0 (by push_cast; linarith) (by push_cast; linarith)
  refine ⟨⟨(lonely_insert_iffG ({1, 3, 4, 5, 6} : Finset ℕ) ρ _).2 ⟨hcl, hmov⟩, ?_⟩, hge, ?_⟩
  · intro s hs hlon
    have hρm : ρ ∈ insert ρ (fset ({1, 3, 4, 5, 6} : Finset ℕ)) := Finset.mem_insert_self _ _
    have hb := lonely_geG hρm h0 hs hlon
    rw [lonely_insert_iffG] at hlon
    by_contra hlt
    push Not at hlt
    exact hmin s hb hlt hlon.1
  · rcases hop with h | h
    · left; exact h
    · right; rw [h]; exact hρt

theorem landingBelowLe13456 (ρ : ℝ) (h0 : 0 < ρ) (ha : ρ ≤ 1) :
    (∃ seq : ℕ → ℝ, seq 0 = 1 / (8 * ρ) ∧ (∀ n, IsMove (insert ρ (fset ({1, 3, 4, 5, 6} : Finset ℕ))) (seq n) (seq (n + 1))) ∧ ∃ N, seq (N + 1) = seq N) ∧
      ∀ seq : ℕ → ℝ, seq 0 = 1 / (8 * ρ) → (∀ n, IsMove (insert ρ (fset ({1, 3, 4, 5, 6} : Finset ℕ))) (seq n) (seq (n + 1))) →
        ∀ N, seq (N + 1) = seq N → seq N = nextFL13456 (1 / (8 * ρ)) := by
  obtain ⟨hf, hge, _⟩ := landSpecBelowLe13456 ρ h0 ha
  have hpos := pos_insertG (S := ({1, 3, 4, 5, 6} : Finset ℕ)) (by intro i hi; simp only [Finset.mem_insert, Finset.mem_singleton] at hi; rcases hi with rfl | rfl | rfl | rfl | rfl <;> norm_num) (ρ := ρ) h0
  have hρm : ρ ∈ insert ρ (fset ({1, 3, 4, 5, 6} : Finset ℕ)) := Finset.mem_insert_self _ _
  have ht0 : 0 < 1 / (8 * ρ) := by positivity
  exact cascade_landsG hpos hρm (lt_of_lt_of_le ht0 hge) hf

