-- STANDING: DEFINITION
def ThreeBlockNearGridClass (V : Fin 8 → ℝ) : Prop := 
  (∀i,0 < V i) ∧ Function.Injective V ∧
  ∃(c g h B a : ℝ)(m : ℤ)(σ : Equiv.Perm (Fin 8)),
    1 ≤ m ∧ 0 < g ∧ 8*(m : ℝ)*g = 1 ∧ g ≤ h ∧ h ≤ 3*g/2 ∧ a≠0 ∧
    V = (fun i  => B+a*speeds c g h (σ i))

theorem threeBlockNearGrid_isolation {V : Fin 8 → ℝ}
    (h : ThreeBlockNearGridClass V)(k : Fin 8) : Isolation V k :=  by
  obtain ⟨hpos,hinj,c,g,h,B,a,m,σ,hm,hg,hgrid,hlo,hhi,ha,hV⟩ :=  h
  rw [hV]
  have hi :=  grid_all_subjects c g h m hm hg hgrid hlo hhi (σ k)
  have hi' :=  subject_isolation_affine B a ha hi
  exact (Fresh.isolation_comp_perm _ σ k).2 hi'

