open Fresh

/-- The frozen set [1, 2, 3, 4, 5, 6] is clear on piece 0, `[1/8, 7/48]`. -/
theorem fpieceG123456_0 (s : ℝ) (h1 : (1/8 : ℝ) ≤ s) (h2 : s ≤ (7/48 : ℝ)) : FClear ({1, 2, 3, 4, 5, 6} : Finset ℕ) s := by
  intro i hi
  simp only [Finset.mem_insert, Finset.mem_singleton] at hi
  rcases hi with rfl | rfl | rfl | rfl | rfl | rfl
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)

