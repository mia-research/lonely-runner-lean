theorem fpieceG123456_1 (s : ℝ) (h1 : (9/32 : ℝ) ≤ s) (h2 : s ≤ (7/24 : ℝ)) : FClear ({1, 2, 3, 4, 5, 6} : Finset ℕ) s := by
  intro i hi
