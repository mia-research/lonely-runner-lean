/-- No instant of the open gap `(7/48, 9/32)` between pieces 0 and 1 is clear for the frozen set. -/
theorem gapG123456_0 (s : ℝ) (ha : (7/48 : ℝ) < s) (hb : s < (9/32 : ℝ)) : ¬ FClear ({1, 2, 3, 4, 5, 6} : Finset ℕ) s := by
  rcases lt_or_ge s (3/16 : ℝ) with c1 | c1
  · exact fnot ({1, 2, 3, 4, 5, 6} : Finset ℕ) 6 (by decide) 1 s (by push_cast; linarith) (by push_cast; linarith)
  rcases lt_or_ge s (9/40 : ℝ) with c2 | c2
  · exact fnot ({1, 2, 3, 4, 5, 6} : Finset ℕ) 5 (by decide) 1 s (by push_cast; linarith) (by push_cast; linarith)
  exact fnot ({1, 2, 3, 4, 5, 6} : Finset ℕ) 4 (by decide) 1 s (by push_cast; linarith) (by push_cast; linarith)

/-- No instant of the open gap `(7/24, 3/8)` between pieces 1 and 2 is clear for the frozen set. -/
theorem gapG123456_1 (s : ℝ) (ha : (7/24 : ℝ) < s) (hb : s < (3/8 : ℝ)) : ¬ FClear ({1, 2, 3, 4, 5, 6} : Finset ℕ) s := by
  exact fnot ({1, 2, 3, 4, 5, 6} : Finset ℕ) 3 (by decide) 1 s (by push_cast; linarith) (by push_cast; linarith)

/-- Every instant in `[1/8, 3/8]` clear for the frozen set lies in a listed piece. [PROVISIONAL: covering] -/
theorem coverG123456 (s : ℝ) (h0 : (1/8 : ℝ) ≤ s) (hR : s ≤ (3/8 : ℝ)) (hF : FClear ({1, 2, 3, 4, 5, 6} : Finset ℕ) s) :
    ((1/8 : ℝ) ≤ s ∧ s ≤ (7/48 : ℝ)) ∨ (((9/32 : ℝ) ≤ s ∧ s ≤ (7/24 : ℝ)) ∨ (((3/8 : ℝ) ≤ s ∧ s ≤ (3/8 : ℝ)))) := by
  rcases le_or_gt s (7/48 : ℝ) with d0 | d0
  · left; exact ⟨h0, d0⟩
  rcases lt_or_ge s (9/32 : ℝ) with g0 | d0g
  · exact absurd hF (gapG123456_0 s d0 g0)
  rcases le_or_gt s (7/24 : ℝ) with d1 | d1
  · right; left; exact ⟨d0g, d1⟩
  rcases lt_or_ge s (3/8 : ℝ) with g1 | d1g
  · exact absurd hF (gapG123456_1 s d1 g1)
  rcases le_or_gt s (3/8 : ℝ) with d2 | d2
  · right; right; exact ⟨d1g, d2⟩
  exact absurd hR (not_le.2 d2)

/-- Some listed piece holds a clear point of the mover, for every ρ > 1.  [PROVISIONAL: counting tool] -/
theorem holdG123456_exists (ρ : ℝ) (hρ : (1 : ℝ) < ρ) :
    Holds ρ (1/8 : ℝ) (7/48 : ℝ) ∨ Holds ρ (9/32 : ℝ) (7/24 : ℝ) ∨ Holds ρ (3/8 : ℝ) (3/8 : ℝ) := by
  by_contra hcon
  push Not at hcon
  obtain ⟨c0, c1, c2⟩ := hcon
  have hρ0 : 0 < ρ := by linarith
  have hw := not_holds_len hρ0 (by norm_num : (1/8 : ℝ) ≤ (7/48 : ℝ)) c0
  have hB : ρ < 13 := by nlinarith
  obtain ⟨N0, a0, b0⟩ := not_holds_win hρ0 c0
  have lo0 : (1 : ℤ) ≤ N0 := int_ge_of_real (by push_cast; nlinarith)
  have hi0 : N0 ≤ (1 : ℤ) := int_le_of_real (by push_cast; nlinarith)
  obtain ⟨N1, a1, b1⟩ := not_holds_win hρ0 c1
  have lo1 : (1 : ℤ) ≤ N1 := int_ge_of_real (by push_cast; nlinarith)
  have hi1 : N1 ≤ (3 : ℤ) := int_le_of_real (by push_cast; nlinarith)
  obtain ⟨N2, a2, b2⟩ := not_holds_win hρ0 c2
  have lo2 : (1 : ℤ) ≤ N2 := int_ge_of_real (by push_cast; nlinarith)
  have hi2 : N2 ≤ (4 : ℤ) := int_le_of_real (by push_cast; nlinarith)
  interval_cases N0 <;> interval_cases N1 <;> interval_cases N2 <;> (push_cast at *; linarith)

/-- The landing: the first piece the mover can hold, at its first clear point. -/
noncomputable def landG123456 (ρ : ℝ) : ℝ :=
  if Holds ρ (1/8 : ℝ) (7/48 : ℝ) then firstPt ρ (1/8 : ℝ) else if Holds ρ (9/32 : ℝ) (7/24 : ℝ) then firstPt ρ (9/32 : ℝ) else firstPt ρ (3/8 : ℝ)

/-- The landing is the first lonely instant, at least `1/8`, and the opening of a named runner: a frozen runner `(i, j)`
(it stands at exactly `1/8` past lap `j`) when the mover is clear at the left end of the holding piece, else the mover. -/
theorem landSpecG123456 (ρ : ℝ) (hρ : (1 : ℝ) < ρ) :
    IsFirst (insert ρ (fset ({1, 2, 3, 4, 5, 6} : Finset ℕ))) (landG123456 ρ) ∧ (1/8 : ℝ) ≤ landG123456 ρ ∧
    (((Holds ρ (1/8 : ℝ) (7/48 : ℝ) ∧ (1/8 : ℝ) ≤ distInt (ρ * (1/8 : ℝ)) ∧ landG123456 ρ = (1/8 : ℝ) ∧ (1 : ℝ) * (1/8 : ℝ) = 0 + 1/8) ∨ (Holds ρ (1/8 : ℝ) (7/48 : ℝ) ∧ ¬ ((1/8 : ℝ) ≤ distInt (ρ * (1/8 : ℝ))) ∧ landG123456 ρ = (((round (ρ * (1/8 : ℝ)) : ℤ) : ℝ) + 1/8) / ρ)) ∨ ((Holds ρ (9/32 : ℝ) (7/24 : ℝ) ∧ ¬ Holds ρ (1/8 : ℝ) (7/48 : ℝ) ∧ (1/8 : ℝ) ≤ distInt (ρ * (9/32 : ℝ)) ∧ landG123456 ρ = (9/32 : ℝ) ∧ (4 : ℝ) * (9/32 : ℝ) = 1 + 1/8) ∨ (Holds ρ (9/32 : ℝ) (7/24 : ℝ) ∧ ¬ Holds ρ (1/8 : ℝ) (7/48 : ℝ) ∧ ¬ ((1/8 : ℝ) ≤ distInt (ρ * (9/32 : ℝ))) ∧ landG123456 ρ = (((round (ρ * (9/32 : ℝ)) : ℤ) : ℝ) + 1/8) / ρ)) ∨ ((Holds ρ (3/8 : ℝ) (3/8 : ℝ) ∧ ¬ Holds ρ (1/8 : ℝ) (7/48 : ℝ) ∧ ¬ Holds ρ (9/32 : ℝ) (7/24 : ℝ) ∧ (1/8 : ℝ) ≤ distInt (ρ * (3/8 : ℝ)) ∧ landG123456 ρ = (3/8 : ℝ) ∧ (3 : ℝ) * (3/8 : ℝ) = 1 + 1/8) ∨ (Holds ρ (3/8 : ℝ) (3/8 : ℝ) ∧ ¬ Holds ρ (1/8 : ℝ) (7/48 : ℝ) ∧ ¬ Holds ρ (9/32 : ℝ) (7/24 : ℝ) ∧ ¬ ((1/8 : ℝ) ≤ distInt (ρ * (3/8 : ℝ))) ∧ landG123456 ρ = (((round (ρ * (3/8 : ℝ)) : ℤ) : ℝ) + 1/8) / ρ))) := by
  have hρ0 : 0 < ρ := by linarith
  have hex := holdG123456_exists ρ hρ
  have hamem := mem_insertG (S := ({1, 2, 3, 4, 5, 6} : Finset ℕ)) ρ (a := 1) (by decide)
  unfold landG123456 IsFirst
  by_cases h0 : Holds ρ (1/8 : ℝ) (7/48 : ℝ)
  · rw [if_pos h0]
    obtain ⟨hc, hl, hr, hin⟩ := holds_clear hρ0 (by norm_num : (1/8 : ℝ) ≤ (7/48 : ℝ)) h0
    have hTpos : (1/8 : ℝ) ≤ firstPt ρ (1/8 : ℝ) := by linarith
    have hfz := fpieceG123456_0 _ hl hr
    refine ⟨⟨(lonely_insert_iffG ({1, 2, 3, 4, 5, 6} : Finset ℕ) ρ _).2 ⟨hfz, hc⟩, ?_⟩, hTpos, ?_⟩
    · intro s hs hlon
      have hs8' := lonely_geG hamem (by norm_num) hs hlon
      have hs8 : (1/8 : ℝ) ≤ s := by norm_num at hs8' ⊢; linarith
      rw [lonely_insert_iffG] at hlon
      obtain ⟨hF, hm⟩ := hlon
      by_contra hlt
      push Not at hlt
      have hsR : s ≤ (3/8 : ℝ) := by linarith
      rcases coverG123456 s hs8 hsR hF with ⟨a0, b0⟩ | ⟨a1, b1⟩ | ⟨a2, b2⟩
      · exact absurd hm (not_le.2 (hin s a0 hlt))
      · linarith
      · linarith
    · by_cases hcl : (1/8 : ℝ) ≤ distInt (ρ * (1/8 : ℝ))
      · left; left; refine ⟨h0, hcl, ?_⟩
        have e : firstPt ρ (1/8 : ℝ) = (1/8 : ℝ) := by unfold firstPt; rw [if_pos hcl]
        exact ⟨e, by norm_num⟩
      · left; right; refine ⟨h0, hcl, ?_⟩
        unfold firstPt; rw [if_neg hcl]
  rw [if_neg h0]
  by_cases h1 : Holds ρ (9/32 : ℝ) (7/24 : ℝ)
  · rw [if_pos h1]
    obtain ⟨hc, hl, hr, hin⟩ := holds_clear hρ0 (by norm_num : (9/32 : ℝ) ≤ (7/24 : ℝ)) h1
    have hTpos : (1/8 : ℝ) ≤ firstPt ρ (9/32 : ℝ) := by linarith
    have hfz := fpieceG123456_1 _ hl hr
    refine ⟨⟨(lonely_insert_iffG ({1, 2, 3, 4, 5, 6} : Finset ℕ) ρ _).2 ⟨hfz, hc⟩, ?_⟩, hTpos, ?_⟩
    · intro s hs hlon
      have hs8' := lonely_geG hamem (by norm_num) hs hlon
      have hs8 : (1/8 : ℝ) ≤ s := by norm_num at hs8' ⊢; linarith
      rw [lonely_insert_iffG] at hlon
      obtain ⟨hF, hm⟩ := hlon
      by_contra hlt
      push Not at hlt
      have hsR : s ≤ (3/8 : ℝ) := by linarith
      rcases coverG123456 s hs8 hsR hF with ⟨a0, b0⟩ | ⟨a1, b1⟩ | ⟨a2, b2⟩
      · exact absurd hm (not_le.2 (not_holds_inWay hρ0 (by norm_num) h0 s a0 b0))
      · exact absurd hm (not_le.2 (hin s a1 hlt))
      · linarith
    · by_cases hcl : (1/8 : ℝ) ≤ distInt (ρ * (9/32 : ℝ))
      · right; left; left; refine ⟨h1, h0, hcl, ?_⟩
        have e : firstPt ρ (9/32 : ℝ) = (9/32 : ℝ) := by unfold firstPt; rw [if_pos hcl]
        exact ⟨e, by norm_num⟩
      · right; left; right; refine ⟨h1, h0, hcl, ?_⟩
        unfold firstPt; rw [if_neg hcl]
  rw [if_neg h1]
  have h2 : Holds ρ (3/8 : ℝ) (3/8 : ℝ) := by
    rcases hex with x0 | x1 | x2
    · exact absurd x0 h0
    · exact absurd x1 h1
    · exact x2
  obtain ⟨hc, hl, hr, hin⟩ := holds_clear hρ0 (by norm_num : (3/8 : ℝ) ≤ (3/8 : ℝ)) h2
  have hTpos : (1/8 : ℝ) ≤ firstPt ρ (3/8 : ℝ) := by linarith
  have hfz := fpieceG123456_2 _ hl hr
  refine ⟨⟨(lonely_insert_iffG ({1, 2, 3, 4, 5, 6} : Finset ℕ) ρ _).2 ⟨hfz, hc⟩, ?_⟩, hTpos, ?_⟩
  · intro s hs hlon
    have hs8' := lonely_geG hamem (by norm_num) hs hlon
    have hs8 : (1/8 : ℝ) ≤ s := by norm_num at hs8' ⊢; linarith
    rw [lonely_insert_iffG] at hlon
    obtain ⟨hF, hm⟩ := hlon
    by_contra hlt
    push Not at hlt
    have hsR : s ≤ (3/8 : ℝ) := by linarith
    rcases coverG123456 s hs8 hsR hF with ⟨a0, b0⟩ | ⟨a1, b1⟩ | ⟨a2, b2⟩
    · exact absurd hm (not_le.2 (not_holds_inWay hρ0 (by norm_num) h0 s a0 b0))
    · exact absurd hm (not_le.2 (not_holds_inWay hρ0 (by norm_num) h1 s a1 b1))
    · exact absurd hm (not_le.2 (hin s a2 hlt))
  · by_cases hcl : (1/8 : ℝ) ≤ distInt (ρ * (3/8 : ℝ))
    · right; right; left; refine ⟨h2, h0, h1, hcl, ?_⟩
      have e : firstPt ρ (3/8 : ℝ) = (3/8 : ℝ) := by unfold firstPt; rw [if_pos hcl]
      exact ⟨e, by norm_num⟩
    · right; right; right; refine ⟨h2, h0, h1, hcl, ?_⟩
      unfold firstPt; rw [if_neg hcl]

theorem landingG123456 (ρ : ℝ) (hρ : (1 : ℝ) < ρ) :
    (∃ seq : ℕ → ℝ, seq 0 = 1 / (8 * (1 : ℝ)) ∧ (∀ n, IsMove (insert ρ (fset ({1, 2, 3, 4, 5, 6} : Finset ℕ))) (seq n) (seq (n + 1))) ∧ ∃ N, seq (N + 1) = seq N) ∧
      ∀ seq : ℕ → ℝ, seq 0 = 1 / (8 * (1 : ℝ)) → (∀ n, IsMove (insert ρ (fset ({1, 2, 3, 4, 5, 6} : Finset ℕ))) (seq n) (seq (n + 1))) →
        ∀ N, seq (N + 1) = seq N → seq N = landG123456 ρ := by
  obtain ⟨hf, hge, _⟩ := landSpecG123456 ρ hρ
  have hpos := pos_insertG (S := ({1, 2, 3, 4, 5, 6} : Finset ℕ)) (by intro i hi; simp only [Finset.mem_insert, Finset.mem_singleton] at hi; rcases hi with rfl | rfl | rfl | rfl | rfl | rfl <;> norm_num) (ρ := ρ) (by linarith)
  have hamem := mem_insertG (S := ({1, 2, 3, 4, 5, 6} : Finset ℕ)) ρ (a := 1) (by decide)
  have := cascade_landsG hpos hamem (T := landG123456 ρ) (lt_of_lt_of_le (by norm_num) hge) hf
  simpa using this

