-- STANDING: DEFINITION
def ThreeBlockGridTriangleClass (V : Fin 8 → ℝ) : Prop :=
  (∀i,0<V i) ∧ Function.Injective V ∧
  ∃(c g h B a : ℝ)(m : ℤ)(σ : Equiv.Perm (Fin 8)),
    1 ≤ m ∧ 1 ≤ (8*(m : ℝ)+1)*g ∧ 1 ≤ (8*(m : ℝ)+1)*h ∧
    (8*(m : ℝ)+1)*(g+h) ≤ 3 ∧ a≠0 ∧
    V=(fun i => B+a*speeds c g h (σ i))

theorem threeBlockGridTriangle_isolation {V : Fin 8 → ℝ}
    (h : ThreeBlockGridTriangleClass V)(k : Fin 8) : Isolation V k := by
  obtain ⟨hpos,hinj,c,g,h,B,a,m,σ,hm,hg,hh,hsum,ha,hV⟩ := h
  rw [hV]
  have hi := grid_triangle_all_subjects c g h m hm hg hh hsum (σ k)
  have hi' := subject_isolation_affine B a ha hi
  exact (Fresh.isolation_comp_perm _ σ k).2 hi'

#print axioms grid_triangle_all_subjects
#print axioms threeBlockGridTriangle_isolation
