open Classical

namespace Fresh.OneMover

open Fresh

theorem core_234 (d1 d2 : ℝ) (h0 : (2 : ℝ) ≤ d1) (hd : d1 ≤ d2) :
    ∃ t, (1/16 : ℝ) ≤ t ∧ t ≤ (7/32 : ℝ) ∧ Clear2 d1 d2 t := by
  have hp1 : 0 < d1 := by linarith
  have hp2 : 0 < d2 := by linarith
  rcases le_or_gt d1 (3 : ℝ) with c0 | b0
  · -- column d1 in [2, 3]
    exact r1_rect (n := (0 : ℤ)) (p := (1/13 : ℝ)) (q := (3/14 : ℝ)) hp1 hp2 (by norm_num) (by norm_num) (by push_cast; linarith) (by push_cast; linarith) (by linarith)
  · -- d1 > 3
    rcases le_or_gt d1 (4 : ℝ) with c1 | b1
    · -- column d1 in [3, 4]
      exact r1_rect (n := (0 : ℤ)) (p := (1/11 : ℝ)) (q := (1/5 : ℝ)) hp1 hp2 (by norm_num) (by norm_num) (by push_cast; linarith) (by push_cast; linarith) (by linarith)
    · -- d1 > 4
      rcases le_or_gt d1 (5 : ℝ) with c2 | b2
      · -- column d1 in [4, 5]
        exact r1_rect (n := (0 : ℤ)) (p := (1/12 : ℝ)) (q := (1/6 : ℝ)) hp1 hp2 (by norm_num) (by norm_num) (by push_cast; linarith) (by push_cast; linarith) (by linarith)
      · -- d1 > 5
        rcases le_or_gt d1 (6 : ℝ) with c3 | b3
        · -- column d1 in [5, 6]
          exact r1_rect (n := (0 : ℤ)) (p := (1/13 : ℝ)) (q := (1/7 : ℝ)) hp1 hp2 (by norm_num) (by norm_num) (by push_cast; linarith) (by push_cast; linarith) (by linarith)
        · -- d1 > 6
          rcases le_or_gt d1 (7 : ℝ) with c4 | b4
          · -- column d1 in [6, 7]
            exact r1_rect (n := (0 : ℤ)) (p := (1/14 : ℝ)) (q := (1/8 : ℝ)) hp1 hp2 (by norm_num) (by norm_num) (by push_cast; linarith) (by push_cast; linarith) (by linarith)
          · -- d1 > 7
            exact big_both (D := (7 : ℝ)) (l := (1/16 : ℝ)) (r := (7/32 : ℝ)) (by norm_num) (by norm_num) (by linarith) (by linarith)

theorem exists_common_clear_234 (d1 d2 : ℝ) (hd1 : (2 : ℝ) < d1) (hd2 : (2 : ℝ) < d2) :
    ∃ t, (1/16 : ℝ) ≤ t ∧ t ≤ (7/32 : ℝ) ∧ Clear2 d1 d2 t := by
  rcases le_total d1 d2 with h | h
  · exact core_234 d1 d2 hd1.le h
  · obtain ⟨t, a1, a2, a3⟩ := core_234 d2 d1 hd2.le h
    exact ⟨t, a1, a2, clear2_symm a3⟩

theorem land2_all_234 (d1 d2 : ℝ) (hd1 : (2 : ℝ) < d1) (hd2 : (2 : ℝ) < d2) :
    ∃ T, IsFirst (insert d1 (insert d2 (fset ({2, 3, 4} : Finset ℕ)))) T ∧ (1/16 : ℝ) ≤ T ∧
          (((1/16 : ℝ) ≤ T ∧ T ≤ (7/32 : ℝ) ∧ Clear2 d1 d2 T ∧ ∀ s, (1/16 : ℝ) ≤ s → s < T → ¬ Clear2 d1 d2 s)) := 
  land2C234 d1 d2 (by linarith) (by linarith) (exists_common_clear_234 d1 d2 hd1 hd2)

#print axioms exists_common_clear_234
