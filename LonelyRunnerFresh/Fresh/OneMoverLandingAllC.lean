/-- Mover below the frozen minimum, frozen disparities {1, 2, 3}. -/
theorem landing_oneMover_BLe123 (c x : ℝ) (k m : Fin 8) (hkm : k ≠ m) (hS : Sdisp k m = ({1, 2, 3} : Finset ℕ))
    (hd0 : 0 < |x - (c + ((k : ℕ) : ℝ))|) (hd : |x - (c + ((k : ℕ) : ℝ))| ≤ 1) :
    (∃ seq : ℕ → ℝ, seq 0 = 1 / (8 * |x - (c + ((k : ℕ) : ℝ))|) ∧
      (∀ n, IsMove (disparitySet (oneMover c x m) k) (seq n) (seq (n + 1))) ∧ ∃ N, seq (N + 1) = seq N) ∧
    ∀ seq : ℕ → ℝ, seq 0 = 1 / (8 * |x - (c + ((k : ℕ) : ℝ))|) →
      (∀ n, IsMove (disparitySet (oneMover c x m) k) (seq n) (seq (n + 1))) →
      ∀ N, seq (N + 1) = seq N → seq N = nextFL123 (1 / (8 * |x - (c + ((k : ℕ) : ℝ))|)) := by
  rw [disparitySet_oneMover_general c x k m hkm, hS]
  exact landingBelowLe123 _ hd0 hd

