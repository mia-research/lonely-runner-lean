  have hamem := mem_insert3 (S := ({2, 3, 6, 7} : Finset ℕ)) d1 d2 d3 (a := 2) (by decide)
  have key : ∀ T : ℝ, T ≤ (1/8 : ℝ) → FClear ({2, 3, 6, 7} : Finset ℕ) T → Clear3 d1 d2 d3 T →
      (∀ s, (1/16 : ℝ) ≤ s → s ≤ (1/8 : ℝ) → s < T → FClear ({2, 3, 6, 7} : Finset ℕ) s → Clear3 d1 d2 d3 s → False) →
      IsFirst (insert d1 (insert d2 (insert d3 (fset ({2, 3, 6, 7} : Finset ℕ))))) T := by
    intro T hTr hF hC hmin
    refine ⟨(lonely_insert3_iff ({2, 3, 6, 7} : Finset ℕ) d1 d2 d3 T).2 ⟨hF, hC⟩, ?_⟩
    intro s hs hlon
