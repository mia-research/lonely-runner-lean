  · left; exact ⟨h0, d0⟩
  rcases lt_or_ge s (3/16 : ℝ) with g0 | d0g
  · exact absurd hF (gapM2367_0 s d0 g0)
  rcases le_or_gt s (15/56 : ℝ) with d1 | d1
  · right; left; exact ⟨d0g, d1⟩
  rcases lt_or_ge s (3/8 : ℝ) with g1 | d1g
  · exact absurd hF (gapM2367_1 s d1 g1)
  rcases le_or_gt s (23/56 : ℝ) with d2 | d2
