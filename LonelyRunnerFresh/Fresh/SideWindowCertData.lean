        have j6 : swc_j_h3 6 = 11 := rfl
        intro i
        have hv7 : i.val < 7 := Fin.is_lt i
        by_cases hq0 : i = 0
        · rw [hq0, j0]; norm_num; linarith [n1, (hb 6).2, h0]
        by_cases hq1 : i = 1
        · rw [hq1, j1]; norm_num; linarith [n41, (hb 6).2, (hb 1).1]
        by_cases hq2 : i = 2
        · rw [hq2, j2]; norm_num; linarith [n42, (hb 6).2, (hb 2).1]
        by_cases hq3 : i = 3
        · rw [hq3, j3]; norm_num; linarith [n43, (hb 6).2, (hb 3).1]
        by_cases hq4 : i = 4
        · rw [hq4, j4]; norm_num; linarith [hs]
        by_cases hq5 : i = 5
        · rw [hq5, j5]; norm_num; linarith [n45, (hb 6).2, (hb 5).1]
        by_cases hq6 : i = 6
        · rw [hq6, j6]; norm_num <;> linarith
        · have w0 : i.val ≠ 0 := fun h => hq0 (Fin.val_inj.mp h)
