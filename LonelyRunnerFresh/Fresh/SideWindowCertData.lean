import Fresh.SideWindowCert

/-!
# The 1,018 side-window certificates of the [17,23) h3 off-plane family

Machine-generated by `experiments/n8/swcdata_gen_v1.py` from
`experiments/n8/tail_h3_offplane_dump_v1.jsonl` (509 leaves x 2 h3 split sides).
Each region is a dyadic bbox (over ρ₂..ρ₇; ρ₁ pinned at 1) cut by one side of the
h₃ plane `25ρ₇ − 89ρ₅`:

* `h3−` (data path `h3-`, the side `25ρ₇ ≥ 89ρ₅`): side vector `swc_a_minus = 89ρ₅ − 25ρ₇`
  stated as `linForm ≤ 0`; window `X = 25/ρ₅`, `Y = 15/ρ₃`;
* `h3+` (data path `h3+`, the side `25ρ₇ ≤ 89ρ₅`): side vector `swc_a_plus = 25ρ₇ − 89ρ₅`;
  window `X = 89/ρ₇`, `Y = 15/ρ₃`;
* laps `swc_j_h3 = (0,1,1,2,3,4,11)` over ρ₁..ρ₇ (both sides).

The data's 15 recorded window inequalities per region decompose, for every one of the
1,018 regions (exact-Fraction verified by the generator, fail-closed), into 12 BOX-route
inequalities (consequences of the bbox alone: the `n*` hypotheses below), ONE SIDE-coupled
inequality (the coupled entry `hv4` at ρ₇ resp. ρ₅ — exactly the side condition), and two
tautologies.  The two general lemmas `swc_h3minus_noCarve` / `swc_h3plus_noCarve` carry the
whole `SideWindowCertV` argument once (`sideWindowCertV_noCarve` of `Fresh.SideWindowCert`,
the `leaves3739_B1` pattern); each instance contributes its bbox literals and the 12
verified numeric facts.  Indexing: region `2·L` is leaf `L`'s h3− side, region `2·L+1` its
h3+ side.  No `#eval`, no `unsafe`, no `IO`; `sorryAx` is failure.
-/

namespace Fresh.BandNoCarve

open Fresh Fresh.Certs Set

-- Mechanical limits for the 1,018-cell tabulation below (per-branch table
-- defeq walks; not mathematical content).
set_option maxRecDepth 1000000
set_option maxHeartbeats 40000000

/-! ### The shared shape of the h3 side family -/

/-- The per-reading laps of the h3 side-window family, over ρ₁..ρ₇ (ρ₁'s slot is the
unused 0; the data's laps over ρ₂..ρ₇ are `(1,1,2,3,4,11)`). -/
def swc_j_h3 : Fin 7 → ℤ := ![0, 1, 1, 2, 3, 4, 11]

/-- The h3− side vector `89ρ₅ − 25ρ₇`: the data's `h3-` regions are the side
`25ρ₇ ≥ 89ρ₅`, stated as `linForm swc_a_minus g ≤ 0`. -/
def swc_a_minus : Fin 7 → ℝ := pairL 4 6 89 25

/-- The h3+ side vector `25ρ₇ − 89ρ₅`: the data's `h3+` regions are the side
`25ρ₇ ≤ 89ρ₅`, stated as `linForm swc_a_plus g ≤ 0`. -/
def swc_a_plus : Fin 7 → ℝ := pairL 6 4 25 89

theorem linForm_swc_a_minus (g : Fin 7 → ℝ) : linForm swc_a_minus g = 89 * g 4 - 25 * g 6 :=
  linForm_pairL 4 6 89 25 g

theorem linForm_swc_a_plus (g : Fin 7 → ℝ) : linForm swc_a_plus g = 25 * g 6 - 89 * g 4 :=
  linForm_pairL 6 4 25 89 g

/-! ### The two instance forms (each carried once, B1-style) -/

/-- **The h3− instance form.**  For any dyadic box `lo ≤ ρ ≤ hi` whose 12 numeric facts
below hold (each a bbox consequence, verified per instance in exact arithmetic), every
arrangement in the box on the side `89ρ₅ ≤ 25ρ₇` is not a carve of `[1,7]`: the window
`X = 25/ρ₅`, `Y = 15/ρ₃` with laps `(1,1,2,3,4,11)` satisfies `hv1`–`hv5` on the half-box's
vertex set — the twelve `n*` facts give the box-route inequalities at every vertex
(`sideVertex_box`), and the coupled entry `hv4` at ρ₇ (`89ρ₅ ≤ 25ρ₇`) is exactly the side
condition (`sideVertex_side`).  Shape-verified against the worked line
`leaves3739_B1_P1pos_noCarve` of `Fresh.SideWindowCert`. -/
theorem swc_h3minus_noCarve (lo hi : Fin 7 → ℝ)
    (hp0 : lo 0 = 1 ∧ hi 0 = 1) (hlo : ∀ i, lo i ≤ hi i)
    (hposka : (0:ℝ) < lo 4) (hposkb : (0:ℝ) < lo 2) (hposlo : ∀ i, 0 ≤ lo i)
    (n1 : hi 4 ≤ 25) (n2 : 25 * hi 2 ≤ 15 * lo 4) (n3 : (15:ℝ) ≤ 7 * lo 2)
    (n41 : 9 * hi 4 ≤ 25 * lo 1) (n42 : 9 * hi 4 ≤ 25 * lo 2)
    (n43 : 17 * hi 4 ≤ 25 * lo 3) (n45 : 33 * hi 4 ≤ 25 * lo 5)
    (n51 : 15 * hi 1 ≤ 15 * lo 2) (n53 : 15 * hi 3 ≤ 23 * lo 2)
    (n54 : 15 * hi 4 ≤ 31 * lo 2) (n55 : 15 * hi 5 ≤ 39 * lo 2)
    (n56 : 15 * hi 6 ≤ 95 * lo 2)
    (g : Fin 7 → ℝ) (hbox : ∀ i, lo i ≤ g i ∧ g i ≤ hi i)
    (hside : linForm swc_a_minus g ≤ 0) : Fresh.Certs.NoCarve g := by
  refine sideWindowCertV_noCarve
    { lo := lo, hi := hi, a := swc_a_minus, na := 25, ka := 4, nb := 15, kb := 2,
      j := swc_j_h3, hp0 := hp0, hlo := hlo, hposka := hposka, hposkb := hposkb,
      hposlo := hposlo,
      hv1 := by
        intro v hvx
        have h0 := sideVertex_pinned hp0 hvx
        have hb := sideVertex_box hlo hvx
        rw [h0]
        linarith [n1, (hb 4).2]
      hv2 := by
        intro v hvx
        have hb := sideVertex_box hlo hvx
        linarith [n2, (hb 2).2, (hb 4).1]
      hv3 := by
        intro v hvx
        have h0 := sideVertex_pinned hp0 hvx
        have hb := sideVertex_box hlo hvx
        rw [h0]
        linarith [n3, (hb 2).1]
      hv4 := by
        intro v hvx
        have h0 := sideVertex_pinned hp0 hvx
        have hb := sideVertex_box hlo hvx
        have hs := sideVertex_side hvx
        rw [linForm_swc_a_minus] at hs
        have j0 : swc_j_h3 0 = 0 := rfl
        have j1 : swc_j_h3 1 = 1 := rfl
        have j2 : swc_j_h3 2 = 1 := rfl
        have j3 : swc_j_h3 3 = 2 := rfl
        have j4 : swc_j_h3 4 = 3 := rfl
        have j5 : swc_j_h3 5 = 4 := rfl
        have j6 : swc_j_h3 6 = 11 := rfl
        intro i
        have hv7 : i.val < 7 := Fin.is_lt i
        by_cases hq0 : i = 0
        · rw [hq0, j0]; norm_num; linarith [n1, (hb 4).2, h0]
        by_cases hq1 : i = 1
        · rw [hq1, j1]; norm_num; linarith [n41, (hb 4).2, (hb 1).1]
        by_cases hq2 : i = 2
        · rw [hq2, j2]; norm_num; linarith [n42, (hb 4).2, (hb 2).1]
        by_cases hq3 : i = 3
        · rw [hq3, j3]; norm_num; linarith [n43, (hb 4).2, (hb 3).1]
        by_cases hq4 : i = 4
        · rw [hq4, j4]; norm_num <;> linarith
        by_cases hq5 : i = 5
        · rw [hq5, j5]; norm_num; linarith [n45, (hb 4).2, (hb 5).1]
        by_cases hq6 : i = 6
        · rw [hq6, j6]; norm_num; linarith [hs]
        · have w0 : i.val ≠ 0 := fun h => hq0 (Fin.val_inj.mp h)
          have w1 : i.val ≠ 1 := fun h => hq1 (Fin.val_inj.mp h)
          have w2 : i.val ≠ 2 := fun h => hq2 (Fin.val_inj.mp h)
          have w3 : i.val ≠ 3 := fun h => hq3 (Fin.val_inj.mp h)
          have w4 : i.val ≠ 4 := fun h => hq4 (Fin.val_inj.mp h)
          have w5 : i.val ≠ 5 := fun h => hq5 (Fin.val_inj.mp h)
          have w6 : i.val ≠ 6 := fun h => hq6 (Fin.val_inj.mp h)
          omega
      hv5 := by
        intro v hvx
        have h0 := sideVertex_pinned hp0 hvx
        have hb := sideVertex_box hlo hvx
        have j0 : swc_j_h3 0 = 0 := rfl
        have j1 : swc_j_h3 1 = 1 := rfl
        have j2 : swc_j_h3 2 = 1 := rfl
        have j3 : swc_j_h3 3 = 2 := rfl
        have j4 : swc_j_h3 4 = 3 := rfl
        have j5 : swc_j_h3 5 = 4 := rfl
        have j6 : swc_j_h3 6 = 11 := rfl
        intro i
        have hv7 : i.val < 7 := Fin.is_lt i
        by_cases hq0 : i = 0
        · rw [hq0, j0]; norm_num; linarith [n3, (hb 2).1, h0]
        by_cases hq1 : i = 1
        · rw [hq1, j1]; norm_num; linarith [n51, (hb 1).2, (hb 2).1]
        by_cases hq2 : i = 2
        · rw [hq2, j2]; norm_num <;> linarith
        by_cases hq3 : i = 3
        · rw [hq3, j3]; norm_num; linarith [n53, (hb 3).2, (hb 2).1]
        by_cases hq4 : i = 4
        · rw [hq4, j4]; norm_num; linarith [n54, (hb 4).2, (hb 2).1]
        by_cases hq5 : i = 5
        · rw [hq5, j5]; norm_num; linarith [n55, (hb 5).2, (hb 2).1]
        by_cases hq6 : i = 6
        · rw [hq6, j6]; norm_num; linarith [n56, (hb 6).2, (hb 2).1]
        · have w0 : i.val ≠ 0 := fun h => hq0 (Fin.val_inj.mp h)
          have w1 : i.val ≠ 1 := fun h => hq1 (Fin.val_inj.mp h)
          have w2 : i.val ≠ 2 := fun h => hq2 (Fin.val_inj.mp h)
          have w3 : i.val ≠ 3 := fun h => hq3 (Fin.val_inj.mp h)
          have w4 : i.val ≠ 4 := fun h => hq4 (Fin.val_inj.mp h)
          have w5 : i.val ≠ 5 := fun h => hq5 (Fin.val_inj.mp h)
          have w6 : i.val ≠ 6 := fun h => hq6 (Fin.val_inj.mp h)
          omega }
    g hbox hside

/-- **The h3+ instance form.**  Mirror of `swc_h3minus_noCarve`: side `25ρ₇ ≤ 89ρ₅`
(`swc_a_plus`), window `X = 89/ρ₇`, `Y = 15/ρ₃`, same laps; the coupled entry `hv4` at ρ₅
(`25ρ₇ ≤ 89ρ₅`) is exactly the side condition. -/
theorem swc_h3plus_noCarve (lo hi : Fin 7 → ℝ)
