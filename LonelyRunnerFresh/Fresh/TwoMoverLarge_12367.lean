theorem cover2G12367 (s : ℝ) (h0 : (1/8 : ℝ) ≤ s) (hR : s ≤ (15/56 : ℝ)) (hF : FClear ({1, 2, 3, 6, 7} : Finset ℕ) s) :
    ((1/8 : ℝ) ≤ s ∧ s ≤ (1/8 : ℝ)) ∨ (((3/16 : ℝ) ≤ s ∧ s ≤ (15/56 : ℝ))) := by
  rcases le_or_gt s (1/8 : ℝ) with d0 | d0
  · left; exact ⟨h0, d0⟩
  rcases lt_or_ge s (3/16 : ℝ) with g0 | d0g
  · exact absurd hF (gap2G12367_0 s d0 g0)
  rcases le_or_gt s (15/56 : ℝ) with d1 | d1
  · right; exact ⟨d0g, d1⟩
  exact absurd hR (not_le.2 d1)

theorem land2G12367 (d1 d2 : ℝ) (hd1 : (22 : ℝ) ≤ d1) (hd2 : (22 : ℝ) ≤ d2) :
    ∃ T, IsFirst (insert d1 (insert d2 (fset ({1, 2, 3, 6, 7} : Finset ℕ)))) T ∧ (1/8 : ℝ) ≤ T ∧
      ((Clear2 d1 d2 (1/8 : ℝ) ∧ T = (1/8 : ℝ)) ∨
      (¬ Clear2 d1 d2 (1/8 : ℝ) ∧ (3/16 : ℝ) ≤ T ∧ T ≤ (15/56 : ℝ) ∧ Clear2 d1 d2 T ∧ ∀ s, (3/16 : ℝ) ≤ s → s < T → ¬ Clear2 d1 d2 s)) := by
  have hd1p : 0 < d1 := by linarith
  have hd2p : 0 < d2 := by linarith
  have hamem := mem_insert2 (S := ({1, 2, 3, 6, 7} : Finset ℕ)) d1 d2 (a := 1) (by decide)
  have key : ∀ T : ℝ, T ≤ (15/56 : ℝ) → FClear ({1, 2, 3, 6, 7} : Finset ℕ) T → Clear2 d1 d2 T →
      (∀ s, (1/8 : ℝ) ≤ s → s ≤ (15/56 : ℝ) → s < T → FClear ({1, 2, 3, 6, 7} : Finset ℕ) s → Clear2 d1 d2 s → False) →
      IsFirst (insert d1 (insert d2 (fset ({1, 2, 3, 6, 7} : Finset ℕ)))) T := by
    intro T hTr hF hC hmin
    refine ⟨(lonely_insert2_iff ({1, 2, 3, 6, 7} : Finset ℕ) d1 d2 T).2 ⟨hF, hC⟩, ?_⟩
    intro s hs hlon
    have hs8' := lonely_geG hamem (by norm_num) hs hlon
    have hs8 : (1/8 : ℝ) ≤ s := by norm_num at hs8' ⊢; linarith
    rw [lonely_insert2_iff] at hlon
    by_contra hlt
    push Not at hlt
    exact hmin s hs8 (by linarith) hlt hlon.1 hlon.2
  by_cases q0 : Clear2 d1 d2 (1/8 : ℝ)
  · refine ⟨(1/8 : ℝ), key (1/8 : ℝ) (by norm_num) (fpiece2G12367_0 _ (le_refl _) (le_refl _)) q0 ?_, by norm_num, ?_⟩
    · intro s h0 hR hlt hF hC
      rcases cover2G12367 s h0 hR hF with ⟨a0, b0⟩ | ⟨a1, b1⟩
      · linarith
      · linarith
    · left; exact ⟨q0, rfl⟩
  have hwid : ∀ d : ℝ, (22 : ℝ) ≤ d → (3/16 : ℝ) + 7 / (4 * d) ≤ (15/56 : ℝ) := by
    intro d hd
    have hdp : 0 < d := by linarith
    have h7 : 7 / (4 * d) ≤ (15/56 : ℝ) - (3/16 : ℝ) := by
      rw [div_le_iff₀ (by positivity)]
      have := mul_le_mul_of_nonneg_left hd (by norm_num : (0 : ℝ) ≤ 4 * ((15/56 : ℝ) - (3/16 : ℝ)))
      nlinarith
    linarith
  have hexw : ∃ t, (3/16 : ℝ) ≤ t ∧ t ≤ (15/56 : ℝ) ∧ Clear2 d1 d2 t := by
    rcases le_total d1 d2 with hle | hle
    · exact two_clear_in hd1p hle (hwid d1 hd1)
    · obtain ⟨t, ha, hb, hc⟩ := two_clear_in hd2p hle (hwid d2 hd2)
      exact ⟨t, ha, hb, ⟨hc.2, hc.1⟩⟩
  obtain ⟨ts, hls, hrs, hcs⟩ := hexw
  obtain ⟨T, hlT, hCT, hmin⟩ := first_two_clear hd1p hd2p (by norm_num : (0 : ℝ) < (3/16 : ℝ)) ⟨ts, hls, hcs⟩
  have hTr : T ≤ (15/56 : ℝ) := le_trans (hmin ts hls hcs) hrs
  refine ⟨T, key T hTr (fpiece2G12367_1 T hlT hTr) hCT ?_, by linarith, ?_⟩
  · intro s h0 hR hlt hF hC
    rcases cover2G12367 s h0 hR hF with ⟨a0, b0⟩ | ⟨a1, b1⟩
    · have e : s = (1/8 : ℝ) := le_antisymm b0 a0
      rw [e] at hC; exact absurd hC q0
    · exact absurd (hmin s a1 hC) (not_le.2 hlt)
  · right; exact ⟨q0, hlT, hTr, hCT, fun s hs hlt hc => absurd (hmin s hs hc) (not_le.2 hlt)⟩

