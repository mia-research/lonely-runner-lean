  rcases le_or_gt s (1/8 : ℝ) with d0 | d0
  · left; exact ⟨h0, d0⟩
  rcases lt_or_ge s (9/40 : ℝ) with g0 | d0g
  · exact absurd hF (gapL12567_0 s d0 g0)
  rcases le_or_gt s (15/56 : ℝ) with d1 | d1
  · right; left; exact ⟨d0g, d1⟩
  rcases lt_or_ge s (17/56 : ℝ) with g1 | d1g
  · exact absurd hF (gapL12567_1 s d1 g1)
  rcases le_or_gt s (5/16 : ℝ) with d2 | d2
  · right; right; left; exact ⟨d1g, d2⟩
  rcases lt_or_ge s (17/48 : ℝ) with g2 | d2g
  · exact absurd hF (gapL12567_2 s d2 g2)
  rcases le_or_gt s (3/8 : ℝ) with d3 | d3
  · right; right; right; left; exact ⟨d2g, d3⟩
  rcases lt_or_ge s (5/8 : ℝ) with g3 | d3g
  · exact absurd hF (gapL12567_3 s d3 g3)
  rcases le_or_gt s (31/48 : ℝ) with d4 | d4
  · right; right; right; right; exact ⟨d3g, d4⟩
  exact absurd hR (not_le.2 d4)

