    (hS : Sdisp2 k m1 m2 = ({2, 3, 4, 5} : Finset ℕ))
    (hd1 : (16 : ℝ) ≤ |x1 - (c + ((k : ℕ) : ℝ))|) (hd2 : (16 : ℝ) ≤ |x2 - (c + ((k : ℕ) : ℝ))|) :
    ∃ T : ℝ, (1 : ℝ) / (8 * (2 : ℝ)) ≤ T ∧ IsFirst (disparitySet (twoMover c x1 x2 m1 m2) k) T ∧
      (∃ seq : ℕ → ℝ, seq 0 = 1 / (8 * (2 : ℝ)) ∧
        (∀ n, IsMove (disparitySet (twoMover c x1 x2 m1 m2) k) (seq n) (seq (n + 1))) ∧ ∃ N, seq (N + 1) = seq N) ∧
      ∀ seq : ℕ → ℝ, seq 0 = 1 / (8 * (2 : ℝ)) →
        (∀ n, IsMove (disparitySet (twoMover c x1 x2 m1 m2) k) (seq n) (seq (n + 1))) → ∀ N, seq (N + 1) = seq N → seq N = T := by
  rw [disparitySet_twoMover c x1 x2 k m1 m2 hk1 hk2 h12, hS]
  obtain ⟨T, hf, hge, _⟩ := land2G2345 _ _ hd1 hd2
  have hd1p : 0 < |x1 - (c + ((k : ℕ) : ℝ))| := lt_of_lt_of_le (by norm_num) hd1
  have hd2p : 0 < |x2 - (c + ((k : ℕ) : ℝ))| := lt_of_lt_of_le (by norm_num) hd2
  have hpos := pos_insert2 (S := ({2, 3, 4, 5} : Finset ℕ)) (by intro i hi; simp only [Finset.mem_insert, Finset.mem_singleton] at hi; rcases hi with rfl | rfl | rfl | rfl <;> norm_num) hd1p hd2p
  have hamem := mem_insert2 (S := ({2, 3, 4, 5} : Finset ℕ)) |x1 - (c + ((k : ℕ) : ℝ))| |x2 - (c + ((k : ℕ) : ℝ))| (a := 2) (by decide)
  have hT : 0 < T := lt_of_lt_of_le (by norm_num) hge
  have := cascade_landsG hpos hamem hT hf
  exact ⟨T, by norm_num at hge ⊢; linarith, hf, by simpa using this.1, by simpa using this.2⟩

