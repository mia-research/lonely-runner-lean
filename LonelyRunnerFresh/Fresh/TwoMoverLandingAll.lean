/-- Two movers: speeds `c + i`, runner `m1` at `x1`, runner `m2` at `x2`. -/
noncomputable def twoMover (c x1 x2 : ℝ) (m1 m2 : Fin 8) : Fin 8 → ℝ :=
  fun i => if i = m1 then x1 else if i = m2 then x2 else c + ((i : ℕ) : ℝ)

/-- The frozen disparities seen by subject `k` when `m1, m2` are the movers. -/
def Sdisp2 (k m1 m2 : Fin 8) : Finset ℕ :=
  ((((Finset.univ : Finset (Fin 8)).erase k).erase m1).erase m2).image
    (fun i : Fin 8 => (((i : ℕ) : ℤ) - ((k : ℕ) : ℤ)).natAbs)

theorem natAbs_cast_abs (i k : Fin 8) :
    ((((i : ℕ) : ℤ) - ((k : ℕ) : ℤ)).natAbs : ℝ) = |((i : ℕ) : ℝ) - ((k : ℕ) : ℝ)| := by
  push_cast [Nat.cast_natAbs, Int.cast_abs]; ring_nf

theorem disparitySet_twoMover (c x1 x2 : ℝ) (k m1 m2 : Fin 8) (hk1 : k ≠ m1) (hk2 : k ≠ m2) (h12 : m1 ≠ m2) :
    disparitySet (twoMover c x1 x2 m1 m2) k =
      insert |x1 - (c + ((k : ℕ) : ℝ))| (insert |x2 - (c + ((k : ℕ) : ℝ))| (fset (Sdisp2 k m1 m2))) := by
  have hvk : twoMover c x1 x2 m1 m2 k = c + ((k : ℕ) : ℝ) := by simp [twoMover, hk1, hk2]
  ext d
  simp only [disparitySet, Finset.mem_image, Finset.mem_erase, Finset.mem_univ, and_true, Finset.mem_insert]
  rw [mem_fset]
  constructor
  · rintro ⟨i, hik, rfl⟩
    by_cases h1 : i = m1
    · left; rw [hvk]; simp [twoMover, h1]
    · by_cases h2 : i = m2
      · right; left; rw [hvk]; simp [twoMover, h1, h2, h12.symm]
      · right; right
        refine ⟨(((i : ℕ) : ℤ) - ((k : ℕ) : ℤ)).natAbs, ?_, ?_⟩
        · unfold Sdisp2
          simp only [Finset.mem_image, Finset.mem_erase, Finset.mem_univ, and_true]
          exact ⟨i, ⟨h2, h1, hik⟩, rfl⟩
        · have hvi : twoMover c x1 x2 m1 m2 i = c + ((i : ℕ) : ℝ) := by simp [twoMover, h1, h2]
          rw [hvi, hvk, natAbs_cast_abs]
          congr 1; ring
  · rintro (rfl | rfl | ⟨n, hn, rfl⟩)
    · exact ⟨m1, fun h => hk1 h.symm, by rw [hvk]; simp [twoMover]⟩
    · exact ⟨m2, fun h => hk2 h.symm, by rw [hvk]; simp [twoMover, h12.symm]⟩
    · unfold Sdisp2 at hn
      simp only [Finset.mem_image, Finset.mem_erase, Finset.mem_univ, and_true] at hn
      obtain ⟨i, ⟨h2, h1, hik⟩, rfl⟩ := hn
      refine ⟨i, hik, ?_⟩
      have hvi : twoMover c x1 x2 m1 m2 i = c + ((i : ℕ) : ℝ) := by simp [twoMover, h1, h2]
      rw [hvi, hvk, natAbs_cast_abs]
      congr 1; ring

