/-- THE decide: every row of the tranche satisfies the full seven-reading row
condition (ρ1 pinned: `R0 ∈ [1,7]` at gap 0; the two integer faces per cell
reading). -/
theorem bulkRowsT1_ok : bulkRowsT1.all rowOKB = true := by decide

/-- Membership implies the row condition (the decide-backed bridge). -/
theorem rowOK_of_memT1 {row : BulkRow} (hmem : row ∈ bulkRowsT1) : rowOK row :=
  (rowOKB_iff row).mp (List.all_eq_true.mp bulkRowsT1_ok row hmem)

/-- **The compressed tranche theorem**: any row of the table certifies every
arrangement in its cell box (schema class 1, `BandFixedR0`). -/
theorem bandBulkT1 {row : BulkRow} (hmem : row ∈ bulkRowsT1) {g : Fin 7 → ℝ}
    (hbox : ∀ i, rowLo row i ≤ g i ∧ g i ≤ rowHi row i) : BandFixedR0 g :=
  bandBulk_of_rowOK row (rowOK_of_memT1 hmem) hbox

/-- The worked example (the tranche's first row): the row condition decided at
the Prop level. -/
theorem worked_rowOK : rowOK ⟨1, 1, 1, 1, 1, 25, 1048576, 0, 0, 0, 0, 0, 3⟩ := by decide

/-- The worked example's consumption: every arrangement in its cell box is
`BandFixedR0`. -/
theorem bandBulk_worked {g : Fin 7 → ℝ}
    (hbox : ∀ i, rowLo ⟨1, 1, 1, 1, 1, 25, 1048576, 0, 0, 0, 0, 0, 3⟩ i ≤ g i ∧ g i ≤ rowHi ⟨1, 1, 1, 1, 1, 25, 1048576, 0, 0, 0, 0, 0, 3⟩ i) : BandFixedR0 g :=
  bandBulk_of_rowOK _ worked_rowOK hbox

#print axioms bulkRowsT1_ok
#print axioms rowOK_of_memT1
#print axioms bandBulkT1
#print axioms worked_rowOK
#print axioms bandBulk_worked

end Fresh.BandReplayBulkT1
