  · have hF' : FClear ({2, 3, 4, 5, 6, 7} : Finset ℕ) (σ - 1 + ((1 : ℕ) : ℝ)) := by
      have e : σ - 1 + ((1 : ℕ) : ℝ) = σ := by push_cast; ring
      rw [e]; exact hF
    have hcov := coverBL234567 (σ - 1) (by linarith) (by linarith) (fclearBL234567_unshift _ 1 hF')
    unfold nfoff234567 at hs2
    by_cases c0 : τ < (1/16 : ℝ)
    · rw [if_pos c0] at hs2
      rcases hcov with ⟨p0, q0⟩ | ⟨p1, q1⟩ | ⟨p2, q2⟩ | ⟨p3, q3⟩ <;> linarith
    rw [if_neg c0] at hs2
    by_cases c1 : τ ≤ (1/8 : ℝ)
    · rw [if_pos c1] at hs2
      rcases hcov with ⟨p0, q0⟩ | ⟨p1, q1⟩ | ⟨p2, q2⟩ | ⟨p3, q3⟩ <;> linarith
    rw [if_neg c1] at hs2
    by_cases c2 : τ < (3/8 : ℝ)
    · rw [if_pos c2] at hs2
      rcases hcov with ⟨p0, q0⟩ | ⟨p1, q1⟩ | ⟨p2, q2⟩ | ⟨p3, q3⟩ <;> linarith
    rw [if_neg c2] at hs2
    by_cases c3 : τ ≤ (3/8 : ℝ)
    · rw [if_pos c3] at hs2
      rcases hcov with ⟨p0, q0⟩ | ⟨p1, q1⟩ | ⟨p2, q2⟩ | ⟨p3, q3⟩ <;> linarith
    rw [if_neg c3] at hs2
    by_cases c4 : τ < (5/8 : ℝ)
    · rw [if_pos c4] at hs2
      rcases hcov with ⟨p0, q0⟩ | ⟨p1, q1⟩ | ⟨p2, q2⟩ | ⟨p3, q3⟩ <;> linarith
    rw [if_neg c4] at hs2
    by_cases c5 : τ ≤ (5/8 : ℝ)
    · rw [if_pos c5] at hs2
      rcases hcov with ⟨p0, q0⟩ | ⟨p1, q1⟩ | ⟨p2, q2⟩ | ⟨p3, q3⟩ <;> linarith
    rw [if_neg c5] at hs2
    by_cases c6 : τ < (7/8 : ℝ)
    · rw [if_pos c6] at hs2
      rcases hcov with ⟨p0, q0⟩ | ⟨p1, q1⟩ | ⟨p2, q2⟩ | ⟨p3, q3⟩ <;> linarith
    rw [if_neg c6] at hs2
    by_cases c7 : τ ≤ (15/16 : ℝ)
    · rw [if_pos c7] at hs2
      rcases hcov with ⟨p0, q0⟩ | ⟨p1, q1⟩ | ⟨p2, q2⟩ | ⟨p3, q3⟩ <;> linarith
    rw [if_neg c7] at hs2
