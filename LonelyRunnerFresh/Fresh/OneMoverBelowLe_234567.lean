/-- Every clear instant of one period lies in a listed piece. [PROVISIONAL: covering] -/
theorem coverBL234567 (s : ℝ) (h0 : 0 ≤ s) (h1 : s < 1) (hF : FClear ({2, 3, 4, 5, 6, 7} : Finset ℕ) s) :
    ((1/16 : ℝ) ≤ s ∧ s ≤ (1/8 : ℝ)) ∨ (((3/8 : ℝ) ≤ s ∧ s ≤ (3/8 : ℝ)) ∨ (((5/8 : ℝ) ≤ s ∧ s ≤ (5/8 : ℝ)) ∨ (((7/8 : ℝ) ≤ s ∧ s ≤ (15/16 : ℝ))))) := by
  rcases lt_or_ge s (1/16 : ℝ) with g_1 | dpre
  · exact absurd hF (gapBL234567_init s h0 g_1)
  rcases le_or_gt s (1/8 : ℝ) with d0 | d0
  · left; exact ⟨dpre, d0⟩
  rcases lt_or_ge s (3/8 : ℝ) with g0 | d0g
  · exact absurd hF (gapBL234567_0 s d0 g0)
  rcases le_or_gt s (3/8 : ℝ) with d1 | d1
  · right; left; exact ⟨d0g, d1⟩
  rcases lt_or_ge s (5/8 : ℝ) with g1 | d1g
  · exact absurd hF (gapBL234567_1 s d1 g1)
  rcases le_or_gt s (5/8 : ℝ) with d2 | d2
  · right; right; left; exact ⟨d1g, d2⟩
  rcases lt_or_ge s (7/8 : ℝ) with g2 | d2g
  · exact absurd hF (gapBL234567_2 s d2 g2)
  rcases le_or_gt s (15/16 : ℝ) with d3 | d3
  · right; right; right; exact ⟨d2g, d3⟩
  exact absurd hF (gapBL234567_3 s d3 h1)

/-- The first frozen-lonely instant at or after `τ ∈ [0, 1)`, as an offset in `[0, 2)`. -/
noncomputable def nfoff234567 (τ : ℝ) : ℝ :=
  if τ < (1/16 : ℝ) then (1/16 : ℝ) else if τ ≤ (1/8 : ℝ) then τ else if τ < (3/8 : ℝ) then (3/8 : ℝ) else if τ ≤ (3/8 : ℝ) then τ else if τ < (5/8 : ℝ) then (5/8 : ℝ) else if τ ≤ (5/8 : ℝ) then τ else if τ < (7/8 : ℝ) then (7/8 : ℝ) else if τ ≤ (15/16 : ℝ) then τ else (17/16 : ℝ)

