/-- The first frozen-lonely offset is `τ` itself or the opening of a frozen runner `i` (it stands at exactly `1/8` past a lap). -/
theorem nfoff234567_open (τ : ℝ) (h0 : 0 ≤ τ) (h1 : τ < 1) :
    (∃ i ∈ ({2, 3, 4, 5, 6, 7} : Finset ℕ), ∃ n : ℤ, (i : ℝ) * nfoff234567 τ = n + 1/8) ∨ nfoff234567 τ = τ := by
  unfold nfoff234567
  by_cases c0 : τ < (1/16 : ℝ)
  · rw [if_pos c0]
    left; exact ⟨2, by decide, 0, by norm_num⟩
  rw [if_neg c0]
  by_cases c1 : τ ≤ (1/8 : ℝ)
  · rw [if_pos c1]
    right; rfl
  rw [if_neg c1]
  by_cases c2 : τ < (3/8 : ℝ)
  · rw [if_pos c2]
    left; exact ⟨3, by decide, 1, by norm_num⟩
  rw [if_neg c2]
  by_cases c3 : τ ≤ (3/8 : ℝ)
  · rw [if_pos c3]
    right; rfl
  rw [if_neg c3]
  by_cases c4 : τ < (5/8 : ℝ)
  · rw [if_pos c4]
    left; exact ⟨5, by decide, 3, by norm_num⟩
  rw [if_neg c4]
  by_cases c5 : τ ≤ (5/8 : ℝ)
  · rw [if_pos c5]
    right; rfl
  rw [if_neg c5]
  by_cases c6 : τ < (7/8 : ℝ)
  · rw [if_pos c6]
    left; exact ⟨7, by decide, 6, by norm_num⟩
  rw [if_neg c6]
  by_cases c7 : τ ≤ (15/16 : ℝ)
  · rw [if_pos c7]
    right; rfl
  rw [if_neg c7]
  left; exact ⟨2, by decide, 2, by norm_num⟩

noncomputable def nextFL234567 (t0 : ℝ) : ℝ := (⌊t0⌋₊ : ℝ) + nfoff234567 (t0 - (⌊t0⌋₊ : ℝ))

theorem nextFL234567_facts (t0 : ℝ) (ht0 : 0 ≤ t0) :
    t0 ≤ nextFL234567 t0 ∧ nextFL234567 t0 - t0 ≤ (1/4 : ℝ) ∧ FClear ({2, 3, 4, 5, 6, 7} : Finset ℕ) (nextFL234567 t0) ∧
    (∀ s : ℝ, t0 ≤ s → s < nextFL234567 t0 → ¬ FClear ({2, 3, 4, 5, 6, 7} : Finset ℕ) s) ∧
    ((∃ i ∈ ({2, 3, 4, 5, 6, 7} : Finset ℕ), ∃ n : ℤ, (i : ℝ) * nextFL234567 t0 = n + 1/8) ∨ nextFL234567 t0 = t0) := by
  have f1 := Nat.floor_le ht0
  have f2 := Nat.lt_floor_add_one t0
  have hτ0 : 0 ≤ t0 - (⌊t0⌋₊ : ℝ) := by linarith
  have hτ1 : t0 - (⌊t0⌋₊ : ℝ) < 1 := by linarith
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · have := nfoff234567_ge _ hτ1; unfold nextFL234567; linarith
  · have := nfoff234567_gap _ hτ0 hτ1; unfold nextFL234567; linarith
  · have := fclearBL234567_shift _ ⌊t0⌋₊ (nfoff234567_clear _ hτ0 hτ1)
    unfold nextFL234567; rw [add_comm]; exact this
  · intro s hs1 hs2 hF
    have hF' : FClear ({2, 3, 4, 5, 6, 7} : Finset ℕ) ((s - (⌊t0⌋₊ : ℝ)) + (⌊t0⌋₊ : ℕ)) := by
      have e : (s - (⌊t0⌋₊ : ℝ)) + ((⌊t0⌋₊ : ℕ) : ℝ) = s := by ring
      rw [e]; exact hF
    unfold nextFL234567 at hs2
    exact nfoff234567_min _ hτ0 hτ1 (s - (⌊t0⌋₊ : ℝ)) (by linarith) (by linarith) (fclearBL234567_unshift _ _ hF')
  · rcases nfoff234567_open _ hτ0 hτ1 with ⟨i, hi, n, hn⟩ | hn
    · left
      refine ⟨i, hi, n + (i : ℤ) * (⌊t0⌋₊ : ℤ), ?_⟩
      unfold nextFL234567
      push_cast
      have : (i : ℝ) * ((⌊t0⌋₊ : ℝ) + nfoff234567 (t0 - (⌊t0⌋₊ : ℝ))) = (i : ℝ) * (⌊t0⌋₊ : ℝ) + (i : ℝ) * nfoff234567 (t0 - (⌊t0⌋₊ : ℝ)) := by ring
      rw [this, hn]; ring
    · right; unfold nextFL234567; rw [hn]; ring

/-- **The landing with the mover below the frozen minimum.** -/
theorem landSpecBelowLe234567 (ρ : ℝ) (h0 : 0 < ρ) (ha : ρ ≤ 2) :
    IsFirst (insert ρ (fset ({2, 3, 4, 5, 6, 7} : Finset ℕ))) (nextFL234567 (1 / (8 * ρ))) ∧ 1 / (8 * ρ) ≤ nextFL234567 (1 / (8 * ρ)) ∧
    ((∃ i ∈ ({2, 3, 4, 5, 6, 7} : Finset ℕ), ∃ n : ℤ, (i : ℝ) * nextFL234567 (1 / (8 * ρ)) = n + 1/8) ∨ ρ * nextFL234567 (1 / (8 * ρ)) = 1/8) := by
  have ht0 : 0 < 1 / (8 * ρ) := by positivity
  obtain ⟨hge, hgap, hcl, hmin, hop⟩ := nextFL234567_facts _ ht0.le
  have hρt : ρ * (1 / (8 * ρ)) = 1 / 8 := by field_simp
  have hmov1 : (1 / 8 : ℝ) ≤ ρ * nextFL234567 (1 / (8 * ρ)) := by nlinarith
  have hmov2 : ρ * nextFL234567 (1 / (8 * ρ)) ≤ 7 / 8 := by nlinarith
  have hmov : (1 / 8 : ℝ) ≤ distInt (ρ * nextFL234567 (1 / (8 * ρ))) :=
    Fresh.Localisation.clear_of_window 0 (by push_cast; linarith) (by push_cast; linarith)
  refine ⟨⟨(lonely_insert_iffG ({2, 3, 4, 5, 6, 7} : Finset ℕ) ρ _).2 ⟨hcl, hmov⟩, ?_⟩, hge, ?_⟩
  · intro s hs hlon
    have hρm : ρ ∈ insert ρ (fset ({2, 3, 4, 5, 6, 7} : Finset ℕ)) := Finset.mem_insert_self _ _
    have hb := lonely_geG hρm h0 hs hlon
    rw [lonely_insert_iffG] at hlon
    by_contra hlt
    push Not at hlt
    exact hmin s hb hlt hlon.1
  · rcases hop with h | h
    · left; exact h
    · right; rw [h]; exact hρt

theorem landingBelowLe234567 (ρ : ℝ) (h0 : 0 < ρ) (ha : ρ ≤ 2) :
    (∃ seq : ℕ → ℝ, seq 0 = 1 / (8 * ρ) ∧ (∀ n, IsMove (insert ρ (fset ({2, 3, 4, 5, 6, 7} : Finset ℕ))) (seq n) (seq (n + 1))) ∧ ∃ N, seq (N + 1) = seq N) ∧
      ∀ seq : ℕ → ℝ, seq 0 = 1 / (8 * ρ) → (∀ n, IsMove (insert ρ (fset ({2, 3, 4, 5, 6, 7} : Finset ℕ))) (seq n) (seq (n + 1))) →
        ∀ N, seq (N + 1) = seq N → seq N = nextFL234567 (1 / (8 * ρ)) := by
  obtain ⟨hf, hge, _⟩ := landSpecBelowLe234567 ρ h0 ha
  have hpos := pos_insertG (S := ({2, 3, 4, 5, 6, 7} : Finset ℕ)) (by intro i hi; simp only [Finset.mem_insert, Finset.mem_singleton] at hi; rcases hi with rfl | rfl | rfl | rfl | rfl | rfl <;> norm_num) (ρ := ρ) h0
  have hρm : ρ ∈ insert ρ (fset ({2, 3, 4, 5, 6, 7} : Finset ℕ)) := Finset.mem_insert_self _ _
  have ht0 : 0 < 1 / (8 * ρ) := by positivity
  exact cascade_landsG hpos hρm (lt_of_lt_of_le ht0 hge) hf

