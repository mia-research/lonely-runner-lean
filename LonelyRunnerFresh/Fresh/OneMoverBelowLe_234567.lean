/-- Shifting by whole laps does not change what is clear for integer readings. -/
theorem fclearBL234567_shift (σ : ℝ) (n : ℕ) (h : FClear ({2, 3, 4, 5, 6, 7} : Finset ℕ) σ) : FClear ({2, 3, 4, 5, 6, 7} : Finset ℕ) (σ + n) := by
  intro i hi
  have e : (i : ℝ) * (σ + n) = (i : ℝ) * σ + (((i * n : ℕ) : ℤ) : ℝ) := by push_cast; ring
  rw [e, Fresh.Localisation.distInt_add_int]
  exact h i hi

theorem fclearBL234567_unshift (σ : ℝ) (n : ℕ) (h : FClear ({2, 3, 4, 5, 6, 7} : Finset ℕ) (σ + n)) : FClear ({2, 3, 4, 5, 6, 7} : Finset ℕ) σ := by
  intro i hi
  have e : (i : ℝ) * (σ + n) = (i : ℝ) * σ + (((i * n : ℕ) : ℤ) : ℝ) := by push_cast; ring
  have := h i hi
  rw [e, Fresh.Localisation.distInt_add_int] at this
  exact this

