  have hamem := mem_insert3 (S := ({2, 3, 5, 6} : Finset ℕ)) d1 d2 d3 (a := 2) (by decide)
  have key : ∀ T : ℝ, T ≤ (7/48 : ℝ) → FClear ({2, 3, 5, 6} : Finset ℕ) T → Clear3 d1 d2 d3 T →
      (∀ s, (1/16 : ℝ) ≤ s → s ≤ (7/48 : ℝ) → s < T → FClear ({2, 3, 5, 6} : Finset ℕ) s → Clear3 d1 d2 d3 s → False) →
      IsFirst (insert d1 (insert d2 (insert d3 (fset ({2, 3, 5, 6} : Finset ℕ))))) T := by
    intro T hTr hF hC hmin
    refine ⟨(lonely_insert3_iff ({2, 3, 5, 6} : Finset ℕ) d1 d2 d3 T).2 ⟨hF, hC⟩, ?_⟩
    intro s hs hlon
    have hs8' := lonely_geG hamem (by norm_num) hs hlon
    have hs8 : (1/16 : ℝ) ≤ s := by norm_num at hs8' ⊢; linarith
    rw [lonely_insert3_iff] at hlon
    by_contra hlt
    push Not at hlt
