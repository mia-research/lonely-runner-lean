theorem landL32356_0 (d1 d2 d3 : ℝ) (hd1p : 0 < d1) (hd2p : 0 < d2) (hd3p : 0 < d3) (hex : ∃ t, (1/16 : ℝ) ≤ t ∧ t ≤ (7/48 : ℝ) ∧ Clear3 d1 d2 d3 t) :
