  obtain ⟨ts, hls, hrs, hcs⟩ := hex
  obtain ⟨T, hlT, hCT, hmin⟩ := first_three_clear hd1p hd2p hd3p (by norm_num : (0 : ℝ) < (1/16 : ℝ)) ⟨ts, hls, hcs⟩
  have hTr : T ≤ (7/48 : ℝ) := le_trans (hmin ts hls hcs) hrs
  refine ⟨T, key T hTr (fpieceM2356_0 T hlT hTr) hCT ?_, by linarith, hlT, hTr, hCT, fun s hs hlt hc => absurd (hmin s hs hc) (not_le.2 hlt)⟩
  intro s h0 hR hlt hF hC
  rcases coverM2356 s h0 (le_trans hR (by norm_num)) hF with ⟨a0, b0⟩ | ⟨a1, b1⟩ | ⟨a2, b2⟩
  · exact absurd (hmin s a0 hC) (not_le.2 hlt)
