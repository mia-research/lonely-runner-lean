theorem fpieceM3467_0 (s : ℝ) (h1 : (1/24 : ℝ) ≤ s) (h2 : s ≤ (1/8 : ℝ)) : FClear ({3, 4, 6, 7} : Finset ℕ) s := by
  intro i hi
  simp only [Finset.mem_insert, Finset.mem_singleton] at hi
  rcases hi with rfl | rfl | rfl | rfl
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)

/-- [PROVISIONAL: covering] -/
theorem coverM3467 (s : ℝ) (h0 : (1/24 : ℝ) ≤ s) (hR : s ≤ (1/8 : ℝ)) (hF : FClear ({3, 4, 6, 7} : Finset ℕ) s) :
    ((1/24 : ℝ) ≤ s ∧ s ≤ (1/8 : ℝ)) := by
  rcases le_or_gt s (1/8 : ℝ) with d0 | d0
  · exact ⟨h0, d0⟩
  exact absurd hR (not_le.2 d0)

theorem landL33467_0 (d1 d2 d3 : ℝ) (hd1p : 0 < d1) (hd2p : 0 < d2) (hd3p : 0 < d3) (hex : ∃ t, (1/24 : ℝ) ≤ t ∧ t ≤ (1/8 : ℝ) ∧ Clear3 d1 d2 d3 t) :
    ∃ T, IsFirst (insert d1 (insert d2 (insert d3 (fset ({3, 4, 6, 7} : Finset ℕ))))) T ∧ (1/24 : ℝ) ≤ T ∧ (1/24 : ℝ) ≤ T ∧ T ≤ (1/8 : ℝ) ∧ Clear3 d1 d2 d3 T ∧ ∀ s, (1/24 : ℝ) ≤ s → s < T → ¬ Clear3 d1 d2 d3 s := by
  have hamem := mem_insert3 (S := ({3, 4, 6, 7} : Finset ℕ)) d1 d2 d3 (a := 3) (by decide)
  have key : ∀ T : ℝ, T ≤ (1/8 : ℝ) → FClear ({3, 4, 6, 7} : Finset ℕ) T → Clear3 d1 d2 d3 T →
      (∀ s, (1/24 : ℝ) ≤ s → s ≤ (1/8 : ℝ) → s < T → FClear ({3, 4, 6, 7} : Finset ℕ) s → Clear3 d1 d2 d3 s → False) →
      IsFirst (insert d1 (insert d2 (insert d3 (fset ({3, 4, 6, 7} : Finset ℕ))))) T := by
    intro T hTr hF hC hmin
    refine ⟨(lonely_insert3_iff ({3, 4, 6, 7} : Finset ℕ) d1 d2 d3 T).2 ⟨hF, hC⟩, ?_⟩
    intro s hs hlon
    have hs8' := lonely_geG hamem (by norm_num) hs hlon
    have hs8 : (1/24 : ℝ) ≤ s := by norm_num at hs8' ⊢; linarith
    rw [lonely_insert3_iff] at hlon
    by_contra hlt
    push Not at hlt
    exact hmin s hs8 (by linarith) hlt hlon.1 hlon.2
  obtain ⟨ts, hls, hrs, hcs⟩ := hex
  obtain ⟨T, hlT, hCT, hmin⟩ := first_three_clear hd1p hd2p hd3p (by norm_num : (0 : ℝ) < (1/24 : ℝ)) ⟨ts, hls, hcs⟩
  have hTr : T ≤ (1/8 : ℝ) := le_trans (hmin ts hls hcs) hrs
  refine ⟨T, key T hTr (fpieceM3467_0 T hlT hTr) hCT ?_, by linarith, hlT, hTr, hCT, fun s hs hlt hc => absurd (hmin s hs hc) (not_le.2 hlt)⟩
  intro s h0 hR hlt hF hC
  rcases coverM3467 s h0 (le_trans hR (by norm_num)) hF with ⟨a0, b0⟩
  · exact absurd (hmin s a0 hC) (not_le.2 hlt)

