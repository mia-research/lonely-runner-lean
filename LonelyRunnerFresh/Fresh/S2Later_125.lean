theorem fpieceL125_0 (s : ℝ) (h1 : (1/8 : ℝ) ≤ s) (h2 : s ≤ (7/40 : ℝ)) : FClear ({1, 2, 5} : Finset ℕ) s := by
  intro i hi
  simp only [Finset.mem_insert, Finset.mem_singleton] at hi
  rcases hi with rfl | rfl | rfl
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)

theorem fpieceL125_1 (s : ℝ) (h1 : (9/40 : ℝ) ≤ s) (h2 : s ≤ (3/8 : ℝ)) : FClear ({1, 2, 5} : Finset ℕ) s := by
