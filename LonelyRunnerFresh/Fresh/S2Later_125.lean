  simp only [Finset.mem_insert, Finset.mem_singleton] at hi
  rcases hi with rfl | rfl | rfl
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 0 (by norm_num) h1 h2 (by norm_num) (by norm_num)
  · exact clear_scaled 1 (by norm_num) h1 h2 (by norm_num) (by norm_num)

theorem gapL125_0 (s : ℝ) (ha : (7/40 : ℝ) < s) (hb : s < (9/40 : ℝ)) : ¬ FClear ({1, 2, 5} : Finset ℕ) s := by
  exact fnot ({1, 2, 5} : Finset ℕ) 5 (by decide) 1 s (by push_cast; linarith) (by push_cast; linarith)

/-- [PROVISIONAL: covering] -/
theorem coverL125 (s : ℝ) (h0 : (1/8 : ℝ) ≤ s) (hR : s ≤ (3/8 : ℝ)) (hF : FClear ({1, 2, 5} : Finset ℕ) s) :
    ((1/8 : ℝ) ≤ s ∧ s ≤ (7/40 : ℝ)) ∨ (((9/40 : ℝ) ≤ s ∧ s ≤ (3/8 : ℝ))) := by
  rcases le_or_gt s (7/40 : ℝ) with d0 | d0
  · left; exact ⟨h0, d0⟩
  rcases lt_or_ge s (9/40 : ℝ) with g0 | d0g
  · exact absurd hF (gapL125_0 s d0 g0)
  rcases le_or_gt s (3/8 : ℝ) with d1 | d1
  · right; exact ⟨d0g, d1⟩
  exact absurd hR (not_le.2 d1)

theorem landL125_0 (d1 d2 : ℝ) (hd1p : 0 < d1) (hd2p : 0 < d2) (hex : ∃ t, (1/8 : ℝ) ≤ t ∧ t ≤ (7/40 : ℝ) ∧ Clear2 d1 d2 t) :
    ∃ T, IsFirst (insert d1 (insert d2 (fset ({1, 2, 5} : Finset ℕ)))) T ∧ (1/8 : ℝ) ≤ T ∧ (1/8 : ℝ) ≤ T ∧ T ≤ (7/40 : ℝ) ∧ Clear2 d1 d2 T ∧ ∀ s, (1/8 : ℝ) ≤ s → s < T → ¬ Clear2 d1 d2 s := by
  have hamem := mem_insert2 (S := ({1, 2, 5} : Finset ℕ)) d1 d2 (a := 1) (by decide)
  have key : ∀ T : ℝ, T ≤ (7/40 : ℝ) → FClear ({1, 2, 5} : Finset ℕ) T → Clear2 d1 d2 T →
      (∀ s, (1/8 : ℝ) ≤ s → s ≤ (7/40 : ℝ) → s < T → FClear ({1, 2, 5} : Finset ℕ) s → Clear2 d1 d2 s → False) →
      IsFirst (insert d1 (insert d2 (fset ({1, 2, 5} : Finset ℕ)))) T := by
    intro T hTr hF hC hmin
    refine ⟨(lonely_insert2_iff ({1, 2, 5} : Finset ℕ) d1 d2 T).2 ⟨hF, hC⟩, ?_⟩
    intro s hs hlon
    have hs8' := lonely_geG hamem (by norm_num) hs hlon
    have hs8 : (1/8 : ℝ) ≤ s := by norm_num at hs8' ⊢; linarith
    rw [lonely_insert2_iff] at hlon
    by_contra hlt
    push Not at hlt
    exact hmin s hs8 (by linarith) hlt hlon.1 hlon.2
  obtain ⟨ts, hls, hrs, hcs⟩ := hex
  obtain ⟨T, hlT, hCT, hmin⟩ := first_two_clear hd1p hd2p (by norm_num : (0 : ℝ) < (1/8 : ℝ)) ⟨ts, hls, hcs⟩
  have hTr : T ≤ (7/40 : ℝ) := le_trans (hmin ts hls hcs) hrs
  refine ⟨T, key T hTr (fpieceL125_0 T hlT hTr) hCT ?_, by linarith, hlT, hTr, hCT, fun s hs hlt hc => absurd (hmin s hs hc) (not_le.2 hlt)⟩
  intro s h0 hR hlt hF hC
  rcases coverL125 s h0 (le_trans hR (by norm_num)) hF with ⟨a0, b0⟩ | ⟨a1, b1⟩
  · exact absurd (hmin s a0 hC) (not_le.2 hlt)
  · linarith

theorem landL125_1 (d1 d2 : ℝ) (hd1p : 0 < d1) (hd2p : 0 < d2) (hn0 : ¬ (∃ t, (1/8 : ℝ) ≤ t ∧ t ≤ (7/40 : ℝ) ∧ Clear2 d1 d2 t)) (hex : ∃ t, (9/40 : ℝ) ≤ t ∧ t ≤ (3/8 : ℝ) ∧ Clear2 d1 d2 t) :
    ∃ T, IsFirst (insert d1 (insert d2 (fset ({1, 2, 5} : Finset ℕ)))) T ∧ (1/8 : ℝ) ≤ T ∧ (9/40 : ℝ) ≤ T ∧ T ≤ (3/8 : ℝ) ∧ Clear2 d1 d2 T ∧ ∀ s, (9/40 : ℝ) ≤ s → s < T → ¬ Clear2 d1 d2 s := by
  have hamem := mem_insert2 (S := ({1, 2, 5} : Finset ℕ)) d1 d2 (a := 1) (by decide)
  have key : ∀ T : ℝ, T ≤ (3/8 : ℝ) → FClear ({1, 2, 5} : Finset ℕ) T → Clear2 d1 d2 T →
      (∀ s, (1/8 : ℝ) ≤ s → s ≤ (3/8 : ℝ) → s < T → FClear ({1, 2, 5} : Finset ℕ) s → Clear2 d1 d2 s → False) →
      IsFirst (insert d1 (insert d2 (fset ({1, 2, 5} : Finset ℕ)))) T := by
    intro T hTr hF hC hmin
    refine ⟨(lonely_insert2_iff ({1, 2, 5} : Finset ℕ) d1 d2 T).2 ⟨hF, hC⟩, ?_⟩
    intro s hs hlon
    have hs8' := lonely_geG hamem (by norm_num) hs hlon
    have hs8 : (1/8 : ℝ) ≤ s := by norm_num at hs8' ⊢; linarith
    rw [lonely_insert2_iff] at hlon
    by_contra hlt
    push Not at hlt
    exact hmin s hs8 (by linarith) hlt hlon.1 hlon.2
  obtain ⟨ts, hls, hrs, hcs⟩ := hex
  obtain ⟨T, hlT, hCT, hmin⟩ := first_two_clear hd1p hd2p (by norm_num : (0 : ℝ) < (9/40 : ℝ)) ⟨ts, hls, hcs⟩
  have hTr : T ≤ (3/8 : ℝ) := le_trans (hmin ts hls hcs) hrs
  refine ⟨T, key T hTr (fpieceL125_1 T hlT hTr) hCT ?_, by linarith, hlT, hTr, hCT, fun s hs hlt hc => absurd (hmin s hs hc) (not_le.2 hlt)⟩
  intro s h0 hR hlt hF hC
  rcases coverL125 s h0 (le_trans hR (by norm_num)) hF with ⟨a0, b0⟩ | ⟨a1, b1⟩
  · exact hn0 ⟨s, a0, b0, hC⟩
  · exact absurd (hmin s a1 hC) (not_le.2 hlt)

