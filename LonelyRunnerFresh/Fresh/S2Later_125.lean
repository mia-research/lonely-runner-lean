theorem coreL125 (d1 d2 : ℝ) (h0 : (1 : ℝ) ≤ d1) (hd : d1 ≤ d2) :
    (∃ t, (1/8 : ℝ) ≤ t ∧ t ≤ (7/40 : ℝ) ∧ Clear2 d1 d2 t) ∨ (∃ t, (9/40 : ℝ) ≤ t ∧ t ≤ (3/8 : ℝ) ∧ Clear2 d1 d2 t) := by
  rcases le_or_gt d1 (2 : ℝ) with c0 | b0
  · exact colL125_0 d1 d2 (by linarith) c0 hd
  -- d1 > 2
  rcases le_or_gt d1 (3 : ℝ) with c1 | b1
  · exact colL125_1 d1 d2 (by linarith) c1 hd
  -- d1 > 3
  rcases le_or_gt d1 (4 : ℝ) with c2 | b2
  · exact colL125_2 d1 d2 (by linarith) c2 hd
  -- d1 > 4
  rcases le_or_gt d1 (5 : ℝ) with c3 | b3
  · exact colL125_3 d1 d2 (by linarith) c3 hd
  -- d1 > 5
  rcases le_or_gt d1 (6 : ℝ) with c4 | b4
  · exact colL125_4 d1 d2 (by linarith) c4 hd
  -- d1 > 6
  rcases le_or_gt d1 (7 : ℝ) with c5 | b5
  · exact colL125_5 d1 d2 (by linarith) c5 hd
  -- d1 > 7
  have hp1 : 0 < d1 := by linarith
  have hp2 : 0 < d2 := by linarith
  right; exact big_both (D := (7 : ℝ)) (l := (9/40 : ℝ)) (r := (3/8 : ℝ)) (by norm_num) (by norm_num) (by linarith) (by linarith)

theorem exists_union_125 (d1 d2 : ℝ) (hd1 : (1 : ℝ) < d1) (hd2 : (1 : ℝ) < d2) :
    (∃ t, (1/8 : ℝ) ≤ t ∧ t ≤ (7/40 : ℝ) ∧ Clear2 d1 d2 t) ∨ (∃ t, (9/40 : ℝ) ≤ t ∧ t ≤ (3/8 : ℝ) ∧ Clear2 d1 d2 t) := by
  rcases le_total d1 d2 with h | h
  · exact coreL125 d1 d2 hd1.le h
  · have hc := coreL125 d2 d1 hd2.le h
    rcases hc with ⟨t, a1, a2, a3⟩ | ⟨t, a1, a2, a3⟩
    · left; exact ⟨t, a1, a2, clear2_symm a3⟩
    · right; exact ⟨t, a1, a2, clear2_symm a3⟩

theorem land2_later_125 (d1 d2 : ℝ) (hd1 : (1 : ℝ) < d1) (hd2 : (1 : ℝ) < d2) :
    ∃ T, IsFirst (insert d1 (insert d2 (fset ({1, 2, 5} : Finset ℕ)))) T ∧ (1/8 : ℝ) ≤ T ∧
      (((1/8 : ℝ) ≤ T ∧ T ≤ (7/40 : ℝ) ∧ Clear2 d1 d2 T ∧ ∀ s, (1/8 : ℝ) ≤ s → s < T → ¬ Clear2 d1 d2 s) ∨
      (¬ (∃ t, (1/8 : ℝ) ≤ t ∧ t ≤ (7/40 : ℝ) ∧ Clear2 d1 d2 t) ∧ (9/40 : ℝ) ≤ T ∧ T ≤ (3/8 : ℝ) ∧ Clear2 d1 d2 T ∧ ∀ s, (9/40 : ℝ) ≤ s → s < T → ¬ Clear2 d1 d2 s)) := by
  have hd1p : 0 < d1 := by linarith
  have hd2p : 0 < d2 := by linarith
  by_cases e0 : ∃ t, (1/8 : ℝ) ≤ t ∧ t ≤ (7/40 : ℝ) ∧ Clear2 d1 d2 t
  · obtain ⟨T, hf, hge, hl, hr, hc, hm⟩ := landL125_0 d1 d2 hd1p hd2p e0
    refine ⟨T, hf, hge, ?_⟩
    left; exact ⟨hl, hr, hc, hm⟩
  have hu := exists_union_125 d1 d2 hd1 hd2
  rcases hu with h0 | h1
  · exact absurd h0 e0
  · obtain ⟨T, hf, hge, hl, hr, hc, hm⟩ := landL125_1 d1 d2 hd1p hd2p e0 h1
    refine ⟨T, hf, hge, ?_⟩
    right; exact ⟨e0, hl, hr, hc, hm⟩

